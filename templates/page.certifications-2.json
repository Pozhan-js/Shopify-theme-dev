        "text_NWpwHm": {
          "type": "text",
          "name": "t:names.text",
          "settings": {
            "text": "<h2><strong>GOOD Comfort KN95</strong></h2><p>This mask has both KN95 and FFP2 certification.</p><p><a href=\"https://cdn.prod.website-files.com/67acb2fdf274634235134c0f/67cedcffb3c31a7098531d66_CNAS-TEST-REPORT_8862-KN95-GB2626-2019-210147061-2.pdf\">KN95 Certification (US)</a></p><p><a href=\"https://cdn.prod.website-files.com/67acb2fdf274634235134c0f/67cefe724b51531283c6df38_CNAS_GOOD_Comfort_FFP2_NR_EU_Test_Report.pdf\">FFP2 Certification (NR / EU) Test Report</a></p><p><a href=\"https://cdn.prod.website-files.com/67acb2fdf274634235134c0f/67cefe8f82767310db9cd920_EU_Declaration_of_Confirmity_FFP2.pdf\">EU Declaration of Conformity</a></p><p><a href=\"https://cdn.prod.website-files.com/67acb2fdf274634235134c0f/67cefeb90cbcb7a25c96845f_CE_Certificate_Test_Report.pdf\">CE Certificate Test Report</a></p><p><a href=\"https://cdn.prod.website-files.com/67acb2fdf274634235134c0f/67cefeeacf07f15fd5627bd7_GOOD_Comfort_FFP2_NR_EU_Certificate_ISO.pdf\">GOOD Comfort FFP2 (NR / EU) Certificate ISO</a></p>",
