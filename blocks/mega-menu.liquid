{% comment %}
  文件名: mega-menu.liquid
  位置: blocks/mega-menu.liquid
  根据菜单二级项自动匹配图片
{% endcomment %}

{{ 'component-mega-menu.css' | asset_url | stylesheet_tag }}

{%- comment -%} 构建图片映射表 {%- endcomment -%}
{%- assign image_map = '' -%}
{%- if block.settings.images_data != blank -%}
  {%- assign image_entries = block.settings.images_data | split: '||' -%}
  {%- assign image_map = '' | split: '' -%}
  {%- for entry in image_entries -%}
    {%- assign parts = entry | split: '::' -%}
    {%- if parts.size == 2 -%}
      {%- assign map_item = parts[0] | append: '::' | append: parts[1] -%}
      {%- assign image_map = image_map | push: map_item -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

<nav class="mega-menu" role="navigation">
  <ul class="mega-menu__list">
    {%- for link in block.settings.menu.links -%}
      <li class="mega-menu__item{% if link.links != blank %} mega-menu__item--has-dropdown{% endif %}">
        <a href="{{ link.url }}" class="mega-menu__link">
          {{ link.title }}
          {%- if link.links != blank -%}
            <svg class="icon icon-caret" viewBox="0 0 10 6">
              <path d="M1 1l4 4 4-4" stroke="currentColor" fill="none"/>
            </svg>
          {%- endif -%}
        </a>
        
        {%- if link.links != blank -%}
          <div class="mega-menu__dropdown">
            <ul class="mega-menu__dropdown-list">
              {%- for child_link in link.links -%}
                {%- assign menu_handle = child_link.title | handleize -%}
                {%- assign matched_image = blank -%}
                
                {%- comment -%} 匹配图片 {%- endcomment -%}
                {%- for i in (1..10) -%}
                  {%- assign title_key = 'item' | append: i | append: '_title' -%}
                  {%- assign image_key = 'item' | append: i | append: '_image' -%}
                  {%- assign config_title = block.settings[title_key] -%}
                  {%- assign config_image = block.settings[image_key] -%}
                  
                  {%- if config_title != blank and config_image != blank -%}
                    {%- if child_link.title == config_title -%}
                      {%- assign matched_image = config_image -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
                
                <li class="mega-menu__dropdown-item">
                  <a href="{{ child_link.url }}" class="mega-menu__dropdown-link">
                    {%- if matched_image != blank -%}
                      <div class="mega-menu__image-wrapper">
                        <img 
                          src="{{ matched_image | image_url: width: 200 }}"
                          alt="{{ child_link.title }}"
                          width="200"
                          height="auto"
                          loading="lazy"
                        >
                      </div>
                    {%- endif -%}
                    <span class="mega-menu__dropdown-title">{{ child_link.title }}</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>

