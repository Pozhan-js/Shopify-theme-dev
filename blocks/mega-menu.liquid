{% comment %}
  文件名: mega-menu.liquid
  位置: blocks/mega-menu.liquid
{% endcomment %}

{{ 'component-mega-menu.css' | asset_url | stylesheet_tag }}

<nav class="mega-menu" role="navigation">
  <ul class="mega-menu__list">
    {%- for link in block.settings.menu.links -%}
      <li class="mega-menu__item{% if link.links != blank %} mega-menu__item--has-dropdown{% endif %}">
        <a href="{{ link.url }}" class="mega-menu__link">
          {{ link.title }}
          {%- if link.links != blank -%}
            <svg class="icon icon-caret" viewBox="0 0 10 6">
              <path d="M1 1l4 4 4-4" stroke="currentColor" fill="none"/>
            </svg>
          {%- endif -%}
        </a>
        
        {%- if link.links != blank -%}
          <div class="mega-menu__dropdown">
            <ul class="mega-menu__dropdown-list">
              {%- for child_link in link.links -%}
                <li class="mega-menu__dropdown-item">
                  <a href="{{ child_link.url }}" class="mega-menu__dropdown-link">
                    {%- comment -%} 从菜单项的 metafield 获取图片 {%- endcomment -%}
                    {%- if child_link.object.metafields.custom.menu_image != blank -%}
                      <div class="mega-menu__image-wrapper">
                        <img 
                          src="{{ child_link.object.metafields.custom.menu_image | image_url: width: 200 }}"
                          alt="{{ child_link.title }}"
                          width="200"
                          height="auto"
                          loading="lazy"
                        >
                      </div>
                    {%- endif -%}
                    <span class="mega-menu__dropdown-title">{{ child_link.title }}</span>
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</nav>

{% schema %}
{
  "name": "Mega Menu",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "菜单",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
