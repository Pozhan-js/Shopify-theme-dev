{%- comment -%}
  快速购买栏 - 固定在页面底部
  使用方法: {% render 'quick-buy-bar', product: product %}
{%- endcomment -%}

<div class="quick-buy-bar" id="quickBuyBar" data-product-id="{{ product.id }}">
  <div class="quick-buy-container">
    
    {%- comment -%} 产品图片 {%- endcomment -%}
    <div class="quick-buy-image">
      {% if product.featured_image %}
        <img 
          src="{{ product.featured_image | img_url: '100x100', crop: 'center' }}" 
          alt="{{ product.featured_image.alt | escape }}"
          loading="lazy"
          data-quick-image
        >
      {% endif %}
    </div>

    {%- comment -%} 产品信息 {%- endcomment -%}
    <div class="quick-buy-info">
      <h3 class="quick-buy-title">{{ product.title }}</h3>
      <div class="quick-buy-price">
        <span class="price" data-quick-price>
          {{ product.selected_or_first_available_variant.price | money }}
        </span>
        {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
          <span class="compare-price" data-quick-compare-price>
            {{ product.selected_or_first_available_variant.compare_at_price | money }}
          </span>
        {% endif %}
      </div>
    </div>

    {%- comment -%} 变体选择器 {%- endcomment -%}
    {% unless product.has_only_default_variant %}
      <div class="quick-buy-variants">
        {% for option in product.options_with_values %}
          <div class="quick-variant-option" data-option-position="{{ option.position }}">
            <label class="quick-option-label">{{ option.name }}</label>
            <select 
              class="quick-variant-select" 
              data-option-position="{{ option.position }}"
              data-option-name="{{ option.name }}"
            >
              {% for value in option.values %}
                <option value="{{ value | escape }}">{{ value }}</option>
              {% endfor %}
            </select>
          </div>
        {% endfor %}
      </div>
    {% endunless %}

    {%- comment -%} 添加到购物车按钮 {%- endcomment -%}
    <div class="quick-buy-actions">
      <button 
        type="button" 
        class="quick-add-to-cart" 
        data-quick-add-to-cart
        {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
      >
        <span class="btn-icon">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M3 3H5L5.4 5M7 13H15L17 5H5.4M7 13L5.4 5M7 13L5.5 15.5C5.2 16 5.5 16.5 6 16.5H15M15 16.5C14.2 16.5 13.5 17.2 13.5 18C13.5 18.8 14.2 19.5 15 19.5C15.8 19.5 16.5 18.8 16.5 18C16.5 17.2 15.8 16.5 15 16.5ZM8 18C8 18.8 7.3 19.5 6.5 19.5C5.7 19.5 5 18.8 5 18C5 17.2 5.7 16.5 6.5 16.5C7.3 16.5 8 17.2 8 18Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="btn-text" data-btn-text>
          {% if product.selected_or_first_available_variant.available %}
           ADD TO CART
          {% else %}
            SOLD OUT
          {% endif %}
        </span>
        <span class="btn-loading" style="display: none;">
          <svg class="spinner" width="20" height="20" viewBox="0 0 20 20">
            <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="2" fill="none" opacity="0.3"/>
            <path d="M10 2 A8 8 0 0 1 18 10" stroke="currentColor" stroke-width="2" fill="none"/>
          </svg>
        </span>
        <span class="btn-success" style="display: none;">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M4 10L8 14L16 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </button>
    </div>

    {%- comment -%} 关闭按钮 {%- endcomment -%}
    <button type="button" class="quick-buy-close" data-quick-close aria-label="关闭">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M2 2L18 18M18 2L2 18" stroke="currentColor" stroke-width="2"/>
      </svg>
    </button>

  </div>
</div>

{%- comment -%} 飞入购物车动画元素 {%- endcomment -%}
<div class="cart-fly-item" id="cartFlyItem" style="display: none;">
  <img src="" alt="" data-fly-image>
</div>

{%- comment -%} 产品数据 JSON {%- endcomment -%}
<script type="application/json" id="quick-buy-product-json">
  {{ product | json }}
</script>
