<div class="dropdown has-mega-menu">
  <span class="nav-item dropdown-trigger" style="cursor: pointer;">
    <span>{{ link.title | escape }}</span>
    <span class="dropdown-arrow"></span>
  </span>
  <div class="mega-dropdown-menu about-mega-menu">
    <div class="about-mega-grid">
      {% comment %} 动态渲染About Us卡片 {% endcomment %}
      {% for block in section.blocks %}
        {% if block.type == 'about_menu_card' and block.settings.card_title != blank %}
          <div class="about-card-column">
            <h3 class="about-card-title">{{ block.settings.card_title }}</h3>
            <div class="about-card" style="background-image: url('{% if block.settings.card_image %}{{ block.settings.card_image | image_url: width: 480 }}{% else %}https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=480&h=377&fit=crop&crop=center{% endif %}');">
              <div class="about-card-overlay">
                <p class="about-card-description">{{ block.settings.card_description }}</p>
                <a href="{{ block.settings.card_url | default: '#' }}" class="about-card-arrow">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
      
      {% comment %} 如果没有配置任何卡片，显示默认卡片 {% endcomment %}
      {% assign about_cards_count = 0 %}
      {% for block in section.blocks %}
        {% if block.type == 'about_menu_card' and block.settings.card_title != blank %}
          {% assign about_cards_count = about_cards_count | plus: 1 %}
        {% endif %}
      {% endfor %}
      
      {% if about_cards_count == 0 %}
        <!-- Default Our Story Card -->
        <div class="about-card-column">
          <h3 class="about-card-title">Our Story</h3>
          <div class="about-card" style="background-image: url('https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=480&h=377&fit=crop&crop=center');">
            <div class="about-card-overlay">
              <p class="about-card-description">XS Pilates helps studios, instructors, and rehab pros achieve better outcomes - with premium quality and flexible customization at every step.</p>
              <a href="/pages/our-story" class="about-card-arrow">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Default Our Factory Card -->
        <div class="about-card-column">
          <h3 class="about-card-title">Our Factory</h3>
          <div class="about-card" style="background-image: url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=480&h=377&fit=crop&crop=center');">
            <div class="about-card-overlay">
              <p class="about-card-description">Step into XS Pilates vertically integrated facility where studio-grade equipment is built through 30+ handcrafted steps, eco-minded finishes, and rigorous QC.</p>
              <a href="/pages/our-factory" class="about-card-arrow">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Default Quality Control Card -->
        <div class="about-card-column">
          <h3 class="about-card-title">Quality Control</h3>
          <div class="about-card" style="background-image: url('https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=480&h=377&fit=crop&crop=center');">
            <div class="about-card-overlay">
              <p class="about-card-description">At XS Pilates, quality is not a goal, it is our foundation. We build trust through meticulous craftsmanship and rigorous standards.</p>
              <a href="/pages/quality-control" class="about-card-arrow">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
    
    <a href="{{ section.settings.mega_menu_footer_link | default: section.settings.contactlink | default: '/pages/contact' }}" class="mega-menu-footer">
      {% if section.settings.contactfootericon %}
        <div class="mega-menu-footer-icon">
          <img src="{{ section.settings.contactfootericon | image_url: width: 44 }}" alt="Contact Icon">
        </div>
      {% endif %}
      <span>{{ section.settings.mega_menu_footer_text | default: 'CONTACT US' }}</span>
    </a>
  </div>
</div>

<style>
/* About Us Mega Menu Specific Styles */
.about-mega-menu {
  background: #FFFCFC;
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
  position: fixed;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-top: 8px;
  width: 100%;
  border-radius: 12px;
  opacity: 0;
  visibility: hidden;
  transition: all 0.2s ease;
  padding: 32px 32px 0 32px;
  z-index: 1000;
}

.about-mega-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  height: 100%;
  margin-bottom: 70px;
}

.about-card-column {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.about-card {
  background-size: cover;
  background-position: center;
  border-radius: 16px;
  position: relative;
  width: 480px;
  height: 377px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  overflow: hidden;
  transition: transform 0.2s ease;
}

.about-card:hover {
  transform: translateY(-2px);
}

.about-card-title {
  font-size: 28px;
  font-weight: 600;
  color: #161616;
  margin: 0 0 16px 0;
  line-height: 1.2;
}

.about-card-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 120px;
  border-radius: 0px 0px 16px 16px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.about-card-description {
  font-size: 16px;
  color: white;
  line-height: 1.4;
  margin: 0;
  flex: 1;
  width: 355px;
  word-wrap: break-word;
  white-space: normal;
  overflow-wrap: break-word;
}

.about-card-arrow {
  position: absolute;
  bottom: 24px;
  right: 24px;
  background: rgba(255, 255, 255, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  backdrop-filter: blur(8px);
  color: white;
  text-decoration: none;
}

.about-card-arrow:hover {
  background: rgba(255, 255, 255, 0.3);
  border-color: rgba(255, 255, 255, 0.5);
  transform: translateX(2px);
  color: white;
}

/* Responsive styles for About menu */
@media (max-width: 480px) {
  .about-mega-menu {
    width: 100%;
    padding: 16px 16px 0 16px;
    border-radius: 8px;
    margin-top: 6px;
  }
  
  .about-mega-grid {
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 50px;
  }
  
  .about-card {
    width: 100%;
    max-width: 300px;
    height: 240px;
  }
  
  .about-card-title {
    font-size: 16px;
    margin-bottom: 10px;
  }
  
  .about-card-overlay {
    height: 80px;
    padding: 12px;
  }
  
  .about-card-description {
    font-size: 12px;
    width: 100%;
  }
  
  .about-card-arrow {
    width: 32px;
    height: 32px;
    bottom: 12px;
    right: 12px;
  }
}

@media (min-width: 481px) and (max-width: 768px) {
  .about-mega-menu {
    width: 95%;
    padding: 18px 18px 0 18px;
    border-radius: 10px;
    margin-top: 7px;
  }
  
  .about-mega-grid {
    grid-template-columns: 1fr;
    gap: 18px;
    margin-bottom: 55px;
  }
  
  .about-card {
    width: 100%;
    max-width: 380px;
    height: 280px;
  }
  
  .about-card-title {
    font-size: 18px;
    margin-bottom: 12px;
  }
  
  .about-card-overlay {
    height: 90px;
    padding: 14px;
  }
  
  .about-card-description {
    font-size: 13px;
    width: 100%;
  }
  
  .about-card-arrow {
    width: 36px;
    height: 36px;
    bottom: 14px;
    right: 14px;
  }
}

@media (min-width: 769px) and (max-width: 1023px) {
  .about-mega-menu {
    width: 95%;
    max-width: 1200px;
    padding: 20px 20px 0 20px;
    border-radius: 10px;
    margin-top: 7px;
  }
  
  .about-mega-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-bottom: 60px;
  }
  
  .about-card {
    width: 100%;
    max-width: 350px;
    height: 280px;
  }
  
  .about-card:nth-child(3) {
    grid-column: span 2;
    justify-self: center;
  }
  
  .about-card-title {
    font-size: 20px;
    margin-bottom: 14px;
  }
  
  .about-card-overlay {
    height: 90px;
    padding: 16px;
  }
  
  .about-card-description {
    font-size: 13px;
    width: 100%;
  }
  
  .about-card-arrow {
    width: 40px;
    height: 40px;
    bottom: 16px;
    right: 16px;
  }
}

@media (min-width: 1024px) and (max-width: 1279px) {
  .about-mega-menu {
    width: 95%;
    max-width: 1300px;
    padding: 24px 24px 0 24px;
    border-radius: 11px;
    margin-top: 8px;
  }
  
  .about-mega-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 65px;
  }
  
  .about-card {
    width: 100%;
    max-width: 380px;
    height: 300px;
  }
  
  .about-card-title {
    font-size: 22px;
    margin-bottom: 15px;
  }
  
  .about-card-overlay {
    height: 100px;
    padding: 18px;
  }
  
  .about-card-description {
    font-size: 14px;
    width: 100%;
  }
  
  .about-card-arrow {
    width: 44px;
    height: 44px;
    bottom: 18px;
    right: 18px;
  }
}

@media (min-width: 1280px) and (max-width: 1919px) {
  .about-mega-menu {
    width: 95%;
    padding: 28px 28px 0 28px;
    border-radius: 12px;
    margin-top: 8px;
  }
  
  .about-mega-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    margin-bottom: 68px;
  }
  
  .about-card {
    width: 100%;
    max-width: 420px;
    height: 330px;
  }
  
  .about-card-title {
    font-size: 24px;
    margin-bottom: 15px;
  }
  
  .about-card-overlay {
    height: 110px;
    padding: 20px;
  }
  
  .about-card-description {
    font-size: 15px;
    width: 100%;
  }
  
  .about-card-arrow {
    width: 46px;
    height: 46px;
    bottom: 20px;
    right: 20px;
  }
}

@media (min-width: 1920px) {
  .about-mega-menu {
    width: 1654px;
    padding: 49px 77px 0 77px;
    border-radius: 12px;
    margin-top: 8px;
  }
  
  .about-mega-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 70px;
  }
  
  .about-card {
    width: 480px;
    height: 377px;
  }
  
  .about-card-title {
    font-size: 28px;
    margin-bottom: 16px;
  }
  
  .about-card-overlay {
    height: 120px;
    padding: 24px;
  }
  
  .about-card-description {
    font-size: 16px;
    width: 355px;
  }
  
  .about-card-arrow {
    width: 48px;
    height: 48px;
    bottom: 24px;
    right: 24px;
  }
}
</style>
