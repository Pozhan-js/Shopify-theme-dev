<div class="dropdown has-mega-menu">
  <span class="nav-item dropdown-trigger" style="cursor: pointer;">
    <span>{{ link.title | escape }}</span>
    <span class="dropdown-arrow"></span>
  </span>
  <div class="mega-dropdown-menu about-mega-menu">
    <div class="about-mega-grid">
      <!-- Our Story Card -->
      <div class="about-card-column">
        <div class="about-card" style="background-image: url('{% if section.settings.about_story_image %}{{ section.settings.about_story_image | image_url: width: 526 }}{% else %}https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=526&h=394&fit=crop&crop=center{% endif %}');">
          <div class="about-card-overlay">
            <h3 class="about-card-title">{{ section.settings.about_story_title | default: 'Our Story' }}</h3>
            <p class="about-card-description">{{ section.settings.about_story_description | default: 'XS Pilates helps studios, instructors, and rehab pros achieve better outcomes - with premium quality and flexible customization at every step.' }}</p>
            <a href="{{ section.settings.about_story_url | default: '/pages/our-story' }}" class="about-card-arrow">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Our Factory Card -->
      <div class="about-card-column">
        <div class="about-card" style="background-image: url('{% if section.settings.about_factory_image %}{{ section.settings.about_factory_image | image_url: width: 526 }}{% else %}https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?w=526&h=394&fit=crop&crop=center{% endif %}');">
          <div class="about-card-overlay">
            <h3 class="about-card-title">{{ section.settings.about_factory_title | default: 'Our Factory' }}</h3>
            <p class="about-card-description">{{ section.settings.about_factory_description | default: 'Step into XS Pilates vertically integrated facility where studio-grade equipment is built through 30+ handcrafted steps, eco-minded finishes, and rigorous QC.' }}</p>
            <a href="{{ section.settings.about_factory_url | default: '/pages/our-factory' }}" class="about-card-arrow">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Quality Control Card -->
      <div class="about-card-column">
        <div class="about-card" style="background-image: url('{% if section.settings.about_quality_image %}{{ section.settings.about_quality_image | image_url: width: 526 }}{% else %}https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=526&h=394&fit=crop&crop=center{% endif %}');">
          <div class="about-card-overlay">
            <h3 class="about-card-title">{{ section.settings.about_quality_title | default: 'Quality Control' }}</h3>
            <p class="about-card-description">{{ section.settings.about_quality_description | default: 'At XS Pilates, quality is not a goal, it is our foundation. We build trust through meticulous craftsmanship and rigorous standards.' }}</p>
            <a href="{{ section.settings.about_quality_url | default: '/pages/quality-control' }}" class="about-card-arrow">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
    
    <div class="mega-menu-footer">
      {% if section.settings.contactfootericon %}
        <div class="mega-menu-footer-icon">
          <img src="{{ section.settings.contactfootericon | image_url: width: 44 }}" alt="Contact Icon">
        </div>
      {% endif %}
      <span>{{ section.settings.mega_menu_footer_text | default: 'CONTACT US' }}</span>
    </div>
  </div>
</div>

<style>
