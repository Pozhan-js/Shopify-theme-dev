{%- comment -%}
------------------------------------------------------------------------------
	Snippet: Image with text caption
	This snippet will output image with caption for image with text section

	- desktop_image: desktop image object (required, object),
	- mobile_image: mobile image object (optional, object),
	- image_width: mobile image width 1x
	- image_width_2x: mobile image widht 2x
	- caption: caption text for the image (optional, string)
	- delay_step: animation delay (optional, number)

	{% render 'image-with-text-caption', desktop_image: first_desktop_image, mobile_image: first_mobile_image, caption: first_image_caption %}
------------------------------------------------------------------------------
{%- endcomment -%}

{%- assign image_width    = image_width | default: "390x" -%}
{%- assign image_width_2x = image_width_2x | default: "780x" -%}

{%- if desktop_image != blank -%}
	{%- capture img_focal -%}
		--img-desktop-pos: {{ desktop_image.presentation.focal_point }};
		--img-mob-pos: {{ mobile_image.presentation.focal_point }};
	{%- endcapture -%}

	<div class="image-with-text__image-wrapper-container">
		<picture class="lazy image-with-text__image-wrapper need-animate tr-dur-0-5" {% if delay_step %}style="transition-delay: {{ delay_step }}s;"{% endif %}>
			<source
				data-srcset="{{ mobile_image | image_url: width: 375 }} 1x, {{ mobile_image | image_url: width: 750 }} 2x"
				srcset="{{ mobile_image | image_url: width: 10 }} 1x, {{ mobile_image | image_url: width: 10 }} 2x"
				media="(max-width: 375px)"
				width="375"
				height="auto"
			/>

			<source
				data-srcset="{{ mobile_image | image_url: width: 420 }} 1x, {{ mobile_image | image_url: width: 840 }} 2x"
				srcset="{{ mobile_image | image_url: width: 10 }} 1x, {{ mobile_image | image_url: width: 10 }} 2x"
				media="(max-width: 420px)"
				width="420"
				height="auto"
			/>

			<source
				data-srcset="{{ mobile_image | image_url: width: 575 }} 1x, {{ mobile_image | image_url: width: 1150 }} 2x"
				srcset="{{ mobile_image | image_url: width: 10 }} 1x, {{ mobile_image | image_url: width: 10 }} 2x"
				media="(max-width: 575px)"
				width="575"
				height="auto"
			/>

			<source
				data-srcset="{{ mobile_image | image_url: width: 768 }} 1x, {{ mobile_image | image_url: width: 1536 }} 2x"
				srcset="{{ mobile_image | image_url: width: 10 }} 1x, {{ mobile_image | image_url: width: 10 }} 2x"
				media="(max-width: 768px)"
				width="768"
				height="auto"
			/>

			<source
				data-srcset="{{ mobile_image | image_url: width: 991 }} 1x, {{ mobile_image | image_url: width: 1982 }} 2x"
				srcset="{{ mobile_image | image_url: width: 10 }} 1x, {{ mobile_image | image_url: width: 10 }} 2x"
				media="(max-width: 991px)"
				width="991"
				height="auto"
			/>

			<source
				data-srcset="{{ desktop_image | image_url: width: 1440 }} 1x, {{ desktop_image | image_url: width: 2880 }} 2x"
				srcset="{{ desktop_image | image_url: width: 10 }} 1x, {{ desktop_image | image_url: width: 10 }} 2x"
				media="(max-width: 1440px)"
				width="1440"
				height="auto"
			/>

			<img
				data-srcset="{{ desktop_image | image_url }} 1x, {{ desktop_image | image_url: width: 2000 }} 2x"
				srcset="{{ desktop_image | image_url: width: 10 }} 1x, {{ desktop_image | image_url: width: 10 }} 2x"
				data-src="{{ desktop_image | image_url }}"
				src="{{ desktop_image | image_url: width: 10 }}"
				alt="{{ desktop_image.alt }}"
				width="{{ desktop_image.width }}"
				height="{{ desktop_image.height }}"
				class="image-with-text__image image-with-text__image--full-width"
				style="{{ img_focal }}"
			/>
		</picture>
		
		{%- if caption != blank -%}
			<div class="image-with-text__caption">
				<span class="image-with-text__caption-text">{{ caption }}</span>
			</div>
		{%- endif -%}
	</div>
{%- else -%}
	<div class="image-with-text__image-wrapper-container">
		<div class="image-with-text__image-wrapper">
			{{ 'product-apparel-3' | placeholder_svg_tag: 'image-with-text__image image-with-text__image--placeholder' }}
		</div>
		{%- if caption != blank -%}
			<div class="image-with-text__caption">
				<span class="image-with-text__caption-text">{{ caption }}</span>
			</div>
		{%- endif -%}
	</div>
{%- endif -%}