{%- doc -%}
  Displays product recommendation in a horizontal layout with clickable product switching.
  Shows product image on the left and product info on the right.
{%- enddoc -%}

{% liquid
  assign image_sizes = '(min-width: 750px) 200px, 150px'
  assign product = closest.product
  assign lazy_image_sizes = 'auto, ' | append: image_sizes

  # Get recommended products (you'll need to implement this logic)
  assign recommended_products = collections.all.products | limit: 3
  assign current_product = recommended_products.first
  if product != blank
    assign current_product = product
  endif
%}

<div
  ref="productRecommendation"
  class="product-recommendation spacing-style border-style"
  style="
    {% render 'border-override', settings: block.settings %}
    {% render 'spacing-style', settings: block.settings %}
  "
  data-product-id="{{ current_product.id }}"
  {{ block.shopify_attributes }}
>
  <div class="product-recommendation__header">
    <div class="product-recommendation__tabs">
      {% for rec_product in recommended_products %}
        <button
          class="product-recommendation__tab {% if forloop.first %}active{% endif %}"
          data-product-id="{{ rec_product.id }}"
          onclick="switchProduct({{ rec_product.id }})"
        >
          {{ rec_product.title }}
        </button>
        {% unless forloop.last %}
          <span class="product-recommendation__separator">—</span>
        {% endunless %}
      {% endfor %}
    </div>
  </div>

  <div class="product-recommendation__content">
    <div class="product-recommendation__image">
      {% if current_product.featured_image %}
        <img
          src="{{ current_product.featured_image | image_url: width: 200 }}"
          alt="{{ current_product.featured_image.alt | escape }}"
          loading="lazy"
          class="product-recommendation__img"
        >
      {% else %}
        <placeholder-image data-type="product"></placeholder-image>
      {% endif %}
    </div>

    <div class="product-recommendation__info">
      <h3 class="product-recommendation__title">{{ current_product.title }}</h3>
      <div class="product-recommendation__action">
        <button class="product-recommendation__button">GET THE SET - {{ current_product.price | money }}</button>
      </div>
    </div>
  </div>

  {{ children }}
</div>

<script>
  function switchProduct(productId) {
    // Remove active class from all tabs
    document.querySelectorAll('.product-recommendation__tab').forEach((tab) => {
      tab.classList.remove('active');
    });

    // Add active class to clicked tab
    document.querySelector(`[data-product-id="${productId}"]`).classList.add('active');

    // Here you would implement the logic to update the product display
    // This might involve AJAX calls to get product data
    console.log('Switching to product:', productId);
  }
</script>

{% stylesheet %}
  .product-recommendation {
    background-color: #f5f5f5;
    border-radius: 8px;
    padding: 24px;
    margin: 20px 0;
  }

  .product-recommendation__header {
    margin-bottom: 24px;
  }

  .product-recommendation__tabs {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .product-recommendation__tab {
    background: none;
    border: none;
    font-size: 18px;
    font-weight: 500;
    color: #999;
    cursor: pointer;
    padding: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: color 0.3s ease;
  }

  .product-recommendation__tab:hover,
  .product-recommendation__tab.active {
    color: #333;
  }

  .product-recommendation__tab.active {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }

  .product-recommendation__separator {
    color: #ccc;
    font-size: 18px;
    font-weight: 300;
  }

  .product-recommendation__content {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .product-recommendation__image {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    border-radius: 8px;
    overflow: hidden;
    background-color: white;
  }

  .product-recommendation__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-recommendation__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .product-recommendation__title {
    font-size: 24px;
    font-weight: 500;
    color: #333;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .product-recommendation__button {
    background-color: transparent;
    border: 2px solid #333;
    border-radius: 25px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 500;
    color: #333;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .product-recommendation__button:hover {
    background-color: #333;
    color: white;
  }

  /* 响应式设计 */
  @media screen and (max-width: 768px) {
    .product-recommendation {
      padding: 16px;
    }

    .product-recommendation__content {
      flex-direction: column;
      text-align: center;
      gap: 16px;
    }

    .product-recommendation__image {
      width: 100px;
      height: 100px;
    }

    .product-recommendation__title {
      font-size: 20px;
    }

    .product-recommendation__tabs {
      justify-content: center;
    }

    .product-recommendation__tab {
      font-size: 16px;
    }
  }

  @media screen and (max-width: 480px) {
    .product-recommendation__tabs {
      flex-direction: column;
      gap: 8px;
    }

    .product-recommendation__separator {
      display: none;
    }

    .product-recommendation__button {
      width: 100%;
      text-align: center;
    }
  }
{% endstylesheet %}
