{%- comment -%}
Delivery Renderer for Shopify Metafields
Usage: {% render 'delivery-renderer', delivery_text: product.metafields.custom.delivery %}
{%- endcomment -%}

{%- assign delivery_content = delivery_text | default: '' -%}

{%- if delivery_content contains 'UPS Standard' -%}
<div class="delivery-options">
  <div class="delivery-option">
    <strong>UPS Standard</strong>
    <p>€18 - €35<br>5-10 days</p>
  </div>
  
  <div class="delivery-option">
    <strong>UPS Express</strong>
    <p>€35 - €50<br>2-4 working days</p>
  </div>
  
  <div class="delivery-note">
    <p>Orders shipped outside the EU might have import duties, VAT, or handling fees added when they arrive. These are set locally and not included in your purchase price. See details <a href="https://tres-bien.com/pages/help">here</a>.</p>
  </div>
  
  <div class="delivery-note">
    <p>Goods will be dispatched and shipped on and during regular working days.</p>
  </div>
</div>

<style>
.delivery-options {
  margin: 20px 0;
}

.delivery-option {
  margin-bottom: 15px;
  padding: 15px;
  border-left: 3px solid #C89F73;
  background-color: #f9f9f9;
}

.delivery-option strong {
  display: block;
  margin-bottom: 5px;
  color: #333;
  font-size: 16px;
}

.delivery-option p {
  margin: 0;
  color: #666;
  line-height: 1.5;
}

.delivery-note {
  margin: 15px 0;
  padding: 10px;
  background-color: #fff8e1;
  border-left: 3px solid #ffa726;
}

.delivery-note p {
  margin: 0;
  color: #555;
  font-size: 14px;
  line-height: 1.5;
}

.delivery-note a {
  color: #C89F73;
  text-decoration: none;
  font-weight: 600;
}

.delivery-note a:hover {
  text-decoration: underline;
}
</style>

{%- else -%}
{{ delivery_content | newline_to_br }}
{%- endif -%}
