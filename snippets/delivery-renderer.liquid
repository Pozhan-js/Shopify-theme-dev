{%- comment -%}
Delivery Renderer for Shopify Metafields - 使用metafield_tag正确渲染富文本
Usage: {% render 'delivery-renderer', delivery_text: product.metafields.custom.delivery %}
{%- endcomment -%}

{%- assign delivery_content = delivery_text | default: '' -%}

{%- if delivery_content != blank -%}
  {{ delivery_content | metafield_tag }}
{%- else -%}
  {%- comment -%} 回退显示 {%- endcomment -%}
  <div class="delivery-options">
    <div class="delivery-option">
      <strong>Standard Delivery (3-5 business days)</strong>
      <p>Free on orders over €50</p>
    </div>
    <div class="delivery-option">
      <strong>Express Delivery (1-2 business days)</strong>
      <p>€9.95</p>
    </div>
    <div class="delivery-option">
      <strong>Click & Collect</strong>
      <p>Free - Pick up in store within 2 hours</p>
    </div>
    <p style="margin-top:15px;">
      <a href="/pages/shipping-info" style="color:#00b300;text-decoration:underline;">View full delivery information</a>
    </p>
  </div>
{%- endif -%}
