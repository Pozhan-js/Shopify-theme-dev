{% comment %}
  Dynamic Equipment Mega Menu with Backend-Configurable Collections
  This snippet renders equipment categories based on collections selected in the backend
{% endcomment %}

{% assign selected_collections = section.settings.equipment_collections %}
{% assign products_per_collection = section.settings.products_per_collection | default: 6 %}
{% assign collections_per_column = section.settings.collections_per_column | default: 2 %}
{% assign total_collections = selected_collections.size %}

{% if selected_collections and total_collections > 0 %}
  {% comment %} Calculate number of columns needed {% endcomment %}
  {% assign columns_needed = total_collections | divided_by: collections_per_column | ceil %}
  {% assign max_columns = 3 %}
  {% if columns_needed > max_columns %}
    {% assign columns_needed = max_columns %}
  {% endif %}

  {% comment %} Render collections in columns {% endcomment %}
  {% for column_index in (0..columns_needed) %}
    {% assign column_start = column_index | times: collections_per_column %}
    {% assign column_end = column_start | plus: collections_per_column | minus: 1 %}
    
    {% if column_start < total_collections %}
      <div class="mega-menu-column">
        {% for i in (column_start..column_end) %}
          {% if i < total_collections %}
            {% assign collection = selected_collections[i] %}
            {% if collection %}
              <div class="mega-menu-category">
                <h3>{{ collection.title | escape }}</h3>
                <ul>
                  {% if collection.products.size > 0 %}
                    {% for product in collection.products limit: products_per_collection %}
                      <li><a href="{{ product.url }}">{{ product.title | escape }}</a></li>
                    {% endfor %}
                    {% comment %} Add "View All" link if there are more products {% endcomment %}
                    {% if collection.products.size > products_per_collection %}
                      <li><a href="{{ collection.url }}" style="font-weight: 600; color: #DC2626;">View All {{ collection.title }}</a></li>
                    {% endif %}
                  {% else %}
                    {% comment %} Fallback if collection has no products {% endcomment %}
                    <li><a href="{{ collection.url }}">View {{ collection.title }}</a></li>
                  {% endif %}
                </ul>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  {% endfor %}

{% else %}
  {% comment %} Fallback: Display default collections if none selected {% endcomment %}
  {% render 'mega-menu-equipment-collections' %}
{% endif %}
