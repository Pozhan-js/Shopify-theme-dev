{% comment %}
  Equipment Mega Menu with Collections and Products
  This snippet renders equipment categories based on collections and their products
{% endcomment %}

{% assign equipment_collections = collections | where: 'handle', 'reformer', 'pilates-chair', 'ladder-barrel', 'cadillac', 'spine-corrector', 'accessories' %}

<div class="mega-menu-column">
  <div class="mega-menu-category">
    <h3>Reformer</h3>
    <ul>
      {% assign reformer_collection = collections['reformer'] %}
      {% if reformer_collection and reformer_collection.products.size > 0 %}
        {% for product in reformer_collection.products limit: 6 %}
          <li><a href="{{ product.url }}">{{ product.title }}</a></li>
        {% endfor %}
      {% else %}
        <li><a href="/collections/reformer">Pilates Reformer XSRF100</a></li>
        <li><a href="/collections/reformer">Aluminum Reformer XSRF04</a></li>
        <li><a href="/collections/reformer">Aluminum Reformer XSRF07</a></li>
        <li><a href="/collections/reformer">Classic Aluminum Reformer XSCAR</a></li>
      {% endif %}
    </ul>
  </div>
  <div class="mega-menu-category">
    <h3>Pilates Chair</h3>
    <ul>
      {% assign chair_collection = collections['pilates-chair'] %}
      {% if chair_collection and chair_collection.products.size > 0 %}
        {% for product in chair_collection.products limit: 4 %}
          <li><a href="{{ product.url }}">{{ product.title }}</a></li>
        {% endfor %}
      {% else %}
        <li><a href="/collections/pilates-chair">Basic Pilates Chair XSCC29</a></li>
        <li><a href="/collections/pilates-chair">Pilates Chair Wooden Base XSCC01</a></li>
        <li><a href="/collections/pilates-chair">Pro Pilates Wunda Chair XSCC32</a></li>
      {% endif %}
    </ul>
  </div>
</div>

