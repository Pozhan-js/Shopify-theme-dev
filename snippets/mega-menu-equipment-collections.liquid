{% comment %}
  Equipment Mega Menu with Collections and Products
  This snippet renders equipment categories based on collections and their products
{% endcomment %}

{% comment %} 获取所有可用的产品系列 {% endcomment %}
{% assign all_collections = collections %}
{% assign products_per_collection = 6 %}

{% comment %} 如果有可用的系列，显示前几个系列 {% endcomment %}
{% if all_collections.size > 0 %}
  {% assign collections_to_show = all_collections | limit: 6 %}
  {% assign collections_per_column = 2 %}
  {% assign total_collections = collections_to_show.size %}
  {% assign columns_needed = total_collections | divided_by: collections_per_column | ceil %}
  {% assign max_columns = 3 %}
  {% if columns_needed > max_columns %}
    {% assign columns_needed = max_columns %}
  {% endif %}

  {% for column_index in (0..columns_needed) %}
    {% assign column_start = column_index | times: collections_per_column %}
    {% assign column_end = column_start | plus: collections_per_column | minus: 1 %}
    
    {% if column_start < total_collections %}
      <div class="mega-menu-column">
        {% for i in (column_start..column_end) %}
          {% if i < total_collections %}
            {% assign collection = collections_to_show[i] %}
            {% if collection %}
              <div class="mega-menu-category">
                <h3>{{ collection.title | escape }}</h3>
                <ul>
                  {% if collection.products.size > 0 %}
                    {% for product in collection.products limit: products_per_collection %}
                      <li><a href="{{ product.url }}">{{ product.title | escape }}</a></li>
                    {% endfor %}
                    {% if collection.products.size > products_per_collection %}
                      <li><a href="{{ collection.url }}" style="font-weight: 600; color: #DC2626;">查看全部 {{ collection.title }}</a></li>
                    {% endif %}
                  {% else %}
                    <li><a href="{{ collection.url }}">查看 {{ collection.title }}</a></li>
                  {% endif %}
                </ul>
              </div>
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  {% endfor %}

{% else %}
  {% comment %} 如果没有系列，显示提示信息 {% endcomment %}
  <div class="mega-menu-column">
    <div class="mega-menu-category">
      <h3>暂无产品系列</h3>
      <ul>
        <li><a href="/collections">查看所有产品</a></li>
      </ul>
    </div>
  </div>
{% endif %}
