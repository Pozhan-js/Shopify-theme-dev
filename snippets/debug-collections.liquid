{% comment %}
  调试用的产品系列信息显示组件
{% endcomment %}

{% if section.settings.enable_debug_mode %}
<div style="position: fixed; top: 100px; right: 20px; background: white; border: 2px solid #333; padding: 15px; z-index: 9999; max-width: 400px; font-size: 12px; box-shadow: 0 4px 8px rgba(0,0,0,0.3);">
  <h4 style="margin: 0 0 10px 0; color: #333;">🔍 产品系列调试信息</h4>
  
  <div style="margin-bottom: 10px;">
    <strong>店铺总系列数:</strong> {{ collections.size }}
  </div>
  
  <div style="margin-bottom: 10px;">
    <strong>后台配置系列数:</strong> {{ section.settings.equipment_collections.size }}
  </div>
  
  {% if collections.size > 0 %}
    <div style="margin-bottom: 10px;">
      <strong>前5个系列:</strong>
      <ul style="margin: 5px 0; padding-left: 20px;">
        {% for collection in collections limit: 5 %}
          <li>{{ collection.title }} ({{ collection.products.size }}个产品)</li>
        {% endfor %}
      </ul>
    </div>
  {% endif %}
  
  {% if section.settings.equipment_collections.size > 0 %}
    <div style="margin-bottom: 10px;">
      <strong>配置的系列:</strong>
      <ul style="margin: 5px 0; padding-left: 20px;">
        {% for collection in section.settings.equipment_collections %}
          <li>{{ collection.title }} ({{ collection.products.size }}个产品)</li>
        {% endfor %}
      </ul>
    </div>
  {% else %}
    <div style="color: #ff6600; margin-bottom: 10px;">
      ⚠️ 后台未配置任何系列
    </div>
  {% endif %}
  
  <div style="font-size: 10px; color: #666; margin-top: 10px;">
    在后台关闭"启用调试模式"可隐藏此信息
  </div>
</div>
{% endif %}
