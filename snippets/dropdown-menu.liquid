<div class="dropdown">
  <a href="{{ link.url }}" class="nav-item">
    <span>{{ link.title | escape }}</span>
    <span class="dropdown-arrow"></span>
  </a>
  <div class="dropdown-menu">
    {% for childlink in link.links %}
      <a href="{{ childlink.url }}" class="dropdown-item">
        {{ childlink.title | escape }}
      </a>
    {% endfor %}
  </div>
</div>
