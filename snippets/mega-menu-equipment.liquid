<div class="dropdown has-mega-menu">
  <span class="nav-item dropdown-trigger" style="cursor: pointer;">
    <span>{{ link.title | escape }}</span>
    <span class="dropdown-arrow"></span>
  </span>
  <div class="mega-dropdown-menu equipment-mega-menu">
    <div class="mega-menu-grid equipment-mega-grid">
      {% comment %} 获取产品系列配置 {% endcomment %}
      {% assign products_per_collection = section.settings.products_per_collection | default: 6 %}
      {% assign collections_per_column = section.settings.collections_per_column | default: 2 %}
      
      {% comment %} 将 collections 转换为数组 {% endcomment %}
      {% assign collections_array = '' %}
      {% for collection in collections %}
        {% assign collections_array = collections_array | append: collection.handle %}
        {% unless forloop.last %}
          {% assign collections_array = collections_array | append: ',' %}
        {% endunless %}
      {% endfor %}
      {% assign collection_handles = collections_array | split: ',' %}
      
      {% if collection_handles.size > 0 %}
        {% assign total_collections = collection_handles.size %}
        {% assign columns_needed = total_collections | divided_by: collections_per_column | ceil %}
        {% assign max_columns = 3 %}
        {% if columns_needed > max_columns %}
          {% assign columns_needed = max_columns %}
        {% endif %}

        {% for column_index in (0..2) %}
          {% assign column_start = column_index | times: collections_per_column %}
          {% assign column_end = column_start | plus: collections_per_column | minus: 1 %}
          
          {% if column_start < total_collections %}
            <div class="mega-menu-column equipment-menu-column">
              {% for i in (column_start..column_end) %}
                {% if i < total_collections %}
                  {% assign collection_handle = collection_handles[i] %}
                  {% assign collection = collections[collection_handle] %}
                  {% if collection %}
                    <div class="mega-menu-category equipment-menu-category">
                      <h3><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h3>
                      <ul>
                        {% if collection.products.size > 0 %}
                          {% for product in collection.products %}
                            <li><a href="{{ product.url }}">{{ product.title | escape }}</a></li>
                          {% endfor %}
                        {% else %}
                          <li><a href="{{ collection.url }}">View {{ collection.title }}</a></li>
                        {% endif %}
                      </ul>
                    </div>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        {% comment %} 如果上面的方法不行，使用直接遍历 {% endcomment %}
        {% assign column_count = 0 %}
        {% assign items_in_column = 0 %}
        
        {% for collection in collections %}
          {% if items_in_column == 0 %}
            <div class="mega-menu-column equipment-menu-column">
          {% endif %}
          
          <div class="mega-menu-category equipment-menu-category">
            <h3><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h3>
            <ul>
              {% if collection.products.size > 0 %}
                {% for product in collection.products %}
                  <li><a href="{{ product.url }}">{{ product.title | escape }}</a></li>
                {% endfor %}
              {% else %}
                <li><a href="{{ collection.url }}">View {{ collection.title }}</a></li>
              {% endif %}
            </ul>
          </div>
          
          {% assign items_in_column = items_in_column | plus: 1 %}
          
          {% if items_in_column >= collections_per_column or forloop.last %}
            </div>
            {% assign items_in_column = 0 %}
            {% assign column_count = column_count | plus: 1 %}
            {% if column_count >= 3 %}
              {% break %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}
      
      <div class="mega-menu-column equipment-menu-column">
        <div class="nav-mega-cta-container">
          {% if section.settings.nav_cta_image %}
            <img src="{{ section.settings.nav_cta_image | image_url: width: 800 }}" alt="{{ section.settings.nav_cta_image_alt | default: 'Premium Equipment' }}" class="nav-mega-cta-image" />
          {% elsif section.settings.mega_menu_image %}
            <img src="{{ section.settings.mega_menu_image | image_url: width: 800 }}" alt="{{ section.settings.mega_menu_image_alt | default: 'Pilates Equipment' }}" class="nav-mega-cta-image" />
          {% else %}
            <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=800&h=1200&fit=crop&crop=center" alt="Pilates Equipment" class="nav-mega-cta-image" />
          {% endif %}
          <div class="nav-mega-cta-bottom-overlay">
            <div class="nav-mega-cta-overlay-title">{{ section.settings.cta_title | default: 'Premium Equipment' }}</div>
            <div class="nav-mega-cta-bottom-row">
              <div class="nav-mega-cta-overlay-subtitle">{{ section.settings.cta_subtitle | default: 'Discover our professional-grade Pilates equipment' }}</div>
              <a href="{{ section.settings.download_file_url | default: '#' }}" class="nav-mega-cta-download-btn" download>
                <div class="nav-mega-cta-download-icon">
                  {% if section.settings.download_icon %}
                    <img src="{{ section.settings.download_icon | image_url: width: 32 }}" alt="Download">
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="7,10 12,15 17,10"></polyline>
                      <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                  {% endif %}
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <a href="{{ section.settings.mega_menu_footer_link | default: section.settings.contactlink | default: '/pages/contact' }}" class="mega-menu-footer">
      {% if section.settings.contactfootericon %}
        <div class="mega-menu-footer-icon">
          <img src="{{ section.settings.contactfootericon | image_url: width: 44 }}" alt="Contact Icon">
        </div>
      {% endif %}
      <span>{{ section.settings.mega_menu_footer_text | default: 'CONTACT US' }}</span>
    </a>
  </div>
</div>

<style>
/* Equipment Mega Menu Specific Styles */
.equipment-mega-menu {
  background: #FFFCFC;
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
  position: fixed;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-top: 8px;
  width: 100%;
  border-radius: 12px;
  opacity: 0;
  visibility: hidden;
  transition: all 0.2s ease;
  padding: 32px 32px 0 32px;
  z-index: 1000;
}

.equipment-mega-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
  height: 100%;
  margin-bottom: 32px;
}

.equipment-menu-column {
  display: flex;
  flex-direction: column;
}

.equipment-menu-category {
  margin-bottom: 24px;
}

.equipment-menu-category h3 {
  font-size: 18px;
  font-weight: 600;
  color: #161616;
  margin-bottom: 12px;
  padding-bottom: 8px;
  position: relative;
}

.equipment-menu-category h3 a {
  color: #161616;
  text-decoration: none;
  transition: color 0.2s ease;
  display: block;
}

.equipment-menu-category h3 a:hover {
  color: #DC2626;
}

.equipment-menu-category ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.equipment-menu-category li {
  margin-bottom: 8px;
}

.equipment-menu-category a {
  color: #6B7280;
  text-decoration: none;
  font-size: 14px;
  transition: color 0.2s ease;
  display: block;
  padding: 4px 0;
}

.equipment-menu-category a:hover {
  color: #DC2626;
}

/* Responsive styles for Equipment menu */
@media (max-width: 480px) {
  .equipment-mega-menu {
    width: 100%;
    padding: 16px 16px 0 16px;
    border-radius: 8px;
    margin-top: 6px;
  }
  
  .equipment-mega-grid {
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }
  
  .equipment-menu-category {
    margin-bottom: 16px;
  }
  
  .equipment-menu-category h3 {
    font-size: 16px;
    margin-bottom: 8px;
  }
  
  .equipment-menu-category a {
    font-size: 13px;
  }
}

@media (min-width: 481px) and (max-width: 768px) {
  .equipment-mega-menu {
    width: 95%;
    padding: 18px 18px 0 18px;
    border-radius: 10px;
    margin-top: 7px;
  }
  
  .equipment-mega-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-bottom: 18px;
  }
  
  .equipment-menu-category {
    margin-bottom: 18px;
  }
  
  .equipment-menu-category h3 {
    font-size: 16px;
    margin-bottom: 10px;
  }
  
  .equipment-menu-category a {
    font-size: 13px;
  }
}

@media (min-width: 769px) and (max-width: 1023px) {
  .equipment-mega-menu {
    width: 95%;
    max-width: 1200px;
    padding: 20px 20px 0 20px;
    border-radius: 10px;
    margin-top: 7px;
  }
  
  .equipment-mega-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 20px;
  }
  
  .equipment-menu-category {
    margin-bottom: 20px;
  }
  
  .equipment-menu-category h3 {
    font-size: 17px;
    margin-bottom: 10px;
  }
  
  .equipment-menu-category a {
    font-size: 13px;
  }
}

@media (min-width: 1024px) and (max-width: 1279px) {
  .equipment-mega-menu {
    width: 95%;
    max-width: 1300px;
    padding: 24px 24px 0 24px;
    border-radius: 11px;
    margin-top: 8px;
  }
  
  .equipment-mega-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 24px;
  }
  
  .equipment-menu-category {
    margin-bottom: 22px;
  }
  
  .equipment-menu-category h3 {
    font-size: 17px;
    margin-bottom: 11px;
  }
  
  .equipment-menu-category a {
    font-size: 13px;
  }
}

@media (min-width: 1280px) and (max-width: 1919px) {
  .equipment-mega-menu {
    width: 95%;
    padding: 28px 28px 0 28px;
    border-radius: 12px;
    margin-top: 8px;
  }
  
  .equipment-mega-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 28px;
    margin-bottom: 28px;
  }
  
  .equipment-menu-category {
    margin-bottom: 22px;
  }
  
  .equipment-menu-category h3 {
    font-size: 17px;
    margin-bottom: 11px;
  }
  
  .equipment-menu-category a {
    font-size: 13px;
  }
}

@media (min-width: 1920px) {
  .equipment-mega-menu {
    width: 1654px;
    padding: 49px 77px 0 77px;
    border-radius: 12px;
    margin-top: 8px;
  }
  
  .equipment-mega-grid {
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
    margin-bottom: 32px;
  }
  
  .equipment-menu-category {
    margin-bottom: 24px;
  }
  
  .equipment-menu-category h3 {
    font-size: 18px;
    margin-bottom: 12px;
  }
  
  .equipment-menu-category a {
    font-size: 14px;
  }
}
</style>
