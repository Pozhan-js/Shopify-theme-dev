<div class="dropdown has-mega-menu">
  <span class="nav-item dropdown-trigger" style="cursor: pointer;">
    <span>{{ link.title | escape }}</span>
    <span class="dropdown-arrow"></span>
  </span>
  <div class="mega-dropdown-menu equipment-mega-menu">
    <div class="mega-menu-grid equipment-mega-grid">
      {% comment %} 获取产品系列配置 {% endcomment %}
      {% assign products_per_collection = section.settings.products_per_collection | default: 6 %}
      {% assign collections_per_column = section.settings.collections_per_column | default: 2 %}
      
      {% comment %} 创建自定义排序的系列数组 {% endcomment %}
      {% assign custom_collection_handles = '' %}
      
      {% comment %} 获取所有自定义系列配置 {% endcomment %}
      {% for block in section.blocks %}
        {% if block.type == 'equipment_config' and block.settings.collection_handle != blank %}
          {% comment %} 将输入的标识符转换为正确的handle格式 {% endcomment %}
          {% assign input_handle = block.settings.collection_handle | strip | downcase | replace: ' ', '-' | replace: '&', 'and' %}
          {% assign custom_collection_handles = custom_collection_handles | append: input_handle %}
          {% unless forloop.last %}
            {% assign custom_collection_handles = custom_collection_handles | append: ',' %}
          {% endunless %}
        {% endif %}
      {% endfor %}
      
      {% assign collection_handles_array = custom_collection_handles | split: ',' %}
      
      {% comment %} 如果有自定义配置，使用自定义顺序；否则使用默认顺序 {% endcomment %}
      {% if collection_handles_array.size > 0 %}
        {% assign total_collections = collection_handles_array.size %}
        
        {% comment %} 第一列：显示前2个系列 {% endcomment %}
        <div class="mega-menu-column equipment-menu-column">
          {% for i in (0..1) %}
            {% if i < total_collections %}
              {% assign collection_handle = collection_handles_array[i] %}
              
              {% comment %} 尝试多种方式匹配系列 {% endcomment %}
              {% assign collection = collections[collection_handle] %}
              {% unless collection %}
                {% comment %} 如果直接匹配失败，尝试通过标题匹配 {% endcomment %}
                {% for coll in collections %}
                  {% assign coll_handle_from_title = coll.title | strip | downcase | replace: ' ', '-' | replace: '&', 'and' %}
                  {% if coll_handle_from_title == collection_handle %}
                    {% assign collection = coll %}
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endunless %}
              
              {% if collection and collection.handle != 'all' %}
                {% comment %} 查找当前系列的自定义配置 {% endcomment %}
                {% assign custom_title = '' %}
                {% assign custom_product_handles = '' %}
                {% assign custom_products_limit = products_per_collection %}
                
                {% for block in section.blocks %}
                  {% if block.type == 'equipment_config' %}
                    {% assign block_handle = block.settings.collection_handle | strip | downcase | replace: ' ', '-' | replace: '&', 'and' %}
                    {% assign collection_handle_from_title = collection.title | strip | downcase | replace: ' ', '-' | replace: '&', 'and' %}
                    {% if block_handle == collection.handle or block_handle == collection_handle_from_title %}
                      {% assign custom_title = block.settings.custom_title %}
                      {% assign custom_product_handles = block.settings.product_handles %}
                      {% assign custom_products_limit = block.settings.products_limit | default: products_per_collection %}
                      {% break %}
                    {% endif %}
                  {% endif %}
                {% endfor %}

                <div class="mega-menu-category equipment-menu-category">
                  {% comment %} 显示标题的优先级：自定义标题 > 系列标题 {% endcomment %}
                  {% assign display_title = custom_title %}
                  {% if display_title == blank %}
                    {% assign display_title = collection.title %}
                  {% endif %}
                  
                  <h3><a href="{{ collection.url }}">{{ display_title | escape }}</a></h3>
                  <ul>
                    {% if collection.products.size > 0 %}
                      {% comment %} 如果有自定义产品顺序，使用自定义顺序 {% endcomment %}
                      {% if custom_product_handles != blank %}
                        {% assign product_handles_list = custom_product_handles | strip | split: ',' %}
                        {% assign products_displayed = 0 %}
                        
                        {% for product_handle_raw in product_handles_list %}
                          {% if products_displayed >= custom_products_limit %}
                            {% break %}
                          {% endif %}
                          
                          {% assign product_handle = product_handle_raw | strip %}
                          {% assign found_product = null %}
                          
                          {% comment %} 在当前系列中查找产品 {% endcomment %}
                          {% for product in collection.products %}
                            {% if product.handle == product_handle %}
                              {% assign found_product = product %}
                              {% break %}
                            {% endif %}
                          {% endfor %}
                          
                          {% if found_product %}
                            <li><a href="{{ found_product.url }}">{{ found_product.title | escape }}</a></li>
                            {% assign products_displayed = products_displayed | plus: 1 %}
                          {% endif %}
                        {% endfor %}
                        
                        {% comment %} 如果自定义产品不足，补充其他产品 {% endcomment %}
                        {% if products_displayed < custom_products_limit %}
                          {% for product in collection.products %}
                            {% if products_displayed >= custom_products_limit %}
                              {% break %}
                            {% endif %}
                            
                            {% assign is_already_displayed = false %}
                            {% for product_handle_raw in product_handles_list %}
                              {% assign product_handle = product_handle_raw | strip %}
                              {% if product.handle == product_handle %}
                                {% assign is_already_displayed = true %}
                                {% break %}
                              {% endif %}
                            {% endfor %}
                            
                            {% unless is_already_displayed %}
                              <li><a href="{{ product.url }}">{{ product.title | escape }}</a></li>
                              {% assign products_displayed = products_displayed | plus: 1 %}
                            {% endunless %}
                          {% endfor %}
                        {% endif %}
                      {% else %}
                        {% comment %} 使用默认产品顺序 {% endcomment %}
                        {% for product in collection.products limit: custom_products_limit %}
                          <li><a href="{{ product.url }}">{{ product.title | escape }}</a></li>
                        {% endfor %}
                      {% endif %}
                    {% else %}
                      <li><a href="{{ collection.url }}">View {{ display_title }}</a></li>
                    {% endif %}
                  </ul>
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>

        {% comment %} 第二列：显示第3-5个系列（3个系列） {% endcomment %}
        <div class="mega-menu-column equipment-menu-column">
          {% for i in (2..4) %}
            {% if i < total_collections %}
              {% assign collection_handle = collection_handles_array[i] %}
              
              {% comment %} 尝试多种方式匹配系列 {% endcomment %}
              {% assign collection = collections[collection_handle] %}
              {% unless collection %}
                {% comment %} 如果直接匹配失败，尝试通过标题匹配 {% endcomment %}
                {% for coll in collections %}
                  {% assign coll_handle_from_title = coll.title | strip | downcase | replace: ' ', '-' | replace: '&', 'and' %}
                  {% if coll_handle_from_title == collection_handle %}
                    {% assign collection = coll %}
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endunless %}
              
              {% if collection and collection.handle != 'all' %}
                {% comment %} 查找当前系列的自定义配置 {% endcomment %}
                {% assign custom_title = '' %}
                {% assign custom_product_handles = '' %}
                {% assign custom_products_limit = products_per_collection %}
                
                {% for block in section.blocks %}
                  {% if block.type == 'equipment_config' %}
                    {% assign block_handle = block.settings.collection_handle | strip | downcase | replace: ' ', '-' | replace: '&', 'and' %}
                    {% assign collection_handle_from_title = collection.title | strip | downcase | replace: ' ', '-' | replace: '&', 'and' %}
                    {% if block_handle == collection.handle or block_handle == collection_handle_from_title %}
                      {% assign custom_title = block.settings.custom_title %}
                      {% assign custom_product_handles = block.settings.product_handles %}
                      {% assign custom_products_limit = block.settings.products_limit | default: products_per_collection %}
                      {% break %}
                    {% endif %}
                  {% endif %}
                {% endfor %}

                <div class="mega-menu-category equipment-menu-category">
                  {% comment %} 显示标题的优先级：自定义标题 > 系列标题 {% endcomment %}
                  {% assign display_title = custom_title %}
                  {% if display_title == blank %}
                    {% assign display_title = collection.title %}
                  {% endif %}
                  
                  <h3><a href="{{ collection.url }}">{{ display_title | escape }}</a></h3>
                  <ul>
                    {% if collection.products.size > 0 %}
                      {% comment %} 如果有自定义产品顺序，使用自定义顺序 {% endcomment %}
                      {% if custom_product_handles != blank %}
                        {% assign product_handles_list = custom_product_handles | strip | split: ',' %}
                        {% assign products_displayed = 0 %}
                        
                        {% for product_handle_raw in product_handles_list %}
                          {% if products_displayed >= custom_products_limit %}
                            {% break %}
                          {% endif %}
                          
                          {% assign product_handle = product_handle_raw | strip %}
                          {% assign found_product = null %}
                          
                          {% comment %} 在当前系列中查找产品 {% endcomment %}
                          {% for product in collection.products %}
                            {% if product.handle == product_handle %}
                              {% assign found_product = product %}
                              {% break %}
                            {% endif %}
                          {% endfor %}
                          
                          {% if found_product %}
                            <li><a href="{{ found_product.url }}">{{ found_product.title | escape }}</a></li>
                            {% assign products_displayed = products_displayed | plus: 1 %}
                          {% endif %}
                        {% endfor %}
                        
                        {% comment %} 如果自定义产品不足，补充其他产品 {% endcomment %}
                        {% if products_displayed < custom_products_limit %}
                          {% for product in collection.products %}
                            {% if products_displayed >= custom_products_limit %}
                              {% break %}
                            {% endif %}
                            
                            {% assign is_already_displayed = false %}
                            {% for product_handle_raw in product_handles_list %}
                              {% assign product_handle = product_handle_raw | strip %}
                              {% if product.handle == product_handle %}
                                {% assign is_already_displayed = true %}
                                {% break %}
                              {% endif %}
                            {% endfor %}
                            
                            {% unless is_already_displayed %}
                              <li><a href="{{ product.url }}">{{ product.title | escape }}</a></li>
                              {% assign products_displayed = products_displayed | plus: 1 %}
                            {% endunless %}
                          {% endfor %}
                        {% endif %}
                      {% else %}
                        {% comment %} 使用默认产品顺序 {% endcomment %}
                        {% for product in collection.products limit: custom_products_limit %}
                          <li><a href="{{ product.url }}">{{ product.title | escape }}</a></li>
                        {% endfor %}
                      {% endif %}
                    {% else %}
                      <li><a href="{{ collection.url }}">View {{ display_title }}</a></li>
                    {% endif %}
                  </ul>
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>

        {% comment %} 第三列：显示剩余系列 {% endcomment %}
        <div class="mega-menu-column equipment-menu-column">
          {% for i in (5..11) %}
            {% if i < total_collections %}
              {% assign collection_handle = collection_handles_array[i] %}
              
              {% comment %} 尝试多种方式匹配系列 {% endcomment %}
              {% assign collection = collections[collection_handle] %}
              {% unless collection %}
                {% comment %} 如果直接匹配失败，尝试通过标题匹配 {% endcomment %}
                {% for coll in collections %}
                  {% assign coll_handle_from_title = coll.title | strip | downcase | replace: ' ', '-' | replace: '&', 'and' %}
                  {% if coll_handle_from_title == collection_handle %}
                    {% assign collection = coll %}
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endunless %}
              
              {% if collection and collection.handle != 'all' %}
                {% comment %} 查找当前系列的自定义配置 {% endcomment %}
                {% assign custom_title = '' %}
                {% assign custom_product_handles = '' %}
                {% assign custom_products_limit = products_per_collection %}
                
                {% for block in section.blocks %}
                  {% if block.type == 'equipment_config' %}
                    {% assign block_handle = block.settings.collection_handle | strip | downcase | replace: ' ', '-' | replace: '&', 'and' %}
                    {% assign collection_handle_from_title = collection.title | strip | downcase | replace: ' ', '-' | replace: '&', 'and' %}
                    {% if block_handle == collection.handle or block_handle == collection_handle_from_title %}
                      {% assign custom_title = block.settings.custom_title %}
                      {% assign custom_product_handles = block.settings.product_handles %}
                      {% assign custom_products_limit = block.settings.products_limit | default: products_per_collection %}
                      {% break %}
                    {% endif %}
                  {% endif %}
                {% endfor %}

                <div class="mega-menu-category equipment-menu-category">
                  {% comment %} 显示标题的优先级：自定义标题 > 系列标题 {% endcomment %}
                  {% assign display_title = custom_title %}
                  {% if display_title == blank %}
                    {% assign display_title = collection.title %}
                  {% endif %}
                  
                  <h3><a href="{{ collection.url }}">{{ display_title | escape }}</a></h3>
                  <ul>
                    {% if collection.products.size > 0 %}
                      {% comment %} 如果有自定义产品顺序，使用自定义顺序 {% endcomment %}
                      {% if custom_product_handles != blank %}
                        {% assign product_handles_list = custom_product_handles | strip | split: ',' %}
                        {% assign products_displayed = 0 %}
                        
                        {% for product_handle_raw in product_handles_list %}
                          {% if products_displayed >= custom_products_limit %}
                            {% break %}
                          {% endif %}
                          
                          {% assign product_handle = product_handle_raw | strip %}
                          {% assign found_product = null %}
                          
                          {% comment %} 在当前系列中查找产品 {% endcomment %}
                          {% for product in collection.products %}
                            {% if product.handle == product_handle %}
                              {% assign found_product = product %}
                              {% break %}
                            {% endif %}
                          {% endfor %}
                          
                          {% if found_product %}
                            <li><a href="{{ found_product.url }}">{{ found_product.title | escape }}</a></li>
                            {% assign products_displayed = products_displayed | plus: 1 %}
                          {% endif %}
                        {% endfor %}
                        
                        {% comment %} 如果自定义产品不足，补充其他产品 {% endcomment %}
                        {% if products_displayed < custom_products_limit %}
                          {% for product in collection.products %}
                            {% if products_displayed >= custom_products_limit %}
                              {% break %}
                            {% endif %}
                            
                            {% assign is_already_displayed = false %}
                            {% for product_handle_raw in product_handles_list %}
                              {% assign product_handle = product_handle_raw | strip %}
                              {% if product.handle == product_handle %}
                                {% assign is_already_displayed = true %}
                                {% break %}
                              {% endif %}
                            {% endfor %}
                            
                            {% unless is_already_displayed %}
                              <li><a href="{{ product.url }}">{{ product.title | escape }}</a></li>
                              {% assign products_displayed = products_displayed | plus: 1 %}
                            {% endunless %}
                          {% endfor %}
                        {% endif %}
                      {% else %}
                        {% comment %} 使用默认产品顺序 {% endcomment %}
                        {% for product in collection.products limit: custom_products_limit %}
                          <li><a href="{{ product.url }}">{{ product.title | escape }}</a></li>
                        {% endfor %}
                      {% endif %}
                    {% else %}
                      <li><a href="{{ collection.url }}">View {{ display_title }}</a></li>
                    {% endif %}
                  </ul>
                </div>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      {% else %}
        {% comment %} 如果没有自定义配置，使用默认系列顺序 {% endcomment %}
        {% assign column_count = 0 %}
        {% assign items_in_column = 0 %}
        
        {% for collection in collections %}
          {% if items_in_column == 0 %}
            <div class="mega-menu-column equipment-menu-column">
          {% endif %}
          
          <div class="mega-menu-category equipment-menu-category">
            <h3><a href="{{ collection.url }}">{{ collection.title | escape }}</a></h3>
            <ul>
              {% if collection.products.size > 0 %}
                {% for product in collection.products limit: products_per_collection %}
                  <li><a href="{{ product.url }}">{{ product.title | escape }}</a></li>
                {% endfor %}
              {% else %}
                <li><a href="{{ collection.url }}">View {{ collection.title }}</a></li>
              {% endif %}
            </ul>
          </div>
          
          {% assign items_in_column = items_in_column | plus: 1 %}
          
          {% if items_in_column >= collections_per_column or forloop.last %}
            </div>
            {% assign items_in_column = 0 %}
            {% assign column_count = column_count | plus: 1 %}
            {% if column_count >= 3 %}
              {% break %}
            {% endif %}
          {% endif %}
        {% endfor %}
      {% endif %}
      
      <div class="mega-menu-column equipment-menu-column">
        <div class="nav-mega-cta-container">
          {% if section.settings.nav_cta_image %}
            <img src="{{ section.settings.nav_cta_image | image_url: width: 800 }}" alt="{{ section.settings.nav_cta_image_alt | default: 'Premium Equipment' }}" class="nav-mega-cta-image" />
          {% elsif section.settings.mega_menu_image %}
            <img src="{{ section.settings.mega_menu_image | image_url: width: 800 }}" alt="{{ section.settings.mega_menu_image_alt | default: 'Pilates Equipment' }}" class="nav-mega-cta-image" />
          {% else %}
            <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=800&h=1200&fit=crop&crop=center" alt="Pilates Equipment" class="nav-mega-cta-image" />
          {% endif %}
          <div class="nav-mega-cta-bottom-overlay">
            <div class="nav-mega-cta-overlay-title">{{ section.settings.cta_title | default: 'Premium Equipment' }}</div>
            <div class="nav-mega-cta-bottom-row">
              <div class="nav-mega-cta-overlay-subtitle">{{ section.settings.cta_subtitle | default: 'Discover our professional-grade Pilates equipment' }}</div>
              <a href="{{ section.settings.download_file_url | default: '#' }}" class="nav-mega-cta-download-btn" download>
                <div class="nav-mega-cta-download-icon">
                  {% if section.settings.download_icon %}
                    <img src="{{ section.settings.download_icon | image_url: width: 32 }}" alt="Download">
                  {% else %}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                      <polyline points="7,10 12,15 17,10"></polyline>
                      <line x1="12" y1="15" x2="12" y2="3"></line>
                    </svg>
                  {% endif %}
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <a href="{{ section.settings.mega_menu_footer_link | default: section.settings.contactlink | default: '/pages/contact' }}" class="mega-menu-footer">
      {% if section.settings.contactfootericon %}
        <div class="mega-menu-footer-icon">
          <img src="{{ section.settings.contactfootericon | image_url: width: 44 }}" alt="Contact Icon">
        </div>
      {% endif %}
      <span>{{ section.settings.mega_menu_footer_text | default: 'CONTACT US' }}</span>
    </a>
  </div>
</div>

<style>
/* Equipment Mega Menu Specific Styles */
.equipment-mega-menu {
  background: #FFFCFC;
  border: 1px solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
  position: fixed;
  top: 100%;
  left: 50%;
  transform: translateX(-50%);
  margin-top: 8px;
  width: 100%;
  border-radius: 12px;
  opacity: 0;
  visibility: hidden;
  transition: all 0.2s ease;
  padding: 32px 32px 0 32px;
  z-index: 1000;
}

.equipment-mega-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
  height: 100%;
  margin-bottom: 32px;
}

.equipment-menu-column {
  display: flex;
  flex-direction: column;
}

.equipment-menu-category {
  margin-bottom: 24px;
}

.equipment-menu-category h3 {
  font-size: 18px;
  font-weight: 600;
  color: #161616;
  margin-bottom: 12px;
  padding-bottom: 8px;
  position: relative;
}

.equipment-menu-category h3 a {
  color: #161616;
  text-decoration: none;
  transition: color 0.2s ease;
  display: block;
}

.equipment-menu-category h3 a:hover {
  color: #DC2626;
}

.equipment-menu-category ul {
  list-style: none;
  padding: 0;
  margin: 0;
}

.equipment-menu-category li {
  margin-bottom: 8px;
}

.equipment-menu-category a {
  color: #6B7280;
  text-decoration: none;
  font-size: 14px;
  transition: color 0.2s ease;
  display: block;
  padding: 4px 0;
}

.equipment-menu-category a:hover {
  color: #DC2626;
}

/* Responsive styles for Equipment menu */
@media (max-width: 480px) {
  .equipment-mega-menu {
    width: 100%;
    padding: 16px 16px 0 16px;
    border-radius: 8px;
    margin-top: 6px;
  }
  
  .equipment-mega-grid {
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }
  
  .equipment-menu-category {
    margin-bottom: 16px;
  }
  
  .equipment-menu-category h3 {
    font-size: 16px;
    margin-bottom: 8px;
  }
  
  .equipment-menu-category a {
    font-size: 13px;
  }
}

@media (min-width: 481px) and (max-width: 768px) {
  .equipment-mega-menu {
    width: 95%;
    padding: 18px 18px 0 18px;
    border-radius: 10px;
    margin-top: 7px;
  }
  
  .equipment-mega-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
    margin-bottom: 18px;
  }
  
  .equipment-menu-category {
    margin-bottom: 18px;
  }
  
  .equipment-menu-category h3 {
    font-size: 16px;
    margin-bottom: 10px;
  }
  
  .equipment-menu-category a {
    font-size: 13px;
  }
}

@media (min-width: 769px) and (max-width: 1023px) {
  .equipment-mega-menu {
