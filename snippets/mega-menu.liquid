<div class="dropdown has-mega-menu">
  <span class="nav-item dropdown-trigger" style="cursor: pointer;">
    <span>{{ link.title | escape }}</span>
    <span class="dropdown-arrow"></span>
  </span>
  <div class="mega-dropdown-menu">
    <div class="mega-menu-grid">
      {% for block in section.blocks %}
        {% if block.type == 'mega_menu_category' %}
          <div class="mega-menu-column">
            <div class="mega-menu-category">
              <h3>{{ block.settings.category_title }}</h3>
              <ul>
                {% for i in (1..6) %}
                  {% assign item_title_key = 'item_' | append: i | append: '_title' %}
                  {% assign item_url_key = 'item_' | append: i | append: '_url' %}
                  {% assign item_title = block.settings[item_title_key] %}
                  {% assign item_url = block.settings[item_url_key] %}
                  {% if item_title != blank %}
                    <li><a href="{{ item_url | default: '#' }}">{{ item_title }}</a></li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          </div>
        {% endif %}
      {% endfor %}
      
      <!-- 如果没有配置 blocks，显示空白，不显示默认内容 -->
      
      <!-- CTA Column -->
      <div class="mega-menu-column">
        <div class="nav-mega-cta-container">
          {% if section.settings.mega_menu_image %}
            <img src="{{ section.settings.mega_menu_image | image_url: width: 800 }}" alt="{{ section.settings.mega_menu_image_alt | default: 'Featured Image' }}" class="nav-mega-cta-image" />
          {% else %}
            {% if menu_type == 'equipment' %}
              <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=800&h=1200&fit=crop&crop=center" alt="Pilates Equipment" class="nav-mega-cta-image" />
            {% elsif menu_type == 'resources' %}
              <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=800&h=1200&fit=crop&crop=center" alt="Pilates Resources" class="nav-mega-cta-image" />
            {% elsif menu_type == 'about' %}
              <img src="https://images.unsplash.com/photo-1560472354-b33ff0c44a43?w=800&h=1200&fit=crop&crop=center" alt="About XS Pilates" class="nav-mega-cta-image" />
            {% endif %}
          {% endif %}
          <div class="nav-mega-cta-bottom-overlay">
            <div class="nav-mega-cta-overlay-title">{{ section.settings.cta_title | default: 'Premium Equipment' }}</div>
            <div class="nav-mega-cta-bottom-row">
              <div class="nav-mega-cta-overlay-subtitle">{{ section.settings.cta_subtitle | default: 'Discover our professional-grade Pilates equipment' }}</div>
              {% if section.settings.enable_download_button and section.settings.download_file_url != blank %}
                <a href="{{ section.settings.download_file_url }}" class="nav-mega-cta-download-btn" download>
                  <div class="nav-mega-cta-download-icon">
                    {% if section.settings.download_icon %}
                      <img src="{{ section.settings.download_icon | image_url: width: 32 }}" alt="Download">
                    {% else %}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7,10 12,15 17,10"></polyline>
                        <line x1="12" y1="15" x2="12" y2="3"></line>
                      </svg>
                    {% endif %}
                  </div>
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="mega-menu-footer">
      {% if section.settings.contactfootericon %}
        <div class="mega-menu-footer-icon">
          <img src="{{ section.settings.contactfootericon | image_url: width: 44 }}" alt="Contact Icon">
        </div>
      {% endif %}
      <span>{{ section.settings.mega_menu_footer_text | default: 'CONTACT US' }}</span>
    </div>
  </div>
</div>
