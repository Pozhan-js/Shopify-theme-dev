<div class="dropdown has-mega-menu">
  <span class="nav-item dropdown-trigger" style="cursor: pointer;">
    <span>{{ link.title | escape }}</span>
    <span class="dropdown-arrow"></span>
  </span>
  <div class="mega-dropdown-menu resources-mega-menu">
    <div class="resources-mega-grid">
      <!-- Left Column - Menu Items -->
      <div class="resources-menu-column">
        <div class="resources-menu-list">
          {% comment %} 动态渲染菜单项 {% endcomment %}
          {% for block in section.blocks %}
            {% if block.type == 'resources_menu_item' and block.settings.menu_text != blank %}
              <a href="{{ block.settings.menu_url | default: '#' }}" class="resources-menu-item">{{ block.settings.menu_text }}</a>
            {% endif %}
          {% endfor %}
          
          {% comment %} 如果没有配置任何菜单项，显示默认菜单 {% endcomment %}
          {% assign resources_menu_count = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'resources_menu_item' and block.settings.menu_text != blank %}
              {% assign resources_menu_count = resources_menu_count | plus: 1 %}
            {% endif %}
          {% endfor %}
          
          {% if resources_menu_count == 0 %}
            <a href="/blogs/news" class="resources-menu-item">Blog</a>
            <a href="/pages/customer-stories" class="resources-menu-item">Customer Story</a>
            <a href="/pages/certificates" class="resources-menu-item">Certificates</a>
            <a href="/pages/faqs" class="resources-menu-item">FAQs</a>
            <a href="/pages/aftersales" class="resources-menu-item">Aftersales</a>
            <a href="/pages/support" class="resources-menu-item">Support</a>
          {% endif %}
        </div>
      </div>
      
      <!-- Cards Container -->
      <div class="resources-cards-container">
        <!-- Blog Card -->
        <div class="resources-content-column">
          <a href="{{ section.settings.resources_blog_url | default: '/blogs/news' }}" class="resources-blog-card" 
             style="background-image: url('{% if section.settings.resources_blog_image %}{{ section.settings.resources_blog_image | image_url: width: 498 }}{% else %}https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=498&h=394&fit=crop&crop=center{% endif %}');">
            <div class="resources-blog-tag">
              {% comment %} 获取第一个菜单项的文本作为标签 {% endcomment %}
              {% assign first_menu_text = '' %}
              {% for block in section.blocks %}
                {% if block.type == 'resources_menu_item' and block.settings.menu_text != blank %}
                  {% assign first_menu_text = block.settings.menu_text %}
                  {% break %}
                {% endif %}
              {% endfor %}
              {{ first_menu_text | default: 'Blog' }}
            </div>
            <div class="resources-blog-content">
              <h3 class="resources-blog-title">{{ section.settings.resources_blog_title | default: '4 Exercises to Relieve Lower Back Pain' }}</h3>
              <p class="resources-blog-description">{{ section.settings.resources_blog_description | default: 'Stop stretching your back! Learn 4 science-backed moves to fix the real cause of your chronic pain.' }}</p>
            </div>
            <div class="resources-blog-arrow">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        </div>
        
        <!-- Customer Story Card -->
        <div class="resources-story-column">
          <a href="{{ section.settings.resources_story_url | default: '/pages/customer-stories' }}" class="resources-story-card"
             style="background-image: url('{% if section.settings.resources_story_image %}{{ section.settings.resources_story_image | image_url: width: 498 }}{% else %}https://images.unsplash.com/photo-1599305445671-ac291c95aaa9?w=498&h=394&fit=crop&crop=center{% endif %}');">
            <div class="resources-story-tag">
              {% comment %} 获取第二个菜单项的文本作为标签 {% endcomment %}
              {% assign second_menu_text = '' %}
              {% assign menu_counter = 0 %}
              {% for block in section.blocks %}
                {% if block.type == 'resources_menu_item' and block.settings.menu_text != blank %}
                  {% assign menu_counter = menu_counter | plus: 1 %}
                  {% if menu_counter == 2 %}
                    {% assign second_menu_text = block.settings.menu_text %}
                    {% break %}
                  {% endif %}
                {% endif %}
              {% endfor %}
              {{ second_menu_text | default: 'Customer Story' }}
            </div>
            <div class="resources-story-content">
              <p class="resources-story-text">{{ section.settings.resources_story_title | default: 'XS Pilates Equipment delivers durable, ergonomic gear trusted by studios for quality Pilates training.' }}</p>
            </div>
            <div class="resources-story-arrow">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        </div>
      </div>
    </div>
    
    <a href="{{ section.settings.mega_menu_footer_link | default: section.settings.contactlink | default: '/pages/contact' }}" class="mega-menu-footer">
      {% if section.settings.contactfootericon %}
        <div class="mega-menu-footer-icon">
          <img src="{{ section.settings.contactfootericon | image_url: width: 44 }}" alt="Contact Icon">
        </div>
      {% endif %}
      <span>{{ section.settings.mega_menu_footer_text | default: 'CONTACT US' }}</span>
    </a>
  </div>
</div>

