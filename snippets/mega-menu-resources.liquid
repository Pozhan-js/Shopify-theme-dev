<div class="dropdown has-mega-menu">
  <span class="nav-item dropdown-trigger" style="cursor: pointer;">
    <span>{{ link.title | escape }}</span>
    <span class="dropdown-arrow"></span>
  </span>
  <div class="mega-dropdown-menu resources-mega-menu">
    <div class="resources-mega-grid">
      <!-- Left Column - Menu Items -->
      <div class="resources-menu-column">
        <div class="resources-menu-list">
          <a href="/blogs/news" class="resources-menu-item">Blog</a>
          <a href="/pages/customer-stories" class="resources-menu-item">Customer Story</a>
          <a href="/pages/certificates" class="resources-menu-item">Certificates</a>
          <a href="/pages/faqs" class="resources-menu-item">FAQs</a>
          <a href="/pages/aftersales" class="resources-menu-item">Aftersales</a>
          <a href="/pages/support" class="resources-menu-item">Support</a>
        </div>
      </div>
      
      <!-- Center Column - Blog Card -->
      <div class="resources-content-column">
        <div class="resources-blog-card">
          <div class="resources-blog-tag">Blog</div>
          <div class="resources-blog-images">
            <img src="https://images.unsplash.com/photo-1544367567-0f2fcb009e0b?w=400&h=240&fit=crop&crop=center" alt="Pilates Exercise" class="resources-blog-image" />
          </div>
          <div class="resources-blog-content">
            <h3 class="resources-blog-title">4 Exercises to Relieve Lower Back Pain</h3>
            <p class="resources-blog-description">Stop stretching your back! Learn 4 science-backed moves to fix the real cause of your chronic pain.</p>
          </div>
          <button class="resources-blog-arrow">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
      
      <!-- Right Column - Customer Story Card -->
      <div class="resources-story-column">
        <div class="resources-story-card">
          <div class="resources-story-tag">Customer Story</div>
          <div class="resources-story-logo">
            <img src="https://images.unsplash.com/photo-1599305445671-ac291c95aaa9?w=200&h=100&fit=crop&crop=center" alt="XS Pilates Logo" class="resources-logo-image" />
          </div>
          <div class="resources-story-content">
            <p class="resources-story-text">XS Pilates Equipment delivers durable, ergonomic gear trusted by studios for quality Pilates training.</p>
          </div>
          <button class="resources-story-arrow">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
    
    <div class="mega-menu-footer">
      {% if section.settings.contactfootericon %}
        <div class="mega-menu-footer-icon">
          <img src="{{ section.settings.contactfootericon | image_url: width: 44 }}" alt="Contact Icon">
        </div>
      {% endif %}
      <span>{{ section.settings.mega_menu_footer_text | default: 'CONTACT US' }}</span>
    </div>
  </div>
</div>

