<article class="blog-post-card" data-article-id="{{ article.id }}" data-category="{{ article.tags | first }}">
  <div class="post-card-inner">
    <!-- 文章图片 -->
    <div class="post-image-wrapper">
      <a href="{{ article.url }}" class="post-image-link">
        {% if article.image %}
          <img src="{{ article.image | image_url: width: 600 }}" 
               alt="{{ article.title | escape }}"
               class="post-image"
               loading="lazy">
        {% else %}
          <div class="no-image-placeholder">
            <svg width="60" height="60" viewBox="0 0 60 60">
              <rect width="60" height="60" fill="#f0f0f0"/>
              <path d="M20 20h20v20H20z" fill="#ddd"/>
              <text x="30" y="35" text-anchor="middle" fill="#999" font-size="8">Blog</text>
            </svg>
          </div>
        {% endif %}
      </a>
      
      <!-- 文章标签 -->
      {% if show_tags and article.tags.size > 0 %}
        <div class="post-tags">
          {% for tag in article.tags limit: 2 %}
            <span class="post-tag">{{ tag }}</span>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- 文章内容 -->
    <div class="post-content">
      <!-- 文章元信息 -->
      <div class="post-meta">
        {% if show_author and article.author %}
          <span class="post-author">
            <svg width="14" height="14" viewBox="0 0 14 14">
              <circle cx="7" cy="4" r="2" fill="currentColor"/>
              <path d="M7 8c-2.5 0-5 1.5-5 3v1h10v-1c0-1.5-2.5-3-5-3z" fill="currentColor"/>
            </svg>
            {{ article.author }}
          </span>
        {% endif %}
        
        {% if show_date %}
          <span class="post-date">
            <svg width="14" height="14" viewBox="0 0 14 14">
              <rect x="2" y="3" width="10" height="8" rx="1" fill="none" stroke="currentColor"/>
              <line x1="5" y1="1" x2="5" y2="5" stroke="currentColor"/>
              <line x1="9" y1="1" x2="9" y2="5" stroke="currentColor"/>
            </svg>
            {{ article.published_at | date: "%B %d, %Y" }}
          </span>
        {% endif %}
      </div>

      <!-- 文章标题 -->
      <h3 class="post-title">
        <a href="{{ article.url }}">{{ article.title }}</a>
      </h3>

      <!-- 文章摘要 -->
      {% if show_excerpt and article.excerpt != blank %}
        <div class="post-excerpt">
          {{ article.excerpt | truncate: excerpt_length | strip_html }}
        </div>
      {% elsif show_excerpt and article.content != blank %}
        <div class="post-excerpt">
          {{ article.content | strip_html | truncate: excerpt_length }}
        </div>
      {% endif %}

      <!-- 阅读更多链接 -->
      <div class="post-footer">
        <a href="{{ article.url }}" class="read-more-link">
          Read More
          <svg width="14" height="14" viewBox="0 0 14 14">
            <path d="M7.146 3.646a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L9.793 7 7.146 4.354a.5.5 0 0 1 0-.708z"/>
          </svg>
        </a>
        
        {% if article.comments_enabled? and article.comments_count > 0 %}
          <span class="comments-count">
            <svg width="14" height="14" viewBox="0 0 14 14">
              <path d="M2 2h10a1 1 0 0 1 1 1v6a1 1 0 0 1-1 1H4l-2 2V3a1 1 0 0 1 1-1z" fill="none" stroke="currentColor"/>
            </svg>
            {{ article.comments_count }} 
            {% if article.comments_count == 1 %}comment{% else %}comments{% endif %}
          </span>
        {% endif %}
      </div>
    </div>
  </div>
</article>
