<article class="blog-post-card" data-article-id="{{ article.id }}" data-category="{{ article.tags | first }}" data-blog-handle="{{ article.blog.handle }}" onclick="window.location.href='{{ article.url }}'">
  <div class="post-card-inner">
    <!-- 文章图片 -->
    <div class="post-image-wrapper">
      {% if article.image %}
        <img src="{{ article.image | image_url: width: 600 }}" 
             alt="{{ article.title | escape }}"
             class="post-image"
             loading="lazy">
      {% else %}
        <div class="no-image-placeholder">
          <svg width="60" height="60" viewBox="0 0 60 60">
            <rect width="60" height="60" fill="#f0f0f0"/>
            <path d="M20 20h20v20H20z" fill="#ddd"/>
            <text x="30" y="35" text-anchor="middle" fill="#999" font-size="8">Blog</text>
          </svg>
        </div>
      {% endif %}
      
      <!-- 文章标签 -->
      {% if show_tags and article.tags.size > 0 %}
        <div class="post-tags">
          {% for tag in article.tags limit: 2 %}
            <span class="post-tag">{{ tag }}</span>
          {% endfor %}
        </div>
      {% endif %}

      <!-- 博客来源标识 -->
      {% if article.blog.title != 'News' %}
        <div class="blog-source-badge">
          {{ article.blog.title }}
        </div>
      {% endif %}
    </div>

    <!-- 文章内容 - 显示在图片底部 -->
    <div class="post-content">
      <!-- 文章标题 -->
      <h3 class="post-title">
        <a href="{{ article.url }}">{{ article.title }}</a>
      </h3>

      <!-- 文章摘要 -->
      {% if show_excerpt %}
        <div class="post-excerpt">
          {% if article.excerpt != blank %}
            {{ article.excerpt | strip_html | truncate: excerpt_length }}
          {% elsif article.content != blank %}
            {{ article.content | strip_html | truncate: excerpt_length }}
          {% endif %}
        </div>
      {% endif %}

      <!-- 文章元信息 - 移到底部 -->
      <div class="post-meta">
        {% if show_date %}
          <span class="post-date">
            <svg width="12" height="12" viewBox="0 0 12 12">
              <rect x="1" y="2" width="10" height="8" rx="1" fill="none" stroke="currentColor"/>
              <line x1="4" y1="1" x2="4" y2="4" stroke="currentColor"/>
              <line x1="8" y1="1" x2="8" y2="4" stroke="currentColor"/>
            </svg>
            {{ article.published_at | date: "%B %d, %Y" }}
          </span>
        {% endif %}
        
        {% if show_author and article.author %}
          <span class="post-author">
            <svg width="12" height="12" viewBox="0 0 12 12">
              <circle cx="6" cy="3" r="2" fill="currentColor"/>
              <path d="M6 7c-2 0-4 1-4 2v1h8v-1c0-1-2-2-4-2z" fill="currentColor"/>
            </svg>
            {{ article.author }}
          </span>
        {% endif %}
      </div>
    </div>
  </div>
</article>
