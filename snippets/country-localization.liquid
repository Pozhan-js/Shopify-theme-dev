{%- comment -%}
  Renders the country picker for the localization form

  Accepts:
    - localPosition: pass in the position in which the form is coming up to create specific IDs
{%- endcomment -%}

{%- liquid
  assign currencies = localization.available_countries | map: 'currency' | map: 'iso_code' | uniq
  assign popular_countries = localization.available_countries | where: 'popular?' | sort: 'name'

  assign show_country_filter = false
  if localization.available_countries.size > 9
    assign show_country_filter = true
  endif

  assign show_popular_countries = false
  if localization.available_countries.size > 9 and popular_countries.size > 1
    assign show_popular_countries = true
  endif

  assign show_currencies = false
  if currencies.size > 1
    assign show_currencies = true
  endif
%}

<div class="disclosure">
  <button
    type="button"
    class="disclosure__button localization-form__select localization-selector link link--text caption-large"
    aria-expanded="false"
    aria-controls="{{ localPosition }}-country-results"
    aria-describedby="{{ localPosition }}Label"
    data-country-modal-trigger
  >
    <svg width="25" height="25" viewBox="0 0 100 100" aria-hidden="true" focusable="false" class="icon" style="max-width: 80px; max-height: 80px;margin-top:.5rem;">
      <path fill="#000" fill-rule="evenodd" d="M51.939 91.4758C51.4613 91.4919 50.9816 91.5 50.5 91.5C50.275 91.5 50.0504 91.4982 49.8262 91.4947C43.6748 84.9588 39.0998 77.176 36.3514 68.75H65.6132C62.8053 77.184 58.1632 84.9624 51.939 91.4758ZM63.0667 89.5877C73.835 86.2155 82.7377 78.6242 87.8386 68.75H73.3125C71.1194 76.2156 67.6599 83.2698 63.0667 89.5877ZM75.0627 61.25H90.8343C91.9186 57.5213 92.5 53.5786 92.5 49.5C92.5 45.7842 92.0175 42.1811 91.1116 38.75H75.2297C75.7925 42.283 76.0802 45.8767 76.0802 49.5C76.0802 53.4658 75.7355 57.396 75.0627 61.25ZM67.7771 38.75H34.367C33.694 42.3854 33.3485 46.1001 33.3485 49.851C33.3485 53.7045 33.7131 57.5197 34.423 61.25H67.5894C68.3438 57.4082 68.7317 53.4744 68.7317 49.5C68.7317 45.8697 68.4081 42.2733 67.7771 38.75ZM65.9365 31.25H36.255C39.0906 22.4029 43.9358 14.2545 50.5028 7.5C50.9835 7.50003 51.4623 7.50814 51.939 7.52419C58.4084 14.2942 63.1687 22.4309 65.9365 31.25ZM73.598 31.25H88.3384C83.3321 20.8892 74.1957 12.8975 63.0667 9.41232C67.8645 16.0116 71.4253 23.4142 73.598 31.25ZM28.6656 68.75C30.8487 76.3313 34.3353 83.4949 38.9872 89.9025C27.7467 86.7056 18.4278 78.9445 13.1614 68.75H28.6656ZM26 49.851C26 46.1076 26.3071 42.3958 26.9074 38.75H9.88836C8.98253 42.1811 8.5 45.7842 8.5 49.5C8.5 53.5786 9.08135 57.5213 10.1657 61.25H26.9571C26.3241 57.5085 26 53.6965 26 49.851ZM28.5806 31.25C30.8566 23.2084 34.5972 15.6304 39.6381 8.91806C27.7397 12.0946 17.9213 20.3648 12.6616 31.25H28.5806ZM100 49.5C100 76.8381 77.8381 99 50.5 99C23.1619 99 1 76.8381 1 49.5C1 22.1619 23.1619 0 50.5 0C77.8381 0 100 22.1619 100 49.5Z" clip-rule="evenodd"></path>
    </svg>
    {{ 'icon-caret.svg' | inline_asset_content }}
  </button>
  <div class="disclosure__list-wrapper country-selector" hidden style="display: none !important;">
    <div class="country-filter{% unless show_country_filter %} country-filter--no-padding{% endunless %}">
      {% if show_country_filter %}
        <div class="field">
          <input
            class="country-filter__input field__input"
            id="country-filter-input"
            type="search"
            name="country_filter"
            value=""
            placeholder="{{ 'localization.search' | t }}"
            role="combobox"
            aria-owns="country-results"
            aria-controls="country-results"
            aria-haspopup="listbox"
            aria-autocomplete="list"
            autocorrect="off"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
          >
          <label class="field__label" for="country-filter-input">{{ 'localization.search' | t }}</label>
          <button
            type="reset"
            class="country-filter__reset-button field__button hidden"
            aria-label="{{ 'general.search.reset' | t }}"
          >
            {{- 'icon-reset.svg' | inline_asset_content -}}
          </button>
          <div class="country-filter__search-icon field__button motion-reduce">
            {{- 'icon-search.svg' | inline_asset_content -}}
          </div>
        </div>
      {% endif %}
      <button
        class="country-selector__close-button button--small link"
        type="button"
        aria-label="{{ 'accessibility.close' | t }}"
      >
        {{- 'icon-close.svg' | inline_asset_content -}}
      </button>
    </div>
    <div id="sr-country-search-results" class="visually-hidden" aria-live="polite"></div>
    <div
      class="disclosure__list country-selector__list{% if show_currencies %} country-selector__list--with-multiple-currencies{% endif %}"
      id="{{ localPosition }}-country-results"
    >
      {% if show_popular_countries %}
        <ul
          role="list"
          class="list-unstyled popular-countries"
          aria-label="{{ 'localization.popular_countries_regions' | t }}"
        >
          {%- for country in popular_countries -%}
            <li class="disclosure__item" tabindex="-1">
              <a
                class="link link--text disclosure__link caption-large focus-inset"
                href="#"
                {% if country.iso_code == localization.country.iso_code %}
                  aria-current="true"
                {% endif %}
                data-value="{{ country.iso_code }}"
                id="{{ country.name }}"
              >
                <span
                  {% if country.iso_code != localization.country.iso_code %}
                    class="visibility-hidden"
                  {% endif %}
                >
                  {{- 'icon-checkmark.svg' | inline_asset_content -}}
                </span>
                <span class="country">{{- country.name }}</span>
                <span class="localization-form__currency motion-reduce{% unless show_currencies %} hidden{% endunless %}">
                  {{ country.currency.iso_code }}
                  {{ country.currency.symbol -}}
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {% endif %}
      <ul role="list" class="list-unstyled countries">
        {%- for country in localization.available_countries -%}
          <li class="disclosure__item" tabindex="-1">
            <a
              class="link link--text disclosure__link caption-large focus-inset"
              href="#"
              {% if country.iso_code == localization.country.iso_code %}
                aria-current="true"
              {% endif %}
              data-value="{{ country.iso_code }}"
              id="{{ country.name }}"
            >
              <span
                {% if country.iso_code != localization.country.iso_code %}
                  class="visibility-hidden"
                {% endif %}
              >
                {{- 'icon-checkmark.svg' | inline_asset_content -}}
              </span>
              <span class="country">{{- country.name }}</span>
              <span class="localization-form__currency motion-reduce{% unless show_currencies %} hidden{% endunless %}">
                {{ country.currency.iso_code }}
                {{ country.currency.symbol -}}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
  <div class="country-selector__overlay"></div>
</div>

<!-- Country Modal -->
<div class="country-modal-overlay" id="country-modal-overlay-{{ localPosition }}" aria-hidden="true" role="dialog" aria-labelledby="country-modal-title-{{ localPosition }}">
  <div class="country-modal-content">
    <div class="country-modal-header">
      <h2 class="country-modal-title" id="country-modal-title-{{ localPosition }}">SELECT COUNTRY</h2>
      <button class="country-modal-close" type="button" aria-label="{{ 'accessibility.close' | t }}" data-country-modal-close>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <div class="country-modal-body">
      <div class="country-select-wrapper">
        <select class="country-select" name="country_code_modal_select" data-country-select>
          {%- for country in localization.available_countries -%}
            <option 
              value="{{ country.iso_code }}" 
              {% if country.iso_code == localization.country.iso_code %}selected{% endif %}
            >
              {{ country.name }} ({{ country.currency.iso_code }})
            </option>
          {%- endfor -%}
        </select>
      </div>
    </div>
    <div class="country-modal-footer">
      <button type="button" class="country-modal-confirm" data-country-modal-confirm>
        CONFIRM
      </button>
    </div>
  </div>
</div>

<input type="hidden" name="country_code" value="{{ localization.country.iso_code }}">

{% style %}
  .localization-form__select .icon-caret {
    display:none!important;
  }
  .js .header-localization:not(.menu-drawer__localization) .localization-form__select {
    padding: 0 1.2rem 0 1.2rem!important;
  }
  .localization-form__select {
    min-width:unset!important;
  }

  /* Country Modal Overlay - Global backdrop */
  .country-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(2px);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .country-modal-overlay[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
  }

  /* Modal Content - Centered */
  .country-modal-content {
    background: white;
    border-radius: 12px;
    width: 90%;
    max-width: 420px;
    min-height: 280px;
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
    margin: 20px;
    overflow: hidden;
  }

  /* Header */
  .country-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 32px 10px;
  }

  .country-modal-title {
    font-size: 20px;
    font-weight: 600;
    margin: 0;
    color: #000;
    letter-spacing: 0.5px;
  }

  .country-modal-close {
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    color: #666;
    transition: color 0.2s ease;
    font-size: 18px;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .country-modal-close:hover {
    color: #000;
  }

  .country-modal-close svg {
    display: block;
    stroke-width: 2;
  }

  /* Body */
  .country-modal-body {
    padding: 32px;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Select Wrapper */
  .country-select-wrapper {
    width: 100%;
  }

  /* Select Dropdown - 1:1 Design Match */
  .country-select {
    width: 100%;
    padding: 16px 20px;
    font-size: 16px;
    font-weight: 400;
    color: #000;
    background: #DDDDDD;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    cursor: pointer;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6,9 12,15 18,9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 16px center;
    background-size: 20px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .country-select:hover {
    border-color: #999;
    background-color: #CCCCCC;
  }

  .country-select:focus {
    outline: none;
  }

  .country-select option {
    padding: 12px;
    font-size: 16px;
  }

  /* Footer */
  .country-modal-footer {
    padding: 14px 32px 22px;
    border-top: 1px solid #f0f0f0;
    text-align: left;
  }

  .country-modal-confirm {
    padding: 16px 48px;
    font-size: 16px;
    font-weight: 600;
    background: #000;
    color: white;
    border: none;
    border-radius: 999em;
    cursor: pointer;
    transition: background-color 0.2s ease;
    letter-spacing: 0.5px;
    min-width: 120px;
  }

  .country-modal-confirm:hover {
    background: #333;
  }

  .country-modal-confirm:active {
    background: #555;
  }

  /* Responsive Design */
  @media (max-width: 480px) {
    .country-modal-content {
      width: 95%;
      margin: 16px;
      min-height: 250px;
    }
    
    .country-modal-header {
      padding: 20px 24px 16px;
    }
    
    .country-modal-title {
      font-size: 18px;
    }
    
    .country-modal-body {
      padding: 24px;
    }
    
    .country-modal-footer {
      padding: 20px 24px 24px;
      text-align: left;
    }
    
    .country-select {
      padding: 14px 16px;
      font-size: 16px;
    }
    
    .country-modal-confirm {
      padding: 14px 32px;
      font-size: 16px;
      min-width: 100px;
    }
  }

  /* Animation */
  .country-modal-overlay {
    transition: opacity 0.3s ease;
  }

  .country-modal-content {
    transition: transform 0.3s ease, opacity 0.3s ease;
    transform: scale(0.95);
    opacity: 0;
  }

  .country-modal-overlay[aria-hidden="false"] .country-modal-content {
    transform: scale(1);
    opacity: 1;
  }
{% endstyle %}

<script>
// Updated script for new modal design
console.log('🚀 Country Modal Script Loading...');

function initCountryModal() {
  console.log('🔄 initCountryModal called');
  
  // Find all modal overlays
  const overlays = document.querySelectorAll('.country-modal-overlay');
  console.log(`🎯 Found ${overlays.length} country-modal-overlay elements`);
  
  overlays.forEach((overlay, index) => {
    console.log(`🔍 Processing overlay ${index}:`, overlay);
    
    // Get modal ID
    const modalId = overlay.id;
    const localPosition = modalId.replace('country-modal-overlay-', '');
    console.log('� Local position:', localPosition);
    
    // Find associated container
    const container = document.querySelector(`#LocalizationForm-${localPosition}`) || 
                     overlay.closest('.disclosure') || 
                     overlay.parentElement;
    
    console.log('📦 Associated container:', container);
    
    if (!container) {
      console.warn('❌ No container found for overlay');
      return;
    }
    
    // Find elements
    const trigger = container.querySelector('.disclosure__button') || 
                   container.querySelector('.localization-form__select');
    const closeButtons = overlay.querySelectorAll('[data-country-modal-close]');
    const confirmButton = overlay.querySelector('[data-country-modal-confirm]');
    const countrySelect = overlay.querySelector('.country-select');
    const hiddenInput = container.querySelector('input[name="country_code"]');
    const originalPanel = container.querySelector('.disclosure__list-wrapper');
    
    console.log('📋 Elements found:', {
      overlay: overlay,
      trigger: trigger,
      closeButtons: closeButtons.length,
      confirmButton: confirmButton,
      countrySelect: countrySelect,
      hiddenInput: hiddenInput,
      originalPanel: originalPanel
    });
    
    if (!trigger || !countrySelect) {
      console.warn('❌ Missing trigger or country select');
      return;
    }
    
    // Hide original dropdown
    if (originalPanel) {
      originalPanel.style.display = 'none';
      originalPanel.setAttribute('hidden', 'true');
    }
    
    // Set initial value
    if (hiddenInput && countrySelect) {
      countrySelect.value = hiddenInput.value;
    }
    
    // Add click listener to trigger
    trigger.addEventListener('click', function(e) {
      console.log('🖱️ Trigger clicked!', e.target);
      e.preventDefault();
      e.stopPropagation();
      
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      console.log('✅ Modal opened');
    });
    
    // Add click listeners to close buttons
    closeButtons.forEach((button, i) => {
      button.addEventListener('click', function(e) {
        console.log(`🖱️ Close button ${i} clicked!`);
        e.preventDefault();
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        console.log('✅ Modal closed');
      });
    });
    
    // Add click listener to overlay background
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) {
        console.log('🖱️ Overlay background clicked!');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    });
    
    // Add click listener to confirm button
    if (confirmButton) {
      confirmButton.addEventListener('click', function(e) {
        console.log('🖱️ Confirm button clicked!');
        e.preventDefault();
        
        const selectedValue = countrySelect.value;
        console.log('📋 Selected value:', selectedValue);
        
        if (hiddenInput) {
          hiddenInput.value = selectedValue;
        }
        
        // Find and click the corresponding original link
        const originalLink = container.querySelector(`a[data-value="${selectedValue}"]`);
        if (originalLink) {
          console.log('🔗 Clicking original link');
          originalLink.click();
        } else {
          const form = container.closest('form');
          if (form) {
            console.log('🚀 Submitting form');
            form.submit();
          } else {
            console.log('📄 No form found, just closing modal');
            overlay.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
          }
        }
      });
    }
    
    // Add escape key listener
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && overlay.getAttribute('aria-hidden') === 'false') {
        console.log('⌨️ Escape key pressed!');
        overlay.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
    });
    
    console.log('✅ CountryModal initialized for overlay', index);
  });
}

// Initialize when DOM is ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', initCountryModal);
} else {
  initCountryModal();
}

// Re-initialize for theme editor
if (typeof Shopify !== 'undefined' && Shopify.designMode) {
  document.addEventListener('shopify:section:load', initCountryModal);
}

console.log('✅ Country Modal Script Loaded');
</script>
