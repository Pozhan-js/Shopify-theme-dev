{%- style -%}
.filter-sidebar {
  position: fixed;
  top: 0;
  right: -400px;
  width: 400px;
  height: 100vh;
  background: white;
  box-shadow: -2px 0 10px rgba(0,0,0,0.1);
  transition: right 0.3s ease;
  padding: 2rem;
  overflow-y: auto;
  z-index: 99999;
}
.filter-header {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 1rem;
}
.close-btn {
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  line-height: 1;
}
.filter-group {
  margin-bottom: 1rem;
}
.filter-group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  padding: 0.5rem 0;
}
.filter-group-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}
.filter-group.active .filter-group-content {
  max-height: 500px;
}
.filter-sidebar.active {
  right: 0;
}
.filter-content h2, 
.filter-content h3 {
  margin-top: 1.5rem;
  margin-bottom: 0.5rem;
  font-weight: 700;
  font-size: 2.2rem; /* 22px */
}
.filter-content ul {
  list-style: none;
  padding-left: 0;
}
.filter-content li {
  margin-bottom: 0.5rem;
  font-weight: 600;
  font-size: 1.8rem; /* 18px */
}
.filter-group-header span {
  font-size: 2.2rem; /* 22px */
  transform: scale(1.5);
  display: inline-block;
  line-height: 1;
}
.apply-btn {
  position: absolute;
  bottom: 2rem;
  background: black;
  color: white;
  border: none;
  padding: 1rem;
  width: 90%!important;
  margin-top: 2rem;
  cursor: pointer;
  border-radius: 20px!important;
}
{%- endstyle -%}

<div class="filter-content">
  <div class="filter-header">
    <button class="close-btn" onclick="toggleFilter()">
      {% render 'custom-close' %}
    </button>
  </div>

  <div class="filter-group">
    <div class="filter-group-header" onclick="toggleFilterGroup(this)">
      <h3>SORT BY</h3>
      <span>+</span>
    </div>
    <div class="filter-group-content">
      <ul>
        <li><input type="radio" name="sort" value="featured" checked> Featured</li>
        <li><input type="radio" name="sort" value="best-selling"> Best selling</li>
        <li><input type="radio" name="sort" value="a-z"> Alphabetically, A-Z</li>
        <li><input type="radio" name="sort" value="z-a"> Alphabetically, Z-A</li>
        <li><input type="radio" name="sort" value="price-low-high"> Price, low to high</li>
        <li><input type="radio" name="sort" value="price-high-low"> Price, high to low</li>
      </ul>
    </div>
  </div>

  <div class="filter-group">
    <div class="filter-group-header" onclick="toggleFilterGroup(this)">
      <h3>BRAND</h3>
      <span>+</span>
    </div>
    <div class="filter-group-content">
      <ul>
        {%- comment -%} 调试：显示产品总数 {%- endcomment -%}
        {%- if collection and collection.products.size > 0 -%}
          {%- assign base_products = collection.products -%}
          <li style="color: red;">调试：集合产品数量 {{ collection.products.size }}</li>
        {%- else -%}
          {%- assign base_products = collections.all.products -%}
          <li style="color: red;">调试：所有产品数量 {{ collections.all.products.size }}</li>
        {%- endif -%}
        
        {%- assign available_brands = '' | split: '' -%}
        {%- assign debug_info = '' | split: '' -%}
        
        {%- comment -%} 从多个来源获取品牌数据 {%- endcomment -%}
        {%- for product in base_products limit: 50 -%}
          {%- assign brand_value = '' -%}
          {%- assign source = '' -%}
          
          {%- comment -%} 尝试多种元字段路径 {%- endcomment -%}
          {%- if product.metafields.custom.brand.value != blank -%}
            {%- assign brand_value = product.metafields.custom.brand.value -%}
            {%- assign source = 'custom.brand.value' -%}
          {%- elsif product.metafields.custom.brand != blank -%}
            {%- assign brand_value = product.metafields.custom.brand -%}
            {%- assign source = 'custom.brand' -%}
          {%- elsif product.metafields.global.brand != blank -%}
            {%- assign brand_value = product.metafields.global.brand -%}
            {%- assign source = 'global.brand' -%}
          {%- elsif product.metafields.product.brand != blank -%}
            {%- assign brand_value = product.metafields.product.brand -%}
            {%- assign source = 'product.brand' -%}
          {%- elsif product.vendor != blank -%}
            {%- assign brand_value = product.vendor -%}
            {%- assign source = 'vendor' -%}
          {%- endif -%}
          
          {%- if brand_value != blank -%}
            {%- unless available_brands contains brand_value -%}
              {%- assign available_brands = available_brands | push: brand_value -%}
              {%- assign debug_info = debug_info | push: source -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
        
        {%- comment -%} 显示调试信息 {%- endcomment -%}
        <li style="color: blue;">调试：找到品牌数量 {{ available_brands.size }}</li>
        {%- for i in (0..available_brands.size) -%}
          {%- if available_brands[i] != blank -%}
            <li style="color: green;">调试：{{ available_brands[i] }} (来源: {{ debug_info[i] }})</li>
          {%- endif -%}
        {%- endfor -%}
        
        {%- comment -%} 显示实际品牌选项 {%- endcomment -%}
        {%- assign sorted_brands = available_brands | sort -%}
        {%- for brand in sorted_brands -%}
          <li>
            <input type="checkbox" name="brand" value="{{ brand }}">
            {{ brand }}
          </li>
        {%- endfor -%}
        
        {%- comment -%} 如果没有找到品牌，显示备用选项 {%- endcomment -%}
        {%- if available_brands.size == 0 -%}
          <li style="color: orange;">没有找到品牌数据，显示备用选项：</li>
          <li><input type="checkbox" name="brand" value="Nike"> Nike</li>
          <li><input type="checkbox" name="brand" value="Adidas"> Adidas</li>
          <li><input type="checkbox" name="brand" value="Puma"> Puma</li>
        {%- endif -%}
      </ul>
    </div>
  </div>

  <div class="filter-group">
    <div class="filter-group-header" onclick="toggleFilterGroup(this)">
      <h3>SIZE</h3>
      <span>+</span>
    </div>
    <div class="filter-group-content">
      <ul>
        {%- assign available_sizes = '' | split: '' -%}
        {%- assign debug_sizes = '' | split: '' -%}
        
        {%- if collection and collection.products.size > 0 -%}
          {%- assign base_products = collection.products -%}
        {%- else -%}
          {%- assign base_products = collections.all.products -%}
        {%- endif -%}
        
        {%- comment -%} 从多个来源获取尺码数据 {%- endcomment -%}
        {%- for product in base_products limit: 50 -%}
          {%- comment -%} 尝试从产品元字段获取 {%- endcomment -%}
          {%- if product.metafields.custom.size.value != blank -%}
            {%- assign size_list = product.metafields.custom.size.value | split: ',' -%}
            {%- for size in size_list -%}
              {%- assign size_value = size | strip -%}
              {%- unless available_sizes contains size_value -%}
                {%- assign available_sizes = available_sizes | push: size_value -%}
                {%- assign debug_sizes = debug_sizes | push: 'custom.size.value' -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- elsif product.metafields.custom.size != blank -%}
            {%- assign size_list = product.metafields.custom.size | split: ',' -%}
            {%- for size in size_list -%}
              {%- assign size_value = size | strip -%}
              {%- unless available_sizes contains size_value -%}
                {%- assign available_sizes = available_sizes | push: size_value -%}
                {%- assign debug_sizes = debug_sizes | push: 'custom.size' -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} 从变体选项获取 {%- endcomment -%}
            {%- for variant in product.variants limit: 10 -%}
              {%- if variant.available -%}
                {%- comment -%} 检查所有选项 {%- endcomment -%}
                {%- assign options = variant.option1 | append: ',' | append: variant.option2 | append: ',' | append: variant.option3 | split: ',' -%}
                {%- for option in options -%}
                  {%- if option != blank and option != 'Default Title' -%}
                    {%- assign option_upper = option | upcase -%}
                    {%- if option_upper contains 'XS' or option_upper contains 'SMALL' or option_upper contains 'MEDIUM' or option_upper contains 'LARGE' or option_upper == 'S' or option_upper == 'M' or option_upper == 'L' or option_upper == 'XL' or option_upper == 'XXL' -%}
                      {%- unless available_sizes contains option -%}
                        {%- assign available_sizes = available_sizes | push: option -%}
                        {%- assign debug_sizes = debug_sizes | push: 'variant_option' -%}
                      {%- endunless -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        
        {%- comment -%} 显示调试信息 {%- endcomment -%}
        <li style="color: blue;">调试：找到尺码数量 {{ available_sizes.size }}</li>
        {%- for i in (0..available_sizes.size) -%}
          {%- if available_sizes[i] != blank -%}
            <li style="color: green;">调试：{{ available_sizes[i] }} (来源: {{ debug_sizes[i] }})</li>
          {%- endif -%}
        {%- endfor -%}
        
        {%- comment -%} 显示实际尺码选项 {%- endcomment -%}
        {%- assign size_order = 'XS,S,M,L,XL,XXL,XXXL' | split: ',' -%}
        {%- for standard_size in size_order -%}
          {%- if available_sizes contains standard_size -%}
            <li>
              <input type="checkbox" name="size" value="{{ standard_size }}">
              {{ standard_size }}
            </li>
          {%- endif -%}
        {%- endfor -%}
        
        {%- comment -%} 如果没有找到尺码，显示备用选项 {%- endcomment -%}
        {%- if available_sizes.size == 0 -%}
          <li style="color: orange;">没有找到尺码数据，显示备用选项：</li>
          <li><input type="checkbox" name="size" value="S"> S</li>
          <li><input type="checkbox" name="size" value="M"> M</li>
          <li><input type="checkbox" name="size" value="L"> L</li>
          <li><input type="checkbox" name="size" value="XL"> XL</li>
        {%- endif -%}
      </ul>
    </div>
  </div>

  <div class="filter-group">
    <div class="filter-group-header" onclick="toggleFilterGroup(this)">
      <h3>PRODUCT TYPE</h3>
      <span>+</span>
    </div>
    <div class="filter-group-content">
      <ul>
        {%- assign available_types = '' | split: '' -%}
        {%- assign debug_types = '' | split: '' -%}
        
        {%- if collection and collection.products.size > 0 -%}
          {%- assign base_products = collection.products -%}
        {%- else -%}
          {%- assign base_products = collections.all.products -%}
        {%- endif -%}
        
        {%- comment -%} 从多个来源获取产品类型数据 {%- endcomment -%}
        {%- for product in base_products limit: 50 -%}
          {%- assign type_value = '' -%}
          {%- assign source = '' -%}
          
          {%- if product.metafields.custom.product_type.value != blank -%}
            {%- assign type_value = product.metafields.custom.product_type.value -%}
            {%- assign source = 'custom.product_type.value' -%}
          {%- elsif product.metafields.custom.product_type != blank -%}
            {%- assign type_value = product.metafields.custom.product_type -%}
            {%- assign source = 'custom.product_type' -%}
          {%- elsif product.metafields.custom.category != blank -%}
            {%- assign type_value = product.metafields.custom.category -%}
            {%- assign source = 'custom.category' -%}
          {%- elsif product.type != blank -%}
            {%- assign type_value = product.type -%}
            {%- assign source = 'product.type' -%}
          {%- endif -%}
          
          {%- if type_value != blank -%}
            {%- unless available_types contains type_value -%}
              {%- assign available_types = available_types | push: type_value -%}
              {%- assign debug_types = debug_types | push: source -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
        
        {%- comment -%} 显示调试信息 {%- endcomment -%}
        <li style="color: blue;">调试：找到产品类型数量 {{ available_types.size }}</li>
        {%- for i in (0..available_types.size) -%}
          {%- if available_types[i] != blank -%}
            <li style="color: green;">调试：{{ available_types[i] }} (来源: {{ debug_types[i] }})</li>
          {%- endif -%}
        {%- endfor -%}
        
        {%- comment -%} 显示实际产品类型选项 {%- endcomment -%}
        {%- assign sorted_types = available_types | sort -%}
        {%- for type in sorted_types -%}
          <li>
            <input type="checkbox" name="type" value="{{ type | replace: ' ', '-' }}">
            {{ type }}
          </li>
        {%- endfor -%}
        
        {%- comment -%} 如果没有找到产品类型，显示备用选项 {%- endcomment -%}
        {%- if available_types.size == 0 -%}
          <li style="color: orange;">没有找到产品类型数据，显示备用选项：</li>
          <li><input type="checkbox" name="type" value="T-Shirt"> T-Shirt</li>
          <li><input type="checkbox" name="type" value="Jeans"> Jeans</li>
          <li><input type="checkbox" name="type" value="Shoes"> Shoes</li>
        {%- endif -%}
      </ul>
    </div>
  </div>

  <div class="filter-group">
    <div class="filter-group-header" onclick="toggleFilterGroup(this)">
      <h3>COLOR</h3>
      <span>+</span>
    </div>
    <div class="filter-group-content">
      <ul>
        {%- assign available_colors = '' | split: '' -%}
        {%- assign debug_colors = '' | split: '' -%}
        
        {%- if collection and collection.products.size > 0 -%}
          {%- assign base_products = collection.products -%}
        {%- else -%}
          {%- assign base_products = collections.all.products -%}
        {%- endif -%}
        
        {%- comment -%} 从多个来源获取颜色数据 {%- endcomment -%}
        {%- for product in base_products limit: 50 -%}
          {%- comment -%} 尝试从产品元字段获取 {%- endcomment -%}
          {%- if product.metafields.custom.color.value != blank -%}
            {%- assign color_list = product.metafields.custom.color.value | split: ',' -%}
            {%- for color in color_list -%}
              {%- assign color_value = color | strip -%}
              {%- unless available_colors contains color_value -%}
                {%- assign available_colors = available_colors | push: color_value -%}
                {%- assign debug_colors = debug_colors | push: 'custom.color.value' -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- elsif product.metafields.custom.color != blank -%}
            {%- assign color_list = product.metafields.custom.color | split: ',' -%}
            {%- for color in color_list -%}
              {%- assign color_value = color | strip -%}
              {%- unless available_colors contains color_value -%}
                {%- assign available_colors = available_colors | push: color_value -%}
                {%- assign debug_colors = debug_colors | push: 'custom.color' -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} 从变体选项获取 {%- endcomment -%}
            {%- for variant in product.variants limit: 10 -%}
              {%- if variant.available -%}
                {%- comment -%} 检查所有选项，排除尺码 {%- endcomment -%}
                {%- assign options = variant.option1 | append: ',' | append: variant.option2 | append: ',' | append: variant.option3 | split: ',' -%}
                {%- for option in options -%}
                  {%- if option != blank and option != 'Default Title' -%}
                    {%- assign option_lower = option | downcase -%}
                    {%- unless option_lower contains 'small' or option_lower contains 'medium' or option_lower contains 'large' or option_lower contains 'xs' or option_lower contains 'xl' or option_lower == 's' or option_lower == 'm' or option_lower == 'l' -%}
                      {%- unless available_colors contains option -%}
                        {%- assign available_colors = available_colors | push: option -%}
                        {%- assign debug_colors = debug_colors | push: 'variant_option' -%}
                      {%- endunless -%}
                    {%- endunless -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        
        {%- comment -%} 显示调试信息 {%- endcomment -%}
        <li style="color: blue;">调试：找到颜色数量 {{ available_colors.size }}</li>
        {%- for i in (0..available_colors.size) -%}
          {%- if available_colors[i] != blank -%}
            <li style="color: green;">调试：{{ available_colors[i] }} (来源: {{ debug_colors[i] }})</li>
          {%- endif -%}
        {%- endfor -%}
        
        {%- comment -%} 显示实际颜色选项 {%- endcomment -%}
        {%- assign sorted_colors = available_colors | sort -%}
        {%- for color in sorted_colors -%}
          <li>
            <input type="checkbox" name="color" value="{{ color }}">
            {{ color }}
          </li>
        {%- endfor -%}
        
        {%- comment -%} 如果没有找到颜色，显示备用选项 {%- endcomment -%}
        {%- if available_colors.size == 0 -%}
          <li style="color: orange;">没有找到颜色数据，显示备用选项：</li>
          <li><input type="checkbox" name="color" value="Red"> Red</li>
          <li><input type="checkbox" name="color" value="Blue"> Blue</li>
          <li><input type="checkbox" name="color" value="Black"> Black</li>
          <li><input type="checkbox" name="color" value="White"> White</li>
        {%- endif -%}
      </ul>
    </div>
  </div>

  {%- comment -%} 计算筛选后的产品数量 {%- endcomment -%}
  {%- assign filtered_product_count = 0 -%}
  
  {%- comment -%} 获取当前URL参数 {%- endcomment -%}
  {%- assign query_params = request.query_string | split: '&' -%}
  
  {%- comment -%} 使用当前集合或所有产品 {%- endcomment -%}
  {%- if collection and collection.products.size > 0 -%}
    {%- assign base_products = collection.products -%}
  {%- else -%}
    {%- assign base_products = collections.all.products -%}
  {%- endif -%}
  
  {%- comment -%} 基于当前筛选条件过滤产品并计数 {%- endcomment -%}
  {%- for product in base_products limit: 500 -%}
    {%- assign include_product = true -%}
    
    {%- comment -%} 检查品牌筛选 {%- endcomment -%}
    {%- assign brand_filter = '' -%}
    {%- for param in query_params -%}
      {%- if param contains 'filter.v.brand' -%}
        {%- assign brand_filter = param | remove: 'filter.v.brand=' -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if brand_filter != blank -%}
      {%- assign selected_brands = brand_filter | split: '+' -%}
      {%- unless selected_brands contains product.vendor -%}
        {%- assign include_product = false -%}
      {%- endunless -%}
    {%- endif -%}
    
    {%- comment -%} 检查产品类型筛选 {%- endcomment -%}
    {%- assign type_filter = '' -%}
    {%- for param in query_params -%}
      {%- if param contains 'filter.v.product_type' -%}
        {%- assign type_filter = param | remove: 'filter.v.product_type=' -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if type_filter != blank -%}
      {%- assign selected_types = type_filter | split: '+' -%}
      {%- assign product_type = product.type | replace: ' ', '-' -%}
      {%- unless selected_types contains product_type -%}
        {%- assign include_product = false -%}
      {%- endunless -%}
    {%- endif -%}
    
    {%- comment -%} 检查颜色筛选 {%- endcomment -%}
    {%- assign color_filter = '' -%}
    {%- for param in query_params -%}
      {%- if param contains 'filter.v.color' -%}
        {%- assign color_filter = param | remove: 'filter.v.color=' -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if color_filter != blank -%}
      {%- assign selected_colors = color_filter | split: '+' -%}
      {%- assign product_colors = '' | split: '' -%}
      {%- for variant in product.variants -%}
        {%- if variant.available -%}
          {%- assign variant_color = variant.title | split: ' / ' | first -%}
          {%- unless product_colors contains variant_color -%}
            {%- assign product_colors = product_colors | push: variant_color -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign color_match = false -%}
      {%- for color in product_colors -%}
        {%- if selected_colors contains color -%}
          {%- assign color_match = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless color_match -%}
        {%- assign include_product = false -%}
      {%- endunless -%}
    {%- endif -%}
    
    {%- comment -%} 检查SIZE筛选 {%- endcomment -%}
    {%- assign size_filter = '' -%}
    {%- for param in query_params -%}
      {%- if param contains 'filter.v.size' -%}
        {%- assign size_filter = param | remove: 'filter.v.size=' -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if size_filter != blank -%}
      {%- assign selected_sizes = size_filter | split: '+' -%}
      {%- assign product_sizes = '' | split: '' -%}
      {%- for variant in product.variants -%}
        {%- if variant.available -%}
          {%- assign variant_size = variant.title | split: ' / ' | last -%}
          {%- unless product_sizes contains variant_size -%}
            {%- assign product_sizes = product_sizes | push: variant_size -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign size_match = false -%}
      {%- for size in product_sizes -%}
        {%- if selected_sizes contains size -%}
          {%- assign size_match = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless size_match -%}
        {%- assign include_product = false -%}
      {%- endunless -%}
    {%- endif -%}
    
    {%- if include_product -%}
      {%- assign filtered_product_count = filtered_product_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  
  <button class="apply-btn" onclick="applyFilters()">
    SHOW {{ filtered_product_count }} RESULTS 
  </button>
</div>

<script>
function toggleFilterGroup(header) {
  const group = header.parentElement;
  group.classList.toggle('active');
  const icon = header.querySelector('span');
  icon.textContent = group.classList.contains('active') ? '-' : '+';
}

function applyFilters() {
  const selectedSort = document.querySelector('input[name="sort"]:checked').value;
  const selectedBrands = Array.from(document.querySelectorAll('input[name="brand"]:checked')).map(el => el.value);
  const selectedSizes = Array.from(document.querySelectorAll('input[name="size"]:checked')).map(el => el.value);
  const selectedTypes = Array.from(document.querySelectorAll('input[name="type"]:checked')).map(el => el.value);
  const selectedColors = Array.from(document.querySelectorAll('input[name="color"]:checked')).map(el => el.value);

  // 构建查询参数
  let queryParams = [];
  
  // 添加排序参数
  let sortParam = '';
  switch(selectedSort) {
    case 'featured':
      sortParam = 'manual';
      break;
    case 'best-selling':
      sortParam = 'best-selling';
      break;
    case 'a-z':
      sortParam = 'title-ascending';
      break;
    case 'z-a':
      sortParam = 'title-descending';
      break;
    case 'price-low-high':
      sortParam = 'price-ascending';
      break;
    case 'price-high-low':
      sortParam = 'price-descending';
      break;
    default:
      sortParam = 'manual';
  }
  queryParams.push(`sort_by=${sortParam}`);

  // 强制重新加载页面以确保排序生效
  if (selectedSort.includes('price')) {
    queryParams.push('force_reload=1');
  }

  // 添加筛选参数
  if (selectedBrands.length) queryParams.push(`filter.v.brand=${selectedBrands.join('+')}`);
  if (selectedSizes.length) queryParams.push(`filter.v.size=${selectedSizes.join('+')}`);
  if (selectedTypes.length) queryParams.push(`filter.v.product_type=${selectedTypes.join('+')}`);
  if (selectedColors.length) queryParams.push(`filter.v.color=${selectedColors.join('+')}`);

  // 重新加载页面应用筛选
  window.location.search = queryParams.join('&');
}
</script>
