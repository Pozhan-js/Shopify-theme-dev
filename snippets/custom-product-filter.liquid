{%- style -%}
.filter-sidebar {
  position: fixed;
  top: 0;
  right: -400px;
  width: 400px;
  height: 100vh;
  background: white;
  box-shadow: -2px 0 10px rgba(0,0,0,0.1);
  transition: right 0.3s ease;
  padding: 2rem;
  overflow-y: auto;
  z-index: 99999;
}
.filter-header {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  margin-bottom: 1rem;
}
.close-btn {
  background: none;
  border: none;
  font-size: 1.5rem;
  cursor: pointer;
  line-height: 1;
}
.filter-group {
  margin-bottom: 1rem;
}
.filter-group-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  padding: 0.5rem 0;
}
.filter-group-content {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
}
.filter-group.active .filter-group-content {
  max-height: 500px;
}
.filter-sidebar.active {
  right: 0;
}
.filter-content h2, 
.filter-content h3 {
  margin-top: 1.5rem;
  margin-bottom: 0.5rem;
  font-weight: 700;
  font-size: 2.2rem; /* 22px */
}
.filter-content ul {
  list-style: none;
  padding-left: 0;
}
.filter-content li {
  margin-bottom: 0.5rem;
  font-weight: 600;
  font-size: 1.8rem; /* 18px */
}
.filter-group-header span {
  font-size: 2.2rem; /* 22px */
  transform: scale(1.5);
  display: inline-block;
  line-height: 1;
}
.apply-btn {
  position: absolute;
  bottom: 2rem;
  background: black;
  color: white;
  border: none;
  padding: 1rem;
  width: 90%!important;
  margin-top: 2rem;
  cursor: pointer;
  border-radius: 20px!important;
}
{%- endstyle -%}

<div class="filter-content">
  <div class="filter-header">
    <button class="close-btn" onclick="toggleFilter()">
      {% render 'custom-close' %}
    </button>
  </div>

  <div class="filter-group">
    <div class="filter-group-header" onclick="toggleFilterGroup(this)">
      <h3>SORT BY</h3>
      <span>+</span>
    </div>
    <div class="filter-group-content">
      <ul>
        <li><input type="radio" name="sort" value="featured" checked> Featured</li>
        <li><input type="radio" name="sort" value="best-selling"> Best selling</li>
        <li><input type="radio" name="sort" value="a-z"> Alphabetically, A-Z</li>
        <li><input type="radio" name="sort" value="z-a"> Alphabetically, Z-A</li>
        <li><input type="radio" name="sort" value="price-low-high"> Price, low to high</li>
        <li><input type="radio" name="sort" value="price-high-low"> Price, high to low</li>
      </ul>
    </div>
  </div>

  <div class="filter-group">
    <div class="filter-group-header" onclick="toggleFilterGroup(this)">
      <h3>BRAND</h3>
      <span>+</span>
    </div>
    <div class="filter-group-content">
      <ul>
        {%- comment -%} 从产品元字段获取品牌数据 {%- endcomment -%}
        {%- assign available_brands = '' | split: '' -%}
        
        {%- comment -%} 使用当前集合或所有产品 {%- endcomment -%}
        {%- if collection and collection.products.size > 0 -%}
          {%- assign base_products = collection.products -%}
        {%- else -%}
          {%- assign base_products = collections.all.products -%}
        {%- endif -%}
        
        {%- comment -%} 从产品元字段中提取品牌 {%- endcomment -%}
        {%- for product in base_products limit: 300 -%}
          {%- comment -%} 尝试从不同的元字段获取品牌信息 {%- endcomment -%}
          {%- assign brand_value = '' -%}
          
          {%- comment -%} 方式1: 从custom.brand元字段获取 {%- endcomment -%}
          {%- if product.metafields.custom.brand != blank -%}
            {%- assign brand_value = product.metafields.custom.brand -%}
          {%- comment -%} 方式2: 从namespace.brand元字段获取 {%- endcomment -%}
          {%- elsif product.metafields.namespace.brand != blank -%}
            {%- assign brand_value = product.metafields.namespace.brand -%}
          {%- comment -%} 方式3: 从product.brand元字段获取 {%- endcomment -%}
          {%- elsif product.metafields.product.brand != blank -%}
            {%- assign brand_value = product.metafields.product.brand -%}
          {%- comment -%} 方式4: 从vendor字段获取 {%- endcomment -%}
          {%- elsif product.vendor != blank -%}
            {%- assign brand_value = product.vendor -%}
          {%- endif -%}
          
          {%- if brand_value != blank -%}
            {%- unless available_brands contains brand_value -%}
              {%- assign available_brands = available_brands | push: brand_value -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
        
        {%- comment -%} 按字母顺序排序品牌 {%- endcomment -%}
        {%- assign sorted_brands = available_brands | sort -%}
        
        {%- comment -%} 显示品牌选项 {%- endcomment -%}
        {%- for brand in sorted_brands -%}
          {%- assign is_checked = false -%}
          {%- assign current_params = request.query_string | split: '&' -%}
          {%- for param in current_params -%}
            {%- if param contains 'filter.v.brand' -%}
              {%- assign param_parts = param | split: '=' -%}
              {%- if param_parts.size > 1 -%}
                {%- assign selected_brands = param_parts[1] | split: '+' -%}
                {%- if selected_brands contains brand -%}
                  {%- assign is_checked = true -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          
          <li>
            <input type="checkbox" 
                   name="brand" 
                   value="{{ brand }}" 
                   {% if is_checked %}checked{% endif %}>
            {{ brand }}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <div class="filter-group">
    <div class="filter-group-header" onclick="toggleFilterGroup(this)">
      <h3>SIZE</h3>
      <span>+</span>
    </div>
    <div class="filter-group-content">
      <ul>
        {%- comment -%} 从产品元字段获取尺码数据 {%- endcomment -%}
        {%- assign available_sizes = '' | split: '' -%}
        
        {%- comment -%} 使用当前集合或所有产品 {%- endcomment -%}
        {%- if collection and collection.products.size > 0 -%}
          {%- assign base_products = collection.products -%}
        {%- else -%}
          {%- assign base_products = collections.all.products -%}
        {%- endif -%}
        
        {%- comment -%} 从产品元字段和变体中提取SIZE {%- endcomment -%}
        {%- for product in base_products limit: 300 -%}
          {%- comment -%} 方式1: 从产品元字段获取尺码列表 {%- endcomment -%}
          {%- if product.metafields.custom.size != blank -%}
            {%- assign size_list = product.metafields.custom.size | split: ',' -%}
            {%- for size in size_list -%}
              {%- assign size_value = size | strip -%}
              {%- unless available_sizes contains size_value -%}
                {%- assign available_sizes = available_sizes | push: size_value -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- elsif product.metafields.namespace.size != blank -%}
            {%- assign size_list = product.metafields.namespace.size | split: ',' -%}
            {%- for size in size_list -%}
              {%- assign size_value = size | strip -%}
              {%- unless available_sizes contains size_value -%}
                {%- assign available_sizes = available_sizes | push: size_value -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} 方式2: 从变体选项中提取 {%- endcomment -%}
            {%- for variant in product.variants -%}
              {%- if variant.available -%}
                {%- assign size_value = '' -%}
                
                {%- comment -%} 从变体元字段获取 {%- endcomment -%}
                {%- if variant.metafields.custom.size != blank -%}
                  {%- assign size_value = variant.metafields.custom.size -%}
                {%- comment -%} 从变体选项获取 {%- endcomment -%}
                {%- elsif variant.option1 and variant.option1 != 'Default Title' -%}
                  {%- assign option1_upper = variant.option1 | upcase -%}
                  {%- if option1_upper contains 'XS' or option1_upper contains 'SMALL' or option1_upper contains 'MEDIUM' or option1_upper contains 'LARGE' or option1_upper == 'S' or option1_upper == 'M' or option1_upper == 'L' -%}
                    {%- assign size_value = variant.option1 -%}
                  {%- endif -%}
                {%- elsif variant.option2 -%}
                  {%- assign option2_upper = variant.option2 | upcase -%}
                  {%- if option2_upper contains 'XS' or option2_upper contains 'SMALL' or option2_upper contains 'MEDIUM' or option2_upper contains 'LARGE' or option2_upper == 'S' or option2_upper == 'M' or option2_upper == 'L' -%}
                    {%- assign size_value = variant.option2 -%}
                  {%- endif -%}
                {%- elsif variant.option3 -%}
                  {%- assign option3_upper = variant.option3 | upcase -%}
                  {%- if option3_upper contains 'XS' or option3_upper contains 'SMALL' or option3_upper contains 'MEDIUM' or option3_upper contains 'LARGE' or option3_upper == 'S' or option3_upper == 'M' or option3_upper == 'L' -%}
                    {%- assign size_value = variant.option3 -%}
                  {%- endif -%}
                {%- endif -%}
                
                {%- if size_value != blank -%}
                  {%- comment -%} 标准化SIZE值 {%- endcomment -%}
                  {%- assign normalized_size = size_value | strip | upcase -%}
                  {%- assign standard_mapping = 'SMALL:S,MEDIUM:M,LARGE:L,X-SMALL:XS,X-LARGE:XL,XX-LARGE:XXL,XXX-LARGE:XXXL' | split: ',' -%}
                  {%- for mapping in standard_mapping -%}
                    {%- assign parts = mapping | split: ':' -%}
                    {%- if parts.size == 2 and normalized_size == parts[0] -%}
                      {%- assign size_value = parts[1] -%}
                      {%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  
                  {%- unless available_sizes contains size_value -%}
                    {%- assign available_sizes = available_sizes | push: size_value -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        
        {%- comment -%} 按标准顺序排序SIZE {%- endcomment -%}
        {%- assign size_order = 'XS,S,M,L,XL,XXL,XXXL,2XL,3XL,4XL,5XL' | split: ',' -%}
        {%- assign sorted_sizes = '' | split: '' -%}
        
        {%- for standard_size in size_order -%}
          {%- if available_sizes contains standard_size -%}
            {%- assign sorted_sizes = sorted_sizes | push: standard_size -%}
          {%- endif -%}
        {%- endfor -%}
        
        {%- comment -%} 添加剩余的SIZE {%- endcomment -%}
        {%- for size in available_sizes -%}
          {%- unless size_order contains size -%}
            {%- assign sorted_sizes = sorted_sizes | push: size -%}
          {%- endunless -%}
        {%- endfor -%}
        
        {%- comment -%} 显示SIZE选项 {%- endcomment -%}
        {%- for size in sorted_sizes -%}
          {%- assign is_checked = false -%}
          {%- assign current_params = request.query_string | split: '&' -%}
          {%- for param in current_params -%}
            {%- if param contains 'filter.v.size' -%}
              {%- assign param_parts = param | split: '=' -%}
              {%- if param_parts.size > 1 -%}
                {%- assign selected_sizes = param_parts[1] | split: '+' -%}
                {%- if selected_sizes contains size -%}
                  {%- assign is_checked = true -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          
          <li>
            <input type="checkbox" 
                   name="size" 
                   value="{{ size }}" 
                   {% if is_checked %}checked{% endif %}>
            {{ size }}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <div class="filter-group">
    <div class="filter-group-header" onclick="toggleFilterGroup(this)">
      <h3>PRODUCT TYPE</h3>
      <span>+</span>
    </div>
    <div class="filter-group-content">
      <ul>
        {%- comment -%} 从产品元字段获取产品类型数据 {%- endcomment -%}
        {%- assign available_types = '' | split: '' -%}
        
        {%- comment -%} 使用当前集合或所有产品 {%- endcomment -%}
        {%- if collection and collection.products.size > 0 -%}
          {%- assign base_products = collection.products -%}
        {%- else -%}
          {%- assign base_products = collections.all.products -%}
        {%- endif -%}
        
        {%- comment -%} 从产品元字段中提取产品类型 {%- endcomment -%}
        {%- for product in base_products limit: 300 -%}
          {%- assign type_value = '' -%}
          
          {%- comment -%} 方式1: 从custom.product_type元字段获取 {%- endcomment -%}
          {%- if product.metafields.custom.product_type != blank -%}
            {%- assign type_value = product.metafields.custom.product_type -%}
          {%- comment -%} 方式2: 从namespace.product_type元字段获取 {%- endcomment -%}
          {%- elsif product.metafields.namespace.product_type != blank -%}
            {%- assign type_value = product.metafields.namespace.product_type -%}
          {%- comment -%} 方式3: 从custom.category元字段获取 {%- endcomment -%}
          {%- elsif product.metafields.custom.category != blank -%}
            {%- assign type_value = product.metafields.custom.category -%}
          {%- comment -%} 方式4: 从product.type字段获取 {%- endcomment -%}
          {%- elsif product.type != blank -%}
            {%- assign type_value = product.type -%}
          {%- endif -%}
          
          {%- if type_value != blank -%}
            {%- unless available_types contains type_value -%}
              {%- assign available_types = available_types | push: type_value -%}
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
        
        {%- comment -%} 按字母顺序排序产品类型 {%- endcomment -%}
        {%- assign sorted_types = available_types | sort -%}
        
        {%- comment -%} 显示产品类型选项 {%- endcomment -%}
        {%- for type in sorted_types -%}
          {%- assign is_checked = false -%}
          {%- assign current_params = request.query_string | split: '&' -%}
          {%- for param in current_params -%}
            {%- if param contains 'filter.v.product_type' -%}
              {%- assign param_parts = param | split: '=' -%}
              {%- if param_parts.size > 1 -%}
                {%- assign selected_types = param_parts[1] | split: '+' -%}
                {%- assign type_value = type | replace: ' ', '-' -%}
                {%- if selected_types contains type_value -%}
                  {%- assign is_checked = true -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          
          <li>
            <input type="checkbox" 
                   name="type" 
                   value="{{ type | replace: ' ', '-' }}" 
                   {% if is_checked %}checked{% endif %}>
            {{ type }}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <div class="filter-group">
    <div class="filter-group-header" onclick="toggleFilterGroup(this)">
      <h3>COLOR</h3>
      <span>+</span>
    </div>
    <div class="filter-group-content">
      <ul>
        {%- comment -%} 从产品元字段获取颜色数据 {%- endcomment -%}
        {%- assign available_colors = '' | split: '' -%}
        
        {%- comment -%} 使用当前集合或所有产品 {%- endcomment -%}
        {%- if collection and collection.products.size > 0 -%}
          {%- assign base_products = collection.products -%}
        {%- else -%}
          {%- assign base_products = collections.all.products -%}
        {%- endif -%}
        
        {%- comment -%} 从产品元字段和变体中提取颜色 {%- endcomment -%}
        {%- for product in base_products limit: 300 -%}
          {%- comment -%} 方式1: 从产品元字段获取颜色列表 {%- endcomment -%}
          {%- if product.metafields.custom.color != blank -%}
            {%- assign color_list = product.metafields.custom.color | split: ',' -%}
            {%- for color in color_list -%}
              {%- assign color_value = color | strip -%}
              {%- unless available_colors contains color_value -%}
                {%- assign available_colors = available_colors | push: color_value -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- elsif product.metafields.namespace.color != blank -%}
            {%- assign color_list = product.metafields.namespace.color | split: ',' -%}
            {%- for color in color_list -%}
              {%- assign color_value = color | strip -%}
              {%- unless available_colors contains color_value -%}
                {%- assign available_colors = available_colors | push: color_value -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} 方式2: 从变体选项中提取 {%- endcomment -%}
            {%- for variant in product.variants -%}
              {%- if variant.available -%}
                {%- assign color_value = '' -%}
                
                {%- comment -%} 从变体元字段获取 {%- endcomment -%}
                {%- if variant.metafields.custom.color != blank -%}
                  {%- assign color_value = variant.metafields.custom.color -%}
                {%- comment -%} 从变体选项获取（排除尺码） {%- endcomment -%}
                {%- elsif variant.option1 and variant.option1 != 'Default Title' -%}
                  {%- assign option1_lower = variant.option1 | downcase -%}
                  {%- unless option1_lower contains 'small' or option1_lower contains 'medium' or option1_lower contains 'large' or option1_lower contains 'xs' or option1_lower contains 'xl' or option1_lower == 's' or option1_lower == 'm' or option1_lower == 'l' -%}
                    {%- assign color_value = variant.option1 -%}
                  {%- endunless -%}
                {%- elsif variant.option2 -%}
                  {%- assign option2_lower = variant.option2 | downcase -%}
                  {%- unless option2_lower contains 'small' or option2_lower contains 'medium' or option2_lower contains 'large' or option2_lower contains 'xs' or option2_lower contains 'xl' or option2_lower == 's' or option2_lower == 'm' or option2_lower == 'l' -%}
                    {%- assign color_value = variant.option2 -%}
                  {%- endunless -%}
                {%- elsif variant.option3 -%}
                  {%- assign option3_lower = variant.option3 | downcase -%}
                  {%- unless option3_lower contains 'small' or option3_lower contains 'medium' or option3_lower contains 'large' or option3_lower contains 'xs' or option3_lower contains 'xl' or option3_lower == 's' or option3_lower == 'm' or option3_lower == 'l' -%}
                    {%- assign color_value = variant.option3 -%}
                  {%- endunless -%}
                {%- endif -%}
                
                {%- if color_value != blank and color_value != 'Default Title' -%}
                  {%- unless available_colors contains color_value -%}
                    {%- assign available_colors = available_colors | push: color_value -%}
                  {%- endunless -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
        
        {%- comment -%} 按字母顺序排序颜色 {%- endcomment -%}
        {%- assign sorted_colors = available_colors | sort -%}
        
        {%- comment -%} 显示颜色选项 {%- endcomment -%}
        {%- for color in sorted_colors -%}
          {%- assign is_checked = false -%}
          {%- assign current_params = request.query_string | split: '&' -%}
          {%- for param in current_params -%}
            {%- if param contains 'filter.v.color' -%}
              {%- assign param_parts = param | split: '=' -%}
              {%- if param_parts.size > 1 -%}
                {%- assign selected_colors = param_parts[1] | split: '+' -%}
                {%- if selected_colors contains color -%}
                  {%- assign is_checked = true -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          
          <li>
            <input type="checkbox" 
                   name="color" 
                   value="{{ color }}" 
                   {% if is_checked %}checked{% endif %}>
            {{ color }}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  {%- comment -%} 计算筛选后的产品数量 {%- endcomment -%}
  {%- assign filtered_product_count = 0 -%}
  
  {%- comment -%} 获取当前URL参数 {%- endcomment -%}
  {%- assign query_params = request.query_string | split: '&' -%}
  
  {%- comment -%} 使用当前集合或所有产品 {%- endcomment -%}
  {%- if collection and collection.products.size > 0 -%}
    {%- assign base_products = collection.products -%}
  {%- else -%}
    {%- assign base_products = collections.all.products -%}
  {%- endif -%}
  
  {%- comment -%} 基于当前筛选条件过滤产品并计数 {%- endcomment -%}
  {%- for product in base_products limit: 500 -%}
    {%- assign include_product = true -%}
    
    {%- comment -%} 检查品牌筛选 {%- endcomment -%}
    {%- assign brand_filter = '' -%}
    {%- for param in query_params -%}
      {%- if param contains 'filter.v.brand' -%}
        {%- assign brand_filter = param | remove: 'filter.v.brand=' -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if brand_filter != blank -%}
      {%- assign selected_brands = brand_filter | split: '+' -%}
      {%- unless selected_brands contains product.vendor -%}
        {%- assign include_product = false -%}
      {%- endunless -%}
    {%- endif -%}
    
    {%- comment -%} 检查产品类型筛选 {%- endcomment -%}
    {%- assign type_filter = '' -%}
    {%- for param in query_params -%}
      {%- if param contains 'filter.v.product_type' -%}
        {%- assign type_filter = param | remove: 'filter.v.product_type=' -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if type_filter != blank -%}
      {%- assign selected_types = type_filter | split: '+' -%}
      {%- assign product_type = product.type | replace: ' ', '-' -%}
      {%- unless selected_types contains product_type -%}
        {%- assign include_product = false -%}
      {%- endunless -%}
    {%- endif -%}
    
    {%- comment -%} 检查颜色筛选 {%- endcomment -%}
    {%- assign color_filter = '' -%}
    {%- for param in query_params -%}
      {%- if param contains 'filter.v.color' -%}
        {%- assign color_filter = param | remove: 'filter.v.color=' -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if color_filter != blank -%}
      {%- assign selected_colors = color_filter | split: '+' -%}
      {%- assign product_colors = '' | split: '' -%}
      {%- for variant in product.variants -%}
        {%- if variant.available -%}
          {%- assign variant_color = variant.title | split: ' / ' | first -%}
          {%- unless product_colors contains variant_color -%}
            {%- assign product_colors = product_colors | push: variant_color -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign color_match = false -%}
      {%- for color in product_colors -%}
        {%- if selected_colors contains color -%}
          {%- assign color_match = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless color_match -%}
        {%- assign include_product = false -%}
      {%- endunless -%}
    {%- endif -%}
    
    {%- comment -%} 检查SIZE筛选 {%- endcomment -%}
    {%- assign size_filter = '' -%}
    {%- for param in query_params -%}
      {%- if param contains 'filter.v.size' -%}
        {%- assign size_filter = param | remove: 'filter.v.size=' -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if size_filter != blank -%}
      {%- assign selected_sizes = size_filter | split: '+' -%}
      {%- assign product_sizes = '' | split: '' -%}
      {%- for variant in product.variants -%}
        {%- if variant.available -%}
          {%- assign variant_size = variant.title | split: ' / ' | last -%}
          {%- unless product_sizes contains variant_size -%}
            {%- assign product_sizes = product_sizes | push: variant_size -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
      {%- assign size_match = false -%}
      {%- for size in product_sizes -%}
        {%- if selected_sizes contains size -%}
          {%- assign size_match = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless size_match -%}
        {%- assign include_product = false -%}
      {%- endunless -%}
    {%- endif -%}
    
    {%- if include_product -%}
      {%- assign filtered_product_count = filtered_product_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
  
  <button class="apply-btn" onclick="applyFilters()">
    SHOW {{ filtered_product_count }} RESULTS 
  </button>
</div>

<script>
function toggleFilterGroup(header) {
  const group = header.parentElement;
  group.classList.toggle('active');
  const icon = header.querySelector('span');
  icon.textContent = group.classList.contains('active') ? '-' : '+';
}

function applyFilters() {
  const selectedSort = document.querySelector('input[name="sort"]:checked').value;
  const selectedBrands = Array.from(document.querySelectorAll('input[name="brand"]:checked')).map(el => el.value);
  const selectedSizes = Array.from(document.querySelectorAll('input[name="size"]:checked')).map(el => el.value);
  const selectedTypes = Array.from(document.querySelectorAll('input[name="type"]:checked')).map(el => el.value);
  const selectedColors = Array.from(document.querySelectorAll('input[name="color"]:checked')).map(el => el.value);

  // 构建查询参数
  let queryParams = [];
  
  // 添加排序参数
  let sortParam = '';
  switch(selectedSort) {
    case 'featured':
      sortParam = 'manual';
      break;
    case 'best-selling':
      sortParam = 'best-selling';
      break;
    case 'a-z':
      sortParam = 'title-ascending';
      break;
    case 'z-a':
      sortParam = 'title-descending';
      break;
    case 'price-low-high':
      sortParam = 'price-ascending';
      break;
    case 'price-high-low':
      sortParam = 'price-descending';
      break;
    default:
      sortParam = 'manual';
  }
  queryParams.push(`sort_by=${sortParam}`);

  // 强制重新加载页面以确保排序生效
  if (selectedSort.includes('price')) {
    queryParams.push('force_reload=1');
  }

  // 添加筛选参数
  if (selectedBrands.length) queryParams.push(`filter.v.brand=${selectedBrands.join('+')}`);
  if (selectedSizes.length) queryParams.push(`filter.v.size=${selectedSizes.join('+')}`);
  if (selectedTypes.length) queryParams.push(`filter.v.product_type=${selectedTypes.join('+')}`);
  if (selectedColors.length) queryParams.push(`filter.v.color=${selectedColors.join('+')}`);

  // 重新加载页面应用筛选
  window.location.search = queryParams.join('&');
}
</script>
