{% comment %}
  Renders a header search modal. Should be used with 'header.liquid'

  Accepts:
  - input_id: {String} Id for the search input element (required)

  Usage:
  {% render 'header-search', input_id: 'My-Id'%}
{% endcomment %}

<details-modal class="header__search">
  <details>
    <summary
      class="header__icon header__icon--search header__icon--summary link focus-inset modal__toggle"
      aria-haspopup="dialog"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <span>
        <span class="svg-wrapper">
          <svg width="24" height="24" viewBox="0 0 100 100" aria-hidden="true" focusable="false" class="icon" fill="currentColor" style="display: block;">
            <path fill="currentColor" fill-rule="evenodd" d="M67.1755 74.4267c-6.9463 5.3998-15.6749 8.6153-25.1545 8.6153C19.3657 83.042 1 64.6763 1 42.021S19.3657 1 42.021 1s41.021 18.3657 41.021 41.021c0 9.4794-3.2154 18.2078-8.615 25.1541L100 92.7481l-7.2516 7.2515-25.5729-25.5729Zm5.6113-32.4057c0 16.9915-13.7743 30.7658-30.7658 30.7658S11.2553 59.0125 11.2553 42.021 25.0295 11.2553 42.021 11.2553 72.7868 25.0295 72.7868 42.021Z" clip-rule="evenodd"></path>
          </svg>
        </span>
        <span class="svg-wrapper header__icon-close">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </span>
    </summary>
    <div class="modal-overlay"></div>
    <div
      class="search-modal modal__content gradient"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.search.search' | t }}"
      style="position: fixed; top: 0; left: 0; width: 100%; height: 100vh; max-height: 100vh; margin: 0; border-radius: 0; overflow: hidden;"
    >
        <div
        class="search-modal__content{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} search-modal__content-top{% else %} search-modal__content-bottom{% endif %}"
        tabindex="-1"
        style="height: 100vh; max-height: 100vh; overflow-y: auto;"
      >
        <div class="search-modal__header">
          <h2 class="search-modal__title">SEARCH</h2>
          <button
            type="button"
            class="search-modal__close-button modal__close-button link link--text focus-inset"
            aria-label="{{ 'accessibility.close' | t }}"
          >
            <span class="svg-wrapper">
              {% render 'custom-close' %}
            </span>
          </button>
        </div>
        
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="search-modal__form">
        {%- endif -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
          <div class="field">
            <input
              class="search__input field__input"
              id="{{ input_id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.placeholder' | t }}"
              role="combobox"
              aria-expanded="false"
              aria-owns="predictive-search-results"
              aria-controls="predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocorrect="off"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
            />
            <input type="hidden" name="options[prefix]" value="last">
            <button
              type="reset"
              class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
              aria-label="{{ 'general.search.reset' | t }}"
            >
              <span class="svg-wrapper">
                {{- 'icon-reset.svg' | inline_asset_content -}}
              </span>
            </button>
          </div>

          {%- if settings.predictive_search_enabled -%}
            <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
              <div class="search-results-container">
                <div class="search-results-header">
                  <span class="results-count">12</span>
                  <a href="{{ routes.search_url }}?q={{ search.terms | escape }}" class="view-all-results">
                    VIEW ALL RESULTS
                  </a>
                </div>
                
                <div class="search-suggestions">
                  <h3 class="suggestions-title">SUGGESTIONS</h3>
                  <ul class="suggestions-list" id="predictive-search-results">
                    <li><a href="#">12 hz</a></li>
                  </ul>
                </div>
                
                <div class="search-products">
                  <h3 class="products-title">PRODUCTS</h3>
                  <div class="products-grid">
                    <div class="product-item">
                      <div class="product-image">
                        <img src="https://via.placeholder.com/150x150" alt="New Balance x Auralee CT500v1 Java / Delicioso">
                      </div>
                      <div class="product-info">
                        <h4 class="product-title">New Balance x Auralee CT500v1 Java / Delicioso</h4>
                        <p class="product-price">€152</p>
                      </div>
                    </div>
                    
                    <div class="product-item">
                      <div class="product-image">
                        <img src="https://via.placeholder.com/150x150" alt="On Cloudmonster Hyper PAF 1 M Black / Black">
                      </div>
                      <div class="product-info">
                        <h4 class="product-title">On Cloudmonster Hyper PAF 1 M Black / Black</h4>
                        <p class="product-price">€236</p>
                      </div>
                    </div>
                    
                    <div class="product-item">
                      <div class="product-image">
                        <img src="https://via.placeholder.com/150x150" alt="New Balance 1906 Loafer Black Croc">
                      </div>
                      <div class="product-info">
                        <h4 class="product-title">New Balance 1906 Loafer Black Croc</h4>
                        <p class="product-price">€124</p>
                      </div>
                    </div>
                    
                    <div class="product-item">
                      <div class="product-image">
                        <img src="https://via.placeholder.com/150x150" alt="New Balance 1906 Loafer Black">
                      </div>
                      <div class="product-info">
                        <h4 class="product-title">New Balance 1906 Loafer Black</h4>
                        <p class="product-price">€124</p>
                      </div>
                    </div>
                    
                    <div class="product-item">
                      <div class="product-image">
                        <img src="https://via.placeholder.com/150x150" alt="New Balance x Auralee CT500v1 Asparagus / Green Hay">
                      </div>
                      <div class="product-info">
                        <h4 class="product-title">New Balance x Auralee CT500v1 Asparagus / Green Hay</h4>
                        <p class="product-price">€152</p>
                      </div>
                    </div>
                    
                    <div class="product-item">
                      <div class="product-image">
                        <img src="https://via.placeholder.com/150x150" alt="adidas by Wales Bonner Karintha Lo Sequin Core Black / Silver Metallic">
                      </div>
                      <div class="product-info">
                        <h4 class="product-title">adidas by Wales Bonner Karintha Lo Sequin Core Black / Silver Metallic</h4>
                        <p class="product-price">
                          <span class="sale-price">€218</span>
                          <span class="original-price">€312</span>
                        </p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              
              {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
            </div>

            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}
        </form>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}
      </div>
    </div>
  </details>
</details-modal>

<script src="{{ 'custom-search.js' | asset_url }}" defer></script>

<style>
.search-modal .predictive-search {
  position: static;
  border: none;
  box-shadow: none;
  background: transparent;
  width: 100%;
}

.search-modal .predictive-search__results-groups-wrapper {
  display: none;
}

.search-modal .search-results-container {
  padding: 2rem 0;
  max-width: 100%;
}

.search-modal .search-results-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  padding: 0 2rem;
}

.search-modal .results-count {
  font-size: 1.1rem;
  font-weight: 600;
  color: #333;
}

.search-modal .view-all-results {
  font-size: 0.9rem;
  font-weight: 600;
  color: #333;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.search-modal .view-all-results:hover {
  text-decoration: underline;
}

.search-modal .search-suggestions {
  margin-bottom: 2rem;
  padding: 0 2rem;
}

.search-modal .suggestions-title,
.search-modal .products-title {
  font-size: 1.1rem;
  font-weight: 600;
  margin-bottom: 1rem;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.search-modal .suggestions-list {
  list-style: none;
  padding: 0;
}

.search-modal .suggestions-list li {
  margin-bottom: 0.5rem;
}

.search-modal .suggestions-list a {
  color: #666;
  text-decoration: none;
  font-size: 1rem;
}

.search-modal .suggestions-list a:hover {
  color: #333;
}

.search-modal .search-products {
  padding: 0 2rem;
}

.search-modal .products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 2rem;
}

.search-modal .product-item {
  display: flex;
  gap: 1rem;
  align-items: flex-start;
}

.search-modal .product-image {
  width: 80px;
  height: 80px;
  flex-shrink: 0;
}

.search-modal .product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.search-modal .product-info {
  flex: 1;
}

.search-modal .product-title {
  font-size: 0.9rem;
  font-weight: 400;
  margin: 0 0 0.5rem 0;
  line-height: 1.3;
}

.search-modal .product-price {
  font-size: 0.9rem;
  font-weight: 600;
  margin: 0;
}

@media (max-width: 768px) {
  .search-modal .products-grid {
    grid-template-columns: 1fr;
  }
  
  .search-modal .search-results-header,
  .search-modal .search-suggestions,
  .search-modal .search-products {
    padding: 0 1rem;
  }
}
/* 修复高度限制 */
.header__search {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100vh !important;
  z-index: 99999 !important;
}

.header__search details {
  height: 100vh !important;
}

.header__search .search-modal {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100vh !important;
  max-height: 100vh !important;
  margin: 0 !important;
  border-radius: 0 !important;
  overflow: hidden !important;
}

.header__search .search-modal__content {
  height: 100vh !important;
  max-height: 100vh !important;
  overflow-y: auto !important;
  padding: 2rem !important;
}

.modal-overlay {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  width: 100% !important;
  height: 100% !important;
  z-index: 99998 !important;
}
</style>
