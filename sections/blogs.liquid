{{ 'section-main-blog.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* 博客列表容器 */
  .blog-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .blog-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .blog-title {
    font-size: 42px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 16px;
    line-height: 1.2;
  }

  .blog-subtitle {
    font-size: 18px;
    color: #666;
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* 博客文章网格 */
  .blog-grid {
    display: flex;
    flex-direction: column;
    gap: 60px;
  }

  /* 博客文章卡片 */
  .blog-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
  }

  @media (min-width: 768px) {
    .blog-card {
      flex-direction: row;
      min-height: 300px;
    }
  }

  .blog-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
  }

  /* 图片区域 */
  .blog-image-wrapper {
    position: relative;
    width: 100%;
    height: 250px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .blog-image-wrapper {
      width: 40%;
      height: auto;
      min-height: 300px;
    }
  }

  .blog-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .blog-card:hover .blog-image {
    transform: scale(1.05);
  }

  .blog-category {
    position: absolute;
    top: 16px;
    left: 16px;
    background: #871d16;
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* 内容区域 */
  .blog-content {
    padding: 32px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 16px;
    font-size: 14px;
    color: #666;
  }

  .blog-date {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .blog-author {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .blog-reading-time {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .blog-card-title {
    font-size: 24px;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .blog-card-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .blog-card-title a:hover {
    color: #871d16;
  }

  .blog-excerpt {
    font-size: 16px;
    color: #555;
    line-height: 1.6;
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .blog-tag {
    background: #f5f5f5;
    color: #666;
    padding: 4px 12px;
    border-radius: 16px;
    font-size: 12px;
    transition: all 0.2s ease;
  }

  .blog-tag:hover {
    background: #871d16;
    color: white;
  }

  .read-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #871d16;
    font-weight: 600;
    text-decoration: none;
    margin-top: auto;
    transition: gap 0.2s ease;
  }

  .read-more:hover {
    gap: 12px;
  }

  .read-more svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .read-more:hover svg {
    transform: translateX(4px);
  }

  /* 文章图片预览 */
  .blog-preview-images {
    display: flex;
    gap: 8px;
    margin: 16px 0;
    flex-wrap: wrap;
  }

  .preview-image {
    width: 80px;
    height: 80px;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid #eee;
    transition: transform 0.2s ease;
  }

  .preview-image:hover {
    transform: scale(1.1);
  }

  /* 文章内容中的图片样式 */
  .blog-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 16px 0;
  }

  /* 特色图片样式增强 */
  .blog-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  /* 图片网格布局 */
  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 16px;
    margin: 20px 0;
  }

  .image-grid img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 8px;
    transition: transform 0.2s ease;
  }

  .image-grid img:hover {
    transform: scale(1.05);
  }

  /* 分页 */
  .blog-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 60px;
  }

  .pagination-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid #ddd;
    border-radius: 8px;
    text-decoration: none;
    color: #666;
    transition: all 0.2s ease;
  }

  .pagination-link:hover,
  .pagination-link.active {
    background: #871d16;
    color: white;
    border-color: #871d16;
  }

  .pagination-link.disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* 响应式设计 */
  @media (max-width: 767px) {
    .blog-title {
      font-size: 32px;
    }

    .blog-card-title {
      font-size: 20px;
    }

    .blog-content {
      padding: 24px;
    }

    .blog-meta {
      flex-wrap: wrap;
      gap: 12px;
    }
  }

  @media (max-width: 480px) {
    .blog-container {
      padding: 0 16px;
    }

    .blog-card {
      margin: 0 -16px;
      border-radius: 0;
    }

    .blog-image-wrapper {
      height: 200px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="blog-container section-{{ section.id }}-padding">
    <!-- 博客头部 -->
    <div class="blog-header">
      <h1 class="blog-title">{{ section.settings.title }}</h1>
      <p class="blog-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <!-- 博客文章列表 -->
    <div class="blog-grid">
      {%- paginate blog.articles by section.settings.posts_per_page -%}
        {%- for article in blog.articles -%}
          <article class="blog-card">
            <!-- 文章图片 -->
            <div class="blog-image-wrapper">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 600, height: 400, crop: 'center' }}"
                  alt="{{ article.title }}"
                  class="blog-image"
                  loading="lazy"
                  width="600"
                  height="400"
                >
              {%- else -%}
                <div
                  class="blog-image"
                  style="background: linear-gradient(135deg, #f5f5f5, #e0e0e0); display: flex; align-items: center; justify-content: center;"
                >
                  <span style="color: #999; font-size: 16px;">📰</span>
                </div>
              {%- endif -%}

              {%- if article.tags.first -%}
                <span class="blog-category">{{ article.tags.first }}</span>
              {%- endif -%}
            </div>

            <!-- 文章内容 -->
            <div class="blog-content">
              <div class="blog-meta">
                <span class="blog-date">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                  </svg>
                  {{ article.published_at | date: '%B %d, %Y' }}
                </span>

                {%- if article.author -%}
                  <span class="blog-author">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                      <circle cx="12" cy="7" r="4"/>
                    </svg>
                    {{ article.author }}
                  </span>
                {%- endif -%}

                <span class="blog-reading-time">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 5 12 12 16 14"/>
                  </svg>
                  {% assign word_count = article.content | strip_html | split: ' ' | size %}
                  {{ word_count | divided_by: 200 | ceil }} min read
                </span>
              </div>

              <h2 class="blog-card-title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h2>

              <div class="blog-excerpt">
                {%- if article.excerpt -%}
                  {{ article.excerpt | strip_html | truncatewords: 30 }}
                {%- else -%}
                  {{ article.content | strip_html | truncatewords: 30 }}
                {%- endif -%}
              </div>

              {%- if article.image -%}
                <div class="blog-preview-images">
                  <img
                    src="{{ article.image | image_url: width: 200, height: 200, crop: 'center' }}"
                    alt="{{ article.title }}"
                    class="preview-image"
                    loading="lazy"
                    width="80"
                    height="80"
                  >
                </div>
              {%- endif -%}

              {%- if article.tags.size > 0 -%}
                <div class="blog-tags">
                  {%- for tag in article.tags limit: 3 -%}
                    <span class="blog-tag">{{ tag }}</span>
                  {%- endfor -%}
                </div>
              {%- endif -%}

              <a href="{{ article.url }}" class="read-more">
                Read More
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12 5 19 12 12 19"/>
                </svg>
              </a>
            </div>
          </article>
        {%- endfor -%}

        <!-- 分页 -->
        {%- if paginate.pages > 1 -%}
          <div class="blog-pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="pagination-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="15 18 9 12 15 6"/>
                </svg>
              </a>
            {%- else -%}
              <span class="pagination-link disabled">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="15 18 9 12 15 6"/>
                </svg>
              </span>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}" class="pagination-link">{{ part.title }}</a>
              {%- else -%}
                {%- if part.title == paginate.current_page -%}
                  <span class="pagination-link active">{{ part.title }}</span>
                {%- else -%}
                  <span class="pagination-link">{{ part.title }}</span>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="pagination-link">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </a>
            {%- else -%}
              <span class="pagination-link disabled">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="9 18 15 12 9 6"/>
                </svg>
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog List",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "default": "Latest News & Articles",
      "label": "Section Title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "default": "Discover insights, tips, and stories from our team",
      "label": "Section Subtitle"
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6,
      "label": "Posts per page"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Layout settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Blog List"
    }
  ]
}
{% endschema %}
