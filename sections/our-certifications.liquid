<div class="certifications-section">
  <div class="certifications-container">
    <div class="certifications-header">
      <h2 class="certifications-title">
        {{ section.settings.title | default: "Our Certifications" }}
      </h2>
      {% if section.settings.subtitle != blank %}
        <p class="certifications-subtitle">
          {{ section.settings.subtitle }}
        </p>
      {% endif %}
    </div>
    
    <div class="certifications-grid">
      <!-- CE Certification -->
      <div class="certification-card">
        <div class="certification-icon">
          {% if section.settings.ce_icon != blank %}
            <img src="{{ section.settings.ce_icon | img_url: '120x120' }}" alt="CE Certification" class="cert-icon-image">
          {% else %}
            <div class="cert-icon-placeholder">
              <span>CE</span>
            </div>
          {% endif %}
        </div>
        <div class="certification-content">
          <h3 class="certification-name">
            {{ section.settings.ce_title | default: "CE Certification" }}
          </h3>
          <p class="certification-description">
            {{ section.settings.ce_description | default: "European Conformity certification ensuring our products meet EU safety, health and environmental protection standards." }}
          </p>
        </div>
      </div>

      <!-- ISO Certification -->
      <div class="certification-card">
        <div class="certification-icon">
          {% if section.settings.iso_icon != blank %}
            <img src="{{ section.settings.iso_icon | img_url: '120x120' }}" alt="ISO Certification" class="cert-icon-image">
          {% else %}
            <div class="cert-icon-placeholder">
              <span>ISO</span>
            </div>
          {% endif %}
        </div>
        <div class="certification-content">
          <h3 class="certification-name">
            {{ section.settings.iso_title | default: "ISO Certification" }}
          </h3>
          <p class="certification-description">
            {{ section.settings.iso_description | default: "International Organization for Standardization certification demonstrating our commitment to quality management systems." }}
          </p>
        </div>
      </div>

      <!-- RoHS Certification -->
      <div class="certification-card">
        <div class="certification-icon">
          {% if section.settings.rohs_icon != blank %}
            <img src="{{ section.settings.rohs_icon | img_url: '120x120' }}" alt="RoHS Certification" class="cert-icon-image">
          {% else %}
            <div class="cert-icon-placeholder">
              <span>RoHS</span>
            </div>
          {% endif %}
        </div>
        <div class="certification-content">
          <h3 class="certification-name">
            {{ section.settings.rohs_title | default: "RoHS Certification" }}
          </h3>
          <p class="certification-description">
            {{ section.settings.rohs_description | default: "Restriction of Hazardous Substances compliance ensuring our products are environmentally friendly and safe." }}
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.certifications-section {
  padding: 80px 0;
  background-color: #ffffff;
}

.certifications-container {
  max-width: 1520px;
  margin: 0 auto;
  padding: 0 20px;
}

.certifications-header {
  text-align: center;
  margin-bottom: 80px;
}

.certifications-title {
  font-size: 48px;
  font-weight: 500;
  color: #161616;
  margin: 0 0 24px 0;
  line-height: 1.2;
}

.certifications-subtitle {
  font-size: 18px;
  font-weight: 400;
  color: rgba(22, 22, 22, 0.6);
  margin: 0 auto;
  max-width: 800px;
  line-height: 1.6;
}

.certifications-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 40px;
  align-items: stretch;
}

.certification-card {
  width: 460px;
  height: 200px;
  box-sizing: border-box;
  border: 1px solid rgba(22, 22, 22, 0.25);
  border-radius: 16px;
  box-shadow: 2px 2px 4px 0px rgba(22, 22, 22, 0.15);
  background: rgba(255, 255, 255, 1);
  padding: 40px 32px;
  text-align: left;
  transition: all 0.3s ease;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
}

.certification-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
  border-color: rgba(194, 46, 53, 0.2);
}

.certification-icon {
  width: 70px;
  height: 70px;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  flex-shrink: 0;
  align-self: center;
}

.cert-icon-image {
  width: 70px;
  height: 70px;
  object-fit: contain;
  border-radius: 50%;
}

.cert-icon-placeholder {
  width: 120px;
  height: 120px;
  background: linear-gradient(135deg, #C22E35 0%, #A02329 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 24px;
  font-weight: 600;
  letter-spacing: 1px;
}

.certification-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: left;
}

.certification-name {
  color: rgba(22, 22, 22, 1);
  font-family: Poppins;
  font-size: 28px;
  font-weight: 500;
  line-height: 36px;
  letter-spacing: 0px;
  text-align: center;
  margin: 0 0 16px 0;
}

.certification-description {
  color: rgba(22, 22, 22, 0.5);
  font-family: Poppins;
  font-size: 16px;
  font-weight: 400;
  line-height: 24px;
  letter-spacing: 0px;
  text-align: center;
  margin: 0;
  flex: 1;
  width: 308px;
  max-width: 308px;
}

/* 响应式设计 */

/* 大屏幕 (1200px+) - 保持原有设计 */
@media (min-width: 1200px) {
  .certifications-grid {
    grid-template-columns: repeat(3, 1fr);
  }
  
  .certification-card {
    width: 100%;
    max-width: 460px;
    height: auto;
    min-height: 200px;
  }
  
  .certification-description {
    width: 100%;
    max-width: 308px;
  }
}

/* 中等屏幕 (768px - 1199px) - 两列布局 */
@media (max-width: 1199px) and (min-width: 768px) {
  .certifications-section {
    padding: 60px 0;
  }
  
  .certifications-container {
    padding: 0 30px;
  }
  
  .certifications-header {
    margin-bottom: 60px;
  }
  
  .certifications-title {
    font-size: 36px;
    margin-bottom: 20px;
  }
  
  .certifications-subtitle {
    font-size: 16px;
  }
  
  .certifications-grid {
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    justify-items: center;
  }
  
  .certification-card {
    width: 100%;
    max-width: 400px;
    height: auto;
    min-height: 180px;
    padding: 30px 24px;
  }
  
  .certification-icon {
    width: 60px;
    height: 60px;
    margin-bottom: 14px;
  }
  
  .cert-icon-image {
    width: 60px;
    height: 60px;
  }
  
  .cert-icon-placeholder {
    width: 100px;
    height: 100px;
    font-size: 20px;
  }
  
  .certification-name {
    font-size: 24px;
    line-height: 30px;
    margin-bottom: 12px;
  }
  
  .certification-description {
    font-size: 14px;
    line-height: 20px;
    width: 100%;
    max-width: none;
  }
}

/* 小屏幕 (481px - 767px) - 单列布局，卡片居中 */
@media (max-width: 767px) and (min-width: 481px) {
  .certifications-section {
    padding: 40px 0;
  }
  
  .certifications-container {
    padding: 0 20px;
  }
  
  .certifications-header {
    margin-bottom: 40px;
  }
  
  .certifications-title {
    font-size: 28px;
    margin-bottom: 16px;
  }
  
  .certifications-subtitle {
    font-size: 14px;
  }
  
  .certifications-grid {
    grid-template-columns: 1fr;
    gap: 24px;
    justify-items: center;
  }
  
  .certification-card {
    width: 100%;
    max-width: 400px;
    height: auto;
    min-height: 140px;
    padding: 24px 20px;
  }
  
  .certification-icon {
    width: 50px;
    height: 50px;
    margin-bottom: 10px;
  }
  
  .cert-icon-image {
    width: 50px;
    height: 50px;
  }
  
  .cert-icon-placeholder {
    width: 80px;
    height: 80px;
    font-size: 16px;
  }
  
  .certification-name {
    font-size: 20px;
    line-height: 26px;
    margin-bottom: 10px;
  }
  
  .certification-description {
    font-size: 13px;
    line-height: 18px;
    width: 100%;
    max-width: none;
  }
}

/* 超小屏幕 (320px - 480px) - 紧凑单列布局 */
@media (max-width: 480px) {
  .certifications-section {
    padding: 30px 0;
  }
  
  .certifications-container {
    padding: 0 16px;
  }
  
  .certifications-header {
    margin-bottom: 30px;
  }
  
  .certifications-title {
    font-size: 24px;
    margin-bottom: 12px;
  }
  
  .certifications-subtitle {
    font-size: 12px;
  }
  
  .certifications-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  
  .certification-card {
    width: 100%;
    height: auto;
    min-height: 100px;
    padding: 20px 16px;
    border-radius: 12px;
  }
  
  .certification-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 10px;
  }
  
  .cert-icon-image {
    width: 40px;
    height: 40px;
  }
  
  .cert-icon-placeholder {
    width: 60px;
    height: 60px;
    font-size: 12px;
  }
  
  .certification-name {
    font-size: 18px;
    line-height: 22px;
    margin-bottom: 8px;
  }
  
  .certification-description {
    font-size: 12px;
    line-height: 16px;
    width: 100%;
    max-width: none;
  }
}

/* 极小屏幕 (最小320px) - 最紧凑布局 */
@media (max-width: 360px) {
  .certifications-section {
    padding: 24px 0;
  }
  
  .certifications-container {
    padding: 0 12px;
  }
  
  .certifications-header {
    margin-bottom: 24px;
  }
  
  .certifications-title {
    font-size: 20px;
    margin-bottom: 10px;
  }
  
  .certifications-subtitle {
    font-size: 11px;
  }
  
  .certifications-grid {
    gap: 16px;
  }
  
  .certification-card {
    min-height: 90px;
    padding: 16px 12px;
    border-radius: 10px;
  }
  
  .certification-icon {
    width: 40px;
    height: 40px;
    margin-bottom: 10px;
  }
  
  .cert-icon-image {
    width: 40px;
    height: 40px;
  }
  
  .cert-icon-placeholder {
    width: 50px;
    height: 50px;
    font-size: 10px;
  }
  
  .certification-name {
    font-size: 16px;
    line-height: 20px;
    margin-bottom: 6px;
  }
  
  .certification-description {
    font-size: 11px;
    line-height: 15px;
  }
}
</style>

{% schema %}
{
  "name": "Our Certifications",
  "tag": "section",
  "class": "our-certifications-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Our Certifications"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "info": "Optional subtitle text"
    },
    {
      "type": "header",
      "content": "CE Certification"
    },
    {
      "type": "image_picker",
      "id": "ce_icon",
      "label": "CE Icon",
      "info": "Upload CE certification icon (recommended size: 120x120px)"
    },
    {
      "type": "text",
      "id": "ce_title",
      "label": "CE Title",
      "default": "CE Certification"
    },
    {
      "type": "textarea",
      "id": "ce_description",
      "label": "CE Description",
      "default": "European Conformity certification ensuring our products meet EU safety, health and environmental protection standards."
    },
    {
      "type": "header",
      "content": "ISO Certification"
    },
    {
      "type": "image_picker",
      "id": "iso_icon",
      "label": "ISO Icon",
      "info": "Upload ISO certification icon (recommended size: 120x120px)"
    },
    {
      "type": "text",
      "id": "iso_title",
      "label": "ISO Title",
      "default": "ISO Certification"
    },
    {
      "type": "textarea",
      "id": "iso_description",
      "label": "ISO Description",
      "default": "International Organization for Standardization certification demonstrating our commitment to quality management systems."
    },
    {
      "type": "header",
      "content": "RoHS Certification"
    },
    {
      "type": "image_picker",
      "id": "rohs_icon",
      "label": "RoHS Icon",
      "info": "Upload RoHS certification icon (recommended size: 120x120px)"
    },
    {
      "type": "text",
      "id": "rohs_title",
      "label": "RoHS Title",
      "default": "RoHS Certification"
    },
    {
      "type": "textarea",
      "id": "rohs_description",
      "label": "RoHS Description",
      "default": "Restriction of Hazardous Substances compliance ensuring our products are environmentally friendly and safe."
    }
  ],
  "presets": [
    {
      "name": "Our Certifications",
      "settings": {
        "title": "Our Certifications",
        "ce_title": "CE Certification",
        "ce_description": "European Conformity certification ensuring our products meet EU safety, health and environmental protection standards.",
        "iso_title": "ISO Certification",
        "iso_description": "International Organization for Standardization certification demonstrating our commitment to quality management systems.",
        "rohs_title": "RoHS Certification",
        "rohs_description": "Restriction of Hazardous Substances compliance ensuring our products are environmentally friendly and safe."
      }
    }
  ]
}
{% endschema %}
