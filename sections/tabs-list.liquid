{% comment %}
  Carousel de bijoux - Section Liquid (Fixed Image Loading)
  ✅ Fixed: Image loading with correct Liquid syntax
  ✅ Removed: Product title and price
  ✅ Removed: Navigation buttons
  ✅ Added: Smooth scroll functionality
  ✅ Modified: Display 5 products per view
{% endcomment %}

<div class="jewelry-carousel-section" data-section-id="{{ section.id }}">
  <div class="container">
    
    <!-- Section Title and Subtitle -->
    {% if section.settings.sectiontitle != blank  %}
      <div class="section-header">
        {% if section.settings.sectiontitle != blank %}
          {% if section.settings.titlelink != blank %}
            <a href="{{ section.settings.titlelink }}" class="section-title-link">
              <h2 class="section-title1">{{ section.settings.sectiontitle }}</h2>
            </a>
          {% else %}
            <h2 class="section-title1">{{ section.settings.sectiontitle }}</h2>
          {% endif %}
        {% endif %}
      </div>
    {% endif %}
    
    <!-- Navigation par onglets -->
    <div class="tab-navigation">
      <div class="tab-container">
        {% for block in section.blocks %}
          {% if block.type == 'collectiontab' %}
            <button
              class="tab-button"
              data-tab="{{ block.id }}"
              data-collection="{{ block.settings.collection.handle }}"
            >
              {{ block.settings.tabtitle | upcase }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Conteneur du carousel -->
    <div class="carousel-wrapper">
      {% for block in section.blocks %}
        {% if block.type == 'collectiontab' %}
          <div 
            class="carousel-content"
            data-content="{{ block.id }}"
          >
            <div class="carousel-track">
              
              <!-- Cartes produits : chaque carte est un lien vers la page produit -->
              {% assign collection = collections[block.settings.collection.handle] %}
              {% if collection and collection.products.size > 0 %}
                {% for product in collection.products limit: block.settings.productslimit %}
                  <a href="{{ product.url }}" class="card-container card-link">
                    <div class="card-inner">
                      <!-- Image container -->
                      <div class="image-container product-card">
                        {% if product.featured_image %}
                          <img
                            src="{{ product.featured_image | image_url: width: 400, height: 500 }}"
                            alt="{{ product.title | escape }}"
                            class="card-image main-image"
                            loading="lazy"
                          >
                          {% if product.images[1] %}
                            <img
                              src="{{ product.images[1] | image_url: width: 400, height: 500 }}"
                              alt="{{ product.title | escape }}"
                              class="card-image hover-image"
                              loading="lazy"
                            >
                          {% endif %}
                        {% else %}
                          <div class="placeholder-image">
                            <span>{{ product.title }}</span>
                          </div>
                        {% endif %}
                        
                        <!-- Badge Best Seller conditionnel -->
                        {% if product.tags contains 'bestseller' %}
                          <div class="bestseller-badge"> 
                            BEST SELLER
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </a>
                {% endfor %}
              {% else %}
                <div class="no-products-message">
                  <p>Aucun produit trouvé dans cette collection.</p>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
/* Variables CSS */
:root {
  --cream: #F5F1EB;
  --warm-beige: #E8DDD4;
  --soft-brown: #C4A484;
  --pearl-white: #FFF8F0;
  --gray-50: #F9FAFB;
  --gray-100: #F3F4F6;
  --gray-200: #E5E7EB;
  --gray-400: #9CA3AF;
  --gray-500: #6B7280;
  --gray-600: #4B5563;
  --gray-700: #374151;
  --gray-900: #111827;
  --white: #FFFFFF;
  --amber-400: #FBBF24;
  --orange-400: #FB923C;
}

/* Section principale */
.jewelry-carousel-section {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: transparent;
  min-height: 50vh;
  padding: 1rem 0;
}

/* Container principal */
.container {
  max-width: 100rem;
  margin: 0 auto;
  padding: 0 1rem;
}

/* Section Header */
.section-header {
  text-align: center;
  margin-bottom: 2rem;
}

/* 标题链接样式 */
.section-title-link {
  text-decoration: none;
  color: inherit;
  display: inline-block;
  transition: all 0.3s ease;
}

.section-title-link:hover {
  transform: translateY(-2px);
  opacity: 0.8;
}

.section-title-link:hover .section-title1 {
  color: var(--soft-brown);
}

.section-title1 {
  font-size: 2.5rem;
  font-family: Georgia, serif;
  font-weight: normal;
  color: var(--color, var(--font-h2-color));
  margin-bottom: 0.5rem;
  line-height: 1.2;
  transition: color 0.3s ease;
}

/* 当标题是链接时，添加光标指针 */
.section-title-link .section-title1 {
  cursor: pointer;
}

/* Navigation des onglets */
.tab-navigation {
  margin-bottom: 2rem;
}

.tab-container {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.tab-button {
  padding: 0.5rem 0;
  font-size: 0.875rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  color: #5c3d3b;
  background: none;
  border: none;
  cursor: pointer;
  transition: color 0.3s ease;
}

.tab-button:hover,
.tab-button.active {
  color: var(--gray-900);
}

.tab-button.active {
  font-weight: 600;
}

/* Carousel wrapper */
.carousel-wrapper {
  position: relative;
  overflow: hidden;
}

.carousel-content {
  display: none;
}

.carousel-content.active {
  display: block;
}

.carousel-track {
  display: flex;
  gap: 1rem;
  overflow-x: auto;
  scroll-behavior: smooth;
  scrollbar-width: none; /* Firefox */
  -ms-overflow-style: none; /* IE and Edge */
  padding-bottom: 1rem;
  padding-right: 1rem;
}

.carousel-track::-webkit-scrollbar {
  display: none; /* Chrome, Safari and Opera */
}

/* Cards containers - 修改为显示5个产品 */
.card-container {
  flex-shrink: 0;
  width: calc((100% - 4rem) / 5); /* 5个产品，4个间隙 */
  min-width: 200px; /* 最小宽度保证在小屏幕上的显示 */
}

.card-link {
  text-decoration: none;
  color: inherit;
  display: block;
  transition: all 0.3s ease;
}

.card-link:hover {
  transform: translateY(-6px);
}

.card-link .card-inner {
  height: 100%;
}

/* Image containers */
.image-container {
  position: relative;
  background-color: var(--white);
  overflow: hidden;
  transition: transform 0.3s ease;
  border-radius: 12px;
  height: 20rem; /* 固定高度 */
}

.image-container:hover {
  transform: scale(1.02);
}

.card-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.5s ease;
  display: block;
}

.hover-image {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
}

.product-card:hover .hover-image {
  opacity: 1;
}

.placeholder-image {
  width: 100%;
  height: 100%;
  background-color: var(--gray-200);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gray-400);
  font-size: 0.875rem;
  text-align: center;
  padding: 1rem;
}

/* Badges */
.bestseller-badge {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  background: linear-gradient(135deg, var(--amber-400) 0%, var(--orange-400) 100%);
  color: var(--white);
  padding: 0.25rem 0.625rem;
  font-size: 0.75rem;
  font-weight: 500;
  border-radius: 9999px;
  box-shadow: 0 2px 8px rgba(251, 191, 36, 0.3);
  z-index: 2;
}

/* No products message */
.no-products-message {
  text-align: center;
  padding: 2rem;
  color: var(--gray-500);
  font-style: italic;
}

/* Responsive */
@media (max-width: 1200px) {
  .card-container {
    width: calc((100% - 3rem) / 4); /* 4个产品 */
  }
}

@media (max-width: 768px) {
  .container {
    padding: 0 0.5rem;
  }
  
  .section-title1 {
    font-size: 2rem;
  }
  
  .tab-container {
    gap: 0.75rem;
  }
  
  .carousel-track {
    gap: 0.75rem;
  }
  
  .card-container {
    width: calc((100% - 1.5rem) / 2.5); /* 2.5个产品 */
    min-width: 150px;
  }
  
  .image-container {
    height: 16rem;
  }

  .card-link:hover {
    transform: translateY(-4px);
  }

  .section-title-link:hover {
    transform: translateY(-1px);
  }
}

@media (max-width: 480px) {
  .section-header {
    margin-bottom: 2rem;
  }
  
  .section-title1 {
    font-size: 1.75rem;
  }
  
  .card-container {
    width: calc((100% - 0.75rem) / 2); /* 2个产品 */
    min-width: 140px;
  }
  
  .image-container {
    height: 14rem;
  }
  
  .carousel-track {
    gap: 0.5rem;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sectionId = '{{ section.id }}';
  const section = document.querySelector(`[data-section-id="${sectionId}"]`);
  
  if (!section) return;
  
  const tabButtons = section.querySelectorAll('.tab-button');
  const carouselContents = section.querySelectorAll('.carousel-content');
  
  let currentTabIndex = 0;

  // 初始化第一个标签页
  if (tabButtons.length > 0) {
    activateTab(0);
  }

  // 标签页切换
  tabButtons.forEach((button, index) => {
    button.addEventListener('click', () => {
      activateTab(index);
    });
  });

  function activateTab(index) {
    // 移除所有活动状态
    tabButtons.forEach(btn => btn.classList.remove('active'));
    carouselContents.forEach(content => content.classList.remove('active'));
    
    // 添加活动状态
    if (tabButtons[index]) {
      tabButtons[index].classList.add('active');
    }
    if (carouselContents[index]) {
      carouselContents[index].classList.add('active');
    }
    
    currentTabIndex = index;
    
    // 重置滚动位置
    const activeContent = carouselContents[index];
    if (activeContent) {
      const track = activeContent.querySelector('.carousel-track');
      if (track) {
        track.scrollLeft = 0;
      }
    }
  }

  // 为每个轮播轨道添加触摸滑动支持
  carouselContents.forEach(content => {
    const track = content.querySelector('.carousel-track');
    if (track) {
      addTouchSupport(track);
    }
  });

  // 触摸滑动支持
  function addTouchSupport(trackEl) {
    let isDown = false;
    let startX;
    let scrollLeft;

    // 鼠标事件
    trackEl.addEventListener('mousedown', (e) => {
      isDown = true;
      trackEl.style.cursor = 'grabbing';
      startX = e.pageX - trackEl.offsetLeft;
      scrollLeft = trackEl.scrollLeft;
      e.preventDefault();
    });

    trackEl.addEventListener('mouseleave', () => {
      isDown = false;
      trackEl.style.cursor = 'grab';
    });

    trackEl.addEventListener('mouseup', () => {
      isDown = false;
      trackEl.style.cursor = 'grab';
    });

    trackEl.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - trackEl.offsetLeft;
      const walk = (x - startX) * 2;
      trackEl.scrollLeft = scrollLeft - walk;
    });

    // 触摸事件
    trackEl.addEventListener('touchstart', (e) => {
      isDown = true;
      startX = e.touches[0].pageX - trackEl.offsetLeft;
      scrollLeft = trackEl.scrollLeft;
    }, { passive: true });

    trackEl.addEventListener('touchmove', (e) => {
      if (!isDown) return;
      const x = e.touches[0].pageX - trackEl.offsetLeft;
      const walk = (x - startX) * 2;
      trackEl.scrollLeft = scrollLeft - walk;
    }, { passive: true });

    trackEl.addEventListener('touchend', () => {
      isDown = false;
    });

    // 设置初始光标样式
    trackEl.style.cursor = 'grab';
  }

  // 图片加载错误处理
  section.addEventListener('error', function(e) {
    if (e.target.tagName === 'IMG') {
      const placeholder = e.target.closest('.image-container').querySelector('.placeholder-image');
      if (!placeholder) {
        const newPlaceholder = document.createElement('div');
        newPlaceholder.className = 'placeholder-image';
        newPlaceholder.innerHTML = '<span>Image non disponible</span>';
        e.target.parentNode.appendChild(newPlaceholder);
      }
      e.target.style.display = 'none';
    }
  }, true);
});
</script>

{% schema %}
{
  "name": "Carousel de bijoux",
  "tag": "section",
  "class": "jewelry-carousel-section",
  "settings": [
    {
      "type": "header",
      "content": "Configuration générale"
    },
    {
      "type": "text",
      "id": "sectiontitle",
      "label": "Titre de la section",
      "default": "Nos Collections"
    },
    {
      "type": "url",
      "id": "titlelink",
      "label": "Lien du titre",
      "info": "Laisser vide si vous ne voulez pas que le titre soit cliquable"
    }
  ],
  "blocks": [
    {
      "type": "collectiontab",
      "name": "Onglet de collection",
      "settings": [
        {
          "type": "text",
          "id": "tabtitle",
          "label": "Titre de l'onglet",
          "default": "Colliers"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "productslimit",
          "label": "Nombre de produits à afficher",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 10
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carousel de bijoux",
      "settings": {
        "sectiontitle": "Nos Collections"
      },
      "blocks": [
        {
          "type": "collectiontab",
          "settings": {
            "tabtitle": "Colliers"
          }
        },
        {
          "type": "collectiontab",
          "settings": {
            "tabtitle": "Boucles d'oreilles"
          }
        },
        {
          "type": "collectiontab",
          "settings": {
            "tabtitle": "Bagues"
          }
        }
      ]
    }
  ]
}
{% endschema %}
