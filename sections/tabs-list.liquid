{% comment %}
  Carousel de bijoux - Section Liquid (Fixed 5 cards display)
  ✅ Fixed: PC端正确显示5张卡片
{% endcomment %}

<div class="jewelry-carousel-section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="container-{{ section.id }}">
    
    <!-- Section Title and Subtitle -->
    {% if section.settings.sectiontitle != blank  %}
      <div class="section-header-{{ section.id }}">
        {% if section.settings.sectiontitle != blank %}
          {% if section.settings.titlelink != blank %}
            <a href="{{ section.settings.titlelink }}" class="section-title-link-{{ section.id }}">
              <h2 class="section-title1-{{ section.id }}">{{ section.settings.sectiontitle }}</h2>
            </a>
          {% else %}
            <h2 class="section-title1-{{ section.id }}">{{ section.settings.sectiontitle }}</h2>
          {% endif %}
        {% endif %}
      </div>
    {% endif %}
    
    <!-- Navigation par onglets -->
    <div class="tab-navigation-{{ section.id }}">
      <div class="tab-container-{{ section.id }}">
        {% for block in section.blocks %}
          {% if block.type == 'collectiontab' %}
            <button
              class="tab-button-{{ section.id }}"
              data-tab="{{ block.id }}"
              data-collection="{{ block.settings.collection.handle }}"
            >
              {{ block.settings.tabtitle | upcase }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Conteneur du carousel -->
    <div class="carousel-wrapper-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.type == 'collectiontab' %}
          <div 
            class="carousel-content-{{ section.id }}"
            data-content="{{ block.id }}"
          >
            <div class="carousel-track-{{ section.id }}">
              
              <!-- Cartes produits -->
              {% assign collection = collections[block.settings.collection.handle] %}
              {% if collection and collection.products.size > 0 %}
                {% for product in collection.products limit: block.settings.productslimit %}
                  <a href="{{ product.url }}" class="card-container-{{ section.id }} card-link-{{ section.id }}">
                    <div class="card-inner-{{ section.id }}">
                      <!-- Image container -->
                      <div class="image-container-{{ section.id }} product-card-{{ section.id }}">
                        {% if product.featured_image %}
                          <img
                            src="{{ product.featured_image | image_url: width: 400, height: 500 }}"
                            alt="{{ product.title | escape }}"
                            class="card-image-{{ section.id }} main-image-{{ section.id }}"
                            loading="lazy"
                          >
                          {% if product.images[1] %}
                            <img
                              src="{{ product.images[1] | image_url: width: 400, height: 500 }}"
                              alt="{{ product.title | escape }}"
                              class="card-image-{{ section.id }} hover-image-{{ section.id }}"
                              loading="lazy"
                            >
                          {% endif %}
                        {% else %}
                          <div class="placeholder-image-{{ section.id }}">
                            <span>{{ product.title }}</span>
                          </div>
                        {% endif %}
                        
                        <!-- Badge Best Seller -->
                        {% if product.tags contains 'bestseller' %}
                          <div class="bestseller-badge-{{ section.id }}"> 
                            BEST SELLER
                          </div>
                        {% endif %}
                      </div>
                    </div>
                  </a>
                {% endfor %}
              {% else %}
                <div class="no-products-message-{{ section.id }}">
                  <p>Aucun produit trouvé dans cette collection.</p>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
/* Variables CSS */
:root {
  --cream-{{ section.id }}: #F5F1EB;
  --warm-beige-{{ section.id }}: #E8DDD4;
  --soft-brown-{{ section.id }}: #C4A484;
  --pearl-white-{{ section.id }}: #FFF8F0;
  --gray-50-{{ section.id }}: #F9FAFB;
  --gray-100-{{ section.id }}: #F3F4F6;
  --gray-200-{{ section.id }}: #E5E7EB;
  --gray-400-{{ section.id }}: #9CA3AF;
  --gray-500-{{ section.id }}: #6B7280;
  --gray-600-{{ section.id }}: #4B5563;
  --gray-700-{{ section.id }}: #374151;
  --gray-900-{{ section.id }}: #111827;
  --white-{{ section.id }}: #FFFFFF;
  --amber-400-{{ section.id }}: #FBBF24;
  --orange-400-{{ section.id }}: #FB923C;
}

/* Section principale */
.jewelry-carousel-section-{{ section.id }} {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: transparent;
  min-height: 50vh;
  padding: 1rem 0;
}

/* Container principal */
.container-{{ section.id }} {
  width: 100%;
  max-width: 100%;
  margin: 0 auto;
  padding: 0 50px;
}

/* Section Header */
.section-header-{{ section.id }} {
  text-align: center;
  margin-bottom: 2rem;
}

.section-title-link-{{ section.id }} {
  text-decoration: none;
  color: inherit;
  display: inline-block;
  transition: all 0.3s ease;
}

.section-title-link-{{ section.id }}:hover {
  transform: translateY(-2px);
  opacity: 0.8;
}

.section-title-link-{{ section.id }}:hover .section-title1-{{ section.id }} {
  color: var(--soft-brown-{{ section.id }});
}

.section-title1-{{ section.id }} {
  font-size: 2.5rem;
  font-family: Georgia, serif;
  font-weight: normal;
  color: var(--color, var(--font-h2-color));
  margin-bottom: 0.5rem;
  line-height: 1.2;
  transition: color 0.3s ease;
}

.section-title-link-{{ section.id }} .section-title1-{{ section.id }} {
  cursor: pointer;
}

/* Navigation des onglets */
.tab-navigation-{{ section.id }} {
  margin-bottom: 2rem;
}

.tab-container-{{ section.id }} {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.tab-button-{{ section.id }} {
  padding: 0.5rem 0;
  font-size: 0.875rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  color: #5c3d3b;
  background: none;
  border: none;
  cursor: pointer;
  transition: color 0.3s ease;
}

.tab-button-{{ section.id }}:hover,
.tab-button-{{ section.id }}.active {
  color: var(--gray-900-{{ section.id }});
}

.tab-button-{{ section.id }}.active {
  font-weight: 600;
}

/* Carousel wrapper */
.carousel-wrapper-{{ section.id }} {
  position: relative;
  overflow: hidden;
}

.carousel-content-{{ section.id }} {
  display: none;
  position: relative;
}

.carousel-content-{{ section.id }}.active {
  display: block;
}

.carousel-track-{{ section.id }} {
  display: flex;
  gap: 1rem;
  overflow-x: auto;
  overflow-y: hidden;
  scroll-behavior: smooth;
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding-bottom: 1rem;
  cursor: grab;
  user-select: none;
}

.carousel-track-{{ section.id }}::-webkit-scrollbar {
  display: none;
}

.carousel-track-{{ section.id }}:active {
  cursor: grabbing;
}

/* Cards containers - PC端固定显示5张 */
.card-container-{{ section.id }} {
  flex: 0 0 auto;
  width: calc((100% - 4rem) / 5); /* 5张卡片，4个间隙(每个1rem) */
  min-width: 220px;
  max-width: 320px;
}

.card-link-{{ section.id }} {
  text-decoration: none;
  color: inherit;
  display: block;
  transition: all 0.3s ease;
  pointer-events: auto;
}

.card-link-{{ section.id }}:hover {
  transform: translateY(-6px);
}

.card-link-{{ section.id }} .card-inner-{{ section.id }} {
  height: 100%;
}

/* Image containers */
.image-container-{{ section.id }} {
  position: relative;
  background-color: var(--white-{{ section.id }});
  overflow: hidden;
  transition: transform 0.3s ease;
  border-radius: 12px;
  height: 20rem;
}

.image-container-{{ section.id }}:hover {
  transform: scale(1.02);
}

.card-image-{{ section.id }} {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.5s ease;
  display: block;
  pointer-events: none;
}

.hover-image-{{ section.id }} {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
}

.product-card-{{ section.id }}:hover .hover-image-{{ section.id }} {
  opacity: 1;
}

.placeholder-image-{{ section.id }} {
  width: 100%;
  height: 100%;
  background-color: var(--gray-200-{{ section.id }});
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gray-400-{{ section.id }});
  font-size: 0.875rem;
  text-align: center;
  padding: 1rem;
}

/* Badges */
.bestseller-badge-{{ section.id }} {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  background: linear-gradient(135deg, var(--amber-400-{{ section.id }}) 0%, var(--orange-400-{{ section.id }}) 100%);
  color: var(--white-{{ section.id }});
  padding: 0.25rem 0.625rem;
  font-size: 0.75rem;
  font-weight: 500;
  border-radius: 9999px;
  box-shadow: 0 2px 8px rgba(251, 191, 36, 0.3);
  z-index: 2;
}

/* No products message */
.no-products-message-{{ section.id }} {
  text-align: center;
  padding: 2rem;
  color: var(--gray-500-{{ section.id }});
  font-style: italic;
}

/* Responsive */
@media (max-width: 1400px) {
  .card-container-{{ section.id }} {
    width: calc((100% - 4rem) / 5);
    min-width: 200px;
  }
}

@media (max-width: 1200px) {
  .container-{{ section.id }} {
    padding: 0 40px;
  }
  
  .card-container-{{ section.id }} {
    width: calc((100% - 3rem) / 4); /* 4张卡片 */
    min-width: 200px;
  }
}

@media (max-width: 992px) {
  .container-{{ section.id }} {
    padding: 0 30px;
  }
  
  .card-container-{{ section.id }} {
    width: calc((100% - 2rem) / 3); /* 3张卡片 */
    min-width: 200px;
  }
}

@media (max-width: 768px) {
  .container-{{ section.id }} {
    padding: 0 20px;
  }
  
  .section-title1-{{ section.id }} {
    font-size: 2rem;
  }
  
  .tab-container-{{ section.id }} {
    gap: 0.75rem;
  }
  
  /* 移动端：显示1.5张卡片 */
  .carousel-track-{{ section.id }} {
    gap: 1rem;
  }
  
  .card-container-{{ section.id }} {
    width: 66.666%;
    min-width: 280px;
    max-width: none;
  }
  
  .image-container-{{ section.id }} {
    height: 22rem;
  }
}

@media (max-width: 576px) {
  .container-{{ section.id }} {
    padding: 0 15px;
  }
  
  .section-title1-{{ section.id }} {
    font-size: 1.75rem;
  }
  
  .carousel-track-{{ section.id }} {
    gap: 0.75rem;
  }
  
  .card-container-{{ section.id }} {
    width: 66.666%;
    min-width: 260px;
  }
  
  .image-container-{{ section.id }} {
    height: 20rem;
  }
}

@media (max-width: 480px) {
  .container-{{ section.id }} {
    padding: 0 10px;
  }
  
  .card-container-{{ section.id }} {
    width: 66.666%;
    min-width: 240px;
  }
  
  .image-container-{{ section.id }} {
    height: 18rem;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sectionId = '{{ section.id }}';
  const section = document.querySelector(`[data-section-id="${sectionId}"]`);
  
  if (!section) return;
  
  const tabButtons = section.querySelectorAll('.tab-button-{{ section.id }}');
  const carouselContents = section.querySelectorAll('.carousel-content-{{ section.id }}');
  
  let currentTabIndex = 0;

  // 初始化第一个标签页
  if (tabButtons.length > 0) {
    activateTab(0);
  }

  // 标签页切换
  tabButtons.forEach((button, index) => {
    button.addEventListener('click', () => {
      activateTab(index);
    });
  });

  function activateTab(index) {
    tabButtons.forEach(btn => btn.classList.remove('active'));
    carouselContents.forEach(content => content.classList.remove('active'));
    
    if (tabButtons[index]) {
      tabButtons[index].classList.add('active');
    }
    if (carouselContents[index]) {
      carouselContents[index].classList.add('active');
    }
    
    currentTabIndex = index;
    
    const activeContent = carouselContents[index];
    if (activeContent) {
      const track = activeContent.querySelector('.carousel-track-{{ section.id }}');
      if (track) {
        track.scrollLeft = 0;
      }
    }
  }

  // 为每个轮播轨道添加拖动支持
  carouselContents.forEach(content => {
    const track = content.querySelector('.carousel-track-{{ section.id }}');
    if (track) {
      addDragSupport(track);
    }
  });

  // 鼠标拖动和触摸滑动支持
  function addDragSupport(trackEl) {
    let isDown = false;
    let startX;
    let scrollLeft;
    let isDragging = false;

    // 鼠标事件
    trackEl.addEventListener('mousedown', (e) => {
      isDown = true;
      isDragging = false;
      trackEl.style.cursor = 'grabbing';
      startX = e.pageX - trackEl.offsetLeft;
      scrollLeft = trackEl.scrollLeft;
      e.preventDefault();
    });

    trackEl.addEventListener('mouseleave', () => {
      isDown = false;
      trackEl.style.cursor = 'grab';
    });

    trackEl.addEventListener('mouseup', () => {
      isDown = false;
      trackEl.style.cursor = 'grab';
      
      // 如果发生了拖动，阻止链接点击
      if (isDragging) {
        setTimeout(() => {
          isDragging = false;
        }, 10);
      }
    });

    trackEl.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - trackEl.offsetLeft;
      const walk = (x - startX) * 2;
      
      if (Math.abs(walk) > 5) {
        isDragging = true;
      }
      
      trackEl.scrollLeft = scrollLeft - walk;
    });

    // 触摸事件
    trackEl.addEventListener('touchstart', (e) => {
      isDown = true;
      isDragging = false;
      startX = e.touches[0].pageX - trackEl.offsetLeft;
      scrollLeft = trackEl.scrollLeft;
    }, { passive: true });

    trackEl.addEventListener('touchmove', (e) => {
      if (!isDown) return;
      const x = e.touches[0].pageX - trackEl.offsetLeft;
      const walk = (x - startX) * 2;
      
      if (Math.abs(walk) > 5) {
        isDragging = true;
      }
      
      trackEl.scrollLeft = scrollLeft - walk;
    }, { passive: true });

    trackEl.addEventListener('touchend', () => {
      isDown = false;
      
      if (isDragging) {
        setTimeout(() => {
          isDragging = false;
        }, 10);
      }
    });

    // 阻止拖动时的链接点击
    trackEl.addEventListener('click', (e) => {
      if (isDragging) {
        e.preventDefault();
        e.stopPropagation();
      }
    }, true);
  }

  // 图片加载错误处理
  section.addEventListener('error', function(e) {
    if (e.target.tagName === 'IMG') {
      const placeholder = e.target.closest('.image-container-{{ section.id }}')?.querySelector('.placeholder-image-{{ section.id }}');
      if (!placeholder) {
        const newPlaceholder = document.createElement('div');
        newPlaceholder.className = 'placeholder-image-{{ section.id }}';
        newPlaceholder.innerHTML = '<span>Image non disponible</span>';
        e.target.parentNode.appendChild(newPlaceholder);
      }
      e.target.style.display = 'none';
    }
  }, true);
});
</script>

{% schema %}
{
  "name": "Carousel de bijoux",
  "tag": "section",
  "class": "jewelry-carousel-section",
  "settings": [
    {
      "type": "header",
      "content": "Configuration générale"
    },
    {
      "type": "text",
      "id": "sectiontitle",
      "label": "Titre de la section",
      "default": "Nos Collections"
    },
    {
      "type": "url",
      "id": "titlelink",
      "label": "Lien du titre",
      "info": "Laisser vide si vous ne voulez pas que le titre soit cliquable"
    }
  ],
  "blocks": [
    {
      "type": "collectiontab",
      "name": "Onglet de collection",
      "settings": [
        {
          "type": "text",
          "id": "tabtitle",
          "label": "Titre de l'onglet",
          "default": "Colliers"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "productslimit",
          "label": "Nombre de produits à afficher",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 10
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carousel de bijoux",
      "settings": {
        "sectiontitle": "Nos Collections"
      },
      "blocks": [
        {
          "type": "collectiontab",
          "settings": {
            "tabtitle": "Colliers"
          }
        },
        {
          "type": "collectiontab",
          "settings": {
            "tabtitle": "Boucles d'oreilles"
          }
        },
        {
          "type": "collectiontab",
          "settings": {
            "tabtitle": "Bagues"
          }
        }
      ]
    }
  ]
}
{% endschema %}
