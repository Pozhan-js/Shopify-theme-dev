{% comment %}
  Carousel de bijoux - Section Liquid (Fixed Image Loading)
  ✅ Fixed: Image loading with correct Liquid syntax
  ✅ Removed: Product title and price
  ✅ Added: Unique class names with section prefix
  ✅ Added: Pagination controls for page-based navigation
  ✅ Modified: Display 5 products per view with page switching
{% endcomment %}

<div class="jewelry-carousel-section-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="container-{{ section.id }}">
    
    <!-- Section Title and Subtitle -->
    {% if section.settings.sectiontitle != blank  %}
      <div class="section-header-{{ section.id }}">
        {% if section.settings.sectiontitle != blank %}
          {% if section.settings.titlelink != blank %}
            <a href="{{ section.settings.titlelink }}" class="section-title-link-{{ section.id }}">
              <h2 class="section-title1-{{ section.id }}">{{ section.settings.sectiontitle }}</h2>
            </a>
          {% else %}
            <h2 class="section-title1-{{ section.id }}">{{ section.settings.sectiontitle }}</h2>
          {% endif %}
        {% endif %}
      </div>
    {% endif %}
    
    <!-- Navigation par onglets -->
    <div class="tab-navigation-{{ section.id }}">
      <div class="tab-container-{{ section.id }}">
        {% for block in section.blocks %}
          {% if block.type == 'collectiontab' %}
            <button
              class="tab-button-{{ section.id }}"
              data-tab="{{ block.id }}"
              data-collection="{{ block.settings.collection.handle }}"
            >
              {{ block.settings.tabtitle | upcase }}
            </button>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Conteneur du carousel -->
    <div class="carousel-wrapper-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.type == 'collectiontab' %}
          <div 
            class="carousel-content-{{ section.id }}"
            data-content="{{ block.id }}"
          >
            <div class="carousel-container-{{ section.id }}">
              
              <!-- Cartes produits : chaque carte est un lien vers la page produit -->
              {% assign collection = collections[block.settings.collection.handle] %}
              {% if collection and collection.products.size > 0 %}
                <div class="carousel-track-{{ section.id }}" data-page="0">
                  {% assign total_products = collection.products | size %}
                  {% assign max_page = total_products | divided_by: 5 | ceil %}
                  
                  {% for product in collection.products limit: block.settings.productslimit %}
                    <a href="{{ product.url }}" class="card-container-{{ section.id }} card-link-{{ section.id }}" 
                       data-product-index="{{ forloop.index0 }}">
                      <div class="card-inner-{{ section.id }}">
                        <!-- Image container -->
                        <div class="image-container-{{ section.id }} product-card-{{ section.id }}">
                          {% if product.featured_image %}
                            <img
                              src="{{ product.featured_image | image_url: width: 400, height: 500 }}"
                              alt="{{ product.title | escape }}"
                              class="card-image-{{ section.id }} main-image-{{ section.id }}"
                              loading="lazy"
                            >
                            {% if product.images[1] %}
                              <img
                                src="{{ product.images[1] | image_url: width: 400, height: 500 }}"
                                alt="{{ product.title | escape }}"
                                class="card-image-{{ section.id }} hover-image-{{ section.id }}"
                                loading="lazy"
                              >
                            {% endif %}
                          {% else %}
                            <div class="placeholder-image-{{ section.id }}">
                              <span>{{ product.title }}</span>
                            </div>
                          {% endif %}
                          
                          <!-- Badge Best Seller conditionnel -->
                          {% if product.tags contains 'bestseller' %}
                            <div class="bestseller-badge-{{ section.id }}"> 
                              BEST SELLER
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    </a>
                  {% endfor %}
                </div>
                
                <!-- Pagination Controls -->
                {% if total_products > 5 %}
                  <div class="pagination-controls-{{ section.id }}">
                    <button class="prev-btn-{{ section.id }}" data-action="prev" disabled>
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    
                    <div class="page-indicator-{{ section.id }}">
                      <span class="current-page-{{ section.id }}">1</span>
                      <span class="separator-{{ section.id }}">/</span>
                      <span class="total-pages-{{ section.id }}">{{ max_page }}</span>
                    </div>
                    
                    <button class="next-btn-{{ section.id }}" data-action="next">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                {% endif %}
              {% else %}
                <div class="no-products-message-{{ section.id }}">
                  <p>Aucun produit trouvé dans cette collection.</p>
                </div>
              {% endif %}
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
/* Variables CSS */
:root {
  --cream: #F5F1EB;
  --warm-beige: #E8DDD4;
  --soft-brown: #C4A484;
  --pearl-white: #FFF8F0;
  --gray-50: #F9FAFB;
  --gray-100: #F3F4F6;
  --gray-200: #E5E7EB;
  --gray-400: #9CA3AF;
  --gray-500: #6B7280;
  --gray-600: #4B5563;
  --gray-700: #374151;
  --gray-900: #111827;
  --white: #FFFFFF;
  --amber-400: #FBBF24;
  --orange-400: #FB923C;
}

/* Section principale */
.jewelry-carousel-section-{{ section.id }} {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: transparent;
  min-height: 50vh;
  padding: 1rem 0;
}

/* Container principal - 全宽设计 */
.container-{{ section.id }} {
  width: 100%;
  margin: 0 auto;
  padding: 0 50px; /* 左右各留50px内边距 */
}

/* Section Header */
.section-header-{{ section.id }} {
  text-align: center;
  margin-bottom: 2rem;
}

/* 标题链接样式 */
.section-title-link-{{ section.id }} {
  text-decoration: none;
  color: inherit;
  display: inline-block;
  transition: all 0.3s ease;
}

.section-title-link-{{ section.id }}:hover {
  transform: translateY(-2px);
  opacity: 0.8;
}

.section-title-link-{{ section.id }}:hover .section-title1-{{ section.id }} {
  color: var(--soft-brown);
}

.section-title1-{{ section.id }} {
  font-size: 2.5rem;
  font-family: Georgia, serif;
  font-weight: normal;
  color: var(--color, var(--font-h2-color));
  margin-bottom: 0.5rem;
  line-height: 1.2;
  transition: color 0.3s ease;
}

/* 当标题是链接时，添加光标指针 */
.section-title-link-{{ section.id }} .section-title1-{{ section.id }} {
  cursor: pointer;
}

/* Navigation des onglets */
.tab-navigation-{{ section.id }} {
  margin-bottom: 2rem;
}

.tab-container-{{ section.id }} {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.tab-button-{{ section.id }} {
  padding: 0.5rem 0;
  font-size: 0.875rem;
  font-weight: 500;
  letter-spacing: 0.05em;
  color: #5c3d3b;
  background: none;
  border: none;
  cursor: pointer;
  transition: color 0.3s ease;
}

.tab-button-{{ section.id }}:hover,
.tab-button-{{ section.id }}.active {
  color: var(--gray-900);
}

.tab-button-{{ section.id }}.active {
  font-weight: 600;
}

/* Carousel wrapper */
.carousel-wrapper-{{ section.id }} {
  position: relative;
  overflow: hidden;
}

.carousel-content-{{ section.id }} {
  display: none;
}

.carousel-content-{{ section.id }}.active {
  display: block;
}

.carousel-container-{{ section.id }} {
  position: relative;
  max-width: 100%;
}

.carousel-track-{{ section.id }} {
  display: flex;
  gap: 1rem;
  padding-bottom: 1rem;
  transition: transform 0.3s ease;
}

/* Cards containers - 调整为显示5个产品，基于全宽容器 */
.card-container-{{ section.id }} {
  flex-shrink: 0;
  width: calc((100% - 4rem) / 5); /* 5个产品，4个间隙 */
  min-width: 200px; /* 最小宽度保证在小屏幕上的显示 */
}

.card-link-{{ section.id }} {
  text-decoration: none;
  color: inherit;
  display: block;
  transition: all 0.3s ease;
}

.card-link-{{ section.id }}:hover {
  transform: translateY(-6px);
}

.card-link-{{ section.id }} .card-inner-{{ section.id }} {
  height: 100%;
}

/* Image containers */
.image-container-{{ section.id }} {
  position: relative;
  background-color: var(--white);
  overflow: hidden;
  transition: transform 0.3s ease;
  border-radius: 12px;
  height: 20rem; /* 固定高度 */
}

.image-container-{{ section.id }}:hover {
  transform: scale(1.02);
}

.card-image-{{ section.id }} {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.5s ease;
  display: block;
}

.hover-image-{{ section.id }} {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
}

.product-card-{{ section.id }}:hover .hover-image-{{ section.id }} {
  opacity: 1;
}

.placeholder-image-{{ section.id }} {
  width: 100%;
  height: 100%;
  background-color: var(--gray-200);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gray-400);
  font-size: 0.875rem;
  text-align: center;
  padding: 1rem;
}

/* Badges */
.bestseller-badge-{{ section.id }} {
  position: absolute;
  top: 0.75rem;
  left: 0.75rem;
  background: linear-gradient(135deg, var(--amber-400) 0%, var(--orange-400) 100%);
  color: var(--white);
  padding: 0.25rem 0.625rem;
  font-size: 0.75rem;
  font-weight: 500;
  border-radius: 9999px;
  box-shadow: 0 2px 8px rgba(251, 191, 36, 0.3);
  z-index: 2;
}

/* Pagination Controls */
.pagination-controls-{{ section.id }} {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 1.5rem;
  margin-top: 2rem;
}

.prev-btn-{{ section.id }},
.next-btn-{{ section.id }} {
  background: var(--white);
  border: 2px solid var(--gray-200);
  border-radius: 50%;
  width: 48px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  color: var(--gray-600);
}

.prev-btn-{{ section.id }}:hover:not(:disabled),
.next-btn-{{ section.id }}:hover:not(:disabled) {
  background: var(--soft-brown);
  border-color: var(--soft-brown);
  color: var(--white);
  transform: scale(1.05);
}

.prev-btn-{{ section.id }}:disabled,
.next-btn-{{ section.id }}:disabled {
  opacity: 0.4;
  cursor: not-allowed;
  background: var(--gray-100);
}

.prev-btn-{{ section.id }}:disabled:hover,
.next-btn-{{ section.id }}:disabled:hover {
  background: var(--gray-100);
  border-color: var(--gray-200);
  color: var(--gray-600);
  transform: none;
}

.page-indicator-{{ section.id }} {
  font-size: 1rem;
  font-weight: 500;
  color: var(--gray-700);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.current-page-{{ section.id }},
.total-pages-{{ section.id }} {
  font-weight: 600;
  color: var(--gray-900);
}

.separator-{{ section.id }} {
  color: var(--gray-400);
}

/* No products message */
.no-products-message-{{ section.id }} {
  text-align: center;
  padding: 2rem;
  color: var(--gray-500);
  font-style: italic;
}

/* Responsive - 调整响应式设计以保持5个产品显示 */
@media (max-width: 1400px) {
  .card-container-{{ section.id }} {
    min-width: 180px;
  }
}

@media (max-width: 1200px) {
  .container-{{ section.id }} {
    padding: 0 40px; /* 稍微减少内边距 */
  }
  
  .card-container-{{ section.id }} {
    min-width: 160px;
  }
}

@media (max-width: 992px) {
  .container-{{ section.id }} {
    padding: 0 30px; /* 进一步减少内边距 */
  }
  
  .card-container-{{ section.id }} {
    min-width: 150px;
  }
}

@media (max-width: 768px) {
  .container-{{ section.id }} {
    padding: 0 20px; /* 移动端减少内边距 */
  }
  
  .section-title1-{{ section.id }} {
    font-size: 2rem;
  }
  
  .tab-container-{{ section.id }} {
    gap: 0.75rem;
  }
  
  .carousel-track-{{ section.id }} {
    gap: 0.75rem;
  }
  
  /* 在中等屏幕上仍显示5个产品但缩小尺寸 */
  .card-container-{{ section.id }} {
    width: calc((100% - 4rem) / 5);
    min-width: 120px;
  }
  
  .image-container-{{ section.id }} {
    height: 16rem;
  }

  .card-link-{{ section.id }}:hover {
    transform: translateY(-4px);
  }

  .section-title-link-{{ section.id }}:hover {
    transform: translateY(-1px);
  }
  
  .prev-btn-{{ section.id }},
  .next-btn-{{ section.id }} {
    width: 40px;
    height: 40px;
  }
}

@media (max-width: 576px) {
  .container-{{ section.id }} {
    padding: 0 15px; /* 小屏幕进一步减少内边距 */
  }
  
  .section-header-{{ section.id }} {
    margin-bottom: 2rem;
  }
  
  .section-title1-{{ section.id }} {
    font-size: 1.75rem;
  }
  
  /* 在小屏幕上调整为显示3个产品 */
  .card-container-{{ section.id }} {
    width: calc((100% - 2rem) / 3);
    min-width: 100px;
  }
  
  .image-container-{{ section.id }} {
    height: 12rem;
  }
  
  .carousel-track-{{ section.id }} {
    gap: 0.5rem;
  }
  
  .pagination-controls-{{ section.id }} {
    gap: 1rem;
  }
  
  .prev-btn-{{ section.id }},
  .next-btn-{{ section.id }} {
    width: 36px;
    height: 36px;
  }
}

@media (max-width: 480px) {
  .container-{{ section.id }} {
    padding: 0 10px; /* 最小屏幕内边距 */
  }
  
  /* 在超小屏幕上显示2个产品 */
  .card-container-{{ section.id }} {
    width: calc((100% - 0.5rem) / 2);
    min-width: 90px;
  }
  
  .image-container-{{ section.id }} {
    height: 10rem;
  }
  
  .page-indicator-{{ section.id }} {
    font-size: 0.875rem;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const sectionId = '{{ section.id }}';
  const section = document.querySelector(`[data-section-id="${sectionId}"]`);
  
  if (!section) return;
  
  const tabButtons = section.querySelectorAll('.tab-button-{{ section.id }}');
  const carouselContents = section.querySelectorAll('.carousel-content-{{ section.id }}');
  
  let currentTabIndex = 0;
  let currentPage = 0;
  let totalPages = 0;
  let productsPerPage = 5;

  // 初始化第一个标签页
  if (tabButtons.length > 0) {
    activateTab(0);
  }

  // 标签页切换
  tabButtons.forEach((button, index) => {
    button.addEventListener('click', () => {
      activateTab(index);
    });
  });

  function activateTab(index) {
    // 移除所有活动状态
    tabButtons.forEach(btn => btn.classList.remove('active'));
    carouselContents.forEach(content => content.classList.remove('active'));
    
    // 添加活动状态
    if (tabButtons[index]) {
      tabButtons[index].classList.add('active');
    }
    if (carouselContents[index]) {
      carouselContents[index].classList.add('active');
    }
    
    currentTabIndex = index;
    currentPage = 0; // 重置到第一页
    
    // 重新初始化当前标签页的分页控制
    initializePagination();
  }

  function initializePagination() {
    const activeContent = carouselContents[currentTabIndex];
    if (!activeContent) return;
    
    const track = activeContent.querySelector('.carousel-track-{{ section.id }}');
    const prevBtn = activeContent.querySelector('.prev-btn-{{ section.id }}');
    const nextBtn = activeContent.querySelector('.next-btn-{{ section.id }}');
    const currentPageSpan = activeContent.querySelector('.current-page-{{ section.id }}');
    const totalPagesSpan = activeContent.querySelector('.total-pages-{{ section.id }}');
    
    if (!track || !prevBtn || !nextBtn || !currentPageSpan || !totalPagesSpan) return;
    
    // 计算总页数
    const totalProducts = track.querySelectorAll('.card-container-{{ section.id }}').length;
    totalPages = Math.ceil(totalProducts / productsPerPage);
    currentPage = 0;
    
    // 更新分页显示
    totalPagesSpan.textContent = totalPages;
    updatePageDisplay();
    
    // 绑定按钮事件
    prevBtn.onclick = () => goToPrevPage();
    nextBtn.onclick = () => goToNextPage();
  }

  function updatePageDisplay() {
    const activeContent = carouselContents[currentTabIndex];
    if (!activeContent) return;
    
    const track = activeContent.querySelector('.carousel-track-{{ section.id }}');
    const prevBtn = activeContent.querySelector('.prev-btn-{{ section.id }}');
    const nextBtn = activeContent.querySelector('.next-btn-{{ section.id }}');
    const currentPageSpan = activeContent.querySelector('.current-page-{{ section.id }}');
    
    if (!track || !prevBtn || !nextBtn || !currentPageSpan) return;
    
    // 更新当前页显示
    currentPageSpan.textContent = currentPage + 1;
    
    // 更新按钮状态
    prevBtn.disabled = currentPage === 0;
    nextBtn.disabled = currentPage === totalPages - 1;
    
    // 平滑移动到对应页面
    const translateX = -(currentPage * 100);
    track.style.transform = `translateX(${translateX}%)`;
  }

  function goToPrevPage() {
    if (currentPage > 0) {
      currentPage--;
      updatePageDisplay();
    }
  }

  function goToNextPage() {
    if (currentPage < totalPages - 1) {
      currentPage++;
      updatePageDisplay();
    }
  }

  // 键盘导航支持
  document.addEventListener('keydown', function(e) {
    const activeContent = carouselContents[currentTabIndex];
    if (!activeContent || !activeContent.classList.contains('active')) return;
    
    if (e.key === 'ArrowLeft') {
      goToPrevPage();
    } else if (e.key === 'ArrowRight') {
      goToNextPage();
    }
  });

  // 图片加载错误处理
  section.addEventListener('error', function(e) {
    if (e.target.tagName === 'IMG') {
      const placeholder = e.target.closest('.image-container-{{ section.id }}').querySelector('.placeholder-image-{{ section.id }}');
      if (!placeholder) {
        const newPlaceholder = document.createElement('div');
        newPlaceholder.className = 'placeholder-image-{{ section.id }}';
        newPlaceholder.innerHTML = '<span>Image non disponible</span>';
        e.target.parentNode.appendChild(newPlaceholder);
      }
      e.target.style.display = 'none';
    }
  }, true);

  // 初始化所有分页控制
  carouselContents.forEach(content => {
    const track = content.querySelector('.carousel-track-{{ section.id }}');
    if (track && track.querySelectorAll('.card-container-{{ section.id }}').length > 5) {
      // 只在有足够产品的情况下显示分页控制
      const controls = content.querySelector('.pagination-controls-{{ section.id }}');
      if (controls) {
        controls.style.display = 'flex';
      }
    }
  });
});
</script>

{% schema %}
{
  "name": "Carousel de bijoux",
  "tag": "section",
  "class": "jewelry-carousel-section",
  "settings": [
    {
      "type": "header",
      "content": "Configuration générale"
    },
    {
      "type": "text",
      "id": "sectiontitle",
      "label": "Titre de la section",
      "default": "Nos Collections"
    },
    {
      "type": "url",
      "id": "titlelink",
      "label": "Lien du titre",
      "info": "Laisser vide si vous ne voulez pas que le titre soit cliquable"
    }
  ],
  "blocks": [
    {
      "type": "collectiontab",
      "name": "Onglet de collection",
      "settings": [
        {
          "type": "text",
          "id": "tabtitle",
          "label": "Titre de l'onglet",
          "default": "Colliers"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "productslimit",
          "label": "Nombre de produits à afficher",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 10
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carousel de bijoux",
      "settings": {
        "sectiontitle": "Nos Collections"
      },
      "blocks": [
        {
          "type": "collectiontab",
          "settings": {
            "tabtitle": "Colliers"
          }
        },
        {
          "type": "collectiontab",
          "settings": {
            "tabtitle": "Boucles d'oreilles"
          }
        },
        {
          "type": "collectiontab",
          "settings": {
            "tabtitle": "Bagues"
          }
        }
      ]
    }
  ]
}
{% endschema %}
