{% comment %}
  Instagram图片展示 - 带鼠标拖拽滑动功能
  1. 主标题展示
  2. 直接展示配置的图片
  3. 支持鼠标拖拽滑动和触控板滑动
  4. 支持自定义锚点ID
  5. PC端左边留白加大，右边50px
  6. 完整显示5张图片，自适应大小
{% endcomment %}

<div class="gallery-showcase-section" 
     id="{{ section.settings.anchor_id | default: section.id | handleize }}" 
     data-section-id="{{ section.id }}">
  <div class="gallery-container">
    <!-- 主标题区域 -->
    {% if section.settings.main_title != blank %}
      <div class="gallery-title-wrapper">
        <h2 class="gallery-main-title">{{ section.settings.main_title }}</h2>
      </div>
    {% endif %}

    <!-- 图片轮播部分 -->
    <div class="gallery-carousel-wrapper">
      <div class="gallery-carousel-content active">
        <div class="gallery-carousel-track" data-section-id="{{ section.id }}">
          {% for block in section.blocks %}
            {% if block.type == 'image_item' %}
              <div class="gallery-card-container gallery-small-card">
                <div class="gallery-card-inner">
                  <div class="gallery-image-container">
                    {% if block.settings.image %}
                      <img
                        src="{{ block.settings.image | img_url: '400x500' }}"
                        alt="{{ block.settings.image.alt | escape }}"
                        class="gallery-card-image"
                        loading="lazy"
                        draggable="false"
                      >
                    {% else %}
                      <div class="gallery-placeholder-image">
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Variables CSS */
  :root {
    --gallery-cream: #f5f1eb;
    --gallery-warm-beige: #e8ddd4;
    --gallery-soft-brown: #c4a484;
    --gallery-pearl-white: #fff8f0;
    --gallery-gray-50: #f9fafb;
    --gallery-gray-100: #f3f4f6;
    --gallery-gray-200: #e5e7eb;
    --gallery-gray-400: #9ca3af;
    --gallery-gray-500: #6b7280;
    --gallery-gray-600: #4b5563;
    --gallery-gray-700: #374151;
    --gallery-gray-900: #111827;
    --gallery-white: #ffffff;
  }

  /* Section principale */
  .gallery-showcase-section {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: transparent;
    min-height: 50vh;
    padding: 1rem 0;
  }

  /* Container principal */
  .gallery-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    margin-bottom: 2rem;
  }

  /* 主标题区域 */
  .gallery-title-wrapper {
    text-align: center;
    margin-bottom: 2rem;
  }

  .gallery-main-title {
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-foreground);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  /* Carousel wrapper */
  .gallery-carousel-wrapper {
    position: relative;
    overflow: hidden;
  }

  .gallery-carousel-content {
    display: none;
  }

  .gallery-carousel-content.active {
    display: block;
  }

  .gallery-carousel-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    cursor: grab;
    user-select: none;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .gallery-carousel-track::-webkit-scrollbar {
    display: none;
  }

  .gallery-carousel-track:active {
    cursor: grabbing;
  }

  /* Cards containers */
  .gallery-card-container {
    flex-shrink: 0;
  }

  .gallery-small-card {
    width: 15rem;
  }

  .gallery-card-inner {
    display: flex;
    flex-direction: column;
  }

  /* Image containers */
  .gallery-image-container {
    position: relative;
    background-color: var(--gallery-white);
    overflow: hidden;
  }

  .gallery-small-card .gallery-image-container {
    height: 17rem;
    border-radius: 8px;
  }

  .gallery-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .gallery-placeholder-image {
    width: 100%;
    height: 100%;
    background-color: var(--gallery-gray-200);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gallery-gray-400);
    font-size: 0.875rem;
  }

  /* PC端优化 - 左边10rem，右边50px，图片自适应显示5张 */
  @media (min-width: 1201px) {
    .gallery-container {
      margin-left: 10rem;
      margin-right: 50px;
      margin-bottom: 2rem;
      padding: 0;
      max-width: none;
    }

    .gallery-carousel-track {
      gap: 1rem;
    }

    /* 使用 calc 计算图片宽度，增加一些余量确保第5张完全显示 */
    .gallery-small-card {
      width: calc((100vw - 10rem - 50px - 4rem - 10px) / 5);
      min-width: 12rem;
      max-width: 16rem;
    }

    .gallery-small-card .gallery-image-container {
      height: calc((100vw - 10rem - 50px - 4rem - 10px) / 5 * 1.15);
      min-height: 13.8rem;
      max-height: 18.4rem;
    }
  }

  /* 移动端保持原样 */
  @media (max-width: 1200px) {
    .gallery-container {
      padding: 0 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .gallery-container {
      padding: 0 1rem;
    }

    .gallery-title-wrapper {
      margin-bottom: 1.5rem;
    }

    .gallery-main-title {
      font-size: 1.5rem;
    }

    .gallery-carousel-track {
      gap: 1rem;
    }

    .gallery-small-card {
      width: 14rem;
    }

    .gallery-small-card .gallery-image-container {
      height: 16rem;
    }
  }

  @media (max-width: 480px) {
    .gallery-container {
      padding: 0 0.5rem;
    }

    .gallery-title-wrapper {
      margin-bottom: 1rem;
    }

    .gallery-main-title {
      font-size: 1.25rem;
    }

    .gallery-small-card {
      width: 12rem;
    }

    .gallery-small-card .gallery-image-container {
      height: 14rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const tracks = document.querySelectorAll('.gallery-carousel-track[data-section-id]');

    tracks.forEach((track) => {
      addDragSupport(track);
    });

    // 鼠标拖动和触摸滑动支持
    function addDragSupport(trackEl) {
      let isDown = false;
      let startX;
      let scrollLeft;
      let isDragging = false;

      // 鼠标按下
      trackEl.addEventListener('mousedown', (e) => {
        isDown = true;
        isDragging = false;
        trackEl.style.cursor = 'grabbing';
        startX = e.pageX - trackEl.offsetLeft;
        scrollLeft = trackEl.scrollLeft;
        e.preventDefault();
      });

      // 鼠标离开
      trackEl.addEventListener('mouseleave', () => {
        isDown = false;
        trackEl.style.cursor = 'grab';
      });

      // 鼠标松开
      trackEl.addEventListener('mouseup', () => {
        isDown = false;
        trackEl.style.cursor = 'grab';
        
        // 延迟重置 isDragging，防止触发点击事件
        if (isDragging) {
          setTimeout(() => {
            isDragging = false;
          }, 10);
        }
      });

      // 鼠标移动
      trackEl.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        const x = e.pageX - trackEl.offsetLeft;
        const walk = (x - startX) * 2;
        
        if (Math.abs(walk) > 5) {
          isDragging = true;
        }
        
        trackEl.scrollLeft = scrollLeft - walk;
      });

      // 触摸开始
      trackEl.addEventListener('touchstart', (e) => {
        isDown = true;
        isDragging = false;
        startX = e.touches[0].pageX - trackEl.offsetLeft;
        scrollLeft = trackEl.scrollLeft;
      }, { passive: true });

      // 触摸移动
      trackEl.addEventListener('touchmove', (e) => {
        if (!isDown) return;
        const x = e.touches[0].pageX - trackEl.offsetLeft;
        const walk = (x - startX) * 2;
        
        if (Math.abs(walk) > 5) {
          isDragging = true;
        }
        
        trackEl.scrollLeft = scrollLeft - walk;
      }, { passive: true });

      // 触摸结束
      trackEl.addEventListener('touchend', () => {
        isDown = false;
        
        if (isDragging) {
          setTimeout(() => {
            isDragging = false;
          }, 10);
        }
      });

      // 防止拖拽时触发点击事件
      trackEl.addEventListener('click', (e) => {
        if (isDragging) {
          e.preventDefault();
          e.stopPropagation();
        }
      }, true);

      // 防止图片被拖拽
      const images = trackEl.querySelectorAll('img');
      images.forEach(img => {
        img.addEventListener('dragstart', (e) => e.preventDefault());
      });
    }
  });
</script>

{% schema %}
{
  "name": "步骤图片展示",
  "tag": "section",
  "class": "gallery-showcase-section",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "主标题",
      "default": "精选图片展示"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "锚点ID",
      "info": "用于页面内跳转的唯一标识符，只能包含字母、数字、下划线和连字符。例如：gallery-section",
      "default": "gallery-section",
      "placeholder": "gallery-section"
    }
  ],
  "blocks": [
    {
      "type": "image_item",
      "name": "图片项",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "图片展示",
      "settings": {
        "main_title": "精选图片展示",
        "anchor_id": "gallery-section"
      },
      "blocks": [
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        }
      ]
    }
  ]
}
{% endschema %}
