{% comment %}
  Instagram图片展示 - 鼠标移动跟随滑动
  鼠标在图片区域左右移动时，图片跟随移动
{% endcomment %}

<div class="gallery-showcase-section" 
     id="{{ section.settings.anchor_id | default: section.id | handleize }}" 
     data-section-id="{{ section.id }}">
  <div class="gallery-container">
    <!-- 主标题区域 -->
    {% if section.settings.main_title != blank %}
      <div class="gallery-title-wrapper">
        <h2 class="gallery-main-title">{{ section.settings.main_title }}</h2>
      </div>
    {% endif %}

    <!-- 图片轮播部分 -->
    <div class="gallery-carousel-wrapper">
      <div class="gallery-carousel-content active">
        <div class="gallery-carousel-track" data-section-id="{{ section.id }}">
          {% for block in section.blocks %}
            {% if block.type == 'image_item' %}
              <div class="gallery-card-container gallery-small-card">
                <div class="gallery-card-inner">
                  <div class="gallery-image-container">
                    {% if block.settings.image %}
                      <img
                        src="{{ block.settings.image | img_url: '400x500' }}"
                        alt="{{ block.settings.image.alt | escape }}"
                        class="gallery-card-image"
                        loading="lazy"
                        draggable="false"
                      >
                    {% else %}
                      <div class="gallery-placeholder-image">
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Variables CSS */
  :root {
    --gallery-cream: #f5f1eb;
    --gallery-warm-beige: #e8ddd4;
    --gallery-soft-brown: #c4a484;
    --gallery-pearl-white: #fff8f0;
    --gallery-gray-50: #f9fafb;
    --gallery-gray-100: #f3f4f6;
    --gallery-gray-200: #e5e7eb;
    --gallery-gray-400: #9ca3af;
    --gallery-gray-500: #6b7280;
    --gallery-gray-600: #4b5563;
    --gallery-gray-700: #374151;
    --gallery-gray-900: #111827;
    --gallery-white: #ffffff;
  }

  .gallery-showcase-section {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: transparent;
    min-height: 50vh;
    padding: 1rem 0;
  }

  .gallery-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    margin-bottom: 2rem;
  }

  .gallery-title-wrapper {
    text-align: center;
    margin-bottom: 2rem;
  }

  .gallery-main-title {
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-foreground);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .gallery-carousel-wrapper {
    position: relative;
    overflow: hidden;
    cursor: default;
  }

  .gallery-carousel-content {
    display: none;
  }

  .gallery-carousel-content.active {
    display: block;
  }

  .gallery-carousel-track {
    display: flex;
    gap: 1rem;
    transition: transform 0.1s ease-out;
    user-select: none;
    will-change: transform;
  }

  .gallery-card-container {
    flex-shrink: 0;
  }

  .gallery-small-card {
    width: calc((100% - 4rem) / 5);
  }

  .gallery-card-inner {
    display: flex;
    flex-direction: column;
  }

  .gallery-image-container {
    position: relative;
    background-color: var(--gallery-white);
    overflow: hidden;
  }

  .gallery-small-card .gallery-image-container {
    height: 17rem;
    border-radius: 8px;
  }

  .gallery-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .gallery-placeholder-image {
    width: 100%;
    height: 100%;
    background-color: var(--gallery-gray-200);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gallery-gray-400);
    font-size: 0.875rem;
  }

  @media (min-width: 1201px) {
    .gallery-container {
      margin: 0 3rem 2rem 10rem;
      padding: 0;
    }

    .gallery-carousel-track {
      gap: 1.5rem;
    }

    .gallery-small-card {
      width: calc((100% - 6rem) / 5);
    }

    .gallery-small-card .gallery-image-container {
      height: 18rem;
    }
  }

  @media (max-width: 1200px) and (min-width: 769px) {
    .gallery-container {
      padding: 0 1.5rem;
    }

    .gallery-small-card {
      width: calc((100% - 3rem) / 4);
    }
  }

  @media (max-width: 768px) {
    .gallery-container {
      padding: 0 1rem;
    }

    .gallery-title-wrapper {
      margin-bottom: 1.5rem;
    }

    .gallery-main-title {
      font-size: 1.5rem;
    }

    .gallery-carousel-track {
      gap: 1rem;
    }

    .gallery-small-card {
      width: calc((100% - 2rem) / 3);
    }

    .gallery-small-card .gallery-image-container {
      height: 16rem;
    }
  }

  @media (max-width: 480px) {
    .gallery-container {
      padding: 0 0.5rem;
    }

    .gallery-title-wrapper {
      margin-bottom: 1rem;
    }

    .gallery-main-title {
      font-size: 1.25rem;
    }

    .gallery-small-card {
      width: calc((100% - 1rem) / 2);
    }

    .gallery-small-card .gallery-image-container {
      height: 14rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const tracks = document.querySelectorAll('.gallery-carousel-track[data-section-id]');

    tracks.forEach((track) => {
      const wrapper = track.closest('.gallery-carousel-wrapper');
      if (!wrapper) return;

      let lastMouseX = null;
      let currentTranslate = 0;

      // 鼠标移动事件 - 根据鼠标移动方向和距离滑动图片
      wrapper.addEventListener('mousemove', (e) => {
        const currentMouseX = e.clientX;
        
        // 如果是第一次移动，记录初始位置
        if (lastMouseX === null) {
          lastMouseX = currentMouseX;
          return;
        }

        // 计算鼠标移动的距离
        const deltaX = currentMouseX - lastMouseX;
        
        // 更新图片位置（鼠标向右移动，图片向右滑；鼠标向左移动，图片向左滑）
        currentTranslate += deltaX * 1.5; // 1.5 是灵敏度系数，可以调整
        
        // 计算最大可滚动距离
        const maxScroll = -(track.scrollWidth - wrapper.offsetWidth);
        
        // 限制滚动范围
        currentTranslate = Math.max(maxScroll, Math.min(0, currentTranslate));
        
        // 应用变换
        track.style.transform = `translateX(${currentTranslate}px)`;
        
        // 更新上一次的鼠标位置
        lastMouseX = currentMouseX;
      });

      // 鼠标离开时重置记录
      wrapper.addEventListener('mouseleave', () => {
        lastMouseX = null;
      });

      // 鼠标进入时重置记录
      wrapper.addEventListener('mouseenter', () => {
        lastMouseX = null;
      });

      // 触摸事件支持（移动端）
      let isDragging = false;
      let startX = 0;
      let scrollLeft = 0;

      wrapper.addEventListener('touchstart', (e) => {
        isDragging = true;
        startX = e.touches[0].clientX;
        scrollLeft = currentTranslate;
      });

      wrapper.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        
        const x = e.touches[0].clientX;
        const walk = (x - startX) * 1.5;
        currentTranslate = scrollLeft + walk;

        const maxScroll = -(track.scrollWidth - wrapper.offsetWidth);
        currentTranslate = Math.max(maxScroll, Math.min(0, currentTranslate));

        track.style.transform = `translateX(${currentTranslate}px)`;
      });

      wrapper.addEventListener('touchend', () => {
        isDragging = false;
      });

      // 防止图片拖拽
      const images = track.querySelectorAll('img');
      images.forEach(img => {
        img.addEventListener('dragstart', (e) => e.preventDefault());
      });
    });
  });
</script>

{% schema %}
{
  "name": "步骤图片展示",
  "tag": "section",
  "class": "gallery-showcase-section",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "主标题",
      "default": "精选图片展示"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "锚点ID",
      "info": "用于页面内跳转的唯一标识符",
      "default": "gallery-section",
      "placeholder": "gallery-section"
    }
  ],
  "blocks": [
    {
      "type": "image_item",
      "name": "图片项",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "图片展示",
      "settings": {
        "main_title": "精选图片展示",
        "anchor_id": "gallery-section"
      },
      "blocks": [
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        }
      ]
    }
  ]
}
{% endschema %}
