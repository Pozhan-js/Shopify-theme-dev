{% comment %}
  Instagram图片展示 - 带鼠标拖拽滑动功能
  1. 主标题展示
  2. 直接展示配置的图片
  3. 支持鼠标拖拽滑动
  4. 支持自定义锚点ID
{% endcomment %}

<div class="gallery-showcase-section" 
     id="{{ section.settings.anchor_id | default: section.id | handleize }}" 
     data-section-id="{{ section.id }}">
  <div class="gallery-container">
    <!-- 主标题区域 -->
    {% if section.settings.main_title != blank %}
      <div class="gallery-title-wrapper">
        <h2 class="gallery-main-title">{{ section.settings.main_title }}</h2>
      </div>
    {% endif %}

    <!-- 图片轮播部分 -->
    <div class="gallery-carousel-wrapper">
      <div class="gallery-carousel-content active">
        <div class="gallery-carousel-track" data-section-id="{{ section.id }}">
          {% for block in section.blocks %}
            {% if block.type == 'image_item' %}
              <div class="gallery-card-container gallery-small-card">
                <div class="gallery-card-inner">
                  <div class="gallery-image-container">
                    {% if block.settings.image %}
                      <img
                        src="{{ block.settings.image | img_url: '400x500' }}"
                        alt="{{ block.settings.image.alt | escape }}"
                        class="gallery-card-image"
                        loading="lazy"
                        draggable="false"
                      >
                    {% else %}
                      <div class="gallery-placeholder-image">
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Variables CSS */
  :root {
    --gallery-cream: #f5f1eb;
    --gallery-warm-beige: #e8ddd4;
    --gallery-soft-brown: #c4a484;
    --gallery-pearl-white: #fff8f0;
    --gallery-gray-50: #f9fafb;
    --gallery-gray-100: #f3f4f6;
    --gallery-gray-200: #e5e7eb;
    --gallery-gray-400: #9ca3af;
    --gallery-gray-500: #6b7280;
    --gallery-gray-600: #4b5563;
    --gallery-gray-700: #374151;
    --gallery-gray-900: #111827;
    --gallery-white: #ffffff;
  }

  /* Section principale */
  .gallery-showcase-section {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: transparent;
    min-height: 50vh;
    padding: 1rem 0;
  }

  /* Container principal - 扩大最大宽度到1400px */
  .gallery-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 2rem;
    margin-bottom: 2rem;
  }

  /* 主标题区域 */
  .gallery-title-wrapper {
    text-align: center;
    margin-bottom: 2rem;
  }

  .gallery-main-title {
    font-size: 2rem;
    font-weight: 600;
    color: var(--color-foreground);
    margin: 0;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  /* Carousel wrapper */
  .gallery-carousel-wrapper {
    position: relative;
    overflow: hidden;
    cursor: grab;
  }

  .gallery-carousel-wrapper:active {
    cursor: grabbing;
  }

  .gallery-carousel-content {
    display: none;
  }

  .gallery-carousel-content.active {
    display: block;
  }

  .gallery-carousel-track {
    display: flex;
    gap: 1rem;
    transition: transform 0.3s ease-out;
    user-select: none;
    will-change: transform;
  }

  .gallery-carousel-track.dragging {
    transition: none;
  }

  /* Cards containers - 缩小卡片尺寸 */
  .gallery-card-container {
    flex-shrink: 0;
  }

  .gallery-small-card {
    width: 15rem; /* 从18rem缩小到15rem */
  }

  .gallery-card-inner {
    display: flex;
    flex-direction: column;
  }

  /* Image containers - 缩小图片高度 */
  .gallery-image-container {
    position: relative;
    background-color: var(--gallery-white);
    overflow: hidden;
  }

  .gallery-small-card .gallery-image-container {
    height: 17rem; /* 从20rem缩小到17rem */
    border-radius: 8px;
  }

  .gallery-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .gallery-placeholder-image {
    width: 100%;
    height: 100%;
    background-color: var(--gallery-gray-200);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gallery-gray-400);
    font-size: 0.875rem;
  }

  /* PC端优化 */
  @media (min-width: 1201px) {
    .gallery-container {
      padding: 0 3rem; /* 增加左右padding */
    }

    .gallery-carousel-track {
      gap: 1.5rem;
    }

    .gallery-small-card {
      width: 16rem; /* PC端稍大一些 */
    }

    .gallery-small-card .gallery-image-container {
      height: 18rem;
    }
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .gallery-container {
      padding: 0 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .gallery-container {
      padding: 0 1rem;
    }

    .gallery-title-wrapper {
      margin-bottom: 1.5rem;
    }

    .gallery-main-title {
      font-size: 1.5rem;
    }

    .gallery-carousel-track {
      gap: 1rem;
    }

    .gallery-small-card {
      width: 14rem;
    }

    .gallery-small-card .gallery-image-container {
      height: 16rem;
    }
  }

  @media (max-width: 480px) {
    .gallery-container {
      padding: 0 0.5rem;
    }

    .gallery-title-wrapper {
      margin-bottom: 1rem;
    }

    .gallery-main-title {
      font-size: 1.25rem;
    }

    .gallery-small-card {
      width: 12rem;
    }

    .gallery-small-card .gallery-image-container {
      height: 14rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const tracks = document.querySelectorAll('.gallery-carousel-track[data-section-id]');

    tracks.forEach((track) => {
      const wrapper = track.closest('.gallery-carousel-wrapper');
      if (!wrapper) return;

      let isDragging = false;
      let startX = 0;
      let scrollLeft = 0;
      let currentTranslate = 0;
      let prevTranslate = 0;
      let animationID = 0;

      // 鼠标按下
      wrapper.addEventListener('mousedown', (e) => {
        isDragging = true;
        startX = e.pageX - wrapper.offsetLeft;
        scrollLeft = currentTranslate;
        track.classList.add('dragging');
        cancelAnimationFrame(animationID);
      });

      // 鼠标移动
      wrapper.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        e.preventDefault();
        
        const x = e.pageX - wrapper.offsetLeft;
        const walk = (x - startX) * 1.5; // 调整滑动灵敏度
        currentTranslate = scrollLeft + walk;

        // 限制滑动范围
        const maxScroll = -(track.scrollWidth - wrapper.offsetWidth);
        currentTranslate = Math.max(maxScroll, Math.min(0, currentTranslate));

        track.style.transform = `translateX(${currentTranslate}px)`;
      });

      // 鼠标松开
      const endDrag = () => {
        if (!isDragging) return;
        isDragging = false;
        track.classList.remove('dragging');
        prevTranslate = currentTranslate;
      };

      wrapper.addEventListener('mouseup', endDrag);
      wrapper.addEventListener('mouseleave', endDrag);

      // 触摸事件支持（移动端）
      wrapper.addEventListener('touchstart', (e) => {
        isDragging = true;
        startX = e.touches[0].clientX;
        scrollLeft = currentTranslate;
        track.classList.add('dragging');
      });

      wrapper.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        
        const x = e.touches[0].clientX;
        const walk = (x - startX) * 1.5;
        currentTranslate = scrollLeft + walk;

        const maxScroll = -(track.scrollWidth - wrapper.offsetWidth);
        currentTranslate = Math.max(maxScroll, Math.min(0, currentTranslate));

        track.style.transform = `translateX(${currentTranslate}px)`;
      });

      wrapper.addEventListener('touchend', () => {
        isDragging = false;
        track.classList.remove('dragging');
        prevTranslate = currentTranslate;
      });

      // 防止图片拖拽
      const images = track.querySelectorAll('img');
      images.forEach(img => {
        img.addEventListener('dragstart', (e) => e.preventDefault());
      });
    });
  });
</script>

{% schema %}
{
  "name": "步骤图片展示",
  "tag": "section",
  "class": "gallery-showcase-section",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "主标题",
      "default": "精选图片展示"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "锚点ID",
      "info": "用于页面内跳转的唯一标识符，只能包含字母、数字、下划线和连字符。例如：gallery-section",
      "default": "gallery-section",
      "placeholder": "gallery-section"
    }
  ],
  "blocks": [
    {
      "type": "image_item",
      "name": "图片项",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "图片展示",
      "settings": {
        "main_title": "精选图片展示",
        "anchor_id": "gallery-section"
      },
      "blocks": [
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        }
      ]
    }
  ]
}
{% endschema %}
