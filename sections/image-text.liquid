<!-- sections/image-text-display.liquid -->
<div class="image-text-section">
  <div class="container">
    <div class="image-grid image-grid--{{ section.settings.image_count }}">
      {% assign image_count_number = section.settings.image_count | plus: 0 %}
      {% for block in section.blocks %}
        {% if forloop.index <= image_count_number %}
          <div class="image-item" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="image-wrapper">
                <img
                  src="{{ block.settings.image | img_url: '600x600' }}"
                  alt="{{ block.settings.image.alt | default: block.settings.text }}"
                  loading="lazy"
                  class="image-item__img"
                >
              </div>
            {% else %}
              <div class="image-placeholder">
                <svg width="100" height="100" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect width="100" height="100" fill="#f3f4f6"/>
                  <path d="M30 70L50 50L70 70M40 40H40.01" stroke="#9ca3af" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>
            {% endif %}

            {% if block.settings.text != blank %}
              <div class="image-item__content">
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}" class="image-item__text-link">
                    {{ block.settings.text }}
                  </a>
                {% else %}
                  <p class="image-item__text">{{ block.settings.text }}</p>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .image-text-section {
    padding: 40px 0;
  }

  .container {
    width: 100%;
    padding: 0 20px;
  }

  .image-grid {
    display: grid;
    gap: 20px;
    width: 100%;
  }

  .image-grid--2 {
    grid-template-columns: 1fr 1fr; /* 2张图片平分空间 */
  }

  .image-grid--4 {
    grid-template-columns: 1fr 1fr 1fr 1fr; /* 4张图片平分空间 */
  }

  .image-item {
    text-align: center;
  }

  .image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    margin-bottom: 15px;
    height: 300px; /* 固定高度 */
  }

  .image-item__img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* 保持比例并填充容器 */
    display: block;
    transition: transform 0.3s ease;
  }

  .image-item__img:hover {
    transform: scale(1.05);
  }

  .image-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f3f4f6;
    border-radius: 8px;
    height: 300px; /* 固定高度 */
    margin-bottom: 15px;
  }

  .image-item__content {
    padding: 0 10px;
    position: relative;
  }

  .image-item__text,
  .image-item__text-link {
    font-size: 1rem;
    line-height: 1.5;
    margin: 0;
    color: #000000; /* 黑色文字 */
    display: inline-block; /* 让下划线只在文字宽度范围内 */
    transition: all 0.3s ease;
  }

  .image-item__text-link {
    text-decoration: none; /* 移除默认下划线 */
  }

  .image-item__text-link:hover {
    color: #000000; /* 鼠标悬停时保持黑色 */
    border-bottom-color: #000000; /* 鼠标悬停时下划线也保持黑色 */
  }

  /* 响应式设计 */
  @media (max-width: 768px) {
    .image-grid--4 {
      grid-template-columns: 1fr 1fr; /* 4张图片在平板上显示2列 */
    }

    .container {
      padding: 0 15px;
    }

    .image-wrapper,
    .image-placeholder {
      height: 250px; /* 移动端稍微小一点 */
    }
  }

  @media (max-width: 480px) {
    .image-grid--4 {
      grid-template-columns: 1fr; /* 4张图片在手机上显示1列 */
    }

    .image-grid--2 {
      grid-template-columns: 1fr; /* 2张图片在手机上也显示1列 */
    }

    .image-text-section {
      padding: 20px 0;
    }

    .image-wrapper,
    .image-placeholder {
      height: 200px; /* 小屏幕更小的高度 */
    }
  }
</style>

{% schema %}
{
  "name": "图片文字展示",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "image_count",
      "label": "图片数量",
      "options": [
        {
          "value": "2",
          "label": "2张图片"
        },
        {
          "value": "4",
          "label": "4张图片"
        }
      ],
      "default": "2"
    }
  ],
  "blocks": [
    {
      "type": "image_item",
      "name": "图片项目",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "选择图片"
        },
        {
          "type": "text",
          "id": "text",
          "label": "文字内容",
          "default": "在这里输入文字"
        },
        {
          "type": "url",
          "id": "link",
          "label": "链接地址（可选）",
          "info": "如果填写链接，文字将变成可点击的链接"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "图片文字展示",
      "blocks": [
        {
          "type": "image_item",
          "settings": {
            "text": "图片描述 1"
          }
        },
        {
          "type": "image_item",
          "settings": {
            "text": "图片描述 2"
          }
        },
        {
          "type": "image_item",
          "settings": {
            "text": "图片描述 3"
          }
        },
        {
          "type": "image_item",
          "settings": {
            "text": "图片描述 4"
          }
        }
      ]
    }
  ]
}
{% endschema %}
