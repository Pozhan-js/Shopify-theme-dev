<div class="company-overview-section" {{ section.shopify_attributes }}>
  <div class="company-overview-container">
    <div class="company-overview-grid">
      <!-- Our Story Card -->
      <div class="company-overview-card">
        <div class="card-image-container">
          {% if section.settings.story_image %}
            <img
              src="{{ section.settings.story_image | img_url: '460x320' }}"
              alt="{{ section.settings.story_title }}"
              class="card-background-image"
            >
          {% else %}
            <div class="card-image-placeholder story-bg"></div>
          {% endif %}
          <div class="card-overlay"></div>
        </div>
        
        <div class="card-content">
          <h3 class="card-title">{{ section.settings.story_title | default: "Our Story" }}</h3>
          <p class="card-description">
            {{ section.settings.story_description | default: "XS Pilates helps studios, instructors, and rehab pros achieve better outcomes - with premium quality and flexible customization at every step." }}
          </p>
          
          {% if section.settings.story_button_text %}
            <a href="{{ section.settings.story_button_url | default: '#' }}" class="card-arrow-button">
              <svg class="arrow-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Our Factory Card -->
      <div class="company-overview-card">
        <div class="card-image-container">
          {% if section.settings.factory_image %}
            <img
              src="{{ section.settings.factory_image | img_url: '460x320' }}"
              alt="{{ section.settings.factory_title }}"
              class="card-background-image"
            >
          {% else %}
            <div class="card-image-placeholder factory-bg"></div>
          {% endif %}
          <div class="card-overlay"></div>
        </div>
        
        <div class="card-content">
          <h3 class="card-title">{{ section.settings.factory_title | default: "Our Factory" }}</h3>
          <p class="card-description">
            {{ section.settings.factory_description | default: "Step into XS Pilates' vertically integrated facility where studio-grade equipment is built through 30+ handcrafted steps, eco-minded finishes, and rigorous QC." }}
          </p>
          
          {% if section.settings.factory_button_text %}
            <a href="{{ section.settings.factory_button_url | default: '#' }}" class="card-arrow-button">
              <svg class="arrow-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>

      <!-- Quality Control Card -->
      <div class="company-overview-card">
        <div class="card-image-container">
          {% if section.settings.quality_image %}
            <img
              src="{{ section.settings.quality_image | img_url: '460x320' }}"
              alt="{{ section.settings.quality_title }}"
              class="card-background-image"
            >
          {% else %}
            <div class="card-image-placeholder quality-bg"></div>
          {% endif %}
          <div class="card-overlay"></div>
        </div>
        
        <div class="card-content">
          <h3 class="card-title">{{ section.settings.quality_title | default: "Quality Control" }}</h3>
          <p class="card-description">
            {{ section.settings.quality_description | default: "At XS Pilates, quality isn't a goal, it's our foundation. We build trust through meticulous craftsmanship and rigorous standards." }}
          </p>
          
          {% if section.settings.quality_button_text %}
            <a href="{{ section.settings.quality_button_url | default: '#' }}" class="card-arrow-button">
              <svg class="arrow-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- Contact Us Button -->
    {% if section.settings.contact_button_text %}
      <div class="contact-us-section">
        <a href="{{ section.settings.contact_button_url | default: '/pages/contact' }}" class="contact-us-button">
          <svg class="contact-icon" width="20" height="16" viewBox="0 0 20 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M18 0H2C0.9 0 0 0.9 0 2V14C0 15.1 0.9 16 2 16H18C19.1 16 20 15.1 20 14V2C20 0.9 19.1 0 18 0ZM18 4L10 9L2 4V2L10 7L18 2V4Z" fill="currentColor"/>
          </svg>
          {{ section.settings.contact_button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

<style>
.company-overview-section {
  padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px 0;
  background-color: {{ section.settings.section_background_color }};
}

.company-overview-container {
  max-width: 1520px;
  margin: 0 auto;
  padding: 0 20px;
}

.company-overview-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
  margin-bottom: 60px;
}

.company-overview-card {
  position: relative;
  border-radius: 16px;
  overflow: hidden;
  background: #f5f5f5;
  height: 320px;
  transition: all 0.3s ease;
  cursor: pointer;
}

.company-overview-card:hover {
  transform: translateY(-8px);
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
}

.card-image-container {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.card-background-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}

.card-image-placeholder {
  width: 100%;
  height: 100%;
}

.story-bg {
  background: url('https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?ixlib=rb-4.0.3&auto=format&fit=crop&w=460&q=80') center/cover;
}

.factory-bg {
  background: url('https://images.unsplash.com/photo-1565043666747-69f6646db940?ixlib=rb-4.0.3&auto=format&fit=crop&w=460&q=80') center/cover;
}

.quality-bg {
  background: url('https://images.unsplash.com/photo-1581092795360-fd1ca04f0952?ixlib=rb-4.0.3&auto=format&fit=crop&w=460&q=80') center/cover;
}

.card-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.6) 100%);
  z-index: 2;
}

.card-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30px;
  z-index: 3;
  color: white;
}

.card-title {
  font-size: 28px;
  font-weight: 600;
  color: white;
  margin: 0 0 16px 0;
  line-height: 1.2;
}

.card-description {
  font-size: 16px;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.9);
  margin: 0 0 20px 0;
  line-height: 1.5;
}

.card-arrow-button {
  position: absolute;
  top: 30px;
  right: 30px;
  width: 48px;
  height: 48px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  text-decoration: none;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
}

.card-arrow-button:hover {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(1.1);
}

.arrow-icon {
  width: 20px;
  height: 20px;
}

/* Contact Us Section */
.contact-us-section {
  display: flex;
  justify-content: center;
  align-items: center;
}

.contact-us-button {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  background: #161616;
  color: white;
  padding: 16px 32px;
  font-size: 16px;
  font-weight: 600;
  text-decoration: none;
  text-transform: uppercase;
  letter-spacing: 1px;
  border-radius: 4px;
  transition: all 0.3s ease;
}

.contact-us-button:hover {
  background: #333333;
  transform: translateY(-2px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
}

.contact-icon {
  width: 20px;
  height: 16px;
  flex-shrink: 0;
}

/* 响应式设计 - 基于1920px设计图按比例缩放 */

/* 大屏幕 (1920px+) - 使用设计图精确尺寸 */
@media (min-width: 1920px) {
  .company-overview-container {
    max-width: 1520px;
  }
  
  .company-overview-grid {
    gap: 30px;
    margin-bottom: 60px;
  }
  
  .company-overview-card {
    height: 320px;
  }
  
  .card-content {
    padding: 30px;
  }
  
  .card-title {
    font-size: 28px;
    margin-bottom: 16px;
  }
  
  .card-description {
    font-size: 16px;
    margin-bottom: 20px;
  }
  
  .card-arrow-button {
    top: 30px;
    right: 30px;
    width: 48px;
    height: 48px;
  }
  
  .arrow-icon {
    width: 20px;
    height: 20px;
  }
}

/* 笔记本电脑 (1366px - 1919px) - 按比例缩放 (约0.84倍) */
@media (max-width: 1919px) and (min-width: 1366px) {
  .company-overview-container {
    max-width: 1277px; /* 1520 * 0.84 */
  }
  
  .company-overview-grid {
    gap: 25px; /* 30 * 0.84 */
    margin-bottom: 50px; /* 60 * 0.84 */
  }
  
  .company-overview-card {
    height: 269px; /* 320 * 0.84 */
  }
  
  .card-content {
    padding: 25px; /* 30 * 0.84 */
  }
  
  .card-title {
    font-size: 24px; /* 28 * 0.84 */
    margin-bottom: 13px; /* 16 * 0.84 */
  }
  
  .card-description {
    font-size: 13px; /* 16 * 0.84 */
    margin-bottom: 17px; /* 20 * 0.84 */
  }
  
  .card-arrow-button {
    top: 25px; /* 30 * 0.84 */
    right: 25px; /* 30 * 0.84 */
    width: 40px; /* 48 * 0.84 */
    height: 40px; /* 48 * 0.84 */
  }
  
  .arrow-icon {
    width: 17px; /* 20 * 0.84 */
    height: 17px; /* 20 * 0.84 */
  }
}

/* 小笔记本 (1024px - 1365px) - 按比例缩放 (约0.67倍) */
@media (max-width: 1365px) and (min-width: 1024px) {
  .company-overview-container {
    max-width: 1018px; /* 1520 * 0.67 */
    padding: 0 30px;
  }
  
  .company-overview-grid {
    gap: 20px; /* 30 * 0.67 */
    margin-bottom: 40px; /* 60 * 0.67 */
  }
  
  .company-overview-card {
    height: 214px; /* 320 * 0.67 */
  }
  
  .card-content {
    padding: 20px; /* 30 * 0.67 */
  }
  
  .card-title {
    font-size: 19px; /* 28 * 0.67 */
    margin-bottom: 11px; /* 16 * 0.67 */
  }
  
  .card-description {
    font-size: 11px; /* 16 * 0.67 */
    margin-bottom: 13px; /* 20 * 0.67 */
  }
  
  .card-arrow-button {
    top: 20px; /* 30 * 0.67 */
    right: 20px; /* 30 * 0.67 */
    width: 32px; /* 48 * 0.67 */
    height: 32px; /* 48 * 0.67 */
  }
  
  .arrow-icon {
    width: 13px; /* 20 * 0.67 */
    height: 13px; /* 20 * 0.67 */
  }
}

/* 平板横屏 (768px - 1023px) - 按比例缩放 (约0.5倍) */
@media (max-width: 1023px) and (min-width: 768px) {
  .company-overview-container {
    padding: 0 25px;
  }
  
  .company-overview-grid {
    gap: 15px; /* 30 * 0.5 */
    margin-bottom: 30px; /* 60 * 0.5 */
  }
  
  .company-overview-card {
    height: 160px; /* 320 * 0.5 */
  }
  
  .card-content {
    padding: 15px; /* 30 * 0.5 */
  }
  
  .card-title {
    font-size: 14px; /* 28 * 0.5 */
    margin-bottom: 8px; /* 16 * 0.5 */
  }
  
  .card-description {
    font-size: 8px; /* 16 * 0.5 */
    margin-bottom: 10px; /* 20 * 0.5 */
  }
  
  .card-arrow-button {
    top: 15px; /* 30 * 0.5 */
    right: 15px; /* 30 * 0.5 */
    width: 24px; /* 48 * 0.5 */
    height: 24px; /* 48 * 0.5 */
  }
  
  .arrow-icon {
    width: 10px; /* 20 * 0.5 */
    height: 10px; /* 20 * 0.5 */
  }
}

/* 平板竖屏和大手机 (481px - 767px) - 单栏布局，按比例缩放 (约0.4倍) */
@media (max-width: 767px) and (min-width: 481px) {
  .company-overview-container {
    padding: 0 20px;
  }
  
  .company-overview-grid {
    grid-template-columns: 1fr;
    gap: 12px; /* 30 * 0.4 */
    margin-bottom: 24px; /* 60 * 0.4 */
  }
  
  .company-overview-card {
    height: 128px; /* 320 * 0.4 */
  }
  
  .card-content {
    padding: 12px; /* 30 * 0.4 */
  }
  
  .card-title {
    font-size: 11px; /* 28 * 0.4 */
    margin-bottom: 6px; /* 16 * 0.4 */
  }
  
  .card-description {
    font-size: 6px; /* 16 * 0.4 */
    margin-bottom: 8px; /* 20 * 0.4 */
  }
  
  .card-arrow-button {
    top: 12px; /* 30 * 0.4 */
    right: 12px; /* 30 * 0.4 */
    width: 19px; /* 48 * 0.4 */
    height: 19px; /* 48 * 0.4 */
  }
  
  .arrow-icon {
    width: 8px; /* 20 * 0.4 */
    height: 8px; /* 20 * 0.4 */
  }
}

/* 小手机 (320px - 480px) - 单栏布局，按比例缩放 (约0.33倍) */
@media (max-width: 480px) {
  .company-overview-container {
    padding: 0 15px;
  }
  
  .company-overview-grid {
    grid-template-columns: 1fr;
    gap: 10px; /* 30 * 0.33 */
    margin-bottom: 20px; /* 60 * 0.33 */
  }
  
  .company-overview-card {
    height: 106px; /* 320 * 0.33 */
  }
  
  .card-content {
    padding: 10px; /* 30 * 0.33 */
  }
  
  .card-title {
    font-size: 9px; /* 28 * 0.33 */
    margin-bottom: 5px; /* 16 * 0.33 */
  }
  
  .card-description {
    font-size: 5px; /* 16 * 0.33 */
    margin-bottom: 7px; /* 20 * 0.33 */
  }
  
  .card-arrow-button {
    top: 10px; /* 30 * 0.33 */
    right: 10px; /* 30 * 0.33 */
    width: 16px; /* 48 * 0.33 */
    height: 16px; /* 48 * 0.33 */
  }
  
  .arrow-icon {
    width: 7px; /* 20 * 0.33 */
    height: 7px; /* 20 * 0.33 */
  }
}

/* 超小屏幕 (最小320px) - 单栏布局，按比例缩放 (约0.25倍) */
@media (max-width: 320px) {
  .company-overview-grid {
    gap: 8px; /* 30 * 0.25 */
    margin-bottom: 15px; /* 60 * 0.25 */
  }
  
  .company-overview-card {
    height: 80px; /* 320 * 0.25 */
  }
  
  .card-content {
    padding: 8px; /* 30 * 0.25 */
  }
  
  .card-title {
    font-size: 7px; /* 28 * 0.25 */
    margin-bottom: 4px; /* 16 * 0.25 */
  }
  
  .card-description {
    font-size: 4px; /* 16 * 0.25 */
    margin-bottom: 5px; /* 20 * 0.25 */
  }
  
  .card-arrow-button {
    top: 8px; /* 30 * 0.25 */
    right: 8px; /* 30 * 0.25 */
    width: 12px; /* 48 * 0.25 */
    height: 12px; /* 48 * 0.25 */
  }
  
  .arrow-icon {
    width: 5px; /* 20 * 0.25 */
    height: 5px; /* 20 * 0.25 */
  }
}
</style>

