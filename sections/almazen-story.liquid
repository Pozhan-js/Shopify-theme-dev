{% comment %}
  AlmaZen Our Story Section
{% endcomment %}

<style>
  .almazen-story {
    padding: 5rem 1.5rem;
    background: linear-gradient(135deg, #faf9f7 0%, #f5f3f0 50%, #e8e4de 100%);
  }
  
  .almazen-story .container {
    max-width: 80rem;
    margin: 0 auto;
  }
  
  .almazen-story .section-header {
    text-align: center;
    margin-bottom: 4rem;
    animation: slideUp 0.6s ease-out;
  }
  
  .almazen-story .section-title {
    font-size: 2.5rem;
    font-family: 'Noto Serif', serif;
    font-weight: 300;
    color: #4a3f32;
    margin-bottom: 1.5rem;
  }
  
  .almazen-story .section-divider {
    width: 4rem;
    height: 2px;
    background: #5a7c5a;
    margin: 0 auto 2rem;
  }
  
  .almazen-story .section-intro {
    font-size: 1.125rem;
    color: #8b7d68;
    max-width: 48rem;
    margin: 0 auto;
    line-height: 1.6;
  }
  
  .almazen-story .story-content {
    display: grid;
    gap: 3rem;
    align-items: center;
    margin-bottom: 4rem;
  }
  
  .almazen-story .story-text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    animation: slideUp 0.6s ease-out;
  }
  
  .almazen-story .story-subtitle {
    font-size: 1.5rem;
    font-family: 'Noto Serif', serif;
    color: #4a3f32;
    margin-bottom: 1rem;
  }
  
  .almazen-story .story-paragraph {
    color: #8b7d68;
    line-height: 1.6;
  }
  
  .almazen-story .story-highlight {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
  }
  
  .almazen-story .highlight-icon {
    width: 3rem;
    height: 3rem;
    background: #e3e7e3;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .almazen-story .highlight-text {
    color: #6b5d4a;
    font-weight: 500;
  }
  
  .almazen-story .story-images {
    position: relative;
  }
  
  .almazen-story .images-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  
  .almazen-story .image-container {
    flex: 1;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  
  .almazen-story .image-container:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 60px rgba(45, 36, 27, 0.15);
  }
  
  .almazen-story .story-image {
    width: 100%;
    height: 24rem;
    object-fit: cover;
    border-radius: 0.5rem;
    box-shadow: 0 10px 40px rgba(45, 36, 27, 0.1);
  }
  
  .almazen-story .image-caption {
    margin-top: 1rem;
    text-align: center;
  }
  
  .almazen-story .caption-text {
    font-size: 0.875rem;
    color: #8b7d68;
    font-style: italic;
  }
  
  .almazen-story .floating-decoration {
    position: absolute;
    border-radius: 50%;
    animation: float 6s ease-in-out infinite;
  }
  
  .almazen-story .decoration-1 {
    top: -1rem;
    right: -1rem;
    width: 6rem;
    height: 6rem;
    background: rgba(199, 210, 199, 0.5);
  }
  
  .almazen-story .decoration-2 {
    bottom: -2rem;
    left: -2rem;
    width: 4rem;
    height: 4rem;
    background: rgba(232, 228, 222, 0.3);
    animation-delay: 2s;
  }
  
  .almazen-story .quote-section {
    background: rgba(255, 255, 255, 0.6);
    border-radius: 1rem;
    padding: 2rem;
    box-shadow: 0 10px 40px rgba(45, 36, 27, 0.1);
  }
  
  .almazen-story .quote-content {
    text-align: center;
  }
  
  .almazen-story .quote-icon {
    color: #5a7c5a;
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }
  
  .almazen-story .quote-text {
    font-size: 1.25rem;
    font-family: 'Noto Serif', serif;
    color: #4a3f32;
    font-style: italic;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }
  
  .almazen-story .quote-author {
    color: #8b7d68;
    font-weight: 500;
  }
  
  @media (min-width: 768px) {
    .almazen-story .section-title {
      font-size: 3rem;
    }
    .almazen-story .story-subtitle {
      font-size: 1.875rem;
    }
    .almazen-story .images-grid {
      flex-direction: row;
    }
    .almazen-story .image-container:nth-child(2) {
      margin-top: 3rem;
    }
    .almazen-story .story-image {
      height: 31.25rem;
    }
    .almazen-story .quote-section {
      padding: 3rem;
    }
    .almazen-story .quote-text {
      font-size: 1.5rem;
    }
  }
  
  @media (min-width: 1024px) {
    .almazen-story {
      padding: 5rem 3rem;
    }
    .almazen-story .story-content {
      grid-template-columns: 1fr 1fr;
    }
  }
  
  @keyframes slideUp {
    0% { transform: translateY(30px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
  }
</style>

<section id="story" class="almazen-story">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        {{ section.settings.story_title | default: 'Our Story' }}
      </h2>
      <div class="section-divider"></div>
      <p class="section-intro">
        {{ section.settings.story_intro }}
      </p>
    </div>

    <div class="story-content">
      <div class="story-text">
        <h3 class="story-subtitle">
          {{ section.settings.story_subtitle }}
        </h3>
        {% for block in section.blocks %}
          {% if block.type == 'story_paragraph' %}
            <p class="story-paragraph">
              {{ block.settings.paragraph_text }}
            </p>
          {% endif %}
        {% endfor %}
    
      </div>
      
      <div class="story-images">
        <div class="images-grid">
          {% if section.settings.story_image_1 %}
            <div class="image-container">
              <img 
                src="{{ section.settings.story_image_1 | img_url: '600x' }}"
                alt="{{ section.settings.story_image_1_alt }}"
                class="story-image"
              />
              {% comment %} <div class="image-caption">
                <p class="caption-text">{{ section.settings.story_image_1_caption }}</p>
              </div> {% endcomment %}
            </div>
          {% endif %}
          {% if section.settings.story_image_2 %}
            <div class="image-container">
              <img 
                src="{{ section.settings.story_image_2 | img_url: '600x' }}"
                alt="{{ section.settings.story_image_2_alt }}"
                class="story-image"
              />
              {% comment %} <div class="image-caption">
                <p class="caption-text">{{ section.settings.story_image_2_caption }}</p>
              </div> {% endcomment %}
            </div>
          {% endif %}
        </div>
        <div class="floating-decoration decoration-1"></div>
        <div class="floating-decoration decoration-2"></div>
      </div>
    </div>

    <div class="quote-section">
      <div class="quote-content">
        <i class="fas fa-quote-left quote-icon"></i>
        <blockquote class="quote-text">
          {{ section.settings.story_quote }}
        </blockquote>
        <cite class="quote-author">{{ section.settings.story_quote_author }}</cite>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Our Story",
  "settings": [
    {
      "type": "text",
      "id": "story_title",
      "label": "Section Title",
      "default": "Our Story"
    },
    {
      "type": "textarea",
      "id": "story_intro",
      "label": "Introduction Text",
      "default": "Born from ancient wisdom and modern mindfulness, AlmaZen bridges the timeless teachings of Zen with contemporary wellness needs."
    },
    {
      "type": "text",
      "id": "story_subtitle",
      "label": "Story Subtitle",
      "default": "Ancient Wisdom, Modern Life"
    },

    {
      "type": "image_picker",
      "id": "story_image_1",
      "label": "Story Image 1"
    },
    {
      "type": "text",
      "id": "story_image_1_alt",
      "label": "Image 1 Alt Text",
      "default": "Traditional artisan crafting mindful products"
    },
    {
      "type": "text",
      "id": "story_image_1_caption",
      "label": "Image 1 Caption",
      "default": "Master artisan handcrafting with mindful intention"
    },
    {
      "type": "image_picker",
      "id": "story_image_2",
      "label": "Story Image 2"
    },
    {
      "type": "text",
      "id": "story_image_2_alt",
      "label": "Image 2 Alt Text",
      "default": "Sacred temple blessing ceremony with monk"
    },
    {
      "type": "textarea",
      "id": "story_quote",
      "label": "Quote Text",
      "default": "In the stillness of the temple, we found not just products, but a way of life. Each creation carries the essence of centuries-old wisdom."
    },
    {
      "type": "text",
      "id": "story_quote_author",
      "label": "Quote Author",
      "default": "— AlmaZen Founders"
    }
  ],
  "blocks": [
    {
      "type": "story_paragraph",
      "name": "Story Paragraph",
      "settings": [
        {
          "type": "textarea",
          "id": "paragraph_text",
          "label": "Paragraph Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Story",
      "blocks": [
        {
          "type": "story_paragraph",
          "settings": {
            "paragraph_text": "AlmaZen was founded on the belief that the ancient wisdom of Chinese Zen philosophy holds the keys to finding peace and balance in our modern world. Our journey began in the sacred temples of China, where we discovered the profound connection between mindfulness, craftsmanship, and spiritual well-being."
          }
        },
        {
          "type": "story_paragraph",
          "settings": {
            "paragraph_text": "Every product in our collection is carefully handcrafted by skilled artisans who understand the sacred nature of their work. Each piece is then blessed in traditional temples, infusing them with positive energy and intention."
          }
        }
      ]
    }
  ]
}
{% endschema %}
