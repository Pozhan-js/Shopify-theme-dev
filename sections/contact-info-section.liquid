<div class="contact-info-section" {{ section.shopify_attributes }}>
  <div class="contact-info-container">
    <div class="contact-call-section">
      <div class="contact-call-content">
        <h2 class="contact-call-title">{{ section.settings.call_title | default: 'Call Us' }}</h2>
        <div class="contact-call-details">
          <div class="contact-company-info">
            <h3 class="contact-company-name">{{ section.settings.company_name | default: 'XS PILATES CHINA' }}</h3>
            {% if section.settings.phone_number != blank %}
              <div class="contact-phone">
                <svg class="contact-phone-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="contact-phone-number">{{ section.settings.phone_number }}</span>
              </div>
            {% endif %}
            {% if section.settings.business_hours != blank %}
              <div class="contact-hours">
                <svg class="contact-hours-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/><polyline points="12,6 12,12 16,14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="contact-hours-text">{{ section.settings.business_hours }}</span>
              </div>
            {% endif %}
          </div>
          {% if section.settings.call_button_text != blank %}
            <a href="tel:{{ section.settings.phone_number | replace: ' ', '' | replace: '-', '' }}" class="contact-call-button">{{ section.settings.call_button_text }}</a>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="contact-divider"></div>

    <div class="contact-find-section">
      <div class="contact-find-content">
        <h2 class="contact-find-title">{{ section.settings.find_title | default: 'Find Us' }}</h2>
        
        <div class="contact-find-blocks" style="flex: 1; display: flex; flex-direction: column; gap: 60px;">
          {% for block in section.blocks %}
            <div class="contact-find-details" {{ block.shopify_attributes }}>
              <div class="contact-location-info">
                {% if block.settings.headquarters_label != blank %}
                  <div class="contact-headquarters-label">{{ block.settings.headquarters_label }}</div>
                {% endif %}

                {% if block.settings.address != blank %}
                  <div class="contact-address">{{ block.settings.address }}</div>
                {% endif %}

                <div class="contact-location-details">
                  {% if block.settings.location_phone != blank %}
                    <div class="contact-location-phone">
                      <svg class="contact-location-phone-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      <span class="contact-location-phone-number">{{ block.settings.location_phone }}</span>
                    </div>
                  {% endif %}

                  {% if block.settings.email != blank %}
                    <div class="contact-email">
                      <a href="mailto:{{ block.settings.email }}" class="contact-email-link">
                        <svg class="contact-email-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="2"/><polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="2"/>
                        </svg>
                        <span class="contact-email-address">{{ block.settings.email }}</span>
                      </a>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}

          {% if section.settings.contact_button_text != blank %}
            <a href="{{ section.settings.contact_button_url | default: '/pages/contact' }}" class="contact-find-button">
              {{ section.settings.contact_button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* 此处保留您原本的所有 CSS 样式即可，无需大幅修改 */
  /* 仅需确保 .contact-find-content 里的布局能承载多个 block */
  .contact-find-blocks {
    display: flex;
    flex-direction: column;
    gap: 40px; /* 多个地址之间的间距 */
  }
</style>

{% schema %}
{
  "name": "联系信息",
  "tag": "section",
  "class": "contact-info-section",
  "settings": [
    {
      "type": "header",
      "content": "Call Us 区域设置"
    },
    {
      "type": "text",
      "id": "call_title",
      "label": "Call Us 标题",
      "default": "Call Us"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "公司名称",
      "default": "XS PILATES CHINA"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "电话号码",
      "default": "+86 138 2579 8157"
    },
    {
      "type": "text",
      "id": "business_hours",
      "label": "营业时间",
      "default": "Mon-Fri 9:00-18:00 (GMT+8)"
    },
    {
      "type": "text",
      "id": "call_button_text",
      "label": "Call Us 按钮文字",
      "default": "CALL NOW"
    },
    {
      "type": "header",
      "content": "Find Us 区域通用设置"
    },
    {
      "type": "text",
      "id": "find_title",
      "label": "Find Us 标题",
      "default": "Find Us"
    },
    {
      "type": "text",
      "id": "contact_button_text",
      "label": "底部联系按钮文字",
      "default": "CONTACT US"
    },
    {
      "type": "url",
      "id": "contact_button_url",
      "label": "底部联系按钮链接"
    }
  ],
  "blocks": [
    {
      "type": "location",
      "name": "地址地点",
      "settings": [
        {
          "type": "text",
          "id": "headquarters_label",
          "label": "标签 (如: HEADQUARTERS)",
          "default": "HEADQUARTERS"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "地址",
          "default": "Building 3, No. 1688 Chuangxin Road, Songjiang District, Shanghai, China"
        },
        {
          "type": "text",
          "id": "location_phone",
          "label": "地址电话",
          "default": "+86 138 2579 8157"
        },
        {
          "type": "text",
          "id": "email",
          "label": "邮箱地址",
          "default": "info@xspilates.com"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "联系信息",
      "blocks": [
        {
          "type": "location"
        }
      ]
    }
  ]
}
{% endschema %}