<div class="contact-info-section" {{ section.shopify_attributes }}>
  <div class="contact-info-container">
    <!-- Call Us 区域 -->
    <div class="contact-call-section">
      <div class="contact-call-content">
        <h2 class="contact-call-title">{{ section.settings.call_title | default: 'Call Us' }}</h2>

        <div class="contact-call-details">
          <div class="contact-company-info">
            <h3 class="contact-company-name">{{ section.settings.company_name | default: 'XS PILATES CHINA' }}</h3>

            {% if section.settings.phone_number != blank %}
              <div class="contact-phone">
                <svg
                  class="contact-phone-icon"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="contact-phone-number">{{ section.settings.phone_number }}</span>
              </div>
            {% endif %}

            {% if section.settings.business_hours != blank %}
              <div class="contact-hours">
                <svg
                  class="contact-hours-icon"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                  <polyline points="12,6 12,12 16,14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="contact-hours-text">{{ section.settings.business_hours }}</span>
              </div>
            {% endif %}
          </div>

          {% if section.settings.call_button_text != blank %}
            <a
              href="tel:{{ section.settings.phone_number | replace: ' ', '' | replace: '-', '' }}"
              class="contact-call-button"
            >
              {{ section.settings.call_button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>

    <!-- 分隔线 -->
    <div class="contact-divider"></div>

    <!-- Find Us 区域 -->
    <div class="contact-find-section">
      <div class="contact-find-content">
        <h2 class="contact-find-title">{{ section.settings.find_title | default: 'Find Us' }}</h2>

        <div class="contact-find-details">
          <div class="contact-location-info">
            {% if section.settings.headquarters_label != blank %}
              <div class="contact-headquarters-label">{{ section.settings.headquarters_label }}</div>
            {% endif %}

            {% if section.settings.address != blank %}
              <div class="contact-address">{{ section.settings.address }}</div>
            {% endif %}

            <div class="contact-location-details">
              {% if section.settings.location_phone != blank %}
                <div class="contact-location-phone">
                  <svg
                    class="contact-location-phone-icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="contact-location-phone-number">{{ section.settings.location_phone }}</span>
                </div>
              {% endif %}

              {% if section.settings.email != blank %}
                <div class="contact-email">
                  <a href="mailto:{{ section.settings.email }}">
                  <svg
                    class="contact-email-icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="2"/>
                    <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="2"/>
                  </svg>
                  <span class="contact-email-address">{{ section.settings.email }}</span>
                </a>
                </div>
              {% endif %}

              {% if section.settings.location_hours != blank %}
                <div class="contact-location-hours">
                  <svg
                    class="contact-location-hours-icon"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
                    <polyline points="12,6 12,12 16,14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span class="contact-location-hours-text">{{ section.settings.location_hours }}</span>
                </div>
              {% endif %}
            </div>
          </div>

          {% if section.settings.contact_button_text != blank %}
            <a href="{{ section.settings.contact_button_url | default: '/pages/contact' }}" class="contact-find-button">
              {{ section.settings.contact_button_text }}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .contact-info-section {
    background-color: #f1f0ee;
    padding: 40px 0;
  }

  .contact-info-container {
    max-width: 1654px;
    margin: 0 auto;
    padding: 0;
  }

  /* Call Us 区域样式 */
  .contact-call-section {
    padding-bottom: 60px;
    border-top: 1px solid rgba(22, 22, 22, 0.25);
    padding-top: 60px;
  }

  .contact-call-content {
    display: flex;
    align-items: flex-start;
    gap: 350px;
  }

  .contact-call-title {
    font-family: 'Poppins', sans-serif;
    font-size: 36px;
    font-weight: 400;
    color: #161616;
    margin: 0;
    line-height: 1.2;
    width: 200px;
    flex-shrink: 0;
  }

  .contact-call-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .contact-company-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-company-name {
    font-family: 'Poppins', sans-serif;
    font-size: 36px;
    font-weight: 400;
    color: #161616;
    margin: 0;
    line-height: 1.3;
  }

  .contact-phone,
  .contact-hours {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .contact-phone-icon,
  .contact-hours-icon {
    width: 16px;
    height: 16px;
    color: rgba(22, 22, 22, 0.5);
    flex-shrink: 0;
  }

  .contact-phone-number {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: #161616;
    line-height: 1.5;
  }

  .contact-hours-text {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: rgba(22, 22, 22, 0.5);
    line-height: 1.5;
  }

  .contact-call-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #c22e35;
    color: white;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 4px;
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .contact-call-button:hover {
    background-color: #a02329;
    transform: translateY(-2px);
  }

  /* 分隔线样式 */
  .contact-divider {
    width: 100%;
    height: 1px;
    background-color: rgba(22, 22, 22, 0.15);
    margin: 0;
  }

  /* Find Us 区域样式 */
  .contact-find-section {
    padding-top: 60px;
    border-top: 1px solid rgba(22, 22, 22, 0.25);
  }

  .contact-find-content {
    display: flex;
    align-items: flex-start;
    gap: 350px;
  }

  .contact-find-title {
    font-family: 'Poppins', sans-serif;
    font-size: 36px;
    font-weight: 400;
    color: #161616;
    margin: 0;
    line-height: 1.2;
    width: 200px;
    flex-shrink: 0;
  }

  .contact-find-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .contact-location-info {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .contact-headquarters-label {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: #161616;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
  }

  .contact-address {
    font-family: 'Poppins', sans-serif;
    font-size: 36px;
    font-weight: 400;
    color: #161616;
    line-height: 1.4;
    margin: 0;
    max-width: 600px;
  }

  .contact-location-details {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }

  .contact-location-phone,
  .contact-email,
  .contact-location-hours {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .contact-location-phone-icon,
  .contact-email-icon,
  .contact-location-hours-icon {
    width: 16px;
    height: 16px;
    color: rgba(22, 22, 22, 0.5);
    flex-shrink: 0;
  }

  .contact-location-phone-number,
  .contact-email-address {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: #161616;
    line-height: 1.5;
  }

  .contact-location-hours-text {
    font-family: 'Poppins', sans-serif;
    font-size: 18px;
    font-weight: 400;
    color: rgba(22, 22, 22, 0.5);
    line-height: 1.5;
  }

  .contact-find-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #c22e35;
    color: white;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 1px;
    border-radius: 4px;
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .contact-find-button:hover {
    background-color: #a02329;
    transform: translateY(-2px);
  }

  /* 响应式设计 */

  /* 大屏幕 (1920px+) - 使用设计图精确尺寸 */
  @media (min-width: 1920px) {
    .contact-info-container {
      max-width: 1654px;
      padding: 0;
    }

    .contact-call-content,
    .contact-find-content {
      gap: 350px;
    }

    .contact-call-title,
    .contact-find-title {
      font-size: 36px;
      width: 200px;
    }

    .contact-company-name,
    .contact-address {
      font-size: 36px;
    }

    .contact-phone-number,
    .contact-hours-text,
    .contact-location-phone-number,
    .contact-email-address,
    .contact-location-hours-text {
      font-size: 18px;
    }

    .contact-headquarters-label {
      font-size: 18px;
    }

    .contact-call-button,
    .contact-find-button {
      font-size: 14px;
      padding: 12px 24px;
    }
  }

  /* 中等屏幕 (1024px - 1919px) - 84%比例缩放 */
  @media (min-width: 1024px) and (max-width: 1919px) {
    .contact-info-container {
      max-width: calc(1654px * 0.84);
      padding: 0 20px;
    }

    .contact-call-content,
    .contact-find-content {
      gap: calc(350px * 0.84);
    }

    .contact-call-title,
    .contact-find-title {
      font-size: calc(36px * 0.84);
      width: calc(200px * 0.84);
    }

    .contact-company-name,
    .contact-address {
      font-size: calc(36px * 0.84);
    }

    .contact-phone-number,
    .contact-hours-text,
    .contact-location-phone-number,
    .contact-email-address,
    .contact-location-hours-text {
      font-size: calc(18px * 0.84);
    }

    .contact-headquarters-label {
      font-size: calc(18px * 0.84);
    }

    .contact-call-button,
    .contact-find-button {
      font-size: calc(14px * 0.84);
      padding: calc(12px * 0.84) calc(24px * 0.84);
    }
  }

  /* 平板屏幕 (768px - 1023px) - 67%比例缩放，垂直布局 */
  @media (min-width: 768px) and (max-width: 1023px) {
    .contact-info-section {
      padding: calc(40px * 0.67) 0;
    }

    .contact-info-container {
      max-width: calc(1654px * 0.67);
      padding: 0 20px;
    }

    .contact-call-section {
      padding-bottom: calc(60px * 0.67);
      padding-top: calc(60px * 0.67);
    }

    .contact-find-section {
      padding-top: calc(60px * 0.67);
    }

    .contact-call-content,
    .contact-find-content {
      flex-direction: column;
      gap: calc(30px * 0.67);
      text-align: center;
    }

    .contact-call-title,
    .contact-find-title {
      font-size: calc(36px * 0.67);
      width: auto;
    }

    .contact-company-name,
    .contact-address {
      font-size: calc(36px * 0.67);
    }

    .contact-phone-number,
    .contact-hours-text,
    .contact-location-phone-number,
    .contact-email-address,
    .contact-location-hours-text {
      font-size: calc(18px * 0.67);
    }

    .contact-headquarters-label {
      font-size: calc(18px * 0.67);
    }

    .contact-call-button,
    .contact-find-button {
      font-size: calc(14px * 0.67);
      padding: calc(12px * 0.67) calc(24px * 0.67);
    }
  }

  /* 小屏幕 (481px - 767px) - 增大文字，靠左对齐 */
  @media (min-width: 481px) and (max-width: 767px) {
    .contact-info-section {
      padding: 20px 0;
    }

    .contact-info-container {
      max-width: 100%;
      padding: 0 20px;
    }

    .contact-call-section {
      padding-bottom: 40px;
      padding-top: 40px;
    }

    .contact-find-section {
      padding-top: 40px;
    }

    .contact-call-content,
    .contact-find-content {
      flex-direction: column;
      gap: 30px;
      text-align: left;
    }

    .contact-call-title,
    .contact-find-title {
      font-size: 28px;
      width: auto;
    }

    .contact-company-name,
    .contact-address {
      font-size: 24px;
    }

    .contact-phone-number,
    .contact-hours-text,
    .contact-location-phone-number,
    .contact-email-address,
    .contact-location-hours-text {
      font-size: 18px;
    }

    .contact-headquarters-label {
      font-size: 16px;
    }

    .contact-call-button,
    .contact-find-button {
      font-size: 12px;
      padding: 10px 20px;
    }
  }

  /* 超小屏幕 (最大480px) - 增大文字，靠左对齐 */
  @media (max-width: 480px) {
    .contact-info-section {
      padding: 30px 0;
    }

    .contact-info-container {
      max-width: 100%;
      padding: 0 15px;
    }

    .contact-call-section {
      padding-bottom: 30px;
      padding-top: 30px;
    }

    .contact-find-section {
      padding-top: 30px;
    }

    .contact-call-content,
    .contact-find-content {
      flex-direction: column;
      gap: 25px;
      text-align: left;
    }

    .contact-call-title,
    .contact-find-title {
      font-size: 24px;
      width: auto;
    }

    .contact-company-name,
    .contact-address {
      font-size: 20px;
    }

    .contact-phone-number,
    .contact-hours-text,
    .contact-location-phone-number,
    .contact-email-address,
    .contact-location-hours-text {
      font-size: 14px;
    }

    .contact-headquarters-label {
      font-size: 12px;
    }

    .contact-call-button,
    .contact-find-button {
      font-size: 12px;
      padding: 10px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "联系信息",
  "tag": "section",
  "class": "contact-info-section",
  "settings": [
    {
      "type": "header",
      "content": "Call Us 区域设置"
    },
    {
      "type": "text",
      "id": "call_title",
      "label": "Call Us 标题",
      "default": "Call Us"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "公司名称",
      "default": "XS PILATES CHINA"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "电话号码",
      "default": "+86 138 2579 8157"
    },
    {
      "type": "text",
      "id": "business_hours",
      "label": "营业时间",
      "default": "Mon-Fri 9:00-18:00 (GMT+8)"
    },
    {
      "type": "text",
      "id": "call_button_text",
      "label": "Call Us 按钮文字",
      "default": "CALL NOW"
    },
    {
      "type": "header",
      "content": "Find Us 区域设置"
    },
    {
      "type": "text",
      "id": "find_title",
      "label": "Find Us 标题",
      "default": "Find Us"
    },
    {
      "type": "text",
      "id": "headquarters_label",
      "label": "总部标签",
      "default": "HEADQUARTERS"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "地址",
      "default": "Building 3, No. 1688 Chuangxin Road, Songjiang District, Shanghai, China"
    },
    {
      "type": "text",
      "id": "location_phone",
      "label": "地址电话",
      "default": "+86 138 2579 8157"
    },
    {
      "type": "text",
      "id": "email",
      "label": "邮箱地址",
      "default": "info@xspilates.com"
    },
    {
      "type": "text",
      "id": "location_hours",
      "label": "地址营业时间",
      "default": "Mon-Fri 9:00-18:00 (GMT+8)"
    },
    {
      "type": "text",
      "id": "contact_button_text",
      "label": "联系按钮文字",
      "default": "CONTACT US"
    },
    {
      "type": "url",
      "id": "contact_button_url",
      "label": "联系按钮链接"
    }
  ],
  "presets": [
    {
      "name": "联系信息",
      "settings": {
        "call_title": "Call Us",
        "company_name": "XS PILATES CHINA",
        "phone_number": "+86 138 2579 8157",
        "business_hours": "Mon-Fri 9:00-18:00 (GMT+8)",
        "call_button_text": "CALL NOW",
        "find_title": "Find Us",
        "headquarters_label": "HEADQUARTERS",
        "address": "Building 3, No. 1688 Chuangxin Road, Songjiang District, Shanghai, China",
        "location_phone": "+86 138 2579 8157",
        "email": "info@xspilates.com",
        "location_hours": "Mon-Fri 9:00-18:00 (GMT+8)",
        "contact_button_text": "CONTACT US"
      }
    }
  ]
}
{% endschema %}
