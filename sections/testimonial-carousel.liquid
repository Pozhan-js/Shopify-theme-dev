{% comment %}
  Testimonials Slider Section
  - Swiper.js
  - Arrow navigation
  - Responsive
{% endcomment %}

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css"
/>

<style>
.testimonials-wrapper {
  padding: 60px 0;
}

.testimonial-card {
  background: #c92b2b;
  color: #fff;
  border-radius: 14px;
  padding: 28px;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.testimonial-header h3 {
  font-size: 20px;
  margin: 0 0 6px;
  font-weight: 700;
}

.testimonial-header .title {
  font-size: 14px;
  opacity: 0.85;
  margin-bottom: 10px;
}

.testimonial-content {
  font-size: 14px;
  line-height: 1.6;
  opacity: 0.95;
  margin-bottom: 20px;
}

.testimonial-footer {
  margin-top: auto;
}

.testimonial-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border: 1px solid #fff;
  color: #fff;
  padding: 8px 14px;
  border-radius: 20px;
  font-size: 13px;
  text-decoration: none;
  transition: all .2s ease;
}

.testimonial-btn:hover {
  background: #fff;
  color: #c92b2b;
}

.swiper-button-next,
.swiper-button-prev {
  color: #333;
}

@media (max-width: 768px) {
  .testimonials-wrapper {
    padding: 40px 0;
  }
}
</style>

<div class="testimonials-wrapper">
  <div class="swiper testimonials-swiper">
    <div class="swiper-wrapper">

      {% for block in section.blocks %}
        <div class="swiper-slide">
          <div class="testimonial-card">
            <div class="testimonial-header">
              <h3>{{ block.settings.name }}</h3>
              <div class="title">{{ block.settings.title }}</div>
            </div>

            <div class="testimonial-content">
              {{ block.settings.content }}
            </div>

            {% if block.settings.link != blank %}
              <div class="testimonial-footer">
                <a class="testimonial-btn" href="{{ block.settings.link }}">
                  Learn more →
                </a>
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}

    </div>

    <!-- Navigation -->
    <div class="swiper-button-prev"></div>
    <div class="swiper-button-next"></div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  new Swiper('.testimonials-swiper', {
    slidesPerView: 4,
    spaceBetween: 24,
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    breakpoints: {
      0: {
        slidesPerView: 1.1
      },
      768: {
        slidesPerView: 2.2
      },
      1024: {
        slidesPerView: 4
      }
    }
  });
});
</script>

{% schema %}
{
  "name": "Testimonials Slider",
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "James Rylee"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Owner, Core Point Studio"
        },
        {
          "type": "textarea",
          "id": "content",
          "label": "Content",
          "default": "This is a testimonial content example. You can replace this text."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Learn more link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}
