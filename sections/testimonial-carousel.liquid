<div class="testimonial-carousel-section">
  <div class="testimonial-carousel-container">
    <div class="testimonial-carousel-cards" id="testimonialCards">
      {% for block in section.blocks %}
        {% if block.settings.image != blank and block.settings.name != blank %}
          <div class="testimonial-card">
            <div class="testimonial-card__left">
              <div class="testimonial-card__header" style="background-color: #c22e35;">
                <h3 class="testimonial-card__name">{{ block.settings.name }}</h3>
                <p class="testimonial-card__role">{{ block.settings.role }}</p>
                <span class="testimonial-card__country">{{ block.settings.country }}</span>
              </div>
              
              <div class="testimonial-card__content-wrapper">
                <div class="testimonial-card__content">
                  <p class="testimonial-card__quote">{{ block.settings.quote }}</p>
                  {% if block.settings.button_link != blank %}
                    <a href="{{ block.settings.button_link }}" class="testimonial-card__button" target="{{ block.settings.button_target }}">
                      → {{ block.settings.button_text | default: "LEARN MORE" }}
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
            
            <div class="testimonial-card__right">
              <img src="{{ block.settings.image | image_url: width: 400, height: 400 }}" alt="{{ block.settings.name }}的案例">
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="testimonial-carousel-nav" id="testimonialNav">
      <span class="testimonial-nav-arrow--left" aria-label="上一组案例">←</span>
      <div class="testimonial-nav-tracks">
        {% for block in section.blocks %}
          <span class="testimonial-nav-track" data-index="{{ forloop.index0 }}"></span>
        {% endfor %}
      </div>
      <span class="testimonial-nav-arrow--right" aria-label="下一组案例">→</span>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "客户案例轮播（Mac优化版）",
  "tag": "section",
  "class": "testimonial-carousel-section",
  "blocks": [
    {
      "type": "testimonial_card",
      "name": "案例卡片",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "右侧图片"
        },
        {
          "type": "text",
          "id": "name",
          "label": "客户姓名",
          "default": "Camille Duret"
        },
        {
          "type": "text",
          "id": "role",
          "label": "客户职位/机构",
          "default": "Head Trainer, Studio Linea"
        },
        {
          "type": "text",
          "id": "country",
          "label": "国家/地区",
          "default": "France"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "案例评价",
          "default": "\"From the upholstery colors to the smooth glide—it's just beautiful to teach and shoot on. My audience often asks where I get my machines; I tell them—XS makes everything better.\""
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "按钮跳转链接"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "按钮文字",
          "default": "LEARN MORE"
        },
        {
          "type": "select",
          "id": "button_target",
          "label": "链接打开方式",
          "options": [
            { "value": "_self", "label": "当前窗口" },
            { "value": "_blank", "label": "新窗口" }
          ],
          "default": "_self"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "客户案例轮播（Mac优化版）"
    }
  ]
}
{% endschema %}

{% style %}
/* 全局盒模型重置，避免宽度计算错误 */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.testimonial-carousel-section {
  max-width: 1920px;
  margin: 20px auto;
  padding: 0;
  width: 100%; /* 强制占满可用宽度 */
}

.testimonial-carousel-container {
  overflow: hidden;
  width: 100%; /* 确保容器宽度100% */
  padding: 0 10px; /* 将padding移到容器内部 */
}

/* 核心修改：用gap替代margin，精确控制间距 */
.testimonial-carousel-cards {
  display: flex;
  transition: transform 0.5s ease;
  width: 100%;
  gap: 16px; /* 使用gap替代margin，更精确控制间距 */
}

/* 适配Mac全分辨率：3张卡片精准分配宽度，无溢出 */
.testimonial-card {
  flex: 0 0 calc(33.333% - 11px); /* 精确计算，减去gap的2/3 */
  background: #c22e35;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  display: flex;
  height: auto;
  max-height: 370px;
  min-height: 370px;
  overflow: hidden;
  border-radius: 12px;
}

.testimonial-card__left {
  flex: 0 0 60%;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.testimonial-card__header {
  padding: 15px 20px;
  background-color: #c22e35;
  color: #ffffff;
  min-height: 139px;
}

.testimonial-card__name {
  font-size: 24px;
  font-weight: 400;
  margin: 0 0 8px;
  line-height: 1.2;
  color: white;
}

.testimonial-card__role {
  font-size: 13px;
  margin: 0 0 12px;
  line-height: 1.2;
  opacity: 0.9;
}

.testimonial-card__country {
  display: inline-block;
  padding: 4px 10px;
  background: rgba(255,255,255,0.3);
  color: #c22e35;
  font-size: 11px;
  font-weight: 600;
  border-radius: 4px;
}

.testimonial-card__content-wrapper {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
}

.testimonial-card__content {
  width: 90%;
  height: 90%;
  background-color: #ffffff;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-radius: 12px;
}

.testimonial-card__quote {
  font-size: 12px;
  line-height: 1.6;
  color: rgba(32,32,32,0.3);
  margin: 0 0 20px;
  flex: 1;
}

.testimonial-card__button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 15px;
  border: 1px solid #c22e35;
  background-color: #ffffff;
  color: #c22e35;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  transition: all 0.3s;
}

.testimonial-card__button:hover {
  background-color: #c22e35;
  color: #ffffff;
}

.testimonial-card__right {
  flex: 1;
  height: 100%;
  overflow: hidden;
}

.testimonial-card__right img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Mac中等尺寸适配（1512px及以下） */
@media (max-width: 1512px) {
  .testimonial-card {
    flex: 0 0 calc(33.333% - 10.67px); /* 更精确的计算 */
  }
}

/* Mac窄屏适配（1440px及以下） */
@media (max-width: 1440px) {
  .testimonial-carousel-container {
    padding: 0 15px; /* 增加内边距，提供更多空间 */
  }
  
  .testimonial-card {
    flex: 0 0 calc(33.333% - 10px); /* 进一步调整间距 */
    max-height: 360px;
    min-height: 360px;
  }
  
  .testimonial-card__header {
    min-height: 130px;
    padding: 12px 18px;
  }
  
  .testimonial-card__name {
    font-size: 22px;
  }
}

/* 大平板适配（1200px及以下） */
@media (max-width: 1200px) {
  .testimonial-carousel-container {
    padding: 0 12px;
  }
  
  .testimonial-card {
    flex: 0 0 calc(50% - 8px); /* 改为2列 */
  }
}

/* 平板适配（992px及以下） */
@media (max-width: 992px) {
  .testimonial-carousel-cards {
    gap: 12px;
  }
  
  .testimonial-card {
    flex: 0 0 calc(50% - 6px);
    max-height: 350px;
    min-height: 350px;
  }
}

/* 手机适配（768px及以下） */
@media (max-width: 768px) {
  .testimonial-card {
    flex: 0 0 100%;
    margin: 0;
    flex-direction: column;
    height: auto;
    max-height: none;
    min-height: auto;
  }
  
  .testimonial-card__right {
    height: 250px;
  }
  
  .testimonial-carousel-cards {
    gap: 20px; /* 手机端增加间距 */
  }
}

/* 小手机适配（480px及以下） */
@media (max-width: 480px) {
  .testimonial-carousel-container {
    padding: 0 8px;
  }
  
  .testimonial-carousel-cards {
    gap: 16px;
  }
  
  .testimonial-card__header {
    min-height: 120px;
    padding: 10px 15px;
  }
  
  .testimonial-card__name {
    font-size: 20px;
  }
}

/* 指示器样式 */
.testimonial-carousel-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 30px;
  font-size: 14px;
  color: #333;
  padding: 0 10px;
}

.testimonial-nav-arrow--left,
.testimonial-nav-arrow--right {
  cursor: pointer;
  user-select: none;
  padding: 5px;
}

.testimonial-nav-tracks {
  display: flex;
  align-items: center;
  gap: 12px;
}

.testimonial-nav-track {
  width: 25px;
  height: 2px;
  background-color: #ddd;
  cursor: pointer;
  transition: width 0.3s;
}

.testimonial-nav-track.active {
  width: 40px;
  background-color: #c22e35;
}
{% endstyle %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  const cardContainer = document.getElementById('testimonialCards');
  const cards = document.querySelectorAll('.testimonial-card');
  const navTracks = document.querySelectorAll('.testimonial-nav-track');
  const navLeft = document.querySelector('.testimonial-nav-arrow--left');
  const navRight = document.querySelector('.testimonial-nav-arrow--right');
  
  if (!cardContainer || cards.length === 0) return;

  let currentIndex = 0;
  let isAnimating = false;
  
  function getVisibleCardCount() {
    if (window.innerWidth >= 1200) return 3;
    if (window.innerWidth >= 768) return 2;
    return 1;
  }
  
  let visibleCards = getVisibleCardCount();

  // 优化：获取卡片真实宽度（包括gap）
  function getCardWidth() {
    if (cards.length === 0) return 0;
    
    const card = cards[0];
    const containerStyle = window.getComputedStyle(cardContainer);
    const gap = parseFloat(containerStyle.gap) || 0;
    
    const cardStyle = window.getComputedStyle(card);
    const width = parseFloat(cardStyle.width);
    
    return width + gap;
  }

  // 防抖处理resize事件
  let resizeTimeout;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(function() {
      visibleCards = getVisibleCardCount();
      updateCarousel();
    }, 150);
  });

  navLeft.addEventListener('click', function() {
    if (isAnimating || currentIndex === 0) return;
    
    currentIndex = Math.max(currentIndex - visibleCards, 0);
    updateCarousel();
  });

  navRight.addEventListener('click', function() {
    if (isAnimating) return;
    
    const maxIndex = Math.max(cards.length - visibleCards, 0);
    currentIndex = Math.min(currentIndex + visibleCards, maxIndex);
    updateCarousel();
  });

  navTracks.forEach(track => {
    track.addEventListener('click', function() {
      if (isAnimating) return;
      
      const index = parseInt(this.dataset.index);
      currentIndex = Math.floor(index / visibleCards) * visibleCards;
      const maxIndex = Math.max(cards.length - visibleCards, 0);
      currentIndex = Math.min(currentIndex, maxIndex);
      updateCarousel();
    });
  });

  function updateCarousel() {
    if (cards.length === 0) return;
    
    isAnimating = true;
    
    const cardWidth = getCardWidth();
    const translateX = -currentIndex * cardWidth;
    
    cardContainer.style.transform = `translateX(${translateX}px)`;
    cardContainer.style.transition = 'transform 0.5s ease';
    
    // 更新指示器状态
    navTracks.forEach((track, idx) => {
      const isActive = idx >= currentIndex && idx < currentIndex + visibleCards;
      track.classList.toggle('active', isActive);
    });

    // 更新箭头状态
    const maxIndex = Math.max(cards.length - visibleCards, 0);
    
    if (navLeft) {
      navLeft.style.opacity = currentIndex === 0 ? '0.5' : '1';
      navLeft.style.cursor = currentIndex === 0 ? 'not-allowed' : 'pointer';
    }
    
    if (navRight) {
      navRight.style.opacity = currentIndex >= maxIndex ? '0.5' : '1';
      navRight.style.cursor = currentIndex >= maxIndex ? 'not-allowed' : 'pointer';
    }
    
    // 动画结束后重置状态
    setTimeout(() => {
      isAnimating = false;
    }, 500);
  }

  // 初始化
  updateCarousel();
  
  // 确保轮播容器宽度正确
  function updateContainerWidth() {
    const container = document.querySelector('.testimonial-carousel-container');
    if (container) {
      const section = document.querySelector('.testimonial-carousel-section');
      const sectionRect = section.getBoundingClientRect();
      container.style.width = `${sectionRect.width}px`;
    }
  }
  
  // 初始化时更新一次
  setTimeout(updateContainerWidth, 100);
  window.addEventListener('resize', updateContainerWidth);
});
{% endjavascript %}