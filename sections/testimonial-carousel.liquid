{% style %}
/* 原有的导航样式保持不变 */
.testimonial-carousel-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 30px;
  font-size: 14px;
  color: #333;
}

.testimonial-nav-arrow--left,
.testimonial-nav-arrow--right {
  cursor: pointer;
  user-select: none;
}

.testimonial-nav-tracks {
  display: flex;
  align-items: center;
  gap: 12px;
}

.testimonial-nav-track {
  width: 25px;
  height: 2px;
  background-color: #ddd;
  cursor: pointer;
  transition: width 0.3s;
}

.testimonial-nav-track.active {
  width: 40px;
  background-color: #c22e35;
}
{% endstyle %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  const cardContainer = document.getElementById('testimonialCards');
  const cards = document.querySelectorAll('.testimonial-card');
  const navTracks = document.querySelectorAll('.testimonial-nav-track');
  const navLeft = document.querySelector('.testimonial-nav-arrow--left');
  const navRight = document.querySelector('.testimonial-nav-arrow--right');
  
  if (!cardContainer || cards.length === 0) return;

  // 获取自动轮播间隔时间（从Shopify设置）
  const section = document.querySelector('.testimonial-carousel-section');
  const autoplayInterval = parseInt(section.dataset.autoplayInterval) || 5000;
  
  let currentIndex = 0; // 当前显示的第一个卡片的索引
  let autoplayTimer = null;
  let isAnimating = false;
  let isAutoplayActive = true;
  
  // 获取单个卡片的宽度（包括margin）
  function getCardWidth() {
    if (cards.length === 0) return 0;
    const card = cards[0];
    const style = window.getComputedStyle(card);
    const width = parseFloat(style.width);
    const marginLeft = parseFloat(style.marginLeft);
    const marginRight = parseFloat(style.marginRight);
    return width + marginLeft + marginRight;
  }
  
  // 获取当前视口中显示的卡片数量
  function getVisibleCardCount() {
    if (window.innerWidth >= 1200) return 3; // 桌面端显示3张
    if (window.innerWidth >= 768) return 2;  // 平板显示2张
    return 1;  // 手机显示1张
  }
  
  let visibleCards = getVisibleCardCount();
  
  // 计算最大可移动的索引（考虑显示数量）
  function getMaxIndex() {
    return Math.max(cards.length - visibleCards, 0);
  }
  
  // 计算指示器应该激活的索引
  function getActiveIndicatorIndex() {
    // 计算当前激活的指示器（基于当前显示的第一个卡片）
    const maxIndex = getMaxIndex();
    const totalIndicators = navTracks.length;
    
    // 如果有多个指示器且不是最后一个位置
    if (totalIndicators > 1 && maxIndex > 0) {
      // 线性映射当前卡片位置到指示器索引
      return Math.min(currentIndex, totalIndicators - 1);
    }
    return currentIndex;
  }
  
  // 启动自动轮播（单张移动）
  function startAutoplay() {
    if (autoplayTimer) clearInterval(autoplayTimer);
    
    autoplayTimer = setInterval(function() {
      if (!isAutoplayActive || isAnimating) return;
      
      const maxIndex = getMaxIndex();
      
      // 如果已经到达最后一个案例，停止自动轮播
      if (currentIndex >= maxIndex) {
        pauseAutoplay();
        return;
      }
      
      // 每次移动一个卡片
      currentIndex = currentIndex + 1;
      updateCarousel();
    }, autoplayInterval);
  }
  
  // 暂停自动轮播
  function pauseAutoplay() {
    if (autoplayTimer) {
      clearInterval(autoplayTimer);
      autoplayTimer = null;
    }
  }
  
  // 恢复自动轮播（离开卡片后）
  function resumeAutoplay() {
    if (isAutoplayActive && !autoplayTimer && currentIndex < getMaxIndex()) {
      startAutoplay();
    }
  }
  
  // 更新轮播位置
  function updateCarousel() {
    if (cards.length === 0) return;
    
    isAnimating = true;
    
    const cardWidth = getCardWidth();
    const translateX = -(currentIndex * cardWidth);
    
    cardContainer.style.transform = `translateX(${translateX}px)`;
    
    // 更新指示器状态
    updateIndicators();
    
    // 更新箭头状态
    updateArrows();
    
    // 动画结束后重置状态
    setTimeout(() => {
      isAnimating = false;
    }, 500);
  }
  
  // 更新指示器状态 - 修正：现在每个指示点一个一个变化
  function updateIndicators() {
    const activeIndex = getActiveIndicatorIndex();
    
    navTracks.forEach((track, idx) => {
      // 激活当前卡片对应的指示点
      const isActive = idx === activeIndex;
      track.classList.toggle('active', isActive);
    });
  }
  
  // 更新箭头状态
  function updateArrows() {
    const maxIndex = getMaxIndex();
    
    if (navLeft) {
      const isDisabled = currentIndex === 0;
      navLeft.style.opacity = isDisabled ? '0.5' : '1';
      navLeft.style.cursor = isDisabled ? 'not-allowed' : 'pointer';
    }
    
    if (navRight) {
      const isDisabled = currentIndex >= maxIndex;
      navRight.style.opacity = isDisabled ? '0.5' : '1';
      navRight.style.cursor = isDisabled ? 'not-allowed' : 'pointer';
    }
  }
  
  // 窗口调整事件处理
  let resizeTimeout;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(function() {
      visibleCards = getVisibleCardCount();
      // 确保当前索引有效
      const maxIndex = getMaxIndex();
      if (currentIndex > maxIndex) {
        currentIndex = maxIndex;
      }
      updateCarousel();
      // 重新启动自动轮播（如果还没到末尾）
      if (isAutoplayActive && currentIndex < maxIndex) {
        startAutoplay();
      }
    }, 150);
  });
  
  // 左箭头点击事件
  navLeft.addEventListener('click', function() {
    if (isAnimating || currentIndex === 0) return;
    
    // 点击时暂停自动轮播，3秒后恢复
    pauseAutoplay();
    setTimeout(resumeAutoplay, 3000);
    
    currentIndex = Math.max(currentIndex - 1, 0);
    updateCarousel();
  });
  
  // 右箭头点击事件
  navRight.addEventListener('click', function() {
    if (isAnimating) return;
    
    const maxIndex = getMaxIndex();
    if (currentIndex >= maxIndex) return;
    
    // 点击时暂停自动轮播，3秒后恢复
    pauseAutoplay();
    setTimeout(resumeAutoplay, 3000);
    
    currentIndex = Math.min(currentIndex + 1, maxIndex);
    updateCarousel();
  });
  
  // 指示器点击事件 - 现在每个指示点对应一个卡片位置
  navTracks.forEach((track, idx) => {
    track.addEventListener('click', function() {
      if (isAnimating) return;
      
      // 点击时暂停自动轮播，3秒后恢复
      pauseAutoplay();
      setTimeout(resumeAutoplay, 3000);
      
      const maxIndex = getMaxIndex();
      // 确保点击的索引不超过最大索引
      const targetIndex = Math.min(idx, maxIndex);
      
      currentIndex = targetIndex;
      updateCarousel();
    });
  });
  
  // 鼠标悬停暂停功能
  cardContainer.addEventListener('mouseenter', function() {
    pauseAutoplay();
  });
  
  cardContainer.addEventListener('mouseleave', function() {
    if (isAutoplayActive && currentIndex < getMaxIndex()) {
      startAutoplay();
    }
  });
  
  // 单个卡片悬停也暂停（增强体验）
  cards.forEach(card => {
    card.addEventListener('mouseenter', function() {
      pauseAutoplay();
    });
  });

  // 初始化
  updateCarousel();
  if (currentIndex < getMaxIndex()) {
    startAutoplay(); // 默认开始自动轮播，但如果是最后一个则不启动
  }
});
{% endjavascript %}