<div class="testimonial-carousel-section" data-autoplay-interval="{{ section.settings.autoplay_interval | default: 5000 }}">
  <div class="testimonial-carousel-container">
    <div class="testimonial-carousel-cards" id="testimonialCards">
      {% for block in section.blocks %}
        {% if block.settings.image != blank and block.settings.name != blank %}
          <div class="testimonial-card">
            <div class="testimonial-card__left">
              <div class="testimonial-card__header" style="background-color: #c22e35;">
                <h3 class="testimonial-card__name">{{ block.settings.name }}</h3>
                <p class="testimonial-card__role">{{ block.settings.role }}</p>
                <span class="testimonial-card__country">{{ block.settings.country }}</span>
              </div>
              
              <div class="testimonial-card__content-wrapper">
                <div class="testimonial-card__content">
                  <p class="testimonial-card__quote">{{ block.settings.quote }}</p>
                  {% if block.settings.button_link != blank %}
                    <a href="{{ block.settings.button_link }}" class="testimonial-card__button" target="{{ block.settings.button_target }}">
                      → {{ block.settings.button_text | default: "LEARN MORE" }}
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
            
            <div class="testimonial-card__right">
              <img src="{{ block.settings.image | image_url: width: 400, height: 400 }}" alt="{{ block.settings.name }}的案例" loading="lazy">
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="testimonial-carousel-controls">
      <div class="testimonial-carousel-nav" id="testimonialNav">
        <span class="testimonial-nav-arrow--left" aria-label="上一组案例">←</span>
        <div class="testimonial-nav-tracks">
          {% comment %} 计算精简指示器数量：每3个卡片对应1个指示点 {% endcomment %}
          {% assign total_cards = section.blocks.size %}
          {% assign indicator_count = total_cards | divided_by: 3.0 | ceil %}
          {% for i in (1..indicator_count) %}
            <span class="testimonial-nav-track" data-group-index="{{ forloop.index0 }}"></span>
          {% endfor %}
        </div>
        <span class="testimonial-nav-arrow--right" aria-label="下一组案例">→</span>
      </div>
      
      <div class="testimonial-carousel-auto-control">
        <button class="testimonial-auto-toggle" id="autoToggle" aria-label="切换自动轮播">
          <span class="auto-toggle-text">暂停自动轮播</span>
          <div class="auto-toggle-icon">
            <span class="icon-pause">❚❚</span>
            <span class="icon-play">▶</span>
          </div>
        </button>
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "客户案例轮播（自动+精简版）",
  "tag": "section",
  "class": "testimonial-carousel-section",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "自动轮播间隔时间（毫秒）",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "default": 5000,
      "info": "设置自动轮播切换的时间间隔，1000毫秒 = 1秒"
    }
  ],
  "blocks": [
    {
      "type": "testimonial_card",
      "name": "案例卡片",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "右侧图片"
        },
        {
          "type": "text",
          "id": "name",
          "label": "客户姓名",
          "default": "Camille Duret"
        },
        {
          "type": "text",
          "id": "role",
          "label": "客户职位/机构",
          "default": "Head Trainer, Studio Linea"
        },
        {
          "type": "text",
          "id": "country",
          "label": "国家/地区",
          "default": "France"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "案例评价",
          "default": "\"From the upholstery colors to the smooth glide—it's just beautiful to teach and shoot on. My audience often asks where I get my machines; I tell them—XS makes everything better.\""
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "按钮跳转链接"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "按钮文字",
          "default": "LEARN MORE"
        },
        {
          "type": "select",
          "id": "button_target",
          "label": "链接打开方式",
          "options": [
            { "value": "_self", "label": "当前窗口" },
            { "value": "_blank", "label": "新窗口" }
          ],
          "default": "_self"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "客户案例轮播（自动+精简版）",
      "settings": {
        "autoplay_interval": 5000
      }
    }
  ]
}
{% endschema %}

{% style %}
/* 全局盒模型重置 */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.testimonial-carousel-section {
  max-width: 1920px;
  margin: 20px auto;
  padding: 0;
  width: 100%;
}

.testimonial-carousel-container {
  overflow: hidden;
  width: 100%;
  padding: 0 10px;
}

.testimonial-carousel-cards {
  display: flex;
  transition: transform 0.5s ease;
  width: 100%;
  gap: 16px;
}

.testimonial-card {
  flex: 0 0 calc(33.333% - 11px);
  background: #c22e35;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  display: flex;
  height: auto;
  max-height: 370px;
  min-height: 370px;
  overflow: hidden;
  border-radius: 12px;
}

.testimonial-card__left {
  flex: 0 0 60%;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.testimonial-card__header {
  padding: 15px 20px;
  background-color: #c22e35;
  color: #ffffff;
  min-height: 139px;
}

.testimonial-card__name {
  font-size: 24px;
  font-weight: 400;
  margin: 0 0 8px;
  line-height: 1.2;
  color: white;
}

.testimonial-card__role {
  font-size: 13px;
  margin: 0 0 12px;
  line-height: 1.2;
  opacity: 0.9;
}

.testimonial-card__country {
  display: inline-block;
  padding: 4px 10px;
  background: rgba(255,255,255,0.3);
  color: #c22e35;
  font-size: 11px;
  font-weight: 600;
  border-radius: 4px;
}

.testimonial-card__content-wrapper {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
}

.testimonial-card__content {
  width: 90%;
  height: 90%;
  background-color: #ffffff;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-radius: 12px;
}

.testimonial-card__quote {
  font-size: 12px;
  line-height: 1.6;
  color: rgba(32,32,32,0.3);
  margin: 0 0 20px;
  flex: 1;
}

.testimonial-card__button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 15px;
  border: 1px solid #c22e35;
  background-color: #ffffff;
  color: #c22e35;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  transition: all 0.3s;
}

.testimonial-card__button:hover {
  background-color: #c22e35;
  color: #ffffff;
}

.testimonial-card__right {
  flex: 1;
  height: 100%;
  overflow: hidden;
}

.testimonial-card__right img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 控制区域样式 */
.testimonial-carousel-controls {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30px;
  padding: 0 10px;
}

.testimonial-carousel-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 14px;
  color: #333;
  margin-bottom: 15px;
}

.testimonial-nav-arrow--left,
.testimonial-nav-arrow--right {
  cursor: pointer;
  user-select: none;
  padding: 5px 10px;
  transition: opacity 0.3s;
}

.testimonial-nav-arrow--left:hover,
.testimonial-nav-arrow--right:hover {
  opacity: 0.7;
}

.testimonial-nav-tracks {
  display: flex;
  align-items: center;
  gap: 12px;
}

.testimonial-nav-track {
  width: 25px;
  height: 2px;
  background-color: #ddd;
  cursor: pointer;
  transition: all 0.3s;
}

.testimonial-nav-track.active {
  width: 40px;
  background-color: #c22e35;
}

/* 自动轮播控制按钮样式 */
.testimonial-carousel-auto-control {
  margin-top: 10px;
}

.testimonial-auto-toggle {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  background-color: #f5f5f5;
  border: 1px solid #ddd;
  border-radius: 20px;
  cursor: pointer;
  font-size: 14px;
  color: #333;
  transition: all 0.3s;
}

.testimonial-auto-toggle:hover {
  background-color: #e9e9e9;
  border-color: #c22e35;
}

.auto-toggle-icon {
  position: relative;
  width: 16px;
  height: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-pause,
.icon-play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 10px;
  transition: opacity 0.3s;
}

.icon-play {
  opacity: 0;
}

.testimonial-auto-toggle.paused .icon-pause {
  opacity: 0;
}

.testimonial-auto-toggle.paused .icon-play {
  opacity: 1;
}

.testimonial-auto-toggle.paused .auto-toggle-text {
  content: "开始自动轮播";
}

/* 响应式设计 */
@media (max-width: 1512px) {
  .testimonial-card {
    flex: 0 0 calc(33.333% - 10.67px);
  }
}

@media (max-width: 1440px) {
  .testimonial-carousel-container {
    padding: 0 15px;
  }
  
  .testimonial-card {
    flex: 0 0 calc(33.333% - 10px);
    max-height: 360px;
    min-height: 360px;
  }
  
  .testimonial-card__header {
    min-height: 130px;
    padding: 12px 18px;
  }
  
  .testimonial-card__name {
    font-size: 22px;
  }
}

@media (max-width: 1200px) {
  .testimonial-carousel-container {
    padding: 0 12px;
  }
  
  .testimonial-card {
    flex: 0 0 calc(50% - 8px);
  }
}

@media (max-width: 992px) {
  .testimonial-carousel-cards {
    gap: 12px;
  }
  
  .testimonial-card {
    flex: 0 0 calc(50% - 6px);
    max-height: 350px;
    min-height: 350px;
  }
}

@media (max-width: 768px) {
  .testimonial-card {
    flex: 0 0 100%;
    flex-direction: column;
    height: auto;
    max-height: none;
    min-height: auto;
  }
  
  .testimonial-card__right {
    height: 250px;
  }
  
  .testimonial-carousel-cards {
    gap: 20px;
  }
  
  .testimonial-carousel-controls {
    flex-direction: column;
  }
  
  .testimonial-auto-toggle {
    margin-top: 10px;
  }
}

@media (max-width: 480px) {
  .testimonial-carousel-container {
    padding: 0 8px;
  }
  
  .testimonial-carousel-cards {
    gap: 16px;
  }
  
  .testimonial-card__header {
    min-height: 120px;
    padding: 10px 15px;
  }
  
  .testimonial-card__name {
    font-size: 20px;
  }
}
{% endstyle %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  const cardContainer = document.getElementById('testimonialCards');
  const cards = document.querySelectorAll('.testimonial-card');
  const navTracks = document.querySelectorAll('.testimonial-nav-track');
  const navLeft = document.querySelector('.testimonial-nav-arrow--left');
  const navRight = document.querySelector('.testimonial-nav-arrow--right');
  const autoToggle = document.getElementById('autoToggle');
  const toggleText = document.querySelector('.auto-toggle-text');
  
  if (!cardContainer || cards.length === 0) return;

  // 从Shopify设置获取自动轮播间隔
  const section = document.querySelector('.testimonial-carousel-section');
  const autoplayInterval = parseInt(section.dataset.autoplayInterval) || 5000;
  
  let currentIndex = 0;
  let isAnimating = false;
  let autoplayTimer = null;
  let isAutoplayActive = true; // 默认开启自动轮播
  
  // 计算每屏显示的卡片数量（响应式）
  function getVisibleCardCount() {
    if (window.innerWidth >= 1200) return 3;
    if (window.innerWidth >= 768) return 2;
    return 1;
  }
  
  let visibleCards = getVisibleCardCount();
  
  // 计算总组数（用于精简指示器）
  function getTotalGroups() {
    return Math.ceil(cards.length / visibleCards);
  }
  
  // 获取当前所在的组索引（用于精简指示器高亮）
  function getCurrentGroupIndex() {
    return Math.floor(currentIndex / visibleCards);
  }
  
  // 获取卡片宽度（包括gap）
  function getCardWidth() {
    if (cards.length === 0) return 0;
    
    const card = cards[0];
    const containerStyle = window.getComputedStyle(cardContainer);
    const gap = parseFloat(containerStyle.gap) || 0;
    const cardStyle = window.getComputedStyle(card);
    const width = parseFloat(cardStyle.width);
    
    return width + gap;
  }
  
  // 启动自动轮播
  function startAutoplay() {
    if (autoplayTimer) clearInterval(autoplayTimer);
    
    autoplayTimer = setInterval(function() {
      if (!isAutoplayActive || isAnimating) return;
      
      const maxIndex = Math.max(cards.length - visibleCards, 0);
      const nextIndex = currentIndex + visibleCards;
      
      if (nextIndex > maxIndex) {
        // 如果已经是最后一组，回到第一组
        currentIndex = 0;
      } else {
        currentIndex = nextIndex;
      }
      
      updateCarousel();
    }, autoplayInterval);
    
    // 更新按钮状态
    if (autoToggle) {
      autoToggle.classList.remove('paused');
      toggleText.textContent = '暂停自动轮播';
    }
  }
  
  // 暂停自动轮播
  function pauseAutoplay() {
    if (autoplayTimer) {
      clearInterval(autoplayTimer);
      autoplayTimer = null;
    }
    
    if (autoToggle) {
      autoToggle.classList.add('paused');
      toggleText.textContent = '开始自动轮播';
    }
  }
  
  // 切换自动轮播状态
  function toggleAutoplay() {
    isAutoplayActive = !isAutoplayActive;
    
    if (isAutoplayActive) {
      startAutoplay();
    } else {
      pauseAutoplay();
    }
  }
  
  // 更新轮播位置
  function updateCarousel() {
    if (cards.length === 0) return;
    
    isAnimating = true;
    
    const cardWidth = getCardWidth();
    const translateX = -currentIndex * cardWidth;
    
    cardContainer.style.transform = `translateX(${translateX}px)`;
    cardContainer.style.transition = 'transform 0.5s ease';
    
    // 更新精简指示器状态
    const currentGroupIndex = getCurrentGroupIndex();
    navTracks.forEach((track, idx) => {
      track.classList.toggle('active', idx === currentGroupIndex);
    });

    // 更新箭头状态
    const maxIndex = Math.max(cards.length - visibleCards, 0);
    
    if (navLeft) {
      navLeft.style.opacity = currentIndex === 0 ? '0.5' : '1';
      navLeft.style.cursor = currentIndex === 0 ? 'not-allowed' : 'pointer';
    }
    
    if (navRight) {
      navRight.style.opacity = currentIndex >= maxIndex ? '0.5' : '1';
      navRight.style.cursor = currentIndex >= maxIndex ? 'not-allowed' : 'pointer';
    }
    
    // 动画结束后重置状态
    setTimeout(() => {
      isAnimating = false;
    }, 500);
  }
  
  // 事件监听器
  navLeft.addEventListener('click', function() {
    if (isAnimating || currentIndex === 0) return;
    
    // 用户交互时暂停自动轮播一小段时间
    pauseAutoplay();
    setTimeout(() => {
      if (isAutoplayActive) startAutoplay();
    }, 3000);
    
    currentIndex = Math.max(currentIndex - visibleCards, 0);
    updateCarousel();
  });

  navRight.addEventListener('click', function() {
    if (isAnimating) return;
    
    // 用户交互时暂停自动轮播一小段时间
    pauseAutoplay();
    setTimeout(() => {
      if (isAutoplayActive) startAutoplay();
    }, 3000);
    
    const maxIndex = Math.max(cards.length - visibleCards, 0);
    currentIndex = Math.min(currentIndex + visibleCards, maxIndex);
    updateCarousel();
  });

  // 精简指示器点击事件
  navTracks.forEach(track => {
    track.addEventListener('click', function() {
      if (isAnimating) return;
      
      // 用户交互时暂停自动轮播一小段时间
      pauseAutoplay();
      setTimeout(() => {
        if (isAutoplayActive) startAutoplay();
      }, 3000);
      
      const groupIndex = parseInt(this.dataset.groupIndex);
      currentIndex = groupIndex * visibleCards;
      
      // 确保不超过最大索引
      const maxIndex = Math.max(cards.length - visibleCards, 0);
      currentIndex = Math.min(currentIndex, maxIndex);
      
      updateCarousel();
    });
  });
  
  // 自动轮播切换按钮
  if (autoToggle) {
    autoToggle.addEventListener('click', toggleAutoplay);
  }
  
  // 窗口调整事件处理
  let resizeTimeout;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(function() {
      visibleCards = getVisibleCardCount();
      updateCarousel();
    }, 150);
  });
  
  // 鼠标悬停时暂停自动轮播
  cardContainer.addEventListener('mouseenter', function() {
    if (isAutoplayActive) {
      pauseAutoplay();
    }
  });
  
  cardContainer.addEventListener('mouseleave', function() {
    if (isAutoplayActive) {
      startAutoplay();
    }
  });
  
  // 初始化
  updateCarousel();
  startAutoplay(); // 默认开始自动轮播
  
  // 确保轮播容器宽度正确
  function updateContainerWidth() {
    const container = document.querySelector('.testimonial-carousel-container');
    if (container) {
      const section = document.querySelector('.testimonial-carousel-section');
      const sectionRect = section.getBoundingClientRect();
      container.style.width = `${sectionRect.width}px`;
    }
  }
  
  setTimeout(updateContainerWidth, 100);
  window.addEventListener('resize', updateContainerWidth);
});
{% endjavascript %}