<div class="testimonial-carousel-section" data-autoplay-interval="{{ section.settings.autoplay_interval | default: 5000 }}">
  <div class="testimonial-carousel-container">
    <div class="testimonial-carousel-cards" id="testimonialCards">
      {% for block in section.blocks %}
        {% if block.settings.image != blank and block.settings.name != blank %}
          <div class="testimonial-card">
            <div class="testimonial-card__left">
              <div class="testimonial-card__header" style="background-color: #c22e35;">
                <h3 class="testimonial-card__name">{{ block.settings.name }}</h3>
                <p class="testimonial-card__role">{{ block.settings.role }}</p>
                <span class="testimonial-card__country">{{ block.settings.country }}</span>
              </div>
              
              <div class="testimonial-card__content-wrapper">
                <div class="testimonial-card__content">
                  <p class="testimonial-card__quote">{{ block.settings.quote }}</p>
                  {% if block.settings.button_link != blank %}
                    <a href="{{ block.settings.button_link }}" class="testimonial-card__button" target="{{ block.settings.button_target }}">
                      → {{ block.settings.button_text | default: "LEARN MORE" }}
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
            
            <div class="testimonial-card__right">
              <img src="{{ block.settings.image | image_url: width: 400, height: 400 }}" alt="{{ block.settings.name }}的案例">
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="testimonial-carousel-nav" id="testimonialNav">
      <span class="testimonial-nav-arrow--left" aria-label="上一组案例">←</span>
      <div class="testimonial-nav-tracks">
        {% for block in section.blocks %}
          <span class="testimonial-nav-track" data-index="{{ forloop.index0 }}"></span>
        {% endfor %}
      </div>
      <span class="testimonial-nav-arrow--right" aria-label="下一组案例">→</span>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "客户案例轮播（自动轮播版）",
  "tag": "section",
  "class": "testimonial-carousel-section",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "自动轮播间隔时间（毫秒）",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "default": 5000,
      "info": "设置自动轮播切换的时间间隔，1000毫秒 = 1秒"
    }
  ],
  "blocks": [
    {
      "type": "testimonial_card",
      "name": "案例卡片",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "右侧图片"
        },
        {
          "type": "text",
          "id": "name",
          "label": "客户姓名",
          "default": "Camille Duret"
        },
        {
          "type": "text",
          "id": "role",
          "label": "客户职位/机构",
          "default": "Head Trainer, Studio Linea"
        },
        {
          "type": "text",
          "id": "country",
          "label": "国家/地区",
          "default": "France"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "案例评价",
          "default": "\"From the upholstery colors to the smooth glide—it's just beautiful to teach and shoot on. My audience often asks where I get my machines; I tell them—XS makes everything better.\""
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "按钮跳转链接"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "按钮文字",
          "default": "LEARN MORE"
        },
        {
          "type": "select",
          "id": "button_target",
          "label": "链接打开方式",
          "options": [
            { "value": "_self", "label": "当前窗口" },
            { "value": "_blank", "label": "新窗口" }
          ],
          "default": "_self"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "客户案例轮播（自动轮播版）",
      "settings": {
        "autoplay_interval": 5000
      }
    }
  ]
}
{% endschema %}

{% style %}
/* 全局盒模型重置，避免宽度计算错误 */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.testimonial-carousel-section {
  max-width: 1920px;
  margin: 20px auto;
  padding: 0 10px;
  width: 100%; /* 强制占满可用宽度 */
}

.testimonial-carousel-container {
  overflow: hidden;
  width: 100%; /* 确保容器宽度100% */
}

/* 核心修改：用padding代替gap，避免flex gap溢出 */
.testimonial-carousel-cards {
  display: flex;
  transition: transform 0.5s ease;
  width: 100%;
}

/* 适配Mac全分辨率：3张卡片精准分配宽度，无溢出 */
.testimonial-card {
  flex: 0 0 calc(33.333% - 16px); /* 调整间距计算，适配Mac */
  margin: 0 8px; /* 用margin代替gap，避免溢出 */
  background: #c22e35;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  display: flex;
  height: auto;
  max-height: 370px;
  overflow: hidden;
  border-radius: 12px;
  cursor: pointer; /* 添加鼠标指针样式 */
  /* 移除min-width强制限制，避免窄屏溢出 */
}

.testimonial-card__left {
  flex: 0 0 60%;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.testimonial-card__header {
  padding: 15px 20px;
  background-color: #c22e35;
  color: #ffffff;
  min-height: 139px;
}

.testimonial-card__name {
  font-size: 24px;
  font-weight: 400;
  margin: 0 0 8px;
  line-height: 1.2;
  color: white;
}

.testimonial-card__role {
  font-size: 13px;
  margin: 0 0 12px;
  line-height: 1.2;
  opacity: 0.9;
}

.testimonial-card__country {
  display: inline-block;
  padding: 4px 10px;
  background: rgba(255,255,255,0.3);
  color: #c22e35;
  font-size: 11px;
  font-weight: 600;
  border-radius: 4px;
}

.testimonial-card__content-wrapper {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
}

.testimonial-card__content {
  width: 90%;
  height: 90%;
  background-color: #ffffff;
  padding: 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-radius: 12px;
}

.testimonial-card__quote {
  font-size: 12px;
  line-height: 1.6;
  color: rgba(32,32,32,0.7);
  margin: 0 0 20px;
  flex: 1;
}

.testimonial-card__button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 15px;
  border: 1px solid #c22e35;
  background-color: #ffffff;
  color: #c22e35;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  transition: all 0.3s;
}

.testimonial-card__button:hover {
  background-color: #c22e35;
  color: #ffffff;
}

.testimonial-card__right {
  flex: 1;
  height: 100%;
  overflow: hidden;
}

.testimonial-card__right img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Mac窄屏适配（1200-1440px） */
@media (max-width: 1440px) and (min-width: 1200px) {
  .testimonial-card {
    flex: 0 0 calc(33.333% - 14px); /* 微调间距，适配1440px Mac */
    margin: 0 7px;
  }
}

/* 平板适配 */
@media (max-width: 1200px) {
  .testimonial-card {
    flex: 0 0 calc(50% - 10px);
    margin: 0 5px;
  }
}

/* 手机适配 */
@media (max-width: 768px) {
  .testimonial-card {
    flex: 0 0 100%;
    margin: 0;
    flex-direction: column;
    height: auto;
    max-height: none; /* 移除最大高度限制 */
  }
  .testimonial-card__right {
    height: 250px;
  }
}

/* 指示器样式 */
.testimonial-carousel-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 30px;
  font-size: 14px;
  color: #333;
}

.testimonial-nav-arrow--left,
.testimonial-nav-arrow--right {
  cursor: pointer;
  user-select: none;
}

.testimonial-nav-tracks {
  display: flex;
  align-items: center;
  gap: 12px;
}

.testimonial-nav-track {
  width: 25px;
  height: 2px;
  background-color: #ddd;
  cursor: pointer;
  transition: width 0.3s;
}

.testimonial-nav-track.active {
  width: 40px;
  background-color: #c22e35;
}
{% endstyle %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  const cardContainer = document.getElementById('testimonialCards');
  const cards = document.querySelectorAll('.testimonial-card');
  const navTracks = document.querySelectorAll('.testimonial-nav-track');
  const navLeft = document.querySelector('.testimonial-nav-arrow--left');
  const navRight = document.querySelector('.testimonial-nav-arrow--right');
  
  if (!cardContainer || cards.length === 0) return;

  // 获取自动轮播间隔时间（从Shopify设置）
  const section = document.querySelector('.testimonial-carousel-section');
  const autoplayInterval = parseInt(section.dataset.autoplayInterval) || 5000;
  
  let currentIndex = 0;
  let autoplayTimer = null;
  let isAnimating = false;
  let isAutoplayActive = true;
  
  function getVisibleCardCount() {
    if (window.innerWidth >= 1200) return 3; // Mac端固定3张
    if (window.innerWidth >= 768) return 2;
    return 1;
  }
  let visibleCards = getVisibleCardCount();

  // 修复：Mac端宽度计算错误导致的偏移问题
  function getCardWidth() {
    // 取第一个卡片的实际宽度（包含margin）
    const card = cards[0];
    const style = window.getComputedStyle(card);
    const width = parseFloat(style.width);
    const marginLeft = parseFloat(style.marginLeft);
    const marginRight = parseFloat(style.marginRight);
    return width + marginLeft + marginRight; // 总宽度=卡片宽+左右margin
  }

  // 启动自动轮播
  function startAutoplay() {
    if (autoplayTimer) clearInterval(autoplayTimer);
    
    autoplayTimer = setInterval(function() {
      if (!isAutoplayActive || isAnimating) return;
      
      const maxIndex = cards.length - visibleCards;
      const nextIndex = currentIndex + visibleCards;
      
      if (nextIndex > maxIndex) {
        // 如果已经是最后一组，回到第一组
        currentIndex = 0;
      } else {
        currentIndex = nextIndex;
      }
      
      updateCarousel();
    }, autoplayInterval);
  }
  
  // 暂停自动轮播
  function pauseAutoplay() {
    if (autoplayTimer) {
      clearInterval(autoplayTimer);
      autoplayTimer = null;
    }
  }
  
  // 恢复自动轮播（离开卡片后）
  function resumeAutoplay() {
    if (isAutoplayActive && !autoplayTimer) {
      startAutoplay();
    }
  }

  window.addEventListener('resize', function() {
    visibleCards = getVisibleCardCount();
    updateCarousel();
  });

  navLeft.addEventListener('click', function() {
    // 点击时短暂暂停自动轮播，3秒后恢复
    pauseAutoplay();
    setTimeout(resumeAutoplay, 3000);
    
    currentIndex = Math.max(currentIndex - visibleCards, 0);
    updateCarousel();
  });

  navRight.addEventListener('click', function() {
    // 点击时短暂暂停自动轮播，3秒后恢复
    pauseAutoplay();
    setTimeout(resumeAutoplay, 3000);
    
    const maxIndex = cards.length - visibleCards;
    currentIndex = Math.min(currentIndex + visibleCards, maxIndex);
    updateCarousel();
  });

  navTracks.forEach(track => {
    track.addEventListener('click', function() {
      // 点击时短暂暂停自动轮播，3秒后恢复
      pauseAutoplay();
      setTimeout(resumeAutoplay, 3000);
      
      const index = parseInt(this.dataset.index);
      currentIndex = Math.floor(index / visibleCards) * visibleCards;
      const maxIndex = cards.length - visibleCards;
      currentIndex = Math.min(currentIndex, maxIndex);
      updateCarousel();
    });
  });

  function updateCarousel() {
    // 核心修复：用实际卡片宽度计算偏移，避免Mac端错位
    const cardWidth = getCardWidth();
    cardContainer.style.transform = `translateX(-${currentIndex * cardWidth}px)`;
    
    navTracks.forEach((track, idx) => {
      track.classList.toggle('active', idx >= currentIndex && idx < currentIndex + visibleCards);
    });

    // 禁用/启用箭头
    navLeft.style.opacity = currentIndex === 0 ? '0.5' : '1';
    navLeft.style.cursor = currentIndex === 0 ? 'not-allowed' : 'pointer';
    const maxIndex = cards.length - visibleCards;
    navRight.style.opacity = currentIndex === maxIndex ? '0.5' : '1';
    navRight.style.cursor = currentIndex === maxIndex ? 'not-allowed' : 'pointer';
    
    // 标记动画开始
    isAnimating = true;
    setTimeout(() => {
      isAnimating = false;
    }, 500);
  }

  // 鼠标悬停暂停功能
  cardContainer.addEventListener('mouseenter', function() {
    pauseAutoplay();
  });
  
  cardContainer.addEventListener('mouseleave', function() {
    if (isAutoplayActive) {
      startAutoplay();
    }
  });
  
  // 单个卡片悬停也暂停（增强体验）
  cards.forEach(card => {
    card.addEventListener('mouseenter', function() {
      pauseAutoplay();
    });
    
    card.addEventListener('mouseleave', function() {
      // 检查鼠标是否还在整个轮播区域内
      const containerRect = cardContainer.getBoundingClientRect();
      const event = new MouseEvent('mouseleave');
      if (!isMouseInContainer(event, containerRect) && isAutoplayActive) {
        startAutoplay();
      }
    });
  });
  
  // 辅助函数：检查鼠标是否在容器内
  function isMouseInContainer(event, containerRect) {
    return (
      event.clientX >= containerRect.left &&
      event.clientX <= containerRect.right &&
      event.clientY >= containerRect.top &&
      event.clientY <= containerRect.bottom
    );
  }

  // 初始化
  updateCarousel();
  startAutoplay(); // 默认开始自动轮播
});
{% endjavascript %}