<div class="blog-list-container page-width">
  {% if section.settings.title != blank %}
    <h2 class="section-title">{{ section.settings.title }}</h2>
  {% endif %}
  <div class="blog-grid">
    {% if section.settings.use_default_blog %}
      {% for article in blog.articles %}
        <a href="{{ article.url }}" class="blog-item">
          {% if article.image %}
            <div class="blog-image">
              <img src="{{ article.image | img_url: '600x' }}" 
                   alt="{{ article.image.alt | escape }}"
                   width="600"
                   height="400"
                   loading="lazy"
                   style="object-fit: cover;">
            </div>
          {% endif %}
          
          <div class="blog-content">
            <h3 class="blog-title">{{ article.title }}</h3>
            
            <div class="blog-meta">
              <div class="meta-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3 9H21M7 3V5M17 3V5M6 13H8M11 13H13M16 13H18M6 17H8M11 17H13M16 17H18M6.2 21H17.8C18.9201 21 19.4802 21 19.908 20.782C20.2843 20.5903 20.5903 20.2843 20.782 19.908C21 19.4802 21 18.9201 21 17.8V8.2C21 7.0799 21 6.51984 20.782 6.09202C20.5903 5.71569 20.2843 5.40973 19.908 5.21799C19.4802 5 18.9201 5 17.8 5H6.2C5.0799 5 4.51984 5 4.09202 5.21799C3.71569 5.40973 3.40973 5.71569 3.21799 6.09202C3 6.51984 3 7.07989 3 8.2V17.8C3 18.9201 3 19.4802 3.21799 19.908C3.40973 20.2843 3.71569 20.5903 4.09202 20.782C4.51984 21 5.07989 21 6.2 21Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{{ article.published_at | date: "%Y-%m-%d" }}</span>
              </div>
            </div>
          </div>
        </a>
      {% endfor %}
    {% else %}
      {% for block in section.blocks %}
        {%- assign linked_article = block.settings.article -%}
        {%- assign fallback_link = block.settings.custom_link -%}
        {%- assign final_title = block.settings.title -%}
        {%- assign final_image = block.settings.image -%}

        {%- if linked_article != blank -%}
          {%- assign final_url = linked_article.url -%}
          {%- unless block.settings.title_override -%}
            {%- assign final_title = linked_article.title -%}
          {%- endunless -%}
          {%- if linked_article.image != blank -%}
            {%- assign final_image = linked_article.image -%}
          {%- endif -%}
        {%- else -%}
          {%- assign final_url = fallback_link | default: '#' -%}
        {%- endif -%}

        <a href="{{ final_url }}" class="blog-item" {{ block.shopify_attributes }}>
          {% if final_image != blank %}
            <div class="blog-image">
              <img src="{{ final_image | img_url: '600x' }}" 
                   alt="{{ final_image.alt | escape }}"
                   width="600"
                   height="400"
                   loading="lazy"
                   style="object-fit: cover;">
            </div>
          {% endif %}
          
          <div class="blog-content">
            <h3 class="blog-title">{{ final_title }}</h3>
            
            <div class="blog-meta">
              <div class="meta-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3 9H21M7 3V5M17 3V5M6 13H8M11 13H13M16 13H18M6 17H8M11 17H13M16 17H18M6.2 21H17.8C18.9201 21 19.4802 21 19.908 20.782C20.2843 20.5903 20.5903 20.2843 20.782 19.908C21 19.4802 21 18.9201 21 17.8V8.2C21 7.0799 21 6.51984 20.782 6.09202C20.5903 5.71569 20.2843 5.40973 19.908 5.21799C19.4802 5 18.9201 5 17.8 5H6.2C5.0799 5 4.51984 5 4.09202 5.21799C3.71569 5.40973 3.40973 5.71569 3.21799 6.09202C3 6.51984 3 7.07989 3 8.2V17.8C3 18.9201 3 19.4802 3.21799 19.908C3.40973 20.2843 3.71569 20.5903 4.09202 20.782C4.51984 21 5.07989 21 6.2 21Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>
                  {% if linked_article != blank %}
                    {{ linked_article.published_at | date: "%Y-%m-%d" }}
                  {% else %}
                    {{ block.settings.date }}
                  {% endif %}
                </span>
              </div>

              {% if block.settings.show_time %}
                {% if linked_article == blank %}
                <div class="meta-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 8V12L15 15M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span>{{ block.settings.time }}</span>
                </div>
                {% endif %}
              {% endif %}
            </div>
          </div>
        </a>
      {% endfor %}
    {% endif %}
  </div>
</div>

<style>
  .blog-list-container {
    padding: 40px 0;
  }
  .section-title {
    text-align: center;
    margin-bottom: 30px;
    font-size: 28px;
    font-weight: 700;
    color: #333;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }
  .blog-item {
    display: flex;
    flex-direction: column;
    gap: 15px;
    text-decoration: none;
    color: inherit;
  }
  .blog-image {
    width: 100%;
    height: 0;
    padding-bottom: 100%; /* 正方形 */
    overflow: hidden;
    border-radius: 8px;
    perspective: 1000px;
    transform-style: preserve-3d;
    position: relative;
  }
  .blog-image img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: all 0.5s cubic-bezier(0.25, 0.45, 0.45, 0.95);
    transform-origin: center center;
    backface-visibility: hidden;
  }
  .blog-item:hover .blog-image img {
    transform: scale(1.1) rotateY(5deg) rotateX(5deg);
    box-shadow: 0 10px 20px rgba(0,0,0,0.1);
  }
  .blog-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .blog-title {
    margin: 0;
    font-weight: 700;
    font-size: 18px;
    line-height: 1.4;
  }
  .blog-meta {
    display: flex;
    gap: 20px;
    color: #666;
    font-size: 14px;
  }
  .meta-item {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  @media (max-width: 1200px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (max-width: 900px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "博客网格列表",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "区块标题",
      "default": "最新博客文章"
    },
    {
      "type": "checkbox",
      "id": "use_default_blog",
      "label": "使用默认博客列表",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "blog_item",
      "name": "博客项",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "自定义图片（可选）"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题",
          "default": "博客标题"
        },
        {
          "type": "checkbox",
          "id": "title_override",
          "label": "启用标题覆盖",
          "info": "关闭则自动使用文章标题",
          "default": true
        },
        {
          "type": "article",
          "id": "article",
          "label": "关联博客文章",
          "info": "选择一篇文章，将自动填充链接、图片和日期"
        },
        {
          "type": "url",
          "id": "custom_link",
          "label": "备用链接",
          "info": "如果未选择文章，则使用此链接"
        },
        {
          "type": "text",
          "id": "date",
          "label": "自定义日期",
          "info": "仅在未选择文章时生效",
          "default": "2025-04-05"
        },
        {
          "type": "text",
          "id": "time",
          "label": "阅读时间或补充信息",
          "default": "5 min read"
        },
        {
          "type": "checkbox",
          "id": "show_time",
          "label": "显示时间信息",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "博客网格列表",
      "category": "内容",
      "blocks": [
        { "type": "blog_item" },
        { "type": "blog_item" },
        { "type": "blog_item" },
        { "type": "blog_item" }
      ]
    }
  ]
}
{% endschema %}
