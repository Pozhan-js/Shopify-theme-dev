{% comment %}
  工业制造模块 - Liquid 模板
  支持后台可编辑的完整模块，支持视频背景
{% endcomment %}

{% assign bg_video = section.settings.background_video %}
{% assign bg_image = section.settings.background_image %}
{% unless bg_image %}
  {% assign bg_image = 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?ixlib=rb-4.0.3&auto=format&fit=crop&w=2070&q=80' %}
{% endunless %}

{% assign main_title = section.settings.main_title | default: 'WHERE TRUST IS MANUFACTURED' %}
{% assign description = section.settings.description
  | default: "We don't outsource trust-we produce it, in a 180,000m² facility optimized for precision, scale, and speed."
%}
{% assign icon = section.settings.icon | default: '⚙️' %}
{% assign description_image = section.settings.description_image %}

<style>
  @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');

  .industrial-manufacturing-section-{{ section.id }} {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    font-family: 'Poppins', sans-serif;
  }

  .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-video-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-background-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border-radius: 16px;
    z-index: -1;
  }

  .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-background-overlay.has-image {
    {% if bg_image contains 'http' %}
      background-image: url('{{ bg_image }}');
    {% else %}
      background-image: url('{{ bg_image | img_url: '2048x' }}');
    {% endif %}
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-background-overlay::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.2) 100%);
    z-index: 1;
  }

  .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-container {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    z-index: 2;
  }

  .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-content-wrapper {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 100%;
    padding-right: 60px;
    position: absolute;
    top: 60%;
    right: 0;
    transform: translateY(-50%);
    width: auto;
    max-width: 500px;
  }

  .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-text-content {
    color: white;
    text-align: left;
  }

  .industrial-manufacturing-section-{{ section.id }} .-industrial-manufacturing-main-title-copy {
    font-family: 'Poppins', sans-serif;
    font-size: 30px;
    font-weight: 500;
    line-height: 60px;
    color: #FFF;
    margin: 0 0 60px;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    max-width: 500px;
  }

  .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }

  .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-icon {
    font-size: 2.5rem;
    margin-top: 5px;
    filter: drop-shadow(2px 2px 4px rgba(0, 0, 0, 0.5));
  }

  .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-description-image {
    object-fit: cover;
    border-radius: 8px;
    margin-top: 5px;
  }

  .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-text-block {
    flex: 1;
    text-align: right;
  }

  .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-description {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
    color: #ffffff;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
    margin: 0;
  }

  /* 响应式设计 */
  @media (max-width: 768px) {
    .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-content-wrapper {
      justify-content: center;
      align-items: center;
      padding-right: 20px;
      padding-bottom: 40px;
      text-align: center;
      width: 100%;
      max-width: 100%;
    }

    .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-main-title-copy {
      font-size: 22px;
      line-height: 40px;
      margin-bottom: 40px;
      max-width: 100%;
      text-align: center;
    }

    .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-feature-item {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-text-block {
      max-width: 100%;
      text-align: center;
    }

    .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-description-image {
      width: 50px;
      height: 50px;
    }
  }

  @media (max-width: 480px) {
    .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-content-wrapper {
      padding-bottom: 30px;
      width: 100%;
      max-width: 100%;
    }

    .industrial-manufacturing-section-{{ section.id }} .-industrial-manufacturing-main-title-copy {
      font-size: 16px;
      line-height: 32px;
    }

    .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-description {
      font-size: 14px;
    }

    .industrial-manufacturing-section-{{ section.id }} .industrial-manufacturing-description-image {
      width: 40px;
      height: 40px;
    }
  }
</style>

<section class="industrial-manufacturing-section-{{ section.id }}">
  {% if bg_video != blank %}
    <video
      class="industrial-manufacturing-video-background"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    >
      <source src="{{ bg_video.sources[1].url }}" type="video/mp4">
    </video>
  {% endif %}

  <div class="industrial-manufacturing-background-overlay {% if bg_video == blank %}has-image{% endif %}">
    <div class="industrial-manufacturing-container">
      <div class="industrial-manufacturing-content-wrapper">
        <div class="industrial-manufacturing-text-content">
          {% if main_title != blank %}
            <h2 class="industrial-manufacturing-main-title-copy">{{ main_title }}</h2>
          {% endif %}

          <div class="industrial-manufacturing-feature-item">
            {% if description_image %}
              <img
                src="{{ description_image | img_url: '120x120' }}"
                alt="描述图片"
                class="industrial-manufacturing-description-image"
              >
            {% elsif icon != blank %}
              <div class="industrial-manufacturing-icon">{{ icon }}</div>
            {% endif %}

            <div class="industrial-manufacturing-text-block">
              {% if description != blank %}
                <p class="industrial-manufacturing-description">{{ description }}</p>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "最后一个",
  "tag": "section",
  "class": "industrial-manufacturing-section",
  "settings": [
    {
      "type": "video",
      "id": "background_video",
      "label": "背景视频",
      "info": "上传 MP4 视频作为背景。视频将自动播放、循环且静音。"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "背景图片（备用）",
      "info": "推荐尺寸: 1920x1080px。当没有视频时显示。"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "主标题",
      "default": "WHERE TRUST IS MANUFACTURED",
      "placeholder": "输入主标题文本"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "描述文本",
      "default": "We don't outsource trust-we produce it, in a 180,000m² facility optimized for precision, scale, and speed.",
      "placeholder": "输入描述文本"
    },
    {
      "type": "image_picker",
      "id": "description_image",
      "label": "描述图片",
      "info": "显示在描述文字左侧的图片，推荐尺寸: 120x120px"
    },
    {
      "type": "text",
      "id": "icon",
      "label": "图标",
      "default": "⚙️",
      "info": "可以使用 Emoji 或字符（当没有上传描述图片时显示）"
    }
  ],
  "presets": [
    {
      "name": "最后一个",
      "settings": {
        "main_title": "WHERE TRUST IS MANUFACTURED",
        "description": "We don't outsource trust-we produce it, in a 180,000m² facility optimized for precision, scale, and speed.",
        "icon": "⚙️"
      }
    }
  ]
}
{% endschema %}
