{% schema %}
{
  "name": "Store Gallery",
  "settings": [
    {
      "type": "text",
      "id": "store_name",
      "label": "Store Name",
      "default": "TRÈS BIEN"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_1",
      "label": "Gallery Image 1"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_2",
      "label": "Gallery Image 2"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_3",
      "label": "Gallery Image 3"
    },
    {
      "type": "image_picker",
      "id": "gallery_image_4",
      "label": "Gallery Image 4"
    }
  ],
  "presets": [
    {
      "name": "Store Gallery"
    }
  ]
}
{% endschema %}

<style>
  .store-gallery {
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0;
  }

  .hero-section {
    position: relative;
    width: 100%;
    height: 600px;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .store-name-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 72px;
    font-weight: 300;
    color: #ffffff;
    letter-spacing: 12px;
    text-transform: uppercase;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    font-family: 'Helvetica Neue', Arial, sans-serif;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    padding: 0;
  }

  .gallery-item {
    position: relative;
    width: 100%;
    aspect-ratio: 3/4;
    overflow: hidden;
    background: #f5f5f5;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  @media (max-width: 1024px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }

    .hero-section {
      height: 450px;
    }

    .store-name-overlay {
      font-size: 48px;
      letter-spacing: 8px;
    }
  }

  @media (max-width: 640px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .hero-section {
      height: 350px;
    }

    .store-name-overlay {
      font-size: 36px;
      letter-spacing: 6px;
    }
  }
</style>

<div class="store-gallery">
  <!-- Hero Section -->
  <div class="hero-section">
    {% if section.settings.hero_image %}
      <img 
        src="{{ section.settings.hero_image | img_url: '1400x' }}" 
        alt="{{ section.settings.store_name }}"
        class="hero-image"
        loading="eager"
      >
    {% else %}
      <img 
        src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=1400&h=600&fit=crop" 
        alt="Store Front"
        class="hero-image"
        loading="eager"
      >
    {% endif %}
    <div class="store-name-overlay">
      {{ section.settings.store_name }}
    </div>
  </div>

  <!-- Gallery Grid -->
  <div class="gallery-grid">
    <div class="gallery-item">
      {% if section.settings.gallery_image_1 %}
        <img 
          src="{{ section.settings.gallery_image_1 | img_url: '600x' }}" 
          alt="Store Interior 1"
          loading="lazy"
        >
      {% else %}
        <img 
          src="https://images.unsplash.com/photo-1595246140625-573b715d11dc?w=600&h=800&fit=crop" 
          alt="Store Interior 1"
          loading="lazy"
        >
      {% endif %}
    </div>

    <div class="gallery-item">
      {% if section.settings.gallery_image_2 %}
        <img 
          src="{{ section.settings.gallery_image_2 | img_url: '600x' }}" 
          alt="Store Interior 2"
          loading="lazy"
        >
      {% else %}
        <img 
          src="https://images.unsplash.com/photo-1558769132-cb1aea3c8565?w=600&h=800&fit=crop" 
          alt="Store Interior 2"
          loading="lazy"
        >
      {% endif %}
    </div>

    <div class="gallery-item">
      {% if section.settings.gallery_image_3 %}
        <img 
          src="{{ section.settings.gallery_image_3 | img_url: '600x' }}" 
          alt="Store Interior 3"
          loading="lazy"
        >
      {% else %}
        <img 
          src="https://images.unsplash.com/photo-1567401893414-76b7b1e5a7a5?w=600&h=800&fit=crop" 
          alt="Store Interior 3"
          loading="lazy"
        >
      {% endif %}
    </div>

    <div class="gallery-item">
      {% if section.settings.gallery_image_4 %}
        <img 
          src="{{ section.settings.gallery_image_4 | img_url: '600x' }}" 
          alt="Store Interior 4"
          loading="lazy"
        >
      {% else %}
        <img 
          src="https://images.unsplash.com/photo-1469334031218-e382a71b716b?w=600&h=800&fit=crop" 
          alt="Store Interior 4"
          loading="lazy"
        >
      {% endif %}
    </div>
  </div>
</div>
