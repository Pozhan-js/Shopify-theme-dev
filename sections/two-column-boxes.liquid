<!-- sections/two-column-boxes.liquid -->
<div class="two-column-boxes-section">
  <div class="container">
    <div class="boxes-wrapper">
      {% for block in section.blocks %}
        <div class="box-item" {{ block.shopify_attributes }}>
          <div class="box-content">
            <!-- Icon -->
            {% if block.settings.icon != 'none' or block.settings.image_upload != blank %}
              <div class="icon-wrapper">
                {% render 'icon-or-image',
                  icon: block.settings.icon,
                  image_upload: block.settings.image_upload,
                  width: block.settings.icon_width,
                  class_name: 'box-icon'
                %}
              </div>
            {% endif %}

            <!-- Title -->
            {% if block.settings.title != blank %}
              <div class="box-title">{{ block.settings.title }}</div>
            {% endif %}

            <!-- Text Content -->
            {% if block.settings.text_content != blank %}
              <p class="box-text">{{ block.settings.text_content }}</p>
            {% endif %}

            <!-- Button -->
            {% if block.settings.button_text != blank %}
              <a href="{{ block.settings.button_link | default: '#' }}" class="box-button">
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .two-column-boxes-section {
    padding: 60px 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .boxes-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 30px;
  }

  .box-item {
    border: 1px solid #000;
    background: transparent;
    padding: 40px 30px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .box-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
  }

  .box-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 60px;
  }

  .icon-wrapper .box-icon {
    fill: currentColor;
    color: #000;
  }

  .box-title {
    font-size: 24px;
    font-weight: bold;
    margin: 0;
    color: #000;
  }

  .box-text {
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
    color: #666;
  }

  .box-button {
    display: inline-block;
    padding: 12px 24px;
    background: #000;
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 500;
    transition: all 0.3s ease;
  }

  .box-button:hover {
    background: #333;
    transform: translateY(-2px);
  }

  /* 响应式设计 */
  @media (max-width: 768px) {
    .boxes-wrapper {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .box-item {
      padding: 30px 20px;
    }

    .box-title {
      font-size: 20px;
    }

    .box-text {
      font-size: 14px;
    }
  }
</style>

