{% schema %}
{
  "name": "Wood Types",
  "tag": "section",
  "class": "wood-types-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Customize Your Pilates Equipment Frame – Wood Types"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Choose the look and performance that fits your brand and studio aesthetic."
    },
    {
      "type": "header",
      "content": "Maple Wood Settings"
    },
    {
      "type": "text",
      "id": "maple_title",
      "label": "Maple Wood Title",
      "default": "Maple Wood Bed Frame"
    },
    {
      "type": "image_picker",
      "id": "maple_image",
      "label": "Maple Wood Image"
    },
    {
      "type": "header",
      "content": "Walnut Wood Settings"
    },
    {
      "type": "text",
      "id": "walnut_title",
      "label": "Walnut Wood Title",
      "default": "Walnut Wood Bed Frame"
    },
    {
      "type": "image_picker",
      "id": "walnut_image",
      "label": "Walnut Wood Image"
    }
  ],
  "presets": [
    {
      "name": "Wood Types",
      "settings": {
        "title": "Customize Your Pilates Equipment Frame – Wood Types",
        "subtitle": "Choose the look and performance that fits your brand and studio aesthetic.",
        "maple_title": "Maple Wood Bed Frame",
        "walnut_title": "Walnut Wood Bed Frame"
      }
    }
  ]
}
{% endschema %}
