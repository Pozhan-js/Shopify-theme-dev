<!-- FAQ Section - 面包甜点店铺常见问题 -->
<div class="faq-section-container">
    <div class="faq-wrapper">
        <h2 class="section-title">{{ section.settings.title | default: 'Baking Knowledge Q&A' }}</h2>
        
        <div class="faq-list">
            <!-- 面粉相关 -->
            <div class="faq-group">
                <h3 class="group-title">面粉与筋度</h3>
                <div class="faq-items">
                    <div class="faq-item">
                        <details class="faq-details">
                            <summary class="faq-question">
                                <span>{{ section.settings.flour_q1 | default: '问题001：如果家里没有需要筋度的面粉，如何自己配置？' }}</span>
                                <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                                    <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2"/>
                                </svg>
                            </summary>
                            <div class="faq-answer">
                                <p>{{ section.settings.flour_a1 | newline_to_br }}</p>
                            </div>
                        </details>
                    </div>
                    
                    <div class="faq-item">
                        <details class="faq-details">
                            <summary class="faq-question">
                                <span>{{ section.settings.flour_q2 | default: '问题034：面粉的分类主要有哪些？' }}</span>
                                <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                                    <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2"/>
                                </svg>
                            </summary>
                            <div class="faq-answer">
                                <p>{{ section.settings.flour_a2 | newline_to_br }}</p>
                            </div>
                        </details>
                    </div>
                    
                    <div class="faq-item">
                        <details class="faq-details">
                            <summary class="faq-question">
                                <span>{{ section.settings.flour_q3 | default: '问题035：什么是低筋面粉？' }}</span>
                                <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                                    <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2"/>
                                </svg>
                            </summary>
                            <div class="faq-answer">
                                <p>{{ section.settings.flour_a3 | default: '低筋面粉也叫薄力粉。主要做各式蛋糕、小西点之类会用到。它的蛋白质含量为6.5%~8.5%。颜色纯白，易揉捏成团，易成型。' }}</p>
                            </div>
                        </details>
                    </div>
                    
                    <div class="faq-item">
                        <details class="faq-details">
                            <summary class="faq-question">
                                <span>{{ section.settings.flour_q4 | default: '问题036：什么是中筋面粉？' }}</span>
                                <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                                    <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2"/>
                                </svg>
                            </summary>
                            <div class="faq-answer">
                                <p>{{ section.settings.flour_a4 | default: '中筋面粉就是我们说的普通面粉。蛋白质含量在8.0%~10.5%。适合做馒头、包子、饺子、烙饼等中式面点，它的颜色乳白，半松散，筋度及黏度均衡。' }}</p>
                            </div>
                        </details>
                    </div>
                    
                    <div class="faq-item">
                        <details class="faq-details">
                            <summary class="faq-question">
                                <span>{{ section.settings.flour_q5 | default: '问题037：什么是高筋面粉？' }}</span>
                                <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none">
                                    <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2"/>
                                </svg>
                            </summary>
                            <div class="faq-answer">
                                <p>{{ section.settings.flour_a5 | default: '蛋白质含量在11.5%~14.5%。筋度强，粘性大，适合做面包、面条等。它的颜色比较深，手感光滑。用手抓起一把高筋粉，用拳头攥紧然后松开，它会很快散开、不易成团。' }}</p>
                            </div>
                        </details>
                    </div>
                </div>
            </div>
            
