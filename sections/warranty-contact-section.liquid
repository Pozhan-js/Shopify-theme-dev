<div class="wcs-warranty-contact-section">
  <div class="wcs-container">
    <div class="wcs-content-layout">
      <!-- 保修信息区域 -->
      <div class="wcs-warranty-info">
        <!-- 保修覆盖区域 -->
        <div class="wcs-warranty-coverage">
          <h2 class="wcs-section-title">{{ section.settings.warranty_title | default: "WARRANTY COVERAGE" }}</h2>
          
          <div class="wcs-warranty-item">
            <div class="wcs-warranty-header">
              <div class="wcs-warranty-line"></div>
              <h3 class="wcs-warranty-subtitle">{{ section.settings.frame_warranty_title | default: "10-Year Frame Warranty" }}</h3>
            </div>
            <p class="wcs-warranty-description">{{ section.settings.frame_warranty_description | default: "Complete structural coverage for all Pilates machine frames" }}</p>
          </div>

          <div class="wcs-warranty-item">
            <div class="wcs-warranty-header">
              <div class="wcs-warranty-line"></div>
              <h3 class="wcs-warranty-subtitle">{{ section.settings.parts_warranty_title | default: "2-Year Parts Warranty" }}</h3>
            </div>
            <p class="wcs-warranty-description">{{ section.settings.parts_warranty_description | default: "Coverage for springs, pulleys, upholstery, and accessories" }}</p>
          </div>
        </div>

        <!-- 技术支持区域 -->
        <div class="wcs-technical-support">
          <h2 class="wcs-section-title">{{ section.settings.support_title | default: "TECHNICAL SUPPORT" }}</h2>
          
          <div class="wcs-support-list">
            {% for block in section.blocks %}
              {% if block.type == 'support_item' %}
                <div class="wcs-support-item" {{ block.shopify_attributes }}>
                  <div class="wcs-support-icon">
                    {% if block.settings.support_icon != blank %}
                      <img src="{{ block.settings.support_icon | img_url: '16x16' }}" alt="Support Icon" class="wcs-support-icon-image">
                    {% else %}
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="8" cy="8" r="7" stroke="#C22E35" stroke-width="2"/>
                        <path d="M5 8l2 2 4-4" stroke="#C22E35" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% endif %}
                  </div>
                  <span class="wcs-support-text">{{ block.settings.support_text }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.wcs-warranty-contact-section {
  background-color: #F1F0EE;
  padding: 80px 0;
}

.wcs-container {
  max-width: 1520px;
  margin: 0 auto;
  padding: 0 20px;
}

.wcs-content-layout {
  display: flex;
  justify-content: center;
  align-items: start;
}

/* 保修信息样式 */
.wcs-warranty-info {
  display: flex;
  flex-direction: column;
  gap: 38px;
  width: 100%;
  max-width: 800px;
}

.wcs-section-title {
  font-size: 36px;
  font-weight: 400;
  color: rgba(22, 22, 22, 0.5);
  margin: 0 0 16px 0;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.wcs-warranty-item {
  margin-bottom: 40px;
  border-left: 3px solid #C22E35;
  padding-left: 16px;
}

.wcs-warranty-header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 12px;
}

.wcs-warranty-line {
  width: 4px;
  height: 24px;
  background-color: #C22E35;
  flex-shrink: 0;
}

.wcs-warranty-subtitle {
  font-size: 18px;
  font-weight: 600;
  color: #161616;
  margin: 0;
}

.wcs-warranty-description {
  font-size: 18px;
  font-weight: 400;
  color: rgba(22, 22, 22, 0.5);
  line-height: 1.5;
  margin: 0;
}

.wcs-support-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.wcs-support-item {
  display: flex;
  align-items: center;
  gap: 16px;
}

.wcs-support-icon {
  flex-shrink: 0;
  width: 16px;
  height: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wcs-support-icon-image {
  width: 16px;
  height: 16px;
  object-fit: contain;
}

.wcs-support-text {
  font-size: 16px;
  color: #666666;
  line-height: 1.5;
}

/* 响应式设计 */

/* 大屏幕 (1920px+) */
@media (min-width: 1920px) {
  .wcs-container {
    max-width: 1520px;
  }
}

@media (max-width: 768px) {
  .wcs-warranty-contact-section {
    padding: 60px 0;
  }
  
  .wcs-container {
    padding: 0 15px;
  }
  
  .wcs-section-title {
    font-size: 28px;
    margin-bottom: 16px;
  }
}

@media (max-width: 480px) {
  .wcs-warranty-contact-section {
    padding: 40px 0;
  }
  
  .wcs-warranty-info {
    gap: 38px;
    width: 100%;
  }
  
  .wcs-warranty-item {
    margin-bottom: 30px;
  }
  
  .wcs-warranty-subtitle {
    font-size: 16px;
  }
  
  .wcs-warranty-description {
    font-size: 16px;
  }
  
  .wcs-section-title {
    font-size: 24px;
  }
  
  .wcs-support-text {
    font-size: 14px;
  }
}
</style>


{% schema %}
{
  "name": "保修信息和联系表单",
  "tag": "section",
  "class": "warranty-contact-section",
  "settings": [
    {
      "type": "header",
      "content": "保修信息设置"
    },
    {
      "type": "text",
      "id": "warranty_title",
      "label": "保修标题",
      "default": "WARRANTY COVERAGE"
    },
    {
      "type": "text",
      "id": "frame_warranty_title",
      "label": "框架保修标题",
      "default": "10-Year Frame Warranty"
    },
    {
      "type": "textarea",
      "id": "frame_warranty_description",
      "label": "框架保修描述",
      "default": "Complete structural coverage for all Pilates machine frames"
    },
    {
      "type": "text",
      "id": "parts_warranty_title",
      "label": "零件保修标题",
      "default": "2-Year Parts Warranty"
    },
    {
      "type": "textarea",
      "id": "parts_warranty_description",
      "label": "零件保修描述",
      "default": "Coverage for springs, pulleys, upholstery, and accessories"
    },
    {
      "type": "header",
      "content": "技术支持设置"
    },
    {
      "type": "text",
      "id": "support_title",
      "label": "技术支持标题",
      "default": "TECHNICAL SUPPORT"
    }
  ],
  "blocks": [
    {
      "type": "support_item",
      "name": "技术支持项目",
      "settings": [
        {
          "type": "text",
          "id": "support_text",
          "label": "支持文本"
        },
        {
          "type": "image_picker",
          "id": "support_icon",
          "label": "支持图标",
          "info": "推荐尺寸：16x16px，如不上传将使用默认勾选图标"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "保修信息和联系表单",
      "blocks": [
        {
          "type": "support_item",
          "settings": {
            "support_text": "Installation video guides"
          }
        },
        {
          "type": "support_item",
          "settings": {
            "support_text": "Remote video call assistance"
          }
        },
        {
          "type": "support_item",
          "settings": {
            "support_text": "Maintenance kits and spare parts"
          }
        },
        {
          "type": "support_item",
          "settings": {
            "support_text": "100% pre-shipment quality inspection"
          }
        }
      ]
    }
  ]
}
{% endschema %}
