{% comment %}
  ===================================================================
  Section: 图文模块 - 带文字上浮动画
  新增功能：
    - 所有文字内容入场动画：slideUp
    - 容器 max-width: 80rem
    - 图片宽高可调百分比，居中显示
    - 支持 desktop/mobile 双图
    - 无背景颜色设置
  ===================================================================
{% endcomment %}

<div class="image-below-title-section"
     style="padding: {{ section.settings.padding_top }}px {{ section.settings.padding_sides }}px {{ section.settings.padding_bottom }}px;
            font-family: 'Helvetica Neue', Arial, sans-serif; color: #333;">
  
  <!-- 主容器：最大宽度 80rem -->
  <div class="container" style="max-width: 80rem; margin: 0 auto; padding: 0 20px;">

    <!-- 大标题 -->
    {%- if section.settings.main_title != blank -%}
      <h1 class="main-title animated"
          style="text-align: {{ section.settings.title_align }};
                 font-size: 36px;
                 margin-bottom: 20px;
                 color: {{ section.settings.title_color }};
                 line-height: 1.3;
                 opacity: 0;
                 transform: translateY(20px);
                 animation: slideUp 0.6s ease-out forwards;">
        {{ section.settings.main_title }}
      </h1>
    {%- endif -%}

    <!-- 装饰性横线 -->
    <div class="animated"
         style="width: 4rem;
                height: 2px;
                background: #5a7c5a;
                margin: 0 auto 2rem;
                opacity: 0;
                transform: translateY(20px);
                animation: slideUp 0.6s ease-out 0.2s forwards;">
    </div>

    <!-- 第一部分：标题1 + 图片1 -->
    <div class="content-block"
         style="text-align: {{ section.settings.content_align }};">
      <h2 class="section-title animated"
          style="font-size: 28px;
                 margin-bottom: 20px;
                 color: #222;
                 opacity: 0;
                 transform: translateY(20px);
                 animation: slideUp 0.6s ease-out 0.3s forwards;">
        {{ section.settings.title_1 }}
      </h2>

      <div class="image-wrapper" style="text-align: center;">
        <!-- Desktop 图片 -->
        <img src="{{ section.settings.image1_desktop | img_url: '1024x' }}"
             alt="{{ section.settings.image1_alt }}"
             class="image-desktop"
             style="
               width: {{ section.settings.image1_width }}%;
               height: {{ section.settings.image1_height }}%;
               max-width: 100%;
               object-fit: cover;
               display: block;
               border-radius: 8px;
               margin: 0 auto;"
             {% if section.settings.image1_desktop_loading == 'lazy' %}loading="lazy"{% endif %}>

        <!-- Mobile 图片 -->
        <img src="{{ section.settings.image1_mobile | img_url: '600x' }}"
             alt="{{ section.settings.image1_alt }}"
             class="image-mobile"
             style="
               width: {{ section.settings.image1_width }}%;
               height: {{ section.settings.image1_height }}%;
               max-width: 100%;
               object-fit: cover;
               display: none;
               border-radius: 8px;
               margin: 0 auto;"
             {% if section.settings.image1_mobile_loading == 'lazy' %}loading="lazy"{% endif %}>
      </div>
    </div>

    <!-- 分隔间距 -->
    <div style="height: 40px;"></div>

    <!-- 第二部分：标题2 + 内容 + 图片2 -->
<div class="content-block"
     style="text-align: {{ section.settings.content_align }};">
  <h2 class="section-title animated"
      style="font-size: 28px;
             margin-bottom: 16px;
             color: #222;
             opacity: 0;
             transform: translateY(20px);
             animation: slideUp 0.6s ease-out 0.4s forwards;">
    {{ section.settings.title_2 }}
  </h2>

  <div class="content-text animated"
       style="font-size: 16px;
              line-height: 1.7;
              color: #555;
              margin-bottom: 20px;
              opacity: 0;
              transform: translateY(20px);
              animation: slideUp 0.6s ease-out 0.5s forwards;">
    {{ section.settings.content_text }}
  </div>

  <!-- 图片容器：带 20px 上边距 -->
  <div class="image-wrapper"
       style="
         position: relative;
         width: {{ section.settings.image2_width }}%;
         min-height: 200px;
         margin: 20px auto 0; /* top: 20px, bottom: 0 */
         overflow: hidden;
         text-align: center;">
    
    <!-- Desktop 图片 -->
    <img src="{{ section.settings.image2_desktop | img_url: '1024x' }}"
         alt="{{ section.settings.image2_alt }}"
         class="image-desktop"
         style="
           position: absolute;
           top: 0; left: 0; right: 0; bottom: 0;
           width: 100%; height: 100%;
           object-fit: cover;
           border-radius: 8px;"
         {% if section.settings.image2_desktop_loading == 'lazy' %}loading="lazy"{% endif %}>

    <!-- Mobile 图片 -->
    <img src="{{ section.settings.image2_mobile | img_url: '600x' }}"
         alt="{{ section.settings.image2_alt }}"
         class="image-mobile"
         style="
           position: absolute;
           top: 0; left: 0; right: 0; bottom: 0;
           width: 100%; height: 100%;
           object-fit: cover;
           border-radius: 8px;
           display: none;"
         {% if section.settings.image2_mobile_loading == 'lazy' %}loading="lazy"{% endif %}>
  </div>
</div>

  </div>
</div>

<style>
  /* 上浮动画定义 */
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* 默认显示 desktop 图 */
  .image-desktop {
    display: block;
  }
  .image-mobile {
    display: none;
  }

  /* 移动端：隐藏 desktop，显示 mobile */
  @media (max-width: 768px) {
    .image-desktop {
      display: none;
    }
    .image-mobile {
      display: block;
    }
  }
</style>

{% schema %}
{
  "name": "图文模块 - 带上浮动画",
  "tag": "section",
  "class": "index-section",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "大标题",
      "default": "探索我们的品牌故事"
    },
    {
      "type": "select",
      "id": "title_align",
      "label": "大标题对齐方式",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "大标题颜色",
      "default": "#000000"
    },

    {
      "type": "header",
      "content": "第一部分：标题1 + 图片1"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "标题1",
      "default": "设计源于生活"
    },
    {
      "type": "range",
      "id": "image1_width",
      "label": "图片1 显示宽度",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "image1_height",
      "label": "图片1 显示高度",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 100
    },
    {
      "type": "image_picker",
      "id": "image1_desktop",
      "label": "图片1 - 桌面端"
    },
    {
      "type": "image_picker",
      "id": "image1_mobile",
      "label": "图片1 - 手机端"
    },
    {
      "type": "text",
      "id": "image1_alt",
      "label": "图片1 替代文本",
      "default": "设计场景图"
    },
    {
      "type": "select",
      "id": "image1_desktop_loading",
      "label": "桌面端图片加载方式",
      "options": [
        { "value": "eager", "label": "立即加载" },
        { "value": "lazy", "label": "懒加载" }
      ],
      "default": "lazy"
    },
    {
      "type": "select",
      "id": "image1_mobile_loading",
      "label": "移动端图片加载方式",
      "options": [
        { "value": "eager", "label": "立即加载" },
        { "value": "lazy", "label": "懒加载" }
      ],
      "default": "lazy"
    },

    {
      "type": "header",
      "content": "第二部分：标题2 + 内容 + 图片2"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "标题2",
      "default": "工艺成就品质"
    },
    {
      "type": "richtext",
      "id": "content_text",
      "label": "内容文字",
      "default": "<p>我们坚持使用传统工艺与现代技术结合，打造每一件精品。</p>"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "正文对齐方式",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image2_width",
      "label": "图片2 显示宽度",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "image2_height",
      "label": "图片2 显示高度",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "default": 100
    },
    {
      "type": "image_picker",
      "id": "image2_desktop",
      "label": "图片2 - 桌面端"
    },
    {
      "type": "image_picker",
      "id": "image2_mobile",
      "label": "图片2 - 手机端"
    },
    {
      "type": "text",
      "id": "image2_alt",
      "label": "图片2 替代文本",
      "default": "生产工艺图"
    },
    {
      "type": "select",
      "id": "image2_desktop_loading",
      "label": "桌面端图片加载方式",
      "options": [
        { "value": "eager", "label": "立即加载" },
        { "value": "lazy", "label": "懒加载" }
      ],
      "default": "lazy"
    },
    {
      "type": "select",
      "id": "image2_mobile_loading",
      "label": "移动端图片加载方式",
      "options": [
        { "value": "eager", "label": "立即加载" },
        { "value": "lazy", "label": "懒加载" }
      ],
      "default": "lazy"
    },

    {
      "type": "header",
      "content": "全局设置"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "顶部内边距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_sides",
      "label": "左右内边距",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "底部内边距",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "带动画图文模块",
      "category": "内容"
    }
  ]
}
{% endschema %}
