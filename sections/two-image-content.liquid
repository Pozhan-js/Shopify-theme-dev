{% comment %}
  ===================================================================
  Section: 图文模块 - 稳定版（已撤回高度基于父元素的修改）
  功能：
    - 大标题 + 装饰横线
    - 标题1 → 图片1（完整显示）
    - 标题2 → 内容 → 图片2（+20px 上边距）
    - 外层 padding: 5rem 3rem
    - 支持 fallback：任一端未上传，自动使用另一端
    - 任何分辨率下均显示图片
    - 使用 <picture> 原生响应式方案
    - 图片完整显示（contain），不裁剪
  ===================================================================
{% endcomment %}

<div class="image-below-title-section"
     style="padding: 5rem 3rem;
            font-family: 'Helvetica Neue', Arial, sans-serif; 
            color: #333;">
  
  <!-- 主容器：最大宽度 80rem -->
  <div class="container" style="max-width: 80rem; margin: 0 auto; padding: 0 20px;">

    <!-- 大标题 -->
    {%- if section.settings.main_title != blank -%}
      <h1 class="main-title animated"
          style="text-align: {{ section.settings.title_align }};
                 font-size: 36px;
                 margin-bottom: 20px;
                 color: {{ section.settings.title_color }};
                 line-height: 1.3;
                 opacity: 0;
                 transform: translateY(20px);
                 animation: slideUp 0.6s ease-out forwards;">
        {{ section.settings.main_title }}
      </h1>
    {%- endif -%}

    <!-- 装饰性横线 -->
    <div class="animated"
         style="width: 4rem;
                height: 2px;
                background: #5a7c5a;
                margin: 0 auto 2rem;
                opacity: 0;
                transform: translateY(20px);
                animation: slideUp 0.6s ease-out 0.2s forwards;">
    </div>

    <!-- 第一部分：标题1 + 图片1 -->
    <div class="content-block"
         style="text-align: {{ section.settings.content_align }};">
      <h2 class="section-title animated"
          style="font-size: 28px;
                 margin-bottom: 20px;
                 color: #222;
                 opacity: 0;
                 transform: translateY(20px);
                 animation: slideUp 0.6s ease-out 0.3s forwards;">
        {{ section.settings.title_1 }}
      </h2>

      <!-- 图片容器 -->
      <div class="image-wrapper"
           style="
             width: {{ section.settings.image1_width }}%;
             height: {{ section.settings.image1_height }}vh;
             min-height: 100px;
             margin: 0 auto;
             overflow: hidden;
             display: flex;
             justify-content: center;
             align-items: center;
             background: transparent;">
        
        <!-- 使用 <picture> 实现响应式源切换 -->
        <picture>
          <!-- Desktop 图 -->
          <source media="(min-width: 769px)"
                  srcset="
                    {%- if section.settings.image1_desktop -%}
                      {{ section.settings.image1_desktop | img_url: '1024x' }}
                    {%- elsif section.settings.image1_mobile -%}
                      {{ section.settings.image1_mobile | img_url: '1024x' }}
                    {%- else -%}
                      {{ 'placeholder.png' | asset_img_url: '1024x' }}
                    {%- endif -%}">
          
          <!-- Mobile 图 -->
          <source media="(max-width: 768px)"
                  srcset="
                    {%- if section.settings.image1_mobile -%}
                      {{ section.settings.image1_mobile | img_url: '600x' }}
                    {%- elsif section.settings.image1_desktop -%}
                      {{ section.settings.image1_desktop | img_url: '600x' }}
                    {%- else -%}
                      {{ 'placeholder.png' | asset_img_url: '600x' }}
                    {%- endif -%}">
          
          <!-- 默认 img -->
          <img src="
            {%- if section.settings.image1_desktop -%}
              {{ section.settings.image1_desktop | img_url: '800x' }}
            {%- elsif section.settings.image1_mobile -%}
              {{ section.settings.image1_mobile | img_url: '800x' }}
            {%- else -%}
              {{ 'placeholder.png' | asset_img_url: '800x' }}
            {%- endif -%}"
               alt="{{ section.settings.image1_alt }}"
               style="
                 max-width: 100%;
                 max-height: 100%;
                 object-fit: contain;
                 object-position: center;
                 display: block;"
               loading="lazy">
        </picture>
      </div>
    </div>

    <!-- 分隔间距 -->
    <div style="height: 40px;"></div>

    <!-- 第二部分：标题2 + 内容 + 图片2 -->
    <div class="content-block"
         style="text-align: {{ section.settings.content_align }};">
      <h2 class="section-title animated"
          style="font-size: 28px;
                 margin-bottom: 16px;
                 color: #222;
                 opacity: 0;
                 transform: translateY(20px);
                 animation: slideUp 0.6s ease-out 0.4s forwards;">
        {{ section.settings.title_2 }}
      </h2>

      <div class="content-text animated"
           style="font-size: 16px;
                  line-height: 1.7;
                  color: #555;
                  margin-bottom: 20px;
                  opacity: 0;
                  transform: translateY(20px);
                  animation: slideUp 0.6s ease-out 0.5s forwards;">
        {{ section.settings.content_text }}
      </div>

      <!-- 图片容器：图片2 -->
      <div class="image-wrapper"
           style="
             width: {{ section.settings.image2_width }}%;
             height: {{ section.settings.image2_height }}vh;
             min-height: 100px;
             margin: 20px auto 0;
             overflow: hidden;
             display: flex;
             justify-content: center;
             align-items: center;
             background: transparent;">
        
        <picture>
          <!-- Desktop 图 -->
          <source media="(min-width: 769px)"
                  srcset="
                    {%- if section.settings.image2_desktop -%}
                      {{ section.settings.image2_desktop | img_url: '1024x' }}
                    {%- elsif section.settings.image2_mobile -%}
                      {{ section.settings.image2_mobile | img_url: '1024x' }}
                    {%- else -%}
                      {{ 'placeholder-2.png' | asset_img_url: '1024x' }}
                    {%- endif -%}">
          
          <!-- Mobile 图 -->
          <source media="(max-width: 768px)"
                  srcset="
                    {%- if section.settings.image2_mobile -%}
                      {{ section.settings.image2_mobile | img_url: '600x' }}
                    {%- elsif section.settings.image2_desktop -%}
                      {{ section.settings.image2_desktop | img_url: '600x' }}
                    {%- else -%}
                      {{ 'placeholder-2.png' | asset_img_url: '600x' }}
                    {%- endif -%}">
          
          <!-- 默认 img -->
          <img src="
            {%- if section.settings.image2_desktop -%}
              {{ section.settings.image2_desktop | img_url: '800x' }}
            {%- elsif section.settings.image2_mobile -%}
              {{ section.settings.image2_mobile | img_url: '800x' }}
            {%- else -%}
              {{ 'placeholder-2.png' | asset_img_url: '800x' }}
            {%- endif -%}"
               alt="{{ section.settings.image2_alt }}"
               style="
                 max-width: 100%;
                 max-height: 100%;
                 object-fit: contain;
                 object-position: center;
                 display: block;"
               loading="lazy">
        </picture>
      </div>
    </div>

  </div>
</div>

<style>
  /* 上浮动画 */
  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animated {
    opacity: 0;
  }
</style>

{% schema %}
{
  "name": "图文模块 - 稳定版",
  "tag": "section",
  "class": "index-section",
  "settings": [
    {
      "type": "text",
      "id": "main_title",
      "label": "大标题",
      "default": "探索我们的品牌故事"
    },
    {
      "type": "select",
      "id": "title_align",
      "label": "大标题对齐方式",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "大标题颜色",
      "default": "#000000"
    },

    {
      "type": "header",
      "content": "第一部分：标题1 + 图片1"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "标题1",
      "default": "设计源于生活"
    },
    {
      "type": "range",
      "id": "image1_width",
      "label": "图片1 显示宽度",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "image1_height",
      "label": "图片1 显示高度 (vh)",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "image_picker",
      "id": "image1_desktop",
      "label": "图片1 - 桌面端"
    },
    {
      "type": "image_picker",
      "id": "image1_mobile",
      "label": "图片1 - 手机端"
    },
    {
      "type": "text",
      "id": "image1_alt",
      "label": "图片1 替代文本",
      "default": "设计场景图"
    },

    {
      "type": "header",
      "content": "第二部分：标题2 + 内容 + 图片2"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "标题2",
      "default": "工艺成就品质"
    },
    {
      "type": "richtext",
      "id": "content_text",
      "label": "内容文字",
      "default": "<p>我们坚持使用传统工艺与现代技术结合，打造每一件精品。</p>"
    },
    {
      "type": "select",
      "id": "content_align",
      "label": "正文对齐方式",
      "options": [
        { "value": "left", "label": "左对齐" },
        { "value": "center", "label": "居中" },
        { "value": "right", "label": "右对齐" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "image2_width",
      "label": "图片2 显示宽度",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "image2_height",
      "label": "图片2 显示高度 (vh)",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 70
    },
    {
      "type": "image_picker",
      "id": "image2_desktop",
      "label": "图片2 - 桌面端"
    },
    {
      "type": "image_picker",
      "id": "image2_mobile",
      "label": "图片2 - 手机端"
    },
    {
      "type": "text",
      "id": "image2_alt",
      "label": "图片2 替代文本",
      "default": "生产工艺图"
    }
  ],
  "presets": [
    {
      "name": "图文模块 - 稳定版",
      "category": "内容"
    }
  ]
}
{% endschema %}
