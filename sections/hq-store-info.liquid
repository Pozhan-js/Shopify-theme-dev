{% schema %}
{
  "name": "HQ Store Info",
  "settings": [
    {
      "type": "text",
      "id": "store_name",
      "label": "Store Name",
      "default": "HQ STORE"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "Fersens väg 20\n211 42 Malmö\nSweden"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hqstore@tres-bien.com"
    },
    {
      "type": "text",
      "id": "opening_hours_title",
      "label": "Opening Hours Title",
      "default": "Opening hours"
    },
    {
      "type": "textarea",
      "id": "opening_hours",
      "label": "Opening Hours",
      "default": "Fri 11-18\nSat 11-17"
    },
    {
      "type": "text",
      "id": "new_arrivals_title",
      "label": "New Arrivals Title",
      "default": "NEW ARRIVALS AT HQ STORE"
    },
    {
      "type": "text",
      "id": "view_more_text",
      "label": "View More Text",
      "default": "View more"
    },
    {
      "type": "url",
      "id": "view_more_link",
      "label": "View More Link"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 10,
      "step": 1,
      "label": "Number of Products to Show",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "HQ Store Info"
    }
  ]
}
{% endschema %}

<div class="hq-store-section">
  <div class="store-info">
    <h2 class="store-name">{{ section.settings.store_name }}</h2>
    
    <div class="store-details">
      <p class="address">{{ section.settings.address | newline_to_br }}</p>
      <p class="email">{{ section.settings.email }}</p>
      
      <div class="opening-hours">
        <p class="hours-title">{{ section.settings.opening_hours_title }}</p>
        <p class="hours-content">{{ section.settings.opening_hours | newline_to_br }}</p>
      </div>
    </div>
  </div>

  <div class="new-arrivals">
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.new_arrivals_title }}</h2>
      {% if section.settings.featured_collection != blank %}
        <a href="{{ collections[section.settings.featured_collection].url }}" class="view-more-link">
          {{ section.settings.view_more_text }}
        </a>
      {% elsif section.settings.view_more_link != blank %}
        <a href="{{ section.settings.view_more_link }}" class="view-more-link">
          {{ section.settings.view_more_text }}
        </a>
      {% endif %}
    </div>

    <div class="products-grid">
      {% if section.settings.featured_collection != blank %}
        {% assign collection = collections[section.settings.featured_collection] %}
        {% for product in collection.products limit: section.settings.products_to_show %}
          <div class="product-card">
            <a href="{{ product.url }}" class="product-link">
              <div class="product-image">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '600x' }}" 
                       alt="{{ product.title | escape }}"
                       loading="lazy">
                {% else %}
                  <div class="placeholder-image"></div>
                {% endif %}
              </div>
              
              <div class="product-info">
                <h3 class="product-title">{{ product.title }}</h3>
                <p class="product-price">
                  {{ product.price | money }}
                </p>
              </div>
            </a>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<style>
.hq-store-section {
  max-width: 1400px;
  margin: 0 auto;
  padding: 40px 20px;
}

.store-info {
  margin-bottom: 60px;
}

.store-name {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 0.5px;
  margin-bottom: 30px;
  text-transform: uppercase;
}

.store-details {
  font-size: 16px;
  line-height: 1.6;
}

.address {
  margin-bottom: 20px;
  white-space: pre-line;
}

.email {
  margin-bottom: 30px;
}

.opening-hours {
  margin-top: 30px;
}

.hours-title {
  font-weight: 600;
  margin-bottom: 8px;
}

.hours-content {
  white-space: pre-line;
}

.new-arrivals {
  margin-top: 60px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30px;
  flex-wrap: wrap;
}

.section-title {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  line-height: 1.3;
  margin-bottom: 10px;
  flex: 1 1 auto;
  min-width: 200px;
}

.view-more-link {
  color: #00c853;
  font-size: 16px;
  text-decoration: none;
  font-weight: 500;
  transition: opacity 0.3s ease;
  white-space: nowrap;
  margin-top: 5px;
}

.view-more-link:hover {
  opacity: 0.7;
}

.products-grid {
  display: flex;
  gap: 0;
  overflow-x: auto;
  scroll-behavior: smooth;
  cursor: grab;
  user-select: none;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.products-grid::-webkit-scrollbar {
  display: none;
}

.products-grid.dragging {
  cursor: grabbing;
  scroll-behavior: auto;
}

.product-card {
  position: relative;
  flex: 0 0 auto;
}

.product-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.product-image {
  width: 250px;
  height: 250px;
  background-color: #f8f8f8;
  overflow: hidden;
  position: relative;
  margin: 0 auto;
}

.product-image img {
  width: 100%;
  object-fit: contain;
  transition: transform 0.3s ease;
  height: auto;
  vertical-align: bottom;
  max-width: 100%;
}

.product-link:hover .product-image img {
  transform: scale(1.05);
}

.placeholder-image {
  width: 100%;
  height: 100%;
  background-color: #f8f8f8;
}

.product-info {
  padding: 15px 0;
  text-align: left;
}

.product-title {
  font-size: 15px;
  font-weight: 400;
  margin-bottom: 8px;
  line-height: 1.5;
  word-wrap: break-word;
  overflow-wrap: break-word;
  hyphens: auto;
  max-width: 250px;
  margin-left: auto;
  margin-right: auto;
}

.product-price {
  font-size: 16px;
  font-weight: 600;
}

@media (max-width: 768px) {

  .product-image {
    width: 180px;
    height: 180px;
  }
  
  .product-title {
    font-size: 14px;
    max-width: 180px;
  }
  
  .section-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }
  
  .store-name {
    font-size: 20px;
  }
  
  .section-title {
    font-size: 18px;
  }
}

@media (max-width: 480px) {

  .product-image {
    width: 140px;
    height: 140px;
  }
  
  .product-title {
    font-size: 13px;
    max-width: 140px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const productsGrid = document.querySelector('.products-grid');
  
  if (!productsGrid) return;
  
  let isDown = false;
  let startX;
  let scrollLeft;
  let startY;
  let isScrolling = false;
  let clickPrevented = false;
  
  // 鼠标事件
  productsGrid.addEventListener('mousedown', (e) => {
    isDown = true;
    productsGrid.classList.add('dragging');
    startX = e.pageX - productsGrid.offsetLeft;
    startY = e.pageY;
    scrollLeft = productsGrid.scrollLeft;
    clickPrevented = false;
    
    // 防止文本选择
    e.preventDefault();
  });
  
  productsGrid.addEventListener('mouseleave', () => {
    if (isDown) {
      isDown = false;
      productsGrid.classList.remove('dragging');
    }
  });
  
  productsGrid.addEventListener('mouseup', () => {
    if (isDown) {
      isDown = false;
      setTimeout(() => {
        productsGrid.classList.remove('dragging');
      }, 100);
    }
  });
  
  productsGrid.addEventListener('mousemove', (e) => {
    if (!isDown) return;
    
    const x = e.pageX - productsGrid.offsetLeft;
    const y = e.pageY;
    const walkX = x - startX;
    const walkY = Math.abs(y - startY);
    
    // 如果水平移动距离大于垂直移动距离，认为是拖动
    if (Math.abs(walkX) > walkY && Math.abs(walkX) > 5) {
      isScrolling = true;
      clickPrevented = true;
    }
    
    if (isScrolling) {
      e.preventDefault();
      productsGrid.scrollLeft = scrollLeft - walkX * 1.5;
    }
  });
  
  // 触摸事件支持
  productsGrid.addEventListener('touchstart', (e) => {
    isDown = true;
    startX = e.touches[0].pageX - productsGrid.offsetLeft;
    startY = e.touches[0].pageY;
    scrollLeft = productsGrid.scrollLeft;
    clickPrevented = false;
    isScrolling = false;
  });
  
  productsGrid.addEventListener('touchend', () => {
    isDown = false;
    isScrolling = false;
    setTimeout(() => {
      clickPrevented = false;
    }, 100);
  });
  
  productsGrid.addEventListener('touchmove', (e) => {
    if (!isDown) return;
    
    const x = e.touches[0].pageX - productsGrid.offsetLeft;
    const y = e.touches[0].pageY;
    const walkX = x - startX;
    const walkY = Math.abs(y - startY);
    
    if (Math.abs(walkX) > walkY && Math.abs(walkX) > 5) {
      isScrolling = true;
      clickPrevented = true;
      e.preventDefault();
      productsGrid.scrollLeft = scrollLeft - walkX * 1.5;
    }
  });
  
  // 防止拖动时触发链接点击
  const productLinks = productsGrid.querySelectorAll('.product-link');
  productLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      if (clickPrevented) {
        e.preventDefault();
      }
    });
  });
  
  // 添加惯性滚动
  let velocity = 0;
  let animationId = null;
  
  productsGrid.addEventListener('mouseup', handleMouseUp);
  productsGrid.addEventListener('mouseleave', handleMouseUp);
  
  function handleMouseUp() {
    if (!isDown) return;
    
    isDown = false;
    isScrolling = false;
    
    // 简单的惯性效果
    const deceleration = 0.95;
    const animate = () => {
      if (Math.abs(velocity) > 0.5) {
        productsGrid.scrollLeft += velocity;
        velocity *= deceleration;
        animationId = requestAnimationFrame(animate);
      } else {
        cancelAnimationFrame(animationId);
        productsGrid.classList.remove('dragging');
      }
    };
    
    animate();
  }
  
  productsGrid.addEventListener('mousemove', (e) => {
    if (!isDown) return;
    
    const x = e.pageX - productsGrid.offsetLeft;
    velocity = (x - startX) * 0.5;
  });
});
</script>
