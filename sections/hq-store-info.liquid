{% schema %}
{
  "name": "HQ Store Info",
  "settings": [
    {
      "type": "text",
      "id": "store_name",
      "label": "Store Name",
      "default": "HQ STORE"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Address",
      "default": "Fersens väg 20\n211 42 Malmö\nSweden"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "hqstore@tres-bien.com"
    },
    {
      "type": "text",
      "id": "opening_hours_title",
      "label": "Opening Hours Title",
      "default": "Opening hours"
    },
    {
      "type": "textarea",
      "id": "opening_hours",
      "label": "Opening Hours",
      "default": "Fri 11-18\nSat 11-17"
    },
    {
      "type": "text",
      "id": "new_arrivals_title",
      "label": "New Arrivals Title",
      "default": "NEW ARRIVALS AT HQ STORE"
    },
    {
      "type": "text",
      "id": "view_more_text",
      "label": "View More Text",
      "default": "View more"
    },
    {
      "type": "url",
      "id": "view_more_link",
      "label": "View More Link"
    },
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 10,
      "step": 1,
      "label": "Number of Products to Show",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "HQ Store Info"
    }
  ]
}
{% endschema %}

<div class="hq-store-section">
  <div class="store-info">
    <h2 class="store-name">{{ section.settings.store_name }}</h2>
    
    <div class="store-details">
      <p class="address">{{ section.settings.address | newline_to_br }}</p>
      <p class="email">{{ section.settings.email }}</p>
      
      <div class="opening-hours">
        <p class="hours-title">{{ section.settings.opening_hours_title }}</p>
        <p class="hours-content">{{ section.settings.opening_hours | newline_to_br }}</p>
      </div>
    </div>
  </div>

  <div class="new-arrivals">
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.new_arrivals_title }}</h2>
      {% if section.settings.view_more_link != blank %}
        <a href="{{ section.settings.view_more_link }}" class="view-more-link">
          {{ section.settings.view_more_text }}
        </a>
      {% endif %}
    </div>

    <div class="products-grid">
      {% if section.settings.featured_collection != blank %}
        {% assign collection = collections[section.settings.featured_collection] %}
        {% for product in collection.products limit: section.settings.products_to_show %}
          <div class="product-card">
            <a href="{{ product.url }}" class="product-link">
              <div class="product-image">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '600x' }}" 
                       alt="{{ product.title | escape }}"
                       loading="lazy">
                {% else %}
                  <div class="placeholder-image"></div>
                {% endif %}
              </div>
              
              <div class="product-info">
                <h3 class="product-title">{{ product.title }}</h3>
                <p class="product-price">
                  {{ product.price | money }}
                </p>
              </div>
            </a>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<style>
.hq-store-section {
  max-width: 1400px;
  margin: 0 auto;
  padding: 40px 20px;
}

.store-info {
  margin-bottom: 60px;
}

.store-name {
  font-size: 24px;
  font-weight: 700;
  letter-spacing: 0.5px;
  margin-bottom: 30px;
  text-transform: uppercase;
}

.store-details {
  font-size: 16px;
  line-height: 1.6;
}

.address {
  margin-bottom: 20px;
  white-space: pre-line;
}

.email {
  margin-bottom: 30px;
}

.opening-hours {
  margin-top: 30px;
}

.hours-title {
  font-weight: 600;
  margin-bottom: 8px;
}

.hours-content {
  white-space: pre-line;
}

.new-arrivals {
  margin-top: 60px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30px;
}

.section-title {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 0.5px;
  text-transform: uppercase;
}

.view-more-link {
  color: #00c853;
  font-size: 16px;
  text-decoration: none;
  font-weight: 500;
  transition: opacity 0.3s ease;
}

.view-more-link:hover {
  opacity: 0.7;
}

.products-grid {
  display: flex;
  gap: 20px;
  overflow-x: auto;
  scroll-behavior: smooth;
  cursor: grab;
  user-select: none;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.products-grid::-webkit-scrollbar {
  display: none;
}

.products-grid.dragging {
  cursor: grabbing;
  scroll-behavior: auto;
}

.product-card {
  position: relative;
  flex: 0 0 280px;
  min-width: 280px;
}

.product-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.product-image {
  width: 100%;
  aspect-ratio: 1;
  background-color: #e8e8e8;
  margin-bottom: 15px;
  overflow: hidden;
}

.product-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.product-link:hover .product-image img {
  transform: scale(1.05);
}

.placeholder-image {
  width: 100%;
  height: 100%;
  background-color: #e8e8e8;
}

.product-info {
  padding: 10px 0;
}

.product-title {
  font-size: 16px;
  font-weight: 400;
  margin-bottom: 8px;
  line-height: 1.4;
}

.product-price {
  font-size: 16px;
  font-weight: 600;
}

@media (max-width: 768px) {
  .product-card {
    flex: 0 0 200px;
    min-width: 200px;
  }
  
  .section-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }
  
  .store-name {
    font-size: 20px;
  }
  
  .section-title {
    font-size: 18px;
  }
}

@media (max-width: 480px) {
  .product-card {
    flex: 0 0 160px;
    min-width: 160px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const productsGrid = document.querySelector('.products-grid');
  
  if (!productsGrid) return;
  
  let isDown = false;
  let startX;
  let scrollLeft;
  
  productsGrid.addEventListener('mousedown', (e) => {
    isDown = true;
    productsGrid.classList.add('dragging');
    startX = e.pageX - productsGrid.offsetLeft;
    scrollLeft = productsGrid.scrollLeft;
  });
  
  productsGrid.addEventListener('mouseleave', () => {
    isDown = false;
    productsGrid.classList.remove('dragging');
  });
  
  productsGrid.addEventListener('mouseup', () => {
    isDown = false;
    productsGrid.classList.remove('dragging');
  });
  
  productsGrid.addEventListener('mousemove', (e) => {
    if (!isDown) return;
    e.preventDefault();
    const x = e.pageX - productsGrid.offsetLeft;
    const walk = (x - startX) * 2;
    productsGrid.scrollLeft = scrollLeft - walk;
  });
  
  // 防止拖动时触发链接点击
  const productLinks = productsGrid.querySelectorAll('.product-link');
  productLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      if (productsGrid.classList.contains('dragging')) {
        e.preventDefault();
      }
    });
  });
});
</script>
