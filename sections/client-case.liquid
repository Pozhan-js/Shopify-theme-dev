<div class="testimonial-carousel-section" data-autoplay-interval="{{ section.settings.autoplay_interval | default: 5000 }}">
  <div class="testimonial-carousel-container">
    <div class="testimonial-carousel-cards" id="testimonialCards">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div class="testimonial-card">
            {% if block.settings.button_link != blank %}
              <a href="{{ block.settings.button_link }}" target="{{ block.settings.button_target }}" class="testimonial-card__full-link">
            {% endif %}
            
            <div class="testimonial-card__image-box">
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="Case Study Image" loading="lazy">
            </div>

            {% if block.settings.button_link != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="testimonial-carousel-nav" id="testimonialNav">
      <span class="testimonial-nav-arrow--left" style="cursor: pointer;">←</span>
      <div class="testimonial-nav-tracks">
        {% comment %} 
          生成指示点：逻辑上，最大有效索引是 总数 - 2 
        {% endcomment %}
        {% assign total_cards = section.blocks.size %}
        {% assign indicator_count = total_cards | minus: 2 %}
        {% if indicator_count < 1 %}{% assign indicator_count = 1 %}{% endif %}
        
        {% for i in (1..indicator_count) %}
          <span class="testimonial-nav-track" data-index="{{ forloop.index0 }}"></span>
        {% endfor %}
      </div>
      <span class="testimonial-nav-arrow--right" style="cursor: pointer;">→</span>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "纯图片案例轮播",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "自动轮播间隔（毫秒）",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "image_card",
      "name": "图片卡片",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "上传案例图片"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "点击图片跳转链接"
        },
        {
          "type": "select",
          "id": "button_target",
          "label": "链接打开方式",
          "options": [
            { "value": "_self", "label": "当前窗口" },
            { "value": "_blank", "label": "新窗口" }
          ],
          "default": "_self"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "纯图片案例轮播"
    }
  ]
}
{% endschema %}

{% style %}
.testimonial-carousel-section {
  max-width: 100%;
  margin: 40px auto;
  padding: 0 15px;
  overflow: hidden;
}

.testimonial-carousel-container {
  overflow: hidden;
  width: 100%;
  position: relative;
}

.testimonial-carousel-cards {
  display: flex;
  transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
  will-change: transform;
}

.testimonial-card {
  flex: 0 0 calc(33.333% - 16px); /* 桌面端显示3张 */
  margin: 0 8px;
  border-radius: 12px;
  overflow: hidden;
  background: #f4f4f4;
  position: relative;
}

.testimonial-card__full-link {
  display: block;
  width: 100%;
  height: 100%;
}

.testimonial-card__image-box {
  width: 100%;
  aspect-ratio: 1 / 1; /* 正方形展示，可改为 4/3 */
}

.testimonial-card__image-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* 响应式适配 */
@media (max-width: 1199px) {
  .testimonial-card { flex: 0 0 calc(50% - 16px); } /* 平板2张 */
}
@media (max-width: 767px) {
  .testimonial-card { flex: 0 0 calc(100% - 16px); } /* 手机1张 */
}

/* 指示器样式 */
.testimonial-carousel-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  margin-top: 30px;
}

.testimonial-nav-tracks {
  display: flex;
  gap: 10px;
}

.testimonial-nav-track {
  width: 25px;
  height: 4px;
  background-color: #e0e0e0;
  cursor: pointer;
  border-radius: 2px;
  transition: all 0.3s ease;
}

.testimonial-nav-track.active {
  width: 45px;
  background-color: #c22e35; /* 激活状态颜色 */
}

.testimonial-nav-arrow--left, .testimonial-nav-arrow--right {
  font-size: 20px;
  font-weight: bold;
  color: #333;
  user-select: none;
}
{% endstyle %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  const container = document.getElementById('testimonialCards');
  const section = document.querySelector('.testimonial-carousel-section');
  if (!container || !section) return;

  const cards = container.querySelectorAll('.testimonial-card');
  const tracks = document.querySelectorAll('.testimonial-nav-track');
  const btnLeft = document.querySelector('.testimonial-nav-arrow--left');
  const btnRight = document.querySelector('.testimonial-nav-arrow--right');

  let currentIndex = 0;
  let autoplayTimer = null;
  const autoplayInterval = parseInt(section.dataset.autoplayInterval) || 5000;

  // 1. 获取当前每屏显示的卡片数
  function getVisibleCount() {
    if (window.innerWidth >= 1200) return 3;
    if (window.innerWidth >= 768) return 2;
    return 1;
  }

  // 2. 计算最大允许的索引（防止右侧留白）
  function getMaxIndex() {
    const visible = getVisibleCount();
    // 关键逻辑：如果你有 10 张图，显示 3 张，最大索引只能是 7 (索引从0开始则为7)
    return Math.max(cards.length - visible, 0);
  }

  // 3. 核心更新函数
  function updateCarousel(isAuto = false) {
    const maxIndex = getMaxIndex();

    // 索引越界处理
    if (currentIndex > maxIndex) {
      currentIndex = 0; // 到底后回到开头
    } else if (currentIndex < 0) {
      currentIndex = maxIndex; // 到头后去往末尾
    }

    // 计算移动距离
    const card = cards[0];
    const cardStyle = window.getComputedStyle(card);
    const cardFullWidth = card.offsetWidth + parseFloat(cardStyle.marginLeft) + parseFloat(cardStyle.marginRight);
    
    // 执行平滑位移
    container.style.transform = `translateX(${-currentIndex * cardFullWidth}px)`;

    // 更新指示点 (1:1 映射)
    tracks.forEach((track, index) => {
      track.classList.toggle('active', index === currentIndex);
    });

    // 箭头透明度反馈
    if(btnLeft) btnLeft.style.opacity = currentIndex === 0 ? "0.3" : "1";
    if(btnRight) btnRight.style.opacity = currentIndex >= maxIndex ? "0.3" : "1";
  }

  // 4. 手动控制逻辑
  function nextSlide() {
    const max = getMaxIndex();
    if (currentIndex < max) {
      currentIndex++;
    } else {
      currentIndex = 0;
    }
    updateCarousel();
  }

  function prevSlide() {
    if (currentIndex > 0) {
      currentIndex--;
    } else {
      currentIndex = getMaxIndex();
    }
    updateCarousel();
  }

  // 5. 自动播放管理
  function startAutoplay() {
    stopAutoplay();
    autoplayTimer = setInterval(nextSlide, autoplayInterval);
  }

  function stopAutoplay() {
    if (autoplayTimer) {
      clearInterval(autoplayTimer);
      autoplayTimer = null;
    }
  }

  // 6. 绑定点击事件
  if (btnRight) {
    btnRight.addEventListener('click', () => {
      stopAutoplay();
      nextSlide();
      // 手动点击后不立即恢复自动播放，给用户观察时间
    });
  }

  if (btnLeft) {
    btnLeft.addEventListener('click', () => {
      stopAutoplay();
      prevSlide();
    });
  }

  tracks.forEach((track, index) => {
    track.addEventListener('click', () => {
      stopAutoplay();
      currentIndex = index;
      updateCarousel();
    });
  });

  // 7. 窗口调整适配
  let resizeTimeout;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(() => {
      const max = getMaxIndex();
      if (currentIndex > max) currentIndex = max; // 重新对齐
      updateCarousel();
    }, 200);
  });

  // 8. 鼠标悬停行为
  section.addEventListener('mouseenter', stopAutoplay);
  section.addEventListener('mouseleave', startAutoplay);

  // 初始化执行
  updateCarousel();
  startAutoplay();
});
{% endjavascript %}