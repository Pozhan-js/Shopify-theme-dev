<div class="testimonial-carousel-section" data-autoplay-interval="{{ section.settings.autoplay_interval | default: 5000 }}">
  <div class="testimonial-carousel-container">
    <div class="testimonial-carousel-cards" id="testimonialCards">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div class="testimonial-card">
            {% if block.settings.button_link != blank %}
              <a href="{{ block.settings.button_link }}" target="{{ block.settings.button_target }}" class="testimonial-card__full-link">
            {% endif %}
            <div class="testimonial-card__image-box">
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="Case Study Image" loading="lazy">
            </div>
            {% if block.settings.button_link != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="testimonial-carousel-nav" id="testimonialNav">
      <span class="testimonial-nav-arrow--left">←</span>
      <div class="testimonial-nav-tracks">
        {% comment %} 
          核心计算：展示5个时，可滚动的终点是 总数-5。
          因此指示点数量设定为 总数减 4。
        {% endcomment %}
        {% assign total_cards = section.blocks.size %}
        {% assign indicator_count = total_cards | minus: 4 %}
        {% if indicator_count < 1 %}{% assign indicator_count = 1 %}{% endif %}
        
        {% for i in (1..indicator_count) %}
          <span class="testimonial-nav-track {% if forloop.first %}active{% endif %}" data-index="{{ forloop.index0 }}"></span>
        {% endfor %}
      </div>
      <span class="testimonial-nav-arrow--right">→</span>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "5图并排案例轮播",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "自动轮播间隔（毫秒）",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "image_card",
      "name": "图片卡片",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "上传案例图片"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "点击跳转链接"
        },
        {
          "type": "select",
          "id": "button_target",
          "label": "链接打开方式",
          "options": [
            { "value": "_self", "label": "当前窗口" },
            { "value": "_blank", "label": "新窗口" }
          ],
          "default": "_self"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "5图并排案例轮播"
    }
  ]
}
{% endschema %}

{% style %}
.testimonial-carousel-section {
  max-width: 100%;
  margin: 40px auto;
  padding: 0 10px;
  overflow: hidden;
  --card-gap: 10px; /* 定义间距 */
}

.testimonial-carousel-container {
  overflow: hidden;
  width: 100%;
}

.testimonial-carousel-cards {
  display: flex;
  transition: transform 0.6s cubic-bezier(0.25, 1, 0.33, 1);
  will-change: transform;
}

.testimonial-card {
  /* 桌面端显示5张：(100% / 5) = 20% */
  flex: 0 0 calc(20% - var(--card-gap));
  margin: 0 calc(var(--card-gap) / 2);
  border-radius: 10px;
  overflow: hidden;
  background: #f9f9f9;
}

.testimonial-card__full-link {
  display: block;
  width: 100%;
  height: 100%;
}

.testimonial-card__image-box {
  width: 100%;
  aspect-ratio: 1 / 1; /* 图片保持正方形 */
}

.testimonial-card__image-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* 响应式断点 */
@media (max-width: 1200px) {
  .testimonial-card { flex: 0 0 calc(33.33% - var(--card-gap)); } /* 平板3张 */
}
@media (max-width: 767px) {
  .testimonial-card { flex: 0 0 calc(50% - var(--card-gap)); } /* 手机2张 */
}

/* 导航样式 */
.testimonial-carousel-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 15px;
  margin-top: 25px;
}

.testimonial-nav-tracks {
  display: flex;
  gap: 8px;
}

.testimonial-nav-track {
  width: 20px;
  height: 4px;
  background-color: #e0e0e0;
  cursor: pointer;
  border-radius: 2px;
  transition: all 0.3s ease;
}

.testimonial-nav-track.active {
  width: 40px;
  background-color: #c22e35;
}

.testimonial-nav-arrow--left, 
.testimonial-nav-arrow--right {
  font-size: 20px;
  cursor: pointer;
  user-select: none;
  color: #333;
}
{% endstyle %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  const container = document.getElementById('testimonialCards');
  const section = document.querySelector('.testimonial-carousel-section');
  if (!container || !section) return;

  const cards = container.querySelectorAll('.testimonial-card');
  const tracks = document.querySelectorAll('.testimonial-nav-track');
  const btnLeft = document.querySelector('.testimonial-nav-arrow--left');
  const btnRight = document.querySelector('.testimonial-nav-arrow--right');

  let currentIndex = 0;
  let autoplayTimer = null;

  function getVisibleCount() {
    if (window.innerWidth >= 1201) return 5;
    if (window.innerWidth >= 768) return 3;
    return 2;
  }

  function getMaxIndex() {
    return Math.max(cards.length - getVisibleCount(), 0);
  }

  function update() {
    const maxIndex = getMaxIndex();
    
    // 边界溢出纠正
    if (currentIndex > maxIndex) currentIndex = 0;
    if (currentIndex < 0) currentIndex = maxIndex;

    const card = cards[0];
    const style = window.getComputedStyle(card);
    const cardFullWidth = card.offsetWidth + parseFloat(style.marginLeft) + parseFloat(style.marginRight);
    
    container.style.transform = `translateX(${-currentIndex * cardFullWidth}px)`;

    // 精准更新指示点 (1:1 匹配)
    tracks.forEach((track, index) => {
      track.classList.toggle('active', index === currentIndex);
    });

    // 箭头可见度
    if(btnLeft) btnLeft.style.opacity = currentIndex === 0 ? "0.3" : "1";
    if(btnRight) btnRight.style.opacity = currentIndex >= maxIndex ? "0.3" : "1";
  }

  function moveNext() {
    const max = getMaxIndex();
    currentIndex = (currentIndex >= max) ? 0 : currentIndex + 1;
    update();
  }

  function movePrev() {
    const max = getMaxIndex();
    currentIndex = (currentIndex <= 0) ? max : currentIndex - 1;
    update();
  }

  // 绑定事件
  if(btnRight) btnRight.onclick = () => { stopAutoplay(); moveNext(); };
  if(btnLeft) btnLeft.onclick = () => { stopAutoplay(); movePrev(); };

  tracks.forEach((track, index) => {
    track.onclick = () => {
      stopAutoplay();
      currentIndex = index;
      update();
    };
  });

  function startAutoplay() {
    stopAutoplay();
    const interval = parseInt(section.dataset.autoplayInterval) || 5000;
    autoplayTimer = setInterval(moveNext, interval);
  }

  function stopAutoplay() {
    if (autoplayTimer) clearInterval(autoplayTimer);
  }

  window.addEventListener('resize', () => {
    const max = getMaxIndex();
    if (currentIndex > max) currentIndex = max;
    update();
  });

  section.addEventListener('mouseenter', stopAutoplay);
  section.addEventListener('mouseleave', startAutoplay);

  // 初始化执行
  update();
  startAutoplay();
});
{% endjavascript %}