<div class="testimonial-carousel-section" data-autoplay-interval="{{ section.settings.autoplay_interval | default: 5000 }}">
  <div class="testimonial-carousel-container">
    <div class="testimonial-carousel-cards" id="testimonialCards">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div class="testimonial-card">
            {% if block.settings.button_link != blank %}
              <a href="{{ block.settings.button_link }}" target="{{ block.settings.button_target }}" class="testimonial-card__full-link">
            {% endif %}
            
            <div class="testimonial-card__image-box">
              <img src="{{ block.settings.image | image_url: width: 800 }}" alt="Case Study Image">
            </div>

            {% if block.settings.button_link != blank %}
              </a>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% if section.blocks.size > 0 %}
    <div class="testimonial-carousel-nav" id="testimonialNav">
      <span class="testimonial-nav-arrow--left">←</span>
      <div class="testimonial-nav-tracks">
        {% assign total_cards = section.blocks.size %}
        {% assign indicator_count = total_cards | minus: 2 %}
        {% if indicator_count < 1 %}{% assign indicator_count = 1 %}{% endif %}
        
        {% for i in (1..indicator_count) %}
          <span class="testimonial-nav-track" data-index="{{ forloop.index0 }}"></span>
        {% endfor %}
      </div>
      <span class="testimonial-nav-arrow--right">→</span>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "纯图片案例轮播",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "自动轮播间隔（毫秒）",
      "min": 2000,
      "max": 9000,
      "step": 500,
      "default": 5000
    }
  ],
  "blocks": [
    {
      "type": "image_card",
      "name": "图片卡片",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "上传案例图片"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "图片跳转链接"
        },
        {
          "type": "select",
          "id": "button_target",
          "label": "链接打开方式",
          "options": [
            { "value": "_self", "label": "当前窗口" },
            { "value": "_blank", "label": "新窗口" }
          ],
          "default": "_self"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "纯图片案例轮播"
    }
  ]
}
{% endschema %}

{% style %}
* {
  box-sizing: border-box;
}

.testimonial-carousel-section {
  max-width: 100%;
  margin: 30px auto;
  padding: 0 10px;
  overflow: hidden;
}

.testimonial-carousel-container {
  overflow: hidden;
  width: 100%;
}

.testimonial-carousel-cards {
  display: flex;
  transition: transform 0.5s ease;
}

.testimonial-card {
  flex: 0 0 calc(33.333% - 16px);
  margin: 0 8px;
  border-radius: 12px;
  overflow: hidden;
  position: relative;
  background: transparent; /* 移除了原来的红色背景 */
}

.testimonial-card__full-link {
  display: block;
  width: 100%;
  height: 100%;
  text-decoration: none;
}

.testimonial-card__image-box {
  width: 100%;
  aspect-ratio: 4 / 3; /* 你可以根据需要修改比例，如 1/1 或 16/9 */
}

.testimonial-card__image-box img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* 确保图片充满容器且不拉伸 */
  display: block;
}

/* 响应式适配 */
@media (max-width: 1200px) {
  .testimonial-card { flex: 0 0 calc(50% - 10px); }
}
@media (max-width: 768px) {
  .testimonial-card { flex: 0 0 calc(100% - 20px); }
  .testimonial-card__image-box { aspect-ratio: auto; height: 300px; }
}

/* 导航样式 */
.testimonial-carousel-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  margin-top: 20px;
}
.testimonial-nav-track {
  width: 25px;
  height: 2px;
  background-color: #ddd;
  cursor: pointer;
}
.testimonial-nav-track.active {
  width: 40px;
  background-color: #333; /* 导航点颜色 */
}
.testimonial-nav-arrow--left, .testimonial-nav-arrow--right {
  cursor: pointer;
  font-size: 18px;
}
{% endstyle %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  const cardContainer = document.getElementById('testimonialCards');
  const section = document.querySelector('.testimonial-carousel-section');
  if (!cardContainer || !section) return;

  const cards = cardContainer.querySelectorAll('.testimonial-card');
  const navTracks = document.querySelectorAll('.testimonial-nav-track');
  const navLeft = document.querySelector('.testimonial-nav-arrow--left');
  const navRight = document.querySelector('.testimonial-nav-arrow--right');
  const autoplayInterval = parseInt(section.dataset.autoplayInterval) || 5000;

  let currentIndex = 0;
  let autoplayTimer = null;

  function getVisibleCardCount() {
    if (window.innerWidth >= 1200) return 3;
    if (window.innerWidth >= 768) return 2;
    return 1;
  }

  function getMaxIndex() {
    return Math.max(cards.length - getVisibleCardCount(), 0);
  }

  function updateCarousel() {
    const card = cards[0];
    const style = window.getComputedStyle(card);
    const cardWidth = card.offsetWidth + parseFloat(style.marginLeft) + parseFloat(style.marginRight);
    
    cardContainer.style.transform = `translateX(${-currentIndex * cardWidth}px)`;

    // 更新导航点
    const maxIndex = getMaxIndex();
    const activeTrackIndex = maxIndex > 0 ? Math.round((currentIndex / maxIndex) * (navTracks.length - 1)) : 0;
    navTracks.forEach((track, idx) => {
      track.classList.toggle('active', idx === activeTrackIndex);
    });
  }

  function startAutoplay() {
    autoplayTimer = setInterval(() => {
      const max = getMaxIndex();
      currentIndex = currentIndex >= max ? 0 : currentIndex + 1;
      updateCarousel();
    }, autoplayInterval);
  }

  function stopAutoplay() {
    clearInterval(autoplayTimer);
  }

  navRight.addEventListener('click', () => {
    const max = getMaxIndex();
    currentIndex = Math.min(currentIndex + 1, max);
    updateCarousel();
    stopAutoplay();
  });

  navLeft.addEventListener('click', () => {
    currentIndex = Math.max(currentIndex - 1, 0);
    updateCarousel();
    stopAutoplay();
  });

  window.addEventListener('resize', updateCarousel);
  section.addEventListener('mouseenter', stopAutoplay);
  section.addEventListener('mouseleave', startAutoplay);

  updateCarousel();
  startAutoplay();
});
{% endjavascript %}