{% schema %}
{
  "name": "blossom veil",
  "settings": [
    {
      "type": "text",
      "id": "title_line1",
      "label": "标题1",
      "default": "blossom"
    },
    {
      "type": "text",
      "id": "title_line2",
      "label": "标题2",
      "default": "veil"
    },
    {
      "type": "image_picker",
      "id": "veil_image",
      "label": "背景图片"
    }
  ],
  "presets": [
    {
      "name": "blossom veil",
      "category": "特殊布局"
    }
  ]
}
{% endschema %}

<div class="veil-container">
  {% if section.settings.veil_image != blank %}
    <img
      width="100%"
      height="auto"
      src="{{ section.settings.veil_image | img_url: '2000x' }}"
      alt="blossom veil"
      class="veil-image"
    >
    <div class="veil-words">
      <h1 class="word serenity">{{ section.settings.title_line1 }}</h1>
      <span class="word love">{{ section.settings.title_line2 }}</span>
    </div>
  {% endif %}
</div>

<style>
  .veil-container {
    position: relative;
    width: 100%;
    height: 60vh;
    overflow: hidden;
  }

  .veil-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%) contrast(1.2);
  }

  .veil-words {
    {% comment %} display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center; {% endcomment %}
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    transform: translate(-50%, -50%);
    text-align: center;
  }

  .word {
    font-size: 5rem;
    font-weight: 600;
    color: white;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.3);
    mix-blend-mode: overlay;
    opacity: 0.9;
    margin: 1rem 0;
  }
  .serenity{
  font-size: 4rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5rem;
    color: white;
    text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.5);
    margin: 0;
    padding: 20px;
    background-color: rgba(0, 0, 0, 0.3);
    display: inline-block;
  }

  @media (max-width: 768px) {
    .word {
      font-size: 2.5rem;
    }
  }
</style>
