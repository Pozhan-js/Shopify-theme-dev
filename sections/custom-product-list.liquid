{% schema %}
{
  "name": "自定义产品网格列表",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "选择产品系列"
    },
    {
      "type": "header",
      "content": "文字样式"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "产品名称字体大小",
      "default": 16
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "产品名称字体粗细",
      "options": [
        {
          "value": "400",
          "label": "常规"
        },
        {
          "value": "600",
          "label": "半粗"
        },
        {
          "value": "700",
          "label": "加粗"
        }
      ],
      "default": "600"
    },
    {
      "type": "range",
      "id": "price_font_size",
      "min": 12,
      "max": 36,
      "step": 1,
      "unit": "px",
      "label": "产品价格字体大小",
      "default": 16
    },
    {
      "type": "select",
      "id": "price_font_weight",
      "label": "产品价格字体粗细",
      "options": [
        {
          "value": "400",
          "label": "常规"
        },
        {
          "value": "600",
          "label": "半粗"
        },
        {
          "value": "700",
          "label": "加粗"
        }
      ],
      "default": "400"
    }
  ],
  "presets": [
    {
      "name": "自定义产品网格列表"
    }
  ]
}
{% endschema %}

{%- style -%}
.pagination {
  margin-top: 3rem;
  text-align: center;
}
.pagination a,
.pagination .current {
  padding: 0.5rem 1rem;
  margin: 0 0.25rem;
  border: 1px solid #ddd;
  text-decoration: none;
}
.pagination .current {
  background: #000;
  color: #fff;
  border-color: #000;
}
.product-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  padding: 2rem 1rem 2rem 0;
  min-height: 60rem;
}

@media (max-width: 1024px) {
  .product-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  main#MainContent.content-for-layout {
    padding-left: 1.6rem !important;
  }
}
.product-card {
  display: flex;
  flex-direction: column;
  gap: 0;
}
.product-link {
  text-decoration: none;
  color: inherit;
  display: flex;
  flex-direction: column;
  gap: 0;
  transition: opacity 0.3s ease;
}
.product-link:hover {
  opacity: 0.8;
}
.product-image-container {
  position: relative;
  overflow: hidden;
  width: 100%;
  height: 0;
  padding-bottom: 100%; /* 1:1 Aspect Ratio */
}
.product-image-slider {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  transition: transform 0.4s ease-in-out;
}
.product-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  flex-shrink: 0;
}
h3.product-title {
  margin-block-start:0;
  margin-block-end:0;
}
.product-price {
  padding-bottom: 2rem;
  margin-top: 1rem;
}
.image-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(0,0,0,0.5);
  color: white;
  border: none;
  padding: 0.5rem;
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.3s ease;
  z-index: 10;
}
.product-image-container:hover .image-nav {
  opacity: 1;
}
.prev {
  left: 1rem;
}
.next {
  right: 1rem;
}
.product-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0;
}
.product-count {
  font-size: 1.8rem;
  font-weight: 600;
  color: #000;
}
.filter-btn {
  width:10rem;
  height:3rem;
  background: none;
  padding: 0.5rem 1rem;
  cursor: pointer;
  font-weight: 600;
  font-size: 2rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}
.filter-btn::before {
  content: "+";
  font-size: 3rem;
  font-weight: 600;
  transition: transform 0.3s ease;
}
.filter-sidebar.active ~ .product-header .filter-btn::after {
  transform: rotate(90deg);
}
{%- endstyle -%}

<!-- debug 产品系列头部信息 {{ section.settings.collection }}-->
<!-- debug page url {{ page.url }}-->
<!-- debug request.params: {{ request.params | json }} -->
<!-- debug request.path: {{ request.path }} -->
<!-- debug request.query_string: {{ request.query_string }} -->
<!-- debug request.query: {{ request.query | json }} -->

{%- comment -%} 显示调试信息在页面上 - 移到变量定义后 {%- endcomment -%}

{%- comment -%} 获取当前集合的多种方式 {%- endcomment -%}
{%- assign current_collection_handle = '' -%}

{%- comment -%} 方法1: 从page.url获取 {%- endcomment -%}
{%- if page.url contains '/collections/' -%}
  {%- assign url_parts = page.url | split: '/collections/' | last -%}
  {%- assign current_collection_handle = url_parts | split: '/' | first -%}
{%- endif -%}

{%- comment -%} 方法2: 从section设置获取 {%- endcomment -%}
{%- if section.settings.collection and current_collection_handle == '' -%}
  {%- assign current_collection_handle = section.settings.collection -%}
{%- endif -%}

{%- comment -%} 方法3: 使用默认collection对象 {%- endcomment -%}
{%- assign selected_collection = collections[current_collection_handle] | default: collection -%}

<!-- debug current_collection_handle: {{ current_collection_handle }}-->
<!-- debug selected_collection.title: {{ selected_collection.title }}-->
<!-- debug selected_collection.description: {{ selected_collection.description }} -->
<!-- debug selected_collection.handle: {{ selected_collection.handle }} -->
{%- if selected_collection -%}
  {%- comment -%} 获取URL参数 - 使用多种方式尝试获取 {%- endcomment -%}
  {%- assign brand_filters = '' -%}
  {%- assign type_filters = '' -%}
  {%- assign color_filters = '' -%}
  {%- assign size_filters = '' -%}
  
  {%- comment -%} 方法1: 使用 request.query (Shopify推荐方式) {%- endcomment -%}
  <!-- debug 开始request.query方法 -->
  {%- if request.query.brand -%}
    {%- assign brand_filters = request.query.brand -%}
    <!-- debug request.query.brand成功: {{ request.query.brand }} -->
  {%- else -%}
    <!-- debug request.query.brand不存在 -->
  {%- endif -%}
  {%- if request.query.type -%}
    {%- assign type_filters = request.query.type -%}
    <!-- debug request.query.type成功: {{ request.query.type }} -->
  {%- else -%}
    <!-- debug request.query.type不存在 -->
  {%- endif -%}
  {%- if request.query.color -%}
    {%- assign color_filters = request.query.color -%}
    <!-- debug request.query.color成功: {{ request.query.color }} -->
  {%- else -%}
    <!-- debug request.query.color不存在 -->
  {%- endif -%}
  {%- if request.query.size -%}
    {%- assign size_filters = request.query.size -%}
    <!-- debug request.query.size成功: {{ request.query.size }} -->
  {%- else -%}
    <!-- debug request.query.size不存在 -->
  {%- endif -%}
  
  {%- comment -%} 方法2: 使用 query_string 解析作为备选 {%- endcomment -%}
  <!-- debug 开始query_string解析方法 -->
  {%- if brand_filters == '' and request.query_string contains 'brand=' -%}
    <!-- debug query_string包含brand=，开始解析 -->
    {%- assign query_parts = request.query_string | split: '&' -%}
    {%- for part in query_parts -%}
      {%- if part contains 'brand=' -%}
        {%- assign brand_filters = part | split: '=' | last | url_decode -%}
        <!-- debug query_string解析brand成功: {{ brand_filters }} -->
      {%- endif -%}
      {%- if part contains 'type=' -%}
        {%- assign type_filters = part | split: '=' | last | url_decode -%}
        <!-- debug query_string解析type成功: {{ type_filters }} -->
      {%- endif -%}
      {%- if part contains 'color=' -%}
        {%- assign color_filters = part | split: '=' | last | url_decode -%}
        <!-- debug query_string解析color成功: {{ color_filters }} -->
      {%- endif -%}
      {%- if part contains 'size=' -%}
        {%- assign size_filters = part | split: '=' | last | url_decode -%}
        <!-- debug query_string解析size成功: {{ size_filters }} -->
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    <!-- debug query_string不包含相关参数或已获取到值 -->
  {%- endif -%}
  
  <!-- debug brand_filters: {{ brand_filters }} -->
  <!-- debug type_filters: {{ type_filters }} -->
  <!-- debug color_filters: {{ color_filters }} -->
  <!-- debug size_filters: {{ size_filters }} -->

<div class="collection-header" style="margin-bottom: 2rem; text-align: left;">
  {% if selected_collection %}
    <h2 style="font-weight: {{ section.settings.title_font_weight }}">{{ selected_collection.title }}</h2>
    {% if selected_collection.description != blank %}
      <p>{{ selected_collection.description }}</p>
    {% endif %}
  {% endif %}
</div>

{%- comment -%} 先初始化筛选计数 {%- endcomment -%}
{%- assign filtered_count = 0 -%}

<div class="product-header">
  <div class="product-count">
    {{ selected_collection.products_count }} products
  </div>
  <div class="filter-btn" onclick="toggleFilter()">Filter</div>
</div>

<div class="product-grid">
  {%- comment -%} 获取每页显示数量，默认24 {%- endcomment -%}
  {%- assign items_per_page = request.query.size | default: 24 | times: 1 -%}
  {%- if items_per_page <= 0 -%}
    {%- assign items_per_page = 24 -%}
  {%- endif -%}
  
  {%- comment -%} 获取排序方式 {%- endcomment -%}
  {%- assign sort_by = request.query.sort_by | default: 'manual' -%}
  <!-- debug 排序方式: {{ sort_by }} -->
  
  {%- comment -%} 显示完整的调试信息在页面上 {%- endcomment -%}
  <div style="background: #f0f0f0; border: 2px solid #ff0000; padding: 10px; margin: 10px 0; font-family: monospace; font-size: 12px;">
    <h4 style="color: #ff0000; margin: 0 0 10px 0;">🔍 完整调试信息</h4>
    <div><strong>当前URL:</strong> {{ page.url }}</div>
    <div><strong>查询字符串:</strong> {{ request.query_string }}</div>
    <div><strong>request.query对象:</strong> {{ request.query | json }}</div>
    <div><strong>request.params对象:</strong> {{ request.params | json }}</div>
    <hr style="margin: 10px 0;">
    <div><strong>sort_by参数:</strong> {{ request.query.sort_by | default: '未获取到' }}</div>
    <div><strong>size参数:</strong> {{ request.query.size | default: '未获取到' }}</div>
    <div><strong>brand参数:</strong> {{ request.query.brand | default: '未获取到' }}</div>
    <div><strong>type参数:</strong> {{ request.query.type | default: '未获取到' }}</div>
    <div><strong>color参数:</strong> {{ request.query.color | default: '未获取到' }}</div>
    <hr style="margin: 10px 0;">
    <div><strong>解析后的sort_by:</strong> {{ sort_by }}</div>
    <div><strong>解析后的items_per_page:</strong> {{ items_per_page }}</div>
    <div><strong>解析后的brand_filters:</strong> {{ brand_filters | default: '空' }}</div>
    <div><strong>解析后的type_filters:</strong> {{ type_filters | default: '空' }}</div>
    <div><strong>解析后的color_filters:</strong> {{ color_filters | default: '空' }}</div>
    <div><strong>解析后的size_filters:</strong> {{ size_filters | default: '空' }}</div>
    <hr style="margin: 10px 0;">
    <div><strong>当前集合句柄:</strong> {{ current_collection_handle | default: '空' }}</div>
    <div><strong>选中集合:</strong> {{ selected_collection.title | default: '未找到' }}</div>
    <div><strong>集合产品数量:</strong> {{ selected_collection.products_count }}</div>
  </div>
  {%- assign page_param = request.path | split: 'page=' | last -%}
  {%- if page_param contains '&' -%}
    {%- assign current_page = page_param | split: '&' | first | times: 1 -%}
  {%- elsif page_param != request.path -%}
    {%- assign current_page = page_param | times: 1 -%}
  {%- endif -%}
  
  {%- comment -%} 根据排序方式获取产品列表 {%- endcomment -%}
  {%- assign sorted_products = selected_collection.products -%}
  {%- case sort_by -%}
    {%- when 'best-selling' -%}
      {%- assign sorted_products = selected_collection.products | sort: 'sales' | reverse -%}
    {%- when 'title-ascending' -%}
      {%- assign sorted_products = selected_collection.products | sort: 'title' -%}
    {%- when 'title-descending' -%}
      {%- assign sorted_products = selected_collection.products | sort: 'title' | reverse -%}
    {%- when 'price-ascending' -%}
      {%- assign sorted_products = selected_collection.products | sort: 'price' -%}
    {%- when 'price-descending' -%}
      {%- assign sorted_products = selected_collection.products | sort: 'price' | reverse -%}
    {%- when 'created-ascending' -%}
      {%- assign sorted_products = selected_collection.products | sort: 'created_at' -%}
    {%- when 'created-descending' -%}
      {%- assign sorted_products = selected_collection.products | sort: 'created_at' | reverse -%}
    {%- else -%}
      {%- assign sorted_products = selected_collection.products -%}
  {%- endcase -%}
  
  {%- for product in sorted_products -%}
    {%- assign include_product = true -%}
    
    {%- comment -%} 显示每个产品的调试信息 {%- endcomment -%}
    <!-- debug 产品 {{ forloop.index }}: {{ product.title }} | vendor: {{ product.vendor }} | type: {{ product.type }} -->
    
    {%- comment -%} 品牌筛选 {%- endcomment -%}
    {%- if brand_filters != blank -%}
      {%- assign brand_match = false -%}
      {%- assign brand_array = brand_filters | split: '+' -%}
      <!-- debug 品牌筛选 - brand_filters: {{ brand_filters }}, brand_array: {{ brand_array | json }}, product.vendor: {{ product.vendor }} -->
      {%- for brand in brand_array -%}
        {%- if product.vendor == brand -%}
          {%- assign brand_match = true -%}
          <!-- debug 品牌匹配成功: {{ brand }} == {{ product.vendor }} -->
        {%- endif -%}
      {%- endfor -%}
      {%- unless brand_match -%}
        {%- assign include_product = false -%}
        <!-- debug 品牌筛选未通过 -->
      {%- else -%}
        <!-- debug 品牌筛选通过 -->
      {%- endunless -%}
    {%- endif -%}
    
    {%- comment -%} 产品类型筛选 {%- endcomment -%}
    {%- if type_filters != blank and include_product -%}
      {%- assign type_match = false -%}
      {%- assign type_array = type_filters | split: '+' -%}
      {%- for type in type_array -%}
        {%- if product.type == type -%}
          {%- assign type_match = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless type_match -%}
        {%- assign include_product = false -%}
      {%- endunless -%}
    {%- endif -%}
    
    {%- comment -%} 颜色筛选 {%- endcomment -%}
    {%- if color_filters != blank and include_product -%}
      {%- assign color_match = false -%}
      {%- assign color_array = color_filters | split: '+' -%}
      {%- for color in color_array -%}
        {%- if product.title contains color -%}
          {%- assign color_match = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless color_match -%}
        {%- assign include_product = false -%}
      {%- endunless -%}
    {%- endif -%}
    
    {%- comment -%} 尺码筛选 {%- endcomment -%}
    {%- if size_filters != blank and include_product -%}
      {%- assign size_match = false -%}
      {%- assign size_array = size_filters | split: '+' -%}
      {%- for size in size_array -%}
        {%- if product.title contains size -%}
          {%- assign size_match = true -%}
        {%- endif -%}
      {%- endfor -%}
      {%- unless size_match -%}
        {%- assign include_product = false -%}
      {%- endunless -%}
    {%- endif -%}
    
    {%- if include_product -%}
      {%- assign filtered_count = filtered_count | plus: 1 -%}
      <!-- debug 产品 {{ product.title }} 通过筛选，当前筛选计数: {{ filtered_count }} -->
      {%- assign current_index = forloop.index0 -%}
      {%- assign start_index = current_page | minus: 1 | times: items_per_page -%}
      {%- assign end_index = start_index | plus: items_per_page -%}
      
      {%- if current_index >= start_index and current_index < end_index -%}
        <div class="product-card">
          <a href="{{ product.url }}" class="product-link">
            <div class="product-image-container">
              <div class="product-image-slider" data-current="0" data-count="{{ product.images.size }}">
                {% for image in product.images %}
                  <img class="product-image" src="{{ image | image_url: width: 400 }}" alt="{{ product.title }}" width="400" height="400" loading="lazy">
                {% endfor %}
              </div>
              {% if product.images.size > 1 %}
                <button class="image-nav prev" onclick="prevImage(event, this)">❮</button>
                <button class="image-nav next" onclick="nextImage(event, this)">❯</button>
              {% endif %}
            </div>

            <h3 class="product-title" style="font-size: {{ section.settings.title_font_size }}px; font-weight: {{ section.settings.title_font_weight }}">{{ product.title }}</h3>
            <div class="product-price" style="font-size: {{ section.settings.price_font_size }}px; font-weight: {{ section.settings.price_font_weight }}">{{ product.price | money }}</div>
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}
  {% endfor %}

</div>

{%- comment -%} 显示最终筛选统计 {%- endcomment -%}
<div style="background: #e8f4f8; border: 1px solid #0066cc; padding: 8px; margin: 5px 0; font-family: monospace; font-size: 11px;">
  <strong>📊 最终筛选统计:</strong>
  总数: {{ selected_collection.products_count }} | 
  筛选后: {{ filtered_count }} | 
  每页: {{ items_per_page }} | 
  排序: {{ sort_by }} |
  总页数: {{ filtered_count | divided_by: items_per_page | ceil }}
</div>

{%- assign total_pages = filtered_count | divided_by: items_per_page | ceil -%}

<div class="pagination">
  {% if total_pages > 1 %}
    {%- assign base_url = request.path -%}
    
    {%- comment -%} 构建保留排序和每页数量的查询字符串 {%- endcomment -%}
    {%- assign query_params = '' -%}
    {%- if sort_by != 'manual' -%}
      {%- assign query_params = query_params | append: 'sort_by=' | append: sort_by -%}
    {%- endif -%}
    {%- if items_per_page != 24 -%}
      {%- if query_params != blank -%}
        {%- assign query_params = query_params | append: '&' -%}
      {%- endif -%}
      {%- assign query_params = query_params | append: 'size=' | append: items_per_page -%}
    {%- endif -%}
    
    {%- if current_page > 1 -%}
      <a href="{{ base_url }}?page={{ current_page | minus: 1 }}{% if query_params != blank %}&{{ query_params }}{% endif %}">Previous</a>
    {%- endif -%}
    
    {%- for page_num in (1..total_pages) -%}
      {%- if page_num == current_page -%}
        <span class="current">{{ page_num }}</span>
      {%- else -%}
        <a href="{{ base_url }}?page={{ page_num }}{% if query_params != blank %}&{{ query_params }}{% endif %}">{{ page_num }}</a>
      {%- endif -%}
    {%- endfor -%}
    
    {%- if current_page < total_pages -%}
      <a href="{{ base_url }}?page={{ current_page | plus: 1 }}{% if query_params != blank %}&{{ query_params }}{% endif %}">Next</a>
    {%- endif -%}
  {% endif %}
</div>
{%- else -%}
  <p>请选择一个产品系列</p>
{%- endif -%}

<div id="filter-sidebar" class="filter-sidebar">
  {% render 'custom-product-filter' %}
</div>

<script>
  function toggleFilter() {
    const sidebar = document.getElementById('filter-sidebar');
    if (sidebar) {
      sidebar.classList.toggle('active');
    }
  }

  function prevImage(event, button) {
    event.preventDefault();
    event.stopPropagation();
    
    const container = button.parentNode;
    const slider = container.querySelector('.product-image-slider');
    const imageCount = parseInt(slider.dataset.count);
    let currentIndex = parseInt(slider.dataset.current);
    
    currentIndex = (currentIndex - 1 + imageCount) % imageCount;
    slider.dataset.current = currentIndex;
    
    const translateX = -currentIndex * 100;
    slider.style.transform = `translateX(${translateX}%)`;
  }

  function nextImage(event, button) {
    event.preventDefault();
    event.stopPropagation();
    
    const container = button.parentNode;
    const slider = container.querySelector('.product-image-slider');
    const imageCount = parseInt(slider.dataset.count);
    let currentIndex = parseInt(slider.dataset.current);
    
    currentIndex = (currentIndex + 1) % imageCount;
    slider.dataset.current = currentIndex;
    
    const translateX = -currentIndex * 100;
    slider.style.transform = `translateX(${translateX}%)`;
  }
</script>