<div class="aftersales-support-banner">
  <div class="aftersales-support-container">
    <div class="aftersales-support-content">
      <h2 class="aftersales-support-title">
        {{ section.settings.title | default: "After-sales Support" }}
      </h2>
      <p class="aftersales-support-description">
        {{ section.settings.description | default: "We provide comprehensive after-sales support to ensure your Pilates equipment continues to perform at its best. From warranty coverage to technical assistance, our dedicated team is here to help you every step of the way." }}
      </p>
    </div>
  </div>
</div>

<style>
.aftersales-support-banner {
  background-color: #F1F0ED;
  padding: 80px 0;
}

.aftersales-support-container {
  max-width: 1520px;
  margin: 0 auto;
  padding: 0 20px;
}

.aftersales-support-content {
  text-align: left;
}

.aftersales-support-title {
  font-size: 48px;
  font-weight: 500;
  color: #161616;
  margin: 0 0 24px 0;
  line-height: 1.2;
}

.aftersales-support-description {
  font-size: 18px;
  font-weight: 400;
  color: #161616;
  margin: 0;
  line-height: 1.6;
  max-width: 800px;
}

/* 响应式设计 - 基于1920px设计图按比例缩放 */

/* 大屏幕 (1920px+) - 使用设计图精确尺寸 */
@media (min-width: 1920px) {
  .aftersales-support-banner {
    padding: 80px 0;
  }
  
  .aftersales-support-container {
    max-width: 1520px;
  }
  
  .aftersales-support-title {
    font-size: 48px;
    margin-bottom: 24px;
  }
  
  .aftersales-support-description {
    font-size: 18px;
  }
}

/* 笔记本电脑 (1366px - 1919px) - 按比例缩放 (约0.84倍) */
@media (max-width: 1919px) and (min-width: 1366px) {
  .aftersales-support-banner {
    padding: 67px 0; /* 80 * 0.84 */
  }
  
  .aftersales-support-container {
    max-width: 1277px; /* 1520 * 0.84 */
  }
  
  .aftersales-support-title {
    font-size: 40px; /* 48 * 0.84 */
    margin-bottom: 20px; /* 24 * 0.84 */
  }
  
  .aftersales-support-description {
    font-size: 15px; /* 18 * 0.84 */
    max-width: 672px; /* 800 * 0.84 */
  }
}

/* 小笔记本 (1024px - 1365px) - 按比例缩放 (约0.67倍) */
@media (max-width: 1365px) and (min-width: 1024px) {
  .aftersales-support-banner {
    padding: 54px 0; /* 80 * 0.67 */
  }
  
  .aftersales-support-container {
    max-width: 1018px; /* 1520 * 0.67 */
    padding: 0 30px;
  }
  
  .aftersales-support-title {
    font-size: 32px; /* 48 * 0.67 */
    margin-bottom: 16px; /* 24 * 0.67 */
  }
  
  .aftersales-support-description {
    font-size: 12px; /* 18 * 0.67 */
    max-width: 536px; /* 800 * 0.67 */
  }
}

/* 平板横屏 (768px - 1023px) - 按比例缩放 (约0.5倍) */
@media (max-width: 1023px) and (min-width: 768px) {
  .aftersales-support-banner {
    padding: 40px 0; /* 80 * 0.5 */
  }
  
  .aftersales-support-container {
    padding: 0 25px;
  }
  
  .aftersales-support-title {
    font-size: 24px; /* 48 * 0.5 */
    margin-bottom: 12px; /* 24 * 0.5 */
  }
  
  .aftersales-support-description {
    font-size: 9px; /* 18 * 0.5 */
    max-width: 400px; /* 800 * 0.5 */
  }
}

/* 平板竖屏和大手机 (481px - 767px) - 按比例缩放 (约0.4倍) */
@media (max-width: 767px) and (min-width: 481px) {
  .aftersales-support-banner {
    padding: 32px 0; /* 80 * 0.4 */
  }
  
  .aftersales-support-container {
    padding: 0 20px;
  }
  
  .aftersales-support-content {
    text-align: center;
  }
  
  .aftersales-support-title {
    font-size: 19px; /* 48 * 0.4 */
    margin-bottom: 10px; /* 24 * 0.4 */
  }
  
  .aftersales-support-description {
    font-size: 7px; /* 18 * 0.4 */
    max-width: 320px; /* 800 * 0.4 */
    margin: 0 auto;
  }
}

/* 小手机 (320px - 480px) - 按比例缩放 (约0.33倍) */
@media (max-width: 480px) {
  .aftersales-support-banner {
    padding: 26px 0; /* 80 * 0.33 */
  }
  
  .aftersales-support-container {
    padding: 0 15px;
  }
  
  .aftersales-support-content {
    text-align: center;
  }
  
  .aftersales-support-title {
    font-size: 16px; /* 48 * 0.33 */
    margin-bottom: 8px; /* 24 * 0.33 */
  }
  
  .aftersales-support-description {
    font-size: 6px; /* 18 * 0.33 */
    max-width: 264px; /* 800 * 0.33 */
    margin: 0 auto;
  }
}

/* 超小屏幕 (最小320px) - 按比例缩放 (约0.25倍) */
@media (max-width: 320px) {
  .aftersales-support-banner {
    padding: 20px 0; /* 80 * 0.25 */
  }
  
  .aftersales-support-content {
    text-align: center;
  }
  
  .aftersales-support-title {
    font-size: 12px; /* 48 * 0.25 */
    margin-bottom: 6px; /* 24 * 0.25 */
  }
  
  .aftersales-support-description {
    font-size: 5px; /* 18 * 0.25 */
    max-width: 200px; /* 800 * 0.25 */
    margin: 0 auto;
  }
}
</style>

{% schema %}
{
  "name": "Aftersales Support",
  "tag": "section",
  "class": "aftersales-support-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Banner Title",
      "default": "After-sales Support"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Banner Description",
      "default": "We provide comprehensive after-sales support to ensure your Pilates equipment continues to perform at its best. From warranty coverage to technical assistance, our dedicated team is here to help you every step of the way."
    }
  ],
  "presets": [
    {
      "name": "Aftersales Support",
      "settings": {
        "title": "After-sales Support",
        "description": "We provide comprehensive after-sales support to ensure your Pilates equipment continues to perform at its best. From warranty coverage to technical assistance, our dedicated team is here to help you every step of the way."
      }
    }
  ]
}
{% endschema %}
