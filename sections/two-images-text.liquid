{% comment %}
  Section: 双图左 + 文本右
  描述：左侧两张图片上下排列，每张图最大高度 300px；右侧可编辑富文本
{% endcomment %}

<div
  class="two-images-text-section"
  style="
    display: flex;
    gap: 30px;
    align-items: stretch;
    padding: 40px 20px;
    max-width: 1200px;
    margin: 0 auto;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    box-sizing: border-box;
  "
>
  <!-- 左侧：两张图片，每张最大高度 300px -->
  <div
    class="image-group"
    style="
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 15px;
    "
  >
    {% if section.settings.image_top != blank %}
      <div
        class="image-top"
        style="
          overflow: hidden;
          border-radius: 8px;
          background-color: #f5f5f5;
          height: 300px;
          display: flex;
          align-items: center;
          justify-content: center;
          overflow:scroll;
        "
      >
        {{
          section.settings.image_top
          | img_url: '500x'
          | img_tag: '', 'style=width: 100%; height: auto; max-height: 300px; object-fit: contain;'
        }}
      </div>
    {% endif %}

    {% if section.settings.image_bottom != blank %}
      <div
        class="image-bottom"
        style="
          overflow: hidden;
          border-radius: 8px;
          background-color: #f5f5f5;
          height: 300px;
          display: flex;
          align-items: center;
          justify-content: center;
             overflow:scroll;
        "
      >
        {{
          section.settings.image_bottom
          | img_url: '500x'
          | img_tag: '', 'style=width: 100%; height: auto; max-height: 300px; object-fit: contain;'
        }}
      </div>
    {% endif %}
  </div>

  <!-- 右侧：富文本内容，垂直居中 -->
  <div
    class="text-content"
    style="
      flex: 1;
      display: flex;
      align-items: center;
      padding: 10px 0;
    "
  >
    <div>{{ section.settings.text_content }}</div>
  </div>
</div>

{% schema %}
{
  "name": "双图左 + 文本右",
  "class": "two-images-text-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_top",
      "label": "上方图片"
    },
    {
      "type": "image_picker",
      "id": "image_bottom",
      "label": "下方图片"
    },
    {
      "type": "richtext",
      "id": "text_content",
      "label": "右侧富文本",
      "default": "<h2>欢迎来到我们的商店</h2><p>在这里你可以编辑文字内容，支持加粗、链接、列表等富文本格式。</p>"
    }
  ],
  "presets": [
    {
      "name": "双图左 + 文本右",
      "category": "内容"
    }
  ]
}
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

