{% comment %}
  Section: 双图左 + 文本右
  描述：左侧两张图片上下排列，每张图最大高度 300px；右侧可编辑富文本
  已优化移动端显示：竖向堆叠，图片高度自适应，排版清晰
{% endcomment %}

<div
  class="two-images-text-section"
  style="
    display: flex;
    gap: 30px;
    flex-wrap: wrap;
    padding: 40px 20px;
    margin: 0 auto;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    box-sizing: border-box;
  "
>
  <!-- 左侧：两张图片，每张最大高度 300px -->
  <div
    class="image-group"
    style="
      flex: 1 1 400px;
      display: flex;
      flex-direction: column;
      gap: 15px;
    "
  >
    {% if section.settings.image_top != blank %}
      <div
        style="
          overflow: hidden;
          border-radius: 8px;
          height: 300px;
          display: flex;
          align-items: center;
          justify-content: center;
        "
      >
        {{
          section.settings.image_top
          | img_url: '500x'
          | img_tag: '', 'style=width: 100%; height: auto; max-height: 300px; object-fit: contain;'
        }}
      </div>
    {% endif %}

    {% if section.settings.image_bottom != blank %}
      <div
        style="
          overflow: hidden;
          border-radius: 8px;
          height: 300px;
          display: flex;
          align-items: center;
          justify-content: center;
        "
      >
        {{
          section.settings.image_bottom
          | img_url: '500x'
          | img_tag: '', 'style=width: 100%; height: auto; max-height: 300px; object-fit: contain;'
        }}
      </div>
    {% endif %}
  </div>

  <!-- 右侧：富文本内容 -->
  <div
    class="text-content"
    style="
      flex: 1 1 400px;
      display: flex;
      align-items: center;
      padding: 10px 0;
    "
  >
    <div
      style="
        width: 100%;
        line-height: 1.6;
        color: #333;
      "
    >
      {{ section.settings.text_content }}
    </div>
  </div>
</div>

<style>
  /* 移动端适配：屏幕小于 750px 时堆叠布局 */
  @media (max-width: 749px) {
    .two-images-text-section {
      flex-direction: column;
      padding: 20px 15px;
    }

    .two-images-text-section .image-group > div,
    .two-images-text-section .image-group > div img {
      height: 220px !important;
      max-height: 220px !important;
    }

    .text-content {
      order: 1;
      margin-top: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "双图左 + 文本右",
  "class": "two-images-text-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image_top",
      "label": "上方图片"
    },
    {
      "type": "image_picker",
      "id": "image_bottom",
      "label": "下方图片"
    },
    {
      "type": "richtext",
      "id": "text_content",
      "label": "右侧富文本",
      "default": "<h2>欢迎来到我们的商店</h2><p>在这里你可以编辑文字内容，支持加粗、链接、列表等富文本格式。</p>"
    }
  ],
  "presets": [
    {
      "name": "双图左 + 文本右",
      "category": "内容"
    }
  ]
}
{% endschema %}
