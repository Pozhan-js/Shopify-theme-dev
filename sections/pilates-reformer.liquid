</style>

<div class="prf-pilates-reformer-section">
  <div class="prf-container">
    <div class="prf-product-layout">
      <!-- 左侧图片区域 -->
      <div class="prf-image-section">
        <div class="prf-main-image">
          <img 
            id="prf-main-product-image" 
            class="prf-main-product-image" 
            src="{{ section.settings.mainimage | img_url: 'master' }}" 
            alt="{{ section.settings.producttitle }}"
          >
        </div>
        
        <div class="prf-thumbnail-images">
          {% for block in section.blocks %}
            {% if block.type == 'image' %}
              <div class="prf-thumbnail-item {% if forloop.first %}prf-active{% endif %}" 
                   onclick="prfChangeImage('{{ block.settings.image | img_url: 'master' }}', this)">
                <img 
                  class="prf-thumbnail-image" 
                  src="{{ block.settings.image | img_url: 'master' }}" 
                  alt="Product view {{ forloop.index }}"
                >
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <!-- 右侧产品信息区域 -->
      <div class="prf-product-info">
        <h1 class="prf-product-title">{{ section.settings.producttitle }}</h1>
        
        <div class="prf-model-info">
          <span class="prf-model-label">{{ section.settings.modellabel }}:</span>
          <span class="prf-model-value">{{ section.settings.modelvalue }}</span>
        </div>

        <div class="prf-customization-section">
          <h2 class="prf-customization-title">{{ section.settings.customizationtitle }}</h2>
          <p class="prf-customization-description">{{ section.settings.customizationdescription }}</p>
        </div>

        <!-- 颜色选择区域 -->
        <div class="prf-color-selection">
          <h3 class="prf-color-title">{{ section.settings.colortitle }}</h3>
          <div class="prf-color-options">
            {% for block in section.blocks %}
              {% if block.type == 'color' %}
                <div class="prf-color-option {% if forloop.first %}prf-selected{% endif %}" 
                     onclick="prfSelectColor(this)">
                  <div class="prf-color-swatch" style="background-color: {{ block.settings.colorvalue }};">
                    <div class="prf-color-checkmark">
                      <svg viewBox="0 0 24 24">
                        <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                      </svg>
                    </div>
                  </div>
                  <span class="prf-color-name">{{ block.settings.colorname }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function prfChangeImage(imageSrc, thumbnailElement) {
    // 更新主图
    document.getElementById('prf-main-product-image').src = imageSrc;
    
    // 更新缩略图激活状态
    document.querySelectorAll('.prf-thumbnail-item').forEach(item => {
      item.classList.remove('prf-active');
    });
    thumbnailElement.classList.add('prf-active');
  }

  function prfSelectColor(colorElement) {
    // 移除所有选中状态
    document.querySelectorAll('.prf-color-option').forEach(option => {
      option.classList.remove('prf-selected');
    });
    
    // 添加选中状态到当前元素
    colorElement.classList.add('prf-selected');
  }
</script>

{% schema %}
{
  "name": "Pilates Reformer Product",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "range",
      "id": "sectionpaddingtop",
