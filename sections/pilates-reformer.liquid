      "default": "Customization Options"
    },
    {
      "type": "range",
      "id": "customizationtitlesize",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Customization title font size",
      "default": 24
    },
    {
      "type": "select",
      "id": "customizationtitleweight",
      "label": "Customization title font weight",
