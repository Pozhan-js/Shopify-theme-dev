<div class="prf-pilates-reformer-section" {{ section.shopifyattributes }}>
  <div class="prf-container">
    <div class="prf-product-layout">
      <!-- 左侧产品图片区域 -->
      <div class="prf-product-images">
        <!-- 主图 -->
        <div class="prf-main-image">
          {% comment %} 优先使用当前产品页面的产品，然后是设置中选择的产品，最后是回退图片 {% endcomment %}
          {% assign current_product = product %}
          {% assign selected_product = all_products[section.settings.producthandle] %}
          {% assign display_product = current_product | default: selected_product %}

          {% if display_product and display_product.images.size > 0 %}
            <img
              src="{{ display_product.images.first | image_url: width: 1200 }}"
              alt="{{ display_product.title }}"
              class="prf-main-product-image"
              id="prf-main-product-image"
            >
          {% elsif section.settings.fallbackimage %}
            <img
              src="{{ section.settings.fallbackimage | image_url: width: 1200 }}"
              alt="{{ section.settings.producttitle }}"
              class="prf-main-product-image"
              id="prf-main-product-image"
            >
          {% endif %}
        </div>

        <!-- 缩略图 -->
        <div class="prf-thumbnail-images">
          {% if display_product and display_product.images.size > 0 %}
            {% for image in display_product.images %}
              <div
                class="prf-thumbnail-item {% if forloop.first %}prf-active{% endif %}"
                data-image-url="{{ image | image_url: width: 1200 }}"
              >
                <img
                  src="{{ image | image_url: width: 150 }}"
                  alt="Product image {{ forloop.index }}"
                  class="prf-thumbnail-image"
                >
              </div>
            {% endfor %}
          {% else %}
            {% for block in section.blocks %}
              {% if block.type == 'thumbnail' %}
                <div
                  class="prf-thumbnail-item"
                  {{ block.shopifyattributes }}
                  data-image-url="{{ block.settings.thumbnailimage | image_url: width: 1200 }}"
                >
                  {% if block.settings.thumbnailimage %}
                    <img
                      src="{{ block.settings.thumbnailimage | image_url: width: 150 }}"
                      alt="Product thumbnail"
                      class="prf-thumbnail-image"
                    >
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <!-- 右侧产品信息区域 -->
      <div class="prf-product-info">
        <!-- 产品标题和型号 -->
        <div class="prf-product-header">
          {% if display_product %}
            <h1 class="prf-product-title">{{ display_product.title }}</h1>
            {% if display_product.metafields.custom.tag %}
              <div class="prf-model-info">
                <span class="prf-model-number">
                  Model No: {{ display_product.metafields.custom.tag }}
                </span>
              </div>
            {% endif %}
          {% else %}
            <h1 class="prf-product-title">{{ section.settings.producttitle }}</h1>
            {% assign fallback_model = section.settings.modelnumber %}
            {% if fallback_model and fallback_model != blank %}
              <div class="prf-model-info">
                <span class="prf-model-number">Model No: {{ fallback_model }}</span>
              </div>
            {% endif %}
          {% endif %}
        </div>

        <!-- 定制询问区域 -->
        {% comment %} 根据产品元字段custom.color_show来判断显示隐藏 {% endcomment %}
        {% assign show_customization = false %}
        {% if display_product and display_product.metafields.custom.color_show %}
          {% assign show_customization = display_product.metafields.custom.color_show %}
        {% elsif section.settings.showcustomizationsection %}
          {% assign show_customization = true %}
        {% endif %}
        
        {% if show_customization %}
          <div class="prf-customization-section">
            <h2 class="prf-customization-title">{{ section.settings.customizationtitle }}</h2>
            <p class="prf-customization-description">{{ section.settings.customizationdescription }}</p>

            {% if section.settings.quotebuttontext %}
              {% assign quotelink = section.settings.quotebuttonlink %}
              {% if quotelink == blank and display_product %}
                {% assign quotelink = '/pages/contact?product=' | append: display_product.handle %}
              {% endif %}
              <a href="{{ quotelink }}" class="prf-quote-button">
                {{ section.settings.quotebuttontext }}
              </a>
            {% endif %}
          </div>
        {% endif %}

        <!-- 颜色选择区域 -->
        {% comment %} 根据产品元字段custom.color_show来判断显示隐藏 {% endcomment %}
        {% assign show_color_selection = false %}
        {% if display_product and display_product.metafields.custom.color_show %}
          {% assign show_color_selection = display_product.metafields.custom.color_show %}
        {% elsif section.settings.showcolorselection %}
          {% assign show_color_selection = true %}
        {% endif %}
        
        {% if show_color_selection %}
          <div class="prf-color-selection">
            <h3 class="prf-color-title">{{ section.settings.colorsectiontitle }}</h3>
            <div class="prf-color-options">
              {% comment %} 优先显示区块配置的颜色选项，确保总是有内容显示 {% endcomment %}
              {% assign has_colors = false %}
              
              {% comment %} 首先尝试从产品获取颜色选项 {% endcomment %}
              {% if display_product and display_product.options_with_values.size > 0 %}
                {% assign firstcolorprocessed = false %}
                {% assign coloroptionname = section.settings.coloroptionname | default: 'Color' %}
                
                {% for option in display_product.options_with_values %}
                  {% assign optionnamelower = option.name | downcase %}
                  {% assign targetnamelower = coloroptionname | downcase %}
                  
                  {% if optionnamelower == targetnamelower or optionnamelower == '颜色' or optionnamelower == 'color' or optionnamelower == 'colour' or optionnamelower == 'upholstery' or optionnamelower == 'fabric' %}
                    {% assign has_colors = true %}
                    {% for value in option.values %}
                      {% assign variantfound = false %}
                      {% assign variantid = '' %}
                      {% assign variantimage = '' %}
                      {% assign colorhex = '#CCCCCC' %}
                      
                      {% comment %} 尝试获取颜色值 {% endcomment %}
                      {% assign colorswatch = value.swatch %}
                      {% if colorswatch and colorswatch.color %}
                        {% assign colorhex = colorswatch.color %}
                      {% else %}
                        {% assign valuelower = value | downcase %}
                        {% case valuelower %}
                          {% when 'black' %}
                            {% assign colorhex = '#000000' %}
                          {% when 'white' %}
                            {% assign colorhex = '#FFFFFF' %}
                          {% when 'red' %}
                            {% assign colorhex = '#FF0000' %}
                          {% when 'blue' %}
                            {% assign colorhex = '#0000FF' %}
                          {% when 'green' %}
                            {% assign colorhex = '#008000' %}
                          {% when 'gray', 'grey' %}
                            {% assign colorhex = '#808080' %}
                          {% when 'steel gray', 'steel grey' %}
                            {% assign colorhex = '#71797E' %}
                          {% when 'brown' %}
                            {% assign colorhex = '#8B4513' %}
                          {% when 'navy' %}
                            {% assign colorhex = '#000080' %}
                          {% when 'beige' %}
                            {% assign colorhex = '#F5F5DC' %}
                          {% when 'tan' %}
                            {% assign colorhex = '#D2B48C' %}
                          {% else %}
                            {% assign colorhex = '#CCCCCC' %}
                        {% endcase %}
                      {% endif %}
                      
                      {% comment %} 查找对应的变体 {% endcomment %}
                      {% for variant in display_product.variants %}
                        {% assign valuematches = false %}
                        
                        {% if variant.option1 == value %}
                          {% assign valuematches = true %}
                        {% elsif variant.option2 == value %}
                          {% assign valuematches = true %}
                        {% elsif variant.option3 == value %}
                          {% assign valuematches = true %}
                        {% endif %}
                        
                        {% if valuematches and variantfound == false %}
                          {% assign variantfound = true %}
                          {% assign variantid = variant.id %}
                          
                          {% if variant.image %}
                            {% assign variantimage = variant.image | image_url: width: 1200 %}
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                      
                      {% unless colorhex contains '#' %}
                        {% if colorhex != '' %}
                          {% assign colorhex = '#' | append: colorhex %}
                        {% else %}
                          {% assign colorhex = '#CCCCCC' %}
                        {% endif %}
                      {% endunless %}
                      
                      <div class="prf-color-option {% unless firstcolorprocessed %}prf-selected{% endunless %}" 
                           data-color="{{ value }}"
                           data-variant-id="{{ variantid }}"
                           data-variant-image="{{ variantimage }}"
                           data-color-hex="{{ colorhex }}">
                        <div class="prf-color-swatch" style="background-color: {{ colorhex }};">
                          {% unless firstcolorprocessed %}
                            <div class="prf-color-checkmark">
                              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" fill="white"/>
                              </svg>
                            </div>
                            {% assign firstcolorprocessed = true %}
                          {% endunless %}
                        </div>
                        <span class="prf-color-name">{{ value }}</span>
                      </div>
                    {% endfor %}
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% endif %}
              
              {% comment %} 如果没有从产品获取到颜色，或者没有产品，使用区块配置的颜色 {% endcomment %}
              {% unless has_colors %}
                {% for block in section.blocks %}
                  {% if block.type == 'coloroption' %}
                    <div class="prf-color-option {% if block.settings.isselected %}prf-selected{% endif %}"
                         {{ block.shopifyattributes }}
                         data-color="{{ block.settings.colorname }}"
                         data-color-hex="{{ block.settings.colorvalue }}">
                      <div class="prf-color-swatch" style="background-color: {{ block.settings.colorvalue }};">
                        {% if block.settings.isselected %}
                          <div class="prf-color-checkmark">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" fill="white"/>
                            </svg>
                          </div>
                        {% endif %}
                      </div>
                      <span class="prf-color-name">{{ block.settings.colorname }}</span>
                    </div>
                  {% endif %}
                {% endfor %}
              {% endunless %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
  .prf-pilates-reformer-section {
    padding: 0px 0 {{ section.settings.sectionpaddingbottom }}px 0;
    background-color: #fff;
  }

  .prf-container {
    max-width: 1750px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .prf-product-layout {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 60px;
    align-items: start;
  }

  /* 产品图片区域 */
  .prf-product-images {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .prf-main-image {
    border-radius: 8px;
    overflow: hidden;
    background: {{ section.settings.mainimagebackground }};
    padding: 20px;
    width: 1234px;
    height: 702px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .prf-main-product-image {
    width: 1139px;
    height: 527px;
    display: block;
    object-fit: contain;
  }

  .prf-thumbnail-images {
    display: grid;
    grid-template-columns: repeat(6, 190px);
    gap: 12px;
    width: 1234px;
    justify-content: flex-start;
  }

  .prf-thumbnail-item {
    border: 1px solid rgba(22, 22, 22, 0.25);
    border-radius: 8px;
    overflow: hidden;
    background: white;
    padding: 0;
    cursor: pointer;
    transition: transform 0.3s ease;
    width: 190px;
    height: 156px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .prf-thumbnail-item:hover {
    transform: scale(1.05);
  }

  .prf-thumbnail-item.prf-active {
    border: 1px solid rgba(194, 46, 53, 1);
    box-shadow: 0 2px 8px rgba(194, 46, 53, 0.3);
  }

  .prf-thumbnail-image {
    width: 186px;
    height: auto;
    max-height: 156px;
    display: block;
    object-fit: contain;
  }

  /* 产品信息区域 */
  .prf-product-info {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .prf-product-header {
    text-align: left;
  }

  .prf-product-title {
    font-size: {{ section.settings.producttitlesize }}px;
    font-weight: 500;
    color: {{ section.settings.producttitlecolor }};
    margin: 0 0 10px 0;
    line-height: 1.2;
  }

  .prf-model-info {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 10px;
  }

  .prf-model-number {
    border: 1px solid {{ section.settings.modelnumbercolor }};
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 14px;
    color: {{ section.settings.modelnumbercolor }};
    background: transparent;
  }

  /* 定制区域 */
  .prf-customization-section {
    text-align: left;
  }

  .prf-customization-title {
    font-size: {{ section.settings.customizationtitlesize }}px;
    font-weight: 500;
    color: {{ section.settings.customizationtitlecolor }};
    margin: 0 0 15px 0;
  }

  .prf-customization-description {
    color: {{ section.settings.descriptioncolor }};
    line-height: 1.6;
    margin: 0 0 20px 0;
    font-size: {{ section.settings.descriptionfontsize }}px;
  }

  .prf-quote-button {
    display: inline-block;
    background: white;
    color: #161616;
    border: 1px solid #c22e35;
    padding: 12px 24px;
    text-decoration: none;
    border-radius: 4px;
    font-weight: bold;
    font-size: 14px;
    position: relative;
    overflow: hidden;
    z-index: 1;
    transition: all 0.7s cubic-bezier(0.83, 0, 0.17, 1);
  }

  .prf-quote-button::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: #c22e35;
    transition: all 0.7s cubic-bezier(0.83, 0, 0.17, 1);
    z-index: -1;
  }

  .prf-quote-button:hover {
    color: white;
  }

  .prf-quote-button:hover::before {
    left: 0;
  }

  .prf-quote-button::after {
    content: ">";
    margin-left: 8px;
    position: relative;
    z-index: 2;
  }

  /* 颜色选择区域 - 参考 upholstery-color-section.liquid */
  .prf-color-selection {
    text-align: left;
    margin-top: 60px;
  }

  .prf-color-title {
    font-size: 18px;
    font-weight: bold;
    color: #333;
    margin: 0 0 30px 0;
    padding-bottom: 10px;
    border-bottom: 2px solid {{ section.settings.quotebuttoncolor }};
    display: inline-block;
  }

  .prf-color-options {
    display: grid;
    grid-template-columns: repeat({{ section.settings.colorcolumns }}, 88px);
    grid-auto-rows: 130px;
    gap: 24.8px;
    height: 480px;
    overflow-y: auto;
    overflow-x: visible;
    padding: 20px 30px 20px 20px;
    margin: -10px -20px;
  }

  /* 自定义滚动条样式 */
  .prf-color-options::-webkit-scrollbar {
    width: 1px;
  }

  .prf-color-options::-webkit-scrollbar-track {
    background: #F3F3F3;
    border-radius: 1px;
  }

  .prf-color-options::-webkit-scrollbar-thumb {
    background: #AB3A39;
    border-radius: 1px;
  }

  .prf-color-options::-webkit-scrollbar-thumb:hover {
    background: #8B2E2F;
  }

  /* Firefox 滚动条样式 */
  .prf-color-options {
    scrollbar-color: #AB3A39 #F3F3F3;
  }

  .prf-color-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
  }

  .prf-color-swatch {
    width: 88px;
    height: 88px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid transparent;
    flex-shrink: 0;
  }

  /* 处理透明或未设置的颜色 */
  .prf-color-swatch[style="rgba(0,0,0,0)"],
  .prf-color-swatch[style="transparent"],
  .prf-color-option[data-color-hex="#CCCCCC"] .prf-color-swatch {
    border: 1px solid #ddd;
    background-image: linear-gradient(45deg, #f0f0f0 25%, transparent 25%), 
                      linear-gradient(-45deg, #f0f0f0 25%, transparent 25%), 
                      linear-gradient(45deg, transparent 75%, #f0f0f0 75%), 
                      linear-gradient(-45deg, transparent 75%, #f0f0f0 75%);
    background-size: 8px 8px;
    background-position: 0 0, 0 4px, 4px -4px, -4px 0px;
  }

  .prf-color-option[data-color-hex="#CCCCCC"] .prf-color-swatch:after {
    content: "默认";
    font-size: 10px;
    color: #666;
    text-align: center;
    line-height: 1.2;
  }

  .prf-color-name {
    font-size: 12px;
    font-weight: 400;
    color: #161616;
    text-align: center;
    line-height: 1.2;
    max-width: 120px;
    word-wrap: break-word;
    overflow-wrap: break-word;
    transition: all 0.3s ease;
    margin-top: 0;
  }

  .prf-color-option:hover .prf-color-swatch {
    transform: scale(1.05);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .prf-color-option.prf-selected .prf-color-swatch {
    transform: scale(1.3);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    z-index: 2;
    position: relative;
  }

  .prf-color-option.prf-selected .prf-color-name {
    margin-top: 8px;
  }

  .prf-color-checkmark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 49px;
    height: 49px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .prf-color-checkmark svg {
    width: 49px;
    height: 49px;
  }

  /* 响应式设计 */
  /* 大屏幕 (1920px+) */
  @media (min-width: 1920px) {
    .prf-container {
      max-width: 1750px;
    }
  }

  @media (max-width: 1919px) and (min-width: 1366px) {
    .prf-container {
      max-width: 1470px; /* 1750 * 0.84 */
    }

    .prf-product-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .prf-main-image {
      width: 100%;
      max-width: 1234px;
      height: 590px; /* 702 * 0.84 */
    }

    .prf-main-product-image {
      width: 957px; /* 1139 * 0.84 */
      height: 443px; /* 527 * 0.84 */
    }

    .prf-thumbnail-images {
      width: 1037px; /* 1234 * 0.84 */
      grid-template-columns: repeat(6, 160px); /* 190 * 0.84 */
      gap: 10px; /* 12 * 0.84 */
    }

    .prf-thumbnail-item {
      width: 160px; /* 190 * 0.84 */
      height: 131px; /* 156 * 0.84 */
    }

    .prf-thumbnail-image {
      width: 156px; /* 186 * 0.84 */
      max-height: 131px; /* 156 * 0.84 */
    }

    .prf-color-selection {
      margin-top: 102px; /* 121 * 0.84 */
    }

    .prf-color-title {
      margin-bottom: 25px;
    }

    .prf-color-options {
      grid-template-columns: repeat({{ section.settings.colorcolumns }}, 70px);
      grid-auto-rows: 108px;
      height: 220px;
      overflow-y: auto;
      overflow-x: visible;
      padding: 15px 25px 15px 15px;
      margin: -8px -15px;
    }

    .prf-color-swatch {
      width: 70px;
      height: 70px;
      flex-shrink: 0;
    }

    .prf-color-option.prf-selected .prf-color-swatch {
      transform: scale(1.3);
    }

    .prf-color-option.prf-selected .prf-color-name {
      margin-top: 6px;
    }

    .prf-color-checkmark {
      width: 35px;
      height: 35px;
    }

    .prf-color-checkmark svg {
      width: 35px;
      height: 35px;
    }

    .prf-color-name {
      font-size: 10px;
      max-width: 100px;
    }
  }

  @media (max-width: 1365px) and (min-width: 1024px) {
    .prf-container {
      max-width: 1173px; /* 1750 * 0.67 */
      padding: 0 30px;
    }

    .prf-product-layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  @media (max-width: 1023px) and (min-width: 768px) {
    .prf-container {
      max-width: 875px; /* 1750 * 0.5 */
    }

    .prf-product-layout {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .prf-thumbnail-images {
      width: 617px; /* 1234 * 0.5 */
      grid-template-columns: repeat(3, 95px); /* 190 * 0.5 */
      gap: 6px; /* 12 * 0.5 */
    }

    .prf-thumbnail-item {
      width: 95px; /* 190 * 0.5 */
      height: 78px; /* 156 * 0.5 */
    }

    .prf-thumbnail-image {
      width: 93px; /* 186 * 0.5 */
      max-height: 78px; /* 156 * 0.5 */
    }

    .prf-main-image {
      width: 100%;
      max-width: 617px; /* 1234 * 0.5 */
      height: 351px; /* 702 * 0.5 */
    }

    .prf-main-product-image {
      width: 570px; /* 1139 * 0.5 */
      height: 264px; /* 527 * 0.5 */
    }

    .prf-color-selection {
      margin-top: 61px; /* 121 * 0.5 */
    }

    .prf-color-title {
      margin-bottom: 20px;
    }

    .prf-color-options {
      grid-template-columns: repeat(2, 60px);
      grid-auto-rows: 98px;
      height: 180px;
      overflow-y: auto;
      overflow-x: visible;
      padding: 12px 20px 12px 12px;
      margin: -6px -12px;
    }

    .prf-color-swatch {
      width: 60px;
      height: 60px;
      flex-shrink: 0;
    }

    .prf-color-option.prf-selected .prf-color-swatch {
      transform: scale(1.3);
    }

    .prf-color-option.prf-selected .prf-color-name {
      margin-top: 5px;
    }

    .prf-color-checkmark {
      width: 30px;
      height: 30px;
    }

    .prf-color-checkmark svg {
      width: 30px;
      height: 30px;
    }

    .prf-color-name {
      font-size: 9px;
      max-width: 90px;
    }
  }

  @media (max-width: 767px) and (min-width: 481px) {
    .prf-container {
      max-width: 700px; /* 1750 * 0.4 */
    }

    .prf-product-layout {
      grid-template-columns: 1fr;
      gap: 25px;
    }
  }

  @media (max-width: 480px) {
    .prf-container {
      max-width: 578px; /* 1750 * 0.33 */
      padding: 0 15px;
    }

    .prf-pilates-reformer-section {
      padding-bottom: {{ section.settings.sectionpaddingtop | dividedby: 2 }}px;
    }

    .prf-thumbnail-images {
      width: 407px; /* 1234 * 0.33 */
      grid-template-columns: repeat(2, 63px); /* 190 * 0.33 */
      gap: 4px; /* 12 * 0.33 */
    }

    .prf-thumbnail-item {
      width: 63px; /* 190 * 0.33 */
      height: 51px; /* 156 * 0.33 */
    }

    .prf-thumbnail-image {
      width: 61px; /* 186 * 0.33 */
      max-height: 51px; /* 156 * 0.33 */
    }

    .prf-main-image {
      width: 100%;
      max-width: 407px; /* 1234 * 0.33 */
      height: 232px; /* 702 * 0.33 */
    }

    .prf-main-product-image {
      width: 376px; /* 1139 * 0.33 */
      height: 174px; /* 527 * 0.33 */
    }

    .prf-color-selection {
      margin-top: 40px; /* 121 * 0.33 */
    }

    .prf-color-title {
      margin-bottom: 15px;
    }

    .prf-color-options {
      grid-template-columns: repeat(2, 50px);
      grid-auto-rows: 88px;
      height: 160px;
      overflow-y: auto;
      overflow-x: visible;
      padding: 10px 15px 10px 10px;
      margin: -5px -10px;
    }

    .prf-color-swatch {
      width: 50px;
      height: 50px;
      flex-shrink: 0;
    }

    .prf-color-option.prf-selected .prf-color-swatch {
      transform: scale(1.3);
    }

    .prf-color-option.prf-selected .prf-color-name {
      margin-top: 4px;
    }

    .prf-color-checkmark {
      width: 25px;
      height: 25px;
    }

    .prf-color-checkmark svg {
      width: 25px;
      height: 25px;
    }

    .prf-color-name {
      font-size: 8px;
      max-width: 80px;
    }
  }

  @media (max-width: 320px) {
    .prf-container {
      max-width: 438px; /* 1750 * 0.25 */
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // 缩略图切换功能
    const prfThumbnailItems = document.querySelectorAll('.prf-thumbnail-item');
    const prfMainImage = document.getElementById('prf-main-product-image');

    prfThumbnailItems.forEach(function (item) {
      item.addEventListener('click', function () {
        const imageUrl = this.getAttribute('data-image-url');

        if (imageUrl && prfMainImage) {
          // 移除所有active类
          prfThumbnailItems.forEach(function (thumb) {
            thumb.classList.remove('prf-active');
          });

          // 添加active类到当前点击的缩略图
          this.classList.add('prf-active');

          // 更换主图
          prfMainImage.src = imageUrl;
        }
      });
    });

    // 颜色选择功能 - 参考 upholstery-color-section.liquid
    const prfColorOptions = document.querySelectorAll('.prf-color-option');

    prfColorOptions.forEach(function (option) {
      option.addEventListener('click', function () {
        // 移除所有选中状态
        prfColorOptions.forEach(function (opt) {
          opt.classList.remove('prf-selected');
          const checkmark = opt.querySelector('.prf-color-checkmark');
          if (checkmark) {
            checkmark.remove();
          }
        });

        // 添加选中状态到当前选项
        this.classList.add('prf-selected');

        // 添加选中标记
        const checkmark = document.createElement('div');
        checkmark.className = 'prf-color-checkmark';
        checkmark.innerHTML = `
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" fill="white"/>
          </svg>
        `;
        this.querySelector('.prf-color-swatch').appendChild(checkmark);

        // 切换主图片
        const variantImage = this.getAttribute('data-variant-image');
        if (variantImage && variantImage !== '' && prfMainImage) {
          prfMainImage.src = variantImage;
        }

        // 触发自定义事件，可用于其他功能
        const colorName = this.getAttribute('data-color');
        const variantId = this.getAttribute('data-variant-id');
        const colorHex = this.getAttribute('data-color-hex');

        const event = new CustomEvent('prfColorSelected', {
          detail: {
            colorName: colorName,
            colorHex: colorHex,
            variantId: variantId,
            variantImage: variantImage
          }
        });

        document.dispatchEvent(event);

        console.log('Selected color:', colorName, 'Variant ID:', variantId);
      });
    });

    // 监听颜色选择事件，可以用于与其他组件通信
    document.addEventListener('prfColorSelected', function(event) {
      // 这里可以添加其他逻辑，比如更新购物车、价格等
      // 例如：更新产品变体选择
      if (event.detail.variantId) {
        const productForm = document.querySelector('form[action="/cart/add"]');
        if (productForm) {
          const variantInput = productForm.querySelector('select[name="id"], input[name="id"]');
          if (variantInput) {
            variantInput.value = event.detail.variantId;
            
            // 触发变化事件
            const changeEvent = new Event('change', { bubbles: true });
            variantInput.dispatchEvent(changeEvent);
          }
        }
      }
    });
  });
</script>

