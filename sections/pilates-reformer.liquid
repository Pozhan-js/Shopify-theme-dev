<script>
  document.addEventListener('DOMContentLoaded', function () {
    // 缩略图切换功能
    const prfThumbnailItems = document.querySelectorAll('.prf-thumbnail-item');
    const prfMainImage = document.getElementById('prf-main-product-image');

    prfThumbnailItems.forEach(function (item) {
      item.addEventListener('click', function () {
        const imageUrl = this.getAttribute('data-image-url');

        if (imageUrl && prfMainImage) {
          // 移除所有active类
          prfThumbnailItems.forEach(function (thumb) {
            thumb.classList.remove('prf-active');
          });

          // 添加active类到当前点击的缩略图
          this.classList.add('prf-active');

          // 更换主图
          prfMainImage.src = imageUrl;
        }
      });
    });

    // 颜色选择功能
    const prfColorOptions = document.querySelectorAll('.prf-color-option');

    prfColorOptions.forEach(function (option) {
      option.addEventListener('click', function () {
        // 移除所有选中状态
        prfColorOptions.forEach(function (opt) {
          opt.classList.remove('prf-selected');
          const checkmark = opt.querySelector('.prf-color-checkmark');
          if (checkmark) {
            checkmark.remove();
          }
        });

        // 添加选中状态到当前选项
        this.classList.add('prf-selected');

        // 添加选中标记
        const checkmark = document.createElement('div');
        checkmark.className = 'prf-color-checkmark';
        checkmark.innerHTML = `
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" fill="white"/>
          </svg>
        `;
        this.querySelector('.prf-color-swatch').appendChild(checkmark);

        // 切换主图片
        const variantImage = this.getAttribute('data-variant-image');
        if (variantImage && variantImage !== '' && prfMainImage) {
          prfMainImage.src = variantImage;
        }

        // 触发自定义事件，可用于其他功能
        const colorName = this.getAttribute('data-color');
        const variantId = this.getAttribute('data-variant-id');
        const colorHex = this.getAttribute('data-color-hex');

        const event = new CustomEvent('prfColorSelected', {
          detail: {
            colorName: colorName,
            colorHex: colorHex,
            variantId: variantId,
            variantImage: variantImage,
          },
        });

        document.dispatchEvent(event);

        console.log('Selected color:', colorName, 'Variant ID:', variantId);
      });
    });

    // 监听颜色选择事件，可以用于与其他组件通信
    document.addEventListener('prfColorSelected', function (event) {
      // 这里可以添加其他逻辑，比如更新购物车、价格等
      // 例如：更新产品变体选择
      if (event.detail.variantId) {
        const productForm = document.querySelector('form[action="/cart/add"]');
        if (productForm) {
          const variantInput = productForm.querySelector('select[name="id"], input[name="id"]');
          if (variantInput) {
            variantInput.value = event.detail.variantId;

            // 触发变化事件
            const changeEvent = new Event('change', { bubbles: true });
            variantInput.dispatchEvent(changeEvent);
          }
        }
      }
    });

    // 移动端触摸优化
    if ('ontouchstart' in window) {
      // 为颜色选项添加触摸反馈
      prfColorOptions.forEach(function (option) {
        option.addEventListener('touchstart', function () {
          this.style.opacity = '0.7';
        });

        option.addEventListener('touchend', function () {
          this.style.opacity = '1';
        });

        option.addEventListener('touchcancel', function () {
          this.style.opacity = '1';
        });
      });

      // 为缩略图添加触摸反馈
      prfThumbnailItems.forEach(function (item) {
        item.addEventListener('touchstart', function () {
          this.style.opacity = '0.7';
        });

        item.addEventListener('touchend', function () {
          this.style.opacity = '1';
        });

        item.addEventListener('touchcancel', function () {
          this.style.opacity = '1';
        });
      });
    }
  });
</script>

