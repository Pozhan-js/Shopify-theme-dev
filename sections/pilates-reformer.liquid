<div class="pilates-reformer-section" {{ section.shopify_attributes }}>
  <div class="container">
    <div class="product-layout">
      <!-- 左侧产品图片区域 -->
      <div class="product-images">
        <!-- 主图 -->
        <div class="main-image">
          {% comment %} 优先使用当前产品页面的产品，然后是设置中选择的产品，最后是回退图片 {% endcomment %}
          {% assign current_product = product %}
          {% assign selected_product = all_products[section.settings.product_handle] %}
          {% assign display_product = current_product | default: selected_product %}

          {% if display_product and display_product.images.size > 0 %}
            <img
              src="{{ display_product.images.first | img_url: '1200x' }}"
              alt="{{ display_product.title }}"
              class="main-product-image"
              id="main-product-image"
            >
          {% elsif section.settings.fallback_image %}
            <img
              src="{{ section.settings.fallback_image | img_url: '1200x' }}"
              alt="{{ section.settings.product_title }}"
              class="main-product-image"
              id="main-product-image"
            >
          {% endif %}
        </div>

        <!-- 缩略图 -->
        <div class="thumbnail-images">
          {% if display_product and display_product.images.size > 0 %}
            {% for image in display_product.images %}
              <div
                class="thumbnail-item {% if forloop.first %}active{% endif %}"
                data-image-url="{{ image | img_url: '1200x' }}"
              >
                <img
                  src="{{ image | img_url: '150x' }}"
                  alt="Product image {{ forloop.index }}"
                  class="thumbnail-image"
                >
              </div>
            {% endfor %}
          {% else %}
            {% for block in section.blocks %}
              {% if block.type == 'thumbnail' %}
                <div
                  class="thumbnail-item"
                  {{ block.shopify_attributes }}
                  data-image-url="{{ block.settings.thumbnail_image | img_url: '1200x' }}"
                >
                  {% if block.settings.thumbnail_image %}
                    <img
                      src="{{ block.settings.thumbnail_image | img_url: '150x' }}"
                      alt="Product thumbnail"
                      class="thumbnail-image"
                    >
                  {% endif %}
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <!-- 右侧产品信息区域 -->
      <div class="product-info">
        <!-- 产品标题和型号 -->
        <div class="product-header">
          {% if display_product %}
            <h1 class="product-title">{{ display_product.title }}</h1>
            <div class="model-info">
              <span class="model-number">
                {{- display_product.variants.first.sku | default: display_product.handle | upcase -}}
              </span>
            </div>
          {% else %}
            <h1 class="product-title">{{ section.settings.product_title }}</h1>
            <div class="model-info">
              <span class="model-number">{{ section.settings.model_number }}</span>
            </div>
          {% endif %}
        </div>

        <!-- 定制询问区域 -->
        <div class="customization-section">
          <h2 class="customization-title">{{ section.settings.customization_title }}</h2>
          <p class="customization-description">{{ section.settings.customization_description }}</p>

          {% if section.settings.quote_button_text %}
            {% assign quote_link = section.settings.quote_button_link %}
            {% if quote_link == blank and display_product %}
              {% assign quote_link = '/pages/contact?product=' | append: display_product.handle %}
            {% endif %}
            <a href="{{ quote_link }}" class="quote-button">
              {{ section.settings.quote_button_text }}
            </a>
          {% endif %}
        </div>

        <!-- 颜色选择区域 -->
        {% if section.settings.show_color_selection %}
          <div class="color-selection">
            <h3 class="color-title">{{ section.settings.color_section_title }}</h3>
            <div class="color-options">
              {% if display_product %}
                {% assign first_color_processed = false %}
                {% assign color_option_name = section.settings.color_option_name | default: 'Color' %}
                
                {% comment %} 查找颜色选项 - 支持多种命名方式 {% endcomment %}
                {% for option in display_product.options_with_values %}
                  {% assign option_name_lower = option.name | downcase %}
                  {% assign target_name_lower = color_option_name | downcase %}
                  
                  {% if option_name_lower == target_name_lower or option_name_lower == '颜色' or option_name_lower == 'color' or option_name_lower == 'colour' or option_name_lower == 'upholstery' or option_name_lower == 'fabric' %}
                    {% for value in option.values %}
                      {% assign variant_found = false %}
                      {% assign variant_id = '' %}
                      {% assign variant_image = '' %}
                      {% assign color_hex = '#CCCCCC' %}
                      
                      {% comment %} 首先尝试使用 color_swatch.color 获取颜色 {% endcomment %}
                      {% assign color_swatch = value.swatch %}
                      {% if color_swatch and color_swatch.color %}
                        {% assign color_hex = color_swatch.color %}
                      {% else %}
                        {% comment %} 如果没有 color_swatch，尝试基于颜色名称的预设颜色映射 {% endcomment %}
                        {% assign value_lower = value | downcase %}
                        {% case value_lower %}
                          {% when 'black' %}
                            {% assign color_hex = '#000000' %}
                          {% when 'white' %}
                            {% assign color_hex = '#FFFFFF' %}
                          {% when 'red' %}
                            {% assign color_hex = '#FF0000' %}
                          {% when 'blue' %}
                            {% assign color_hex = '#0000FF' %}
                          {% when 'green' %}
                            {% assign color_hex = '#008000' %}
                          {% when 'gray', 'grey' %}
                            {% assign color_hex = '#808080' %}
                          {% when 'steel gray', 'steel grey' %}
                            {% assign color_hex = '#71797E' %}
                          {% when 'brown' %}
                            {% assign color_hex = '#8B4513' %}
                          {% when 'navy' %}
                            {% assign color_hex = '#000080' %}
                          {% when 'beige' %}
                            {% assign color_hex = '#F5F5DC' %}
                          {% when 'tan' %}
                            {% assign color_hex = '#D2B48C' %}
                          {% else %}
                            {% assign color_hex = '#CCCCCC' %}
                        {% endcase %}
                      {% endif %}
                      
                      {% comment %} 查找对应的变体 {% endcomment %}
                      {% for variant in display_product.variants %}
                        {% assign value_matches = false %}
                        
                        {% comment %} 检查变体的所有选项值 {% endcomment %}
                        {% if variant.option1 == value %}
                          {% assign value_matches = true %}
                        {% elsif variant.option2 == value %}
                          {% assign value_matches = true %}
                        {% elsif variant.option3 == value %}
                          {% assign value_matches = true %}
                        {% endif %}
                        
                        {% if value_matches and variant_found == false %}
                          {% assign variant_found = true %}
                          {% assign variant_id = variant.id %}
                          
                          {% comment %} 获取变体图片 {% endcomment %}
                          {% if variant.image %}
                            {% assign variant_image = variant.image | img_url: '1200x' %}
                          {% endif %}
                        {% endif %}
                      {% endfor %}
                      
                      {% comment %} 确保颜色值格式正确 {% endcomment %}
                      {% unless color_hex contains '#' %}
                        {% if color_hex != '' %}
                          {% assign color_hex = '#' | append: color_hex %}
                        {% else %}
                          {% assign color_hex = '#CCCCCC' %}
                        {% endif %}
                      {% endunless %}
                      
                      <div class="color-option {% unless first_color_processed %}selected{% endunless %}" 
                           data-color="{{ value }}"
                           data-variant-id="{{ variant_id }}"
                           data-variant-image="{{ variant_image }}"
                           data-color-hex="{{ color_hex }}">
                        <div class="color-swatch" style="background-color: {{ color_hex }};">
                          {% unless first_color_processed %}
                            <div class="color-checkmark">
                              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" fill="white"/>
                              </svg>
                            </div>
                            {% assign first_color_processed = true %}
                          {% endunless %}
                        </div>
                        <span class="color-name">{{ value }}</span>
                      </div>
                    {% endfor %}
                    {% break %}
                  {% endif %}
                {% endfor %}
              {% else %}
                {% comment %} 如果没有产品，使用区块配置的颜色 {% endcomment %}
                {% for block in section.blocks %}
                  {% if block.type == 'color_option' %}
                    <div class="color-option {% if block.settings.is_selected %}selected{% endif %}"
                         {{ block.shopify_attributes }}
                         data-color="{{ block.settings.color_name }}"
                         data-color-hex="{{ block.settings.color_value }}">
                      <div class="color-swatch" style="background-color: {{ block.settings.color_value }};">
                        {% if block.settings.is_selected %}
                          <div class="color-checkmark">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" fill="white"/>
                            </svg>
                          </div>
                        {% endif %}
                      </div>
                      <span class="color-name">{{ block.settings.color_name }}</span>
                    </div>
                  {% endif %}
                {% endfor %}
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
  .pilates-reformer-section {
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px 0;
    margin-top: {{ section.settings.section_margin_top }}px;
    background-color: #fff;
  }

  .container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .product-layout {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 60px;
    align-items: start;
  }

  /* 产品图片区域 */
  .product-images {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .main-image {
    border-radius: 8px;
    overflow: hidden;
    background: {{ section.settings.main_image_background }};
    padding: 20px;
    width: 1234px;
    height: 702px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .main-product-image {
    width: 1139px;
    height: 527px;
    display: block;
    object-fit: contain;
  }

  .thumbnail-images {
    display: grid;
    grid-template-columns: repeat({{ section.settings.thumbnail_columns }}, 230px);
    gap: 15px;
    width: 1234px;
    justify-content: flex-start;
  }

  .thumbnail-item {
    border: 1px solid rgba(22, 22, 22, 0.25);
    border-radius: 8px;
    overflow: hidden;
    background: white;
    padding: 0;
    cursor: pointer;
    transition: transform 0.3s ease;
    width: 230px;
    height: 189px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thumbnail-item:hover {
    transform: scale(1.05);
  }

  .thumbnail-item.active {
    border: 1px solid rgba(194, 46, 53, 1);
    box-shadow: 0 2px 8px rgba(194, 46, 53, 0.3);
  }

  .thumbnail-image {
    width: 225px;
    height: auto;
    max-height: 189px;
    display: block;
    object-fit: contain;
  }

  /* 产品信息区域 */
  .product-info {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .product-header {
    text-align: left;
  }

  .product-title {
    font-size: {{ section.settings.product_title_size }}px;
    font-weight: 500;
    color: {{ section.settings.product_title_color }};
    margin: 0 0 10px 0;
    line-height: 1.2;
  }

  .model-info {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 10px;
  }

  .model-number {
    border: 1px solid {{ section.settings.model_number_color }};
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 14px;
    color: {{ section.settings.model_number_color }};
    background: transparent;
  }

  /* 定制区域 */
  .customization-section {
    text-align: left;
  }

  .customization-title {
    font-size: {{ section.settings.customization_title_size }}px;
    font-weight: 500;
    color: {{ section.settings.customization_title_color }};
    margin: 0 0 15px 0;
  }

  .customization-description {
    color: {{ section.settings.description_color }};
    line-height: 1.6;
    margin: 0 0 20px 0;
    font-size: {{ section.settings.description_font_size }}px;
  }

  .quote-button {
    display: inline-block;
    background: white;
    color: #161616;
    border: 1px solid #c22e35;
    padding: 12px 24px;
    text-decoration: none;
    border-radius: 4px;
    font-weight: bold;
    font-size: 14px;
    position: relative;
    overflow: hidden;
    z-index: 1;
    transition: color 0.3s ease;
  }

  .quote-button::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: #c22e35;
    transition: left 0.3s ease;
    z-index: -1;
  }

  .quote-button:hover {
    color: white;
  }

  .quote-button:hover::before {
    left: 0;
  }

  .quote-button::after {
    content: ">";
    margin-left: 8px;
    position: relative;
    z-index: 2;
  }

  /* 颜色选择区域 - 参考 upholstery-color-section.liquid */
  .color-selection {
    text-align: left;
    margin-top: 60px;
  }

  .color-title {
    font-size: 18px;
    font-weight: bold;
    color: #333;
    margin: 0 0 30px 0;
    padding-bottom: 10px;
    border-bottom: 2px solid {{ section.settings.quote_button_color }};
    display: inline-block;
  }

  .color-options {
    display: grid;
    grid-template-columns: repeat({{ section.settings.color_columns }}, 88px);
    grid-auto-rows: 130px;
    gap: 24.8px;
    height: 480px;
    overflow-y: auto;
    overflow-x: visible;
    padding: 20px 30px 20px 20px;
    margin: -10px -20px;
  }

  /* 自定义滚动条样式 */
  .color-options::-webkit-scrollbar {
    width: 1px;
  }

  .color-options::-webkit-scrollbar-track {
    background: #F3F3F3;
    border-radius: 1px;
  }

  .color-options::-webkit-scrollbar-thumb {
    background: #AB3A39;
    border-radius: 1px;
  }

  .color-options::-webkit-scrollbar-thumb:hover {
    background: #8B2E2F;
  }

  /* Firefox 滚动条样式 */
  .color-options {
    scrollbar-color: #AB3A39 #F3F3F3;
  }

  .color-option {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
  }

  .color-swatch {
    width: 88px;
    height: 88px;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid transparent;
    flex-shrink: 0;
  }

  /* 处理透明或未设置的颜色 */
  .color-swatch[style*="rgba(0,0,0,0)"],
  .color-swatch[style*="transparent"],
  .color-option[data-color-hex="#CCCCCC"] .color-swatch {
    border: 1px solid #ddd;
    background-image: linear-gradient(45deg, #f0f0f0 25%, transparent 25%), 
                      linear-gradient(-45deg, #f0f0f0 25%, transparent 25%), 
                      linear-gradient(45deg, transparent 75%, #f0f0f0 75%), 
                      linear-gradient(-45deg, transparent 75%, #f0f0f0 75%);
    background-size: 8px 8px;
    background-position: 0 0, 0 4px, 4px -4px, -4px 0px;
  }

  .color-option[data-color-hex="#CCCCCC"] .color-swatch:after {
    content: "默认";
    font-size: 10px;
    color: #666;
    text-align: center;
    line-height: 1.2;
  }

  .color-name {
    font-size: 12px;
    font-weight: 400;
    color: #161616;
    text-align: center;
    line-height: 1.2;
    max-width: 120px;
    word-wrap: break-word;
    overflow-wrap: break-word;
    transition: all 0.3s ease;
    margin-top: 0;
  }

  .color-option:hover .color-swatch {
    transform: scale(1.05);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }

  .color-option.selected .color-swatch {
    transform: scale(1.3);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3);
    z-index: 10;
    position: relative;
  }

  .color-option.selected .color-name {
    margin-top: 8px;
  }

  .color-checkmark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 49px;
    height: 49px;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
  }

  .color-checkmark svg {
    width: 49px;
    height: 49px;
  }

  /* 响应式设计 */
  @media (max-width: 1024px) {
    .product-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .main-image {
      width: 100%;
      max-width: 1234px;
      height: 590px; /* 702 * 0.84 */
    }

    .main-product-image {
      width: 957px; /* 1139 * 0.84 */
      height: 443px; /* 527 * 0.84 */
    }

    .thumbnail-images {
      width: 1037px; /* 1234 * 0.84 */
      grid-template-columns: repeat({{ section.settings.thumbnail_columns }}, 193px); /* 230 * 0.84 */
    }

    .thumbnail-item {
      width: 193px; /* 230 * 0.84 */
      height: 159px; /* 189 * 0.84 */
    }

    .thumbnail-image {
      width: 189px; /* 225 * 0.84 */
    }

    .color-selection {
      margin-top: 102px; /* 121 * 0.84 */
    }

    .color-title {
      margin-bottom: 25px;
    }

    .color-options {
      grid-template-columns: repeat({{ section.settings.color_columns }}, 70px);
      grid-auto-rows: 108px;
      height: 220px;
      overflow-y: auto;
      overflow-x: visible;
      padding: 15px 25px 15px 15px;
      margin: -8px -15px;
    }

    .color-swatch {
      width: 70px;
      height: 70px;
      flex-shrink: 0;
    }

    .color-option.selected .color-swatch {
      transform: scale(1.3);
    }

    .color-option.selected .color-name {
      margin-top: 6px;
    }

    .color-checkmark {
      width: 35px;
      height: 35px;
    }

    .color-checkmark svg {
      width: 35px;
      height: 35px;
    }

    .color-name {
      font-size: 10px;
      max-width: 100px;
    }
  }

  @media (max-width: 768px) {
    .thumbnail-images {
      width: 617px; /* 1234 * 0.5 */
      grid-template-columns: repeat(3, 115px); /* 230 * 0.5 */
      gap: 8px; /* 15 * 0.5 */
    }

    .thumbnail-item {
      width: 115px; /* 230 * 0.5 */
      height: 95px; /* 189 * 0.5 */
    }

    .thumbnail-image {
      width: 113px; /* 225 * 0.5 */
    }

    .main-image {
      width: 100%;
      max-width: 617px; /* 1234 * 0.5 */
      height: 351px; /* 702 * 0.5 */
    }

    .main-product-image {
      width: 570px; /* 1139 * 0.5 */
      height: 264px; /* 527 * 0.5 */
    }

    .color-selection {
      margin-top: 61px; /* 121 * 0.5 */
    }

    .color-title {
      margin-bottom: 20px;
    }

    .color-options {
      grid-template-columns: repeat(2, 60px);
      grid-auto-rows: 98px;
      height: 180px;
      overflow-y: auto;
      overflow-x: visible;
      padding: 12px 20px 12px 12px;
      margin: -6px -12px;
    }

    .color-swatch {
      width: 60px;
      height: 60px;
      flex-shrink: 0;
    }

    .color-option.selected .color-swatch {
      transform: scale(1.3);
    }

    .color-option.selected .color-name {
      margin-top: 5px;
    }

    .color-checkmark {
      width: 30px;
      height: 30px;
    }

    .color-checkmark svg {
      width: 30px;
      height: 30px;
    }

    .color-name {
      font-size: 9px;
      max-width: 90px;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 15px;
    }

    .pilates-reformer-section {
      padding: {{ section.settings.section_padding_top | divided_by: 2 }}px 0;
    }

    .thumbnail-images {
      width: 407px; /* 1234 * 0.33 */
      grid-template-columns: repeat(2, 76px); /* 230 * 0.33 */
      gap: 5px; /* 15 * 0.33 */
    }

    .thumbnail-item {
      width: 76px; /* 230 * 0.33 */
      height: 62px; /* 189 * 0.33 */
    }

    .thumbnail-image {
      width: 74px; /* 225 * 0.33 */
    }

    .main-image {
      width: 100%;
      max-width: 407px; /* 1234 * 0.33 */
      height: 232px; /* 702 * 0.33 */
    }

    .main-product-image {
      width: 376px; /* 1139 * 0.33 */
      height: 174px; /* 527 * 0.33 */
    }

    .color-selection {
      margin-top: 40px; /* 121 * 0.33 */
    }

    .color-title {
      margin-bottom: 15px;
    }

    .color-options {
      grid-template-columns: repeat(2, 50px);
      grid-auto-rows: 88px;
      height: 160px;
      overflow-y: auto;
      overflow-x: visible;
      padding: 10px 15px 10px 10px;
      margin: -5px -10px;
    }

    .color-swatch {
      width: 50px;
      height: 50px;
      flex-shrink: 0;
    }

    .color-option.selected .color-swatch {
      transform: scale(1.3);
    }

    .color-option.selected .color-name {
      margin-top: 4px;
    }

    .color-checkmark {
      width: 25px;
      height: 25px;
    }

    .color-checkmark svg {
      width: 25px;
      height: 25px;
    }

    .color-name {
      font-size: 8px;
      max-width: 80px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // 缩略图切换功能
    const thumbnailItems = document.querySelectorAll('.thumbnail-item');
    const mainImage = document.getElementById('main-product-image');

    thumbnailItems.forEach(function (item) {
      item.addEventListener('click', function () {
        const imageUrl = this.getAttribute('data-image-url');

        if (imageUrl && mainImage) {
          // 移除所有active类
          thumbnailItems.forEach(function (thumb) {
            thumb.classList.remove('active');
          });

          // 添加active类到当前点击的缩略图
          this.classList.add('active');

          // 更换主图
          mainImage.src = imageUrl;
        }
      });
    });

    // 颜色选择功能 - 参考 upholstery-color-section.liquid
    const colorOptions = document.querySelectorAll('.color-option');

    colorOptions.forEach(function (option) {
      option.addEventListener('click', function () {
        // 移除所有选中状态
        colorOptions.forEach(function (opt) {
          opt.classList.remove('selected');
          const checkmark = opt.querySelector('.color-checkmark');
          if (checkmark) {
            checkmark.remove();
          }
        });

        // 添加选中状态到当前选项
        this.classList.add('selected');

        // 添加选中标记
        const checkmark = document.createElement('div');
        checkmark.className = 'color-checkmark';
        checkmark.innerHTML = `
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 16.17L4.83 12L3.41 13.41L9 19L21 7L19.59 5.59L9 16.17Z" fill="white"/>
          </svg>
        `;
        this.querySelector('.color-swatch').appendChild(checkmark);

        // 切换主图片
        const variantImage = this.getAttribute('data-variant-image');
        if (variantImage && variantImage !== '' && mainImage) {
          mainImage.src = variantImage;
        }

        // 触发自定义事件，可用于其他功能
        const colorName = this.getAttribute('data-color');
        const variantId = this.getAttribute('data-variant-id');
        const colorHex = this.getAttribute('data-color-hex');

        const event = new CustomEvent('colorSelected', {
          detail: {
            colorName: colorName,
            colorHex: colorHex,
            variantId: variantId,
            variantImage: variantImage
          }
        });

        document.dispatchEvent(event);

        console.log('Selected color:', colorName, 'Variant ID:', variantId);
      });
    });

    // 监听颜色选择事件，可以用于与其他组件通信
    document.addEventListener('colorSelected', function(event) {
      // 这里可以添加其他逻辑，比如更新购物车、价格等
      // 例如：更新产品变体选择
      if (event.detail.variantId) {
        const productForm = document.querySelector('form[action*="/cart/add"]');
        if (productForm) {
          const variantInput = productForm.querySelector('select[name="id"], input[name="id"]');
          if (variantInput) {
            variantInput.value = event.detail.variantId;
            
            // 触发变化事件
            const changeEvent = new Event('change', { bubbles: true });
            variantInput.dispatchEvent(changeEvent);
          }
        }
      }
    });
  });
</script>

