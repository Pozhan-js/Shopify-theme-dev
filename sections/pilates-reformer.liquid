    }

    .prf-thumbnail-image {
      width: 100%;
      height: 100%;
    }

    .prf-color-selection {
      margin-top: 30px;
    }

    .prf-color-options {
      grid-template-columns: repeat(3, 65px);
      grid-auto-rows: 100px;
      height: 220px;
      gap: 18px;
    }

    .prf-color-swatch {
      width: 65px;
      height: 65px;
    }

    .prf-color-checkmark {
      width: 32px;
      height: 32px;
    }

    .prf-color-checkmark svg {
      width: 32px;
      height: 32px;
    }
  }

  /* 平板端 (768px - 1023px) */
  @media (max-width: 1023px) and (min-width: 768px) {
    .prf-container {
      max-width: 720px;
      padding: 0 20px;
    }

    .prf-product-layout {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .prf-main-image {
      width: 100%;
      height: 400px;
      padding: 15px;
    }

    .prf-main-product-image {
      width: 100%;
      height: 100%;
      max-width: 600px;
      max-height: 300px;
    }

    .prf-thumbnail-images {
      width: 100%;
      grid-template-columns: repeat(4, 1fr);
