      padding: 15px;
    }

    .prf-main-product-image {
      width: 100%;
      height: 100%;
      max-width: 900px;
      max-height: 400px;
    }

    .prf-thumbnail-images {
      width: 100%;
      grid-template-columns: repeat(6, 1fr);
      gap: 10px;
      max-width: 900px;
    }

    .prf-thumbnail-item {
      width: 100%;
      height: 120px;
      aspect-ratio: 1.2;
    }

    .prf-thumbnail-image {
      width: 100%;
      height: 100%;
    }

    .prf-color-selection {
      margin-top: 40px;
    }

    .prf-color-options {
      grid-template-columns: repeat({{ section.settings.colorcolumns }}, 70px);
      grid-auto-rows: 108px;
      height: 250px;
      gap: 20px;
    }

    .prf-color-swatch {
      width: 70px;
      height: 70px;
    }

    .prf-color-checkmark {
      width: 35px;
      height: 35px;
    }

    .prf-color-checkmark svg {
      width: 35px;
      height: 35px;
    }
  }

  /* 中等桌面端 (1024px - 1365px) */
  @media (max-width: 1365px) and (min-width: 1024px) {
    .prf-container {
      max-width: 1000px;
      padding: 0 20px;
    }

    .prf-product-layout {
