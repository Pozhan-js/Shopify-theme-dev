{% schema %}
{
  "name": "风水智慧区块",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Where Walls Whisper Wisdom The Measurable Poetry of Feng Shui Science"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "标题字体大小",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "主展示图片"
    }
  ],
  "presets": [
    {
      "name": "风水智慧区块",
      "category": "自定义区块"
    }
  ]
}
{% endschema %}

<div class="fengshui-wisdom-section">
  <div class="page-width">
    <div class="wisdom-display">
      {% if section.settings.main_image != blank %}
        <div class="main-display">
          <img
            src="{{ section.settings.main_image | image_url: width: 1200 }}"
            alt="风水智慧展示"
            width="1200"
            height="800"
            loading="lazy"
          >
        </div>
      {% endif %}
      
      <div class="wisdom-header">
        <h2 class="wisdom-title" style="font-size: {{ section.settings.title_font_size }}px;">{{ section.settings.title }}</h2>
      </div>
    </div>
  </div>
</div>

<style>
  .fengshui-wisdom-section {
    padding: 60px 0;
    background: #000;
  }

  .wisdom-display {
    display: flex;
    flex-direction: column;
  }

  .wisdom-header {
    text-align: center;
    margin-top: 30px;
  }

  .wisdom-title {
    font-weight: 600;
    color: #fff;
    text-shadow: 2px 2px 4px rgba(255, 255, 255, 0.3);
    line-height: 1.4;
    margin: 0 auto;
    max-width: 800px;
    word-wrap: break-word;
  }

  .main-display {
    margin-bottom: 40px;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .main-display img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
