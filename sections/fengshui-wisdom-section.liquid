{% schema %}
{
  "name": "风水智慧区块",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "Where Walls Whisper Wisdom The Measurable Poetry of Feng Shui Science"
    },

    {
      "type": "image_picker",
      "id": "main_image",
      "label": "主展示图片"
    }
  ],
  "presets": [
    {
      "name": "风水智慧区块",
      "category": "自定义区块"
    }
  ]
}
{% endschema %}

<div class="fengshui-wisdom-section">
  <div class="page-width">
    <div class="wisdom-content">
      <div class="wisdom-display">
      {% if section.settings.main_image != blank %}
        <div class="main-display">
          <img
            src="{{ section.settings.main_image | image_url: width: 1200 }}"
            alt="风水智慧展示"
            width="1200"
            height="800"
            loading="lazy"
          >
        </div>
      {% endif %}
      
      <div class="wisdom-header">
        <h2 class="wisdom-title">{{ section.settings.title }}</h2>
      </div>
      </div>
    </div>
  </div>
</div>

<style>
  .fengshui-wisdom-section {
    padding: 60px 0;
    background: #000;
  }

  .wisdom-display {
    display: flex;
    flex-direction: column;
  }

  .wisdom-header {
    text-align: center;
    margin-top: 30px;
  }

  .wisdom-content {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }

  .wisdom-title {
    font-size: 3.1rem;
    color: #fff;
    text-align: center;
    margin-bottom: 30px;
    margin-top: 30px;
    font-weight: 500;
    line-height: 1.4;
    word-wrap: break-word;
  }

  .main-display {
    margin-bottom: 40px;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .main-display img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .wisdom-title {
      font-size: 1.8rem;
    }
  }
</style>
