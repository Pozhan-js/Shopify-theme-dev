          Vietnam
        </td>
      </tr>
    </tbody>
  </table>

  <p class="note-text">{{ section.settings.brexit_note }}</p>

  <p>{{ section.settings.delivery_note }}</p>

  <div class="content-section">
    <h2>{{ section.settings.returns_title }}</h2>
    <p>{{ section.settings.returns_text }} <a href="{{ section.settings.returns_link }}">here</a>.</p>
  </div>

  <div class="content-section">
    <h2>{{ section.settings.payment_title }}</h2>
    <p>{{ section.settings.payment_text }}</p>
  </div>

  <div class="content-section">
    <h2>{{ section.settings.vat_title }}</h2>
    <p>{{ section.settings.vat_text }}</p>
  </div>
</div>

