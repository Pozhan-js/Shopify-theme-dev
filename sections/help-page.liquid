      </tr>
    </tbody>
  </table>

  <p class="note-text">{{ section.settings.brexit_note }}</p>

  <p>{{ section.settings.delivery_note }}</p>

  <div class="richtext-content">
    {{ section.settings.returns_content }}
  </div>

  <div class="richtext-content">
    {{ section.settings.payment_content }}
  </div>

  <div class="richtext-content">
    {{ section.settings.vat_content }}
  </div>
</div>

