<style>
  .help-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }

  .help-page h1 {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 30px;
    letter-spacing: 0.5px;
  }

  .help-page p {
    line-height: 1.6;
    margin-bottom: 20px;
    color: #333;
  }

  .help-page a {
    color: #000;
    text-decoration: underline;
  }

  .help-page h2 {
    font-size: 16px;
    font-weight: 700;
    margin: 30px 0 15px 0;
  }

  .richtext-content {
    margin: 20px 0;
    line-height: 1.8;
  }

  .richtext-content h2 {
    font-size: 16px;
    font-weight: 700;
    margin: 30px 0 15px 0;
  }

  .richtext-content p {
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .richtext-content ul,
  .richtext-content ol {
    margin: 15px 0;
    padding-left: 25px;
  }

  .richtext-content li {
    margin-bottom: 8px;
  }

  .richtext-content strong {
    font-weight: 700;
  }

  .richtext-content em {
    font-style: italic;
  }

  .shipping-table {
    width: 100%;
    border-collapse: collapse;
    margin: 30px 0;
    border: 1px solid #000;
  }

  .shipping-table th,
  .shipping-table td {
    border: 1px solid #000;
    padding: 12px 15px;
    text-align: left;
    font-size: 14px;
  }

  .shipping-table th {
    background-color: #e9e9e9;
    font-weight: 700;
  }

  .shipping-table td {
    background-color: #fff;
  }

  .zones-table {
    width: 100%;
    border-collapse: collapse;
    margin: 30px 0;
    border: 1px solid #000;
  }

  .zones-table th,
  .zones-table td {
    border: 1px solid #000;
    padding: 12px 15px;
    text-align: left;
    font-size: 13px;
    vertical-align: top;
  }

  .zones-table th {
    background-color: #e9e9e9;
    font-weight: 700;
  }

  .note-text {
    font-style: italic;
    margin: 20px 0;
    font-size: 14px;
  }

  .content-section {
    margin: 30px 0;
  }

  @media (max-width: 768px) {
    .help-page {
      padding: 20px 15px;
    }

    .help-page h1 {
      font-size: 24px;
    }

    .shipping-table,
    .zones-table {
      font-size: 12px;
    }

    .shipping-table th,
    .shipping-table td,
    .zones-table th,
    .zones-table td {
      padding: 8px 10px;
    }

    /* Mobile zones layout */
    .shipping-table {
      display: none;
    }

    .mobile-zones {
      display: block;
    }

    .zone-item {
      border: 1px solid #000;
      margin-bottom: 15px;
      background-color: #fff;
    }

    .zone-header {
      background-color: #e9e9e9;
      padding: 12px 15px;
      font-weight: 700;
      font-size: 14px;
      border-bottom: 1px solid #000;
    }

    .zone-content {
      padding: 12px 15px;
    }

    .zone-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 8px 0;
      border-bottom: 1px solid #eee;
    }

    .zone-row:last-child {
      border-bottom: none;
    }

    .zone-label {
      font-size: 13px;
      color: #333;
    }

    .zone-value {
      font-weight: 700;
      font-size: 13px;
    }

    /* Mobile zones countries layout */
    .zones-table {
      display: none;
    }

    .mobile-zones-countries {
      display: block;
      margin: 30px 0;
    }

    .zone-country-item {
      border: 1px solid #000;
      margin-bottom: 15px;
      background-color: #fff;
    }

    .zone-country-header {
      background-color: #e9e9e9;
      padding: 12px 15px;
      font-weight: 700;
      font-size: 14px;
      border-bottom: 1px solid #000;
    }

    .zone-country-content {
      padding: 12px 15px;
      font-size: 13px;
      line-height: 1.6;
    }
  }

  @media (min-width: 769px) {
    .mobile-zones {
      display: none;
    }
    
    .mobile-zones-countries {
      display: none;
    }
  }
</style>

