<style>
  .help-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }

  .help-page h1 {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 30px;
    letter-spacing: 0.5px;
  }

  .help-page p {
    line-height: 1.6;
    margin-bottom: 20px;
    color: #333;
  }

  .help-page a {
    color: #000;
    text-decoration: underline;
  }

  .help-page h2 {
    font-size: 16px;
    font-weight: 700;
    margin: 30px 0 15px 0;
  }

  .address-block {
    margin: 20px 0;
    line-height: 1.8;
  }

  .shipping-table {
    width: 100%;
    border-collapse: collapse;
    margin: 30px 0;
    border: 1px solid #000;
  }

  .shipping-table th,
  .shipping-table td {
    border: 1px solid #000;
    padding: 12px 15px;
    text-align: left;
    font-size: 14px;
  }

  .shipping-table th {
    background-color: #f5f5f5;
    font-weight: 700;
  }

  .shipping-table td {
    background-color: #fff;
  }

  .zones-table {
    width: 100%;
    border-collapse: collapse;
    margin: 30px 0;
    border: 1px solid #000;
  }

  .zones-table th,
  .zones-table td {
    border: 1px solid #000;
    padding: 12px 15px;
    text-align: left;
    font-size: 13px;
    vertical-align: top;
  }

  .zones-table th {
    background-color: #f5f5f5;
    font-weight: 700;
  }

  .note-text {
    font-style: italic;
    margin: 20px 0;
    font-size: 14px;
  }

  .content-section {
    margin: 30px 0;
  }

  @media (max-width: 768px) {
    .help-page {
      padding: 20px 15px;
    }

    .help-page h1 {
      font-size: 24px;
    }

    .shipping-table,
    .zones-table {
      font-size: 12px;
    }

    .shipping-table th,
    .shipping-table td,
    .zones-table th,
    .zones-table td {
      padding: 8px 10px;
    }
  }
</style>

<div class="help-page">
  <h1>{{ section.settings.page_title }}</h1>
  
  <p>{{ section.settings.intro_text }}</p>
  
  <p>
    <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
  </p>

  <div class="address-block">
    <strong>{{ section.settings.company_name }}</strong><br>
    {{ section.settings.address_line1 }}<br>
    {{ section.settings.address_line2 }}<br>
    {{ section.settings.country }}
  </div>

  <div class="content-section">
    <h2>{{ section.settings.delivery_title }}</h2>
    <p>{{ section.settings.delivery_text }}</p>
  </div>

  <div class="content-section">
    <strong>Sweden</strong><br>
    {{ section.settings.sweden_dhl }}<br>
    {{ section.settings.sweden_pickup }}
  </div>

  <!-- Sweden Shipping Table -->
  <table class="shipping-table">
    <thead>
      <tr>
        <th>Zones</th>
        <th>Standard (1-4 working days)</th>
        <th>Free Shipping</th>
        <th>In-store pickup</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Sweden</td>
        <td>75 SEK</td>
        <td>2500 SEK</td>
        <td>Free</td>
      </tr>
    </tbody>
  </table>

  <!-- International Shipping Table -->
  <table class="shipping-table">
    <thead>
      <tr>
        <th>Zones</th>
        <th>Standard (5-10 working days)</th>
        <th>Express (1-5 working days)</th>
        <th>Free Shipping</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>Shipping Zone 1</td>
        <td>{{ section.settings.zone_1_standard }}</td>
        <td>{{ section.settings.zone_1_express }}</td>
        <td>{{ section.settings.zone_1_free }}</td>
      </tr>
      <tr>
        <td>Shipping Zone 2</td>
