        <td>{{ section.settings.zone_3_express }}</td>
        <td>{{ section.settings.zone_3_free }}</td>
      </tr>
      <tr>
        <td>Shipping Zone 4</td>
        <td>{{ section.settings.zone_4_standard }}</td>
        <td>{{ section.settings.zone_4_express }}</td>
        <td>{{ section.settings.zone_4_free }}</td>
      </tr>
      <tr>
        <td>Shipping Zone 5</td>
        <td>{{ section.settings.zone_5_standard }}</td>
        <td>{{ section.settings.zone_5_express }}</td>
        <td>{{ section.settings.zone_5_free }}</td>
      </tr>
      <tr>
        <td>Shipping Zone 6</td>
        <td>{{ section.settings.zone_6_standard }}</td>
        <td>{{ section.settings.zone_6_express }}</td>
        <td>{{ section.settings.zone_6_free }}</td>
      </tr>
      <tr>
        <td>Shipping Zone 7</td>
        <td>{{ section.settings.zone_7_standard }}</td>
        <td>{{ section.settings.zone_7_express }}</td>
        <td>{{ section.settings.zone_7_free }}</td>
      </tr>
      <tr>
        <td>Shipping Zone 8</td>
        <td>{{ section.settings.zone_8_standard }}</td>
        <td>{{ section.settings.zone_8_express }}</td>
        <td>{{ section.settings.zone_8_free }}</td>
      </tr>
    </tbody>
  </table>

  <!-- Zones Countries Table -->
  <table class="zones-table">
    <thead>
      <tr>
        <th>Shipping Zone 1</th>
        <th>Shipping Zone 2</th>
        <th>Shipping Zone 3</th>
        <th>Shipping Zone 4</th>
        <th>Shipping Zone 5</th>
        <th>Shipping Zone 6</th>
        <th>Shipping Zone 7</th>
        <th>Shipping Zone 8</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>
          Belgium<br>
          Germany<br>
          Netherlands
        </td>
        <td>
          Austria<br>
          Croatia<br>
          Denmark<br>
          Finland<br>
          France<br>
          Greece<br>
          Hungary<br>
          Italy<br>
          Luxembourg<br>
          Monaco<br>
          Portugal<br>
