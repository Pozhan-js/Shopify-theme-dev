<style>
  .help-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }

  .help-page h1 {
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 30px;
    letter-spacing: 0.5px;
  }

  .help-page p {
    line-height: 1.6;
    margin-bottom: 20px;
    color: #333;
  }

  .help-page a {
    color: #000;
    text-decoration: underline;
  }

  .help-page h2 {
    font-size: 16px;
    font-weight: 700;
    margin: 30px 0 15px 0;
  }

  .richtext-content {
    margin: 20px 0;
    line-height: 1.8;
  }

  .richtext-content h2 {
    font-size: 16px;
    font-weight: 700;
    margin: 30px 0 15px 0;
  }

  .richtext-content p {
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .richtext-content ul,
  .richtext-content ol {
    margin: 15px 0;
    padding-left: 25px;
  }

  .richtext-content li {
    margin-bottom: 8px;
  }

  .richtext-content strong {
    font-weight: 700;
  }

  .richtext-content em {
    font-style: italic;
  }

  .shipping-table {
    width: 100%;
    border-collapse: collapse;
    margin: 30px 0;
    border: 1px solid #000;
  }

  .shipping-table th,
  .shipping-table td {
    border: 1px solid #000;
    padding: 12px 15px;
    text-align: left;
    font-size: 14px;
  }

  .shipping-table th {
    background-color: #e9e9e9;
    font-weight: 700;
  }

  .shipping-table td {
    background-color: #fff;
  }

  .zones-table {
    width: 100%;
    border-collapse: collapse;
    margin: 30px 0;
    border: 1px solid #000;
  }

  .zones-table th,
  .zones-table td {
    border: 1px solid #000;
    padding: 12px 15px;
    text-align: left;
    font-size: 13px;
    vertical-align: top;
  }

  .zones-table th {
    background-color: #e9e9e9;
    font-weight: 700;
  }

  .note-text {
    font-style: italic;
    margin: 20px 0;
    font-size: 14px;
  }

  .content-section {
    margin: 30px 0;
  }

  @media (max-width: 768px) {
    .help-page {
      padding: 20px 15px;
    }

    .help-page h1 {
      font-size: 24px;
    }

    .shipping-table,
    .zones-table {
      font-size: 12px;
    }

    .shipping-table th,
    .shipping-table td,
    .zones-table th,
    .zones-table td {
      padding: 8px 10px;
    }
  }
</style>

<div class="help-page">
  <h1>{{ section.settings.page_title }}</h1>
  
  <div class="richtext-content">
    {{ section.settings.intro_content }}
  </div>

  <div class="richtext-content">
    {{ section.settings.contact_content }}
  </div>

  <div class="richtext-content">
    {{ section.settings.delivery_content }}
  </div>

  <!-- Sweden Shipping Table -->
  <table class="shipping-table">
    <thead>
      <tr>
        <th>Zones</th>
        <th>Standard (1-4 working days)</th>
        <th>Free Shipping</th>
        <th>In-store pickup</th>
      </tr>
    </thead>
