{% comment %}
  Product Info Section - Multi-SKU Support
  Displays current product information from Shopify product object
  Auto-fetches first product from collections if no specific product is set
  Supports backend editing through section settings
{% endcomment %}

{% liquid
  assign displayproduct = product
  if section.settings.selectedproduct != blank
    assign displayproduct = allproducts[section.settings.selectedproduct]
  elsif displayproduct == blank and collections.all.products.size > 0
    assign displayproduct = collections.all.products.first
  endif
%}

<style>
  .product-info-section {
    padding: {{ section.settings.paddingtop | times: 0.5 | round: 0 }}px 0 {{ section.settings.paddingbottom | times: 0.5 | round: 0 }}px 0;
    background: {{ section.settings.backgroundcolor }};
  }

  .product-info-container {
    max-width: 1280px;
    width: 90%;
    margin: 0 auto;
  }

  .product-info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .product-info-left {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .product-title {
    font-size: {{ section.settings.titlefontsize }}px;
    font-weight: bold;
    color: {{ section.settings.titlecolor }};
    margin: 0;
    line-height: 1.1;
  }

  .product-description {
    font-size: {{ section.settings.descriptionfontsize }}px;
    color: {{ section.settings.descriptioncolor }};
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }

  .price-row {
    display: flex;
    justify-content: space-between;
    font-size: {{ section.settings.pricefontsize }}px;
    font-weight: 600;
    color: {{ section.settings.pricecolor }};
    align-items: center;
  }

  .price-old {
    color: {{ section.settings.oldpricecolor }};
    text-decoration: line-through;
  }

  .price-discount {
    color: {{ section.settings.discountcolor }};
    font-weight: bold;
  }

  .sku-selector {
    margin: 1rem 0;
  }

  .sku-selector h3 {
    font-size: {{ section.settings.skutitlefontsize }}px;
    color: {{ section.settings.skutitlecolor }};
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .sku-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .sku-option {
    position: relative;
  }

  .sku-option input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .sku-option label {
    display: block;
    padding: 0.5rem 0.75rem;
    border: 2px solid {{ section.settings.skubordercolor }};
    border-radius: {{ section.settings.skuborderradius }}px;
    background: {{ section.settings.skubackgroundcolor }};
    color: {{ section.settings.skutextcolor }};
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: {{ section.settings.skufontsize }}px;
    font-weight: 500;
    text-align: center;
    min-width: 70px;
  }

  .sku-option input[type="radio"]:checked + label {
    border-color: #9ABD48;
    background: #9ABD48;
    color: white;
  }

  .sku-option label:hover {
    border-color: #9ABD48;
  }

  .quantity-selector {
    margin: 0.75rem 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .quantity-selector label {
    font-size: {{ section.settings.quantityfontsize }}px;
    color: {{ section.settings.quantitycolor }};
    font-weight: 600;
  }

  .quantity-input {
    display: flex;
    align-items: center;
    border: 2px solid {{ section.settings.quantitybordercolor }};
    border-radius: {{ section.settings.quantityborderradius }}px;
    overflow: hidden;
  }

  .quantity-btn {
    background: {{ section.settings.quantitybtnbackground }};
    color: {{ section.settings.quantitybtncolor }};
    border: none;
    padding: 0.4rem 0.6rem;
    cursor: pointer;
    font-size: 16px;
    font-weight: bold;
    transition: background 0.3s ease;
  }

  .quantity-btn:hover {
    background: #9ABD48;
    color: white;
  }

  .quantity-number {
    padding: 0.4rem 0.75rem;
    border: none;
    text-align: center;
    font-size: {{ section.settings.quantityfontsize }}px;
    font-weight: 600;
    width: 50px;
    background: white;
  }

  .benefits-list {
    margin: 1rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .benefit-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: {{ section.settings.benefitfontsize }}px;
    color: {{ section.settings.benefitcolor }};
  }

  .benefit-item .value {
    color: {{ section.settings.benefitvaluecolor }};
    font-weight: normal;
  }

  .total-row {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid #e5e7eb;
    display: flex;
    justify-content: space-between;
    font-size: {{ section.settings.totalfontsize }}px;
    font-weight: bold;
    color: {{ section.settings.totalcolor }};
  }

  .shipping-info {
    margin-bottom: 0.5rem;
    font-size: {{ section.settings.descriptionfontsize }}px;
    color: {{ section.settings.descriptioncolor }};
  }

  .shipping-info p {
    margin: 0px;
  }

  .disclaimer {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: {{ section.settings.disclaimercolor }};
    line-height: 1.4;
  }

  .disclaimer p {
    margin: 0.25rem 0;
  }

  .guarantee {
    margin-top: 0.75rem;
    font-weight: 600;
    color: {{ section.settings.guaranteecolor }};
    font-size: 0.9rem;
  }

  .guarantee p {
    margin: 0.25rem 0;
  }

  .flexible {
    font-size: 0.8rem;
    color: {{ section.settings.flexiblecolor }};
  }

  .flexible p {
    margin: 0.25rem 0;
  }

  .button-group {
    margin-top: 1.5rem;
    display: flex;
    gap: 0.75rem;
    flex-direction: column;
  }

  .add-to-cart-button, .buy-now-button {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: {{ section.settings.buttonborderradius }}px;
    font-size: {{ section.settings.buttonfontsize }}px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    text-align: center;
    transition: all 0.3s ease;
    width: 100%;
  }

  .add-to-cart-button {
    background: {{ section.settings.addtocartbgcolor }};
    color: {{ section.settings.addtocarttextcolor }};
    border: 2px solid #9ABD48;
  }

  .add-to-cart-button:hover {
    background: #9ABD48;
    color: white;
    transform: translateY(-1px);
  }

  .buy-now-button {
    background: #9ABD48;
    color: white;
  }

  .buy-now-button:hover {
    background: #8aa63f;
    transform: translateY(-1px);
  }

  .image-container {
    width: 100%;
    max-width: 630px;
    height: 700px;
    display: flex;
    align-items: center;
    /* justify-content: flex-end; */
    border-radius: {{ section.settings.imageborderradius }}px;
    /* overflow: hidden; */
    position: relative;
    flex-direction: column;
  }

  .main-image {
    max-width: 100%;

    width: auto;
    height: {{ section.settings.imageheight }}px;
    object-fit: contain;
    border-radius: {{ section.settings.imageborderradius }}px;
    transition: opacity 0.3s ease;
  }

  .main-image.changing {
    opacity: 0.7;
  }

  .placeholder-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9ca3af;
    font-size: 16px;
    background: #f9fafb;
    border-radius: {{ section.settings.imageborderradius }}px;
    border: 2px dashed #d1d5db;
  }

  .thumbnail-gallery {
    display: flex;
    gap: 8px;
    margin-top: 16px;
    overflow-x: auto;
    padding: 8px 16px;
    width: 100%;
    scrollbar-width: thin;
    /* position: absolute;
    bottom: -100px; */
  }

  @media (max-width: 768px) {
    .thumbnail-gallery {
      max-width: 100% ;
      padding: 8px;
    }
  }

  .thumbnail {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 4px;
    cursor: pointer;
    border: 1px solid #e5e7eb;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .thumbnail:hover {
    border-color: #9ABD48;
  }

  .thumbnail.active {
    border: 2px solid #9ABD48;
  }

  .product-form {
    width: 100%;
  }

  @media (max-width: 768px) {
    .product-info-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .product-info-left {
      gap: 0.5rem;
    }

    .product-title {
      font-size: {{ section.settings.titlefontsizemobile }}px;
    }

    .benefit-item, .price-row, .total-row {
      font-size: {{ section.settings.benefitfontsizemobile }}px;
    }

    .benefit-item {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .total-row {
      flex-direction: row;
      justify-content: space-between;
    }

    .button-group {
      flex-direction: column;
      gap: 0.5rem;
    }

    .sku-options {
      justify-content: center;
    }

    .quantity-selector {
      justify-content: center;
    }

    .image-container {
      justify-content: center;
      height: auto;
      max-width: 83vw;
      max-height: 500px;
      padding-bottom: 20px;
    }

    .main-image {
      height: auto;
      max-height: 300px;
    }

    .thumbnail-gallery {
      position: static;
      margin-top: 10px;
      padding: 8px 0;
      width: 100%;
    }
  }
</style>

{% comment %}
  Product Info Section - Multi-SKU Support + Thumbnail Filtering by SKU Number
{% endcomment %}

{% liquid
  assign displayproduct = product
  if section.settings.selectedproduct != blank
    assign displayproduct = allproducts[section.settings.selectedproduct]
  elsif displayproduct == blank and collections.all.products.size > 0
    assign displayproduct = collections.all.products.first
  endif
%}

<section class="product-info-section">
  <div class="product-info-container">
    <div class="product-info-grid">
      <!-- Left Content -->
      <div class="product-info-left">
        <h1 class="product-title">
          {% if section.settings.useproducttitle %}
            {{ displayproduct.title }}
          {% else %}
            {{ section.settings.producttitle | default: displayproduct.title }}
          {% endif %}
        </h1>

        <div class="product-description">
          {% if section.settings.useproductdescription %}
            {{ displayproduct.description }}
          {% else %}
            {{ section.settings.productdescription | default: displayproduct.description }}
          {% endif %}
        </div>

        <div class="price-row">
          <span id="current-price">
            {% if displayproduct.compareatprice > displayproduct.price %}
              {{ displayproduct.price | money }}
            {% else %}
              {{ displayproduct.price | money }}
            {% endif %}
          </span>
          {% if displayproduct.compareatprice > displayproduct.price %}
            <span class="price-old price-discount" id="old-price">{{ displayproduct.compareatprice | money }}</span>
          {% endif %}
        </div>

        {% if section.settings.shippinginfo != blank %}
          <div class="shipping-info">{{ section.settings.shippinginfo }}</div>
        {% endif %}

        <form class="product-form" action="/cart/add" method="post" enctype="multipart/form-data">
          {% if displayproduct.variants.size > 1 %}
            <div class="sku-selector">
              <h3>{{ section.settings.skuselectortitle }}</h3>
              <div class="sku-options">
                {% for variant in displayproduct.variants %}
                  <div class="sku-option">
                    <input
                      type="radio"
                      id="variant-{{ variant.id }}"
                      name="id"
                      value="{{ variant.id }}"
                      data-price="{{ variant.price | money }}"
                      data-old-price="{% if variant.compareatprice > variant.price %}{{ variant.compareatprice | money }}{% endif %}"
                      data-available="{{ variant.available }}"
                      data-image="{% if variant.image %}{{ variant.image | img_url: '800x800' }}{% elsif displayproduct.featured_image %}{{ displayproduct.featured_image | img_url: '800x800' }}{% endif %}"
                      data-image-alt="{% if variant.image %}{{ variant.image.alt | default: variant.title }}{% else %}{{ displayproduct.featured_image.alt | default: displayproduct.title }}{% endif %}"
                      {% if forloop.first %}checked{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                    >
                    <label for="variant-{{ variant.id }}">{{ variant.title }}</label>
                  </div>
                {% endfor %}
              </div>
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ displayproduct.selected_or_first_available_variant.id }}">
          {% endif %}

          <div class="quantity-selector">
            <label for="quantity">{{ section.settings.quantitylabel }}:</label>
            <div class="quantity-input">
              <button type="button" class="quantity-btn" onclick="changeQuantity(-1)">−</button>
              <input type="number" id="quantity" name="quantity" value="1" min="1" class="quantity-number" readonly>
              <button type="button" class="quantity-btn" onclick="changeQuantity(1)">+</button>
            </div>
          </div>

          <div class="total-row">
            <span>{{ section.settings.totallabel }}</span>
            <span id="total-price">{{ displayproduct.price | money }}</span>
          </div>

          <div class="button-group">
            <button type="submit" name="add" class="add-to-cart-button" id="add-to-cart-btn">
              {{ section.settings.addtocarttext }}
            </button>
            <button type="button" class="buy-now-button" id="buy-now-btn">
              {{ section.settings.buynowtext }}
            </button>
          </div>
        </form>
      </div>

      <!-- Right Image -->
      <div class="image-container">
        {% assign imageurl = '' %}
        {% assign imagealt = '' %}

        {% if section.settings.useproductimage and displayproduct.featured_image %}
          {% assign imageurl = displayproduct.featured_image | img_url: '800x800' %}
          {% assign imagealt = displayproduct.featured_image.alt | default: displayproduct.title %}
        {% elsif section.settings.mainimage != blank %}
          {% assign imageurl = section.settings.mainimage | img_url: '800x800' %}
          {% assign imagealt = section.settings.mainimagealt | default: displayproduct.title %}
        {% elsif section.settings.fallbackimage != blank %}
          {% assign imageurl = section.settings.fallbackimage | img_url: '800x800' %}
          {% assign imagealt = section.settings.mainimagealt | default: displayproduct.title %}
        {% elsif displayproduct.featured_image %}
          {% assign imageurl = displayproduct.featured_image | img_url: '800x800' %}
          {% assign imagealt = displayproduct.featured_image.alt | default: displayproduct.title %}
        {% endif %}

        {% if imageurl != blank and imageurl != '' %}
          <img
            id="main-product-image"
            src="{{ imageurl }}"
            alt="{{ imagealt }}"
            class="main-image"
            width="800"
            height="800"
            loading="lazy"
          >
          <div class="placeholder-image" style="display: none;">
            <span>{{ displayproduct.title | default: 'Product Image' }}</span>
          </div>
        {% else %}
          <div id="main-product-image" class="placeholder-image">
            <span>{{ displayproduct.title | default: 'No Image Available' }}</span>
          </div>
        {% endif %}

        {% if displayproduct.images.size > 1 %}
          <div class="thumbnail-gallery">
            {% for image in displayproduct.images %}
              {%- assign keytext = image.src | downcase -%}
              <img
                src="{{ image | img_url: '100x100' }}"
                alt="{{ image.alt | default: displayproduct.title }}"
                class="thumbnail{% if forloop.first %} active{% endif %}"
                width="100"
                height="100"
                data-image-key="{{ keytext }}"
                onclick="
                  document.getElementById('main-product-image').src='{{ image | img_url: '800x800' }}';
                  document.querySelectorAll('.thumbnail').forEach(thumb => thumb.classList.remove('active'));
                  this.classList.add('active');
                "
              >
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  function changeQuantity(change) {
    const quantityInput = document.getElementById('quantity');
    let num = parseInt(quantityInput.value);
    num = num + change;
    if (num < 1) num = 1;
    quantityInput.value = num;
    updateTotalPrice();
  }

  document.addEventListener('DOMContentLoaded', function () {
    const variantOptions = document.querySelectorAll('input[name="id"]');
    const currentPriceElement = document.getElementById('current-price');
    const oldPriceElement = document.getElementById('old-price');
    const addToCartBtn = document.getElementById('add-to-cart-btn');
    const buyNowBtn = document.getElementById('buy-now-btn');

    // 添加页面加载完成的总价更新函数
    function updateTotalPrice() {
      const quantityInput = document.getElementById('quantity');
      const currentPriceElement = document.getElementById('current-price');
      const totalPriceElement = document.getElementById('total-price');
      
      if (quantityInput && currentPriceElement && totalPriceElement) {
        const quantity = parseInt(quantityInput.value) || 1;
        const priceText = currentPriceElement.textContent.replace(/[^\d.]/g, '');
        const price = parseFloat(priceText) || 0;
        const total = quantity * price;
        
        totalPriceElement.textContent = '$' + total.toFixed(2);
      }
    }

    // 初始化总价
    updateTotalPrice();

    variantOptions.forEach(function (option) {
      option.addEventListener('change', function () {
        if (!this.checked) return;

        const newPrice = this.getAttribute('data-price');
        const newOldPrice = this.getAttribute('data-old-price');
        const isAvailable = this.getAttribute('data-available') === 'true';
        const newImage = this.getAttribute('data-image');
        const newImageAlt = this.getAttribute('data-image-alt');
        const variantTitle = this.nextElementSibling.textContent;

        if (newPrice) currentPriceElement.textContent = newPrice;
        if (newOldPrice && newOldPrice !== '') {
          if (!document.getElementById('old-price')) {
            const priceRow = document.querySelector('.price-row');
            const oldPriceSpan = document.createElement('span');
            oldPriceSpan.className = 'price-old price-discount';
            oldPriceSpan.id = 'old-price';
            priceRow.appendChild(oldPriceSpan);
          }
          document.getElementById('old-price').textContent = newOldPrice;
          document.getElementById('old-price').style.display = 'inline';
        } else if (oldPriceElement) {
          oldPriceElement.style.display = 'none';
        }

        // 添加错误处理
        try {
          // 🧩 根据变体名称中的数字过滤缩略图
          const variantTitle = this.nextElementSibling.textContent.toLowerCase();
          const match = variantTitle.match(/\d+/);
          const variantNumber = match ? match[0] : '';
          const thumbnails = document.querySelectorAll('.thumbnail');
          const mainImage = document.getElementById('main-product-image');

          // 先过滤缩略图并移除 active 状态
          thumbnails.forEach((thumb, index) => {
            const key = thumb.getAttribute('data-image-key').toLowerCase();
            const shouldShow = variantNumber && key.includes(variantNumber);
            const displayStyle = shouldShow ? 'inline-block' : (variantNumber ? 'none' : 'inline-block');
            
            thumb.style.display = displayStyle;
            thumb.classList.remove('active');
          });

          // 确定主图源：优先级 1. 变体图片 2. 第一个可见缩略图 3. 保持当前
          let finalImageSrc = null;
          let finalImageAlt = '';

          if (newImage && newImage.trim() !== '') {
            // 优先使用变体指定的图片
            finalImageSrc = newImage;
            finalImageAlt = newImageAlt || '';
          } else {
            // 如果变体没有指定图片，使用第一个可见缩略图
            const visibleThumb = Array.from(thumbnails).find(t => t.style.display !== 'none');
            if (visibleThumb) {
              finalImageSrc = visibleThumb.src.replace('100x100', '800x800');
              finalImageAlt = visibleThumb.alt || '';
              visibleThumb.classList.add('active');
            }
          }

          // 更新主图
          if (finalImageSrc && mainImage) {
            mainImage.src = finalImageSrc;
            mainImage.alt = finalImageAlt;
            
            // 如果使用的是变体图片，需要找到对应的缩略图并设为 active
            if (newImage && newImage.trim() !== '') {
              const matchingThumb = Array.from(thumbnails).find(thumb => {
                const thumbLargeUrl = thumb.src.replace('100x100', '800x800');
                return thumbLargeUrl === finalImageSrc && thumb.style.display !== 'none';
              });
              if (matchingThumb) {
                matchingThumb.classList.add('active');
              }
            }
          }
        } catch (error) {
          console.error('❌ SKU 图片切换出错:', error);
        }

        // 更新按钮状态
        addToCartBtn.disabled = !isAvailable;
        buyNowBtn.disabled = !isAvailable;
        addToCartBtn.textContent = isAvailable ? '{{ section.settings.addtocarttext }}' : 'Sold Out';

        updateTotalPrice();
      });
    });

    // Buy now - redirect to checkout
    document.getElementById('buy-now-btn').addEventListener('click', function () {
      const form = document.querySelector('.product-form');
      const formData = new FormData(form);
      fetch('/cart/add.js', { method: 'POST', body: formData })
        .then(() => { window.location.href = '/checkout'; })
        .catch(err => console.error('Error:', err));
    });

    updateTotalPrice();

    // 页面载入时按默认变体自动过滤
    const firstChecked = document.querySelector('input[name="id"]:checked');
    if (firstChecked) firstChecked.dispatchEvent(new Event('change'));
  });

  function updateTotalPrice() {
    const selectedVariant = document.querySelector('input[name="id"]:checked');
    const quantity = parseInt(document.getElementById('quantity').value);
    const totalPriceElement = document.getElementById('total-price');
    if (selectedVariant && selectedVariant.getAttribute('data-price')) {
      const unitPrice = selectedVariant.getAttribute('data-price');
      const num = parseFloat(unitPrice.replace(/[^0-9.]/g, ''));
      const currency = unitPrice.match(/[^\d\s,\.]+/);
      const symbol = currency ? currency[0] : '$';
      totalPriceElement.textContent = symbol + (num * quantity).toFixed(2);
    }
  }
</script>




{% schema %}
{
  "name": "Product Info Section",
  "settings": [
    {
      "type": "header",
      "content": "Product Selection"
    },
    {
      "type": "product",
      "id": "selectedproduct",
      "label": "Select Product",
      "info": "Choose a specific product to display. Leave empty to use current page product or first available product."
    },
    {
      "type": "header",
      "content": "Product Data Settings"
    },
    {
      "type": "checkbox",
      "id": "useproducttitle",
      "label": "Use Product Title",
      "default": true,
      "info": "Use the actual product title instead of custom title"
    },
    {
      "type": "checkbox",
      "id": "useproductdescription",
      "label": "Use Product Description",
      "default": true,
      "info": "Use the actual product description instead of custom description"
    },
    {
      "type": "checkbox",
      "id": "useproductimage",
      "label": "Use Product Featured Image",
      "default": true,
      "info": "Use the product's featured image instead of custom image"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "paddingtop",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 64
    },
    {
      "type": "range",
      "id": "paddingbottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 64
    },
    {
      "type": "color",
      "id": "backgroundcolor",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Image Settings"
    },
