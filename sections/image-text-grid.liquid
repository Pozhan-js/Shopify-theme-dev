<!-- sections/store-info-grid.liquid -->
<div class="store-info-grid-section">
  <!-- 横幅部分 -->
  {% if section.settings.banner_image %}
    <div class="content-container">
      <div class="banner-container">
        <img
          src="{{ section.settings.banner_image | img_url: '1920x600' }}"
          alt="{{ section.settings.banner_image.alt | escape }}"
          class="banner-image"
          loading="lazy"
        >
        {% if section.settings.banner_text %}
          <div class="banner-overlay">
            <h2 class="banner-title">{{ section.settings.banner_text }}</h2>
          </div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  <!-- 店面信息网格部分 -->
  {% if section.blocks.size > 0 %}
    <div class="content-container">
      <div class="grid-container">
        {% for block in section.blocks %}
          <div class="grid-item" {{ block.shopify_attributes }}>
            <!-- 地址信息 -->
            {% if block.settings.address %}
              <div class="store-address">
                <svg
                  class="address-icon"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" fill="currentColor"/>
                </svg>
                <span class="address-text">{{ block.settings.address }}</span>
              </div>
            {% endif %}

            <!-- 店面图片 -->
            {% if block.settings.image %}
              <div class="store-image">
                <img
                  src="{{ block.settings.image | img_url: '600x400' }}"
                  alt="{{ block.settings.image.alt | escape }}"
                  loading="lazy"
                >
              </div>
            {% endif %}

            <!-- 店面信息内容 -->
            {% if block.settings.content %}
              <div class="store-content">
                {{ block.settings.content }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
</div>

<style>
  .store-info-grid-section {
    width: 100%;
  }

  /* 内容容器 - 统一宽度 */
  .content-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0;
  }

  /* 横幅样式 - 与卡片同宽 */
  .banner-container {
    position: relative;
    width: 100%;
    height: 400px;
    overflow: hidden;
  }

  .banner-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .banner-overlay {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: white;
    z-index: 2;
  }

  .banner-title {
    font-size: 3rem;
    font-weight: bold;
    margin: 0;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }

  /* 网格布局 */
  .grid-container {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }

  .grid-item {
    background-color: {{ section.settings.card_background_color | default: 'transparent' }};

    overflow: hidden;
    transition: transform 0.3s ease;
  }


  /* 地址信息样式 */
  .store-address {
    display: flex;
    align-items: center;
    padding: 16px 24px;
    background: transparent;
  }

  .address-icon {
    color: #000000;
    margin-right: 8px;
    flex-shrink: 0;
  }

  .address-text {
    color: #333;
    font-size: 0.9rem;
    font-weight: 500;
  }

  /* 店面图片样式 - 居中显示，左右内边距 */
  .store-image {
    padding: 0 30px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 20px;
  }

  .store-image img {
    width: 100%;
    max-width: 100%;
    height: 250px;
    object-fit: cover;
    transition: transform 0.3s ease;
  }



  /* 店面内容样式 */
  .store-content {
    padding: 0 24px 24px 24px;
    color: #666;
    line-height: 1.6;
  }

  /* 富文本样式 */
  .store-content h1,
  .store-content h2,
  .store-content h3,
  .store-content h4,
  .store-content h5,
  .store-content h6 {
    color: #333;
    margin: 0 0 16px 0;
    font-weight: 600;
  }

  .store-content h1 { font-size: 1.8rem; }
  .store-content h2 { font-size: 1.6rem; }
  .store-content h3 { font-size: 1.4rem; }
  .store-content h4 { font-size: 1.2rem; }
  .store-content h5 { font-size: 1.1rem; }
  .store-content h6 { font-size: 1rem; }

  .store-content p {
    margin: 0 0 16px 0;
  }

  .store-content p:last-child {
    margin-bottom: 0;
  }

  .store-content ul,
  .store-content ol {
    margin: 0 0 16px 0;
    padding-left: 20px;
  }

  .store-content li {
    margin-bottom: 8px;
  }

  .store-content a {
    color: #007cba;
    text-decoration: none;
    transition: color 0.3s ease;
  }



  .store-content strong {
    font-weight: 600;
    color: #333;
  }

  .store-content em {
    font-style: italic;
  }

  .store-content blockquote {
    border-left: 4px solid #007cba;
    padding-left: 16px;
    margin: 16px 0;
    font-style: italic;
    color: #555;
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    .content-container {
      padding: 0 16px;
    }

    .banner-container {
      height: 250px;
    }

    .banner-title {
      font-size: 2rem;
    }

    .grid-container {
      grid-template-columns: 1fr;
      /* gap: 24px; */
      margin-top: 24px;
    }

    .store-address {
      padding: 14px 20px;
    }

    .address-text {
      font-size: 0.85rem;
    }

    .store-image {
      padding: 0 20px;
      margin-bottom: 16px;
    }

    .store-image img {
      height: 200px;
    }

    .store-content {
      padding: 0 20px 20px 20px;
    }

    .store-content h1 { font-size: 1.5rem; }
    .store-content h2 { font-size: 1.4rem; }
    .store-content h3 { font-size: 1.3rem; }
    .store-content h4 { font-size: 1.2rem; }
    .store-content h5 { font-size: 1.1rem; }
    .store-content h6 { font-size: 1rem; }
  }

  @media (max-width: 480px) {
    .content-container {
      padding: 0 12px;
    }

    .banner-container {
      height: 200px;
    }

    .banner-title {
      font-size: 1.5rem;
    }

    .grid-container {
      /* gap: 20px; */
    }

    .store-address {
      padding: 12px 16px;
    }

    .address-icon {
      width: 14px;
      height: 14px;
    }

    .address-text {
      font-size: 0.8rem;
    }

    .store-image {
      padding: 0 16px;
      margin-bottom: 12px;
    }

    .store-image img {
      height: 180px;
    }

    .store-content {
      padding: 0 16px 16px 16px;
    }

    .store-content h1 { font-size: 1.3rem; }
    .store-content h2 { font-size: 1.25rem; }
    .store-content h3 { font-size: 1.2rem; }
    .store-content h4 { font-size: 1.1rem; }
    .store-content h5 { font-size: 1rem; }
    .store-content h6 { font-size: 0.95rem; }
  }
</style>

{% schema %}
{
  "name": "店面信息网格",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "横幅图片"
    },
    {
      "type": "text",
      "id": "banner_text",
      "label": "横幅标题",
      "default": "我们的店面"
    },
    {
      "type": "header",
      "content": "卡片样式设置"
    },
    {
      "type": "color",
      "id": "card_background_color",
      "label": "卡片背景色",
      "default": "transparent"
    }
  ],
  "blocks": [
    {
      "type": "store_info_item",
      "name": "店面信息项",
      "settings": [
        {
          "type": "text",
          "id": "address",
          "label": "店面地址",
          "default": "北京市朝阳区xxx街道xxx号"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "店面图片"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "店面信息",
          "default": "<h3>店面名称</h3><p><strong>营业时间：</strong>周一至周日 9:00-21:00</p><p><strong>联系电话：</strong>400-123-4567</p><p><strong>特色服务：</strong>提供专业的产品咨询和售后服务</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "店面信息网格",
      "blocks": [
        {
          "type": "store_info_item"
        },
        {
          "type": "store_info_item"
        }
      ]
    }
  ]
}
{% endschema %}
