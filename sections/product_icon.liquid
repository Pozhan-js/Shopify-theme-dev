<div class="feature-highlights-section">
  <div class="feature-highlights-container">
    <!-- 标题区域（样式与之前保持一致） -->
    <div class="sustainable-manufacturing-header">
      {% if section.settings.title != blank %}
        <h2 class="sustainable-manufacturing-title">{{ section.settings.title }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <p class="sustainable-manufacturing-description">{{ section.settings.description }}</p>
      {% endif %}
    </div>

    <!-- 功能图标卡片区域 -->
    <div class="feature-highlights-grid">
      {% for block in section.blocks %}
        {% if block.type == 'feature_card' %}
          <div class="feature-card" {{ block.shopifyattributes }}>
            <!-- 功能图标 -->
            <div class="feature-card-icon">
              {% if block.settings.icon != blank %}
                <img
                  src="{{ block.settings.icon | img_url: '80x80' }}"
                  alt="{{ block.settings.title }}"
                  loading="lazy"
                >
              {% else %}
                <!-- 占位图标 -->
                <div class="feature-card-placeholder-icon">
                  <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                    <circle cx="20" cy="20" r="18" fill="#F8EFEA" />
                  </svg>
                </div>
              {% endif %}
            </div>

            <!-- 功能标题 + 描述 -->
            <h3 class="feature-card-title">{{ block.settings.title }}</h3>
            <p class="feature-card-desc">{{ block.settings.desc }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  /* 复用之前的标题样式（与可持续制造模块标题一致） */
  .sustainable-manufacturing-header {
    text-align: center;
    margin-bottom: 40px;
  }

  .sustainable-manufacturing-title {
    font-size: 40px;
    font-weight: 500;
    color: #161616;
    margin: 0 0 20px;
    line-height: 1.2;
  }

  .sustainable-manufacturing-description {
    font-size: {{ section.settings.descriptionsize }}px;
    color: rgba(22, 22, 22, 0.5);
    line-height: 1.6;
    max-width: 940px;
    margin: 0 auto;
  }

  /* 功能卡片区域样式 */
  .feature-highlights-section {
    padding: 60px 0;
    background-color: {{ section.settings.backgroundcolor }};
  }

  .feature-highlights-container {
    max-width: 1626px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .feature-highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 30px;
    justify-items: center;
    text-align: center;
  }

  .feature-card {
    max-width: 220px;
  }

  .feature-card-icon {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background-color: #F8EFEA; /* 示例图中图标背景色 */
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 20px;
  }

  .feature-card-icon img {
    width: 40%;
    height: 40%;
    object-fit: contain;
  }

  .feature-card-title {
    font-size: 18px;
    font-weight: 500;
    color: #161616;
    margin: 0 0 10px;
    text-transform: capitalize;
  }

  .feature-card-desc {
    font-size: 14px;
    color: rgba(22, 22, 22, 0.5);
    line-height: 1.5;
    margin: 0;
  }

  /* 响应式适配（与之前模块逻辑一致） */
  @media (max-width: 768px) {
    .sustainable-manufacturing-title {
      font-size: 30px;
    }

    .sustainable-manufacturing-description {
      font-size: {{ section.settings.descriptionsize | minus: 2 }}px;
    }

    .feature-highlights-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 480px) {
    .sustainable-manufacturing-title {
      font-size: 27px;
    }

    .sustainable-manufacturing-description {
      font-size: {{ section.settings.descriptionsize | minus: 3 }}px;
    }

    .feature-highlights-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "功能亮点展示",
  "tag": "section",
  "class": "feature-highlights-section",
  "settings": [
    {
      "type": "header",
      "content": "标题设置"
    },
    {
      "type": "text",
      "id": "title",
      "label": "模块标题",
      "default": "Silent Strength. Built to Perform."
    },
    {
      "type": "range",
      "id": "titlesize",
      "label": "标题字体大小",
      "min": 24,
      "max": 48,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "模块描述",
      "default": "Engineered for total-body control, studio-grade durability, and brand-level customization."
    },
    {
      "type": "range",
      "id": "descriptionsize",
      "label": "描述字体大小",
      "min": 14,
      "max": 20,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "布局设置"
    },
    {
      "type": "color",
      "id": "backgroundcolor",
      "label": "背景颜色",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "feature_card",
      "name": "功能卡片",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "卡片图标"
        },
        {
          "type": "text",
          "id": "title",
          "label": "卡片标题",
          "default": "Precision Glide System"
        },
        {
          "type": "textarea",
          "id": "desc",
          "label": "卡片描述",
          "default": "Dual-rail carriage and sealed bearings deliver ultra-smooth, silent motion."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "功能亮点预设",
      "blocks": [
        {
          "type": "feature_card",
          "settings": {
            "title": "Precision Glide System",
            "desc": "Dual-rail carriage and sealed bearings deliver ultra-smooth, silent motion."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Reinforced Frame Integrity",
            "desc": "Whether crafted from aluminum or solid wood — built for strength and longevity."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Balanced Spring Resistance",
            "desc": "Fine-tuned tension supports deep-core activation and movement control."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Comfort-Driven Craftsmanship",
            "desc": "Soft-touch upholstery and ergonomic contours for lasting comfort in every session."
          }
        },
        {
          "type": "feature_card",
          "settings": {
            "title": "Fully Customizable Aesthetic",
            "desc": "14+ upholstery colors and material finishes — scalable OEM personalization for any brand."
          }
        }
      ]
    }
  ]
}
{% endschema %}