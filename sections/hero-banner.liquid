<style>
  /* Hero Banner Styles */
  .hero-banner-section {
    margin-top:74px;
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    border-radius: 16px;
    overflow: hidden;
  }

  .hero-banner-video-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .hero-banner-video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.2) 100%);
    z-index: -1;
  }

  .hero-banner-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 128px 24px 0;
    width: 90%;
  }

  .hero-banner-content {
    max-width: 1024px;
  }

  .hero-banner-title {
    color: #FFFFFF;
    font-weight: 500;
    line-height: 60px;
    letter-spacing: -0.02em;
    font-size: 40px;
    margin-bottom: 24px;
    font-family: 'Inter'
    , system-ui
    , sans-serif;
  }

  .hero-banner-subtitle {
    margin-bottom: 32px;
    max-width: 600px;
  }

  .hero-banner-subtitle-line {
    color: #FFFFFF;
    font-weight: 400;
    line-height: 30px;
    font-size: 16px;
    margin: 0 0 8px 0;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }

  .hero-banner-subtitle-line:last-child {
    margin-bottom: 0;
  }

  .hero-banner-cta-button {
    background-color: #c22e35;
    color: white;
    border: 1px solid #c22e35;
    transition: all 0.7s cubic-bezier(0.83, 0, 0.17, 1);
    width: 180px;
    height: 59.76px;
    border-radius: 4px;
    font-weight: 600;
    font-size: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-decoration: none;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    padding: 0;
    z-index: 1;
  }

  .hero-banner-cta-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    background-color: white;
    transition: width 0.7s cubic-bezier(0.83, 0, 0.17, 1);
    z-index: -1;
  }

  .hero-banner-cta-button:hover::before {
    width: 100%;
  }

  .hero-banner-cta-button:hover {
    color: #161616;
    box-shadow: 0 6px 20px rgba(220, 38, 38, 0.4);
    transform: translateY(-2px);
  }

  .hero-banner-cta-icon {
    transition: transform 0.3s ease;
  }

  .hero-banner-cta-button:hover .hero-banner-cta-icon {
    transform: translateX(4px);
  }

  /* Default background if no video is set */
  .hero-banner-section.hero-banner-default-bg {
    background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.8));
  }

  /* Responsive styles */
  @media (max-width: 480px) {
    .hero-banner-section {
      background-attachment: scroll;
      min-height: 100vh;
      margin-top:48px;
    }

    .hero-banner-container {
      padding: 80px 16px 0;
      width: 90%;
    }

    .hero-banner-content {
      max-width: 100%;
    }

    .hero-banner-title {
      font-size: 24px;
      line-height: 36px;
      margin-bottom: 16px;
    }

    .hero-banner-subtitle {
      margin-bottom: 24px;
      max-width: 100%;
    }

    .hero-banner-subtitle-line {
      font-size: 12px;
      line-height: 20px;
      white-space: normal;
    }

    .hero-banner-cta-button {
      width: 140px;
      height: 36px;
      font-size: 10.375px;
      gap: 4px;
    }

    .hero-banner-cta-button .hero-banner-cta-icon {
      width: 12px;
      height: 12px;
    }
  }

  @media (min-width: 481px) and (max-width: 768px) {
    .hero-banner-section {
      background-attachment: scroll;
      min-height: 100vh;
      margin-top:52px;
    }

    .hero-banner-container {
      padding: 90px 20px 0;
      width: 90%;
    }

    .hero-banner-content {
      max-width: 100%;
    }

    .hero-banner-title {
      font-size: 27px;
      line-height: 40px;
      margin-bottom: 18px;
    }

    .hero-banner-subtitle {
      margin-bottom: 26px;
      max-width: 100%;
    }

    .hero-banner-subtitle-line {
      font-size: 13px;
      line-height: 22px;
      white-space: normal;
    }

    .hero-banner-cta-button {
      width: 150px;
      height: 57px;
      font-size: 14px;
      gap: 6px;
    }

    .hero-banner-cta-button .hero-banner-cta-icon {
      width: 12px;
      height: 12px;
    }
  }

  @media (min-width: 769px) and (max-width: 1023px) {
    .hero-banner-section {
      background-attachment: scroll;
      min-height: 100vh;
      margin-top:48px;
    }

    .hero-banner-container {
      padding: 110px 28px 0;
      width: 90%;
    }

    .hero-banner-content {
      max-width: 800px;
    }

    .hero-banner-title {
      font-size: 30px;
      line-height: 46px;
      margin-bottom: 20px;
    }

    .hero-banner-subtitle {
      margin-bottom: 28px;
      max-width: 500px;
    }

    .hero-banner-subtitle-line {
      font-size: 13px;
      line-height: 24px;
    }

    .hero-banner-cta-button {
      width: 160px;
      height: 57px;
      font-size: 11px;
      gap: 7px;
    }

    .hero-banner-cta-button .hero-banner-cta-icon {
      width: 14px;
      height: 14px;
    }
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .hero-banner-section {
      background-attachment: scroll;
      min-height: 100vh;
      margin-top:56px;
    }
    .hero-banner-container {
      padding: 120px 30px 0;
      width: 90%;
    }

    .hero-banner-content {
      max-width: 900px;
    }

    .hero-banner-title {
      font-size: 33.5px;
      line-height: 50px;
      margin-bottom: 22px;
    }

    .hero-banner-subtitle {
      margin-bottom: 30px;
      max-width: 550px;
    }

    .hero-banner-subtitle-line {
      font-size: 14px;
      line-height: 26px;
    }

    .hero-banner-cta-button {
      width: 165px;
      height: 51px;
      font-size: 12px;
      gap: 7px;
    }

    .hero-banner-cta-button .hero-banner-cta-icon {
      width: 14px;
      height: 14px;
    }
  }

  @media (min-width: 1280px) and (max-width: 1439px) {
    .hero-banner-section {
      background-attachment: scroll;
      min-height: 100vh;
      margin-top:60px;
    }
    .hero-banner-container {
      padding: 125px 32px 0;
      width: 90%;
    }

    .hero-banner-content {
      max-width: 1000px;
    }

    .hero-banner-title {
      font-size: 35px;
      line-height: 52px;
      margin-bottom: 23px;
    }

    .hero-banner-subtitle {
      margin-bottom: 31px;
      max-width: 580px;
    }

    .hero-banner-subtitle-line {
      font-size: 14px;
      line-height: 27px;
    }

    .hero-banner-cta-button {
      width: 170px;
      height: 51px;
      font-size: 12px;
      gap: 7px;
    }

    .hero-banner-cta-button .hero-banner-cta-icon {
      width: 15px;
      height: 15px;
    }
  }

  @media (min-width: 1440px) and (max-width: 1679px) {
    .hero-banner-section {
      background-attachment: scroll;
      min-height: 100vh;
      margin-top:60px;
    }
    .hero-banner-container {
      padding: 126px 32px 0;
      width: 90%;
    }

    .hero-banner-content {
      max-width: 1000px;
    }

    .hero-banner-title {
      font-size: 37px;
      line-height: 55px;
      margin-bottom: 23px;
    }

    .hero-banner-subtitle {
      margin-bottom: 31px;
      max-width: 580px;
    }

    .hero-banner-subtitle-line {
      font-size: 14px;
      line-height: 28px;
    }

    .hero-banner-cta-button {
      width: 172px;
      height: 51px;
      font-size: 12px;
      gap: 7px;
    }

    .hero-banner-cta-button .hero-banner-cta-icon {
      width: 15px;
      height: 15px;
    }
  }

  @media (min-width: 1680px) and (max-width: 1919px) {
    .hero-banner-section {
      background-attachment: scroll;
      min-height: 100vh;
      margin-top:60px;
    }
    .hero-banner-container {
      padding: 127px 32px 0;
      width: 90%;
    }

    .hero-banner-content {
      max-width: 1020px;
    }

    .hero-banner-title {
      font-size: 38px;
      line-height: 58px;
      margin-bottom: 23px;
    }

    .hero-banner-subtitle {
      margin-bottom: 31px;
      max-width: 590px;
    }

    .hero-banner-subtitle-line {
      font-size: 15px;
      line-height: 29px;
    }

    .hero-banner-cta-button {
      width: 175px;
      height: 51px;
      font-size: 12px;
      gap: 7px;
    }

    .hero-banner-cta-button .hero-banner-cta-icon {
      width: 15px;
      height: 15px;
    }
  }

  @media (min-width: 1920px) {
    .hero-banner-container {
      padding: 128px 32px 0;
      width: 90%;
    }

    .hero-banner-content {
      max-width: 1024px;
    }

    .hero-banner-title {
      font-size: 40px;
      line-height: 60px;
      margin-bottom: 24px;
    }

    .hero-banner-subtitle {
      margin-bottom: 32px;
      max-width: 600px;
    }

    .hero-banner-subtitle-line {
      font-size: 15px;
      line-height: 30px;
    }

    .hero-banner-cta-button {
      width: 180px;
      height: 50px;
      font-size: 12px;
      gap: 8px;
    }

    .hero-banner-cta-button .hero-banner-cta-icon {
      width: 16px;
      height: 16px;
    }
  }

  /* Animation effects */
  @keyframes hero-banner-fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-banner-content > * {
    animation: hero-banner-fadeInUp 0.8s ease-out forwards;
  }

  .hero-banner-title {
    animation-delay: 0.2s;
  }

  .hero-banner-subtitle {
    animation-delay: 0.4s;
  }

  .hero-banner-cta-button {
    animation-delay: 0.6s;
  }
</style>

<section class="hero-banner-section {% if section.settings.herobackgroundvideo == blank %}hero-banner-default-bg{% endif %}">
  {% if section.settings.herobackgroundvideo != blank %}
    <video 
      class="hero-banner-video-background" 
      autoplay 
      muted 
      loop 
      playsinline
      preload="metadata">
      <source src="{{ section.settings.herobackgroundvideo.sources[1].url }}" type="video/mp4">
    </video>
    <div class="hero-banner-video-overlay"> </div>
  {% endif %}
  
  <div class="hero-banner-container">
    <div class="hero-banner-content">
      <h1 class="hero-banner-title">
        {% if section.settings.herotitle != blank %}
          {{ section.settings.herotitle | newlinetobr }}
        {% else %}
          The Pilates Equipment<br>
          Manufacturer Behind Global<br>
          Pilates Brands
        {% endif %}
      </h1>

      <div class="hero-banner-subtitle">
        {% if section.settings.herosubtitleline1 != blank or section.settings.herosubtitleline2 != blank %}
          {% if section.settings.herosubtitleline1 != blank %}
            <p class="hero-banner-subtitle-line">{{ section.settings.herosubtitleline1 }}</p>
          {% endif %}
          {% if section.settings.herosubtitleline2 != blank %}
            <p class="hero-banner-subtitle-line">{{ section.settings.herosubtitleline2 }}</p>
          {% endif %}
        {% else %}
          <p class="hero-banner-subtitle-line">Supplying 25%+ of the world's total pilates equipment production</p>
          <p class="hero-banner-subtitle-line">with premium quality and innovative design solutions</p>
        {% endif %}
      </div>

      {% if section.settings.showctabutton %}
        <a href="{{ section.settings.ctalink | default: '#quote' }}" class="hero-banner-cta-button">
          <svg
            class="hero-banner-cta-icon"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7" />
          </svg>
          <span>{{ section.settings.ctatext | default: 'GET A QUOTE' }}</span>
        </a>
        <a href="{{ section.settings.ctalink-second | default: '#quote' }}" class="hero-banner-cta-button">
          <svg
            class="hero-banner-cta-icon"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7" />
          </svg>
          <span>{{ section.settings.ctatext | default: 'GET A QUOTE' }}</span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
  {
    "name": "Hero Banner",
    "settings": [
      {
        "type": "video",
        "id": "herobackgroundvideo",
        "label": "Background Video",
        "info": "Upload MP4 video for background. Video will autoplay, loop, and be muted."
      },
      {
        "type": "textarea",
        "id": "herotitle",
        "label": "Hero Title",
        "default": "The Pilates Equipment\nManufacturer Behind Global\nPilates Brands",
        "info": "Use line breaks to control text layout"
      },
      {
        "type": "text",
        "id": "herosubtitleline1",
        "label": "Hero Subtitle - Line 1",
        "default": "Supplying 25%+ of the world's total pilates equipment production"
      },
      {
        "type": "text",
        "id": "herosubtitleline2",
        "label": "Hero Subtitle - Line 2",
        "default": "with premium quality and innovative design solutions"
      },
      {
        "type": "checkbox",
        "id": "showctabutton",
        "label": "Show CTA Button",
        "default": true
      },
      {
        "type": "text",
        "id": "ctatext",
        "label": "CTA Button Text",
        "default": "GET A QUOTE"
      },
      {
        "type": "url",
        "id": "ctalink",
        "label": "CTA Button Link",
        "info": "Where the button should link to"
      },
      {
        "type": "url",
        "id": "ctalink-second",
        "label": "CTA Button Link",
        "info": "Where the button should link to"
      }
    ],
    "presets": [
      {
        "name": "Hero Banner"
      }
    ]
  }
{% endschema %}
