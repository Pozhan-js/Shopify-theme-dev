{%
  schema
%}
{
  "name": "Chinese Aromatherapy",
  "tag": "section",
  "class": "aromatherapy-section-wrapper",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Chinese Aromatherapy"
    },
    {
      "type": "text",
      "id": "section_subtitle",
      "label": "Section Subtitle",
      "default": "Traditional Healing Through Natural Essences"
    },
    {
      "type": "textarea",
      "id": "section_description",
      "label": "Section Description",
      "default": "Chinese Aromatherapy integrates traditional Chinese medicine theory with modern aromatherapy techniques, using aromatic molecules from natural plant essential oils to regulate the body's qi-blood balance and achieve a harmonious state of mind and body wellness. This ancient and mysterious art carries the wisdom crystallized from five thousand years of Chinese civilization, providing modern people with a path to return to nature and cultivate both body and spirit."
    },
    {
      "type": "header",
      "content": "Feature Cards"
    },
    {
      "type": "text",
      "id": "feature_1_text",
      "label": "Feature 1 Text",
      "default": "Natural Plant Essences"
    },
    {
      "type": "text",
      "id": "feature_1_icon",
      "label": "Feature 1 Icon Class",
      "default": "fas fa-seedling"
    },
    {
      "type": "text",
      "id": "feature_2_text",
      "label": "Feature 2 Text",
      "default": "Yin-Yang Balance Therapy"
    },
    {
      "type": "text",
      "id": "feature_2_icon",
      "label": "Feature 2 Icon Class",
      "default": "fas fa-balance-scale"
    },
    {
      "type": "text",
      "id": "feature_3_text",
      "label": "Feature 3 Text",
      "default": "Mind-Body Harmony"
    },
    {
      "type": "text",
      "id": "feature_3_icon",
      "label": "Feature 3 Icon Class",
      "default": "fas fa-heart"
    },
    {
      "type": "text",
      "id": "feature_4_text",
      "label": "Feature 4 Text",
      "default": "Traditional Wellness Wisdom"
    },
    {
      "type": "text",
      "id": "feature_4_icon",
      "label": "Feature 4 Icon Class",
      "default": "fas fa-spa"
    },
    {
      "type": "header",
      "content": "Styling"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color",
      "default": "#5d6f5d"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color",
      "default": "#f59e0b"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Section Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Section Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Chinese Aromatherapy"
    }
  ]
}
{%
  endschema
%}

<section class="aromatherapy-section" 
         style="padding-top: {{ section.settings.section_padding_top }}px; padding-bottom: {{ section.settings.section_padding_bottom }}px;">
  
  <div class="aromatherapy-header">
    <!-- Floating Icon -->
    {% comment %} <div class="aromatherapy-icon">
      <i class="fas fa-yin-yang"></i>
    </div> {% endcomment %}
    
    <!-- Main Title -->
    <h1 class="aromatherapy-title">
      {{ section.settings.section_title }}
    </h1>
    
    <!-- Subtitle -->
    <h2 class="aromatherapy-subtitle">
      {{ section.settings.section_subtitle }}
    </h2>
    
    <!-- Description -->
    <p class="aromatherapy-description">
      {{ section.settings.section_description }}
    </p>
  </div>

  <!-- Feature Cards Grid -->
  <div class="feature-cards-grid">
    {% if section.settings.feature_1_text != blank %}
      <div class="feature-card">
        {% comment %} <div class="feature-card-icon">
          <i class="{{ section.settings.feature_1_icon }}"></i>
        </div> {% endcomment %}
        <h3 class="feature-card-title">{{ section.settings.feature_1_text }}</h3>
      </div>
    {% endif %}

    {% if section.settings.feature_2_text != blank %}
      <div class="feature-card">
        {% comment %} <div class="feature-card-icon">
          <i class="{{ section.settings.feature_2_icon }}"></i>
        </div> {% endcomment %}
        <h3 class="feature-card-title">{{ section.settings.feature_2_text }}</h3>
      </div>
    {% endif %}

    {% if section.settings.feature_3_text != blank %}
      <div class="feature-card">
        {% comment %} <div class="feature-card-icon">
          <i class="{{ section.settings.feature_3_icon }}"></i>
        </div> {% endcomment %}
        <h3 class="feature-card-title">{{ section.settings.feature_3_text }}</h3>
      </div>
    {% endif %}

    {% if section.settings.feature_4_text != blank %}
      <div class="feature-card">
        {% comment %} <div class="feature-card-icon">
          <i class="{{ section.settings.feature_4_icon }}"></i>
        </div> {% endcomment %}
        <h3 class="feature-card-title">{{ section.settings.feature_4_text }}</h3>
      </div>
    {% endif %}
  </div>
</section>

<style>
  /* Chinese Aromatherapy Section Styles */
  .aromatherapy-section {
    max-width: 1280px;
    margin: 0 auto;
    padding-left: 1rem;
    padding-right: 1rem;
    --primary-color: {{ section.settings.primary_color }};
    --accent-color: {{ section.settings.accent_color }};
    --bg-color: #fafafa;
  }

  .aromatherapy-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .aromatherapy-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
    background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
    border-radius: 50%;
    margin-bottom: 1.5rem;
    animation: float 6s ease-in-out infinite;
  }

  .aromatherapy-icon i {
    color: white;
    font-size: 1.5rem;
  }

  .aromatherapy-title {
    font-size: 3rem;
    font-weight: bold;
    background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
    font-family: 'Noto Serif SC', serif;
  }

  .aromatherapy-subtitle {
    font-size: 1.5rem;
    color: var(--primary-color);
    margin-bottom: 1.5rem;
    font-weight: 300;
  }

  .aromatherapy-description {
    font-size: 1.125rem;
    color: #6b7280;
    max-width: 64rem;
    margin: 0 auto 2.5rem;
    line-height: 1.75;
  }

  /* Feature Cards Grid */
  .feature-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .feature-card {
    background: white;
    border-radius: 16px;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
    border: 1px solid rgba(93, 111, 93, 0.1);
  }

  .feature-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 24px rgba(93, 111, 93, 0.15);
    border-color: var(--accent-color);
  }

  .feature-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    background: linear-gradient(135deg, var(--primary-color), var(--accent-color));
    color: white;
    border-radius: 50%;
    margin: 0 auto 1rem;
    font-size: 1.25rem;
  }

  .feature-card-title {
    font-size: 1.125rem;
    color: var(--primary-color);
    font-weight: 500;
    margin: 0;
  }

  /* Floating Animation */
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .aromatherapy-title {
      font-size: 2.5rem;
    }
    .aromatherapy-subtitle {
      font-size: 1.25rem;
    }
    .aromatherapy-description {
      font-size: 1rem;
    }
    .feature-cards-grid {
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .aromatherapy-title {
      font-size: 2rem;
    }
    .aromatherapy-icon {
      width: 4rem;
      height: 4rem;
    }
    .aromatherapy-icon i {
      font-size: 1.25rem;
    }
    .feature-card {
      padding: 1.25rem;
    }
    .feature-card-icon {
      width: 3rem;
      height: 3rem;
      font-size: 1.1rem;
    }
    .feature-card-title {
      font-size: 1rem;
    }
  }
</style>
