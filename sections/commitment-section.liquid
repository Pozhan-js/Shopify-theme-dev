<div class="commitment-section" {{ section.shopify_attributes }}>
  <div class="commitment-container">
    <div class="commitment-content">
      <!-- 左侧文本内容 -->
      <div class="commitment-text">
        {% if section.settings.heading != blank %}
          <h2 class="commitment-heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.paragraph_1 != blank %}
          <p class="commitment-paragraph">{{ section.settings.paragraph_1 }}</p>
        {% endif %}

        {% if section.settings.paragraph_2 != blank %}
          <p class="commitment-paragraph">{{ section.settings.paragraph_2 }}</p>
        {% endif %}
      </div>

      <!-- 右侧图片 -->
      <div class="commitment-image">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | img_url: '800x' }}"
            alt="{{ section.settings.image_alt | default: section.settings.heading }}"
            class="commitment-img"
          >
        {% else %}
          <div class="commitment-placeholder">
            <svg width="100" height="100" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect width="100" height="100" fill="#E5E5E5"/>
              <path d="M30 70L50 50L70 70" stroke="#999" stroke-width="2" fill="none"/>
              <circle cx="40" cy="35" r="5" fill="#999"/>
            </svg>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
  .commitment-section {
    background-color: {{ section.settings.background_color }};
    padding: 33px 0;
  }

  .commitment-container {
    max-width: 1750px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .commitment-content {
    display: grid;
    grid-template-columns: 498px 1fr;
    gap: 100px;
    align-items: center;
  }

  .commitment-text {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.paragraph_spacing }}px;
    width: 498px;
  }

  .commitment-heading {
    font-family: 'Poppins', sans-serif;
    font-size: 48px;
    font-weight: 500;
    color: {{ section.settings.heading_color }};
    line-height: {{ section.settings.heading_line_height }};
    margin: 0;
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
  }

  .commitment-paragraph {
    font-family: 'Poppins', sans-serif;
    font-size: 16px;
    font-weight: {{ section.settings.paragraph_font_weight }};
    color: rgba(22, 22, 22, 0.5);
    line-height: 32px;
    margin: 0;
    letter-spacing: {{ section.settings.paragraph_letter_spacing }}px;
  }

  .commitment-image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .commitment-img {
    width: 1080px;
    height: 800px;
    border-radius: {{ section.settings.image_border_radius }}px;
    box-shadow: {{ section.settings.image_shadow }};
    object-fit: cover;
  }

  .commitment-placeholder {
    width: 1080px;
    height: 800px;
    background-color: #f5f5f5;
    border-radius: {{ section.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px dashed #ddd;
  }

  /* 响应式设计 */

  /* 大屏幕 (1920px+) - 使用设计图精确尺寸 */
  @media (min-width: 1920px) {
    .commitment-container {
      max-width: 1750px;
      padding: 0 48px;
    }
    
    .commitment-content {
      gap: 100px;
    }
    
    .commitment-heading {
      font-size: 48px;
    }
    
    .commitment-paragraph {
      font-size: 16px;
      line-height: 32px;
    }
  }

  /* 中等屏幕 (1024px - 1919px) - 84%比例缩放 */
  @media (min-width: 1024px) and (max-width: 1919px) {
    .commitment-container {
      max-width: calc(1750px * 0.84);
      padding: 0 calc(48px * 0.84);
    }
    
    .commitment-content {
      grid-template-columns: calc(498px * 0.84) 1fr;
      gap: calc(100px * 0.84);
    }
    
    .commitment-text {
      gap: calc({{ section.settings.paragraph_spacing }}px * 0.84);
      width: calc(498px * 0.84);
    }
    
    .commitment-heading {
      font-size: calc(48px * 0.84);
    }
    
    .commitment-paragraph {
      font-size: calc(16px * 0.84);
      line-height: calc(32px * 0.84);
    }
    
    .commitment-img {
      width: calc(1080px * 0.84);
      height: calc(800px * 0.84);
    }
    
    .commitment-placeholder {
      width: calc(1080px * 0.84);
      height: calc(800px * 0.84);
    }
  }

  /* 平板屏幕 (768px - 1023px) - 67%比例缩放，垂直布局 */
  @media (min-width: 768px) and (max-width: 1023px) {
    .commitment-container {
      max-width: calc(1750px * 0.67);
      padding: 0 calc(48px * 0.67);
    }
    
    .commitment-content {
      grid-template-columns: 1fr;
      gap: calc(100px * 0.67);
      text-align: center;
    }
    
    .commitment-text {
      gap: calc({{ section.settings.paragraph_spacing }}px * 0.67);
      width: calc(498px * 0.67);
      margin: 0 auto;
    }
    
    .commitment-heading {
      font-size: calc(48px * 0.67);
    }
    
    .commitment-paragraph {
      font-size: calc(16px * 0.67);
      line-height: calc(32px * 0.67);
    }
    
    .commitment-img {
      width: calc(1080px * 0.67);
      height: calc(800px * 0.67);
    }
    
    .commitment-placeholder {
      width: calc(1080px * 0.67);
      height: calc(800px * 0.67);
    }
  }

  /* 小屏幕 (481px - 767px) - 50%比例缩放 */
  @media (min-width: 481px) and (max-width: 767px) {
    .commitment-section {
      padding: calc(33px * 0.5) 0 calc(33px * 0.5) 0;
    }
    
    .commitment-container {
      max-width: calc(1750px * 0.5);
      padding: 0 calc(48px * 0.5);
    }
    
    .commitment-content {
      grid-template-columns: 1fr;
      gap: calc(100px * 0.5);
      text-align: center;
    }
    
    .commitment-text {
      gap: calc({{ section.settings.paragraph_spacing }}px * 0.5);
      width: calc(498px * 0.5);
      margin: 0 auto;
    }
    
    .commitment-heading {
      font-size: calc(48px * 0.5);
    }
    
    .commitment-paragraph {
      font-size: calc(16px * 0.5);
      line-height: calc(32px * 0.5);
    }
    
    .commitment-img {
      width: calc(1080px * 0.5);
      height: calc(800px * 0.5);
    }
    
    .commitment-placeholder {
      width: calc(1080px * 0.5);
      height: calc(800px * 0.5);
    }
  }

  /* 超小屏幕 (最大480px) - 33%比例缩放 */
  @media (max-width: 480px) {
    .commitment-section {
      padding: calc(33px * 0.33) 0 calc(33px * 0.33) 0;
    }
    
    .commitment-container {
      max-width: calc(1750px * 0.33);
      padding: 0 calc(48px * 0.33);
      min-padding: 0 15px;
    }
    
    .commitment-content {
      grid-template-columns: 1fr;
      gap: calc(100px * 0.33);
      text-align: center;
      min-gap: 30px;
    }
    
    .commitment-text {
      gap: calc({{ section.settings.paragraph_spacing }}px * 0.33);
      min-gap: 15px;
      width: calc(498px * 0.33);
      margin: 0 auto;
      min-width: 250px;
    }
    
    .commitment-heading {
      font-size: calc(48px * 0.33);
      min-font-size: 18px;
    }
    
    .commitment-paragraph {
      font-size: calc(16px * 0.33);
      line-height: calc(32px * 0.33);
      min-font-size: 12px;
      min-line-height: 18px;
    }
    
    .commitment-img {
      width: calc(1080px * 0.33);
      height: calc(800px * 0.33);
      min-width: 250px;
      min-height: 185px;
    }
    
    .commitment-placeholder {
      width: calc(1080px * 0.33);
      height: calc(800px * 0.33);
      min-width: 250px;
      min-height: 185px;
    }
  }
</style>

{% schema %}
{
  "name": "Commitment Excellence",
  "tag": "section",
  "class": "commitment-section",
  "settings": [
    {
      "type": "header",
      "content": "区块设置"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#F1F0EE"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "顶部内边距",
      "default": 33
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "底部内边距",
      "default": 33
    },
    {
      "type": "header",
      "content": "内容设置"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "Our Commitment to Excellence"
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "第一段文本",
      "default": "At XSPilates, we believe that quality Pilates equipment should be accessible to everyone. That's why we've dedicated ourselves to creating professional-grade machines at prices that make sense for studios, trainers, and home practitioners alike."
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "第二段文本",
      "default": "Every piece of equipment we manufacture undergoes rigorous quality testing and is built to withstand years of intensive use. We use only premium materials and time-tested construction methods to ensure your investment delivers lasting value."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "右侧图片"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "图片描述",
      "info": "用于无障碍访问的图片描述"
    },
    {
      "type": "header",
      "content": "标题样式"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "标题字体大小",
      "default": 48
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "标题字体粗细",
      "options": [
        { "value": "300", "label": "细体" },
        { "value": "400", "label": "正常" },
        { "value": "500", "label": "中等" },
        { "value": "600", "label": "半粗" },
        { "value": "700", "label": "粗体" }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "标题颜色",
      "default": "#161616"
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "min": 1.0,
      "max": 2.0,
      "step": 0.1,
      "label": "标题行高",
      "default": 1.2,
      "unit": "em"
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "min": -2,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "label": "标题字母间距",
      "default": 0
    },
    {
      "type": "header",
      "content": "段落样式"
    },
    {
      "type": "range",
      "id": "paragraph_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "段落字体大小",
      "default": 16
    },
    {
      "type": "select",
      "id": "paragraph_font_weight",
      "label": "段落字体粗细",
      "options": [
        { "value": "300", "label": "细体" },
        { "value": "400", "label": "正常" },
        { "value": "500", "label": "中等" },
        { "value": "600", "label": "半粗" }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "paragraph_color",
      "label": "段落颜色",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "paragraph_line_height",
      "min": 1.0,
      "max": 2.5,
      "step": 0.1,
      "label": "段落行高",
      "default": 1.6,
      "unit": "em"
    },
    {
      "type": "range",
      "id": "paragraph_letter_spacing",
      "min": -1,
      "max": 3,
      "step": 0.1,
      "unit": "px",
      "label": "段落字母间距",
      "default": 0
    },
    {
      "type": "range",
      "id": "paragraph_spacing",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "段落间距",
      "default": 25
    },
    {
      "type": "header",
      "content": "图片样式"
    },
    {
      "type": "range",
      "id": "image_border_radius",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "图片圆角",
      "default": 12
    },
    {
      "type": "text",
      "id": "image_shadow",
      "label": "图片阴影",
      "default": "0 8px 32px rgba(0, 0, 0, 0.1)",
      "info": "CSS阴影值，例如：0 8px 32px rgba(0, 0, 0, 0.1)"
    }
  ],
  "presets": [
    {
      "name": "Commitment Excellence",
      "settings": {
        "heading": "Our Commitment to Excellence",
        "paragraph_1": "At XSPilates, we believe that quality Pilates equipment should be accessible to everyone. That's why we've dedicated ourselves to creating professional-grade machines at prices that make sense for studios, trainers, and home practitioners alike.",
        "paragraph_2": "Every piece of equipment we manufacture undergoes rigorous quality testing and is built to withstand years of intensive use. We use only premium materials and time-tested construction methods to ensure your investment delivers lasting value.",
        "background_color": "#F1F0EE",
        "heading_color": "#161616",
        "paragraph_color": "#666666",
        "heading_font_size": 48,
        "paragraph_font_size": 16,
        "heading_font_weight": "600",
        "paragraph_font_weight": "400",
        "section_padding_top": 33,
        "section_padding_bottom": 33
      }
    }
  ]
}
{% endschema %}
