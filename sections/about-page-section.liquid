<!-- About Page Section - About Us page content -->
    <div class="about-page-section">
      <div class="container">
        <div class="about-header">
          <h1 class="page-title">{{ section.settings.page_title | default: 'About Us' }}</h1>
          <p class="page-subtitle">{{ section.settings.page_subtitle | default: 'Baking with Heart, Delivering Happiness' }}</p>
        </div>

        <div class="about-content">
          <div class="content-section">
            <h2>{{ section.settings.section1_title | default: 'Our Story' }}</h2>
            <div class="content-text">
              {{
                section.settings.section1_content
                | default: '<p>Welcome to our baking world! We are a bakery specializing in handmade bread and exquisite desserts.</p><p>Since 2015, we have always insisted on using the highest quality ingredients and traditional handmade craftsmanship to bring fresh and delicious baked products to every customer.</p>'
              }}
            </div>
          </div>

          {% if section.settings.show_image1 and section.settings.image1 != blank %}
            <div class="about-image">
              <img
                src="{{ section.settings.image1 | image_url: width: 800 }}"
                alt="{{ section.settings.image1.alt | default: 'About Us' }}"
              >
            </div>
          {% endif %}

          <div class="content-section">
            <h2>{{ section.settings.section2_title | default: 'Our Philosophy' }}</h2>
            <div class="content-text">
              {{
                section.settings.section2_content
                | default: '<p><strong>Fresh:</strong> Made fresh daily to ensure the best taste</p><p><strong>Healthy:</strong> Selected premium ingredients, no preservatives added</p><p><strong>Innovative:</strong> Combining traditional craftsmanship with modern flavors</p>'
              }}
            </div>
          </div>

          <div class="features-grid">
            <div class="feature-item">
              <div class="feature-icon">🥐</div>
              <h3>Handmade</h3>
              <p>All products are handmade to ensure freshness and quality</p>
            </div>
            <div class="feature-item">
              <div class="feature-icon">🌾</div>
              <h3>Premium Ingredients</h3>
              <p>Selected imported flour and natural ingredients</p>
            </div>
            <div class="feature-item">
              <div class="feature-icon">❤️</div>
              <h3>Caring Service</h3>
              <p>Every customer can feel our dedication</p>
            </div>
          </div>

          <div class="content-section">
            <h2>{{ section.settings.section3_title | default: 'Contact Us' }}</h2>
            <div class="contact-info">
              <p><strong>Address:</strong>{{ section.settings.address | default: '123 Baking Street, Downtown District, City' }}</p>
              <p><strong>Phone:</strong>{{ section.settings.phone | default: '+1 (555) 123-4567' }}</p>
              <p><strong>Business Hours:</strong>{{ section.settings.hours | default: 'Monday - Sunday 8:00 AM - 8:00 PM' }}</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <style>
      .about-page-section {
        padding: 60px 20px;
        background: #fff;
      }

      .container {
        max-width: 1000px;
        margin: 0 auto;
      }

      .about-header {
        text-align: center;
        margin-bottom: 50px;
      }

      .page-title {
        font-size: 36px;
        font-weight: 600;
        color: #d8a26c;
        margin-bottom: 10px;
      }

      .page-subtitle {
        font-size: 18px;
        color: #666;
      }

      .about-content {
        display: flex;
        flex-direction: column;
        gap: 40px;
      }

      .content-section h2 {
        font-size: 28px;
        font-weight: 600;
        color: #d8a26c;
        margin-bottom: 20px;
      }

      .content-text {
        font-size: 16px;
        line-height: 1.8;
        color: #333;
      }

      .content-text p {
        margin-bottom: 15px;
      }

      .content-text strong {
        color: #d8a26c;
      }

      .about-image {
        margin: 20px 0;
        border-radius: 12px;
        overflow: hidden;
      }

      .about-image img {
        width: 100%;
        height: auto;
        display: block;
      }

      .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
        margin: 40px 0;
      }

      .feature-item {
        text-align: center;
        padding: 30px;
        background: #fafafa;
        border-radius: 12px;
      }

      .feature-icon {
        font-size: 48px;
        margin-bottom: 15px;
        color: #d8a26c;
      }

      .feature-item h3 {
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 10px;
        color: #333;
      }

      .feature-item p {
        color: #666;
        line-height: 1.6;
      }

      .contact-info {
        background: #fafafa;
        padding: 30px;
        border-radius: 12px;
      }

      .contact-info p {
        margin-bottom: 10px;
        font-size: 16px;
      }

      .contact-info strong {
        color: #d8a26c;
      }

      @media (max-width: 768px) {
        .about-page-section {
          padding: 40px 15px;
        }

        .page-title {
          font-size: 28px;
        }

        .page-subtitle {
          font-size: 16px;
        }

        .content-section h2 {
          font-size: 24px;
        }

        .content-text {
          font-size: 15px;
        }

        .features-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>

    {% schema %}
    {
      "name": "About Us Page",
      "settings": [
        {
          "type": "text",
          "id": "page_title",
          "label": "Page Title",
          "default": "About Us"
        },
        {
          "type": "text",
          "id": "page_subtitle",
          "label": "Page Subtitle",
          "default": "Baking with Heart, Delivering Happiness"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#D8A26C"
        },
        {
          "type": "image_picker",
          "id": "image1",
          "label": "About Us Image"
        },
        {
          "type": "text",
          "id": "section1_title",
          "label": "First Section Title",
          "default": "Our Story"
        },
        {
          "type": "richtext",
          "id": "section1_content",
          "label": "First Section Content",
          "default": "<p>Welcome to our baking world! We are a bakery specializing in handmade bread and exquisite desserts.</p><p>Since 2015, we have always insisted on using the highest quality ingredients and traditional handmade craftsmanship to bring fresh and delicious baked products to every customer.</p>"
        },
        {
          "type": "text",
          "id": "section2_title",
          "label": "Second Section Title",
          "default": "Our Philosophy"
        },
        {
          "type": "richtext",
          "id": "section2_content",
          "label": "Second Section Content",
          "default": "<p><strong>Fresh:</strong> Made fresh daily to ensure the best taste</p><p><strong>Healthy:</strong> Selected premium ingredients, no preservatives added</p><p><strong>Innovative:</strong> Combining traditional craftsmanship with modern flavors</p>"
        },
        {
          "type": "text",
          "id": "section3_title",
          "label": "Third Section Title",
          "default": "Contact Us"
        },
        {
          "type": "text",
          "id": "address",
          "label": "Store Address",
          "default": "123 Baking Street, Downtown District, City"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Contact Phone",
          "default": "+1 (555) 123-4567"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Business Hours",
          "default": "Monday - Sunday 8:00 AM - 8:00 PM"
        }
      ],
      "presets": [
        {
          "name": "About Us Page",
          "category": "Page Content"
        }
      ]
    }
    {% endschema %}
