{% comment %}
  ===================================================================
  博客文章模板 - 作者信息固定在底部 40px
  功能：
    - 背景图 = 文章特色图片（自动获取）
    - 顶部显示日期 + 类型（移动端保持左右布局）
    - 中部显示标题和内容
    - 作者信息固定在页面底部上方 40px 处
    - 去掉遮罩层，纯净背景
    - 响应式适配手机
  ===================================================================
{% endcomment %}

{%- assign blog_post = section.settings.blog_post_override | default: article -%}

{%- comment %} 获取文章特色图片作为背景，若无则使用备用图 {% endcomment %}
{%- if blog_post.image %}
  {%- assign background_image = blog_post.image | img_url: '2048x' | prepend: 'https:' -%}
{%- else %}
  {%- assign background_image = section.settings.fallback_image | img_url: '2048x' | prepend: 'https:' -%}
{%- endif %}

{%- comment %} 获取文章类型：取第一个标签，否则显示“未分类” {% endcomment %}
{%- if blog_post.tags.size > 0 %}
  {%- assign post_type = blog_post.tags.first -%}
{%- else %}
  {%- assign post_type = '未分类' -%}
{%- endif %}

{%- assign author_name = blog_post.author -%}

<div class="blog-post-section" style="background-image: url('{{ background_image }}');">
  <div class="container">
    <!-- 上部：左右结构 -->
    <div class="blog-header">
      <div class="date">{{ blog_post.published_at | date: "%Y/%m/%d" }}</div>
      <div class="type">{{ post_type }}</div>
    </div>

    <!-- 中部：标题和内容 -->
    <div class="blog-content">
      <h1 class="title">{{ blog_post.title }}</h1>
      <div class="body">
        {{ blog_post.content }}
      </div>
    </div>

    <!-- 下部：作者信息 - 固定在底部 40px -->
    <div class="blog-footer">
      <p class="author">作者：{{ author_name }}</p>
    </div>
  </div>
</div>

<style>
  .blog-post-section {
    min-height: 100vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 40px 16px;
    color: white;
    font-family: "Helvetica Neue", Arial, sans-serif;
    position: relative; /* 确保子元素可绝对定位 */
  }

  .container {
    max-width: 960px;
    margin: 0 auto;
    min-height: 100%; /* 容器撑满 */
    display: flex;
    flex-direction: column;
  }

  /* 上部：日期 + 类型 */
  .blog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    font-size: 14px;
    white-space: nowrap;
  }

  .blog-header .date {
    font-weight: normal;
    flex-shrink: 0;
  }

  .blog-header .type {
    background: transparent;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 13px;
    margin-left: auto;
    flex-shrink: 0;
  }

  /* 中部：标题和内容 */
  .blog-content {
    flex: 1; /* 占据剩余空间 */
    text-align: center;
  }

  .blog-content .title {
    font-size: 32px;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .blog-content .body {
    font-size: 16px;
    line-height: 1.8;
    background: transparent;
    padding: 24px;
    border-radius: 10px;
    text-align: left;
  }

  /* 作者信息：固定在距离底部 40px 的位置 */
  .blog-footer {
    position: absolute;
    bottom: 40px;
    left: 0;
    right: 0;
    text-align: center;
    width: 100%;
  }

  .blog-footer .author {
    font-size: 18px;
    font-weight: 500;
    display: inline-block;
    background: rgba(0, 0, 0, 0.3);
    color: white;
    padding: 8px 20px;
    border-radius: 30px;
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    .blog-header {
      font-size: 13px;
      padding: 0 4px;
    }
    .blog-header .date,
    .blog-header .type {
      font-size: 12px;
      padding: 3px 6px;
    }
    .blog-content .title {
      font-size: 26px;
    }
    .blog-content .body {
      font-size: 15px;
      padding: 20px;
    }
    .blog-footer .author {
      font-size: 16px;
      padding: 6px 16px;
    }
  }

  /* 超小屏适配 */
  @media (max-width: 480px) {
    .blog-header .date,
    .blog-header .type {
      font-size: 11px;
      padding: 2px 5px;
    }
    .blog-content .title {
      font-size: 24px;
    }
    .blog-content .body {
      font-size: 14px;
      line-height: 1.6;
      padding: 16px;
    }
    .blog-footer .author {
      font-size: 15px;
      padding: 6px 14px;
    }
  }
</style>

{% schema %}
{
  "name": "博客模板",
  "tag": "section",
  "settings": [
    {
      "type": "article",
      "id": "blog_post_override",
      "label": "【调试】指定文章",
      "info": "留空时自动显示当前文章"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "备用背景图",
      "info": "当文章无图片时使用"
    }
  ],
  "presets": [
    {
      "name": "固定作者底部模板",
      "category": "博客"
    }
  ]
}
{% endschema %}
