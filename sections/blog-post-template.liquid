{% comment %}
  ===================================================================
  博客文章模板 - 纯净透明 + 内容居中 + 条件显示
  功能：
    - 背景图 = 文章特色图片（自动获取）
    - 无类型时不显示“未分类”
    - 去掉“作者：”前缀
    - 日期不加粗
    - 文章内容居中
    - 所有背景颜色设为透明
    - 作者信息固定在底部 40px
  ===================================================================
{% endcomment %}

{%- assign blog_post = section.settings.blog_post_override | default: article -%}

{%- comment %} 获取文章特色图片作为背景，若无则使用备用图 {% endcomment %}
{%- if blog_post.image %}
  {%- assign background_image = blog_post.image | img_url: '2048x' | prepend: 'https:' -%}
{%- else %}
  {%- assign background_image = section.settings.fallback_image | img_url: '2048x' | prepend: 'https:' -%}
{%- endif %}

{%- comment %} 获取文章类型：仅当存在标签时显示第一个 {% endcomment %}
{%- if blog_post.tags.size > 0 %}
  {%- assign post_type = blog_post.tags.first -%}
{%- else %}
  {%- assign post_type = '' -%}
{%- endif %}

{%- assign author_name = blog_post.author -%}

<div class="blog-post-section" style="background-image: url('{{ background_image }}');">
  <div class="container">
    <!-- 上部：左右结构 -->
    <div class="blog-header">
      <div class="date">{{ blog_post.published_at | date: "%Y/%m/%d" }}</div>
      {%- if post_type != blank -%}
        <div class="type">{{ post_type }}</div>
      {%- endif -%}
    </div>

    <!-- 中部：标题和内容 -->
    <div class="blog-content">
      <h1 class="title">{{ blog_post.title }}</h1>
      <div class="body">
        {{ blog_post.content }}
      </div>
    </div>

    <!-- 下部：作者信息 - 固定在底部 40px -->
    <div class="blog-footer">
      <p class="author">{{ author_name }}</p>
    </div>
  </div>
</div>

<style>
  .blog-post-section {
    min-height: 100vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 40px 16px;
    color: white;
    font-family: "Helvetica Neue", Arial, sans-serif;
    position: relative;
  }

  .container {
    max-width: 960px;
    margin: 0 auto;
    min-height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* 上部：日期 + 类型 */
  .blog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    font-size: 14px;
    white-space: nowrap;
  }

  .blog-header .date {
    font-weight: normal; /* 不加粗 */
  }

  .blog-header .type {
    font-size: 13px;
    padding: 4px 8px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.3); /* 轻微高亮，可选；如需完全透明请删除此行 */
    margin-left: auto;
    flex-shrink: 0;
  }

  /* 中部：标题和内容 */
  .blog-content {
    flex: 1;
    text-align: center; /* 标题和内容都居中 */
  }

  .blog-content .title {
    font-size: 32px;
    margin-bottom: 20px;
    line-height: 1.3;
  }

  .blog-content .body {
    font-size: 16px;
    line-height: 1.8;
    text-align: center; /* 内容居中 */
    padding: 24px 16px;
    margin-top: 16px;
    /* 所有背景透明 */
    background: transparent;
  }

  /* 下部：作者信息 */
  .blog-footer {
    position: absolute;
    bottom: 40px;
    left: 0;
    right: 0;
    text-align: center;
  }

  .blog-footer .author {
    font-size: 18px;
    font-weight: 500;
    color: white;
    /* 完全透明背景 */
    background: transparent;
    padding: 0;
    margin: 0;
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    .blog-header {
      font-size: 13px;
    }
    .blog-header .date,
    .blog-header .type {
      font-size: 12px;
      padding: 3px 6px;
    }
    .blog-content .title {
      font-size: 26px;
    }
    .blog-content .body {
      font-size: 15px;
      padding: 20px 12px;
    }
    .blog-footer .author {
      font-size: 16px;
    }
  }

  @media (max-width: 480px) {
    .blog-header .date,
    .blog-header .type {
      font-size: 11px;
      padding: 2px 5px;
    }
    .blog-content .title {
      font-size: 24px;
    }
    .blog-content .body {
      font-size: 14px;
      line-height: 1.6;
      padding: 16px 10px;
    }
    .blog-footer .author {
      font-size: 15px;
    }
  }
</style>

{% schema %}
{
  "name": "博客模板",
  "tag": "section",
  "settings": [
    {
      "type": "article",
      "id": "blog_post_override",
      "label": "【调试】指定文章",
      "info": "留空时自动显示当前文章"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "备用背景图",
      "info": "当文章无图片时使用"
    }
  ],
  "presets": [
    {
      "name": "纯净透明博客模板",
      "category": "博客"
    }
  ]
}
{% endschema %}
