{% comment %}
  ===================================================================
  博客文章模板 - 移动端优化版
  功能更新：
    - 缩小顶部日期和类型字体
    - 移动端保持左右布局（不换列）
    - 去掉遮罩层，背景图纯净显示
    - 自动从文章获取：背景图、标签、作者
  ===================================================================
{% endcomment %}

{%- assign blog_post = section.settings.blog_post_override | default: article -%}

{%- comment %} 获取文章特色图片作为背景，若无则使用备用图 {% endcomment %}
{%- if blog_post.image %}
  {%- assign background_image = blog_post.image | img_url: '2048x' | prepend: 'https:' -%}
{%- else %}
  {%- assign background_image = section.settings.fallback_image | img_url: '2048x' | prepend: 'https:' -%}
{%- endif %}

{%- comment %} 获取文章类型：取第一个标签，否则显示“未分类” {% endcomment %}
{%- if blog_post.tags.size > 0 %}
  {%- assign post_type = blog_post.tags.first -%}
{%- else %}
  {%- assign post_type = '未分类' -%}
{%- endif %}

{%- assign author_name = blog_post.author -%}

<div class="blog-post-section" style="background-image: url('{{ background_image }}');">
  <div class="container">
    <!-- 上部：左右结构 -->
    <div class="blog-header">
      <div class="date">{{ blog_post.published_at | date: "%Y/%m/%d" }}</div>
      <div class="type">{{ post_type }}</div>
    </div>

    <!-- 中部：标题和内容 -->
    <div class="blog-content">
      <h1 class="title">{{ blog_post.title }}</h1>
      <div class="body">
        {{ blog_post.content }}
      </div>
    </div>

    <!-- 下部：作者信息 -->
    <div class="blog-footer">
      <p class="author">{{ author_name }}</p>
    </div>
  </div>
</div>

<style>
  .blog-post-section {
    min-height: 100vh;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 40px 16px; /* 减小边距，适配移动端 */
    color: white;
    font-family: "Helvetica Neue", Arial, sans-serif;
  }

  .container {
    max-width: 960px;
    margin: 0 auto;
  }

  /* 上部：日期 + 类型，保持左右布局 */
  .blog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
    font-size: 14px; /* 缩小默认字体 */
    white-space: nowrap; /* 防止换行 */
  }

  .blog-header .date {
    font-weight: normal;
    flex-shrink: 0; /* 防止被压缩 */
  }

  .blog-header .type {
    background: rgba(255, 255, 255, 0);
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 13px; /* 更小字体 */
    margin-left: auto; /* 类型靠右对齐 */
    flex-shrink: 0; /* 防止被挤压 */
  }

  /* 中部：标题和内容 */
  .blog-content .title {
    font-size: 32px;
    margin-bottom: 20px;
    text-align: center;
    line-height: 1.3;
  }

  .blog-content .body {
    font-size: 16px;
    line-height: 1.8;
    background: rgba(0, 0, 0, 0);
    padding: 24px;
    border-radius: 10px;
    text-align:center;
  }

  /* 下部：作者 */
  .blog-footer {
    margin-top: 40px;
    text-align: center;
  }

  .blog-footer .author {
    font-size: 18px;
    font-weight: 500;
  }

  /* 移动端适配：保持左右布局，不换行 */
  @media (max-width: 768px) {
    .blog-header {
      font-size: 13px; /* 更小 */
      padding: 0 4px;
    }
    .blog-header .date {
      font-size: 12px;
      padding-right: 8px;
    }
    .blog-header .type {
      font-size: 12px;
      padding: 3px 6px;
    }
    .blog-content .title {
      font-size: 26px;
    }
    .blog-content .body {
      font-size: 15px;
      padding: 20px;
    }
    .blog-footer .author {
      font-size: 16px;
    }
  }

  /* 超小屏适配（如 iPhone SE）*/
  @media (max-width: 480px) {
    .blog-header {
      gap: 8px;
    }
    .blog-header .date,
    .blog-header .type {
      font-size: 11px;
      padding: 2px 5px;
    }
    .blog-content .title {
      font-size: 24px;
    }
    .blog-content .body {
      font-size: 14px;
      line-height: 1.6;
      padding: 16px;
    }
    .blog-footer .author {
      font-size: 15px;
    }
  }
</style>

{% schema %}
{
  "name": "博客模板 - 移动端优化（无遮罩）",
  "tag": "section",
  "settings": [
    {
      "type": "article",
      "id": "blog_post_override",
      "label": "【调试】指定文章",
      "info": "留空时自动显示当前文章"
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "备用背景图",
      "info": "当文章无图片时使用"
    }
  ],
  "presets": [
    {
      "name": "移动端优化博客模板",
      "category": "博客"
    }
  ]
}
{% endschema %}
