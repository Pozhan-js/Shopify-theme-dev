<div class="proof-of-quality-section">
  <div class="proof-of-quality-container">

    <div class="proof-of-quality-header">
      <h2 class="proof-of-quality-title">
        {{ section.settings.title }}
      </h2>
      <p class="proof-of-quality-subtitle">
        {{ section.settings.subtitle }}
      </p>
    </div>

    <!-- 轮播容器 -->
    <div class="quality-carousel">
      <div class="quality-track">

        {% for block in section.blocks %}
          <div class="quality-item" {{ block.shopify_attributes }}>
            <div class="quality-card">

              <div class="certificate-display">
                {% if block.settings.image != blank %}
                  <img
                    src="{{ block.settings.image | img_url: '400x' }}"
                    class="certificate-image"
                    alt="{{ block.settings.title }}"
                  >
                {% endif %}
              </div>

              <div class="quality-info">
                <h3 class="quality-cert-title">
                  {{ block.settings.title }}
                </h3>
                <p class="quality-description">
                  {{ block.settings.text }}
                </p>
              </div>

            </div>
          </div>
        {% endfor %}

      </div>
    </div>

  </div>
</div>

<style>
.proof-of-quality-section{
  padding:80px 0;
  background:#fff;
}

/* ====== 轮播 ====== */

.quality-carousel{
  overflow:hidden;
  position:relative;
}

.quality-track{
  display:flex;
  gap:30px;
  width:max-content;
  animation: scroll 30s linear infinite;
}

.quality-item{
  flex:0 0 auto;
}

/* 卡片样式 */

.quality-card{
  width:320px;
  background:#fff;
  border-radius:16px;
  box-shadow:0 4px 20px rgba(0,0,0,.1);
  padding:30px;
}

.certificate-image{
  width:100%;
  height:320px;
  object-fit:contain;
}

.quality-cert-title{
  font-size:22px;
  margin-top:20px;
  color:#c22e35;
}

.quality-description{
  font-size:14px;
  opacity:.7;
}

/* ===== 无限滚动动画 ===== */

@keyframes scroll{
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}

/* ===== 移动端适配 ===== */

@media(max-width:768px){

  .quality-track{
    animation: none;
    overflow-x:auto;
    scroll-snap-type:x mandatory;
    -webkit-overflow-scrolling:touch;
  }

  .quality-item{
    scroll-snap-align:center;
  }

  .quality-card{
    width:260px;
  }
}
</style>

<script>
/* ===== 无限复制实现真正无缝轮播 ===== */

document.addEventListener("DOMContentLoaded", function(){

  const track = document.querySelector(".quality-track");

  if(!track) return;

  // 复制一份内容实现无缝循环
  track.innerHTML += track.innerHTML;

});
</script>

{% schema %}
{
  "name": "Proof of Quality Carousel",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Proof of Quality"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Every XS Pilates product is manufactured under internationally recognized standards."
    }
  ],

  "blocks": [
    {
      "type": "certificate",
      "name": "Certificate Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Certificate Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Certificate Title",
          "default": "ISO 9001"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Quality management certification."
        }
      ]
    }
  ],

  "presets": [
    {
      "name": "Proof of Quality Carousel",
      "blocks": [
        { "type": "certificate" },
        { "type": "certificate" },
        { "type": "certificate" },
        { "type": "certificate" }
      ]
    }
  ]
}
{% endschema %}