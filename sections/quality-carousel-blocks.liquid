<div class="proof-of-quality-xsp">
    <div class="proof-of-quality-container-xsp">

        <div class="proof-of-quality-header-xsp">
        <h2 class="proof-of-quality-title-xsp">
            {{ section.settings.title }}
        </h2>
        <p class="proof-of-quality-subtitle-xsp">
            {{ section.settings.subtitle }}
        </p>
        </div>

        <!-- 轮播 -->
        <div class="quality-carousel-xsp">
        <div class="quality-track-xsp">

            {% for block in section.blocks %}
            <div class="quality-item-xsp" {{ block.shopify_attributes }}>
                <div class="quality-card-xsp">

                <div class="certificate-display-xsp">
                    {% if block.settings.image != blank %}
                    <img
                        src="{{ block.settings.image | img_url: '400x' }}"
                        class="certificate-image-xsp"
                        alt="{{ block.settings.title }}"
                    >
                    {% endif %}
                </div>
                {% if block.settings.title != blank or  block.settings.text != blank %}
                    <div class="quality-info-xsp">
                        {% if block.settings.title != blank %}
                            <h3 class="quality-cert-title-xsp">
                            {{ block.settings.title }}
                            </h3>
                        {% endif %}
                        {% if block.settings.text != blank %}
                            <p class="quality-description-xsp">
                            {{ block.settings.text }}
                            </p>
                        {% endif %}
                    </div>
                {% endif %}
                </div>
            </div>
            {% endfor %}

        </div>
        </div>

    </div>
</div>

    <style>
    .proof-of-quality-xsp {
    background: #ffffff;
    color: #000000;
    position: relative;
    height: 1004px; /* 604px白色 + 400px红色 */
    }
    .proof-of-quality-xsp::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 400px;
    background: #c22e35;
    z-index: 1;
  }
    @media (min-width: 1920px) {
        .proof-of-quality-xsp {
        margin-top: 40px;
        height: 804px; /* 604px白色 + 400px红色 */
        }

        .proof-of-quality-xsp::after {
        height: 400px;
        }
    }

    /* ===== 轮播 ===== */

    .quality-carousel-xsp{
    overflow:hidden;
    }

    .quality-track-xsp{
    display:flex;
    gap:30px;
    width:max-content;
    animation: scroll-xsp 30s linear infinite;
    }

    .quality-item-xsp{
    flex:0 0 auto;
    }

    /* 卡片 */

    .quality-card-xsp{
    width:320px;
    background:#fff;
    border-radius:16px;
    box-shadow:0 4px 20px rgba(0,0,0,.1);
    padding:30px;
    }

    .certificate-image-xsp{
    width:100%;
    height:320px;
    object-fit:contain;
    }

    .quality-cert-title-xsp{
    font-size:22px;
    margin-top:20px;
    color:#c22e35;
    }

    .quality-description-xsp{
    font-size:14px;
    opacity:.7;
    }

    /* 无限滚动动画 */

    @keyframes scroll-xsp{
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
    }

    /* ===== 手机适配 ===== */

    @media(max-width:768px){

    .quality-track-xsp{
        animation:none;
        overflow-x:auto;
        scroll-snap-type:x mandatory;
        -webkit-overflow-scrolling:touch;
    }

    .quality-item-xsp{
        scroll-snap-align:center;
    }

    .quality-card-xsp{
        width:260px;
    }
    }
    </style>

    <script>
    document.addEventListener("DOMContentLoaded", function(){

    const track = document.querySelector(".quality-track-xsp");
    if(!track) return;

    track.innerHTML += track.innerHTML;

    });
    </script>

    {% schema %}
    {
    "name": "Proof of Quality Carousel",
    "settings": [
        {
        "type": "text",
        "id": "title",
        "label": "Title",
        "default": "Proof of Quality"
        },
        {
        "type": "textarea",
        "id": "subtitle",
        "label": "Subtitle",
        "default": "Every XS Pilates product is manufactured under internationally recognized standards."
        }
    ],

    "blocks": [
        {
        "type": "certificate",
        "name": "Certificate Card",
        "settings": [
            {
            "type": "image_picker",
            "id": "image",
            "label": "Certificate Image"
            },
            {
            "type": "text",
            "id": "title",
            "label": "Certificate Title",
            "default": "ISO 9001"
            },
            {
            "type": "textarea",
            "id": "text",
            "label": "Description",
            "default": "Quality management certification."
            }
        ]
        }
    ],

    "presets": [
        {
        "name": "Proof of Quality Carousel",
        "blocks": [
            { "type": "certificate" },
            { "type": "certificate" },
            { "type": "certificate" },
            { "type": "certificate" }
        ]
        }
    ]
    }
    {% endschema %}