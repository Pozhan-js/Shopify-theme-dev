    {
      "type": "text",
      "id": "button_text",
      "label": "按钮文本",
      "default": "Follow Us"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram链接",
      "info": "输入Instagram主页链接"
    }
  ],
  "blocks": [
    {
      "type": "image_item",
      "name": "图片项",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram图片展示",
      "settings": {
        "text_content": "关注我们的Instagram，获取最新产品动态和时尚灵感",
        "button_text": "Follow Us"
      },
      "blocks": [
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        },
        {
          "type": "image_item"
        }
      ]
    }
  ]
}
{% endschema %}
