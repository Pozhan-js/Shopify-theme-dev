{% comment %}
  Instagram图片展示 - 网格布局
  1. 头部左右布局：左边文本区域，右边Instagram按钮
  2. 网格展示：奇数排左大图+右小图，偶数排右大图+左小图
{% endcomment %}

<div class="instagram-grid-section" data-section-id="{{ section.id }}">
  <div class="container">
    <!-- 左右布局的头部区域 -->
    <div class="header-layout">
      <!-- 左侧文本区域 -->
      <div class="text-content">
        {% if section.settings.text_content != blank %}
          <p class="header-text">{{ section.settings.text_content }}</p>
        {% endif %}
      </div>
      
      <!-- 右侧Instagram按钮 -->
      {% if section.settings.instagram_link != blank %}
        <div class="button-content">
          <a href="{{ section.settings.instagram_link }}" class="instagram-button" target="_blank" rel="noopener">
            <svg class="instagram-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.265-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            {{ section.settings.button_text | default: 'Follow Us' }}
          </a>
        </div>
      {% endif %}
    </div>

    <!-- 图片网格部分 -->
    <div class="grid-wrapper">
      {% assign images = section.blocks | where: 'type', 'image_item' %}
      {% assign rows = images.size | divided_by: 7.0 | ceil %}
      
      {% for i in (1..rows) %}
        {% assign row_start = forloop.index0 | times: 7 %}
        {% assign row_images = images | offset: row_start | limit: 7 %}
        {% assign row_index = forloop.index0 %}
        {% assign is_odd_row = row_index | modulo: 2 %}
        
        {% if row_images.size > 0 %}
          <div class="image-row {% if is_odd_row == 0 %}left-large{% else %}right-large{% endif %}">
            {% if is_odd_row == 0 %}
              <!-- 奇数排：左大图 + 右小图 -->
              <div class="large-image-container left">
                {% if row_images[0].settings.image %}
                  <img
                    src="{{ row_images[0].settings.image | img_url: '600x600' }}"
                    alt="{{ row_images[0].settings.image.alt | escape }}"
                    class="large-image"
                    loading="lazy"
                  >
                {% else %}
                  <div class="placeholder-image large">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {% endif %}
              </div>
              
              <div class="small-images-grid">
                {% for j in (1..6) %}
                  {% assign image_index = j %}
                  {% if row_images[image_index] %}
                    <div class="small-image-container">
                      {% if row_images[image_index].settings.image %}
                        <img
                          src="{{ row_images[image_index].settings.image | img_url: '300x300' }}"
                          alt="{{ row_images[image_index].settings.image.alt | escape }}"
                          class="small-image"
                          loading="lazy"
                        >
                      {% else %}
                        <div class="placeholder-image small">
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            {% else %}
              <!-- 偶数排：左小图 + 右大图 -->
              <div class="small-images-grid">
                {% for j in (0..5) %}
                  {% assign image_index = j %}
                  {% if row_images[image_index] %}
                    <div class="small-image-container">
                      {% if row_images[image_index].settings.image %}
                        <img
                          src="{{ row_images[image_index].settings.image | img_url: '300x300' }}"
                          alt="{{ row_images[image_index].settings.image.alt | escape }}"
                          class="small-image"
                          loading="lazy"
                        >
                      {% else %}
                        <div class="placeholder-image small">
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {% endif %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
              
              <div class="large-image-container right">
                {% if row_images[6].settings.image %}
                  <img
                    src="{{ row_images[6].settings.image | img_url: '600x600' }}"
                    alt="{{ row_images[6].settings.image.alt | escape }}"
                    class="large-image"
                    loading="lazy"
                  >
                {% else %}
                  <div class="placeholder-image large">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
/* Variables CSS */
:root {
  --cream: #F5F1EB;
  --warm-beige: #E8DDD4;
  --soft-brown: #C4A484;
  --pearl-white: #FFF8F0;
  --gray-50: #F9FAFB;
  --gray-100: #F3F4F6;
  --gray-200: #E5E7EB;
  --gray-400: #9CA3AF;
  --gray-500: #6B7280;
  --gray-600: #4B5563;
  --gray-700: #374151;
  --gray-900: #111827;
  --white: #FFFFFF;
  --amber-400: #FBBF24;
  --orange-400: #FB923C;
}

/* Section principale */
.instagram-grid-section {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: transparent;
  padding: 2rem 0;
}

/* Container principal */
.container {
  max-width: 100rem;
  margin: 0 auto;
  padding: 0 2rem;
}

/* 头部左右布局 */
.header-layout {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 3rem;
  gap: 2rem;
}

/* 左侧文本区域 */
.text-content {
  flex: 1;
  text-align: left;
}

.header-text {
  font-size: 1.125rem;
  color: var(--color-foreground);
  margin: 0;
  line-height: 1.5;
  font-weight: 400;
}

/* 右侧按钮区域 */
.button-content {
  flex-shrink: 0;
}

.instagram-button {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1.5rem;
  background-color: transparent;
  border: 1px solid #000;
  border-radius: 0.5rem;
  color: var(--gray-700);
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.3s ease;
  cursor: pointer;
}

.instagram-button:hover {
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.instagram-button:active {
  transform: translateY(0);
}

.instagram-icon {
  width: 1.125rem;
  height: 1.125rem;
  color: var(--gray-600);
  transition: color 0.3s ease;
}

.instagram-button:hover .instagram-icon {
  color: var(--gray-800);
}

/* Grid wrapper */
.grid-wrapper {
  max-width: 80rem;
  margin: 0 auto;
}

/* Image rows */
.image-row {
  display: flex;
  gap: 2rem;
  margin-bottom: 3rem;
  align-items: center;
}

.image-row:last-child {
  margin-bottom: 0;
}

/* Large image container */
.large-image-container {
  flex-shrink: 0;
  width: 24rem;
  height: 24rem;
  border-radius: 12px;
  overflow: hidden;
  transition: transform 0.3s ease;
}

.large-image-container:hover {
  transform: scale(1.02);
}

.large-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Small images grid */
.small-images-grid {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 1rem;
  height: 24rem;
}

.small-image-container {
  border-radius: 8px;
  overflow: hidden;
  transition: transform 0.3s ease;
}

.small-image-container:hover {
  transform: scale(1.05);
}

.small-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Placeholder images */
.placeholder-image {
  width: 100%;
  height: 100%;
  background-color: var(--gray-200);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gray-400);
}

.placeholder-image.large {
  font-size: 1.5rem;
}

.placeholder-image.small {
  font-size: 0.875rem;
}

.placeholder-svg {
  width: 3rem;
  height: 3rem;
  opacity: 0.5;
}

/* Responsive */
@media (max-width: 1024px) {
  .container {
    padding: 0 1rem;
  }
  
  .large-image-container {
    width: 20rem;
    height: 20rem;
  }
  
  .small-images-grid {
    height: 20rem;
  }
  
  .image-row {
    gap: 1.5rem;
  }
}

@media (max-width: 768px) {
  .header-layout {
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  
  .text-content {
    text-align: center;
  }
  
  .button-content {
    display: flex;
    justify-content: center;
  }
  
  .header-text {
    font-size: 1rem;
  }
  
  .image-row {
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .large-image-container {
    width: 100%;
    height: 20rem;
    max-width: 24rem;
    margin: 0 auto;
  }
  
  .small-images-grid {
    height: auto;
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(3, 1fr);
    gap: 0.75rem;
  }
  
  .small-image-container {
    height: 8rem;
  }
}

@media (max-width: 480px) {
  .container {
    padding: 0 0.5rem;
  }
  
  .header-layout {
    margin-bottom: 1.5rem;
  }
  
  .header-text {
    font-size: 0.875rem;
  }
  
  .instagram-button {
    padding: 0.625rem 1.25rem;
    font-size: 0.8rem;
  }
  
  .instagram-icon {
    width: 1rem;
    height: 1rem;
  }
  
  .large-image-container {
    height: 16rem;
  }
  
  .small-images-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }
  
  .small-image-container {
    height: 6rem;
  }
  
  .image-row {
    margin-bottom: 1.5rem;
  }
}
</style>

