{% comment %}
  Instagram图片展示 - 网格布局
  1. 头部左右布局：左边文本区域，右边Instagram按钮
  2. 交替网格布局：奇数行左大右小，偶数行右大左小
  3. 每行7张图片：1张大图 + 6张小图（3x2网格）
{% endcomment %}

<div class="instagram-grid-section" data-section-id="{{ section.id }}">
  <div class="container">
    <!-- 左右布局的头部区域 -->
    <div class="header-layout">
      <!-- 左侧文本区域 -->
      <div class="text-content">
        {% if section.settings.text_content != blank %}
          <p class="header-text">{{ section.settings.text_content }}</p>
        {% endif %}
      </div>
      
      <!-- 右侧Instagram按钮 -->
      {% if section.settings.instagram_link != blank %}
        <div class="button-content">
          <a href="{{ section.settings.instagram_link }}" class="instagram-button" target="_blank" rel="noopener">
            <svg class="instagram-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.265-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
            {{ section.settings.button_text | default: 'Follow Us' }}
          </a>
        </div>
      {% endif %}
    </div>

    <!-- 图片网格布局 -->
    <div class="grid-wrapper">
      {% assign row_count = 0 %}
      {% assign image_index = 0 %}
      
      {% for i in (0..100) %}
        {% assign start_index = i | times: 7 %}
        {% assign end_index = start_index | plus: 6 %}
        
        {% comment %}检查是否还有图片{% endcomment %}
        {% assign has_images = false %}
        {% for block in section.blocks limit: 7 offset: start_index %}
          {% if block.type == 'image_item' %}
            {% assign has_images = true %}
            {% break %}
          {% endif %}
        {% endfor %}
        
        {% if has_images == false %}
          {% break %}
        {% endif %}
        
        {% assign is_odd_row = i | modulo: 2 %}
        
        <div class="grid-row {% if is_odd_row == 0 %}layout-left{% else %}layout-right{% endif %}">
          {% if is_odd_row == 0 %}
            <!-- 奇数行：左大右小 -->
            <div class="large-image-container">
              {% assign block = section.blocks[start_index] %}
              {% if block and block.type == 'image_item' %}
                {% if block.settings.image %}
                  <img
                    src="{{ block.settings.image | img_url: '800x800' }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    class="grid-image"
                    loading="lazy"
                  >
                {% else %}
                  <div class="placeholder-image">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {% endif %}
              {% endif %}
            </div>
            
            <div class="small-images-grid">
              {% for j in (1..6) %}
                {% assign block_index = start_index | plus: j %}
                {% assign block = section.blocks[block_index] %}
                <div class="small-image-container">
                  {% if block and block.type == 'image_item' %}
                    {% if block.settings.image %}
                      <img
                        src="{{ block.settings.image | img_url: '400x400' }}"
                        alt="{{ block.settings.image.alt | escape }}"
                        class="grid-image"
                        loading="lazy"
                      >
                    {% else %}
                      <div class="placeholder-image">
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {% endif %}
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          {% else %}
            <!-- 偶数行：右大左小 -->
            <div class="small-images-grid">
              {% for j in (0..5) %}
                {% assign block_index = start_index | plus: j %}
                {% assign block = section.blocks[block_index] %}
                <div class="small-image-container">
                  {% if block and block.type == 'image_item' %}
                    {% if block.settings.image %}
                      <img
                        src="{{ block.settings.image | img_url: '400x400' }}"
                        alt="{{ block.settings.image.alt | escape }}"
                        class="grid-image"
                        loading="lazy"
                      >
                    {% else %}
                      <div class="placeholder-image">
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {% endif %}
                  {% endif %}
                </div>
              {% endfor %}
            </div>
            
            <div class="large-image-container">
              {% assign block_index = start_index | plus: 6 %}
              {% assign block = section.blocks[block_index] %}
              {% if block and block.type == 'image_item' %}
                {% if block.settings.image %}
                  <img
                    src="{{ block.settings.image | img_url: '800x800' }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    class="grid-image"
                    loading="lazy"
                  >
                {% else %}
                  <div class="placeholder-image">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {% endif %}
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
/* Variables CSS */
:root {
  --gray-200: #E5E7EB;
  --gray-400: #9CA3AF;
  --gray-600: #4B5563;
  --gray-700: #374151;
  --white: #FFFFFF;
}

/* Section principale */
.instagram-grid-section {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: transparent;
  padding: 2rem 0;
}

/* Container principal */
.container {
  max-width: 100rem;
  margin: 0 auto;
  padding: 0 1rem;
}

/* 头部左右布局 */
.header-layout {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 2rem;
  gap: 2rem;
}

/* 左侧文本区域 */
.text-content {
  flex: 1;
  text-align: left;
}

.header-text {
  font-size: 1.125rem;
  color: var(--color-foreground);
  margin: 0;
  line-height: 1.5;
  font-weight: 400;
}

/* 右侧按钮区域 */
.button-content {
  flex-shrink: 0;
}

.instagram-button {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1.5rem;
  background-color: transparent;
  border: 1px solid #000;
  border-radius: 0.5rem;
  color: var(--gray-700);
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.3s ease;
  cursor: pointer;
}

.instagram-button:hover {
  transform: translateY(-1px);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
}

.instagram-icon {
  width: 1.125rem;
  height: 1.125rem;
  color: var(--gray-600);
}

/* 网格布局 */
.grid-wrapper {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.grid-row {
  display: flex;
  gap: 1rem;
  width: 100%;
}

/* 大图容器 - 占40% */
.large-image-container {
  flex: 0 0 40%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 8px;
  background-color: var(--gray-200);
}

/* 小图网格容器 - 占60% */
.small-images-grid {
  flex: 0 0 60%;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 1rem;
}

.small-image-container {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 8px;
  background-color: var(--gray-200);
}

/* 图片样式 */
.grid-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.placeholder-image {
  width: 100%;
  height: 100%;
  background-color: var(--gray-200);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--gray-400);
}

.placeholder-svg {
  width: 50%;
  height: 50%;
  opacity: 0.5;
}

/* Responsive - 平板 */
@media (max-width: 1024px) {
  .large-image-container {
    flex: 0 0 45%;
  }
  
  .small-images-grid {
    flex: 0 0 55%;
  }
}

/* Responsive - 手机 */
@media (max-width: 768px) {
  .header-layout {
    flex-direction: column;
    align-items: stretch;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  
  .text-content {
    text-align: center;
  }
  
  .button-content {
    display: flex;
    justify-content: center;
  }
  
  .header-text {
    font-size: 1rem;
  }
  
  .grid-row {
    flex-direction: column;
  }
  
  .grid-row.layout-right {
    flex-direction: column-reverse;
  }
  
  .large-image-container,
  .small-images-grid {
    flex: 1 1 auto;
    width: 100%;
  }
  
  .small-images-grid {
    grid-template-columns: repeat(2, 1fr);
    grid-template-rows: repeat(3, 1fr);
  }
}

@media (max-width: 480px) {
  .header-text {
    font-size: 0.875rem;
  }
  
  .instagram-button {
    padding: 0.625rem 1.25rem;
    font-size: 0.8rem;
  }
  
  .grid-wrapper {
    gap: 0.75rem;
  }
  
  .grid-row {
    gap: 0.75rem;
  }
  
  .small-images-grid {
    gap: 0.75rem;
  }
}
</style>

{% schema %}
{
  "name": "Instagram图片展示",
  "tag": "section",
  "class": "instagram-grid-section",
  "settings": [
    {
      "type": "textarea",
      "id": "text_content",
      "label": "文本内容",
      "default": "关注我们的Instagram，获取最新产品动态和时尚灵感"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "按钮文本",
      "default": "Follow Us"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "Instagram链接",
      "info": "输入Instagram主页链接"
    }
  ],
  "blocks": [
    {
      "type": "image_item",
      "name": "图片项",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        }
      ]
    }
  ],
  "max_blocks": 100,
  "presets": [
    {
      "name": "Instagram图片展示",
      "settings": {
        "text_content": "关注我们的Instagram，获取最新产品动态和时尚灵感",
        "button_text": "Follow Us"
      },
      "blocks": [
        {"type": "image_item"},
        {"type": "image_item"},
        {"type": "image_item"},
        {"type": "image_item"},
        {"type": "image_item"},
        {"type": "image_item"},
        {"type": "image_item"},
        {"type": "image_item"},
        {"type": "image_item"},
        {"type": "image_item"},
        {"type": "image_item"},
        {"type": "image_item"},
        {"type": "image_item"},
        {"type": "image_item"}
      ]
    }
  ]
}
{% endschema %}
