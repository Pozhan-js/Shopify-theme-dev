<div class="breadcrumb-navigation-section" {{ section.shopify_attributes }}>
  <div class="breadcrumb-container">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <!-- Home Icon -->
        <li class="breadcrumb-item breadcrumb-home">
          <a href="{{ routes.root_url }}" class="breadcrumb-link" aria-label="Home">
            {% if section.settings.home_icon %}
              <img
                src="{{ section.settings.home_icon | img_url: '16x16' }}"
                alt="Home"
                class="breadcrumb-home-icon breadcrumb-home-icon-image"
              >
            {% else %}
              <svg
                class="breadcrumb-home-icon"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M3 9L12 2L21 9V20C21 20.5304 20.7893 21.0391 20.4142 21.4142C20.0391 21.7893 19.5304 22 19 22H5C4.46957 22 3.96086 21.7893 3.58579 21.4142C3.21071 21.0391 3 20.5304 3 20V9Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M9 22V12H15V22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {% endif %}
          </a>
          <span class="breadcrumb-separator">
            {% if section.settings.separator_icon %}
              <img
                src="{{ section.settings.separator_icon | img_url: '12x12' }}"
                alt=">"
                class="breadcrumb-separator-icon"
              >
            {% else %}
              <svg
                class="breadcrumb-separator-icon"
                width="8"
                height="12"
                viewBox="0 0 8 12"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path d="M1.5 1L6.5 6L1.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {% endif %}
          </span>
        </li>

        <!-- Dynamic Breadcrumb Items -->
        {% comment %} 从URL中获取产品系列名 {% endcomment %}
        {% assign current_product = product %}
        {% assign selected_product = all_products[section.settings.product_handle] %}
        {% assign display_product = current_product | default: selected_product %}

        {% comment %} 从URL中获取集合信息 {% endcomment %}
        {% assign current_collection = collection %}
        {% assign url_parts = request.path | split: '/' %}
        {% assign collection_handle_from_url = '' %}

        {% for part in url_parts %}
          {% if part == 'collections' and forloop.index < url_parts.size %}
            {% assign collection_handle_from_url = url_parts[forloop.index] %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% if collection_handle_from_url != blank %}
          {% assign collection_from_url = collections[collection_handle_from_url] %}
        {% endif %}

        {% if display_product %}
          <!-- 产品集合面包屑 - 固定展示Pilates Equipment (不可点击) -->
          <li class="breadcrumb-item">
            <span class="breadcrumb-text">Pilates Equipment</span>
            <span class="breadcrumb-separator">
              {% if section.settings.separator_icon %}
                <img
                  src="{{ section.settings.separator_icon | img_url: '12x12' }}"
                  alt=">"
                  class="breadcrumb-separator-icon"
                >
              {% else %}
                <svg
                  class="breadcrumb-separator-icon"
                  width="8"
                  height="12"
                  viewBox="0 0 8 12"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path d="M1.5 1L6.5 6L1.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              {% endif %}
            </span>
          </li>

          {% comment %} 统一处理集合别名显示 {% endcomment %}
          {% assign target_collection = null %}

          {% comment %} 优先使用URL中的集合 {% endcomment %}
          {% if collection_handle_from_url != blank %}
            {% assign target_collection = collections[collection_handle_from_url] %}
          {% elsif display_product.collections.size > 0 %}
            {% comment %} 回退到产品的第一个集合 {% endcomment %}
            {% assign target_collection = display_product.collections.first %}
          {% endif %}

          {% if target_collection %}
            {% assign display_collection_name = target_collection.title %}

            {% comment %} 检查是否有配置的别名 {% endcomment %}
            {% for block in section.blocks %}
              {% if block.type == 'collection_alias' and block.settings.original_name == target_collection.title %}
                {% assign display_collection_name = block.settings.display_name %}
                {% break %}
              {% endif %}
            {% endfor %}

            <li class="breadcrumb-item">
              <a href="{{ target_collection.url }}" class="breadcrumb-link">
                {{ display_collection_name }}
              </a>
              <span class="breadcrumb-separator">
                {% if section.settings.separator_icon %}
                  <img
                    src="{{ section.settings.separator_icon | img_url: '12x12' }}"
                    alt=">"
                    class="breadcrumb-separator-icon"
                  >
                {% else %}
                  <svg
                    class="breadcrumb-separator-icon"
                    width="8"
                    height="12"
                    viewBox="0 0 8 12"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path d="M1.5 1L6.5 6L1.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% endif %}
              </span>
            </li>
          {% else %}
            <!-- 如果产品没有集合，使用默认面包屑 -->
            {% for block in section.blocks %}
              {% if block.type == 'breadcrumb_item' %}
                <li class="breadcrumb-item" {{ block.shopify_attributes }}>
                  {% if block.settings.item_url %}
                    <a href="{{ block.settings.item_url }}" class="breadcrumb-link">
                      {{ block.settings.item_text }}
                    </a>
                  {% else %}
                    <span class="breadcrumb-text">{{ block.settings.item_text }}</span>
                  {% endif %}
                  {% unless forloop.last %}
                    <span class="breadcrumb-separator">
                      {% if section.settings.separator_icon %}
                        <img
                          src="{{ section.settings.separator_icon | img_url: '12x12' }}"
                          alt=">"
                          class="breadcrumb-separator-icon"
                        >
                      {% else %}
                        <svg
                          class="breadcrumb-separator-icon"
                          width="8"
                          height="12"
                          viewBox="0 0 8 12"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path d="M1.5 1L6.5 6L1.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      {% endif %}
                    </span>
                  {% endunless %}
                </li>
              {% endif %}
            {% endfor %}
          {% endif %}

          <!-- 当前产品 (最后一项，不可点击) -->
          <li class="breadcrumb-item breadcrumb-current" aria-current="page">
            <span class="breadcrumb-text breadcrumb-current-text">
              {{ display_product.title }}
            </span>
          </li>
        {% else %}
          <!-- 如果没有产品，使用区块配置的面包屑 -->
          {% for block in section.blocks %}
            {% if block.type == 'breadcrumb_item' %}
              <li class="breadcrumb-item" {{ block.shopify_attributes }}>
                {% if block.settings.item_url %}
                  <a href="{{ block.settings.item_url }}" class="breadcrumb-link">
                    {{ block.settings.item_text }}
                  </a>
                {% else %}
                  <span class="breadcrumb-text">{{ block.settings.item_text }}</span>
                {% endif %}
                {% unless forloop.last %}
                  <span class="breadcrumb-separator">
                    {% if section.settings.separator_icon %}
                      <img
                        src="{{ section.settings.separator_icon | img_url: '12x12' }}"
                        alt=">"
                        class="breadcrumb-separator-icon"
                      >
                    {% else %}
                      <svg
                        class="breadcrumb-separator-icon"
                        width="8"
                        height="12"
                        viewBox="0 0 8 12"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path d="M1.5 1L6.5 6L1.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% endif %}
                  </span>
                {% endunless %}
              </li>
            {% endif %}
          {% endfor %}
        {% endif %}
      </ol>
    </nav>
  </div>
</div>

<style>
  .breadcrumb-navigation-section {
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px 0;
    background-color: {{ section.settings.section_background_color }};
    margin-top: 66px;
  }

  .breadcrumb-container {
    max-width: 1520px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .breadcrumb-nav {
    width: 100%;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: {{ section.settings.item_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    gap: {{ section.settings.separator_spacing }}px;
    font-size: 12px;
    line-height: 1.4;
  }

  .breadcrumb-link {
    color: rgba(22, 22, 22, 0.5);
    text-decoration: none;
    transition: color 0.3s ease;
    display: flex;
    align-items: center;
    font-weight: {{ section.settings.link_font_weight }};
  }

  .breadcrumb-link:hover {
    color: {{ section.settings.link_hover_color }};
  }

  .breadcrumb-text {
    color: rgba(22, 22, 22, 0.5);
    font-weight: {{ section.settings.text_font_weight }};
  }

  .breadcrumb-current-text {
    color: #161616;
    font-weight: {{ section.settings.current_font_weight }};
  }

  .breadcrumb-home-icon {
    width: 16px;
    height: 16px;
    display: block;
    color: {{ section.settings.home_icon_color }};
  }

  .breadcrumb-home-icon-image {
    object-fit: contain;
    object-position: center;
  }

  .breadcrumb-separator {
    display: flex;
    align-items: center;
    color: {{ section.settings.separator_color }};
  }

  .breadcrumb-separator-icon {
    width: 8px;
    height: 12px;
    display: block;
    color: {{ section.settings.separator_color }};
  }

  /* 响应式设计 - 基于1920px设计图按比例缩放 */

  /* 大屏幕 (1920px+) - 使用设计图精确尺寸 */
  @media (min-width: 1920px) {
    .breadcrumb-container {
      max-width: 1520px;
    }

    .breadcrumb-list {
      gap: {{ section.settings.item_spacing }}px;
    }

    .breadcrumb-item {
      gap: {{ section.settings.separator_spacing }}px;
      font-size: 14px;
    }

    .breadcrumb-home-icon {
      width: 16px;
      height: 16px;
    }

    .breadcrumb-separator-icon {
      width: 8px;
      height: 12px;
    }
  }

  /* 其余尺寸自适应 - 基于视口宽度动态计算 */
  @media (max-width: 1919px) {
    .breadcrumb-container {
      max-width: calc(1520px * (100vw / 1920px));
      min-max-width: 320px;
    }

    .breadcrumb-list {
      gap: calc({{ section.settings.item_spacing }}px * (100vw / 1920px));
      min-gap: 4px;
    }

    .breadcrumb-item {
      gap: calc({{ section.settings.separator_spacing }}px * (100vw / 1920px));
      font-size: calc(18px * (100vw / 1920px));
      min-gap: 4px;
      min-font-size: 10px;
    }

    .breadcrumb-home-icon {
      width: calc(16px * (100vw / 1920px));
      height: calc(16px * (100vw / 1920px));
      min-width: 12px;
      min-height: 12px;
    }

    .breadcrumb-home-icon-image {
      object-fit: contain;
      object-position: center;
    }

    .breadcrumb-separator-icon {
      width: calc(8px * (100vw / 1920px));
      height: calc(12px * (100vw / 1920px));
      min-width: 6px;
      min-height: 8px;
    }
  }

  /* 平板和手机端 - 单行布局 */
  @media (max-width: 768px) {
    .breadcrumb-container {
      padding: 0 15px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .breadcrumb-list {
      gap: calc({{ section.settings.item_spacing }}px * 0.5);
      min-gap: 4px;
      flex-wrap: nowrap;
      min-width: max-content;
      padding-bottom: 6px;
    }

    .breadcrumb-item {
      gap: calc({{ section.settings.separator_spacing }}px * 0.5);
      font-size: calc(12px * 0.75);
      min-gap: 4px;
      min-font-size: 10px;
      flex-shrink: 0;
    }

    .breadcrumb-home-icon {
      width: 14px;
      height: 14px;
    }

    .breadcrumb-separator-icon {
      width: 6px;
      height: 10px;
    }

    /* 平板端文本优化 */
    .breadcrumb-text,
    .breadcrumb-link {
      max-width: none;
      overflow: visible;
      text-overflow: clip;
      white-space: normal;
      word-break: break-word;
    }

    /* 为长文本添加智能截断 */
    .breadcrumb-text,
    .breadcrumb-link {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      max-width: 180px;
    }

    /* 当前页面项保持单行 */
    .breadcrumb-current .breadcrumb-current-text {
      white-space: nowrap;
      max-width: 150px;
      text-overflow: ellipsis;
      overflow: hidden;
    }
  }

  /* 超小屏幕优化 */
  @media (max-width: 480px) {
    .breadcrumb-navigation-section {
      padding: calc({{ section.settings.section_padding_top }}px * 0.5) 0;
    }

    .breadcrumb-container {
      padding: 0 10px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    .breadcrumb-list {
      gap: clamp(4px, 1vw, 8px);
      flex-wrap: nowrap;
      min-width: max-content;
      padding-bottom: 8px;
    }

    .breadcrumb-item {
      gap: clamp(4px, 1vw, 6px);
      font-size: clamp(10px, 2.5vw, 12px);
      flex-shrink: 0;
    }

    .breadcrumb-home-icon {
      width: clamp(12px, 3vw, 16px);
      height: clamp(12px, 3vw, 16px);
    }

    .breadcrumb-separator-icon {
      width: clamp(6px, 1.5vw, 8px);
      height: clamp(8px, 2vw, 12px);
    }

    /* 移动端文本优化 - 移除强制截断 */
    .breadcrumb-text,
    .breadcrumb-link {
      max-width: none;
      overflow: visible;
      text-overflow: clip;
      white-space: normal;
      word-break: break-word;
    }

    /* 可选：为长文本添加渐变截断效果 */
    .breadcrumb-text,
    .breadcrumb-link {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      max-width: 150px;
    }

    /* 当前页面项保持单行 */
    .breadcrumb-current .breadcrumb-current-text {
      white-space: nowrap;
      max-width: 120px;
      text-overflow: ellipsis;
      overflow: hidden;
    }
  }

  /* 极超小屏幕优化 (320px以下) */
  @media (max-width: 320px) {
    .breadcrumb-container {
      padding: 0 8px;
    }

    .breadcrumb-list {
      gap: 2px;
      padding-bottom: 6px;
    }

    .breadcrumb-item {
      gap: 2px;
      font-size: 10px;
    }

    .breadcrumb-home-icon {
      width: 12px;
      height: 12px;
    }

    .breadcrumb-separator-icon {
      width: 6px;
      height: 8px;
    }

    /* 极超小屏幕文本截断 */
    .breadcrumb-text,
    .breadcrumb-link {
      max-width: 100px;
      -webkit-line-clamp: 1;
    }

    .breadcrumb-current .breadcrumb-current-text {
      max-width: 80px;
    }
  }
</style>

{% schema %}
{
  "name": "Breadcrumb Navigation",
  "tag": "section",
  "class": "breadcrumb-navigation-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 16
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Product Settings"
    },
    {
      "type": "paragraph",
      "content": "This section will automatically use the current product when placed on a product page. You can also manually select a product for other pages."
    },
    {
      "type": "product",
      "id": "product_handle",
      "label": "Manual Product Selection (optional)",
      "info": "Leave empty to use current product on product pages"
    },
    {
      "type": "header",
      "content": "Collection Name Aliases"
    },
    {
      "type": "paragraph",
      "content": "Configure custom display names for collections. Add Collection Alias blocks below to map original collection names to custom display names. If no alias is configured, the original collection name will be used."
    },
    {
      "type": "header",
      "content": "Parent Collection"
    },
    {
      "type": "text",
      "id": "parent_collection_title",
      "label": "Parent Collection Title",
      "default": "Pilates Equipment",
      "info": "Fixed parent category shown before product collection (non-clickable)"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "rgba(22, 22, 22, 0.5)"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link Hover Color",
      "default": "#333333"
    },
    {
      "type": "select",
      "id": "link_font_weight",
      "label": "Link Font Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "rgba(22, 22, 22, 0.5)"
    },
    {
      "type": "select",
      "id": "text_font_weight",
      "label": "Text Font Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "current_text_color",
      "label": "Current Page Text Color",
      "default": "#161616"
    },
    {
      "type": "select",
      "id": "current_font_weight",
      "label": "Current Page Font Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "image_picker",
      "id": "home_icon",
      "label": "Home Icon",
      "info": "Upload custom home icon (recommended size: 16x16px). If not provided, default home icon will be used."
    },
    {
      "type": "color",
      "id": "home_icon_color",
      "label": "Home Icon Color",
      "default": "#999999"
    },
    {
      "type": "image_picker",
      "id": "separator_icon",
      "label": "Custom Separator Icon",
      "info": "Upload custom separator icon (recommended size: 8x12px). If not provided, default arrow will be used."
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator Color",
      "default": "#cccccc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 4,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Item Spacing",
      "default": 13
    },
    {
      "type": "range",
      "id": "separator_spacing",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Separator Spacing",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "breadcrumb_item",
      "name": "Breadcrumb Item",
      "settings": [
        {
          "type": "text",
          "id": "item_text",
          "label": "Item Text",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "item_url",
          "label": "Item URL",
          "info": "Leave empty to make this item non-clickable"
        }
      ]
    },
    {
      "type": "collection_alias",
      "name": "Collection Alias",
      "settings": [
        {
          "type": "text",
          "id": "original_name",
          "label": "Original Collection Name",
          "info": "Enter the exact original collection name as it appears in Shopify"
        },
        {
          "type": "text",
          "id": "display_name",
          "label": "Display Name",
          "info": "Enter the custom display name you want to show in breadcrumbs"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Breadcrumb Navigation",
      "settings": {
        "section_padding_top": 16,
        "section_padding_bottom": 16,
        "section_background_color": "#ffffff",
        "parent_collection_title": "Pilates Equipment",
        "link_color": "rgba(22, 22, 22, 0.5)",
        "link_hover_color": "#333333",
        "link_font_weight": "400",
        "text_color": "rgba(22, 22, 22, 0.5)",
        "text_font_weight": "400",
        "current_text_color": "#161616",
        "current_font_weight": "500",
        "home_icon_color": "#999999",
        "separator_color": "#cccccc",
        "item_spacing": 13,
        "separator_spacing": 12
      },
      "blocks": [
        {
          "type": "collection_alias",
          "settings": {
            "original_name": "Reformer",
            "display_name": "Pilates Reformers"
          }
        },
        {
          "type": "collection_alias",
          "settings": {
            "original_name": "Cadillac",
            "display_name": "Pilates Cadillacs"
          }
        },
        {
          "type": "collection_alias",
          "settings": {
            "original_name": "Chair",
            "display_name": "Pilates Chairs"
          }
