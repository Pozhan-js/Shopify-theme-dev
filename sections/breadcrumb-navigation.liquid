<div class="breadcrumb-navigation-section" {{ section.shopify_attributes }}>
  <div class="breadcrumb-container">
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <!-- Home Icon -->
        <li class="breadcrumb-item breadcrumb-home">
          <a href="{{ routes.root_url }}" class="breadcrumb-link" aria-label="Home">
            {% if section.settings.home_icon %}
              <img src="{{ section.settings.home_icon | img_url: '20x20' }}" alt="Home" class="breadcrumb-home-icon">
            {% else %}
              <svg class="breadcrumb-home-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 9L12 2L21 9V20C21 20.5304 20.7893 21.0391 20.4142 21.4142C20.0391 21.7893 19.5304 22 19 22H5C4.46957 22 3.96086 21.7893 3.58579 21.4142C3.21071 21.0391 3 20.5304 3 20V9Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M9 22V12H15V22" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {% endif %}
          </a>
          <span class="breadcrumb-separator">
            {% if section.settings.separator_icon %}
              <img src="{{ section.settings.separator_icon | img_url: '12x12' }}" alt=">" class="breadcrumb-separator-icon">
            {% else %}
              <svg class="breadcrumb-separator-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M1.5 1L6.5 6L1.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {% endif %}
          </span>
        </li>

        <!-- Dynamic Breadcrumb Items -->
        {% comment %} 优先使用当前产品页面的产品，然后是设置中选择的产品 {% endcomment %}
        {% assign current_product = product %}
        {% assign selected_product = all_products[section.settings.product_handle] %}
        {% assign display_product = current_product | default: selected_product %}

        {% if display_product %}
          <!-- 产品集合面包屑 -->
          {% if display_product.collections.size > 0 %}
            {% assign main_collection = display_product.collections.first %}
            
            <!-- 父级集合 (如果存在) -->
            {% if section.settings.parent_collection_title %}
              <li class="breadcrumb-item">
                <a href="{{ section.settings.parent_collection_url | default: '/collections' }}" class="breadcrumb-link">
                  {{ section.settings.parent_collection_title }}
                </a>
                <span class="breadcrumb-separator">
                  {% if section.settings.separator_icon %}
                    <img src="{{ section.settings.separator_icon | img_url: '12x12' }}" alt=">" class="breadcrumb-separator-icon">
                  {% else %}
                    <svg class="breadcrumb-separator-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M1.5 1L6.5 6L1.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {% endif %}
                </span>
              </li>
            {% endif %}

            <!-- 当前集合 -->
            <li class="breadcrumb-item">
              <a href="{{ main_collection.url }}" class="breadcrumb-link">
                {{ main_collection.title }}
              </a>
              <span class="breadcrumb-separator">
                {% if section.settings.separator_icon %}
                  <img src="{{ section.settings.separator_icon | img_url: '12x12' }}" alt=">" class="breadcrumb-separator-icon">
                {% else %}
                  <svg class="breadcrumb-separator-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1.5 1L6.5 6L1.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% endif %}
              </span>
            </li>
          {% else %}
            <!-- 如果产品没有集合，使用默认面包屑 -->
            {% for block in section.blocks %}
              {% if block.type == 'breadcrumb_item' %}
                <li class="breadcrumb-item" {{ block.shopify_attributes }}>
                  {% if block.settings.item_url %}
                    <a href="{{ block.settings.item_url }}" class="breadcrumb-link">
                      {{ block.settings.item_text }}
                    </a>
                  {% else %}
                    <span class="breadcrumb-text">{{ block.settings.item_text }}</span>
                  {% endif %}
                  {% unless forloop.last %}
                    <span class="breadcrumb-separator">
                      {% if section.settings.separator_icon %}
                        <img src="{{ section.settings.separator_icon | img_url: '12x12' }}" alt=">" class="breadcrumb-separator-icon">
                      {% else %}
                        <svg class="breadcrumb-separator-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M1.5 1L6.5 6L1.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      {% endif %}
                    </span>
                  {% endunless %}
                </li>
              {% endif %}
            {% endfor %}
          {% endif %}

          <!-- 当前产品 (最后一项，不可点击) -->
          <li class="breadcrumb-item breadcrumb-current" aria-current="page">
            <span class="breadcrumb-text breadcrumb-current-text">
              {{ display_product.title }}
            </span>
          </li>
        {% else %}
          <!-- 如果没有产品，使用区块配置的面包屑 -->
          {% for block in section.blocks %}
            {% if block.type == 'breadcrumb_item' %}
              <li class="breadcrumb-item" {{ block.shopify_attributes }}>
                {% if block.settings.item_url %}
                  <a href="{{ block.settings.item_url }}" class="breadcrumb-link">
                    {{ block.settings.item_text }}
                  </a>
                {% else %}
                  <span class="breadcrumb-text">{{ block.settings.item_text }}</span>
                {% endif %}
                {% unless forloop.last %}
                  <span class="breadcrumb-separator">
                    {% if section.settings.separator_icon %}
                      <img src="{{ section.settings.separator_icon | img_url: '12x12' }}" alt=">" class="breadcrumb-separator-icon">
                    {% else %}
                      <svg class="breadcrumb-separator-icon" width="8" height="12" viewBox="0 0 8 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M1.5 1L6.5 6L1.5 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% endif %}
                  </span>
                {% endunless %}
              </li>
            {% endif %}
          {% endfor %}
        {% endif %}
      </ol>
    </nav>
  </div>
</div>

<style>
  .breadcrumb-navigation-section {
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px 0;
    background-color: {{ section.settings.section_background_color }};
    border-bottom: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    margin-top: 66px;
  }

  .breadcrumb-container {
    max-width: 1520px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .breadcrumb-nav {
    width: 100%;
  }

  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: {{ section.settings.item_spacing }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .breadcrumb-item {
    display: flex;
    align-items: center;
    gap: {{ section.settings.separator_spacing }}px;
    font-size: {{ section.settings.font_size }}px;
    line-height: 1.4;
  }

  .breadcrumb-link {
    color: {{ section.settings.link_color }};
    text-decoration: none;
    transition: color 0.3s ease;
    display: flex;
    align-items: center;
    font-weight: {{ section.settings.link_font_weight }};
  }

  .breadcrumb-link:hover {
    color: {{ section.settings.link_hover_color }};
  }

  .breadcrumb-text {
    color: {{ section.settings.text_color }};
    font-weight: {{ section.settings.text_font_weight }};
  }

  .breadcrumb-current-text {
    color: {{ section.settings.current_text_color }};
    font-weight: {{ section.settings.current_font_weight }};
  }

  .breadcrumb-home-icon {
    width: 16px;
    height: 16px;
    display: block;
    color: {{ section.settings.home_icon_color }};
  }

  .breadcrumb-separator {
    display: flex;
    align-items: center;
    color: {{ section.settings.separator_color }};
  }

  .breadcrumb-separator-icon {
    width: 8px;
    height: 12px;
    display: block;
    color: {{ section.settings.separator_color }};
  }

  /* 响应式设计 - 基于1920px设计图按比例缩放 */

  /* 大屏幕 (1920px+) - 使用设计图精确尺寸 */
  @media (min-width: 1920px) {
    .breadcrumb-container {
      max-width: 1520px;
    }
    
    .breadcrumb-list {
      gap: {{ section.settings.item_spacing }}px;
    }
    
    .breadcrumb-item {
      gap: {{ section.settings.separator_spacing }}px;
      font-size: {{ section.settings.font_size }}px;
    }
    
    .breadcrumb-home-icon {
      width: 16px;
      height: 16px;
    }
    
    .breadcrumb-separator-icon {
      width: 8px;
      height: 12px;
    }
  }

  /* 其余尺寸自适应 - 基于视口宽度动态计算 */
  @media (max-width: 1919px) {
    .breadcrumb-container {
      max-width: calc(1520px * (100vw / 1920px));
      min-max-width: 320px;
    }
    
    .breadcrumb-list {
      gap: calc({{ section.settings.item_spacing }}px * (100vw / 1920px));
      min-gap: 4px;
    }
    
    .breadcrumb-item {
      gap: calc({{ section.settings.separator_spacing }}px * (100vw / 1920px));
      font-size: calc({{ section.settings.font_size }}px * (100vw / 1920px));
      min-gap: 4px;
      min-font-size: 10px;
    }
    
    .breadcrumb-home-icon {
      width: calc(16px * (100vw / 1920px));
      height: calc(16px * (100vw / 1920px));
      min-width: 12px;
      min-height: 12px;
    }
    
    .breadcrumb-separator-icon {
      width: calc(8px * (100vw / 1920px));
      height: calc(12px * (100vw / 1920px));
      min-width: 6px;
      min-height: 8px;
    }
  }

  /* 平板和手机端 - 单行布局 */
  @media (max-width: 768px) {
    .breadcrumb-container {
      padding: 0 15px;
    }
    
    .breadcrumb-list {
      gap: calc({{ section.settings.item_spacing }}px * 0.5);
      min-gap: 4px;
    }
    
    .breadcrumb-item {
      gap: calc({{ section.settings.separator_spacing }}px * 0.5);
      font-size: calc({{ section.settings.font_size }}px * 0.75);
      min-gap: 4px;
      min-font-size: 10px;
    }
    
    .breadcrumb-home-icon {
      width: 14px;
      height: 14px;
    }
    
    .breadcrumb-separator-icon {
      width: 6px;
      height: 10px;
    }
  }

  /* 超小屏幕优化 */
  @media (max-width: 480px) {
    .breadcrumb-navigation-section {
      padding: calc({{ section.settings.section_padding_top }}px * 0.5) 0;
    }
    
    .breadcrumb-container {
      padding: 0 10px;
    }
    
    .breadcrumb-list {
      gap: clamp(4px, 1vw, 8px);
    }
    
    .breadcrumb-item {
      gap: clamp(4px, 1vw, 6px);
      font-size: clamp(10px, 2.5vw, 14px);
    }
    
    .breadcrumb-home-icon {
      width: clamp(12px, 3vw, 16px);
      height: clamp(12px, 3vw, 16px);
    }
    
    .breadcrumb-separator-icon {
      width: clamp(6px, 1.5vw, 8px);
      height: clamp(8px, 2vw, 12px);
    }

    /* 移动端文本截断 */
    .breadcrumb-text,
    .breadcrumb-link {
      max-width: 120px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>

{% schema %}
{
  "name": "Breadcrumb Navigation",
  "tag": "section",
  "class": "breadcrumb-navigation-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Top Padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 16
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Bottom Border Width",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Bottom Border Color",
      "default": "#e5e5e5"
    },
    {
      "type": "header",
      "content": "Product Settings"
    },
    {
      "type": "paragraph",
      "content": "This section will automatically use the current product when placed on a product page. You can also manually select a product for other pages."
    },
    {
      "type": "product",
      "id": "product_handle",
      "label": "Manual Product Selection (optional)",
      "info": "Leave empty to use current product on product pages"
    },
    {
      "type": "header",
      "content": "Parent Collection"
    },
    {
      "type": "text",
      "id": "parent_collection_title",
      "label": "Parent Collection Title",
      "default": "Pilates Equipment",
      "info": "Optional parent category to show before product collection"
    },
    {
      "type": "url",
      "id": "parent_collection_url",
      "label": "Parent Collection URL"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 14
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Link Hover Color",
      "default": "#333333"
    },
    {
      "type": "select",
      "id": "link_font_weight",
      "label": "Link Font Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    },
    {
      "type": "select",
      "id": "text_font_weight",
      "label": "Text Font Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "current_text_color",
      "label": "Current Page Text Color",
      "default": "#333333"
    },
    {
      "type": "select",
      "id": "current_font_weight",
      "label": "Current Page Font Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "image_picker",
      "id": "home_icon",
      "label": "Custom Home Icon",
      "info": "Upload custom home icon (recommended size: 16x16px). If not provided, default home icon will be used."
    },
    {
      "type": "color",
      "id": "home_icon_color",
      "label": "Home Icon Color",
      "default": "#999999"
    },
    {
      "type": "image_picker",
      "id": "separator_icon",
      "label": "Custom Separator Icon",
      "info": "Upload custom separator icon (recommended size: 8x12px). If not provided, default arrow will be used."
    },
    {
      "type": "color",
      "id": "separator_color",
      "label": "Separator Color",
      "default": "#cccccc"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Item Spacing",
      "default": 8
    },
    {
      "type": "range",
      "id": "separator_spacing",
      "min": 4,
      "max": 16,
      "step": 2,
      "unit": "px",
      "label": "Separator Spacing",
      "default": 8
    }
  ],
  "blocks": [
    {
      "type": "breadcrumb_item",
      "name": "Breadcrumb Item",
      "settings": [
        {
          "type": "text",
          "id": "item_text",
          "label": "Item Text",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "item_url",
          "label": "Item URL",
          "info": "Leave empty to make this item non-clickable"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Breadcrumb Navigation",
      "settings": {
        "section_padding_top": 16,
        "section_padding_bottom": 16,
        "section_background_color": "#ffffff",
        "border_width": 1,
        "border_color": "#e5e5e5",
        "parent_collection_title": "Pilates Equipment",
        "font_size": 14,
        "link_color": "#999999",
        "link_hover_color": "#333333",
        "link_font_weight": "400",
        "text_color": "#666666",
        "text_font_weight": "400",
        "current_text_color": "#333333",
        "current_font_weight": "500",
        "home_icon_color": "#999999",
        "separator_color": "#cccccc",
        "item_spacing": 8,
        "separator_spacing": 8
      },
      "blocks": [
        {
          "type": "breadcrumb_item",
          "settings": {
            "item_text": "Pilates Equipment",
            "item_url": "/collections/pilates-equipment"
          }
        },
        {
          "type": "breadcrumb_item",
          "settings": {
            "item_text": "Reformer",
            "item_url": "/collections/reformer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
