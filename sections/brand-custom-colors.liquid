<div class="brand-custom-colors-section" {{ section.shopify_attributes }}>
  <div class="brand-custom-colors-container">
    <div class="brand-custom-colors-layout">
      <!-- 左侧文字内容 -->
      <div class="brand-custom-colors-text">
        <h2 class="brand-custom-colors-title">{{ section.settings.main_title }}</h2>

        <div class="brand-custom-colors-description">
          {{ section.settings.description }}
        </div>

        <div class="brand-custom-colors-cta">
          <p class="brand-custom-colors-cta-text">{{ section.settings.cta_text }}</p>
          {% if section.settings.show_underline %}
            <div class="brand-custom-colors-underline"></div>
          {% endif %}
        </div>
      </div>

      <!-- 右侧颜色材料图片 -->
      <div class="brand-custom-colors-visual">
        {% if section.settings.colors_image %}
          <img
            src="{{ section.settings.colors_image | img_url: '800x' }}"
            alt="{{ section.settings.colors_image_alt }}"
            class="brand-custom-colors-image"
          >
        {% endif %}
      </div>
    </div>
  </div>
</div>

<style>
  .brand-custom-colors-section {
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px 0;
    background-color: #fff;
  }

  .brand-custom-colors-container {
    max-width: 1520px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .brand-custom-colors-layout {
    display: grid;
    grid-template-columns: 626px 1fr;
    gap: 131px;
    align-items: center;
    min-height: 500px;
  }

  /* 左侧文字内容 */
  .brand-custom-colors-text {
    width: 626px;
    padding-right: 0;
  }

  .brand-custom-colors-title {
    font-size: 48px;
    font-weight: 500;
    color: #161616;
    line-height: {{ section.settings.title_line_height }};
    margin: 0 0 {{ section.settings.title_margin_bottom }}px 0;
    max-width: 556px;
  }

  .brand-custom-colors-description {
    font-size: 16px;
    color: rgba(22, 22, 22, 0.5);
    font-weight: 400;
    line-height: {{ section.settings.description_line_height }};
    margin: 0 0 124px 0;
    text-align: justify;
    text-justify: inter-word;
  }

  .brand-custom-colors-cta {
    margin-top: {{ section.settings.cta_margin_top }}px;
  }

  .brand-custom-colors-cta-text {
    font-size: {{ section.settings.cta_font_size }}px;
    color: #161616;
    font-weight: 600;
    line-height: {{ section.settings.cta_line_height }};
    margin: 0 0 {{ section.settings.cta_margin_bottom }}px 0;
  }

  .brand-custom-colors-underline {
    width: {{ section.settings.underline_width }}px;
    height: {{ section.settings.underline_height }}px;
    background-color: {{ section.settings.underline_color }};
    margin-top: {{ section.settings.underline_margin_top }}px;
  }

  /* 自适应下划线 - 根据最后一行文字长度 */
  .brand-custom-colors-cta-text {
    position: relative;
    display: block;
  }

  .brand-custom-colors-cta-text::after {
    content: '';
    position: absolute;
    bottom: -{{ section.settings.underline_margin_top }}px;
    left: 0;
    width: var(--last-line-width, 100%);
    height: {{ section.settings.underline_height }}px;
    background-color: {{ section.settings.underline_color }};
    display: {% if section.settings.show_underline %}block{% else %}none{% endif %};
    transition: width 0.3s ease;
  }

  /* 默认状态下的红线宽度 */
  .brand-custom-colors-cta-text:not(.js-calculated)::after {
    width: 80%;
  }

  /* 右侧颜色图片 */
  .brand-custom-colors-visual {
    display: flex;
    justify-content: center;
    align-items: center;
    padding-left: 40px;
  }

  .brand-custom-colors-image {
    width: 673px;
    height: 528px;
    display: block;
    object-fit: contain;
  }

  /* 响应式设计 */
  @media (max-width: 1919px) and (min-width: 1366px) {
    .brand-custom-colors-container {
      max-width: 1277px; /* 1520 * 0.84 */
    }
    
    .brand-custom-colors-layout {
      grid-template-columns: 526px 1fr; /* 626 * 0.84 */
      gap: 110px; /* 131 * 0.84 */
    }

    .brand-custom-colors-text {
      width: 526px; /* 626 * 0.84 */
      padding-right: 0;
    }

    .brand-custom-colors-title {
      max-width: 467px; /* 556 * 0.84 */
    }

    .brand-custom-colors-description {
      font-size: 13px; /* 16 * 0.84 */
      margin-bottom: 104px; /* 124 * 0.84 */
      text-align: justify;
      text-justify: inter-word;
    }

    .brand-custom-colors-visual {
      padding-left: 34px; /* 40 * 0.84 */
    }

    .brand-custom-colors-image {
      width: 565px; /* 673 * 0.84 */
      height: 444px; /* 528 * 0.84 */
    }
  }

  @media (max-width: 1365px) and (min-width: 1024px) {
    .brand-custom-colors-container {
      max-width: 1018px; /* 1520 * 0.67 */
      padding: 0 30px;
    }
    
    .brand-custom-colors-layout {
      grid-template-columns: 419px 1fr; /* 626 * 0.67 */
      gap: 88px; /* 131 * 0.67 */
    }

    .brand-custom-colors-text {
      width: 419px; /* 626 * 0.67 */
      padding-right: 0;
    }

    .brand-custom-colors-title {
      max-width: 373px; /* 556 * 0.67 */
    }

    .brand-custom-colors-description {
      font-size: 12px; /* 18 * 0.67 */
      margin-bottom: 83px; /* 124 * 0.67 */
      text-align: justify;
      text-justify: inter-word;
    }

    .brand-custom-colors-visual {
      padding-left: 27px; /* 40 * 0.67 */
    }

    .brand-custom-colors-image {
      width: 451px; /* 673 * 0.67 */
      height: 354px; /* 528 * 0.67 */
    }
  }

  @media (max-width: 1023px) and (min-width: 768px) {
    .brand-custom-colors-layout {
      grid-template-columns: 1fr;
      gap: 66px; /* 131 * 0.5 */
      text-align: center;
    }

    .brand-custom-colors-text {
      width: 100%;
      padding-right: 0;
      order: 1;
    }

    .brand-custom-colors-title {
      max-width: 278px; /* 556 * 0.5 */
      margin: 0 auto 15px auto; /* 30 * 0.5 */
    }

    .brand-custom-colors-description {
      font-size: 9px; /* 18 * 0.5 */
      margin-bottom: 62px; /* 124 * 0.5 */
      text-align: justify;
      text-justify: inter-word;
    }

    .brand-custom-colors-visual {
      padding-left: 0;
      order: 2;
    }

    .brand-custom-colors-image {
      width: 337px; /* 673 * 0.5 */
      height: 264px; /* 528 * 0.5 */
    }
  }

  @media (max-width: 767px) and (min-width: 481px) {
    .brand-custom-colors-container {
      padding: 0 20px;
    }
    
    .brand-custom-colors-layout {
      grid-template-columns: 1fr;
      gap: 52px; /* 131 * 0.4 */
      text-align: center;
    }

    .brand-custom-colors-text {
      width: 100%;
      padding-right: 0;
      order: 1;
    }

    .brand-custom-colors-title {
      font-size: 19px; /* 48 * 0.4 */
      max-width: 222px; /* 556 * 0.4 */
      margin: 0 auto 12px auto; /* 30 * 0.4 */
    }

    .brand-custom-colors-description {
      font-size: 6px; /* 16 * 0.4 */
      margin-bottom: 50px; /* 124 * 0.4 */
      text-align: justify;
      text-justify: inter-word;
    }

    .brand-custom-colors-cta-text {
      font-size: 7px; /* 18 * 0.4 */
      margin-bottom: 5px; /* 12 * 0.4 */
    }

    .brand-custom-colors-visual {
      padding-left: 0;
      order: 2;
    }

    .brand-custom-colors-image {
      width: 269px; /* 673 * 0.4 */
      height: 211px; /* 528 * 0.4 */
    }
  }

  @media (max-width: 480px) {
    .brand-custom-colors-container {
      padding: 0 15px;
    }

    .brand-custom-colors-section {
      padding: {{ section.settings.section_padding_top | divided_by: 2 }}px 0;
    }

    .brand-custom-colors-layout {
      grid-template-columns: 1fr;
      gap: 43px; /* 131 * 0.33 */
      text-align: center;
    }

    .brand-custom-colors-title {
      font-size: 16px; /* 48 * 0.33 */
      max-width: 184px; /* 556 * 0.33 */
      margin: 0 auto 10px auto; /* 30 * 0.33 */
    }

    .brand-custom-colors-description {
      font-size: 5px; /* 16 * 0.33 */
      margin-bottom: 41px; /* 124 * 0.33 */
      text-align: justify;
      text-justify: inter-word;
    }

    .brand-custom-colors-cta-text {
      font-size: 6px; /* 18 * 0.33 */
      margin-bottom: 4px; /* 12 * 0.33 */
    }

    .brand-custom-colors-image {
      width: 222px; /* 673 * 0.33 */
      height: 174px; /* 528 * 0.33 */
    }
  }

  @media (max-width: 320px) {
    .brand-custom-colors-layout {
      gap: 33px; /* 131 * 0.25 */
    }

    .brand-custom-colors-title {
      font-size: 12px; /* 48 * 0.25 */
      max-width: 139px; /* 556 * 0.25 */
      margin: 0 auto 8px auto; /* 30 * 0.25 */
    }

    .brand-custom-colors-description {
      font-size: 4px; /* 16 * 0.25 */
      margin-bottom: 31px; /* 124 * 0.25 */
      text-align: justify;
      text-justify: inter-word;
    }

    .brand-custom-colors-cta-text {
      font-size: 5px; /* 18 * 0.25 */
      margin-bottom: 3px; /* 12 * 0.25 */
    }

    .brand-custom-colors-image {
      width: 168px; /* 673 * 0.25 */
      height: 132px; /* 528 * 0.25 */
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  function calculateLastLineWidth() {
    const ctaTexts = document.querySelectorAll('.brand-custom-colors-cta-text');
    
    ctaTexts.forEach(function(ctaText) {
      if (!ctaText) return;
      
      // 创建一个临时的测量元素
      const tempElement = document.createElement('div');
      tempElement.style.cssText = `
        position: absolute;
        visibility: hidden;
        height: auto;
        width: auto;
        white-space: nowrap;
        font-family: ${getComputedStyle(ctaText).fontFamily};
        font-size: ${getComputedStyle(ctaText).fontSize};
        font-weight: ${getComputedStyle(ctaText).fontWeight};
        line-height: ${getComputedStyle(ctaText).lineHeight};
        letter-spacing: ${getComputedStyle(ctaText).letterSpacing};
      `;
      
      document.body.appendChild(tempElement);
      
      // 获取文本内容并按空格分割成单词
      const text = ctaText.textContent || ctaText.innerText;
      const words = text.trim().split(/\s+/);
      const containerWidth = ctaText.offsetWidth;
      
      let currentLine = '';
      let lastLineWidth = 0;
      
      // 逐个添加单词，检测换行
      for (let i = 0; i < words.length; i++) {
        const testLine = currentLine + (currentLine ? ' ' : '') + words[i];
        tempElement.textContent = testLine;
        
        if (tempElement.offsetWidth > containerWidth && currentLine !== '') {
          // 发生换行，当前行就是上一行
          tempElement.textContent = currentLine;
          // 开始新行
          currentLine = words[i];
        } else {
          currentLine = testLine;
        }
      }
      
      // 最后一行的宽度
      tempElement.textContent = currentLine;
      lastLineWidth = tempElement.offsetWidth;
      
      // 清理临时元素
      document.body.removeChild(tempElement);
      
      // 设置CSS变量
      ctaText.style.setProperty('--last-line-width', lastLineWidth + 'px');
      ctaText.classList.add('js-calculated');
    });
  }
  
  // 初始计算
  calculateLastLineWidth();
  
  // 窗口大小改变时重新计算
  let resizeTimer;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(calculateLastLineWidth, 250);
  });
  
  // 字体加载完成后重新计算
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(calculateLastLineWidth);
  }
});
</script>

{% schema %}
{
  "name": "Brand Custom Colors",
  "tag": "section",
  "class": "brand-colors-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "color",
      "id": "section_background_color",
      "label": "Section Background Color",
      "default": "#fff"
    },
    {
      "type": "header",
      "content": "Main Title"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title",
      "default": "Match Your Brand with 14 Custom Colors"
    },
    {
      "type": "range",
      "id": "title_line_height",
      "min": 1.0,
      "max": 2.0,
      "step": 0.1,
      "label": "Title Line Height",
      "default": 1.2
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Title Bottom Margin",
      "default": 30
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "We offer over 14 standard upholstery color options — all customizable at scale to match your brand's unique identity. Whether you require matte or glossy textures, minimal tones or bold accents, we ensure visual consistency across your entire product line. For bulk OEM orders, we support custom color matching, sampling, and full material documentation. Our team can also assist with building a branded aesthetic system tailored to your market."
    },
    {
      "type": "range",
      "id": "description_line_height",
      "min": 1.2,
      "max": 2.0,
      "step": 0.1,
      "label": "Description Line Height",
      "default": 1.6
    },
    {
      "type": "range",
      "id": "description_margin_bottom",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Description Bottom Margin",
      "default": 40
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "textarea",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Ready to create your own collection? Get in touch for custom options and full color charts."
    },
    {
      "type": "range",
