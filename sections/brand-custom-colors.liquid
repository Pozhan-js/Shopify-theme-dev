      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "CTA Font Size",
      "default": 18
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "CTA Text Color",
      "default": "#333333"
    },
    {
      "type": "select",
      "id": "cta_font_weight",
