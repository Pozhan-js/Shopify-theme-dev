{%- style -%}
  .recently-viewed {
    width: 100vw;
    background-color: #f8f9fa;
    padding: 60px 0;
    margin-left: calc(-50vw + 50%);
    margin-right: calc(-50vw + 50%);
  }

  .recently-viewed__container {
    max-width: 1350px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .recently-viewed__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
  }

  .recently-viewed__title {
    font-size: 32px;
    font-weight: 700;
    color: #1a1a1a;
    margin: 0;
  }

  .recently-viewed__nav {
    display: flex;
    gap: 12px;
  }

  .recently-viewed__nav-btn {
    width: 44px;
    height: 44px;
    border: none;
    background: #ffffff;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .recently-viewed__nav-btn:hover {
    background: #871d16;
    color: white;
    transform: translateY(-2px);
  }

  .recently-viewed__nav-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  .recently-viewed__nav-btn svg {
    width: 20px;
    height: 20px;
  }

  .recently-viewed__slider {
    position: relative;
    overflow: hidden;
  }

  .recently-viewed__track {
    display: flex;
    transition: transform 0.4s ease;
    gap: 20px;
  }

  .recently-viewed__slide {
    flex: 0 0 calc(20% - 16px);
    min-width: 0;
  }

  .recently-viewed__product {
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .recently-viewed__product:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .recently-viewed__image {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    background: #f5f5f5;
  }

  .recently-viewed__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .recently-viewed__product:hover .recently-viewed__image img {
    transform: scale(1.05);
  }

  .recently-viewed__content {
    padding: 16px;
  }

  .recently-viewed__product-title {
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 8px 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .recently-viewed__product-title a {
    color: inherit;
    text-decoration: none;
  }

  .recently-viewed__product-title a:hover {
    color: #871d16;
  }

  .recently-viewed__price {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .recently-viewed__current-price {
    font-size: 18px;
    font-weight: 700;
    color: #1a1a1a;
  }

  .recently-viewed__original-price {
    font-size: 14px;
    color: #999;
    text-decoration: line-through;
  }

  .recently-viewed__vendor {
    font-size: 13px;
    color: #666;
    margin-bottom: 8px;
  }

  .recently-viewed__add-to-cart {
    width: 100%;
    background: #871d16;
    color: white;
    border: none;
    padding: 10px 16px;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .recently-viewed__add-to-cart:hover {
    background: #6b1611;
  }

  .recently-viewed__empty {
    text-align: center;
    padding: 60px 0;
  }

  .recently-viewed__empty-title {
    font-size: 24px;
    color: #666;
    margin-bottom: 10px;
  }

  .recently-viewed__empty-text {
    font-size: 16px;
    color: #999;
  }

  /* 响应式设计 */
  @media (max-width: 1200px) {
    .recently-viewed__slide {
      flex: 0 0 calc(25% - 15px);
    }
  }

  @media (max-width: 992px) {
    .recently-viewed__slide {
      flex: 0 0 calc(33.333% - 13.333px);
    }
  }

  @media (max-width: 768px) {
    .recently-viewed {
      padding: 40px 0;
    }

    .recently-viewed__title {
      font-size: 28px;
    }

    .recently-viewed__slide {
      flex: 0 0 calc(50% - 10px);
    }

    .recently-viewed__nav {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .recently-viewed__slide {
      flex: 0 0 100%;
    }
  }
{%- endstyle -%}

<section class="recently-viewed">
  <div class="recently-viewed__container">
    <div class="recently-viewed__header">
      {% if section.settings.title != blank %}
        <h2 class="recently-viewed__title">{{ section.settings.title }}</h2>
      {% else %}
        <h2 class="recently-viewed__title">Recently Viewed</h2>
      {% endif %}

      <div class="recently-viewed__nav">
        <button class="recently-viewed__nav-btn" id="prev-btn" aria-label="Previous products">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button class="recently-viewed__nav-btn" id="next-btn" aria-label="Next products">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="recently-viewed__slider">
      <div class="recently-viewed__track" id="recently-track">
        {%- assign recent_products = product.metafields.custom.recently_viewed
          | default: collections.all.products
          | limit: 5
        -%}

        {%- if recent_products.size > 0 -%}
          {%- for product in recent_products limit: 5 -%}
            <div class="recently-viewed__slide">
              <div class="recently-viewed__product">
                <a href="{{ product.url }}" class="recently-viewed__image">
                  {%- if product.featured_image -%}
                    <img
                      src="{{ product.featured_image | img_url: '300x300' }}"
                      alt="{{ product.title }}"
                      loading="lazy"
                    >
                  {%- else -%}
                    <div style="background: #f5f5f5; height: 100%; display: flex; align-items: center; justify-content: center;">
                      <span style="color: #999; font-size: 14px;">No Image</span>
                    </div>
                  {%- endif -%}
                </a>

                <div class="recently-viewed__content">
                  {%- if product.vendor != blank -%}
                    <div class="recently-viewed__vendor">{{ product.vendor }}</div>
                  {%- endif -%}

                  <h3 class="recently-viewed__product-title">
                    <a href="{{ product.url }}">{{ product.title }}</a>
                  </h3>

                  <div class="recently-viewed__price">
                    <span class="recently-viewed__current-price">{{ product.price | money }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="recently-viewed__original-price">{{ product.compare_at_price | money }}</span>
                    {%- endif -%}
                  </div>

                  <button
                    class="recently-viewed__add-to-cart"
                    onclick="addToCart({{ product.selected_or_first_available_variant.id }})"
                  >
                    Add to Cart
                  </button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="recently-viewed__empty">
            <h3 class="recently-viewed__empty-title">No recently viewed products</h3>
            <p class="recently-viewed__empty-text">Start browsing to see your recently viewed items here.</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  class RecentlyViewedSlider {
    constructor() {
      this.track = document.getElementById('recently-track');
      this.slides = this.track.querySelectorAll('.recently-viewed__slide');
      this.prevBtn = document.getElementById('prev-btn');
      this.nextBtn = document.getElementById('next-btn');
      this.currentIndex = 0;
      this.slideWidth = 0;
      this.visibleSlides = 5;

      this.init();
    }

    init() {
      if (this.slides.length === 0) return;

      this.calculateVisibleSlides();
      this.bindEvents();
      this.updateButtons();

      // 响应式处理
      window.addEventListener('resize', () => {
        this.calculateVisibleSlides();
        this.updateSlider();
      });
    }

    calculateVisibleSlides() {
      const containerWidth = this.track.parentElement.offsetWidth;

      if (window.innerWidth <= 480) {
        this.visibleSlides = 1;
      } else if (window.innerWidth <= 768) {
        this.visibleSlides = 2;
      } else if (window.innerWidth <= 992) {
        this.visibleSlides = 3;
      } else if (window.innerWidth <= 1200) {
        this.visibleSlides = 4;
      } else {
        this.visibleSlides = 5;
      }

      this.slideWidth = 100 / this.visibleSlides;
    }

    updateSlider() {
      const translateX = -this.currentIndex * this.slideWidth;
      this.track.style.transform = `translateX(${translateX}%)`;
      this.updateButtons();
    }

    nextSlide() {
      const maxIndex = Math.max(0, this.slides.length - this.visibleSlides);
      if (this.currentIndex < maxIndex) {
        this.currentIndex++;
        this.updateSlider();
      }
    }

    prevSlide() {
      if (this.currentIndex > 0) {
        this.currentIndex--;
        this.updateSlider();
      }
    }

    updateButtons() {
      const maxIndex = Math.max(0, this.slides.length - this.visibleSlides);

      this.prevBtn.disabled = this.currentIndex === 0;
      this.nextBtn.disabled = this.currentIndex >= maxIndex;
    }

    bindEvents() {
      this.prevBtn.addEventListener('click', () => this.prevSlide());
      this.nextBtn.addEventListener('click', () => this.nextSlide());
    }
  }

  // 添加到购物车功能
  function addToCart(variantId) {
    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Accept: 'application/json',
      },
      body: JSON.stringify({
        id: variantId,
        quantity: 1,
      }),
    })
      .then((response) => response.json())
      .then((data) => {
        // 显示成功消息或更新购物车计数
        console.log('Product added to cart:', data);
        // 这里可以触发购物车抽屉打开或其他反馈
      })
      .catch((error) => {
        console.error('Error adding to cart:', error);
      });
  }

  // 初始化滑块
  document.addEventListener('DOMContentLoaded', function () {
    new RecentlyViewedSlider();
  });

  // 记录浏览历史
  document.addEventListener('DOMContentLoaded', function () {
    if (window.location.pathname.includes('/products/')) {
      const productHandle = window.location.pathname.split('/products/')[1]?.split('/')[0];
      if (productHandle) {
        let viewedProducts = JSON.parse(localStorage.getItem('recentlyViewed') || '[]');
        viewedProducts = viewedProducts.filter((handle) => handle !== productHandle);
        viewedProducts.unshift(productHandle);
        viewedProducts = viewedProducts.slice(0, 10);
        localStorage.setItem('recentlyViewed', JSON.stringify(viewedProducts));
      }
    }
  });
</script>

{% schema %}
{
  "name": "Recently Viewed Products",
  "tag": "section",
  "class": "recently-viewed-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Recently Viewed"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f8f9fa"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Recently Viewed Products"
    }
  ]
}
{% endschema %}
