{% comment %}
  AlmaZen Our Philosophy Section
{% endcomment %}

<style>
  .almazen-philosophy {
    padding: 5rem 1.5rem;
    background: white;
  }
  
  .almazen-philosophy .container {
    max-width: 80rem;
    margin: 0 auto;
  }
  
  .almazen-philosophy .section-header {
    text-align: center;
    margin-bottom: 4rem;
    animation: slideUp 0.6s ease-out;
  }
  
  .almazen-philosophy .section-title {
    font-size: 2.5rem;
    font-family: 'Noto Serif', serif;
    font-weight: 300;
    color: #4a3f32;
    margin-bottom: 1.5rem;
  }
  
  .almazen-philosophy .section-divider {
    width: 4rem;
    height: 2px;
    background: #5a7c5a;
    margin: 0 auto 2rem;
  }
  
  .almazen-philosophy .section-intro {
    font-size: 1.125rem;
    color: #8b7d68;
    max-width: 48rem;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  /* 新增的文本框和图片样式 */
  .almazen-philosophy .intro-content {
    max-width: 80rem;
    margin: 0 auto 2rem;
  }

  .almazen-philosophy .intro-text {
    background: #faf9f7;
    border-radius: 0.75rem;
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
  }

  .almazen-philosophy .intro-text:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(45, 36, 27, 0.1);
  }

  .almazen-philosophy .intro-text-content {
    color: #8b7d68;
    line-height: 1.6;
    font-size: 1rem;
  }

  .almazen-philosophy .intro-image-container {
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }

  .almazen-philosophy .intro-image-container:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  .almazen-philosophy .intro-image {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  
  /* 其余样式保持不变... */
</style>


<section id="philosophy" class="almazen-philosophy">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        {{ section.settings.philosophy_title | default: 'Our Philosophy' }}
      </h2>
      <div class="section-divider"></div>
      <p class="section-intro">
        {{ section.settings.philosophy_intro }}
      </p>
      
      <!-- 新增的文本框和图片 -->
      <div class="intro-content">
        {% if section.settings.intro_text_content != blank %}
          <div class="intro-text">
            <div class="intro-text-content">
              {{ section.settings.intro_text_content }}
            </div>
          </div>
        {% endif %}
        
        {% if section.settings.intro_image %}
          <div class="intro-image-container" style="{% if section.settings.intro_image_height %}height: {{ section.settings.intro_image_height }}px;{% endif %}">
            <img 
              src="{{ section.settings.intro_image | image_url: width: 1200 }}" 
              alt="{{ section.settings.intro_image_alt | default: 'Philosophy Introduction' }}"
              class="intro-image"
              loading="lazy"
              width="1200"
              {% if section.settings.intro_image_height %}height="{{ section.settings.intro_image_height }}"{% endif %}
            >
          </div>
        {% endif %}
      </div>
    </div>

    <div class="principles-grid">
      {% for block in section.blocks %}
        {% if block.type == 'philosophy_principle' %}
          <div class="principle-card">
            {% comment %} <div class="principle-icon">
              <i class="fas {{ block.settings.principle_icon }}" style="color: white; font-size: 1.25rem;"></i>
            </div> {% endcomment %}
            <h3 class="principle-title">{{ block.settings.principle_title }}</h3>
            <p class="principle-description">{{ block.settings.principle_description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.philosophy_bg_image %}
      <div class="highlight-section">
        <div 
          class="highlight-bg"
          style="background-image: url('{{ section.settings.philosophy_bg_image | image_url: width: 2048 }}');"
        >
          <div class="highlight-overlay"></div>
          <div class="highlight-content">
            <h3 class="highlight-title">
              {{ section.settings.philosophy_highlight_title }}
            </h3>
            <p class="highlight-text">
              {{ section.settings.philosophy_highlight_text }}
            </p>
          </div>
        </div>
      </div>
    {% endif %}
    
    {% if section.settings.text_content_title != blank or section.settings.text_content_body != blank %}
      <div class="text-section">
        <div class="text-content">
          {% if section.settings.text_content_title != blank %}
            <h3 class="text-title">{{ section.settings.text_content_title }}</h3>
          {% endif %}
          {% if section.settings.text_content_body != blank %}
            <div 
              class="text-body {% if section.settings.text_wrap_enabled %}wrap-enabled{% else %}wrap-disabled{% endif %}"
              style="font-size: {{ section.settings.text_font_size }}px;"
            >
              {{ section.settings.text_content_body }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
    
    {% if section.settings.bottom_image_desktop or section.settings.bottom_image_mobile %}
      <div class="bottom-image-section">
        <div class="bottom-image-container" style="height: {{ section.settings.bottom_image_height }}px;">
          <!-- PC端图片 -->
          {% if section.settings.bottom_image_desktop %}
            <img 
              src="{{ section.settings.bottom_image_desktop | image_url: width: 2048 }}" 
              alt="{{ section.settings.bottom_image_alt | default: 'Our Philosophy' }}"
              class="bottom-image bottom-image-desktop"
              loading="lazy"
              width="2048"
              height="{{ section.settings.bottom_image_height }}"
            >
          {% endif %}
          
          <!-- 移动端图片 -->
          {% if section.settings.bottom_image_mobile %}
            <img 
              src="{{ section.settings.bottom_image_mobile | image_url: width: 768 }}" 
              alt="{{ section.settings.bottom_image_mobile_alt | default: section.settings.bottom_image_alt | default: 'Our Philosophy' }}"
              class="bottom-image bottom-image-mobile"
              loading="lazy"
              width="768"
              height="{{ section.settings.bottom_image_mobile_height | default: section.settings.bottom_image_height }}"
            >
          {% endif %}
          
          <div class="bottom-image-overlay"></div>
        </div>
      </div>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const principlesGrid = document.querySelector('.almazen-philosophy .principles-grid');
    if (principlesGrid) {
      const principleCount = principlesGrid.children.length;
      principlesGrid.style.setProperty('--principle-count', principleCount);
    }
  });
</script>

{% schema %}
{
  "name": "Our Philosophy",
  "settings": [
    {
      "type": "text",
      "id": "philosophy_title",
      "label": "Section Title",
      "default": "Our Philosophy"
    },
    {
      "type": "textarea",
      "id": "philosophy_intro",
      "label": "Introduction Text",
      "default": "Deeply rooted in Zen principles, our philosophy guides every aspect of AlmaZen, from product creation to community building."
    },
    {
      "type": "header",
      "content": "Introduction Content"
    },
    {
      "type": "richtext",
      "id": "intro_text_content",
      "label": "Introduction Text Box",
      "info": "Additional text content below the introduction"
    },
    {
      "type": "image_picker",
      "id": "intro_image",
      "label": "Introduction Image"
    },
    {
      "type": "text",
      "id": "intro_image_alt",
      "label": "Introduction Image Alt Text",
      "default": "Philosophy Introduction"
    },
    {
      "type": "range",
      "id": "intro_image_height",
      "label": "Introduction Image Height (px)",
      "min": 200,
      "max": 600,
      "step": 50,
      "default": 300,
      "info": "Leave empty for auto height"
    },
    {
      "type": "header",
      "content": "Highlight Section"
    },
    {
      "type": "image_picker",
      "id": "philosophy_bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "philosophy_highlight_title",
      "label": "Highlight Title",
      "default": "Zen in Every Detail"
    },
    {
      "type": "textarea",
      "id": "philosophy_highlight_text",
      "label": "Highlight Text",
      "default": "Our philosophy isn't just words—it's woven into every thread, carved into every surface, and blessed into every creation."
    },
    {
      "type": "header",
      "content": "Bottom Images"
    },
    {
      "type": "image_picker",
      "id": "bottom_image_desktop",
      "label": "Bottom Image (Desktop)",
      "info": "Image displayed on desktop and tablet devices"
    },
    {
      "type": "image_picker",
      "id": "bottom_image_mobile",
      "label": "Bottom Image (Mobile)",
      "info": "Image displayed on mobile devices"
    },
    {
      "type": "text",
      "id": "bottom_image_alt",
      "label": "Desktop Image Alt Text",
      "default": "Our Philosophy"
    },
    {
      "type": "text",
      "id": "bottom_image_mobile_alt",
      "label": "Mobile Image Alt Text",
      "info": "Leave empty to use desktop alt text"
    },
    {
      "type": "range",
      "id": "bottom_image_height",
      "label": "Desktop Image Height (px)",
      "min": 200,
      "max": 800,
      "step": 50,
      "default": 400
    },
    {
      "type": "range",
      "id": "bottom_image_mobile_height",
      "label": "Mobile Image Height (px)",
      "min": 200,
      "max": 600,
      "step": 50,
      "default": 300,
      "info": "Leave empty to use desktop height"
    },
    {
      "type": "header",
      "content": "Text Content Section"
    },
    {
      "type": "text",
      "id": "text_content_title",
      "label": "Text Content Title",
      "default": "Our Commitment"
    },
    {
      "type": "richtext",
      "id": "text_content_body",
      "label": "Text Content Body",
      "default": "<p>At AlmaZen, we believe that true wellness comes from harmony between mind, body, and spirit. Every product we create is designed to support this balance, bringing peace and mindfulness into your daily life.</p>"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Text Font Size (px)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "text_wrap_enabled",
      "label": "Enable Text Wrapping",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "philosophy_principle",
      "name": "Philosophy Principle",
      "settings": [
        {
          "type": "text",
          "id": "principle_title",
          "label": "Principle Title"
        },
        {
          "type": "textarea",
          "id": "principle_description",
          "label": "Principle Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Philosophy"
    }
  ]
}
{% endschema %}
