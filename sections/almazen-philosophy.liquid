{% comment %}
  AlmaZen Our Philosophy Section
{% endcomment %}

<style>
  .almazen-philosophy {
    padding: 5rem 1.5rem;
    background: white;
  }
  
  .almazen-philosophy .container {
    max-width: 80rem;
    margin: 0 auto;
  }
  
  .almazen-philosophy .section-header {
    text-align: center;
    margin-bottom: 4rem;
    animation: slideUp 0.6s ease-out;
  }
  
  .almazen-philosophy .section-title {
    font-size: 2.5rem;
    font-family: 'Noto Serif', serif;
    font-weight: 300;
    color: #4a3f32;
    margin-bottom: 1.5rem;
  }
  
  .almazen-philosophy .section-divider {
    width: 4rem;
    height: 2px;
    background: #5a7c5a;
    margin: 0 auto 2rem;
  }
  
  .almazen-philosophy .section-intro {
    font-size: 1.125rem;
    color: #8b7d68;
    max-width: 48rem;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  /* 新增的文本框和图片样式 */
  .almazen-philosophy .intro-content {
    max-width: 80rem;
    margin: 0 auto 2rem;
  }

  .almazen-philosophy .intro-text {
    background: #faf9f7;
    border-radius: 0.75rem;
    padding: 2rem;
    margin-bottom: 2rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
  }

  .almazen-philosophy .intro-text:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(45, 36, 27, 0.1);
  }

  .almazen-philosophy .intro-text-content {
    color: #8b7d68;
    line-height: 1.6;
    font-size: 1rem;
  }

  .almazen-philosophy .intro-image-container {
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    margin: 0 auto;
  }

  .almazen-philosophy .intro-image-container:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  .almazen-philosophy .intro-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  
  .almazen-philosophy .principles-grid {
    display: grid;
    gap: 2rem;
    margin-bottom: 4rem;
    grid-template-columns: repeat(var(--principle-count, 1), 1fr);
  }
  
  @media (max-width: 768px) {
    .almazen-philosophy .principles-grid {
      grid-template-columns: 1fr;
    }
  }
  
  .almazen-philosophy .principle-card {
    text-align: center;
    background: #faf9f7;
    border-radius: 0.75rem;
    padding: 2rem;
    transition: all 0.3s ease;
    transform: translateY(0);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }
  
  .almazen-philosophy .principle-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 60px rgba(45, 36, 27, 0.15);
  }
  
  .almazen-philosophy .principle-icon {
    width: 4rem;
    height: 4rem;
    background: linear-gradient(135deg, #7d9a7d, #8b7d68);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    transition: transform 0.3s ease;
  }
  
  .almazen-philosophy .principle-card:hover .principle-icon {
    transform: scale(1.1);
  }
  
  .almazen-philosophy .principle-title {
    font-size: 1.25rem;
    font-family: 'Noto Serif', serif;
    color: #4a3f32;
    margin-bottom: 1rem;
  }
  
  .almazen-philosophy .principle-description {
    color: #8b7d68;
    line-height: 1.6;
  }
  
  .almazen-philosophy .highlight-section {
    position: relative;
  }
  
  .almazen-philosophy .highlight-bg {
    height: 24rem;
    border-radius: 1rem;
    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  
  .almazen-philosophy .highlight-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    border-radius: 1rem;
  }
  
  .almazen-philosophy .highlight-content {
    position: relative;
    z-index: 10;
    text-align: center;
    color: white;
    padding: 0 1.5rem;
  }
  
  .almazen-philosophy .highlight-title {
    font-size: 1.875rem;
    font-family: 'Noto Serif', serif;
    font-weight: 300;
    margin-bottom: 1rem;
  }
  
  .almazen-philosophy .highlight-text {
    font-size: 1.125rem;
    opacity: 0.9;
    max-width: 32rem;
    margin: 0 auto;
  }
  
  .almazen-philosophy .text-section {
    margin: 4rem 0;
    text-align: center;
  }
  
  .almazen-philosophy .text-content {
    width: 100%;
    margin: 0 auto;
    padding: 2rem;
    background: #faf9f7;
    border-radius: 0.75rem;
    transition: all 0.3s ease;
    transform: translateY(0);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
  }
  
  .almazen-philosophy .text-content:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 60px rgba(45, 36, 27, 0.15);
  }
  
  .almazen-philosophy .text-title {
    font-size: 1.875rem;
    font-family: 'Noto Serif', serif;
    color: #4a3f32;
    margin-bottom: 1rem;
  }
  
  .almazen-philosophy .text-body {
    color: #8b7d68;
    line-height: 1.6;
  }
  
  .almazen-philosophy .text-body.wrap-enabled {
    white-space: pre-line;
    word-wrap: break-word;
  }
  
  .almazen-philosophy .text-body.wrap-disabled {
    white-space: normal;
    word-wrap: break-word;
  }
  
  .almazen-philosophy .text-body p {
    margin-bottom: 1rem;
  }
  
  .almazen-philosophy .text-body p:last-child {
    margin-bottom: 0;
  }
  
  .almazen-philosophy .text-body ul,
  .almazen-philosophy .text-body ol {
    margin-bottom: 1rem;
    padding-left: 2rem;
  }
  
  .almazen-philosophy .text-body li {
    margin-bottom: 0.5rem;
  }
  
  .almazen-philosophy .text-body h1,
  .almazen-philosophy .text-body h2,
  .almazen-philosophy .text-body h3,
  .almazen-philosophy .text-body h4,
  .almazen-philosophy .text-body h5,
  .almazen-philosophy .text-body h6 {
    color: #4a3f32;
    margin-bottom: 1rem;
    font-family: 'Noto Serif', serif;
  }
  
  .almazen-philosophy .bottom-image-section {
    margin-top: 4rem;
    text-align: center;
  }
  
  .almazen-philosophy .bottom-image-container {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    margin: 0 auto;
  }
  
  .almazen-philosophy .bottom-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* 响应式图片显示 */
  .almazen-philosophy .bottom-image-desktop {
    display: block;
  }

  .almazen-philosophy .bottom-image-mobile {
    display: none;
  }
  
  .almazen-philosophy .bottom-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.1) 100%);
  }
  
  @media (min-width: 768px) {
    .almazen-philosophy .section-title {
      font-size: 3rem;
    }
    .almazen-philosophy .highlight-title {
      font-size: 2.25rem;
    }
    .almazen-philosophy .highlight-text {
      font-size: 1.25rem;
    }
  }
  
  @media (min-width: 1024px) {
    .almazen-philosophy {
      padding: 5rem 3rem;
    }
  }
  
  @media (max-width: 768px) {
    .almazen-philosophy .principles-grid {
      grid-template-columns: 1fr;
    }
    .almazen-philosophy .highlight-bg {
      background-attachment: scroll;
    }
    .almazen-philosophy .intro-text {
      padding: 1.5rem;
    }
    
    /* 移动端显示移动端图片 */
    .almazen-philosophy .bottom-image-desktop {
      display: none;
    }

    .almazen-philosophy .bottom-image-mobile {
      display: block;
    }
  }
  
  @media (min-width: 769px) and (max-width: 1024px) {
    .almazen-philosophy .principles-grid {
      grid-template-columns: repeat(var(--principle-count, 1), 1fr);
    }
  }
  
  @keyframes slideUp {
    0% { transform: translateY(30px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }
</style>

<section id="philosophy" class="almazen-philosophy">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        {{ section.settings.philosophy_title | default: 'Our Philosophy' }}
      </h2>
      <div class="section-divider"></div>
      <p class="section-intro">
        {{ section.settings.philosophy_intro }}
      </p>
      
      <!-- 新增的文本框和图片 -->
      <div class="intro-content">
        {% if section.settings.intro_text_content != blank %}
          <div class="intro-text">
            <div class="intro-text-content">
              {{ section.settings.intro_text_content }}
            </div>
          </div>
        {% endif %}
        
        {% if section.settings.intro_image %}
          <div class="intro-image-container" 
               style="width: {{ section.settings.intro_image_width }}%; height: {{ section.settings.intro_image_height }}vh;">
            <img 
              src="{{ section.settings.intro_image | image_url: width: 1200 }}" 
              alt="{{ section.settings.intro_image_alt | default: 'Philosophy Introduction' }}"
              class="intro-image"
              loading="lazy"
            >
          </div>
        {% endif %}
      </div>
    </div>

    <div class="principles-grid">
      {% for block in section.blocks %}
        {% if block.type == 'philosophy_principle' %}
          <div class="principle-card">
            {% comment %} <div class="principle-icon">
              <i class="fas {{ block.settings.principle_icon }}" style="color: white; font-size: 1.25rem;"></i>
            </div> {% endcomment %}
            <h3 class="principle-title">{{ block.settings.principle_title }}</h3>
            <p class="principle-description">{{ block.settings.principle_description }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.philosophy_bg_image %}
      <div class="highlight-section">
        <div 
          class="highlight-bg"
          style="background-image: url('{{ section.settings.philosophy_bg_image | image_url: width: 2048 }}');"
        >
          <div class="highlight-overlay"></div>
          <div class="highlight-content">
            <h3 class="highlight-title">
              {{ section.settings.philosophy_highlight_title }}
            </h3>
            <p class="highlight-text">
              {{ section.settings.philosophy_highlight_text }}
            </p>
          </div>
        </div>
      </div>
    {% endif %}
    
    {% if section.settings.text_content_title != blank or section.settings.text_content_body != blank %}
      <div class="text-section">
        <div class="text-content">
          {% if section.settings.text_content_title != blank %}
            <h3 class="text-title">{{ section.settings.text_content_title }}</h3>
          {% endif %}
          {% if section.settings.text_content_body != blank %}
            <div 
              class="text-body {% if section.settings.text_wrap_enabled %}wrap-enabled{% else %}wrap-disabled{% endif %}"
              style="font-size: {{ section.settings.text_font_size }}px;"
            >
              {{ section.settings.text_content_body }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
    
    {% if section.settings.bottom_image_desktop or section.settings.bottom_image_mobile %}
      <div class="bottom-image-section">
        <div class="bottom-image-container" 
             style="width: {{ section.settings.bottom_image_width }}%; height: {{ section.settings.bottom_image_height }}vh;">
          <!-- PC端图片 -->
          {% if section.settings.bottom_image_desktop %}
            <img 
              src="{{ section.settings.bottom_image_desktop | image_url: width: 2048 }}" 
              alt="{{ section.settings.bottom_image_alt | default: 'Our Philosophy' }}"
              class="bottom-image bottom-image-desktop"
              loading="lazy"
            >
          {% endif %}
          
          <!-- 移动端图片 -->
          {% if section.settings.bottom_image_mobile %}
            <img 
              src="{{ section.settings.bottom_image_mobile | image_url: width: 768 }}" 
              alt="{{ section.settings.bottom_image_mobile_alt | default: section.settings.bottom_image_alt | default: 'Our Philosophy' }}"
              class="bottom-image bottom-image-mobile"
              loading="lazy"
            >
          {% endif %}
          
          <div class="bottom-image-overlay"></div>
        </div>
      </div>
    {% endif %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const principlesGrid = document.querySelector('.almazen-philosophy .principles-grid');
    if (principlesGrid) {
      const principleCount = principlesGrid.children.length;
      principlesGrid.style.setProperty('--principle-count', principleCount);
    }
  });
</script>

{% schema %}
{
  "name": "Our Philosophy",
  "settings": [
    {
      "type": "text",
      "id": "philosophy_title",
      "label": "Section Title",
      "default": "Our Philosophy"
    },
    {
      "type": "textarea",
      "id": "philosophy_intro",
      "label": "Introduction Text",
      "default": "Deeply rooted in Zen principles, our philosophy guides every aspect of AlmaZen, from product creation to community building."
    },
    {
      "type": "header",
      "content": "Introduction Content"
    },
    {
      "type": "richtext",
      "id": "intro_text_content",
      "label": "Introduction Text Box",
      "info": "Additional text content below the introduction"
    },
    {
      "type": "image_picker",
      "id": "intro_image",
      "label": "Introduction Image"
    },
    {
      "type": "text",
      "id": "intro_image_alt",
      "label": "Introduction Image Alt Text",
      "default": "Philosophy Introduction"
    },
    {
      "type": "range",
      "id": "intro_image_width",
      "label": "Introduction Image Width (%)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 80,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "intro_image_height",
      "label": "Introduction Image Height (vh)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "vh",
      "info": "Viewport height percentage"
    },
    {
      "type": "header",
      "content": "Highlight Section"
    },
    {
      "type": "image_picker",
      "id": "philosophy_bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "philosophy_highlight_title",
      "label": "Highlight Title",
      "default": "Zen in Every Detail"
    },
    {
      "type": "textarea",
      "id": "philosophy_highlight_text",
      "label": "Highlight Text",
      "default": "Our philosophy isn't just words—it's woven into every thread, carved into every surface, and blessed into every creation."
    },
    {
      "type": "header",
      "content": "Bottom Images"
    },
    {
      "type": "image_picker",
      "id": "bottom_image_desktop",
      "label": "Bottom Image (Desktop)",
      "info": "Image displayed on desktop and tablet devices"
    },
    {
      "type": "image_picker",
      "id": "bottom_image_mobile",
      "label": "Bottom Image (Mobile)",
      "info": "Image displayed on mobile devices"
    },
    {
      "type": "text",
      "id": "bottom_image_alt",
      "label": "Desktop Image Alt Text",
      "default": "Our Philosophy"
    },
    {
      "type": "text",
      "id": "bottom_image_mobile_alt",
      "label": "Mobile Image Alt Text",
      "info": "Leave empty to use desktop alt text"
    },
    {
      "type": "range",
      "id": "bottom_image_width",
      "label": "Bottom Image Width (%)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 100,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "bottom_image_height",
      "label": "Bottom Image Height (vh)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 50,
      "unit": "vh",
      "info": "Viewport height percentage"
    },
    {
      "type": "header",
      "content": "Text Content Section"
    },
    {
      "type": "text",
      "id": "text_content_title",
      "label": "Text Content Title",
      "default": "Our Commitment"
    },
    {
      "type": "richtext",
      "id": "text_content_body",
      "label": "Text Content Body",
      "default": "<p>At AlmaZen, we believe that true wellness comes from harmony between mind, body, and spirit. Every product we create is designed to support this balance, bringing peace and mindfulness into your daily life.</p>"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "Text Font Size (px)",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 18
    },
    {
      "type": "checkbox",
      "id": "text_wrap_enabled",
      "label": "Enable Text Wrapping",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "philosophy_principle",
      "name": "Philosophy Principle",
      "settings": [
        {
          "type": "text",
          "id": "principle_title",
          "label": "Principle Title"
        },
        {
          "type": "textarea",
          "id": "principle_description",
          "label": "Principle Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Philosophy"
    }
  ]
}
{% endschema %}
