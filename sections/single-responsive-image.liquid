{% comment %} 单张响应式图片模块（含顶部标题区域） - 支持后台配置宽高/边距/标题，适配手机端 {% endcomment %}
<div class="single-responsive-image-module" 
     style="
       margin-top: {{ section.settings.margin_top }}px; /* 后台配置上外边距 */
       margin-bottom: {{ section.settings.margin_bottom }}px; /* 后台配置下外边距 */
       padding: {{ section.settings.padding }}px; /* 后台配置内边距 */
       max-width: 100%;
       box-sizing: border-box;
     ">
  {% comment %} 标题区域（已整合到模块顶部） {% endcomment %}
  <div class="sustainable-manufacturing-header">
    {% if section.settings.title != blank %}
      <h2 class="sustainable-manufacturing-title">{{ section.settings.title }}</h2>
    {% endif %}
    {% if section.settings.description != blank %}
      <p class="sustainable-manufacturing-description">{{ section.settings.description }}</p>
    {% endif %}
  </div>

  {% if section.settings.image != blank %}
    {% comment %} 核心：图片渲染 + 响应式样式 {% endcomment %}
    <img 
      src="{{ section.settings.image | image_url: width: section.settings.image_width, height: section.settings.image_height }}" 
      alt="{{ section.settings.image.alt | default: 'Custom Image' }}"
      class="single-responsive-image-module__img"
      style="
        width: {{ section.settings.image_width }}px;
        height: {{ section.settings.image_height }}px;
        object-fit: contain; /* 图片完整显示，不变形（推荐） */
        display: block;
        margin: 0 auto; /* 图片水平居中 */
        margin-top: 20px; /* 标题与图片之间增加间距，避免重叠 */
      "
    >
  {% else %}
    {% comment %} 无图片时的占位框 {% endcomment %}
    <div class="single-responsive-image-placeholder"
         style="
           width: {{ section.settings.image_width }}px;
           height: {{ section.settings.image_height }}px;
           background: #f5f5f5;
           display: flex;
           align-items: center;
           justify-content: center;
           color: #999;
           margin: 0 auto;
           margin-top: 20px; /* 标题与占位框之间增加间距 */
         ">
      请上传图片
    </div>
  {% endif %}
</div>

{% comment %} 后台配置项（Schema）- 补充标题/描述/描述字体大小配置 {% endcomment %}
{% schema %}
{
  "name": "单张响应式图片（带标题）",
  "tag": "section",
  "class": "single-responsive-image-section",
  "settings": [
    {
      "type": "header",
      "content": "标题配置"
    },
    {
      "type": "text",
      "id": "title",
      "label": "模块标题",
      "default": "自定义图片标题"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "模块描述",
      "default": "这里可以填写图片的补充说明文字"
    },
    {
      "type": "range", // 用range更方便后台调整字体大小
      "id": "descriptionsize",
      "label": "描述字体大小（px）",
      "min": 14,
      "max": 20,
      "step": 1,
      "default": 16
    },
    {
      "type": "header",
      "content": "图片配置"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "上传图片"
    },
    {
      "type": "number",
      "id": "image_width",
      "label": "图片宽度（px）",
      "default": 300
    },
    {
      "type": "number",
      "id": "image_height",
      "label": "图片高度（px）",
      "default": 200
    },
    {
      "type": "header",
      "content": "间距配置"
    },
    {
      "type": "number",
      "id": "margin_top",
      "label": "模块上外边距（px）",
      "default": 20
    },
    {
      "type": "number",
      "id": "margin_bottom",
      "label": "模块下外边距（px）",
      "default": 20
    },
    {
      "type": "number",
      "id": "padding",
      "label": "模块内边距（px）",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "单张响应式图片（带标题）"
    }
  ]
}
{% endschema %}

{% comment %} 响应式样式（修正后，包含你的自定义样式） {% endcomment %}
{% style %}
/* 标题区域基础样式 */
.sustainable-manufacturing-header {
  text-align: center;
  margin-bottom: 20px;
}

.sustainable-manufacturing-title {
  font-size: 40px;
  font-weight: 500;
  color: #161616;
  margin: 0 0 20px;
  line-height: 1.2;
}

.sustainable-manufacturing-description {
  font-size: {{ section.settings.descriptionsize }}px;
  color: rgba(22, 22, 22, 0.5);
  line-height: 1.6;
  max-width: 940px;
  margin: 0 auto;
}

/* 媒体查询：修正英文符号，规范嵌套/并列格式 */
@media (max-width: 768px) {
  .sustainable-manufacturing-title {
    font-size: 30px;
  }

  .sustainable-manufacturing-description {
    font-size: {{ section.settings.descriptionsize | minus: 2 }}px;
  }
}

/* 媒体查询：480px 并列布局（更规范，也可嵌套在768px内） */
@media (max-width: 480px) {
  .sustainable-manufacturing-title {
    font-size: 27px;
  }

  .sustainable-manufacturing-description {
    font-size: {{ section.settings.descriptionsize | minus: 3 }}px;
  }
}

/* 手机端适配：图片样式 */
@media (max-width: 768px) {
  .single-responsive-image-module__img {
    width: 100% !important; /* 图片宽度占满容器 */
    height: auto !important; /* 高度自动，避免变形 */
    max-width: {{ section.settings.image_width }}px; /* 最大不超过后台设置的宽度 */
  }
  .single-responsive-image-placeholder {
    width: 100% !important;
    height: auto !important;
    min-height: 150px; /* 占位框最小高度，避免太矮 */
  }
}
{% endstyle %}