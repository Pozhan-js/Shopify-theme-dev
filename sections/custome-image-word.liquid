

{% schema %}
{
  "name": "图文区块",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "标题",
      "default": "区块标题"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "内容",
      "default": "<p>在这里输入您的富文本内容</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "图片"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "图片位置",
      "options": [
        {
          "value": "top",
          "label": "富文本上方"
        },
        {
          "value": "bottom",
          "label": "富文本下方"
        }
      ],
      "default": "top"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "图片宽度",
      "default": 100
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "图片与文本间距",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "图文区块"
    }
  ]
}
{% endschema %}

<style>
  .image-text-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: {{ section.settings.spacing }}px;
    padding: 40px 0;
  }

  .image-content {
    width: {{ section.settings.image_width }}%;
    order: {% if section.settings.image_position == 'top' %}1{% else %}3{% endif %};
  }

  .image-content img {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .text-content {
    width: 100%;
    order: 2;
  }

  .section-heading {
    font-size: 2rem;
    margin-bottom: 20px;
  }

  @media screen and (max-width: 749px) {
    .image-content {
      width: 100%;
    }
    
    .image-text-container {
      padding: 20px 0;
      gap: 15px;
    }
  }
</style>

<div class="image-text-container">
  <div class="image-content">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 800 }}"
        alt="{{ section.settings.heading | escape }}"
        loading="lazy"
        width="800"
        height="{{ 800 | divided_by: section.settings.image.aspect_ratio | round }}"
      >
    {%- endif -%}
  </div>

  <div class="text-content">
    <h2 class="section-heading">{{ section.settings.heading }}</h2>
    <div class="rte">
      {{ section.settings.text }}
    </div>
  </div>
</div>
