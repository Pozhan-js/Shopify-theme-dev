{
  "name": "视频轮播",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "标题",
      "default": "精彩视频展示"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "视频",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "选择视频"
        },
        {
          "type": "text",
          "id": "video_title",
          "label": "视频标题"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "视频轮播",
      "category": "媒体",
      "blocks": [
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" },
        { "type": "video" }
      ]
    }
  ]
}
{% endschema %}
