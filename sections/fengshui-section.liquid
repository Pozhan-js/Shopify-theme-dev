{% schema %}
{
  "name": "风水布置区块",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "风水装饰品图片"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述内容",
      "default": "<p>Feng Shui: The ancient art of harmonizing energy flow. Scientifically balance your space, enhance environmental vibes, and elevate daily life with natural vitality.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "按钮文字",
      "default": "Unlock Custom Feng Shui Solution"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "按钮链接"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景颜色",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "文字颜色",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "风水布置区块",
      "category": "自定义区块"
    }
  ]
}
{% endschema %}

<div class="fengshui-section">
  <div class="page-width">
    <div class="fengshui-compact-layout">
      {% if section.settings.image != blank %}
        <div class="fengshui-image-wrapper">
          <img
            src="{{ section.settings.image | image_url: width: 400 }}"
            alt="风水装饰品"
            class="fengshui-image"
            width="400"
            height="auto"
            loading="lazy"
          >
        </div>
      {% endif %}
      
      <div class="fengshui-text-content">
        {{ section.settings.description }}
      </div>
      
      {% if section.settings.button_text != blank %}
        <div class="fengshui-button-wrapper">
          <a href="{{ section.settings.button_link }}" class="fengshui-button">
            {{ section.settings.button_text }}
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<style>
  .fengshui-section {
    padding: 60px 0;
    background: {{ section.settings.bg_color }};
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .page-width {
    width: 100%;
  }

  .fengshui-compact-layout {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 30px;
  }

  .fengshui-image-wrapper,
  .fengshui-text-content,
  .fengshui-button-wrapper {
    margin: 0 !important;
    padding: 0 !important;
  }

  .fengshui-image {
    width: 100%;
    max-width: 400px;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  }

  .fengshui-text-content {
    font-size: 1.5rem;
    line-height: 1.8;
    color: {{ section.settings.text_color }};
    max-width: 800px;
  }

  .fengshui-button {
    background-color: transparent;
    color: {{ section.settings.text_color }};
    padding: 12px 30px;
    border: 2px solid {{ section.settings.text_color }};
    border-radius: 4px;
    font-size: 1.5rem;
    transition: all 0.3s ease;
    text-decoration: none;
    --border-opacity: transparent;
  }

  .fengshui-button:hover {
    background-color: {{ section.settings.text_color }};
    color: {{ section.settings.bg_color }};
    border-color: {{ section.settings.text_color }};
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .fengshui-section {
      padding: 30px 20px;
      min-height: auto;
    }
    
    .fengshui-compact-layout {
      padding: 0 20px;
    }
    
    .fengshui-image {
      max-width: 300px;
    }
    
    .fengshui-text-content {
      font-size: 1.3rem;
    }
  }
</style>
