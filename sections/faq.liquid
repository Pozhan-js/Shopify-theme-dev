<!-- FAQ Section -->
<section class="faq-section">
  <div class="container">
    {% if section.settings.faq_title != blank %}
      <h2 class="faq-title">{{ section.settings.faq_title }}</h2>
    {% endif %}
    
    <div class="faq-content">
      <div class="faq-list">
        {% for block in section.blocks %}
          {% if block.type == 'faq_item' %}
            <div class="faq-item" {{ block.shopify_attributes }}>
              <div class="faq-question" onclick="toggleFaq(this)">
                <h3>{{ block.settings.question }}</h3>
                <span class="faq-icon">+</span>
              </div>
              <div class="faq-answer">
                <div class="faq-answer-content">
                  {{ block.settings.answer }}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<style>
.faq-section {
  padding: 20px 0;
  background-color: {{ section.settings.background_color }};
}

.container {
  max-width: 1000px;
  margin: 0 auto;
  padding: 0 40px;
}

.faq-title {
  font-family: Georgia, serif;
  text-align: center;
  font-weight: normal;
  font-size: 3rem;
  color: {{ section.settings.title_color }};
  margin-bottom: 20px;
  letter-spacing: 2px;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.faq-item {
  border-bottom: 1px solid {{ section.settings.divider_color }};
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-question {
  padding: 12px 0;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: transparent;
  transition: opacity 0.2s ease;
}

.faq-question:hover {
  opacity: 0.7;
}

.faq-question h3 {
  margin: 0;
  font-size: 1.1rem;
  font-weight: 400;
  flex: 1;
  padding-right: 20px;
  color: {{ section.settings.question_color }};
  text-transform: lowercase;
  line-height: 1.6;
}

.faq-icon {
  font-size: 1.5rem;
  font-weight: 300;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  min-width: 30px;
  text-align: center;
  color: {{ section.settings.icon_color }};
  will-change: transform;
}

/* 使用 grid 实现流畅的展开动画 */
.faq-answer {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  will-change: grid-template-rows;
}

.faq-answer-content {
  overflow: hidden;
  padding: 0;
  color: {{ section.settings.answer_color }};
  font-size: 0.9rem;
  line-height: 1.6;
}

.faq-item.active .faq-answer {
  grid-template-rows: 1fr;
}

.faq-item.active .faq-answer-content {
  padding: 0 0 15px 0;
}

.faq-item.active .faq-icon {
  transform: rotate(45deg);
}

/* 响应式设计 */
@media (max-width: 768px) {
  .faq-section {
    padding: 60px 0;
  }
  
  .container {
    padding: 0 20px;
  }
  
  .faq-title {
    font-size: 2rem;
    margin-bottom: 40px;
  }
  
  .faq-question {
    padding: 12px 0;
  }
  
  .faq-question h3 {
    font-size: 1rem;
  }
  
  .faq-item.active .faq-answer-content {
    padding: 0 0 12px 0;
    font-size: 0.85rem;
  }
}

@media (max-width: 480px) {
  .faq-section {
    padding: 40px 0;
  }
  
  .container {
    padding: 0 15px;
  }
  
  .faq-title {
    font-size: 1.5rem;
    margin-bottom: 30px;
  }
  
  .faq-question {
    padding: 10px 0;
  }
  
  .faq-question h3 {
    font-size: 0.95rem;
  }
  
  .faq-item.active .faq-answer-content {
    padding: 0 0 10px 0;
    font-size: 0.8rem;
  }
}
</style>

<script>
function toggleFaq(element) {
  const faqItem = element.parentElement;
  const isActive = faqItem.classList.contains('active');
  
  // 使用 requestAnimationFrame 优化性能
  requestAnimationFrame(() => {
    if (isActive) {
      faqItem.classList.remove('active');
      element.setAttribute('aria-expanded', 'false');
    } else {
      faqItem.classList.add('active');
      element.setAttribute('aria-expanded', 'true');
    }
  });
}

// 键盘访问性支持
document.addEventListener('DOMContentLoaded', function() {
  const faqQuestions = document.querySelectorAll('.faq-question');
  
  faqQuestions.forEach(question => {
    question.setAttribute('tabindex', '0');
    question.setAttribute('role', 'button');
    question.setAttribute('aria-expanded', 'false');
    
    question.addEventListener('keydown', function(e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleFaq(this);
      }
    });
  });
});
</script>

{% schema %}
{
  "name": "FAQ Section",
  "tag": "section",
  "class": "faq-section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "faq_title",
