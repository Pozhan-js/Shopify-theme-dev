      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "default": "#AA848D"
    },
    {
      "type": "color",
      "id": "question_color",
      "label": "问题颜色",
      "default": "#AA848D"
    },
    {
      "type": "color",
