{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* 相关产品样式 */
  .related-products {
    position: relative;
  }

  .related-products__heading {
    margin-bottom: 30px;
    text-align: center;
  }

  .related-products__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    align-items: stretch;
  }

  @media (min-width: 750px) {
    .related-products__grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  @media (max-width: 749px) {
    .related-products__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    }
  }

  /* 产品卡片样式 */
  .related-product-card {
    background: #ffffff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .related-product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
  }

  .related-product-card__image {
    position: relative;
    aspect-ratio: 1/1;
    overflow: hidden;
    background: #f5f5f5;
  }

  .related-product-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .related-product-card:hover .related-product-card__image img {
    transform: scale(1.05);
  }

  .related-product-card__content {
    padding: 16px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .related-product-card__vendor {
    font-size: 13px;
    color: #666;
    margin-bottom: 4px;
    flex-shrink: 0;
  }

  .related-product-card__title {
    font-size: 16px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 8px 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.8em;
  }

  .related-product-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .related-product-card__title a:hover {
    color: #871d16;
  }

  .related-product-card__price {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    margin-top: auto;
  }

  .related-product-card__current-price {
    font-size: 18px;
    font-weight: 700;
    color: #1a1a1a;
  }

  .related-product-card__original-price {
    font-size: 14px;
    color: #999;
    text-decoration: line-through;
  }

  .related-product-card__add-to-cart {
    width: 100%;
    background: #871d16;
    color: white;
    border: none;
    padding: 10px 16px;
    /* border-radius: 6px; */
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: auto;
  }

  .related-product-card__add-to-cart:hover {
    background: #6b1611;
  }

  .related-product-card__add-to-cart:disabled {
    background: #ccc;
    cursor: not-allowed;
  }

  .related-products__empty {
    text-align: center;
    padding: 60px 0;
  }

  .related-products__empty-title {
    font-size: 24px;
    color: #666;
    margin-bottom: 10px;
  }

  .related-products__empty-text {
    font-size: 16px;
    color: #999;
  }

  /* 图片形状样式 */
  {% if section.settings.image_shape == 'arch' %}
    .related-product-card__image {
      mask: url('{{ 'mask-arch.svg' | asset_url }}') center/contain no-repeat;
      -webkit-mask: url('{{ 'mask-arch.svg' | asset_url }}') center/contain no-repeat;
    }
  {% elsif section.settings.image_shape == 'blob' %}
    .related-product-card__image {
      mask: url('{{ 'mask-blobs.css' | asset_url }}') center/contain no-repeat;
      -webkit-mask: url('{{ 'mask-blobs.css' | asset_url }}') center/contain no-repeat;
    }
  {% endif %}
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="related-products page-width section-{{ section.id }}-padding isolate{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <product-recommendations
      class="related-products__container"
      data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}"
      data-section-id="{{ section.id }}"
      data-product-id="{{ product.id }}"
    >
      {% if recommendations.performed and recommendations.products_count > 0 %}
        <h2
          class="related-products__heading inline-richtext {{ section.settings.heading_size }}"
          style="color: {{ section.settings.title_color }};"
        >
          {{ section.settings.heading }}
        </h2>

        <ul class="related-products__grid" role="list">
          {% for recommendation in recommendations.products %}
            <li class="related-products__item">
              <div class="related-product-card">
                <a href="{{ recommendation.url }}" class="related-product-card__image">
                  {% if recommendation.featured_image %}
                    <img
                      src="{{ recommendation.featured_image | img_url: '300x300' }}"
                      alt="{{ recommendation.title }}"
                      loading="lazy"
                      {% if section.settings.image_shape != 'default' %}
                        style="object-fit: cover;"
                      {% endif %}
                    >
                  {% else %}
                    <div style="background: #f5f5f5; height: 100%; display: flex; align-items: center; justify-content: center;">
                      <span style="color: #999; font-size: 14px;">No Image</span>
                    </div>
                  {% endif %}
                </a>

                <div class="related-product-card__content">
                  {% if section.settings.show_vendor and recommendation.vendor != blank %}
                    <div class="related-product-card__vendor">{{ recommendation.vendor }}</div>
                  {% endif %}

                  <h3 class="related-product-card__title">
                    <a href="{{ recommendation.url }}">{{ recommendation.title }}</a>
                  </h3>

                  <div class="related-product-card__price">
                    <span class="related-product-card__current-price">{{ recommendation.price | money }}</span>
                    {% if recommendation.compare_at_price > recommendation.price %}
                      <span class="related-product-card__original-price">
                        {{- recommendation.compare_at_price | money -}}
                      </span>
                    {% endif %}
                  </div>

                  {% if section.settings.show_rating and recommendation.metafields.reviews.rating.value %}
                    <div class="related-product-card__rating">
                      {% render 'rating', rating: recommendation.metafields.reviews.rating.value, size: 'small' %}
                    </div>
                  {% endif %}

                  <button
                    class="related-product-card__add-to-cart"
                    onclick="addRelatedToCart({{ recommendation.selected_or_first_available_variant.id }}, '{{ recommendation.title | escape }}')"
                    {% unless recommendation.available %}
                      disabled
                    {% endunless %}
                  >
                    {%- if recommendation.available -%}
                      Add to Cart
                    {%- else -%}
                      Sold Out
                    {%- endif -%}
                  </button>
                </div>
              </div>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <div class="related-products__empty">
          <h2 class="related-products__empty-title">{{ section.settings.heading }}</h2>
          <p class="related-products__empty-text">No related products found.</p>
        </div>
      {% endif %}
    </product-recommendations>
  </div>
</div>

<script>
  // 添加到购物车功能 - 无alert版本
  function addRelatedToCart(variantId, productTitle) {
    event.preventDefault();

    const button = event.target;
    const originalText = button.textContent;

    // 显示加载状态
    button.textContent = 'Adding...';
    button.disabled = true;
    button.style.background = '#6b1611';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Accept: 'application/json',
      },
      body: JSON.stringify({
        id: variantId,
        quantity: 1,
      }),
    })
      .then((response) => response.json())
      .then((data) => {
        // 成功反馈 - 按钮状态变化
        button.textContent = 'Added!';
        button.style.background = '#28a745';

        // 触发购物车更新事件
        document.dispatchEvent(
          new CustomEvent('cart:updated', {
            detail: { cart: data },
          })
        );

        // 恢复按钮状态
        setTimeout(() => {
          button.textContent = originalText;
          button.style.background = '';
          button.disabled = false;
        }, 1500);
      })
      .catch((error) => {
        console.error('Error adding to cart:', error);
        button.textContent = 'Error';
        button.style.background = '#dc3545';

        setTimeout(() => {
          button.textContent = originalText;
          button.style.background = '';
          button.disabled = false;
        }, 2000);
      });
  }

  // 监听产品推荐更新
  document.addEventListener('DOMContentLoaded', function () {
    const recommendations = document.querySelector('product-recommendations');
    if (recommendations) {
      recommendations.addEventListener('product-recommendations:loaded', function () {
        // 重新绑定添加到购物车事件
        const buttons = document.querySelectorAll('.related-product-card__add-to-cart');
        buttons.forEach((button) => {
          button.addEventListener('click', function (e) {
            e.preventDefault();
            const variantId = this.getAttribute('onclick').match(/\d+/)[0];
            const productTitle = this.getAttribute('onclick').match(/'([^']+)'/)[1];
            addRelatedToCart(variantId, productTitle);
          });
        });
      });
    }
  });
</script>

{% schema %}
{
  "name": "t:sections.related-products.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.related-products.settings.paragraph__1.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "t:sections.related-products.settings.paragraph__1.default",
      "label": "t:sections.related-products.settings.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        },
        {
          "value": "hxl",
          "label": "t:sections.all.heading_size.options__4.label"
        },
        {
          "value": "hxxl",
          "label": "t:sections.all.heading_size.options__5.label"
        }
