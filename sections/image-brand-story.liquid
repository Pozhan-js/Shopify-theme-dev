{% schema %}
{
  "name": "图片与品牌故事",
  "settings": [
    {
      "type": "header",
      "content": "左侧图片设置"
    },
    {
      "type": "image_picker",
      "id": "image_top",
      "label": "上方图片"
    },
    {
      "type": "image_picker",
      "id": "image_bottom",
      "label": "下方图片"
    },
    {
      "type": "header",
      "content": "右侧内容设置"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo图片"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "px",
      "label": "Logo宽度",
      "default": 200
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "描述文字",
      "default": "<p>在这里输入你的品牌故事或产品描述。</p>"
    },
    {
      "type": "header",
      "content": "布局设置"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "顶部间距",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "底部间距",
      "default": 60
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "图片与品牌故事"
    }
  ]
}
{% endschema %}

<style>
  .image-brand-section {
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  .image-brand-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .image-brand-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .image-brand-left {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .image-brand-left img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .image-brand-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 40px;
  }

  .image-brand-logo {
    margin-bottom: 40px;
  }

  .image-brand-logo img {
    width: {{ section.settings.logo_width }}px;
    height: auto;
    display: block;
  }

  .image-brand-description {
    font-size: 16px;
    line-height: 1.8;
    color: #333;
  }

  .image-brand-description p {
    margin-bottom: 20px;
  }

  @media screen and (max-width: 768px) {
    .image-brand-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .image-brand-right {
      padding: 20px;
    }

    .image-brand-logo {
      margin-bottom: 30px;
    }

    .image-brand-description {
      font-size: 14px;
    }
  }
</style>

<section class="image-brand-section">
  <div class="image-brand-container">
    <div class="image-brand-grid">
      <!-- 左侧图片区域 -->
      <div class="image-brand-left">
        {% if section.settings.image_top %}
          <div class="image-brand-item">
            <img 
              src="{{ section.settings.image_top | img_url: 'master' }}" 
              alt="{{ section.settings.image_top.alt | escape }}"
              loading="lazy"
            >
          </div>
        {% else %}
          <div class="image-brand-item" style="background: #f5f5f5; aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center;">
            <p style="color: #999;">上方图片</p>
          </div>
        {% endif %}

        {% if section.settings.image_bottom %}
          <div class="image-brand-item">
            <img 
              src="{{ section.settings.image_bottom | img_url: 'master' }}" 
              alt="{{ section.settings.image_bottom.alt | escape }}"
              loading="lazy"
            >
          </div>
        {% else %}
          <div class="image-brand-item" style="background: #f5f5f5; aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center;">
            <p style="color: #999;">下方图片</p>
          </div>
        {% endif %}
      </div>

      <!-- 右侧内容区域 -->
      <div class="image-brand-right">
        {% if section.settings.logo %}
          <div class="image-brand-logo">
            <img 
              src="{{ section.settings.logo | img_url: 'master' }}" 
              alt="{{ section.settings.logo.alt | escape }}"
              loading="lazy"
            >
          </div>
        {% else %}
          <div class="image-brand-logo" style="width: {{ section.settings.logo_width }}px; height: {{ section.settings.logo_width }}px; background: #f5f5f5; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
            <p style="color: #999;">Logo</p>
          </div>
        {% endif %}

        <div class="image-brand-description">
          {{ section.settings.description }}
        </div>
      </div>
    </div>
  </div>
</section>
