{%- comment -%}
------------------------------------------------------------------------------
	Section: Image with text - New Vertical Layout
	每张图片匹配一个文本框的上下布局设计
------------------------------------------------------------------------------
{%- endcomment -%}

{%- assign image_position         = section.settings.image_position -%}
{%- assign text_alignment         = section.settings.text_alignment -%}
{%- assign content_vertical_alignment = section.settings.content_vertical_alignment -%}
{%- assign heading                = section.settings.heading -%}
{%- assign subheading             = section.settings.subheading -%}
{%- assign text_content           = section.settings.text_content -%}
{%- assign button_label           = section.settings.button_label -%}
{%- assign button_aria_label      = section.settings.button_aria_label -%}
{%- assign button_url             = section.settings.button_url -%}
{%- assign button_style           = section.settings.button_style -%}

{%- assign container              = section.settings.container_width -%}

{% if container == 'inherit' %}
	{% assign container_width = settings.container_width %}
{% else %}
	{% assign container_width = container %}
{% endif %}

{%- capture section_styles -%}
	--text-alignment: {{ text_alignment | replace: "left", "start" | replace: "right", "end" }};
	--content-vertical-alignment: {{ content_vertical_alignment }};
	--container-width: {{ container_width }};
{%- endcapture -%}

{%- style -%}
	#shopify-section-{{ section.id }} {
		padding-top: {{ section.settings.offset_top_mobile }}px;
		padding-bottom: {{ section.settings.offset_bottom_mobile }}px;
	}

	@media screen and (min-width: 992px) {
		#shopify-section-{{ section.id }} {
			padding-top: {{ section.settings.offset_top_desktop }}px;
			padding-bottom: {{ section.settings.offset_bottom_desktop }}px;
		}
	}

	/* 新的上下布局样式 */
	.image-with-text-vertical {
		padding: 2rem 1.5rem;
	}

	.image-with-text-vertical__container {
		max-width: var(--container-width);
		margin: 0 auto;
	}

	.image-with-text-vertical__header {
		text-align: center;
		margin-bottom: 3rem;
	}

	.image-with-text-vertical__heading {
		font-size: 2.5rem;
		font-weight: 300;
		color: var(--color-text, #2d241b);
		margin-bottom: 1rem;
	}

	.image-with-text-vertical__subheading {
		font-size: 1.25rem;
		color: var(--color-text-light, #8b7d68);
		margin-bottom: 1.5rem;
	}

	.image-with-text-vertical__text-content {
		color: var(--color-text-light, #8b7d68);
		line-height: 1.6;
		margin-bottom: 2rem;
	}

	.image-with-text-vertical__grid {
		display: grid;
		gap: 3rem;
		margin-bottom: 3rem;
	}

	.image-text-pair {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		align-items: center;
	}

	.image-text-pair__image {
		width: 100%;
		border-radius: 0.5rem;
		box-shadow: 0 4px 20px rgba(45, 36, 27, 0.1);
		transition: transform 0.3s ease;
	}

	.image-text-pair__image:hover {
		transform: translateY(-2px);
	}

	.image-text-pair__text-area {
		width: 100%;
		max-width: 600px;
	}

	.image-text-pair__label {
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--color-text, #2d241b);
		margin-bottom: 0.5rem;
		display: block;
	}

	.image-text-pair__textarea {
		width: 100%;
		padding: 0.75rem 1rem;
		font-size: 1rem;
		font-family: inherit;
		color: var(--color-text, #2d241b);
		background-color: #ffffff;
		border: 1px solid var(--color-border, #d1c7b8);
		border-radius: 0.5rem;
		transition: all 0.3s ease;
		box-shadow: 0 2px 4px rgba(45, 36, 27, 0.05);
		resize: vertical;
		min-height: 80px;
		line-height: 1.5;
	}

	.image-text-pair__textarea:focus {
		outline: none;
		border-color: var(--color-accent, #5a7c5a);
		box-shadow: 0 0 0 3px rgba(90, 124, 90, 0.1);
	}

	.image-text-pair__textarea::placeholder {
		color: var(--color-text-light, #8b7d68);
		opacity: 0.7;
	}

	.image-with-text-vertical__button {
		margin-top: 2rem;
	}

	@media (min-width: 768px) {
		.image-with-text-vertical__heading {
			font-size: 3rem;
		}
		
		.image-with-text-vertical__subheading {
			font-size: 1.5rem;
		}
		
		.image-text-pair__textarea {
			padding: 0.875rem 1.125rem;
			font-size: 1.0625rem;
			min-height: 100px;
		}
	}

	@media (min-width: 992px) {
		.image-with-text-vertical {
			padding: 3rem 2rem;
		}
		
		.image-text-pair {
			flex-direction: row;
			align-items: flex-start;
			gap: 2rem;
		}
		
		.image-text-pair:nth-child(even) {
			flex-direction: row-reverse;
		}
		
		.image-text-pair__image {
			flex: 1;
			max-width: 50%;
		}
		
		.image-text-pair__text-area {
			flex: 1;
			max-width: 50%;
		}
	}
{%- endstyle -%}

<section class="image-with-text-vertical js-animate {% if request.visual_preview_mode or section.index == 1 %}animated{% endif %}" style="{{ section_styles }}">
	<div class="image-with-text-vertical__container">
		{%- if heading != blank or subheading != blank or text_content != blank -%}
			<div class="image-with-text-vertical__header">
				{%- if heading != blank -%}
					<h2 class="image-with-text-vertical__heading">
						{{- heading -}}
					</h2>
				{%- endif -%}

				{% if subheading != blank %}
					<p class="image-with-text-vertical__subheading">{{ subheading }}</p>
				{% endif %}

				{%- if text_content != blank -%}
					<div class="image-with-text-vertical__text-content rte">
						{{- text_content -}}
					</div>
				{%- endif -%}
			</div>
		{%- endif -%}

		<div class="image-with-text-vertical__grid">
			{%- for i in (1..3) -%}
				{%- assign desktop_image = section.settings['image_' | append: i | append: '_desktop'] -%}
				{%- assign mobile_image = section.settings['image_' | append: i | append: '_mobile'] | default: desktop_image -%}
				{%- assign text_label = section.settings['text_' | append: i | append: '_label'] -%}
				{%- assign text_placeholder = section.settings['text_' | append: i | append: '_placeholder'] -%}
				{%- assign text_default = section.settings['text_' | append: i | append: '_default'] -%}
				{%- assign text_rows = section.settings['text_' | append: i | append: '_rows'] -%}
				{%- assign image_alt = section.settings['image_' | append: i | append: '_alt'] -%}

				{%- if desktop_image != blank -%}
					<div class="image-text-pair">
						<img 
							src="{{ desktop_image | img_url: '600x' }}"
							srcset="{{ desktop_image | img_url: '600x' }} 1x, {{ desktop_image | img_url: '1200x' }} 2x"
							alt="{{ image_alt }}"
							class="image-text-pair__image"
							loading="lazy"
						/>
						<div class="image-text-pair__text-area">
							<label for="image-text-{{ i }}-{{ section.id }}" class="image-text-pair__label">
								{{ text_label | default: "Text " | append: i }}
							</label>
							<textarea 
								id="image-text-{{ i }}-{{ section.id }}" 
								class="image-text-pair__textarea" 
								placeholder="{{ text_placeholder | default: "Enter your content here..." }}"
								rows="{{ text_rows | default: 3 }}"
							>{{ text_default }}</textarea>
						</div>
					</div>
				{%- endif -%}
			{%- endfor -%}
		</div>

		{%- if button_label != blank and button_url != blank -%}
			<a
				href="{{- button_url -}}"
				{%- if button_aria_label != blank -%}aria-label="{{- button_aria_label | escape -}}"{%- endif -%}
				class="image-with-text-vertical__button button button--{{- button_style -}}"
			>
				{{- button_label -}}
			</a>
		{%- endif -%}
	</div>
</section>

