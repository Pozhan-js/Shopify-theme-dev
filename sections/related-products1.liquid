<div class="related-products-section">
  <div class="container">
    <h2 class="section-title">{{ section.settings.heading }}</h2>

    {% if section.settings.product_selection == 'manual' %}
      <!-- 手动选择的产品 -->
      <div class="products-grid">
        {% for block in section.blocks %}
          {% assign featured_product = all_products[block.settings.product] %}
          {% if featured_product != blank %}
            <div class="product-card" {{ block.shopify_attributes }}>
              <a href="{{ featured_product.url }}">
                <img src="{{ featured_product.featured_image | image_url: width: 300}}" 
                     alt="{{ featured_product.title }}">
                <h3>{{ featured_product.title }}</h3>
                <p class="price">{{ featured_product.price | money }}</p>
              </a>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <!-- 自动推荐 -->
      <div id="auto-recommendations" data-product-id="{{ product.id }}"></div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "You may also like"
    },
    {
      "type": "select",
      "id": "product_selection",
      "label": "Product Selection",
      "options": [
        {
          "value": "auto",
          "label": "Automatic recommendations"
        },
        {
          "value": "manual",
          "label": "Manual selection"
        }
      ],
      "default": "auto"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}
