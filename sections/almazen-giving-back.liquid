        }
      ]
    },
    {
      "type": "giving_stat",
      "name": "Giving Statistic",
      "settings": [
        {
          "type": "text",
          "id": "stat_number",
          "label": "Statistic Number"
        },
        {
          "type": "text",
          "id": "stat_label",
          "label": "Statistic Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Giving Back",
      "blocks": [
        {
          "type": "giving_initiative",
          "settings": {
            "initiative_title": "Temple Preservation",
