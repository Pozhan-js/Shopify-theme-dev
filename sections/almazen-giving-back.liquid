{% comment %}
  AlmaZen Giving Back Section
{% endcomment %}

<style>
  .almazen-giving {
    padding: 5rem 1.5rem;
    background: white;
  }
  
  .almazen-giving .container {
    max-width: 80rem;
    margin: 0 auto;
  }
  
  .almazen-giving .section-header {
    text-align: center;
    margin-bottom: 4rem;
    animation: slideUp 0.6s ease-out;
  }
  
  .almazen-giving .section-title {
    font-size: 2.5rem;
    font-family: 'Noto Serif', serif;
    font-weight: 300;
    color: #4a3f32;
    margin-bottom: 1.5rem;
  }
  
  .almazen-giving .section-divider {
    width: 4rem;
    height: 2px;
    background: #5a7c5a;
    margin: 0 auto 2rem;
  }
  
  .almazen-giving .section-intro {
    font-size: 1.125rem;
    color: #8b7d68;
    max-width: 48rem;
    margin: 0 auto;
    line-height: 1.6;
  }
  
  .almazen-giving .initiatives-grid {
    display: grid;
    gap: 2rem;
    margin-bottom: 4rem;
  }
  
  .almazen-giving .initiative-card {
    background: #faf9f7;
    border-radius: 0.75rem;
    padding: 2rem;
    transition: all 0.3s ease;
    border: 1px solid rgba(232, 228, 222, 0.5);
    transform: translateY(0);
  }
  
  .almazen-giving .initiative-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 60px rgba(45, 36, 27, 0.15);
  }
  
  .almazen-giving .initiative-content {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
  }
  
  .almazen-giving .initiative-icon {
    width: 4rem;
    height: 4rem;
    background: linear-gradient(135deg, #7d9a7d, #8b7d68);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.3s ease;
  }
  
  .almazen-giving .initiative-card:hover .initiative-icon {
    transform: scale(1.1);
  }
  
  .almazen-giving .initiative-text {
    flex: 1;
  }
  
  .almazen-giving .initiative-title {
    font-size: 1.25rem;
    font-family: 'Noto Serif', serif;
    color: #4a3f32;
    margin-bottom: 0.75rem;
  }
  
  .almazen-giving .initiative-description {
    color: #8b7d68;
    line-height: 1.6;
    margin-bottom: 1rem;
  }
  
  .almazen-giving .impact-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #e3e7e3;
    border-radius: 9999px;
    padding: 0.5rem 1rem;
  }
  
  .almazen-giving .impact-text {
    color: #374d37;
    font-weight: 500;
    font-size: 0.875rem;
  }
  
  .almazen-giving .highlight-section {
    position: relative;
    margin-bottom: 4rem;
  }
  
  .almazen-giving .highlight-bg {
    height: 20rem;
    border-radius: 1rem;
    background-attachment: fixed;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  
  .almazen-giving .highlight-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 1rem;
  }
  
  .almazen-giving .highlight-content {
    position: relative;
    z-index: 10;
    text-align: center;
    color: white;
    padding: 0 1.5rem;
  }
  
  .almazen-giving .highlight-title {
    font-size: 1.875rem;
    font-family: 'Noto Serif', serif;
    font-weight: 300;
    margin-bottom: 1rem;
  }
  
  .almazen-giving .highlight-text {
    font-size: 1.125rem;
    opacity: 0.9;
    max-width: 32rem;
    margin: 0 auto 2rem;
  }
  
  .almazen-giving .stats-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    text-align: center;
  }
  
  .almazen-giving .stat-item {
    display: flex;
    flex-direction: column;
  }
  
  .almazen-giving .stat-number {
    font-size: 1.5rem;
    font-weight: bold;
    margin-bottom: 0.25rem;
  }
  
  .almazen-giving .stat-label {
    font-size: 0.875rem;
    opacity: 0.8;
  }
  
  .almazen-giving .cta-section {
    text-align: center;
    background: #f6f7f6;
    border-radius: 1rem;
    padding: 2rem;
  }
  
  .almazen-giving .cta-title {
    font-size: 1.5rem;
    font-family: 'Noto Serif', serif;
    color: #4a3f32;
    margin-bottom: 1.5rem;
  }
  
  .almazen-giving .cta-text {
    font-size: 1.125rem;
    color: #8b7d68;
    line-height: 1.6;
    max-width: 48rem;
    margin: 0 auto;
  }
  
  .almazen-giving .text-module {
    background: #faf9f7;
    border-radius: 1rem;
    padding: 2.5rem;
    margin: 2rem 0 3rem;
    border: 1px solid rgba(232, 228, 222, 0.5);
    box-shadow: 0 8px 30px rgba(45, 36, 27, 0.08);
    text-align: center;
  }
  
  .almazen-giving .text-module-content {
    max-width: 64rem;
    margin: 0 auto;
  }
  
  .almazen-giving .text-module-title {
    font-size: 1.75rem;
    font-family: 'Noto Serif', serif;
    color: #4a3f32;
    margin-bottom: 1rem;
    font-weight: 400;
  }
  
  .almazen-giving .text-module-description {
    font-size: 1.125rem;
    color: #8b7d68;
    line-height: 1.7;
  }
  
  .almazen-giving .text-module-description.rte p {
    margin-bottom: 1rem;
  }
  
  .almazen-giving .text-module-description.rte p:last-child {
    margin-bottom: 0;
  }
  
  .almazen-giving .text-module-description.rte h1,
  .almazen-giving .text-module-description.rte h2,
  .almazen-giving .text-module-description.rte h3,
  .almazen-giving .text-module-description.rte h4,
  .almazen-giving .text-module-description.rte h5,
  .almazen-giving .text-module-description.rte h6 {
    color: #4a3f32;
    margin: 1.5rem 0 1rem;
    font-family: 'Noto Serif', serif;
  }
  
  .almazen-giving .text-module-description.rte ul,
  .almazen-giving .text-module-description.rte ol {
    margin: 1rem 0;
    padding-left: 2rem;
  }
  
  .almazen-giving .text-module-description.rte li {
    margin-bottom: 0.5rem;
  }
  
  .almazen-giving .text-module-description.rte a {
    color: #7d9a7d;
    text-decoration: underline;
  }
  
  .almazen-giving .text-module-description.rte a:hover {
    color: #5a7c5a;
  }
  
  @media (min-width: 768px) {
    .almazen-giving .section-title {
      font-size: 3rem;
    }
    .almazen-giving .initiatives-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .almazen-giving .highlight-title {
      font-size: 2.25rem;
    }
    .almazen-giving .highlight-text {
      font-size: 1.25rem;
    }
    .almazen-giving .cta-section {
      padding: 3rem;
    }
    .almazen-giving .cta-title {
      font-size: 1.875rem;
    }
  }
  
  @media (min-width: 1024px) {
    .almazen-giving {
      padding: 5rem 3rem;
    }
  }
  
  @media (max-width: 768px) {
    .almazen-giving .highlight-bg {
      background-attachment: scroll;
    }
  }
  
  @keyframes slideUp {
    0% { transform: translateY(30px); opacity: 0; }
    100% { transform: translateY(0); opacity: 1; }
  }
</style>

<section id="giving-back" class="almazen-giving">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        {{ section.settings.giving_title | default: 'Giving Back' }}
      </h2>
      <div class="section-divider"></div>
      <p class="section-intro">
        {{ section.settings.giving_intro }}
      </p>
    </div>

    <div class="text-module">
      <div class="text-module-content">
        <h3 class="text-module-title">
          {{ section.settings.text_module_title }}
        </h3>
        <div class="text-module-description rte">
          {{ section.settings.text_module_description }}
        </div>
      </div>
    </div>

    <div class="initiatives-grid">
      {% for block in section.blocks %}
        {% if block.type == 'giving_initiative' %}
          <div class="initiative-card">
            <div class="initiative-content">

              <div class="initiative-text">
                <h3 class="initiative-title">{{ block.settings.initiative_title }}</h3>
                <p class="initiative-description">{{ block.settings.initiative_description }}</p>
                <div class="impact-badge">
                  <i class="fas fa-heart" style="color: #456245; font-size: 0.875rem;"></i>
                  <span class="impact-text">{{ block.settings.initiative_impact }}</span>
                </div>
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.giving_bg_image %}
      <div class="highlight-section">
        <div 
          class="highlight-bg"
          style="background-image: url('{{ section.settings.giving_bg_image | img_url: '2048x' }}');"
        >
          <div class="highlight-overlay"></div>
          <div class="highlight-content">
            <h3 class="highlight-title">
              {{ section.settings.giving_highlight_title }}
            </h3>
            <p class="highlight-text">
              {{ section.settings.giving_highlight_text }}
            </p>
            <div class="stats-grid">
              {% for block in section.blocks %}
                {% if block.type == 'giving_stat' %}
                  <div class="stat-item">
                    <div class="stat-number">{{ block.settings.stat_number }}</div>
                    <div class="stat-label">{{ block.settings.stat_label }}</div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    {% endif %}

    <div class="cta-section">
      <h3 class="cta-title">
        {{ section.settings.giving_cta_title }}
      </h3>
      <p class="cta-text">
        {{ section.settings.giving_cta_text }}
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Giving Back",
  "settings": [
    {
      "type": "textarea",
      "id": "giving_intro",
      "label": "Introduction Text",
      "default": "True to Zen principles of compassion and interconnectedness, we believe in giving back to the communities and traditions that inspire our work."
    },
    {
      "type": "text",
      "id": "text_module_title",
      "label": "Text Module Title",
      "default": "Our Commitment to Giving"
    },
    {
      "type": "richtext",
      "id": "text_module_description",
      "label": "Text Module Description",
      "default": "Through mindful giving, we honor the ancient Zen principle of interconnectedness. Every contribution creates ripples of positive change, supporting communities, preserving traditions, and nurturing the natural world that sustains us all."
    },
    {
      "type": "text",
      "id": "giving_highlight_title",
      "label": "Highlight Title",
      "default": "Creating Ripples of Positive Change"
    },
    {
      "type": "text",
      "id": "giving_cta_title",
      "label": "CTA Title",
      "default": "Join Our Mission of Compassion"
    },
    {
      "type": "textarea",
      "id": "giving_cta_text",
      "label": "CTA Text",
      "default": "When you choose AlmaZen, you become part of a larger movement dedicated to preserving ancient wisdom, supporting communities, and creating positive change in the world. Together, we can make a meaningful difference."
    }
  ],
  "blocks": [
    {
      "type": "giving_initiative",
      "name": "Giving Initiative",
      "settings": [
        {
          "type": "text",
          "id": "initiative_title",
          "label": "Initiative Title"
        },
        {
          "type": "textarea",
          "id": "initiative_description",
          "label": "Initiative Description"
        },
        {
          "type": "text",
          "id": "initiative_icon",
