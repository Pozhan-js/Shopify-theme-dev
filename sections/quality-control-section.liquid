<div class="quality-control-section" {{ section.shopify_attributes }}>
  <div class="quality-control-container">
    <!-- 标题 -->
    <div class="quality-control-header">
      <h2 class="quality-control-title">{{ section.settings.section_title | default: "Quality Control" }}</h2>
    </div>

    <!-- 质量控制步骤 -->
    <div class="quality-control-steps">
      {% for block in section.blocks %}
        {% if block.type == 'quality_step' %}
          <div class="quality-step" {{ block.shopify_attributes }}>
            <div class="step-number">{{ block.settings.step_number | default: forloop.index | prepend: '0' | slice: -2, 2 }}</div>
            <div class="step-content">
              <h3 class="step-title">{{ block.settings.step_title }}</h3>
              <p class="step-description">{{ block.settings.step_description }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .quality-control-section {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px 0;
  }

  .quality-control-container {
    max-width: 1750px;
    margin: 0 auto;
    padding: 0 48px;
  }

  .quality-control-header {
    text-align: center;
    margin-bottom: 80px;
  }

  .quality-control-title {
    font-family: 'Poppins', sans-serif;
    font-size: 48px;
    font-weight: 500;
    color: {{ section.settings.title_color }};
    margin: 0;
    letter-spacing: 0px;
    line-height: 1.2;
  }

  .quality-control-steps {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 40px;
  }

  .quality-step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    position: relative;
  }

  .quality-step:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -20px;
    top: 60px;
    width: 0.5px;
    height: calc(100% - 60px);
    background-color: rgba(22, 22, 22, 0.25);
  }

  .step-number {
    font-family: 'Poppins', sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: #C22E35;
    margin-bottom: 20px;
    letter-spacing: 0px;
    position: relative;
    z-index: 2;
  }

  .step-number::before {
    content: '';
    position: absolute;
    left: 18px;
    top: 35%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    background-color: rgba(194, 46, 53, 0.15);
    border-radius: 50%;
    z-index: -1;
  }

  .step-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .step-title {
    font-family: 'Poppins', sans-serif;
    font-size: 28px;
    font-weight: 500;
    color: #161616;
    margin: 0;
    line-height: 1.3;
    letter-spacing: 0px;
  }

  .step-description {
    font-family: 'Poppins', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: rgba(22, 22, 22, 0.5);
    line-height: 1.5;
    margin: 0;
    letter-spacing: 0px;
  }

  /* 响应式设计 */

  /* 大屏幕 (1920px+) - 使用设计图精确尺寸 */
  @media (min-width: 1920px) {
    .quality-control-container {
      max-width: 1750px;
      padding: 0 48px;
    }
    
    .quality-control-header {
      margin-bottom: 80px;
    }
    
    .quality-control-title {
      font-size: 48px;
    }
    
    .quality-control-steps {
      grid-template-columns: repeat(6, 1fr);
      gap: 40px;
    }
    
    .quality-step:not(:last-child)::after {
      right: -20px;
      top: 60px;
      height: calc(100% - 60px);
    }
    
    .step-number {
      font-size: 24px;
      margin-bottom: 20px;
    }
    
    .step-number::before {
      left: 18px;
      top: 35%;
      width: 40px;
      height: 40px;
    }
    
    .step-content {
      gap: 16px;
    }
    
    .step-title {
      font-size: 28px;
    }
    
    .step-description {
      font-size: 14px;
    }
  }

  /* 中等屏幕 (1024px - 1919px) - 84%比例缩放 */
  @media (min-width: 1024px) and (max-width: 1919px) {
    .quality-control-container {
      max-width: calc(1750px * 0.84);
      padding: 0 calc(48px * 0.84);
    }
    
    .quality-control-header {
      margin-bottom: calc(80px * 0.84);
    }
    
    .quality-control-title {
      font-size: calc(48px * 0.84);
    }
    
    .quality-control-steps {
      grid-template-columns: repeat(6, 1fr);
      gap: calc(40px * 0.84);
    }
    
    .quality-step:not(:last-child)::after {
      right: calc(-20px * 0.84);
      top: calc(60px * 0.84);
      height: calc(100% - 60px * 0.84);
    }
    
    .step-number {
      font-size: calc(24px * 0.84);
      margin-bottom: calc(20px * 0.84);
    }
    
    .step-number::before {
      left: calc(18px * 0.84);
      top: 35%;
      width: calc(40px * 0.84);
      height: calc(40px * 0.84);
    }
    
    .step-content {
      gap: calc(16px * 0.84);
    }
    
    .step-title {
      font-size: calc(28px * 0.84);
    }
    
    .step-description {
      font-size: calc(14px * 0.84);
    }
  }

  /* 平板屏幕 (768px - 1023px) - 67%比例缩放，3列布局 */
  @media (min-width: 768px) and (max-width: 1023px) {
    .quality-control-container {
      max-width: calc(1750px * 0.67);
      padding: 0 calc(48px * 0.67);
    }
    
    .quality-control-header {
      margin-bottom: calc(80px * 0.67);
    }
    
    .quality-control-title {
      font-size: calc(48px * 0.67);
    }
    
    .quality-control-steps {
      grid-template-columns: repeat(3, 1fr);
      gap: calc(40px * 0.67);
    }
    
    .quality-step:not(:last-child)::after {
      right: calc(-20px * 0.67);
      top: calc(60px * 0.67);
      height: calc(100% - 60px * 0.67);
    }
    
    .step-number {
      font-size: calc(24px * 0.67);
      margin-bottom: calc(20px * 0.67);
    }
    
    .step-number::before {
      left: calc(18px * 0.67);
      top: 35%;
      width: calc(40px * 0.67);
      height: calc(40px * 0.67);
    }
    
    .step-content {
      gap: calc(16px * 0.67);
    }
    
    .step-title {
      font-size: calc(28px * 0.67);
    }
    
    .step-description {
      font-size: calc(14px * 0.67);
    }
  }

  /* 小屏幕 (481px - 767px) - 50%比例缩放，2列布局 */
  @media (min-width: 481px) and (max-width: 767px) {
    .quality-control-section {
      padding: calc({{ section.settings.section_padding_top }}px * 0.5) 0 calc({{ section.settings.section_padding_bottom }}px * 0.5) 0;
    }
    
    .quality-control-container {
      max-width: calc(1750px * 0.5);
      padding: 0 calc(48px * 0.5);
    }
    
    .quality-control-header {
      margin-bottom: calc(80px * 0.5);
    }
    
    .quality-control-title {
      font-size: calc(48px * 0.5);
    }
    
    .quality-control-steps {
      grid-template-columns: repeat(2, 1fr);
      gap: calc(40px * 0.5);
    }
    
    .quality-step:not(:last-child)::after {
      right: calc(-20px * 0.5);
      top: calc(60px * 0.5);
      height: calc(100% - 60px * 0.5);
    }
    
    .step-number {
      font-size: calc(24px * 0.5);
      margin-bottom: calc(20px * 0.5);
    }
    
    .step-number::before {
      left: calc(18px * 0.5);
      top: 35%;
      width: calc(40px * 0.5);
      height: calc(40px * 0.5);
    }
    
    .step-content {
      gap: calc(16px * 0.5);
    }
    
    .step-title {
      font-size: calc(28px * 0.5);
    }
    
    .step-description {
      font-size: calc(14px * 0.5);
    }
  }

  /* 超小屏幕 (最大480px) - 33%比例缩放，单列布局 */
  @media (max-width: 480px) {
    .quality-control-section {
      padding: calc({{ section.settings.section_padding_top }}px * 0.33) 0 calc({{ section.settings.section_padding_bottom }}px * 0.33) 0;
    }
    
    .quality-control-container {
      max-width: calc(1750px * 0.33);
      padding: 0 calc(48px * 0.33);
      min-padding: 0 15px;
    }
    
    .quality-control-header {
      margin-bottom: calc(80px * 0.33);
      min-margin-bottom: 30px;
    }
    
    .quality-control-title {
      font-size: calc(48px * 0.33);
      min-font-size: 20px;
    }
    
    .quality-control-steps {
      grid-template-columns: 1fr;
      gap: calc(40px * 0.33);
      min-gap: 20px;
    }
    
    .quality-step:not(:last-child)::after {
      display: none;
    }
    
    .step-number {
      font-size: calc(24px * 0.33);
      margin-bottom: calc(20px * 0.33);
      min-font-size: 16px;
      min-margin-bottom: 8px;
    }
    
    .step-number::before {
      left: calc(18px * 0.33);
      top: 35%;
      width: calc(40px * 0.33);
      height: calc(40px * 0.33);
      min-width: 20px;
      min-height: 20px;
    }
    
    .step-content {
      gap: calc(16px * 0.33);
      min-gap: 8px;
    }
    
    .step-title {
      font-size: calc(28px * 0.33);
      min-font-size: 16px;
    }
    
    .step-description {
      font-size: calc(14px * 0.33);
      min-font-size: 12px;
    }
  }
</style>

{% schema %}
{
  "name": "Quality Control",
  "tag": "section",
  "class": "quality-control-section",
  "settings": [
    {
      "type": "header",
      "content": "区块设置"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#F8F8F8"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "顶部内边距",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "底部内边距",
      "default": 80
    },
    {
      "type": "header",
      "content": "标题设置"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "区块标题",
      "default": "Quality Control"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "default": "#161616"
    }
  ],
  "blocks": [
    {
      "type": "quality_step",
      "name": "质量控制步骤",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "步骤编号",
          "default": "01",
          "info": "例如：01, 02, 03..."
        },
        {
          "type": "text",
          "id": "step_title",
          "label": "步骤标题"
        },
        {
          "type": "textarea",
          "id": "step_description",
          "label": "步骤描述"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quality Control",
      "blocks": [
        {
          "type": "quality_step",
          "settings": {
            "step_number": "01",
            "step_title": "Material Sourcing",
            "step_description": "We select only high-quality raw materials compliant with CE, ISO, and RoHS international standards."
          }
        },
        {
          "type": "quality_step",
          "settings": {
            "step_number": "02",
            "step_title": "Skilled Production",
            "step_description": "Our 350+ experienced specialists in woodworking, metal finishing, and upholstery use advanced machinery and processes."
          }
        },
        {
          "type": "quality_step",
          "settings": {
            "step_number": "03",
            "step_title": "In-Process Checks",
            "step_description": "Semi-finished products are sample-tested after each production batch to ensure consistency and prevent deviations."
          }
        },
        {
          "type": "quality_step",
          "settings": {
            "step_number": "04",
            "step_title": "Assembly & Testing",
            "step_description": "Completed products undergo comprehensive functional, load-bearing, and safety tests by dedicated assembly teams."
          }
        },
        {
          "type": "quality_step",
          "settings": {
            "step_number": "05",
            "step_title": "100% Final Inspection",
            "step_description": "Every single piece of equipment is meticulously inspected against our core metrics: appearance, structure, function, and stability."
          }
        },
        {
          "type": "quality_step",
          "settings": {
            "step_number": "06",
            "step_title": "Secure Packaging",
            "step_description": "Approved products are packed in custom-designed packaging to minimize the risk of damage during transit."
          }
        }
      ]
    }
  ]
}
{% endschema %}
