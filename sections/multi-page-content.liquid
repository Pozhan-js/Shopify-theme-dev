<!-- sections/multi-page-content.liquid -->
<div class="multi-page-section">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'page_content' %}
        {% assign target_page = pages[block.settings.page_handle] %}
        {% if target_page %}
          <div class="page-content-block" {{ block.shopify_attributes }}>
            {% if block.settings.show_title %}
              <h2 class="page-title">{{ target_page.title }}</h2>
            {% endif %}
            <div class="page-content">
              {{ target_page.content }}
            </div>
          </div>
        {% endif %}

      {% when 'collection_products' %}
        {% assign target_collection = collections[block.settings.collection_handle] %}
        {% if target_collection %}
          <div class="collection-block" {{ block.shopify_attributes }}>
            {% if block.settings.show_title %}
              <h2 class="collection-title">{{ target_collection.title }}</h2>
            {% endif %}
            <div class="products-grid">
              {% for product in target_collection.products limit: block.settings.product_limit %}
                <div class="product-item">
                  <a href="{{ product.url }}">
                    <img src="{{ product.featured_image | img_url: '300x300' }}" alt="{{ product.title }}">
                    <h3>{{ product.title }}</h3>
                    <p>{{ product.price | money }}</p>
                  </a>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
    {% endcase %}
  {% endfor %}
</div>

<style>
  .multi-page-section {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .page-content-block,
  .collection-block {
    margin-bottom: 60px;
    padding: 30px;
    background: #f9f9f9;
    border-radius: 8px;
  }

  .page-title,
  .collection-title {
    font-size: 2rem;
    margin-bottom: 20px;
    color: #333;
  }

  .page-content {
    line-height: 1.6;
    color: #666;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  .product-item {
    text-align: center;
    padding: 20px;
    background: white;
    border-radius: 8px;
    transition: transform 0.3s ease;
  }

  .product-item:hover {
    transform: translateY(-5px);
  }

  .product-item img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 4px;
    margin-bottom: 15px;
  }

  .product-item h3 {
    font-size: 1.1rem;
    margin-bottom: 10px;
    color: #333;
  }

  .product-item a {
    text-decoration: none;
    color: inherit;
  }

  @media (max-width: 768px) {
    .multi-page-section {
      padding: 20px 16px;
    }

    .page-content-block,
    .collection-block {
      padding: 20px;
      margin-bottom: 40px;
    }

    .products-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
    }
  }
</style>

{% schema %}
{
  "name": "多页面内容集成",
  "settings": [
    {
      "type": "header",
      "content": "页面内容集成设置"
    }
  ],
  "blocks": [
    {
      "type": "page_content",
      "name": "页面内容",
      "settings": [
        {
          "type": "page",
          "id": "page_handle",
          "label": "选择页面"
        },
        {
          "type": "checkbox",
          "id": "show_title",
          "label": "显示页面标题",
          "default": true
        }
      ]
    },
    {
      "type": "collection_products",
      "name": "产品集合",
      "settings": [
        {
          "type": "collection",
          "id": "collection_handle",
          "label": "选择产品集合"
        },
        {
          "type": "checkbox",
          "id": "show_title",
          "label": "显示集合标题",
          "default": true
        },
        {
          "type": "range",
          "id": "product_limit",
          "label": "显示产品数量",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 4
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "多页面内容集成",
      "blocks": [
        {
          "type": "page_content"
        },
        {
          "type": "collection_products"
        }
      ]
    }
  ]
}
{% endschema %}
