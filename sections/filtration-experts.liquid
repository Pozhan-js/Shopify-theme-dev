<style>
  .filtration-experts {
    width: 100%;
    background-color: #ffffff;
    padding: 60px 0;
  }

  .filtration-experts__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 45px;
    box-sizing: border-box;
  }

  .filtration-experts__title {
    text-align: center;
    font-size: 36px;
    font-weight: 600;
    color: #333;
    margin: 0 0 50px 0;
  }

  .filtration-experts__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }

  .filtration-experts__article {
    background: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .filtration-experts__article:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .filtration-experts__image-wrapper {
    position: relative;
    width: 100%;
    height: 280px;
    overflow: hidden;
    background: #f8f9fa;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .filtration-experts__image {
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center;
  }

  .filtration-experts__content {
    padding: 25px 20px 30px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .filtration-experts__date {
    font-size: 14px;
    color: #666;
    margin: 0 0 10px 0;
    font-weight: 400;
  }

  .filtration-experts__article-title {
    font-size: 18px;
    font-weight: 600;
    color: #333;
    margin: 0 0 15px 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .filtration-experts__article-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .filtration-experts__article-title a:hover {
    color: #871d16;
  }

  .filtration-experts__excerpt {
    font-size: 14px;
    color: #666;
    line-height: 1.6;
    margin: 0;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .filtration-experts__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8f9fa;
  }

  .filtration-experts__no-blog {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-style: italic;
  }

  @media (max-width: 1024px) {
    .filtration-experts {
      padding: 50px 0;
    }

    .filtration-experts__container {
      padding: 0 30px;
    }

    .filtration-experts__title {
      font-size: 32px;
      margin-bottom: 40px;
    }

    .filtration-experts__grid {
      gap: 30px;
    }

    .filtration-experts__image-wrapper {
      height: 250px;
    }

    .filtration-experts__content {
      padding: 20px 18px 25px;
    }

    .filtration-experts__article-title {
      font-size: 17px;
    }

    .filtration-experts__excerpt {
      font-size: 13px;
    }
  }

  @media (max-width: 768px) {
    .filtration-experts {
      padding: 40px 0;
    }

    .filtration-experts__container {
      padding: 0 20px;
    }

    .filtration-experts__title {
      font-size: 28px;
      margin-bottom: 35px;
    }

    .filtration-experts__grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .filtration-experts__image-wrapper {
      height: 220px;
    }

    .filtration-experts__content {
      padding: 18px 15px 22px;
    }

    .filtration-experts__article-title {
      font-size: 16px;
      margin-bottom: 12px;
    }

    .filtration-experts__excerpt {
      font-size: 12px;
    }

    .filtration-experts__date {
      font-size: 13px;
      margin-bottom: 8px;
    }
  }

  @media (max-width: 480px) {
    .filtration-experts {
      padding: 35px 0;
    }

    .filtration-experts__container {
      padding: 0 15px;
    }

    .filtration-experts__title {
      font-size: 24px;
      margin-bottom: 30px;
    }

    .filtration-experts__grid {
      gap: 20px;
    }

    .filtration-experts__image-wrapper {
      height: 200px;
    }

    .filtration-experts__content {
      padding: 15px 12px 18px;
    }

    .filtration-experts__article-title {
      font-size: 15px;
      margin-bottom: 10px;
    }

    .filtration-experts__excerpt {
      font-size: 11px;
    }

    .filtration-experts__date {
      font-size: 12px;
      margin-bottom: 6px;
    }
  }
</style>

<section class="filtration-experts">
  <div class="filtration-experts__container">
    {% if section.settings.title != blank %}
      <h2 class="filtration-experts__title" style="color: {{ section.settings.title_color }};">
        {{ section.settings.title }}
      </h2>
    {% endif %}

    {% if section.settings.blog_handle != blank %}
      {% assign selected_blog = blogs[section.settings.blog_handle] %}
      {% if selected_blog.articles.size > 0 %}
        <div class="filtration-experts__grid">
          {% for article in selected_blog.articles limit: section.settings.articles_limit %}
            <article class="filtration-experts__article">
              <div class="filtration-experts__image-wrapper">
                {% if article.image %}
                  <img
                    src="{{ article.image | img_url: '400x' }}"
                    alt="{{ article.title }}"
                    class="filtration-experts__image"
                    loading="lazy"
                  >
                {% else %}
                  <div class="filtration-experts__placeholder">
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M21 19V5C21 3.9 20.1 3 19 3H5C3.9 3 3 3.9 3 5V19C3 20.1 3.9 21 5 21H19C20.1 21 21 20.1 21 19ZM8.5 13.5L11 16.51L14.5 12L19 18H5L8.5 13.5Z" fill="#ccc"/>
                    </svg>
                  </div>
                {% endif %}
              </div>

              <div class="filtration-experts__content">
                <time class="filtration-experts__date" style="color: {{ section.settings.date_color }};">
                  {{ article.published_at | date: "%B %d, %Y" }}
                </time>

                <h3 class="filtration-experts__article-title" style="color: {{ section.settings.article_title_color }};">
                  <a href="{{ article.url }}">{{ article.title }}</a>
                </h3>

                <p class="filtration-experts__excerpt" style="color: {{ section.settings.excerpt_color }};">
                  {% if article.excerpt != blank %}
                    {{ article.excerpt | strip_html | truncate: 150 }}
                  {% else %}
                    {{ article.content | strip_html | truncate: 150 }}
                  {% endif %}
                </p>
              </div>
            </article>
          {% endfor %}
        </div>
      {% else %}
        <div class="filtration-experts__no-blog">
          <p>No articles found in the selected blog.</p>
        </div>
      {% endif %}
    {% else %}
      <div class="filtration-experts__no-blog">
        <p>Please select a blog to display articles.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Filtration Experts",
  "tag": "section",
  "class": "filtration-experts-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Learn From Filtration Experts"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Blog Settings"
    },
    {
      "type": "blog",
      "id": "blog_handle",
      "label": "Select Blog"
    },
    {
      "type": "range",
      "id": "articles_limit",
      "label": "Number of Articles",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Content Colors"
    },
    {
      "type": "color",
      "id": "date_color",
      "label": "Date Color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "article_title_color",
      "label": "Article Title Color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "excerpt_color",
      "label": "Excerpt Color",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Learn From Filtration Experts"
    }
  ]
}
{% endschema %}

<style>
  .filtration-experts-section {
    background-color: {{ section.settings.background_color | default: '#ffffff' }};
  }
</style>
