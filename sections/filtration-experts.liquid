<!-- Filtration Experts Section - 从 Shopify 博客读取文章内容 -->
    <style>
      .filtration-experts {
        width: 100%;
        background-color: #ffffff;
        padding: 60px 0;
      }

      .filtration-experts__container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 45px;
        box-sizing: border-box;
      }

      .filtration-experts__title {
        text-align: center;
        font-size: 36px;
        font-weight: 600;
        color: #333;
        margin: 0 0 50px 0;
      }

      .filtration-experts__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 40px;
      }

      .filtration-experts__article {
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        cursor: pointer;
        border: 1px solid #e9ecef;
      }

      .filtration-experts__article:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        border-color: #871d16;
      }

      .filtration-experts__article-link {
        display: contents;
        text-decoration: none;
        color: inherit;
      }

      .filtration-experts__image-wrapper {
        position: relative;
        width: 100%;
        height: 280px;
        overflow: hidden;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s ease;
      }

      .filtration-experts__article:hover .filtration-experts__image-wrapper {
        transform: scale(1.02);
      }

      .filtration-experts__image {
        width: auto;
        height: auto;
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        object-position: center;
        transition: transform 0.3s ease;
      }

      .filtration-experts__article:hover .filtration-experts__image {
        transform: scale(1.05);
      }

      .filtration-experts__content {
        padding: 25px 20px 30px;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
      }

      .filtration-experts__date {
        font-size: 14px;
        color: #666;
        margin: 0 0 10px 0;
        font-weight: 400;
      }

      .filtration-experts__article-title {
        font-size: 18px;
        font-weight: 600;
        color: #333;
        margin: 0 0 15px 0;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color 0.3s ease;
      }

      .filtration-experts__article:hover .filtration-experts__article-title {
        color: #871d16;
      }

      .filtration-experts__article-title a {
        color: inherit;
        text-decoration: none;
      }

      .filtration-experts__article-title a:hover {
        color: inherit;
      }

      .filtration-experts__excerpt {
        font-size: 14px;
        color: #666;
        line-height: 1.6;
        margin: 0;
        flex-grow: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      @media (max-width: 1024px) {
        .filtration-experts {
          padding: 50px 0;
        }

        .filtration-experts__container {
          padding: 0 30px;
        }

        .filtration-experts__title {
          font-size: 32px;
          margin-bottom: 40px;
        }

        .filtration-experts__grid {
          gap: 30px;
        }

        .filtration-experts__image-wrapper {
          height: 250px;
        }

        .filtration-experts__content {
          padding: 20px 18px 25px;
        }

        .filtration-experts__article-title {
          font-size: 17px;
        }

        .filtration-experts__excerpt {
          font-size: 13px;
        }
      }

      @media (max-width: 768px) {
        .filtration-experts {
          padding: 40px 0;
        }

        .filtration-experts__container {
          padding: 0 20px;
        }

        .filtration-experts__title {
          font-size: 28px;
          margin-bottom: 35px;
        }

        .filtration-experts__grid {
          grid-template-columns: 1fr;
          gap: 25px;
        }

        .filtration-experts__image-wrapper {
          height: 220px;
        }

        .filtration-experts__content {
          padding: 18px 15px 22px;
        }

        .filtration-experts__article-title {
          font-size: 16px;
          margin-bottom: 12px;
        }

        .filtration-experts__excerpt {
          font-size: 12px;
        }

        .filtration-experts__date {
          font-size: 13px;
          margin-bottom: 8px;
        }
      }

      @media (max-width: 480px) {
        .filtration-experts {
          padding: 35px 0;
        }

        .filtration-experts__container {
          padding: 0 15px;
        }

        .filtration-experts__title {
          font-size: 24px;
          margin-bottom: 30px;
        }

        .filtration-experts__grid {
          gap: 20px;
        }

        .filtration-experts__image-wrapper {
          height: 200px;
        }

        .filtration-experts__content {
          padding: 15px 12px 18px;
        }

        .filtration-experts__article-title {
          font-size: 15px;
          margin-bottom: 10px;
        }

        .filtration-experts__excerpt {
          font-size: 11px;
        }

        .filtration-experts__date {
          font-size: 12px;
          margin-bottom: 6px;
        }
      }
    </style>

    <section class="filtration-experts">
      <div class="filtration-experts__container">
        {% if section.settings.title != blank %}
          <h2 class="filtration-experts__title" style="color: {{ section.settings.title_color }};">
            {{ section.settings.title }}
          </h2>
        {% endif %}

        <div class="filtration-experts__grid">
          {% assign blog = blogs[section.settings.blog_handle] %}
          {% if blog %}
            {% assign articles = blog.articles | limit: section.settings.articles_limit %}
            {% for article in articles %}
              <a href="{{ article.url }}" class="filtration-experts__article-link">
                <article class="filtration-experts__article">
                  <div class="filtration-experts__image-wrapper">
                    {% if article.image %}
                      <img
                        src="{{ article.image | img_url: '400x' }}"
                        alt="{{ article.title }}"
                        class="filtration-experts__image"
                        loading="lazy"
                      >
                    {% else %}
                      <div style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: #666; font-size: 14px;">
                        No Image
                      </div>
                    {% endif %}
                  </div>

                  <div class="filtration-experts__content">
                    <time class="filtration-experts__date" style="color: {{ section.settings.date_color }};">
                      {{ article.published_at | date: '%B %d, %Y' }}
                    </time>

                    <h3 class="filtration-experts__article-title" style="color: {{ section.settings.article_title_color }};">
                      {{ article.title }}
                    </h3>

                    {% if article.excerpt != blank %}
                      <p class="filtration-experts__excerpt" style="color: {{ section.settings.excerpt_color }};">
                        {{ article.excerpt | strip_html | truncate: 150 }}
                      </p>
                    {% else %}
                      <p class="filtration-experts__excerpt" style="color: {{ section.settings.excerpt_color }};">
                        {{ article.content | strip_html | truncate: 150 }}
                      </p>
                    {% endif %}
                  </div>
                </article>
              </a>
            {% endfor %}
          {% else %}
            <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: #666;">
              <p>Please select a blog in the section settings.</p>
            </div>
          {% endif %}
        </div>
      </div>
    </section>

    {% schema %}
    {
      "name": "Filtration Experts",
      "tag": "section",
      "class": "filtration-experts-section",
      "settings": [
        {
          "type": "header",
          "content": "Section Settings"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Section Title",
          "default": "Learn From Filtration Experts"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#333333"
        },
        {
          "type": "color",
          "id": "background_color",
          "label": "Background Color",
          "default": "#ffffff"
        },
        {
          "type": "blog",
          "id": "blog_handle",
          "label": "Select Blog",
          "info": "Choose the blog to display articles from"
        },
        {
          "type": "range",
          "id": "articles_limit",
          "min": 1,
          "max": 12,
          "step": 1,
          "default": 3,
          "label": "Number of Articles to Display"
        },
        {
          "type": "color",
          "id": "date_color",
          "label": "Date Color",
          "default": "#666666"
        },
        {
          "type": "color",
          "id": "article_title_color",
          "label": "Article Title Color",
          "default": "#333333"
        },
        {
          "type": "color",
          "id": "excerpt_color",
          "label": "Excerpt Color",
          "default": "#666666"
        }
      ],
      "presets": [
        {
          "name": "Learn From Filtration Experts",
          "settings": {
            "title": "Learn From Filtration Experts",
            "articles_limit": 3
          }
        }
      ]
    }
    {% endschema %}

    <style>
      .filtration-experts-section {
        background-color: {{ section.settings.background_color | default: '#ffffff' }};
      }
    </style>
