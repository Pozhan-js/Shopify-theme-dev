{% comment %}
  双图轮播英雄区块 - 支持左右两张图片联动轮播
{% endcomment %}

<div class="carousel-hero-section" data-section-id="{{ section.id }}">
  <style>
    .carousel-container-{{ section.id }} {
      background: transparent;
      border-radius: 1rem;
      overflow: hidden;
      width:100%;
      margin: 0 auto;
      {% comment %} box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1); {% endcomment %}
      margin-bottom:40px;
    }

    .carousel-content-{{ section.id }} {
      display: flex;
      height: 600px;
      gap:1rem;
    }

    .carousel-image-area-{{ section.id }} {
      position: relative;
      width: 50%;
      overflow: hidden;
      background: #f3f4f6;
      border-radius:0.5rem;
      z-index: 1;
    }

    .carousel-image-{{ section.id }} {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 0.5s ease-in-out, transform 0.5s ease-in-out;
      transform: scale(1.02);
    }

    .carousel-image-{{ section.id }}.active {
      opacity: 1;
      z-index: 10;
      transform: scale(1);
    }

    /* 右侧图片区域样式 */
    .carousel-right-image-area-{{ section.id }} {
      position: relative;
      width: 50%;
      overflow: hidden;
      background: #f3f4f6;
      border-radius:0.5rem;
      z-index: 1;
    }

    .carousel-right-image-{{ section.id }} {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 0.5s ease-in-out, transform 0.5s ease-in-out;
      transform: scale(1.02);
    }

    .carousel-right-image-{{ section.id }}.active {
      opacity: 1;
      z-index: 10;
      transform: scale(1);
    }

    .carousel-thumbnails-{{ section.id }} {
      position: absolute;
      left: 1rem;
      bottom: 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      z-index: 20;
    }

    .thumbnail-item-{{ section.id }} {
      width: 64px;
      height: 48px;
      border-radius: 0.5rem;
      overflow: hidden;
      cursor: pointer;
      border: 2px solid transparent;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      opacity: 0.6;
    }

    .thumbnail-item-{{ section.id }}:hover {
      opacity: 0.8;
      transform: scale(1.05);
    }

    .thumbnail-item-{{ section.id }}.active {
      opacity: 1;
      transform: scale(1.1);
      border-color: white;
    }

    .thumbnail-item-{{ section.id }} img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    @media (max-width: 768px) {
      .carousel-content-{{ section.id }} {
        flex-direction: column;
        height: auto;
      }

      .carousel-image-area-{{ section.id }},
      .carousel-right-image-area-{{ section.id }} {
        width: 100%;
        height: 300px;
      }
    }
  </style>

  <div class="carousel-container-{{ section.id }}">
    <div class="carousel-content-{{ section.id }}">
      <!-- 左侧图片区域 -->
      <div class="carousel-image-area-{{ section.id }}">
        {% for block in section.blocks %}
          {% if block.settings.left_image != blank %}
            <img
              src="{{ block.settings.left_image | img_url: '800x600' }}"
              alt="{{ block.settings.title | escape }}"
              class="carousel-image-{{ section.id }}{% if forloop.first %} active{% endif %}"
              data-index="{{ forloop.index0 }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            >
          {% endif %}
        {% endfor %}

        <!-- 缩略图导航 -->
        <div class="carousel-thumbnails-{{ section.id }}">
          {% for block in section.blocks %}
            {% if block.settings.left_image != blank %}
              <div
                class="thumbnail-item-{{ section.id }}{% if forloop.first %} active{% endif %}"
                data-index="{{ forloop.index0 }}"
              >
                <img
                  src="{{ block.settings.left_image | img_url: '64x48' }}"
                  alt="缩略图 {{ forloop.index }}"
                >
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <!-- 右侧图片区域 -->
      <div class="carousel-right-image-area-{{ section.id }}">
        {% for block in section.blocks %}
          {% if block.settings.right_image != blank %}
            <img
              src="{{ block.settings.right_image | img_url: '800x600' }}"
              alt="{{ block.settings.title | escape }}"
              class="carousel-right-image-{{ section.id }}{% if forloop.first %} active{% endif %}"
              data-index="{{ forloop.index0 }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
            >
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const sectionId = '{{ section.id }}';
    const carousel = document.querySelector(`[data-section-id="${sectionId}"]`);
    
    if (!carousel) return;

    const leftImages = carousel.querySelectorAll(`.carousel-image-${sectionId}`);
    const rightImages = carousel.querySelectorAll(`.carousel-right-image-${sectionId}`);
    const thumbnails = carousel.querySelectorAll(`.thumbnail-item-${sectionId}`);
    
    let currentIndex = 0;
    let autoPlayTimer;
    const totalSlides = leftImages.length;

    function updateCarousel(index) {
      // 更新左侧图片
      leftImages.forEach((img, i) => {
        img.classList.toggle('active', i === index);
      });

      // 更新右侧图片
      rightImages.forEach((img, i) => {
        img.classList.toggle('active', i === index);
      });

      // 更新缩略图
      thumbnails.forEach((thumb, i) => {
        thumb.classList.toggle('active', i === index);
      });

      currentIndex = index;
    }

    function nextSlide() {
      const nextIndex = currentIndex === totalSlides - 1 ? 0 : currentIndex + 1;
      updateCarousel(nextIndex);
    }

    function startAutoPlay() {
      if (totalSlides <= 1) return;
      autoPlayTimer = setInterval(nextSlide, {{ section.settings.autoplay_speed | default: 5000 }});
    }

    function stopAutoPlay() {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
      }
    }

    // 缩略图点击/悬停事件
    thumbnails.forEach((thumb, index) => {
      thumb.addEventListener('mouseenter', () => {
        stopAutoPlay();
        updateCarousel(index);
      });

      thumb.addEventListener('mouseleave', () => {
        {% if section.settings.enable_autoplay %}
          startAutoPlay();
        {% endif %}
      });
    });

    // 启动自动轮播
    {% if section.settings.enable_autoplay %}
      startAutoPlay();
    {% endif %}

    // 页面可见性变化时控制自动播放
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoPlay();
      } else {
        {% if section.settings.enable_autoplay %}
          startAutoPlay();
        {% endif %}
      }
    });
  });
</script>

{% schema %}
{
  "name": "双图轮播英雄区块",
  "tag": "section",
  "class": "carousel-hero-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_autoplay",
      "label": "启用自动轮播",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "自动轮播速度 (毫秒)",
      "min": 2000,
      "max": 8000,
      "step": 2000,
      "default": 4000
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "轮播项",
      "settings": [
        {
          "type": "image_picker",
          "id": "left_image",
          "label": "左侧图片"
        },
        {
          "type": "image_picker",
          "id": "right_image",
          "label": "右侧图片"
        },
        {
          "type": "text",
          "id": "title",
          "label": "标题（用于图片alt属性）",
          "default": "轮播图片"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "双图轮播英雄区块",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
