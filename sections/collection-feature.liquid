{% comment %}
  Section: Collection Info on Product Page
  在商品详情页显示该商品所属系列的图片和描述
  当产品属于多个系列时，显示第一个系列
{% endcomment %}

{% assign target_collection = product.collections.first %}

{% if target_collection %}
  <div class="collection-info-section" style="margin: {{ section.settings.section_spacing }}px 0; background-color: {{ section.settings.section_bg_color }};">
    <div class="collection-info-container">
      <div class="collection-info-image">
        {% if target_collection.image %}
          <img 
            src="{{ target_collection.image | img_url: '600x' }}"
            srcset="{{ target_collection.image | img_url: '300x' }} 300w,
                    {{ target_collection.image | img_url: '600x' }} 600w,
                    {{ target_collection.image | img_url: '900x' }} 900w"
            sizes="(max-width: 768px) 100vw, 55vw"
            alt="{{ target_collection.title }}"
            loading="lazy"
          >
        {% else %}
          {%- comment -%}如果第一个系列没有图片，尝试找一个有图片的系列{%- endcomment -%}
          {% for collection in product.collections %}
            {% if collection.image %}
              {% assign target_collection = collection %}
              <img 
                src="{{ collection.image | img_url: '600x' }}"
                srcset="{{ collection.image | img_url: '300x' }} 300w,
                        {{ collection.image | img_url: '600x' }} 600w,
                        {{ collection.image | img_url: '900x' }} 900w"
                sizes="(max-width: 768px) 100vw, 55vw"
                alt="{{ collection.title }}"
                loading="lazy"
              >
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}
      </div>
      
      <div class="collection-info-content" style="background-color: {{ section.settings.text_bg_color }};">
        <h2 class="collection-info-title">{{ target_collection.title }}</h2>
        {% if target_collection.description != blank %}
          <div class="collection-info-description">
            {{ target_collection.description }}
          </div>
        {% endif %}
        {% if section.settings.show_link %}
          <a href="{{ target_collection.url }}" class="collection-info-link">
            查看完整系列 →
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  <style>
    .collection-info-section {
      padding: 0 40px;
    }
    
    .collection-info-container {
      display: grid;
      grid-template-columns: 49% 51%;
      gap: 12px;
      align-items: center;
    }
    
    .collection-info-image {
      width: 100%;
    }
    
    .collection-info-image img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 8px;
      object-fit: cover;
    }
    
    .collection-info-content {
      padding: 20px;
      border-radius: 8px;
    }
    
    .collection-info-title {
      font-size: 28px;
      font-weight: bold;
      margin-bottom: 16px;
      color: #000;
    }
    
    .collection-info-description {
      font-size: 16px;
      line-height: 1.6;
      margin-bottom: 24px;
      color: #666;
      white-space: pre-line;
    }
    
    .collection-info-link {
      display: inline-block;
      padding: 12px 24px;
      background-color: #000;
      color: #fff;
      text-decoration: none;
      border-radius: 4px;
      transition: background-color 0.3s ease;
      font-weight: 500;
    }
    
    .collection-info-link:hover {
      background-color: #333;
    }
    
    @media (max-width: 768px) {
      .collection-info-section {
        padding: 0 20px;
      }
      
      .collection-info-container {
        grid-template-columns: 1fr;
        gap: 24px;
      }
      
      .collection-info-content {
        padding: 10px;
      }
      
      .collection-info-title {
        font-size: 24px;
      }
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "产品系列信息",
  "tag": "section",
  "class": "section-collection-info",
  "settings": [
    {
      "type": "header",
      "content": "显示设置"
    },
    {
      "type": "paragraph",
      "content": "当产品属于多个系列时，将显示第一个有图片的系列"
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "显示查看系列链接",
      "default": true
    },
    {
      "type": "range",
      "id": "section_spacing",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "上下间距",
      "default": 40
    },
    {
      "type": "header",
      "content": "颜色设置"
    },
    {
      "type": "color",
      "id": "section_bg_color",
      "label": "整体背景颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_bg_color",
      "label": "文字区域背景颜色",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "产品系列信息"
    }
  ]
}
{% endschema %}
