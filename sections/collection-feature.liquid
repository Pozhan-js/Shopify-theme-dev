{% schema %}
{
  "name": "图文展示",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "图片"
    },
    {
      "type": "range",
      "id": "image_width",
      "min": 30,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "图片宽度",
      "default": 50
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "标题",
      "default": "<p>标题文字</p>"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "内容",
      "default": "<p>这里是内容描述文字</p>"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "间隙大小",
      "default": 30
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "圆角大小",
      "default": 10
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "上边距",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "下边距",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "图文展示"
    }
  ]
}
{% endschema %}

<style>
  .image-text-section-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
  }

  .image-text-container-{{ section.id }} {
    display: flex;
    align-items: center;
    gap: {{ section.settings.gap }}px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .image-text-image-{{ section.id }} {
    flex: 0 0 {{ section.settings.image_width }}%;
    border-radius: {{ section.settings.border_radius }}px;
    overflow: hidden;
  }

  .image-text-image-{{ section.id }} img {
    width: 100%;
    height: auto;
    display: block;
  }

  .image-text-content-{{ section.id }} {
    flex: 1;
  }

  .image-text-content-{{ section.id }} h2 {
    margin-bottom: 20px;
    font-size: 32px;
    font-weight: bold;
  }

  .image-text-content-{{ section.id }} .content-text {
    font-size: 16px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .image-text-container-{{ section.id }} {
      flex-direction: column;
    }

    .image-text-image-{{ section.id }} {
      flex: 0 0 100%;
      width: 100%;
    }

    .image-text-content-{{ section.id }} h2 {
      font-size: 24px;
    }
  }
</style>

<div class="image-text-section-{{ section.id }}">
  <div class="image-text-container-{{ section.id }}">
    {% if section.settings.image %}
      <div class="image-text-image-{{ section.id }}">
        <img src="{{ section.settings.image | img_url: 'master' }}" alt="{{ section.settings.image.alt | escape }}">
      </div>
    {% endif %}

    <div class="image-text-content-{{ section.id }}">
      {% if section.settings.title != blank %}
        <div class="title-text">
          {{ section.settings.title }}
        </div>
      {% endif %}

      {% if section.settings.content != blank %}
        <div class="content-text">
          {{ section.settings.content }}
        </div>
      {% endif %}
    </div>
  </div>
</div>
