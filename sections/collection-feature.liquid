{% comment %}
  Section: Collection Info on Product Page
  在商品详情页显示产品所属系列的图片和描述
{% endcomment %}

{% if product.collections.first %}
  {% assign collection = product.collections.first %}
  
  <div class="collection-info-section">
    <div class="collection-info-container">
      <div class="collection-info-image">
        {% if collection.image %}
          {{ collection.image | image_url: width: 600 | image_tag: 
             alt: collection.title,
             loading: 'lazy',
             widths: '300, 400, 500, 600, 700, 800'
          }}
        {% elsif collection.featured_image %}
          {{ collection.featured_image | image_url: width: 600 | image_tag: 
             alt: collection.title,
             loading: 'lazy',
             widths: '300, 400, 500, 600, 700, 800'
          }}
        {% endif %}
      </div>
      
      <div class="collection-info-content">
        <h2 class="collection-info-title">{{ collection.title }}</h2>
        {% if collection.description != blank %}
          <div class="collection-info-description">
            {{ collection.description }}
          </div>
        {% endif %}
        <a href="{{ collection.url }}" class="collection-info-link">
          查看完整系列 →
        </a>
      </div>
    </div>
  </div>

  <style>
    .collection-info-section {
      margin: 40px 0;
      padding: 0 20px;
    }
    
    .collection-info-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
    }
    
    .collection-info-image {
      width: 100%;
    }
    
    .collection-info-image img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 8px;
      object-fit: cover;
    }
    
    .collection-info-content {
      padding: 20px;
    }
    
    .collection-info-title {
      font-size: 28px;
      font-weight: bold;
      margin-bottom: 16px;
      color: #000;
    }
    
    .collection-info-description {
      font-size: 16px;
      line-height: 1.6;
      margin-bottom: 24px;
      color: #666;
    }
    
    .collection-info-link {
      display: inline-block;
      padding: 12px 24px;
      background-color: #000;
      color: #fff;
      text-decoration: none;
      border-radius: 4px;
      transition: background-color 0.3s ease;
      font-weight: 500;
    }
    
    .collection-info-link:hover {
      background-color: #333;
    }
    
    /* 响应式设计 */
    @media (max-width: 768px) {
      .collection-info-container {
        grid-template-columns: 1fr;
        gap: 24px;
      }
      
      .collection-info-content {
        padding: 10px;
      }
      
      .collection-info-title {
        font-size: 24px;
      }
    }
  </style>
{% endif %}

{% schema %}
{
  "name": "产品系列信息",
  "tag": "section",
  "class": "section-collection-info",
  "settings": [
    {
      "type": "header",
      "content": "显示设置"
    },
    {
      "type": "checkbox",
      "id": "show_link",
      "label": "显示查看系列链接",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "图片比例",
      "options": [
        {
          "value": "auto",
          "label": "原始比例"
        },
        {
          "value": "1/1",
          "label": "正方形 (1:1)"
        },
        {
          "value": "4/3",
          "label": "横向 (4:3)"
        },
        {
          "value": "16/9",
          "label": "宽屏 (16:9)"
        }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "section_spacing",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "上下间距",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "产品系列信息"
    }
  ]
}
{% endschema %}
