{% comment %}
  Section: Collection Info on Product Page
  显示产品所属系列的图片和描述
{% endcomment %}

{% if product.collections.first %}
  {% assign collection = product.collections.first %}
  
  <div class="collection-info-section">
    <div class="collection-info-container">
      <div class="collection-info-image">
        {% if collection.image %}
          <img 
            src="{{ collection.image | image_url: width: 600 }}"
            alt="{{ collection.title }}"
            loading="lazy"
            width="600"
            height="{{ 600 | divided_by: collection.image.aspect_ratio | round }}"
          >
        {% endif %}
      </div>
      
      <div class="collection-info-content">
        <h2 class="collection-info-title">{{ collection.title }}</h2>
        {% if collection.description != blank %}
          <div class="collection-info-description">
            {{ collection.description }}
          </div>
        {% endif %}
        <a href="{{ collection.url }}" class="collection-info-link">
          查看系列 →
        </a>
      </div>
    </div>
  </div>

  <style>
    .collection-info-section {
      margin: 40px 0;
      padding: 0 20px;
    }
    
    .collection-info-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
      max-width: 1200px;
      margin: 0 auto;
    }
    
    .collection-info-image img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 8px;
    }
    
    .collection-info-content {
      padding: 20px;
    }
    
    .collection-info-title {
      font-size: 28px;
      font-weight: bold;
      margin-bottom: 16px;
    }
    
    .collection-info-description {
      font-size: 16px;
      line-height: 1.6;
      margin-bottom: 24px;
      color: #666;
    }
    
    .collection-info-link {
      display: inline-block;
      padding: 12px 24px;
      background-color: #000;
      color: #fff;
      text-decoration: none;
      border-radius: 4px;
      transition: background-color 0.3s;
    }
    
    .collection-info-link:hover {
      background-color: #333;
    }
    
    @media (max-width: 768px) {
      .collection-info-container {
        grid-template-columns: 1fr;
        gap: 24px;
      }
    }
  </style>
{% endif %}
