{% comment %}
  Text and Image Section
{% endcomment %}

<style>
  .text-image-section {
    padding: 5rem 1.5rem;
    background: white;
  }
  
  .text-image-section .container {
    max-width: 80rem;
    margin: 0 auto;
  }
  
  .text-image-section .content-wrapper {
    display: flex;
    align-items: center;
    gap: 3rem;
  }
  
  .text-image-section .content-wrapper.image-left {
    flex-direction: row-reverse;
  }
  
  .text-image-section .content-wrapper.image-right {
    flex-direction: row;
  }
  
  .text-image-section .text-module {
    flex: 1;
    max-width: 50%;
  }
  
  .text-image-section .text-module.text-left {
    text-align: left;
  }
  
  .text-image-section .text-module.text-center {
    text-align: center;
  }
  
  .text-image-section .text-module.text-right {
    text-align: right;
  }
  
  .text-image-section .image-module {
    flex: 1;
    max-width: 50%;
    display: flex;
  }
  
  .text-image-section .super-title {
    font-size: 2.5rem;
    font-family: 'Noto Serif', serif;
    font-weight: 500;
    color: #4a3f32;
    margin-bottom: 1.5rem;
    line-height: 1.2;
  }
  
  .text-image-section .image-with-text__subheading {
    margin-top: 16px;
    font-weight: 500;
    line-height: 1.5;
    word-break: break-word;
  }
  
  .text-image-section .content-text {
    font-size: 1.125rem;
    line-height: 1.6;
    margin-top: 16px;
    margin-bottom: 2rem;
    color: var(--color-text-secondary);
  }
  
  .text-image-section .content-text p {
    margin-bottom: 1rem;
  }
  
  .text-image-section .content-text p:last-child {
    margin-bottom: 0;
  }
  
  /* 图片布局样式 */
  .text-image-section .image-container {
    position: relative;
    width: 100%;
    height: 100%;
  }
  
  /* 响应式图片显示 */
  .text-image-section .desktop-image {
    display: block;
  }
  
  .text-image-section .mobile-image {
    display: none;
  }
  
  /* 所有图片通用样式 */
  .text-image-section img {
    border-radius: var(--global-border-radius);
    transition: all 0.3s ease;
  }
  
  .text-image-section img:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }
  
  /* 单张图片 */
  .text-image-section .layout-single {
    width: 100%;
    height: 100%;
  }
  
  .text-image-section .layout-single .single-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }
  
  /* 双图片垂直布局 - 左右排列 */
  .text-image-section .layout-double-vertical {
    display: flex;
    gap: 1.5rem;
    width: 100%;
    height: 100%;
  }
  
  .text-image-section .layout-double-vertical .image-item {
    flex: 1;
    height: 100%;
  }
  
  .text-image-section .layout-double-vertical .double-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }
  
  /* 双图片水平布局 - 上下排列 */
  .text-image-section .layout-double-horizontal {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
    height: 100%;
  }
  
  .text-image-section .layout-double-horizontal .image-item {
    flex: 1;
    width: 100%;
  }
  
  .text-image-section .layout-double-horizontal .double-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }
  
  /* 双图片垂直偏移布局 - 重叠效果 */
  .text-image-section .layout-double-vertical-offset {
    position: relative;
    width: 100%;
    height: 100%;
  }
  
  .text-image-section .layout-double-vertical-offset .image-item {
    position: absolute;
    width: 60%;
    height: 100%;
  }
  
  .text-image-section .layout-double-vertical-offset .image-item:first-child {
    left: 0;
    z-index: 1;
  }
  
  .text-image-section .layout-double-vertical-offset .image-item:last-child {
    right: 0;
    top: -20px;
    z-index: 2;
  }
  
  .text-image-section .layout-double-vertical-offset .double-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }
  
  /* 双图片大小布局 - 大小图重叠 */
  .text-image-section .layout-double-with-small {
    position: relative;
    width: 100%;
    height: 100%;
  }
  
  .text-image-section .layout-double-with-small .image-item:first-child {
    position: absolute;
    width: 83.33333%;
    height: 100%;
    right: 0;
    z-index: 1;
  }
  
  .text-image-section .layout-double-with-small .image-item:last-child {
    position: absolute;
    width: 34.2986111%;
    height: 50%;
    left: calc(83.33333% - 34.2986111% * 0.5);
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
  }
  
  .text-image-section .layout-double-with-small .double-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }
  
  /* 三张图片布局 */
  .text-image-section .layout-triple {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 1.5rem;
    width: 100%;
    height: 100%;
  }
  
  .text-image-section .layout-triple .image-item:first-child {
    grid-row: 1 / 3;
  }
  
  .text-image-section .layout-triple .triple-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }
  
  /* 响应式设计 */
  @media (max-width: 1024px) {
    .text-image-section .content-wrapper {
      flex-direction: column;
      gap: 2rem;
    }
    
    .text-image-section .text-module,
    .text-image-section .image-module {
      max-width: 100%;
    }
    
    .text-image-section .super-title {
      font-size: 2rem;
    }
  }
  
  @media (max-width: 768px) {
    .text-image-section {
      padding: 3rem 1rem;
    }
    
    .text-image-section .content-wrapper {
      flex-direction: column !important;
      gap: 1.5rem;
    }
    
    /* Mobile端图片在上，文本在下 */
    .text-image-section .content-wrapper .image-module {
      order: 1;
    }
    
    .text-image-section .content-wrapper .text-module {
      order: 2;
    }
    
    .text-image-section .desktop-image {
      display: none;
    }
    
    .text-image-section .mobile-image {
      display: block;
    }
    
    .text-image-section .super-title {
      font-size: 1.75rem;
    }
    
    .text-image-section .content-text {
      font-size: 1rem;
    }
    
    .text-image-section .layout-double-horizontal,
    .text-image-section .layout-double-vertical-offset,
    .text-image-section .layout-double-with-small {
      flex-direction: column;
    }
    
    .text-image-section .layout-double-vertical-offset .image-item:last-child,
    .text-image-section .layout-double-with-small .image-item:last-child {
      margin-top: 0;
    }
    
    .text-image-section .layout-triple {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }
    
    .text-image-section .layout-triple .image-item:first-child {
      grid-row: auto;
    }
  }
</style>

<section class="text-image-section">
  <div class="container">
    <div class="content-wrapper image-{{ section.settings.image_position }}">
      <!-- 文本模块 -->
      <div class="text-module text-{{ section.settings.text_alignment }}">
        {% if section.settings.super_title != blank %}
          <h2 class="super-title">{{ section.settings.super_title }}</h2>
        {% endif %}
        
        {% if section.settings.main_title != blank %}
          <div class="image-with-text__subheading">{{ section.settings.main_title }}</div>
        {% endif %}
        
        {% if section.settings.content_text != blank %}
          <div class="content-text">
            {{ section.settings.content_text }}
          </div>
        {% endif %}
        
        {% if section.settings.button_text != blank and section.settings.button_url != blank %}
          <a href="{{ section.settings.button_url }}" class="image-with-text__button button button--secondary-border">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>
      
      <!-- 图片模块 -->
      <div class="image-module">
        <div class="image-container">
          {% assign desktop_image_count = 0 %}
          {% assign mobile_image_count = 0 %}
          
          {% if section.settings.desktop_image_1 %}
            {% assign desktop_image_count = desktop_image_count | plus: 1 %}
          {% endif %}
          {% if section.settings.desktop_image_2 %}
            {% assign desktop_image_count = desktop_image_count | plus: 1 %}
          {% endif %}
          {% if section.settings.desktop_image_3 %}
            {% assign desktop_image_count = desktop_image_count | plus: 1 %}
          {% endif %}
          
          {% if section.settings.mobile_image_1 %}
            {% assign mobile_image_count = mobile_image_count | plus: 1 %}
          {% endif %}
          {% if section.settings.mobile_image_2 %}
            {% assign mobile_image_count = mobile_image_count | plus: 1 %}
          {% endif %}
          {% if section.settings.mobile_image_3 %}
            {% assign mobile_image_count = mobile_image_count | plus: 1 %}
          {% endif %}
          
          <!-- Desktop Images -->
          <div class="desktop-image">
            {% if desktop_image_count == 1 %}
              <!-- 单张图片 -->
              <div class="layout-single">
                {% if section.settings.desktop_image_1 %}
                  <img 
                    src="{{ section.settings.desktop_image_1 | image_url: width: 800 }}" 
                    class="single-image"
                    loading="lazy"
                  >
                {% endif %}
              </div>
              
            {% elsif desktop_image_count == 2 %}
              <!-- 双张图片 -->
              <div class="layout-{{ section.settings.double_layout }}">
                <div class="image-item">
                  <img 
                    src="{{ section.settings.desktop_image_1 | image_url: width: 600 }}" 
                    class="double-image"
                    loading="lazy"
                  >
                </div>
                
                <div class="image-item">
                  <img 
                    src="{{ section.settings.desktop_image_2 | image_url: width: 600 }}" 
                    class="double-image"
                    loading="lazy"
                  >
                </div>
              </div>
              
            {% elsif desktop_image_count == 3 %}
              <!-- 三张图片 -->
              <div class="layout-triple">
                <div class="image-item">
                  <img 
                    src="{{ section.settings.desktop_image_1 | image_url: width: 600 }}" 
                    class="triple-image"
                    loading="lazy"
                  >
                </div>
                
                <div class="image-item">
                  <img 
                    src="{{ section.settings.desktop_image_2 | image_url: width: 400 }}" 
                    class="triple-image"
                    loading="lazy"
                  >
                </div>
                
                <div class="image-item">
                  <img 
                    src="{{ section.settings.desktop_image_3 | image_url: width: 400 }}" 
                    class="triple-image"
                    loading="lazy"
                  >
                </div>
              </div>
            {% endif %}
          </div>
          
          <!-- Mobile Images -->
          <div class="mobile-image">
            {% assign display_mobile_count = mobile_image_count %}
            {% if mobile_image_count == 0 %}
              {% assign display_mobile_count = desktop_image_count %}
            {% endif %}
            
            {% if display_mobile_count == 1 %}
              <!-- 单张图片 -->
              <div class="layout-single">
                {% if section.settings.mobile_image_1 %}
                  <img 
                    src="{{ section.settings.mobile_image_1 | image_url: width: 800 }}" 
                    class="single-image"
                    loading="lazy"
                  >
                {% elsif section.settings.desktop_image_1 %}
                  <img 
                    src="{{ section.settings.desktop_image_1 | image_url: width: 800 }}" 
                    class="single-image"
                    loading="lazy"
                  >
                {% endif %}
              </div>
              
            {% elsif display_mobile_count == 2 %}
              <!-- 双张图片 -->
              <div class="layout-{{ section.settings.double_layout }}">
                <div class="image-item">
                  {% if section.settings.mobile_image_1 %}
                    <img 
                      src="{{ section.settings.mobile_image_1 | image_url: width: 600 }}" 
                      class="double-image"
                      loading="lazy"
                    >
                  {% elsif section.settings.desktop_image_1 %}
                    <img 
                      src="{{ section.settings.desktop_image_1 | image_url: width: 600 }}" 
                      class="double-image"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
                
                <div class="image-item">
                  {% if section.settings.mobile_image_2 %}
                    <img 
                      src="{{ section.settings.mobile_image_2 | image_url: width: 600 }}" 
                      class="double-image"
                      loading="lazy"
                    >
                  {% elsif section.settings.desktop_image_2 %}
                    <img 
                      src="{{ section.settings.desktop_image_2 | image_url: width: 600 }}" 
                      class="double-image"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
              </div>
              
            {% elsif display_mobile_count == 3 %}
              <!-- 三张图片 -->
              <div class="layout-triple">
                <div class="image-item">
                  {% if section.settings.mobile_image_1 %}
                    <img 
                      src="{{ section.settings.mobile_image_1 | image_url: width: 600 }}" 
                      class="triple-image"
                      loading="lazy"
                    >
                  {% elsif section.settings.desktop_image_1 %}
                    <img 
                      src="{{ section.settings.desktop_image_1 | image_url: width: 600 }}" 
                      class="triple-image"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
                
                <div class="image-item">
                  {% if section.settings.mobile_image_2 %}
                    <img 
                      src="{{ section.settings.mobile_image_2 | image_url: width: 400 }}" 
                      class="triple-image"
                      loading="lazy"
                    >
                  {% elsif section.settings.desktop_image_2 %}
                    <img 
                      src="{{ section.settings.desktop_image_2 | image_url: width: 400 }}" 
                      class="triple-image"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
                
                <div class="image-item">
                  {% if section.settings.mobile_image_3 %}
                    <img 
                      src="{{ section.settings.mobile_image_3 | image_url: width: 400 }}" 
                      class="triple-image"
                      loading="lazy"
                    >
                  {% elsif section.settings.desktop_image_3 %}
                    <img 
                      src="{{ section.settings.desktop_image_3 | image_url: width: 400 }}" 
                      class="triple-image"
                      loading="lazy"
                    >
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Text and Image Section",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "text",
      "id": "super_title",
      "label": "Super Title",
      "info": "Large main title (h2 tag)"
    },
    {
      "type": "text",
      "id": "main_title",
      "label": "Main Title",
      "info": "Small text above main title"
    },
    {
      "type": "richtext",
      "id": "content_text",
      "label": "Content Text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Desktop Images"
    },
    {
      "type": "image_picker",
      "id": "desktop_image_1",
      "label": "Desktop Image 1"
    },
    {
      "type": "image_picker",
      "id": "desktop_image_2",
      "label": "Desktop Image 2"
    },
    {
      "type": "image_picker",
      "id": "desktop_image_3",
      "label": "Desktop Image 3"
    },
    {
      "type": "header",
      "content": "Mobile Images"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_1",
      "label": "Mobile Image 1",
      "info": "If not uploaded, desktop image will be used"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_2",
      "label": "Mobile Image 2",
      "info": "If not uploaded, desktop image will be used"
    },
    {
      "type": "image_picker",
      "id": "mobile_image_3",
      "label": "Mobile Image 3",
      "info": "If not uploaded, desktop image will be used"
    },
    {
      "type": "header",
      "content": "Double Image Layout (when 2 images uploaded)"
    },
    {
      "type": "select",
      "id": "double_layout",
      "label": "Double Image Layout",
      "options": [
        {
          "value": "double_vertical",
          "label": "Side by Side"
        },
        {
          "value": "double_horizontal",
          "label": "Stacked"
        },
        {
          "value": "double_vertical_offset",
          "label": "Overlapped"
        },
        {
          "value": "double_with_small",
          "label": "Large with Small"
        }
      ],
      "default": "double_vertical",
      "info": "Layout style when exactly 2 images are uploaded"
    }
  ],
  "presets": [
    {
      "name": "Text and Image Section",
      "settings": {
        "super_title": "Crafting Mindful Experiences",
        "main_title": "About Us",
        "content_text": "<p>We believe in creating products that bring peace and mindfulness to your daily life. Every piece is carefully crafted with attention to detail and respect for traditional techniques.</p>",
        "button_text": "Learn More",
        "image_position": "right",
        "text_alignment": "left",
        "double_layout": "double_vertical"
      }
    }
  ]
}
{% endschema %}
