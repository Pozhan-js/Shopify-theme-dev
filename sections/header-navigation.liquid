<header>
  <div class="nav-blur">
    <nav class="nav-container">
      <div class="nav-flex">
        <!-- Logo -->
        <div class="logo-container">
          <a href="{{ routes.root_url }}">
            {% if section.settings.logoimage %}
              <div class="logo-image">
                {% assign logosize2x = section.settings.logosize | default: 48 | times: 2 %}
                <img
                  src="{{ section.settings.logoimage | image_url: width: logosize2x }}"
                  alt="{{ section.settings.sitename | default: shop.name }}"
                  width="{{ section.settings.logosize | default: 48 }}"
                  height="{{ section.settings.logosize | default: 48 }}">
              </div>
            {% else %}
              <div class="logo-bg">
                <span>{{ section.settings.logotext | default: 'XS' }}</span>
              </div>
            {% endif %}
          </a>
        </div>

        <!-- Desktop Navigation -->
        <div class="desktop-nav">
          {% assign mainmenu = linklists[section.settings.mainmenu] %}
          {% if mainmenu and mainmenu.links.size > 0 %}
            {% for link in mainmenu.links %}
              {% assign linkhandle = link.title | handleize %}
              
              {% if linkhandle == 'pilates-equipment' or linkhandle == 'products' or linkhandle == 'equipment' %}
                <!-- Equipment Mega Menu with Dynamic Collections -->
                <div class="dropdown has-mega-menu">
                  <span class="nav-item dropdown-trigger" style="cursor: pointer;">
                    <span>{{ link.title | escape }}</span>
                    <span class="dropdown-arrow"></span>
                  </span>
                  <div class="mega-dropdown-menu">
                    <div class="mega-menu-grid">
                      {% render 'mega-menu-dynamic-collections', section: section %}
                      <h1>6666666666</h1>
                      <div class="mega-menu-column">
                        <div class="mega-menu-cta">
                          {% if section.settings.mega_menu_image %}
                            <img src="{{ section.settings.mega_menu_image | image_url: width: 800 }}" alt="{{ section.settings.mega_menu_image_alt | default: 'Pilates Equipment' }}" />
                          {% else %}
                            <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=800&h=1200&fit=crop&crop=center" alt="Pilates Equipment" />
                          {% endif %}
                        </div>
                      </div>
                    </div>
                    <div class="mega-menu-footer">
                      {% if section.settings.contactfootericon %}
                        <div class="mega-menu-footer-icon">
                          <img src="{{ section.settings.contactfootericon | image_url: width: 44 }}" alt="Contact Icon">
                        </div>
                      {% endif %}
                      <span>{{ section.settings.mega_menu_footer_text | default: 'CONTACT US' }}</span>
                    </div>
                  </div>
                </div>
              {% elsif section.settings.enable_mega_menu and linkhandle == section.settings.mega_menu_handle %}
                <!-- Mega Menu -->
                {% render 'mega-menu', 
                   link: link, 
                   section: section,
                   menu_type: section.settings.mega_menu_type %}
              {% elsif link.links.size > 0 %}
                <!-- Regular Dropdown Menu -->
                {% render 'dropdown-menu', link: link %}
              {% else %}
                <!-- Simple Link -->
                <a href="{{ link.url }}" class="nav-item">
                  {{ link.title | escape }}
                </a>
              {% endif %}
            {% endfor %}
          {% else %}
            <!-- Default Menu Items -->
            {% render 'default-navigation' %}
          {% endif %}
        </div>

        <!-- Right Side Actions -->
        <div class="right-actions">
          <!-- Contact Us Button -->
          <a href="{{ section.settings.contactlink }}" class="contact-badge">
            <span>{{ section.settings.contacttext | default: 'Contact Us' | escape }}</span>
            <div class="contact-arrow-icon">
              <svg
                viewBox="0 0 10.417 10.3762"
                xmlns="http://www.w3.org/2000/svg"
                width="10.416992"
                height="10.376221"
                fill="none">
                <g>
                  <path
                    d="M-0.353553 3.26282L3.61638 -0.707107L7.58631 3.26282L6.8792 3.96993L3.26282 0.353553L3.61638 0L3.96993 0.353553L0.353553 3.96993L-0.353553 3.26282Z"
                    fill="rgb(255,255,255)"
                    fill-rule="nonzero"
                    transform="matrix(0.708494,0.705717,-0.708494,0.705716,5.29272,0)" />
                  <line
                    x1="0"
                    x2="7.23275518"
                    y1="0"
                    y2="0"
                    stroke="rgb(255,255,255)"
                    stroke-width="1"
                    transform="matrix(-0.708494,0.705716,-0.708494,-0.705717,7.73047,2.76355)" />
                </g>
              </svg>
            </div>
          </a>

          <!-- Search Icon -->
          <button class="search-icon" onclick="toggleSearch()">
            <svg
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>

          <!-- Mobile Menu Button -->
          <button class="mobile-menu-toggle" onclick="toggleMobileMenu()">
            <svg
              class="menu-icon"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg
              class="close-icon"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              style="display: none;">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </nav>

    <!-- Mobile Menu -->
    {% render 'mobile-menu', section: section %}
  </div>
</header>

<script>
function toggleMobileMenu() {
  const mobileMenu = document.getElementById('mobileMenu');
  const menuIcon = document.querySelector('.menu-icon');
  const closeIcon = document.querySelector('.close-icon');
  
  if (mobileMenu.style.display === 'none' || mobileMenu.style.display === '') {
    mobileMenu.style.display = 'block';
    menuIcon.style.display = 'none';
    closeIcon.style.display = 'block';
  } else {
    mobileMenu.style.display = 'none';
    menuIcon.style.display = 'block';
    closeIcon.style.display = 'none';
  }
}

function toggleSubmenu(submenuId) {
  const submenu = document.getElementById(submenuId);
  if (submenu.style.display === 'none' || submenu.style.display === '') {
    submenu.style.display = 'flex';
  } else {
    submenu.style.display = 'none';
  }
}

function toggleSearch() {
  console.log('Search clicked');
}
</script>

