<style>
  /* Header Navigation Styles */
  .nav-blur {
    backdrop-filter: blur(12px);
    background: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.15);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    border-radius: 0;
    margin: 0;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
  }

  .nav-container {
    padding: 8px 16px;
    min-height: calc(32px + 16px);
    display: flex;
    align-items: center;
  }

  .nav-flex {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 100%;
    width: 100%;
  }

  .logo-container {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 100%;
  }

  .logo-bg {
    background: #DC2626;
    color: #FFFFFF;
    width: 32px;
    height: calc(32px + 8px);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 16px;
    text-decoration: none;
  }

  .logo-bg span {
    color: #FFFFFF;
    font-weight: bold;
    font-size: inherit;
    line-height: 1;
  }

  .logo-image {
    height: calc(32px + 8px);
    border-radius: 6px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-image img {
    height: 100%;
    width: auto;
    border-radius: 6px;
  }

  .logo-container {
    display: flex;
    align-items: center;
  }

  .logo-container a {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 24px;
    margin-left: 32px;
  }

  .dropdown {
    position: relative;
    white-space: nowrap;
  }

  .nav-item {
    color: #161616;
    font-weight: 500;
    font-size: 16px;
    letter-spacing: 0.01em;
    transition: all 0.2s ease;
    text-decoration: none;
    display: flex;
    align-items: center;
    padding: 8px 10px;
    min-width: fit-content;
    height: 32px;
  }

  .nav-item:hover {
    color: #374151;
    border-bottom: 1.5px solid #C22E35;
  }

  .dropdown:hover .nav-item {
    color: #374151;
    border-bottom: 1.5px solid #C22E35;
  }

  .dropdown-arrow::after {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-left: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    transition: transform 0.2s ease;
    vertical-align: baseline;
  }

  .dropdown:hover .dropdown-arrow::after {
    transform: rotate(225deg) translateY(-1px);
  }

  .dropdown-menu {
    background: #FFFCFC;
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15);
    position: absolute;
    top: 100%;
    left: 0;
    margin-top: 8px;
    width: 192px;
    border-radius: 8px;
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s ease;
  }

  .dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
  }

  .dropdown-item {
    display: block;
    padding: 8px 16px;
    font-size: 16px;
    color: #374151;
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .dropdown-item:hover {
    background: #F3F4F6;
    color: #111827;
  }

  .right-actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .contact-badge {
    background: none;
    border: none;
    padding: 0;
    display: none;
    align-items: center;
    gap: 8px;
    color: #161616;
    font-size: 16px;
    font-weight: 500;
    transition: all 0.3s ease;
    cursor: pointer;
    text-decoration: none;
    height: 32px;
  }

  .contact-badge:hover {
    color: #374151;
  }

  .contact-arrow-icon {
    background: #B33C3B;
    width: 20px;
    height: 20px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .contact-badge:hover .contact-arrow-icon {
    background: #9A2F2E;
    transform: translateX(2px) translateY(-2px);
  }

  .search-icon {
    transition: all 0.3s ease;
    color: #161616;
    background: none;
    border: none;
    padding: 8px;
    cursor: pointer;
    border-radius: 4px;
    height: 32px;
    width: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .search-icon:hover {
    transform: scale(1.1);
    color: #DC2626;
  }

  .mobile-menu-toggle {
    background: none;
    border: none;
    color: #161616;
    padding: 8px;
    cursor: pointer;
    display: flex;
    height: 32px;
    width: 32px;
    align-items: center;
    justify-content: center;
  }

  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #FFFCFC;
    border: 1px solid rgba(0, 0, 0, 0.15);
    border-top: none;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    display: none;
    padding: 16px;
  }

  .mobile-menu-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .mobile-menu-item {
    width: 100%;
    text-align: left;
    color: #161616;
    background: none;
    border: none;
    padding: 12px 0;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: color 0.2s ease;
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .mobile-menu-item:last-child {
    border-bottom: none;
  }

  .mobile-menu-item:hover {
    color: #374151;
  }

  .mobile-submenu {
    margin-left: 0;
    margin-top: 8px;
    padding-left: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-left: 2px solid rgba(0, 0, 0, 0.2);
  }

  .mobile-submenu-item {
    color: #6B7280;
    text-decoration: none;
    padding: 8px 0;
    font-size: 16px;
    transition: color 0.2s ease;
  }

  .mobile-submenu-item:hover {
    color: #161616;
  }

  .mobile-contact-badge {
    background: none;
    border: none;
    padding: 16px 0;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 8px;
    color: #161616;
    font-size: 16px;
    font-weight: 500;
    margin-top: 16px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s ease;
    border-top: 1px solid rgba(0, 0, 0, 0.2);
  }

  .mobile-contact-badge:hover {
    color: #374151;
  }

  .mobile-contact-badge .contact-arrow-icon {
    width: 18px;
    height: 18px;
  }

  /* Responsive styles */
    @media (max-width: 480px) {
    .nav-container {
      padding: 6px 12px;
      min-height: 48px;
    }

    .logo-bg {
      width: 28px;
      height: 32px;
      font-size: 14px;
    }

    .logo-image {
      height: 32px;
    }

    .nav-item {
      font-size: 16px;
      padding: 6px 8px;
      height: 28px;
    }

    .search-icon {
      height: 28px;
      width: 28px;
      padding: 6px;
    }

    .mobile-menu-toggle {
      height: 28px;
      width: 28px;
      padding: 6px;
    }

    .right-actions {
      gap: 12px;
    }
  }

  @media (min-width: 481px) and (max-width: 768px) {
    .nav-container {
      padding: 8px 16px;
      min-height: 52px;
    }

    .logo-bg {
      width: 30px;
      height: 36px;
      font-size: 15px;
    }

    .logo-image {
      height: 36px;
    }

    .nav-item {
      font-size: 16px;
      padding: 7px 9px;
      height: 30px;
    }

    .search-icon {
      height: 30px;
      width: 30px;
      padding: 7px;
    }

    .mobile-menu-toggle {
      height: 30px;
      width: 30px;
      padding: 7px;
    }

    .right-actions {
      gap: 14px;
    }
  }

  @media (min-width: 769px) and (max-width: 1023px) {
    .nav-blur {
      border-radius: 16px;
      margin-top: 30px;
      margin-left: auto;
      margin-right: auto;
      width: 95%;
      max-width: 1200px;
    }

    .nav-container {
      padding: 8px 24px;
      min-height: 48px;
    }

    .logo-bg {
      width: 111px;
      height: 31px;
      font-size: 13px;
    }

    .logo-bg span {
      font-size: 13px;
    }

    .logo-image {
      height: 31px;
    }

    .logo-image img {
      width: 111px;
      height: 31px;
    }

    .nav-item {
      height: 32px;
      font-size: 13px;
    }

    .search-icon {
      height: 32px;
      width: 32px;
    }

    .mobile-menu-toggle {
      height: 32px;
      width: 32px;
    }

    .desktop-nav {
      display: flex;
      flex: 1;
      justify-content: flex-start;
      gap: 20px;
      margin-left: 24px;
    }

    .contact-badge {
      display: flex;
      height: 32px;
    }

    .mobile-menu {
      display: none !important;
    }
  }

  @media (min-width: 1024px) and (max-width: 1279px) {
    .nav-blur {
      border-radius: 16px;
      margin-top: 35px;
      margin-left: auto;
      margin-right: auto;
      width: 95%;
      max-width: 1300px;
    }

    .nav-container {
      padding: 8px 28px;
      min-height: 52px;
    }

    .logo-bg {
      width: 141px;
      height: 40px;
      font-size: 14px;
    }

    .logo-bg span {
      font-size: 14px;
    }

    .logo-image {
      height: 40px;
    }

    .logo-image img {
      width: 141px;
      height: 40px;
    }

    .nav-item {
      height: 32px;
      font-size: 14px;
    }

    .contact-badge {
      display: flex;
      height: 32px;
    }

    .contact-arrow-icon {
      width: 20px;
      height: 20px;
    }

    .search-icon {
      height: 32px;
      width: 32px;
    }

    .mobile-menu-toggle {
      display: none;
    }

    .desktop-nav {
      display: flex;
      flex: 1;
      justify-content: flex-start;
      gap: 24px;
      margin-left: 28px;
    }

    .mobile-menu {
      display: none !important;
    }
  }

  @media (min-width: 1280px) and (max-width: 1919px) {
    .nav-blur {
      border-radius: 16px;
      margin-top: 40px;
      margin-left: auto;
      margin-right: auto;
      width: 95%;
    }

    .nav-container {
      padding: 8px 30px;
      min-height: 60px;
      height: 60px;
    }

    .logo-bg {
      width: 171px;
      height: 48px;
      font-size: 14px;
    }

    .logo-bg span {
      font-size: 14px;
    }

    .logo-image {
      height: 48px;
    }

    .logo-image img {
      width: 171px;
      height: 48px;
    }

    .nav-item {
      height: 32px;
      font-size: 14px;
    }

    .contact-badge {
      display: flex;
      height: 32px;
      font-size: 14px;
    }

    .contact-arrow-icon {
      width: 14px;
      height: 14px;
    }

    .search-icon {
      height: 32px;
      width: 32px;
    }

    .search-icon svg {
      width: 16px;
      height: 16px;
    }

    .mobile-menu-toggle {
      display: none;
    }

    .desktop-nav {
      display: flex;
      flex: 1;
      justify-content: flex-start;
      gap: 24px;
      margin-left: 30px;
    }

    .mobile-menu {
      display: none !important;
    }
  }

  @media (min-width: 1920px) {
    .nav-blur {
      border-radius: 16px;
      margin-top: 46.825px;
      margin-left: auto;
      margin-right: auto;
      width: 1654px;
    }

    .nav-container {
      padding: 8px 32px;
      min-height: 72px;
      height: 72px;
    }

    .logo-bg {
      width: 201px;
      height: 57px;
      font-size: 16px;
    }

    .logo-bg span {
      font-size: 16px;
    }

    .logo-image {
      height: 57px;
    }

    .logo-image img {
      width: 201px;
      height: 57px;
    }

    .nav-item {
      height: 32px;
      font-size: 16px;
    }

    .contact-badge {
      display: flex;
      height: 32px;
    }

    .contact-arrow-icon {
      width: 14px;
      height: 14px;
    }

    .search-icon {
      height: 32px;
      width: 32px;
    }

    .search-icon svg {
      width: 16px;
      height: 16px;
    }

    .mobile-menu-toggle {
      display: none;
    }

    .desktop-nav {
      display: flex;
      flex: 1;
      justify-content: flex-start;
      gap: 24px;
      margin-left: 32px;
    }

    .mobile-menu {
      display: none !important;
    }
  }
</style>

<header>
  <div class="nav-blur">
    <nav class="nav-container">
      <div class="nav-flex">
        <!-- Logo -->
        <div class="logo-container">
          <a href="{{ routes.root_url }}">
            {% if section.settings.logoimage %}
              <div class="logo-image">
                {% assign logosize2x = section.settings.logosize | default: 48 | times: 2 %}
                <img
                  src="{{ section.settings.logoimage | img_url: logosize2x }}"
                  alt="{{ section.settings.sitename | default: shop.name }}"
                  width="{{ section.settings.logosize | default: 48 }}"
                  height="{{ section.settings.logosize | default: 48 }}">
              </div>
            {% else %}
              <div class="logo-bg">
                <span>{{ section.settings.logotext | default: 'XS' }}</span>
              </div>
            {% endif %}
          </a>
        </div>

        <!-- Desktop Navigation -->
        <div class="desktop-nav">
          {% comment %} 直接显示所有自定义导航项目 {% endcomment %}
          {% for block in section.blocks %}
            {% if block.type == 'nav_item' %}
              {% if block.settings.show_dropdown %}
                <!-- Custom Dropdown Menu -->
                <div class="dropdown" {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.nav_url | default: '#' }}" class="nav-item dropdown-arrow">
                    {{ block.settings.nav_title | escape }}
                  </a>
                  <div class="dropdown-menu">
                    {% comment %} 查找对应的下拉菜单项目 {% endcomment %}
                    {% assign current_nav_index = forloop.index %}
                    {% for dropdown_block in section.blocks %}
                      {% if dropdown_block.type == 'dropdown_item' and dropdown_block.settings.parent_nav == current_nav_index %}
                        <a href="{{ dropdown_block.settings.dropdown_url | default: '#' }}" class="dropdown-item" {{ dropdown_block.shopify_attributes }}>
                          {{ dropdown_block.settings.dropdown_title | escape }}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
              {% else %}
                <!-- Simple Custom Link -->
                <a href="{{ block.settings.nav_url | default: '#' }}" class="nav-item" {{ block.shopify_attributes }}>
                  {{ block.settings.nav_title | escape }}
                </a>
              {% endif %}
            {% endif %}
          {% endfor %}
          
          {% comment %} 如果没有任何导航项目，显示默认菜单 {% endcomment %}
          {% assign nav_count = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'nav_item' %}
              {% assign nav_count = nav_count | plus: 1 %}
            {% endif %}
          {% endfor %}
          
          {% if nav_count == 0 %}
            <!-- Default Menu Items -->
            <a href="#" class="nav-item">Pilates Equipment</a>
            <a href="#" class="nav-item">Resources</a>
            <a href="#" class="nav-item">About Us</a>
          {% endif %}
        </div>

        <!-- Right Side Actions -->
        <div class="right-actions">
          <!-- Contact Us Button -->
          <a href="{{ section.settings.contactlink }}" class="contact-badge">
            <span>{{ section.settings.contacttext | default: 'Contact Us' | escape }}</span>
            <div class="contact-arrow-icon">
              <svg
                viewBox="0 0 10.417 10.3762"
                xmlns="http://www.w3.org/2000/svg"
                xmlns:xlink="http://www.w3.org/1999/xlink"
                width="10.416992"
                height="10.376221"
                fill="none"
                customFrame="#000000">
                <g id="组合 24">
                <g id="组合 3">
                  <path
                    id="多边形 7"
                    d="M-0.353553 3.26282L3.61638 -0.707107L7.58631 3.26282L6.8792 3.96993L3.26282 0.353553L3.61638 0L3.96993 0.353553L0.353553 3.96993L-0.353553 3.26282Z"
                    fill="rgb(255,255,255)"
                    fill-rule="nonzero"
                    transform="matrix(0.708494,0.705717,-0.708494,0.705716,5.29272,0)" />
                  <line
                    id="直线 2"
                    x1="0"
                    x2="7.23275518"
                    y1="0"
                    y2="0"
                    stroke="rgb(255,255,255)"
                    stroke-width="1"
                    transform="matrix(-0.708494,0.705716,-0.708494,-0.705717,7.73047,2.76355)" />
                </g>
              </g>
            </svg>
          </div>
        </a>

        <!-- Search Icon -->
        <button class="search-icon" onclick="toggleSearch()">
          <svg
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <!-- Mobile Menu Button -->
        <button class="mobile-menu-toggle" onclick="toggleMobileMenu()">
          <svg
            class="menu-icon"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg
            class="close-icon"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            style="display: none;">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div class="mobile-menu" id="mobileMenu">
      <div class="mobile-menu-content">
        {% comment %} 直接显示所有自定义移动端导航项目 {% endcomment %}
        {% for block in section.blocks %}
          {% if block.type == 'nav_item' %}
            {% if block.settings.show_dropdown %}
              <!-- Custom Mobile Dropdown -->
              <div {{ block.shopify_attributes }}>
                <button class="mobile-menu-item" onclick="toggleSubmenu('mobile-submenu-{{ forloop.index }}')">
                  {{ block.settings.nav_title | escape }}
                </button>
                <div class="mobile-submenu" id="mobile-submenu-{{ forloop.index }}" style="display: none;">
                  {% comment %} 查找对应的下拉菜单项目 {% endcomment %}
                  {% assign current_nav_index = forloop.index %}
                  {% for dropdown_block in section.blocks %}
                    {% if dropdown_block.type == 'dropdown_item' and dropdown_block.settings.parent_nav == current_nav_index %}
                      <a href="{{ dropdown_block.settings.dropdown_url | default: '#' }}" class="mobile-submenu-item" {{ dropdown_block.shopify_attributes }}>
                        {{ dropdown_block.settings.dropdown_title | escape }}
                      </a>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            {% else %}
              <!-- Simple Custom Mobile Link -->
              <a href="{{ block.settings.nav_url | default: '#' }}" class="mobile-menu-item" {{ block.shopify_attributes }}>
                {{ block.settings.nav_title | escape }}
              </a>
            {% endif %}
          {% endif %}
        {% endfor %}
        
        {% comment %} 如果没有任何导航项目，显示默认菜单 {% endcomment %}
        {% assign nav_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'nav_item' %}
            {% assign nav_count = nav_count | plus: 1 %}
          {% endif %}
        {% endfor %}
        
        {% if nav_count == 0 %}
          <!-- Default Mobile Menu Items -->
          <a href="#" class="mobile-menu-item">Pilates Equipment</a>
          <a href="#" class="mobile-menu-item">Resources</a>
          <a href="#" class="mobile-menu-item">About Us</a>
        {% endif %}

        <a href="{{ section.settings.contactlink }}" class="mobile-contact-badge">
          <span>{{ section.settings.contacttext | default: 'Contact Us' | escape }}</span>
          <div class="contact-arrow-icon">
            <svg
              viewBox="0 0 10.417 10.3762"
              xmlns="http://www.w3.org/2000/svg"
              xmlns:xlink="http://www.w3.org/1999/xlink"
              width="10.416992"
              height="10.376221"
              fill="none"
              customFrame="#000000">
              <g id="组合 24">
              <g id="组合 3">
                <path
                  id="多边形 7"
                  d="M-0.353553 3.26282L3.61638 -0.707107L7.58631 3.26282L6.8792 3.96993L3.26282 0.353553L3.61638 0L3.96993 0.353553L0.353553 3.96993L-0.353553 3.26282Z"
                  fill="rgb(255,255,255)"
                  fill-rule="nonzero"
                  transform="matrix(0.708494,0.705717,-0.708494,0.705716,5.29272,0)" />
                <line
                  id="直线 2"
                  x1="0"
                  x2="7.23275518"
                  y1="0"
                  y2="0"
                  stroke="rgb(255,255,255)"
                  stroke-width="1"
                  transform="matrix(-0.708494,0.705716,-0.708494,-0.705717,7.73047,2.76355)" />
              </g>
            </g>
          </svg>
        </div>
      </a>
    </div>
  </div>
</header>

<script>
function toggleMobileMenu() {
  const mobileMenu = document.getElementById('mobileMenu');
  const menuIcon = document.querySelector('.menu-icon');
  const closeIcon = document.querySelector('.close-icon');
  
  if (mobileMenu.style.display === 'none' || mobileMenu.style.display === '') {
    mobileMenu.style.display = 'block';
    menuIcon.style.display = 'none';
    closeIcon.style.display = 'block';
  } else {
    mobileMenu.style.display = 'none';
    menuIcon.style.display = 'block';
    closeIcon.style.display = 'none';
  }
}

function toggleSubmenu(submenuId) {
  const submenu = document.getElementById(submenuId);
  if (submenu.style.display === 'none' || submenu.style.display === '') {
    submenu.style.display = 'flex';
  } else {
    submenu.style.display = 'none';
  }
}

function toggleSearch() {
  // 搜索功能实现
  console.log('Search clicked');
}
</script>

