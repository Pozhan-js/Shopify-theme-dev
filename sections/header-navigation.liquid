    }

    .mega-menu-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .nav-mega-cta-container {
      grid-column: span 2;
      min-height: 200px;
    }

    .nav-mega-cta-image {
      width: 140px;
