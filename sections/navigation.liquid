<!-- sections/ajax-navigation.liquid -->
{% schema %}
{
  "name": "AJAX Navigation",
  "settings": [
    {
      "type": "text",
      "id": "main_content_selector",
      "label": "主内容区域选择器",
      "default": "#MainContent",
      "info": "要替换的主内容区域的 CSS 选择器，例如：#MainContent 或 .main-content"
    }
  ],
  "blocks": [
    {
      "type": "nav_button",
      "name": "导航按钮",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "按钮文字",
          "default": "CATEGORY"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "按钮链接"
        },
        {
          "type": "checkbox",
          "id": "is_highlighted",
          "label": "高亮显示",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AJAX Navigation",
      "blocks": [
        {
          "type": "nav_button",
          "settings": {
            "button_text": "FEATURED",
            "button_link": "/collections/featured"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "SKIN",
            "button_link": "/collections/skin"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "LIP+CHEEK",
            "button_link": "/collections/lip-cheek"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "SETS",
            "button_link": "/collections/sets"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "AWARD WINNERS",
            "button_link": "/collections/award-winners"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "SHOP ALL",
            "button_link": "/collections/all",
            "is_highlighted": true
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .ajax-navigation {
    padding: 40px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ajax-navigation__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
    align-items: center;
  }

  .ajax-nav-button {
    padding: 12px 30px;
    border-radius: 50px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    border: 2px solid #333;
    background: none;
  }

  .ajax-nav-button--outlined {
    background-color: transparent;
    color: #333;
  }

  .ajax-nav-button--outlined:hover,
  .ajax-nav-button--outlined.active {
    background-color: #333;
    color: #fff;
  }

  .ajax-nav-button--filled {
    background-color: #333;
    color: #fff;
  }

  .ajax-nav-button--filled:hover {
    background-color: #555;
    border-color: #555;
  }

  .ajax-nav-button.loading {
    opacity: 0.6;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .ajax-navigation {
      padding: 30px 15px;
    }
    
    .ajax-nav-button {
      padding: 10px 20px;
      font-size: 12px;
    }
  }
</style>

<div class="ajax-navigation" data-ajax-nav="{{ section.id }}">
  <div class="ajax-navigation__buttons">
    {% for block in section.blocks %}
      {% if block.type == 'nav_button' %}
        <button 
          type="button"
          class="ajax-nav-button {% if block.settings.is_highlighted %}ajax-nav-button--filled{% else %}ajax-nav-button--outlined{% endif %}"
          data-url="{{ block.settings.button_link }}"
          data-selector="{{ section.settings.main_content_selector }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.button_text }}
        </button>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
(function() {
  const SECTION_ID = "{{ section.id }}";
  const MAIN_SELECTOR = "{{ section.settings.main_content_selector }}";
  let isLoading = false;

  // 使用 document 级别的事件委托，确保动态加载的按钮也能响应
  document.addEventListener('click', function(e) {
    const button = e.target.closest(`[data-ajax-nav="${SECTION_ID}"] .ajax-nav-button`);
    if (!button || isLoading) return;
    
    e.preventDefault();
    
    const url = button.dataset.url;
    const selector = button.dataset.selector || MAIN_SELECTOR;
    
    if (!url) return;
    
    // 更新按钮状态
    updateButtonStates(url);
    
    // 加载新页面内容
    loadPageContent(url, selector);
  });

  /**
   * 更新所有导航按钮的激活状态
   */
  function updateButtonStates(activeUrl) {
    const allButtons = document.querySelectorAll(`[data-ajax-nav="${SECTION_ID}"] .ajax-nav-button`);
    
    allButtons.forEach(btn => {
      try {
        const btnUrl = new URL(btn.dataset.url, window.location.origin);
        const targetUrl = new URL(activeUrl, window.location.origin);
        
        if (btnUrl.pathname === targetUrl.pathname) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      } catch (error) {
        console.error('Invalid URL:', btn.dataset.url);
      }
    });
  }

  /**
   * 通过 AJAX 加载页面内容
   */
  async function loadPageContent(url, selector) {
    if (isLoading) return;
    
    isLoading = true;
    
    // 添加加载状态
    const allButtons = document.querySelectorAll(`[data-ajax-nav="${SECTION_ID}"] .ajax-nav-button`);
    allButtons.forEach(btn => btn.classList.add('loading'));
    
    try {
      const response = await fetch(url, {
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      });
      
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      
      const html = await response.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      
      const newContent = doc.querySelector(selector);
      const currentContent = document.querySelector(selector);
      
      if (newContent && currentContent) {
        // 替换内容
        currentContent.innerHTML = newContent.innerHTML;
        
        // 更新页面标题
        const newTitle = doc.querySelector('title');
        if (newTitle) {
          document.title = newTitle.textContent;
        }
        
        // 更新 URL（不触发页面刷新）
        history.pushState({ url, selector }, '', url);
        
        // 平滑滚动到顶部
        window.scrollTo({ 
          top: 0, 
          behavior: 'smooth' 
        });
        
        // 触发自定义事件，通知其他脚本内容已更新
        document.dispatchEvent(new CustomEvent('ajax:pageLoaded', {
          detail: { 
            url,
            selector,
            timestamp: Date.now()
          }
        }));
        
        // 重新初始化 Shopify 动态结账按钮
        if (typeof Shopify !== 'undefined' && Shopify.PaymentButton) {
          Shopify.PaymentButton.init();
        }
        
        // 重新初始化主题相关功能
        if (typeof theme !== 'undefined' && theme.init) {
          theme.init();
        }
        
        // 重新初始化产品表单
        if (typeof window.Shopify !== 'undefined' && window.Shopify.ProductForm) {
          const forms = document.querySelectorAll('form[action*="/cart/add"]');
          forms.forEach(form => {
            new Shopify.ProductForm(form);
          });
        }
        
      } else {
        console.error('Content selector not found:', selector);
        // 如果找不到选择器，直接跳转
        window.location.href = url;
      }
      
    } catch (error) {
      console.error('Error loading page:', error);
      // 出错时回退到正常页面跳转
      window.location.href = url;
    } finally {
      isLoading = false;
      // 移除加载状态
      allButtons.forEach(btn => btn.classList.remove('loading'));
    }
  }

  /**
   * 处理浏览器前进/后退按钮
   */
  window.addEventListener('popstate', function(e) {
    if (e.state && e.state.url) {
      const selector = e.state.selector || MAIN_SELECTOR;
      loadPageContent(e.state.url, selector);
      updateButtonStates(e.state.url);
    }
  });

  /**
   * 页面加载时初始化按钮状态
   */
  function initializeButtonStates() {
    const currentPath = window.location.pathname;
    updateButtonStates(currentPath);
    
    // 保存初始状态到历史记录
    history.replaceState({ 
      url: window.location.href,
      selector: MAIN_SELECTOR
    }, '', window.location.href);
  }

  // 初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeButtonStates);
  } else {
    initializeButtonStates();
  }

  // 监听自定义事件（可选，用于调试）
  document.addEventListener('ajax:pageLoaded', function(e) {
    console.log('Page loaded via AJAX:', e.detail);
  });

})();
</script>
