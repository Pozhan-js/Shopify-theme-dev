<!-- sections/ajax-navigation.liquid -->
{% schema %}
{
  "name": "AJAX Navigation",
  "settings": [
    {
      "type": "text",
      "id": "main_content_selector",
      "label": "主内容区域选择器",
      "default": "#MainContent",
      "info": "要替换的主内容区域的 CSS 选择器，例如：#MainContent 或 .main-content"
    },
    {
      "type": "text",
      "id": "content_wrapper_selector",
      "label": "内容包装器选择器",
      "default": ".collection-products",
      "info": "实际要替换的内容区域（不包括导航），留空则替换整个主内容区域"
    }
  ],
  "blocks": [
    {
      "type": "nav_button",
      "name": "导航按钮",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "按钮文字",
          "default": "CATEGORY"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "按钮链接"
        },
        {
          "type": "checkbox",
          "id": "is_highlighted",
          "label": "高亮显示",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AJAX Navigation",
      "blocks": [
        {
          "type": "nav_button",
          "settings": {
            "button_text": "FEATURED",
            "button_link": "/collections/featured"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "SKIN",
            "button_link": "/collections/skin"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "LIP+CHEEK",
            "button_link": "/collections/lip-cheek"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "SETS",
            "button_link": "/collections/sets"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "AWARD WINNERS",
            "button_link": "/collections/award-winners"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "SHOP ALL",
            "button_link": "/collections/all",
            "is_highlighted": true
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .ajax-navigation {
    padding: 40px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ajax-navigation__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
    align-items: center;
  }

  .ajax-nav-button {
    padding: 12px 30px;
    border-radius: 50px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    border: 2px solid #333;
    background: none;
  }

  .ajax-nav-button--outlined {
    background-color: transparent;
    color: #333;
  }

  .ajax-nav-button--outlined:hover,
  .ajax-nav-button--outlined.active {
    background-color: #333;
    color: #fff;
  }

  .ajax-nav-button--filled {
    background-color: #333;
    color: #fff;
  }

  .ajax-nav-button--filled:hover {
    background-color: #555;
    border-color: #555;
  }

  .ajax-nav-button--filled.active {
    background-color: #222;
    border-color: #222;
  }

  .ajax-nav-button.loading {
    opacity: 0.6;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .ajax-navigation {
      padding: 30px 15px;
    }
    
    .ajax-nav-button {
      padding: 10px 20px;
      font-size: 12px;
    }
  }
</style>

<div class="ajax-navigation" data-ajax-nav="{{ section.id }}" data-ajax-nav-persistent>
  <div class="ajax-navigation__buttons">
    {% for block in section.blocks %}
      {% if block.type == 'nav_button' %}
        <button 
          type="button"
          class="ajax-nav-button {% if block.settings.is_highlighted %}ajax-nav-button--filled{% else %}ajax-nav-button--outlined{% endif %}"
          data-url="{{ block.settings.button_link }}"
          data-selector="{{ section.settings.main_content_selector }}"
          data-content-selector="{{ section.settings.content_wrapper_selector }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.button_text }}
        </button>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
(function() {
  const SECTION_ID = "{{ section.id }}";
  const MAIN_SELECTOR = "{{ section.settings.main_content_selector }}";
  const CONTENT_WRAPPER_SELECTOR = "{{ section.settings.content_wrapper_selector }}";
  const DEFAULT_SORT_BY = "created-descending"; // 默认排序参数
  let isLoading = false;

  // 使用 document 级别的事件委托
  document.addEventListener('click', function(e) {
    const button = e.target.closest(`[data-ajax-nav="${SECTION_ID}"] .ajax-nav-button`);
    if (!button || isLoading) return;
    
    e.preventDefault();
    
    let url = button.dataset.url;
    const mainSelector = button.dataset.selector || MAIN_SELECTOR;
    const contentSelector = button.dataset.contentSelector || CONTENT_WRAPPER_SELECTOR;
    
    if (!url) return;
    
    // 为 /collections/all 页面添加默认排序参数
    url = addDefaultSortParam(url);
    
    // 先更新按钮状态
    updateButtonStates(url);
    
    // 加载新页面内容
    loadPageContent(url, mainSelector, contentSelector);
  });

  /**
   * 为 /collections/all 页面添加默认排序参数
   */
  function addDefaultSortParam(url) {
    try {
      const urlObj = new URL(url, window.location.origin);
      
      // 只对 /collections/all 页面添加默认排序
      if (urlObj.pathname === '/collections/all' && !urlObj.searchParams.has('sort_by')) {
        urlObj.searchParams.set('sort_by', DEFAULT_SORT_BY);
        return urlObj.toString();
      }
    } catch (error) {
      console.error('URL parsing error:', error);
    }
    
    return url;
  }

  /**
   * 更新所有导航按钮的激活状态
   */
  function updateButtonStates(activeUrl) {
    const allButtons = document.querySelectorAll(`[data-ajax-nav="${SECTION_ID}"] .ajax-nav-button`);
    
    allButtons.forEach(btn => {
      try {
        const btnUrl = new URL(btn.dataset.url, window.location.origin);
        const targetUrl = new URL(activeUrl, window.location.origin);
        
        // 移除所有按钮的 active 类
        btn.classList.remove('active');
        
        // 给匹配的按钮添加 active 类
        if (btnUrl.pathname === targetUrl.pathname) {
          btn.classList.add('active');
        }
      } catch (error) {
        console.error('Invalid URL:', btn.dataset.url);
      }
    });
  }

  /**
   * 通过 AJAX 加载页面内容
   */
  async function loadPageContent(url, mainSelector, contentSelector) {
    if (isLoading) return;
    
    isLoading = true;
    
    // 保存当前滚动位置
    const currentScrollY = window.scrollY;
    
    // 添加加载状态
    const allButtons = document.querySelectorAll(`[data-ajax-nav="${SECTION_ID}"] .ajax-nav-button`);
    allButtons.forEach(btn => btn.classList.add('loading'));
    
    try {
      const response = await fetch(url, {
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      });
      
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      
      const html = await response.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      
      // 优先使用 contentSelector，如果不存在则使用 mainSelector
      let newContent, currentContent;
      
      if (contentSelector) {
        newContent = doc.querySelector(contentSelector);
        currentContent = document.querySelector(contentSelector);
      }
      
      // 如果 contentSelector 找不到，回退到 mainSelector
      if (!newContent || !currentContent) {
        newContent = doc.querySelector(mainSelector);
        currentContent = document.querySelector(mainSelector);
        
        // 如果使用 mainSelector，需要保留导航组件
        if (newContent && currentContent) {
          // 保存当前导航组件
          const navComponent = currentContent.querySelector(`[data-ajax-nav="${SECTION_ID}"][data-ajax-nav-persistent]`);
          
          // 替换内容
          currentContent.innerHTML = newContent.innerHTML;
          
          // 如果原来有导航组件，将其插回去
          if (navComponent) {
            const newNavPosition = currentContent.querySelector(`[data-ajax-nav="${SECTION_ID}"]`);
            if (newNavPosition) {
              newNavPosition.replaceWith(navComponent);
            } else {
              // 如果新内容中没有导航位置，插入到开头
              currentContent.insertBefore(navComponent, currentContent.firstChild);
            }
            
            // 重新更新按钮状态
            updateButtonStates(url);
          }
        }
      } else {
        // 只替换内容区域，不影响导航
        currentContent.innerHTML = newContent.innerHTML;
      }
      
      if (newContent && currentContent) {
        // 更新页面标题
        const newTitle = doc.querySelector('title');
        if (newTitle) {
          document.title = newTitle.textContent;
        }
        
        // 更新 URL，并保存滚动位置
        history.pushState({ 
          url, 
          mainSelector, 
          contentSelector,
          scrollY: currentScrollY 
        }, '', url);
        
        // 恢复滚动位置（使用 requestAnimationFrame 确保 DOM 更新完成）
        requestAnimationFrame(() => {
          window.scrollTo(0, currentScrollY);
        });
        
        // 触发自定义事件
        document.dispatchEvent(new CustomEvent('ajax:pageLoaded', {
          detail: { 
            url,
            mainSelector,
            contentSelector,
            timestamp: Date.now()
          }
        }));
        
        // 重新初始化 Shopify 功能
        if (typeof Shopify !== 'undefined' && Shopify.PaymentButton) {
          Shopify.PaymentButton.init();
        }
        
        if (typeof theme !== 'undefined' && theme.init) {
          theme.init();
        }
        
        // 重新初始化产品表单
        if (typeof window.Shopify !== 'undefined' && window.Shopify.ProductForm) {
          const forms = document.querySelectorAll('form[action*="/cart/add"]');
          forms.forEach(form => {
            new Shopify.ProductForm(form);
          });
        }
        
      } else {
        console.error('Content selector not found');
        window.location.href = url;
      }
      
    } catch (error) {
      console.error('Error loading page:', error);
      window.location.href = url;
    } finally {
      isLoading = false;
      // 移除加载状态
      allButtons.forEach(btn => btn.classList.remove('loading'));
    }
  }

  /**
   * 处理浏览器前进/后退按钮
   */
  window.addEventListener('popstate', function(e) {
    if (e.state && e.state.url) {
      const mainSelector = e.state.mainSelector || MAIN_SELECTOR;
      const contentSelector = e.state.contentSelector || CONTENT_WRAPPER_SELECTOR;
      const savedScrollY = e.state.scrollY || 0;
      
      // 加载内容
      loadPageContent(e.state.url, mainSelector, contentSelector).then(() => {
        // 恢复保存的滚动位置
        requestAnimationFrame(() => {
          window.scrollTo(0, savedScrollY);
        });
      });
      
      updateButtonStates(e.state.url);
    }
  });

  /**
   * 页面加载时初始化按钮状态
   */
  function initializeButtonStates() {
    const currentPath = window.location.pathname;
    updateButtonStates(currentPath);
    
    // 保存初始状态
    history.replaceState({ 
      url: window.location.href,
      mainSelector: MAIN_SELECTOR,
      contentSelector: CONTENT_WRAPPER_SELECTOR,
      scrollY: window.scrollY
    }, '', window.location.href);
  }

  // 初始化
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeButtonStates);
  } else {
    initializeButtonStates();
  }

})();
</script>
