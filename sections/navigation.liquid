<!-- category-navigation.liquid -->
{% schema %}
{
  "name": "Category Navigation",
  "settings": [
    {
      "type": "text",
      "id": "target_section_id",
      "label": "Target Section ID",
      "default": "product-grid",
      "info": "要重新加载的目标 section ID"
    }
  ],
  "blocks": [
    {
      "type": "category_button",
      "name": "Category Button",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "CATEGORY"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "checkbox",
          "id": "is_highlighted",
          "label": "Highlight Button",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Navigation",
      "blocks": [
        {
          "type": "category_button",
          "settings": {
            "button_text": "FEATURED",
            "button_link": "/collections/featured"
          }
        },
        {
          "type": "category_button",
          "settings": {
            "button_text": "SKIN",
            "button_link": "/collections/skin"
          }
        },
        {
          "type": "category_button",
          "settings": {
            "button_text": "SHOP ALL",
            "button_link": "/collections/all",
            "is_highlighted": true
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .category-navigation {
    padding: 40px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .category-navigation__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
    align-items: center;
  }

  .category-button {
    padding: 12px 30px;
    border-radius: 50px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    border: 2px solid #333;
  }

  .category-button--outlined {
    background-color: transparent;
    color: #333;
  }

  .category-button--outlined:hover,
  .category-button--outlined.active {
    background-color: #333;
    color: #fff;
  }

  .category-button--filled {
    background-color: #333;
    color: #fff;
  }

  .category-button--filled:hover {
    background-color: #555;
    border-color: #555;
  }

  .content-loading {
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 0.3s;
  }

  @media (max-width: 768px) {
    .category-navigation {
      padding: 30px 15px;
    }
    
    .category-button {
      padding: 10px 20px;
      font-size: 12px;
    }
  }
</style>

<div class="category-navigation" id="category-nav-{{ section.id }}">
  <div class="category-navigation__buttons">
    {% for block in section.blocks %}
      {% if block.type == 'category_button' %}
        <button 
          type="button"
          class="category-button category-nav-btn {% if block.settings.is_highlighted %}category-button--filled{% else %}category-button--outlined{% endif %} {% if forloop.first %}active{% endif %}"
          data-url="{{ block.settings.button_link }}"
          data-target="{{ section.settings.target_section_id }}"
          onclick="handleCategoryClick(this)"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.button_text }}
        </button>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
  // 全局函数，确保可以被调用
  window.handleCategoryClick = function(button) {
    console.log('Button clicked!'); // 调试用
    
    const url = button.getAttribute('data-url');
    const targetId = button.getAttribute('data-target');
    
    console.log('URL:', url, 'Target:', targetId); // 调试用
    
    if (!url || !targetId) {
      console.error('Missing URL or target ID');
      return;
    }
    
    // 更新按钮状态
    const allButtons = document.querySelectorAll('.category-nav-btn');
    allButtons.forEach(btn => btn.classList.remove('active'));
    button.classList.add('active');
    
    // 查找目标元素
    const targetElement = document.getElementById(targetId);
    
    if (!targetElement) {
      console.error('Target element not found:', targetId);
      // 如果找不到目标元素，直接跳转
      window.location.href = url;
      return;
    }
    
    // 加载内容
    loadContent(url, targetId, targetElement);
  };
  
  async function loadContent(url, sectionId, targetElement) {
    try {
      // 添加加载状态
      targetElement.classList.add('content-loading');
      
      // 构建请求 URL
      const separator = url.includes('?') ? '&' : '?';
      const fetchUrl = `${url}${separator}section_id=${sectionId}`;
      
      console.log('Fetching:', fetchUrl); // 调试用
      
      // 获取新内容
      const response = await fetch(fetchUrl);
      
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      
      const html = await response.text();
      
      console.log('Content loaded'); // 调试用
      
      // 创建临时容器来解析 HTML
      const tempDiv = document.createElement('div');
      tempDiv.innerHTML = html;
      
      // 查找新内容中的目标 section
      const newContent = tempDiv.querySelector(`#${sectionId}`);
      
      if (newContent) {
        // 替换内容
        targetElement.innerHTML = newContent.innerHTML;
      } else {
        // 如果没有找到特定 section，替换整个内容
        targetElement.innerHTML = html;
      }
      
      // 移除加载状态
      targetElement.classList.remove('content-loading');
      
      // 更新 URL
      history.pushState({ url, sectionId }, '', url);
      
      // 滚动到内容区域
      targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
      
    } catch (error) {
      console.error('Error loading content:', error);
      targetElement.classList.remove('content-loading');
      
      // 出错时直接跳转
      window.location.href = url;
    }
  }
  
  // 处理浏览器前进/后退
  window.addEventListener('popstate', function(e) {
    if (e.state && e.state.url && e.state.sectionId) {
      const targetElement = document.getElementById(e.state.sectionId);
      if (targetElement) {
        loadContent(e.state.url, e.state.sectionId, targetElement);
      }
    }
  });
</script>
