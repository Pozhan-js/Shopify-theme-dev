<!-- sections/ajax-navigation.liquid -->
{% schema %}
{
  "name": "AJAX Navigation",
  "settings": [
    {
      "type": "text",
      "id": "main_content_selector",
      "label": "主内容区域选择器",
      "default": "#MainContent",
      "info": "要替换的主内容区域的 CSS 选择器，例如：#MainContent 或 .main-content"
    },
    {
      "type": "text",
      "id": "content_wrapper_selector",
      "label": "内容包装器选择器",
      "default": ".collection-products",
      "info": "实际要替换的内容区域（不包括导航），留空则替换整个主内容区域"
    }
  ],
  "blocks": [
    {
      "type": "nav_button",
      "name": "导航按钮",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "按钮文字",
          "default": "CATEGORY"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "按钮链接"
        },
        {
          "type": "checkbox",
          "id": "is_highlighted",
          "label": "高亮显示",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AJAX Navigation",
      "blocks": [
        {
          "type": "nav_button",
          "settings": {
            "button_text": "FEATURED",
            "button_link": "/collections/featured"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "SKIN",
            "button_link": "/collections/skin"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "LIP+CHEEK",
            "button_link": "/collections/lip-cheek"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "SETS",
            "button_link": "/collections/sets"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "AWARD WINNERS",
            "button_link": "/collections/award-winners"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "SHOP ALL",
            "button_link": "/collections/all",
            "is_highlighted": true
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .ajax-navigation {
    padding: 40px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ajax-navigation__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
    align-items: center;
  }

  .ajax-nav-button {
    padding: 12px 30px;
    border-radius: 50px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    border: 2px solid #333;
    background: none;
  }

  .ajax-nav-button--outlined {
    background-color: transparent;
    color: #333;
  }

  .ajax-nav-button--outlined:hover,
  .ajax-nav-button--outlined.active {
    background-color: #333;
    color: #fff;
  }

  .ajax-nav-button--filled {
    background-color: #333;
    color: #fff;
  }

  .ajax-nav-button--filled:hover {
    background-color: #555;
    border-color: #555;
  }

  .ajax-nav-button--filled.active {
    background-color: #222;
    border-color: #222;
  }

  .ajax-nav-button.loading {
    opacity: 0.6;
    pointer-events: none;
  }

  @media (max-width: 768px) {
    .ajax-navigation {
      padding: 30px 15px;
    }
    
    .ajax-nav-button {
      padding: 10px 20px;
      font-size: 12px;
    }
  }
</style>

<div class="ajax-navigation" data-ajax-nav="{{ section.id }}" data-ajax-nav-persistent>
  <div class="ajax-navigation__buttons">
    {% for block in section.blocks %}
      {% if block.type == 'nav_button' %}
        <button 
          type="button"
          class="ajax-nav-button {% if block.settings.is_highlighted %}ajax-nav-button--filled{% else %}ajax-nav-button--outlined{% endif %}"
          data-url="{{ block.settings.button_link }}"
          data-selector="{{ section.settings.main_content_selector }}"
          data-content-selector="{{ section.settings.content_wrapper_selector }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.button_text }}
        </button>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
(function() {
  const SECTION_ID = "{{ section.id }}";
  const MAIN_SELECTOR = "{{ section.settings.main_content_selector }}";
  const CONTENT_WRAPPER_SELECTOR = "{{ section.settings.content_wrapper_selector }}";
  let isLoading = false;

  document.addEventListener('click', function(e) {
    const button = e.target.closest(`[data-ajax-nav="${SECTION_ID}"] .ajax-nav-button`);
    if (!button || isLoading) return;
    
    e.preventDefault();
    
    const url = button.dataset.url;
    const mainSelector = button.dataset.selector || MAIN_SELECTOR;
    const contentSelector = button.dataset.contentSelector || CONTENT_WRAPPER_SELECTOR;
    
    if (!url) return;
    
    updateButtonStates(url);
    loadPageContent(url, mainSelector, contentSelector);
  });

  function updateButtonStates(activeUrl) {
    const allButtons = document.querySelectorAll(`[data-ajax-nav="${SECTION_ID}"] .ajax-nav-button`);
    
    allButtons.forEach(btn => {
      try {
        const btnUrl = new URL(btn.dataset.url, window.location.origin);
        const targetUrl = new URL(activeUrl, window.location.origin);
        
        btn.classList.remove('active');
        
        if (btnUrl.pathname === targetUrl.pathname) {
          btn.classList.add('active');
        }
      } catch (error) {
        console.error('Invalid URL:', btn.dataset.url);
      }
    });
  }

  async function loadPageContent(url, mainSelector, contentSelector) {
    if (isLoading) return;
    
    isLoading = true;
    
    const allButtons = document.querySelectorAll(`[data-ajax-nav="${SECTION_ID}"] .ajax-nav-button`);
    allButtons.forEach(btn => btn.classList.add('loading'));
    
    try {
      const response = await fetch(url, {
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      });
      
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      
      const html = await response.text();
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      
      console.log('🔍 Debug Info:');
      console.log('Main Selector:', mainSelector);
      console.log('Content Selector:', contentSelector);
      
      const navComponent = document.querySelector(`[data-ajax-nav="${SECTION_ID}"][data-ajax-nav-persistent]`);
      const mainContent = document.querySelector(mainSelector);
      
      console.log('Current nav found:', !!navComponent);
      console.log('Current main content found:', !!mainContent);
      
      if (!mainContent) {
        console.error('❌ Main content area not found');
        window.location.href = url;
        return;
      }
      
      const newMainContent = doc.querySelector(mainSelector);
      console.log('New main content found:', !!newMainContent);
      
      if (!newMainContent) {
        console.error('❌ New content not found in fetched page');
        window.location.href = url;
        return;
      }
      
      // 🔑 改进的内容替换逻辑
      if (navComponent) {
        console.log('✅ Using nav-aware replacement');
        
        // 收集导航栏之后的所有内容
        let currentSibling = navComponent.nextElementSibling;
        const toRemove = [];
        
        while (currentSibling) {
          toRemove.push(currentSibling);
          currentSibling = currentSibling.nextElementSibling;
        }
        
        console.log('Removing', toRemove.length, 'elements after nav');
        
        // 移除旧内容
        toRemove.forEach(el => el.remove());
        
        // 从新页面提取内容
        const newNavInNewPage = newMainContent.querySelector(`[data-ajax-nav="${SECTION_ID}"]`);
        let insertedCount = 0;
        
        Array.from(newMainContent.children).forEach(child => {
          // 跳过新页面中的导航栏
          if (newNavInNewPage && (child === newNavInNewPage || child.contains(newNavInNewPage))) {
            console.log('Skipping nav in new content');
            return;
          }
          
          // 克隆并插入新内容
          const clonedChild = child.cloneNode(true);
          mainContent.appendChild(clonedChild);
          insertedCount++;
        });
        
        console.log('✅ Inserted', insertedCount, 'new elements');
        
      } else {
        console.log('⚠️ Nav not found, using fallback replacement');
        
        // 备用方案：直接替换 MainContent
        const oldHTML = mainContent.innerHTML;
        mainContent.innerHTML = newMainContent.innerHTML;
        
        console.log('Content changed:', oldHTML !== mainContent.innerHTML);
      }
      
      // 更新页面元数据
      const newTitle = doc.querySelector('title');
      if (newTitle) {
        document.title = newTitle.textContent;
        console.log('✅ Title updated:', newTitle.textContent);
      }
      
      history.pushState({ url, mainSelector, contentSelector }, '', url);
      console.log('✅ URL updated:', url);
      
      window.scrollTo({ 
        top: 0, 
        behavior: 'smooth' 
      });
      
      document.dispatchEvent(new CustomEvent('ajax:pageLoaded', {
        detail: { 
          url,
          mainSelector,
          contentSelector,
          timestamp: Date.now()
        }
      }));
      
      reinitializeShopifyFeatures();
      
    } catch (error) {
      console.error('❌ Error loading page:', error);
      window.location.href = url;
    } finally {
      isLoading = false;
      allButtons.forEach(btn => btn.classList.remove('loading'));
    }
  }

  function reinitializeShopifyFeatures() {
    if (typeof Shopify !== 'undefined' && Shopify.PaymentButton) {
      Shopify.PaymentButton.init();
    }
    
    if (typeof theme !== 'undefined' && theme.init) {
      theme.init();
    }
    
    if (typeof window.Shopify !== 'undefined' && window.Shopify.ProductForm) {
      const forms = document.querySelectorAll('form[action*="/cart/add"]');
      forms.forEach(form => {
        new Shopify.ProductForm(form);
      });
    }
  }

  window.addEventListener('popstate', function(e) {
    if (e.state && e.state.url) {
      const mainSelector = e.state.mainSelector || MAIN_SELECTOR;
      const contentSelector = e.state.contentSelector || CONTENT_WRAPPER_SELECTOR;
      loadPageContent(e.state.url, mainSelector, contentSelector);
      updateButtonStates(e.state.url);
    }
  });

  function initializeButtonStates() {
    const currentPath = window.location.pathname;
    updateButtonStates(currentPath);
    
    history.replaceState({ 
      url: window.location.href,
      mainSelector: MAIN_SELECTOR,
      contentSelector: CONTENT_WRAPPER_SELECTOR
    }, '', window.location.href);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeButtonStates);
  } else {
    initializeButtonStates();
  }

})();
</script>

