<!-- sections/ajax-navigation.liquid -->
{% schema %}
{
  "name": "AJAX Navigation",
  "settings": [
    {
      "type": "text",
      "id": "main_content_selector",
      "label": "主内容区域选择器",
      "default": "#MainContent",
      "info": "要替换的主内容区域的 CSS 选择器，例如：#MainContent 或 .main-content"
    }
  ],
  "blocks": [
    {
      "type": "nav_button",
      "name": "导航按钮",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "按钮文字",
          "default": "CATEGORY"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "按钮链接"
        },
        {
          "type": "checkbox",
          "id": "is_highlighted",
          "label": "高亮显示",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "AJAX Navigation",
      "blocks": [
        {
          "type": "nav_button",
          "settings": {
            "button_text": "FEATURED",
            "button_link": "/collections/featured"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "SKIN",
            "button_link": "/collections/skin"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "LIP+CHEEK",
            "button_link": "/collections/lip-cheek"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "SETS",
            "button_link": "/collections/sets"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "AWARD WINNERS",
            "button_link": "/collections/award-winners"
          }
        },
        {
          "type": "nav_button",
          "settings": {
            "button_text": "SHOP ALL",
            "button_link": "/collections/all",
            "is_highlighted": true
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .ajax-navigation {
    padding: 40px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ajax-navigation__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
    align-items: center;
  }

  .ajax-nav-button {
    padding: 12px 30px;
    border-radius: 50px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    border: 2px solid #333;
    background: none;
  }

  .ajax-nav-button--outlined {
    background-color: transparent;
    color: #333;
  }

  .ajax-nav-button--outlined:hover,
  .ajax-nav-button--outlined.active {
    background-color: #333;
    color: #fff;
  }

  .ajax-nav-button--filled {
    background-color: #333;
    color: #fff;
  }

  .ajax-nav-button--filled:hover {
    background-color: #555;
    border-color: #555;
  }

  @media (max-width: 768px) {
    .ajax-navigation {
      padding: 30px 15px;
    }
    
    .ajax-nav-button {
      padding: 10px 20px;
      font-size: 12px;
    }
  }
</style>

<div class="ajax-navigation" data-ajax-nav="{{ section.id }}">
  <div class="ajax-navigation__buttons">
    {% for block in section.blocks %}
      {% if block.type == 'nav_button' %}
        <button 
          type="button"
          class="ajax-nav-button {% if block.settings.is_highlighted %}ajax-nav-button--filled{% else %}ajax-nav-button--outlined{% endif %}"
          data-url="{{ block.settings.button_link }}"
          data-selector="{{ section.settings.main_content_selector }}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.button_text }}
        </button>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
(function() {
  const navSection = document.querySelector('[data-ajax-nav="{{ section.id }}"]');
  if (!navSection) return;

  const buttons = navSection.querySelectorAll('.ajax-nav-button');
  
  // 标记当前活动按钮
  const currentPath = window.location.pathname;
  buttons.forEach(btn => {
    const btnUrl = new URL(btn.dataset.url, window.location.origin);
    if (btnUrl.pathname === currentPath) {
      btn.classList.add('active');
    }
  });

  // 使用事件委托，避免按钮被替换后失效
  navSection.addEventListener('click', function(e) {
    const button = e.target.closest('.ajax-nav-button');
    if (!button) return;
    
    e.preventDefault();
    
    const url = button.dataset.url;
    const selector = button.dataset.selector || '#MainContent';
    
    if (!url) return;
    
    // 更新按钮状态
    buttons.forEach(btn => btn.classList.remove('active'));
    button.classList.add('active');
    
    // 加载新页面内容
    loadPageContent(url, selector);
  });

  async function loadPageContent(url, selector) {
    try {
      // 获取新页面内容
      const response = await fetch(url, {
        headers: {
          'X-Requested-With': 'XMLHttpRequest'
        }
      });
      
      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }
      
      const html = await response.text();
      
      // 解析 HTML
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      
      // 获取新内容
      const newContent = doc.querySelector(selector);
      const currentContent = document.querySelector(selector);
      
      if (newContent && currentContent) {
        // 替换内容
        currentContent.innerHTML = newContent.innerHTML;
        
        // 更新页面标题
        const newTitle = doc.querySelector('title');
        if (newTitle) {
          document.title = newTitle.textContent;
        }
        
        // 更新 URL
        history.pushState({ url }, '', url);
        
        // 滚动到顶部
        window.scrollTo({ top: 0, behavior: 'smooth' });
        
        // 触发自定义事件，让其他脚本知道内容已更新
        document.dispatchEvent(new CustomEvent('page:loaded', {
          detail: { url }
        }));
        
        // 重新初始化 Shopify 相关功能
        if (typeof Shopify !== 'undefined' && Shopify.PaymentButton) {
          Shopify.PaymentButton.init();
        }
        
        // 重新初始化产品表单
        if (typeof theme !== 'undefined' && theme.init) {
          theme.init();
        }
        
      } else {
        console.error('Content selector not found:', selector);
        window.location.href = url;
      }
      
    } catch (error) {
      console.error('Error loading page:', error);
      window.location.href = url;
    }
  }

  // 处理浏览器前进/后退
  window.addEventListener('popstate', function(e) {
    if (e.state && e.state.url) {
      const selector = navSection.querySelector('.ajax-nav-button').dataset.selector || '#MainContent';
      loadPageContent(e.state.url, selector);
      
      // 更新按钮状态
      buttons.forEach(btn => {
        const btnUrl = new URL(btn.dataset.url, window.location.origin);
        if (btnUrl.pathname === e.state.url || btnUrl.href === e.state.url) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    }
  });
})();
</script>
