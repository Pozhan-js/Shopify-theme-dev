<!-- category-navigation.liquid -->
{% schema %}
{
  "name": "Category Navigation",
  "settings": [
    {
      "type": "text",
      "id": "target_section_id",
      "label": "Target Section ID",
      "default": "product-grid",
      "info": "The section ID to reload when clicking buttons"
    }
  ],
  "blocks": [
    {
      "type": "category_button",
      "name": "Category Button",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "CATEGORY"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "checkbox",
          "id": "is_highlighted",
          "label": "Highlight Button",
          "default": false
        }
      ]
    }
  ]
}
{% endschema %}

<style>
  .category-navigation {
    padding: 40px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .category-navigation__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    justify-content: center;
    align-items: center;
  }

  .category-button {
    padding: 12px 30px;
    border-radius: 50px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    border: 2px solid #333;
  }

  .category-button--outlined {
    background-color: transparent;
    color: #333;
  }

  .category-button--outlined:hover,
  .category-button--outlined.active {
    background-color: #333;
    color: #fff;
  }

  .category-button--filled {
    background-color: #333;
    color: #fff;
  }

  .category-button--filled:hover {
    background-color: #555;
    border-color: #555;
  }

  /* 加载动画 */
  .loading-overlay {
    position: relative;
  }

  .loading-overlay::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.7);
    display: none;
    align-items: center;
    justify-content: center;
  }

  .loading-overlay.is-loading::after {
    display: flex;
  }
</style>

<div class="category-navigation" data-section-id="{{ section.id }}">
  <div class="category-navigation__buttons">
    {% for block in section.blocks %}
      {% if block.type == 'category_button' %}
        <button 
          type="button"
          data-url="{{ block.settings.button_link }}"
          data-target="{{ section.settings.target_section_id }}"
          class="category-button {% if block.settings.is_highlighted %}category-button--filled{% else %}category-button--outlined{% endif %} {% if forloop.first %}active{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.button_text }}
        </button>
      {% endif %}
    {% endfor %}
  </div>
</div>

<script>
(function() {
  const categoryNav = document.querySelector('[data-section-id="{{ section.id }}"]');
  if (!categoryNav) return;

  const buttons = categoryNav.querySelectorAll('.category-button');
  
  buttons.forEach(button => {
    button.addEventListener('click', async function(e) {
      e.preventDefault();
      
      const url = this.dataset.url;
      const targetSectionId = this.dataset.target;
      
      if (!url || !targetSectionId) return;
      
      // 更新按钮状态
      buttons.forEach(btn => btn.classList.remove('active'));
      this.classList.add('active');
      
      // 加载新内容
      await loadSectionContent(url, targetSectionId);
    });
  });

  async function loadSectionContent(url, sectionId) {
    const targetElement = document.querySelector(`[data-section-id="${sectionId}"]`);
    if (!targetElement) {
      console.error(`Target section ${sectionId} not found`);
      return;
    }

    try {
      // 添加加载状态
      targetElement.classList.add('loading-overlay', 'is-loading');
      
      // 构建请求 URL
      const fetchUrl = `${url}${url.includes('?') ? '&' : '?'}section_id=${sectionId}`;
      
      // 获取新内容
      const response = await fetch(fetchUrl);
      if (!response.ok) throw new Error('Network response was not ok');
      
      const html = await response.text();
      
      // 替换内容
      targetElement.outerHTML = html;
      
      // 更新浏览器 URL（不刷新页面）
      history.pushState({ sectionId, url }, '', url);
      
      // 触发自定义事件，通知其他脚本内容已更新
      document.dispatchEvent(new CustomEvent('section:loaded', {
        detail: { sectionId, url }
      }));
      
    } catch (error) {
      console.error('Error loading section:', error);
      targetElement.classList.remove('is-loading');
    }
  }

  // 处理浏览器前进/后退按钮
  window.addEventListener('popstate', function(e) {
    if (e.state && e.state.url && e.state.sectionId) {
      loadSectionContent(e.state.url, e.state.sectionId);
    }
  });
})();
</script>
