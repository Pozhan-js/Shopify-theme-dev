<!-- sections/product-detail.liquid -->
<div class="product-detail-section">
  <div class="product-container">
    <!-- 左侧图片展示区域 -->
    <div class="product-images">
      <div class="main-image">
        <img src="{{ product.featured_image | img_url: '800x800' }}" alt="{{ product.title }}" id="main-product-image">
        <!-- 缩略图移到左下角 -->
        <div class="thumbnail-images">
          {% for image in product.images limit: 4 %}
            <div class="thumbnail {% if forloop.first %}active{% endif %}" data-image="{{ image | img_url: '800x800' }}">
              <img src="{{ image | img_url: '100x100' }}" alt="{{ product.title }}">
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- 右侧商品详情区域 -->
    <div class="product-info">
      <div class="product-info-content">
        <!-- 商品标题 -->
        <h1 class="product-title">{{ product.title }}</h1>
        
        <!-- 商品副标题 -->
        {% if section.settings.show_subtitle %}
          <p class="product-subtitle">{{ section.settings.subtitle | default: product.metafields.custom.subtitle | default: "THE NOURISHING LIP LAYER" }}</p>
        {% endif %}
        
        <!-- 评分 -->
        {% if section.settings.show_rating %}
          <div class="product-rating">
            <div class="stars">
              {% for i in (1..5) %}
                <span class="star {% if i <= section.settings.rating %}filled{% endif %}">★</span>
              {% endfor %}
            </div>
            <span class="rating-count">({{ section.settings.rating_count }})</span>
          </div>
        {% endif %}

        <!-- 商品描述 -->
        {% if section.settings.show_description %}
          <div class="product-description">
            {{ product.description }}
          </div>
        {% endif %}

        <!-- 商品表单 -->
        <form action="/cart/add" method="post" enctype="multipart/form-data" class="product-form" id="product-form">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          
          <!-- 多属性选择 -->
          {% for option in product.options_with_values %}
            <div class="product-option">
              <label class="option-label">{{ option.name }}:</label>
              
              {% if option.name == 'Color' or option.name == '颜色' %}
                <!-- 颜色选择器 -->
                <div class="color-selector">
                  {% for value in option.values %}
                    <input type="radio" 
                           name="options[{{ option.name }}]" 
                           value="{{ value }}" 
                           id="option-{{ option.name | handleize }}-{{ value | handleize }}"
                           {% if forloop.first %}checked{% endif %}>
                    <label for="option-{{ option.name | handleize }}-{{ value | handleize }}" 
                           class="color-option" 
                           data-color="{{ value | handleize }}"
                           title="{{ value }}">
                      <span class="color-circle color-{{ value | handleize }}"></span>
                    </label>
                  {% endfor %}
                </div>
              {% else %}
                <!-- 下拉选择器 -->
                <select name="options[{{ option.name }}]" class="option-select">
                  {% for value in option.values %}
                    <option value="{{ value }}">{{ value }}</option>
                  {% endfor %}
                </select>
              {% endif %}
            </div>
          {% endfor %}

          <!-- 数量选择 -->
          {% if section.settings.show_quantity %}
            <div class="quantity-selector">
              <label class="quantity-label">{{ section.settings.quantity_label }}:</label>
              <div class="quantity-input">
                <button type="button" class="quantity-btn minus">-</button>
                <input type="number" name="quantity" value="1" min="1" class="quantity-field">
                <button type="button" class="quantity-btn plus">+</button>
              </div>
            </div>
          {% endif %}

          <!-- 价格 -->
          {% if section.settings.show_price %}
            <div class="product-price">
              <span class="price">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="compare-price">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
          {% endif %}

          <!-- 立即购买按钮 -->
          {% if section.settings.show_buy_now %}
            <button type="button" class="buy-now-btn" style="border-color: {{ section.settings.button_color }}; color: {{ section.settings.button_color }};">
              {{ section.settings.buy_now_text }}
            </button>
          {% endif %}
        </form>
      </div>
    </div>
  </div>
</div>

<style>
.product-detail-section {
  padding: {{ section.settings.section_padding_top }}px 20px {{ section.settings.section_padding_bottom }}px 20px;
  max-width: {{ section.settings.container_width }}px;
  margin: 0 auto;
  background-color: {{ section.settings.background_color }};
}

.product-container {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: {{ section.settings.content_gap }}px;
  align-items: start;
}

/* 左侧图片区域 */
.product-images {
  position: sticky;
  top: 20px;
}

.main-image {
  width: 100%;
  border-radius: {{ section.settings.image_border_radius }}px;
  overflow: hidden;
  background: #f8f8f8;
  position: relative;
}

.main-image img {
  width: 100%;
  height: auto;
  display: block;
  transition: opacity 0.3s ease;
}

/* 缩略图移到左下角 */
.thumbnail-images {
  position: absolute;
  bottom: 20px;
  left: 20px;
  display: flex;
  gap: 8px;
  flex-direction: column;
}

.thumbnail {
  width: 60px;
  height: 60px;
  border-radius: {{ section.settings.thumbnail_border_radius }}px;
  overflow: hidden;
  cursor: pointer;
  border: 2px solid rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
  opacity: 0.7;
}

.thumbnail:hover {
  opacity: 1;
  border-color: {{ section.settings.accent_color }};
  transform: scale(1.05);
}

.thumbnail.active {
  border-color: {{ section.settings.accent_color }};
  opacity: 1;
}

.thumbnail img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 右侧商品信息区域 */
.product-info {
  height: 80vh;
  overflow-y: auto;
  padding-right: 10px;
}

.product-info::-webkit-scrollbar {
  width: 6px;
}

.product-info::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 3px;
}

.product-info::-webkit-scrollbar-thumb {
  background: #c1c1c1;
  border-radius: 3px;
}

.product-title {
  font-size: {{ section.settings.title_font_size }}px;
  font-weight: {{ section.settings.title_font_weight }};
  color: {{ section.settings.title_color }};
  margin: 0 0 10px 0;
  line-height: 1.2;
  letter-spacing: -0.02em;
}

.product-subtitle {
  font-size: {{ section.settings.subtitle_font_size }}px;
  color: {{ section.settings.subtitle_color }};
  margin: 0 0 15px 0;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.product-rating {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 25px;
}

.stars {
  color: {{ section.settings.star_color }};
  font-size: 1.1rem;
}

.rating-count {
  color: {{ section.settings.text_color }};
  font-size: 0.9rem;
}

.product-description {
  color: {{ section.settings.text_color }};
  line-height: 1.6;
  margin-bottom: 30px;
  font-size: {{ section.settings.description_font_size }}px;
}

/* 商品选项 */
.product-option {
  margin-bottom: 25px;
}

.option-label {
  display: block;
  font-weight: 500;
  margin-bottom: 10px;
  color: {{ section.settings.label_color }};
  font-size: 0.9rem;
}

.color-selector {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.color-selector input[type="radio"] {
  display: none;
}

.color-option {
  cursor: pointer;
  display: block;
  position: relative;
}

.color-circle {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2px solid #e0e0e0;
  display: block;
  transition: all 0.3s ease;
  position: relative;
}

.color-circle::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 20px;
  height: 20px;
  border-radius: 50%;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.color-selector input[type="radio"]:checked + .color-option .color-circle {
  border-color: {{ section.settings.accent_color }};
  box-shadow: 0 0 0 2px rgba(0,0,0,0.1);
}

.color-selector input[type="radio"]:checked + .color-option .color-circle::after {
  opacity: 1;
  background: {{ section.settings.accent_color }};
}

/* 颜色定义 */
.color-strawberry-glaze { background: #d63384; }
.color-pink { background: #ff69b4; }
.color-nude { background: #deb887; }
.color-clear { background: #ffffff; border-color: #ccc; }
.color-lavender { background: #e6e6fa; }

.option-select {
  width: 100%;
  padding: 12px 16px;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-size: 0.9rem;
  background: white;
  cursor: pointer;
}

/* 数量选择器 */
.quantity-selector {
  margin-bottom: 25px;
}

.quantity-label {
  display: block;
  font-weight: 500;
  margin-bottom: 10px;
  color: {{ section.settings.label_color }};
  font-size: 0.9rem;
}

.quantity-input {
  display: flex;
  align-items: center;
  width: fit-content;
  border: 1px solid #ddd;
  border-radius: 6px;
  overflow: hidden;
}

.quantity-btn {
  background: #f8f8f8;
  border: none;
  width: 40px;
  height: 40px;
  cursor: pointer;
  font-size: 1.2rem;
  transition: background-color 0.3s ease;
}

.quantity-btn:hover {
  background: #e8e8e8;
}

.quantity-field {
  border: none;
  width: 60px;
  height: 40px;
  text-align: center;
  font-size: 0.9rem;
  background: white;
}

/* 价格 */
.product-price {
  margin-bottom: 30px;
}

.price {
  font-size: {{ section.settings.price_font_size }}px;
  font-weight: 600;
  color: {{ section.settings.price_color }};
}

.compare-price {
  font-size: {{ section.settings.compare_price_font_size }}px;
  color: #999;
  text-decoration: line-through;
  margin-left: 10px;
}

/* 立即购买按钮 */
.buy-now-btn {
  width: 100%;
  padding: 16px 24px;
  border: 2px solid;
  border-radius: {{ section.settings.button_border_radius }}px;
  font-size: {{ section.settings.button_font_size }}px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.3s ease;
  background: transparent;
}

.buy-now-btn:hover {
  background: {{ section.settings.button_color }};
  color: white !important;
}

/* 响应式设计 */
@media (max-width: 768px) {
  .product-container {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  
  .product-images {
    position: static;
  }
  
  .product-info {
    height: auto;
    overflow-y: visible;
  }
  
  .product-title {
    font-size: {{ section.settings.title_font_size | minus: 8 }}px;
  }
  
  .thumbnail-images {
    position: static;
    flex-direction: row;
    justify-content: center;
    margin-top: 15px;
  }
  
  .thumbnail {
    width: 70px;
    height: 70px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // 缩略图悬停切换功能
  const thumbnails = document.querySelectorAll('.thumbnail');
  const mainImage = document.getElementById('main-product-image');
  
  thumbnails.forEach(thumbnail => {
    // 鼠标移入时切换图片
    thumbnail.addEventListener('mouseenter', function() {
      const newImageSrc = this.dataset.image;
      mainImage.src = newImageSrc;
      
      thumbnails.forEach(t => t.classList.remove('active'));
      this.classList.add('active');
    });
  });
  
  // 数量选择器功能
  const minusBtn = document.querySelector('.quantity-btn.minus');
  const plusBtn = document.querySelector('.quantity-btn.plus');
  const quantityField = document.querySelector('.quantity-field');
  
  if (minusBtn && plusBtn && quantityField) {
    minusBtn.addEventListener('click', function() {
      const currentValue = parseInt(quantityField.value);
      if (currentValue > 1) {
        quantityField.value = currentValue - 1;
      }
    });
    
    plusBtn.addEventListener('click', function() {
      const currentValue = parseInt(quantityField.value);
      quantityField.value = currentValue + 1;
    });
  }
  
  // 立即购买功能 - 修复跳转问题
  const buyNowBtn = document.querySelector('.buy-now-btn');
  if (buyNowBtn) {
    buyNowBtn.addEventListener('click', function(e) {
      e.preventDefault();
      
      const form = document.getElementById('product-form');
      const formData = new FormData(form);
      
      // 先添加到购物车
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          id: formData.get('id'),
          quantity: parseInt(formData.get('quantity')) || 1
        })
      })
      .then(response => {
        if (response.ok) {
          return response.json();
        }
        throw new Error('添加到购物车失败');
      })
      .then(data => {
        // 成功添加后跳转到结账页面
        window.location.href = '/checkout';
      })
      .catch(error => {
        console.error('Error:', error);
        alert('添加到购物车时出现错误，请重试');
      });
    });
  }
  
  // 变体选择功能
  const variantSelectors = document.querySelectorAll('input[name^="options"], select[name^="options"]');
  const productForm = document.getElementById('product-form');
  
  if (variantSelectors.length > 0 && productForm) {
    variantSelectors.forEach(selector => {
      selector.addEventListener('change', updateVariant);
    });
  }
  
  function updateVariant() {
    const selectedOptions = [];
    variantSelectors.forEach(selector => {
      if (selector.type === 'radio' && selector.checked) {
        selectedOptions.push(selector.value);
      } else if (selector.type === 'select-one') {
        selectedOptions.push(selector.value);
      }
    });
    
    // 这里需要根据选择的选项找到对应的变体ID
    // 由于这需要产品的变体数据，建议在模板中输出变体数据供JavaScript使用
    console.log('Selected options:', selectedOptions);
  }
});
</script>

