<!-- sections/product-detail.liquid -->
<div class="product-detail-section">
  <div class="product-container">
    <!-- 左侧图片展示区域 -->
    <div class="product-images">
      <div class="main-image">
        <img
          src="{{ product.featured_image | img_url: '800x800' }}"
          alt="{{ product.title }}"
          id="main-product-image"
          width="800"
          height="800"
        >
        <!-- 缩略图移到左下角 -->
        <div class="thumbnail-images">
          {% for image in product.images limit: 4 %}
            <div
              class="thumbnail {% if forloop.first %}active{% endif %}"
              data-image="{{ image | img_url: '800x800' }}"
              data-image-alt="{{ product.title }}"
            >
              <img
                src="{{ image | img_url: '100x100' }}"
                alt="{{ product.title }}"
                width="100"
                height="100"
              >
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- 右侧商品详情区域 -->
    <div class="product-info" style="background-color: {{ section.settings.info_background_color }};">
      <div class="product-info-content">
        {% capture details %}
          {% content_for 'block',
            type: '_product-details',
            id: 'product-details',
            closest.product: product
          %}
        {% endcapture %}
        {{ details }}
      </div>
    </div>
  </div>
   <!-- 快速购买栏 -->
  <div class="quick-buy-bar" id="quickBuyBar" style="display: none;">
    <div class="quick-buy-content">
      <div class="quick-buy-product-info">
        <div class="quick-buy-image">
          {% if closest.product.featured_media %}
            <img
              src="{{ closest.product.featured_media | image_url: width: 60 }}"
              alt="{{ closest.product.title }}"
              loading="lazy"
            >
          {% endif %}
        </div>
        <div class="quick-buy-details">
          <h3 class="quick-buy-title">{{ closest.product.title }}</h3>
        </div>
      </div>

      <div class="quick-buy-options">
        {% unless closest.product.has_only_default_variant %}
          <div class="quick-buy-variants">
            {% for option in closest.product.options_with_values %}
              <div class="variant-option">
                <label class="option-label">{{ option.name }}:</label>
                <div class="option-buttons" data-option-index="{{ forloop.index0 }}">
                  {% for value in option.values %}
                    <button
                      type="button"
                      class="option-btn {% if forloop.first %}active{% endif %}"
                      data-value="{{ value }}"
                    >
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>
              </div>
            {% endfor %}
          </div>
        {% endunless %}

        <div class="quick-buy-quantity">
          <label class="quantity-label">Qty:</label>
          <div class="quantity-selector">
            <button type="button" class="quantity-btn quantity-minus">-</button>
            <input type="number" class="quantity-input" value="1" min="1">
            <button type="button" class="quantity-btn quantity-plus">+</button>
          </div>
        </div>
      </div>

      <div class="quick-buy-actions">
        <button type="button" class="quick-buy-btn" id="quickBuyButton">
          <span class="btn-text"
            >Buy Now · <span class="btn-price">{{ closest.product.price | money }}</span></span
          >
          <span class="btn-loading" style="display: none;">Adding...</span>
        </button>
      </div>

      {% comment %} <button type="button" class="quick-buy-close" id="quickBuyClose">×</button> {% endcomment %}
    </div>
  </div>
    {% content_for 'blocks' %}
</div>

<style>
  /* 快速购买栏样式 */
  .quick-buy-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(255, 255, 255, 0.98);
    backdrop-filter: blur(10px);
    border-top: 1px solid #e0e0e0;
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.1);
    z-index: 1000;
    transform: translateY(100%);
    transition: transform 0.3s ease-in-out;
    padding: 16px;
  }

  .quick-buy-bar.show {
    transform: translateY(0);
  }

  .quick-buy-content {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
  }

  .quick-buy-product-info {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .quick-buy-image img {
    width: 60px;
    height: 60px;
    object-fit: cover;
    border-radius: 8px;
  }

  .quick-buy-title {
    font-size: 14px;
    font-weight: 600;
    margin: 0;
    line-height: 1.2;
    max-width: 150px;
  }

  .quick-buy-options {
    display: flex;
    align-items: center;
    gap: 20px;
    flex: 1;
  }

  .quick-buy-variants {
    display: flex;
    gap: 16px;
  }

  .variant-option {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .option-label,
  .quantity-label {
    font-size: 12px;
    color: #666;
    white-space: nowrap;
    font-weight: 500;
  }

  .option-buttons {
    display: flex;
    gap: 6px;
  }

  .option-btn {
    background: #f5f5f5;
    color: #000;
    border: none;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    min-width: 40px;
  }

  .option-btn:hover {
    background: #e0e0e0;
  }

  .option-btn.active {
    background: #000;
    color: #fff;
  }

  .option-btn.active:hover {
    background: #333;
  }

  .quick-buy-quantity {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid #ddd;
    border-radius: 6px;
    overflow: hidden;
  }

  .quantity-btn {
    background: #f8f9fa;
    border: none;
    padding: 8px 12px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.2s;
    color: #333;
  }

  .quantity-btn:hover {
    background: #e9ecef;
  }

  .quantity-input {
    border: none;
    text-align: center;
    width: 50px;
    padding: 8px 4px;
    font-size: 12px;
    font-weight: 500;
  }

  .quick-buy-actions {
    flex-shrink: 0;
  }

  .quick-buy-btn {
    background: #007bff;
    color: white;
    border: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s;
    position: relative;
    min-width: 140px;
    font-size: 14px;
  }

  .quick-buy-btn:hover {
    background: #0056b3;
  }

  .quick-buy-btn:disabled {
    background: #6c757d;
    cursor: not-allowed;
  }

  .btn-price {
    font-weight: 700;
    color: #fff;
  }

  .quick-buy-close {
    position: absolute;
    top: -8px;
    right: -8px;
    background: #6c757d;
    color: white;
    border: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;
  }

  .quick-buy-close:hover {
    background: #5a6268;
  }

  /* 移动端适配 */
  @media screen and (max-width: 768px) {
    .quick-buy-content {
      flex-direction: column;
      gap: 12px;
      align-items: stretch;
    }

    .quick-buy-product-info {
      justify-content: center;
    }

    .quick-buy-title {
      max-width: none;
      text-align: center;
    }

    .quick-buy-options {
      flex-direction: column;
      gap: 12px;
    }

    .quick-buy-variants {
      justify-content: center;
      flex-wrap: wrap;
    }

    .variant-option {
      flex-direction: column;
      gap: 6px;
      align-items: center;
    }

    .option-buttons {
      flex-wrap: wrap;
      justify-content: center;
    }

    .quick-buy-quantity {
      justify-content: center;
    }

    .quick-buy-btn {
      width: 100%;
    }
  }

  @media screen and (max-width: 480px) {
    .quick-buy-variants {
      flex-direction: column;
      gap: 8px;
    }

    .option-btn {
      padding: 8px 16px;
      font-size: 13px;
    }
  }

  .product-information {
    gap: var(--gap) 0;
  }

  /* Base grid layout */
  .product-information__grid {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: 1 / -1;
  }

  /* Default column positions */
  .product-details {
    order: 1;
  }

  .product-information__media {
    order: 0;
    width: 0;
    min-width: 100%;
  }

  /* Mobile styles */
  @media screen and (max-width: 749px) {
    .product-information__media {
      grid-column: 1 / -1;
    }

    .product-details {
      grid-column: 2 / 3;
    }
  }

  /* Desktop styles */
  @media screen and (min-width: 750px) {
    .product-information__grid {
      grid-column: 2;
    }

    /* Position when there is no media */
    .product-information__grid.product-information--media-none,
    .product-information__grid:has(.product-information__media:empty) {
      .product-details {
        width: var(--narrow-content-width);
        margin: 0 auto;
      }
    }

    /* Position when there is media */
    .product-information__grid:not(:has(.product-information__media:empty)) {
      /* Media on the left side */
      &.product-information--media-left {
        grid-template-columns: 1fr min(50vw, var(--sidebar-width));

        .product-information__media {
          padding-right: calc(var(--gap, 0) / 2);
        }

        .product-details {
          padding-left: calc(var(--gap, 0) / 2);
        }

        &:has(.media-gallery--extend) {
          grid-column: 1 / 3;
        }
      }

      /* Media on the right side */
      &.product-information--media-right {
        grid-template-columns: min(50vw, var(--sidebar-width)) 1fr;

        .product-information__media {
          padding-left: calc(var(--gap, 0) / 2);
          order: 1;
        }

        .product-details {
          padding-right: calc(var(--gap, 0) / 2);
          order: 0;
        }

        &:has(.media-gallery--extend) {
          grid-column: 2 / -1;
        }
      }

      /* Equal width columns */
      &.product-information__grid--half,
      &.product-information__grid--half:has(.media-gallery--extend) {
        grid-column: 1 / -1;
        grid-template-columns:
          var(--full-page-grid-margin) calc(var(--full-page-grid-central-column-width) / 2) calc(
            var(--full-page-grid-central-column-width) / 2
          )
          var(--full-page-grid-margin);

        &.product-information--media-left {
          .product-information__media {
            grid-column: 2 / 3;

            &:has(.media-gallery--extend) {
              grid-column: 1 / 3;
            }
          }

          .product-details {
            grid-column: 3 / 4;
          }
        }

        &.product-information--media-right {
          .product-information__media {
            grid-column: 3 / 4;

            &:has(.media-gallery--extend) {
              grid-column: 3 / -1;
            }
          }

          .product-details {
            grid-column: 2 / 3;
          }
        }
      }
    }

    /* Handle full width section */
    .section--full-width {
      .product-information__grid:not(:has(.product-information__media:empty)),
      .product-information__grid:not(:has(.product-information__media:empty)) {
        &.product-information--media-left,
        &.product-information--media-right {
          grid-column: 1 / -1;
        }

        &.product-information--media-left .product-details {
          padding-inline-end: var(--padding-lg);
        }

        &.product-information--media-right .product-details {
          padding-inline-start: var(--padding-lg);
        }

        &.product-information__grid--half.product-information--media-left {
          .product-information__media {
            grid-column: 1 / 3;
          }

          .product-details {
            grid-column: 3 / -1;
          }
        }

        &.product-information__grid--half.product-information--media-right {
          .product-information__media {
            grid-column: 3 / -1;
          }

          .product-details {
            grid-column: 1 / 3;
          }
        }
      }
    }
  }

  /* Wider sidebar for large screens */
  @media screen and (min-width: 1200px) {
    .product-information__grid:not(
        .product-information__grid--half,
        :has(.product-information__media:empty)
      ).product-information--media-left {
      grid-template-columns: 2fr 1fr;
    }

    .product-information__grid:not(
        .product-information__grid--half,
        :has(.product-information__media:empty)
      ).product-information--media-right {
      grid-template-columns: 1fr 2fr;
    }
  }

  .product-information__grid--limit-details .product-details > .group-block {
    max-width: var(--sidebar-width);
  }

  /* If the header is sticky, make product details content stick underneath the header */
  body:has(#header-group #header-component[data-sticky-state='active']) .product-details.sticky-content--desktop {
    --sticky-header-offset: var(--header-height);
  }

  .product-detail-section {
    padding: {{ section.settings.section_padding_top }}px 20px {{ section.settings.section_padding_bottom }}px 20px;
    width: 100%;
    margin: 0 auto;
    background: transparent;
  }

  .product-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.content_gap }}px;
    align-items: start;
  }

  /* 左侧图片区域 */
  .product-images {
    position: sticky;
    top: 20px;
  }

  .main-image {
    width: 100%;
    height: calc(100vh - 180px); /* 100vh - 40px(announcement) - 80px(navigation) */
    min-height: 500px;
    /*max-height: 800px;*/
    border-radius: {{ section.settings.image_border_radius }}px;
    overflow: hidden;
    background: #f8f8f8;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s ease;
  }

  /* 缩略图移到左下角 */
  .thumbnail-images {
    position: absolute;
    bottom: 20px;
    left: 20px;
    display: flex;
    gap: 8px;
    flex-direction: column;
    z-index: 10;
  }

  .thumbnail {
    width: 60px;
    height: 60px;
    border-radius: {{ section.settings.thumbnail_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid rgba(255, 255, 255, 0.8);
    transition: all 0.3s ease;
    opacity: 0.7;
    background: white;
  }

  .thumbnail:hover {
    opacity: 1;
    border-color: {{ section.settings.accent_color }};
    transform: scale(1.05);
  }

  .thumbnail.active {
    border-color: {{ section.settings.accent_color }};
    opacity: 1;
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 右侧商品信息区域 */
  .product-info {
    height: calc(100vh - 180px); /* 100vh - 40px(announcement) - 80px(navigation) */
    min-height: 500px;
    /*max-height: 800px;*/
    overflow-y: auto;
    padding: 40px;
    border-radius: {{ section.settings.info_border_radius }}px;
  }

  .product-info::-webkit-scrollbar {
    width: 6px;
  }

  .product-info::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 3px;
  }

  .product-info::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 3px;
  }

  .product-title {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    color: {{ section.settings.title_color }};
    margin: 0 0 10px 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .product-subtitle {
    font-size: {{ section.settings.subtitle_font_size }}px;
    color: {{ section.settings.subtitle_color }};
    margin: 0 0 15px 0;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 25px;
  }

  .stars {
    color: {{ section.settings.star_color }};
    font-size: 1.1rem;
  }

  .rating-count {
    color: {{ section.settings.text_color }};
    font-size: 0.9rem;
  }

  .product-description {
    color: {{ section.settings.text_color }};
    line-height: 1.6;
    margin-bottom: 30px;
    font-size: {{ section.settings.description_font_size }}px;
  }

  /* 价格显示控制 */
  .mobile-price {
    display: none;
  }

  .desktop-price {
    display: block;
  }

  /* 商品选项 */
  .product-option {
    margin-bottom: 25px;
  }

  .option-label {
    display: block;
    font-weight: 500;
    margin-bottom: 10px;
    color: {{ section.settings.label_color }};
    font-size: 0.9rem;
  }

  /* 颜色选择器 */
  .color-selector {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .color-selector input[type="radio"] {
    display: none;
  }

  .color-option {
    cursor: pointer;
    display: block;
    position: relative;
  }

  .color-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid #e0e0e0;
    display: block;
    transition: all 0.3s ease;
    position: relative;
  }

  .color-circle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .color-selector input[type="radio"]:checked + .color-option .color-circle {
    border-color: {{ section.settings.accent_color }};
    box-shadow: 0 0 0 2px rgba(0,0,0,0.1);
  }

  .color-selector input[type="radio"]:checked + .color-option .color-circle::after {
    opacity: 1;
    background: {{ section.settings.accent_color }};
  }

  /* 颜色定义 */
  .color-strawberry-glaze { background: #d63384; }
  .color-pink { background: #ff69b4; }
  .color-nude { background: #deb887; }
  .color-clear { background: #ffffff; border-color: #ccc; }
  .color-lavender { background: #e6e6fa; }

  /* 圆角按钮选择器 */
  .button-selector {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .button-selector input[type="radio"] {
    display: none;
  }

  .button-option {
    padding: 10px 20px;
    border: 2px solid #e0e0e0;
    border-radius: {{ section.settings.option_button_border_radius }}px;
    background: transparent;
    color: {{ section.settings.text_color }};
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.9rem;
    font-weight: 500;
    min-width: 60px;
    text-align: center;
    display: inline-block;
  }

  .button-option:hover {
    border-color: {{ section.settings.accent_color }};
    background: rgba({{ section.settings.accent_color | color_extract: 'red' }}, {{ section.settings.accent_color | color_extract: 'green' }}, {{ section.settings.accent_color | color_extract: 'blue' }}, 0.1);
  }

  .button-selector input[type="radio"]:checked + .button-option {
    border-color: {{ section.settings.accent_color }};
    background: {{ section.settings.accent_color }};
    color: white;
  }

  /* 数量选择器 */
  .quantity-selector {
    margin-bottom: 25px;
  }

  .quantity-label {
    display: block;
    font-weight: 500;
    margin-bottom: 10px;
    color: {{ section.settings.label_color }};
    font-size: 0.9rem;
  }

  .quantity-input {
    display: flex;
    align-items: center;
    width: fit-content;
    border: 1px solid #ddd;
    border-radius: 6px;
    overflow: hidden;
  }

  .quantity-btn {
    background: #f8f8f8;
    border: none;
    width: 40px;
    height: 40px;
    cursor: pointer;
    font-size: 1.2rem;
    transition: background-color 0.3s ease;
  }

  .quantity-btn:hover {
    background: #e8e8e8;
  }

  .quantity-field {
    border: none;
    width: 60px;
    height: 40px;
    text-align: center;
    font-size: 0.9rem;
    background: white;
  }

  /* 价格 */
  .product-price {
    margin-bottom: 30px;
  }

  .price {
    font-size: {{ section.settings.price_font_size }}px;
    font-weight: 600;
    color: {{ section.settings.price_color }};
  }

  .compare-price {
    font-size: {{ section.settings.compare_price_font_size }}px;
    color: #999;
    text-decoration: line-through;
    margin-left: 10px;
  }

  /* 立即购买按钮 */
  .buy-now-btn {
    width: 100%;
    padding: 16px 24px;
    border: 2px solid;
    border-radius: {{ section.settings.button_border_radius }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    background: transparent;
  }

  .buy-now-btn:hover {
    background: {{ section.settings.button_color }};
    color: white !important;
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    .product-detail-section {
      padding: 20px 15px;
    }

    .product-container {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .product-images {
      position: static;
      order: 1;
    }

    .main-image {
      height: 350px;
      border-radius: 8px;
    }

    .product-info {
      height: auto;
      overflow-y: visible;
      padding: 20px;
      order: 2;
    }

    .product-title {
      font-size: {{ section.settings.title_font_size | minus: 12 }}px;
      margin-bottom: 8px;
    }

    .product-subtitle {
      font-size: {{ section.settings.subtitle_font_size | minus: 1 }}px;
      margin-bottom: 12px;
    }

    .product-rating {
      margin-bottom: 15px;
    }

    .product-description {
      font-size: {{ section.settings.description_font_size | minus: 1 }}px;
      margin-bottom: 20px;
    }

    .product-option {
      margin-bottom: 20px;
    }

    .quantity-selector {
      margin-bottom: 20px;
    }

    /* 价格显示控制 - 移动端 */
    .mobile-price {
      display: block;
      margin-bottom: 20px;
      padding: 15px;
      background: rgba(248, 248, 248, 0.8);
      border-radius: 8px;
      text-align: center;
    }

    .desktop-price {
      display: none;
    }

    .mobile-price .price {
      font-size: {{ section.settings.price_font_size | plus: 4 }}px;
    }

    /* 移动端隐藏缩略图 */
    .thumbnail-images {
      display: none;
    }

    /* 颜色选择器适配 */
    .color-selector {
      gap: 10px;
      justify-content: center;
    }

    .color-circle {
      width: 35px;
      height: 35px;
    }

    .color-circle::after {
      width: 16px;
      height: 16px;
    }

    /* 按钮选择器适配 */
    .button-selector {
      gap: 8px;
    }

    .button-option {
      padding: 8px 16px;
      font-size: 0.85rem;
      min-width: 50px;
    }

    /* 按钮适配 */
    .buy-now-btn {
      padding: 18px 24px;
      font-size: {{ section.settings.button_font_size | plus: 2 }}px;
      font-weight: 600;
      position: sticky;
      bottom: 20px;
      z-index: 100;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }

    /* 数量选择器适配 */
    .quantity-input {
      width: 100%;
      max-width: 150px;
      margin: 0 auto;
    }

    .quantity-btn {
      width: 45px;
      height: 45px;
      font-size: 1.4rem;
    }

    .quantity-field {
      width: 60px;
      height: 45px;
      font-size: 1rem;
    }
  }

  /* 超小屏幕适配 */
  @media (max-width: 480px) {
    .product-detail-section {
      padding: 15px 10px;
    }

    .main-image {
      height: 300px;
    }

    .product-title {
      font-size: {{ section.settings.title_font_size | minus: 16 }}px;
    }

    .thumbnail {
      width: 45px;
      height: 45px;
    }

    .color-circle {
      width: 32px;
      height: 32px;
    }

    .buy-now-btn {
      bottom: 10px;
      margin: 0 -10px;
      border-radius: 0;
    }
  }

  /* 横屏适配 */
  @media (max-width: 768px) and (orientation: landscape) {
    .main-image {
      height: 250px;
    }

    .buy-now-btn {
      position: static;
      margin-top: 20px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const mainImage = document.getElementById('main-product-image');
    const productImages = document.querySelector('.product-images');
    let touchStartX = 0;
    let touchEndX = 0;
    let currentImageIndex = 0;
    const images = Array.from(document.querySelectorAll('.thumbnail')).map((thumb) => ({
      src: thumb.dataset.image,
      alt: thumb.dataset.imageAlt,
    }));

    // 移动端滑动切换功能
    if (window.innerWidth <= 768) {
      productImages.addEventListener(
        'touchstart',
        function (e) {
          touchStartX = e.changedTouches[0].screenX;
        },
        false
      );

      productImages.addEventListener(
        'touchend',
        function (e) {
          touchEndX = e.changedTouches[0].screenX;
          handleSwipe();
        },
        false
      );

      function handleSwipe() {
        if (touchEndX < touchStartX && currentImageIndex < images.length - 1) {
          // 向左滑动 - 下一张
          currentImageIndex++;
          changeImage(currentImageIndex);
        } else if (touchEndX > touchStartX && currentImageIndex > 0) {
          // 向右滑动 - 上一张
          currentImageIndex--;
          changeImage(currentImageIndex);
        }
      }

      function changeImage(index) {
        if (mainImage && images[index]) {
          mainImage.src = images[index].src;
          mainImage.alt = images[index].alt;
        }
      }
    } else {
      // 桌面端保留缩略图悬停切换功能
      const thumbnails = document.querySelectorAll('.thumbnail');
      thumbnails.forEach((thumbnail) => {
        thumbnail.addEventListener('mouseenter', function () {
          const newImageSrc = this.dataset.image;
          const newImageAlt = this.dataset.imageAlt;
          if (newImageSrc && mainImage) {
            mainImage.src = newImageSrc;
            mainImage.alt = newImageAlt;
            thumbnails.forEach((t) => t.classList.remove('active'));
            this.classList.add('active');
          }
        });
      });
    }

    // 数量选择器功能
    const minusBtn = document.querySelector('.quantity-btn.minus');
    const plusBtn = document.querySelector('.quantity-btn.plus');
    const quantityField = document.querySelector('.quantity-field');

    if (minusBtn && plusBtn && quantityField) {
      minusBtn.addEventListener('click', function () {
        const currentValue = parseInt(quantityField.value);
        if (currentValue > 1) {
          quantityField.value = currentValue - 1;
        }
      });

      plusBtn.addEventListener('click', function () {
        const currentValue = parseInt(quantityField.value);
        quantityField.value = currentValue + 1;
      });
    }

    // 立即购买功能
    const buyNowBtn = document.querySelector('.buy-now-btn');
    if (buyNowBtn) {
      buyNowBtn.addEventListener('click', function (e) {
        e.preventDefault();

        const form = document.getElementById('product-form');
        const formData = new FormData(form);

        // 添加加载状态
        this.textContent = '处理中...';
        this.disabled = true;

        // 先添加到购物车
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: formData.get('id'),
            quantity: parseInt(formData.get('quantity')) || 1,
          }),
        })
          .then((response) => {
            if (response.ok) {
              return response.json();
            }
            throw new Error('添加到购物车失败');
          })
          .then((data) => {
            // 成功添加后跳转到结账页面
            window.location.href = '/checkout';
          })
          .catch((error) => {
            console.error('Error:', error);
            alert('添加到购物车时出现错误，请重试');
            // 恢复按钮状态
            this.textContent = '{{ section.settings.buy_now_text }}';
            this.disabled = false;
          });
      });
    }
    const quickBuyBar = document.getElementById('quickBuyBar');
  const quickBuyButton = document.getElementById('quickBuyButton');
  // const quickBuyClose = document.getElementById('quickBuyClose');
  const quantityInput = document.querySelector('.quantity-input');
  const quantityMinus = document.querySelector('.quantity-minus');
  const quantityPlus = document.querySelector('.quantity-plus');
  const optionButtons = document.querySelectorAll('.option-btn');
  const btnPrice = document.querySelector('.btn-price');
  
  let currentVariant = null;
  let isVisible = false;
  let selectedOptions = [];
  
  // 产品变体数据
  const productVariants = {{ closest.product.variants | json }};
  const productOptions = {{ closest.product.options | json }};
  
  // 初始化选中的选项
  document.querySelectorAll('.option-buttons').forEach((buttonGroup, index) => {
    const activeBtn = buttonGroup.querySelector('.option-btn.active');
    selectedOptions[index] = activeBtn ? activeBtn.dataset.value : '';
  });
  
  // 滚动监听
  let ticking = false;
  function handleScroll() {
    if (!ticking) {
      requestAnimationFrame(function() {
        const scrollY = window.scrollY;
        const shouldShow = scrollY > 300;
        
        if (shouldShow && !isVisible) {
          quickBuyBar.style.display = 'block';
          setTimeout(() => quickBuyBar.classList.add('show'), 10);
          isVisible = true;
        } else if (!shouldShow && isVisible) {
          quickBuyBar.classList.remove('show');
          setTimeout(() => {
            if (!quickBuyBar.classList.contains('show')) {
              quickBuyBar.style.display = 'none';
            }
          }, 300);
          isVisible = false;
        }
        ticking = false;
      });
    }
    ticking = true;
  }
  
  window.addEventListener('scroll', handleScroll);
  
  // // 关闭按钮
  // quickBuyClose.addEventListener('click', function() {
  //   quickBuyBar.classList.remove('show');
  //   setTimeout(() => quickBuyBar.style.display = 'none', 300);
  //   isVisible = false;
  // });
  
  // 数量控制
  quantityMinus.addEventListener('click', function() {
    const currentValue = parseInt(quantityInput.value);
    if (currentValue > 1) {
      quantityInput.value = currentValue - 1;
    }
  });
  
  quantityPlus.addEventListener('click', function() {
    const currentValue = parseInt(quantityInput.value);
    quantityInput.value = currentValue + 1;
  });
  
  // 选项按钮点击事件
  optionButtons.forEach(button => {
    button.addEventListener('click', function() {
      const buttonGroup = this.parentElement;
      const optionIndex = parseInt(buttonGroup.dataset.optionIndex);
      
      // 移除同组其他按钮的active状态
      buttonGroup.querySelectorAll('.option-btn').forEach(btn => {
        btn.classList.remove('active');
      });
      
      // 添加当前按钮的active状态
      this.classList.add('active');
      
      // 更新选中的选项
      selectedOptions[optionIndex] = this.dataset.value;
      
      // 更新当前变体
      updateCurrentVariant();
    });
  });
  
  // 查找变体
  function findVariantByOptions(options) {
    return productVariants.find(variant => {
      return variant.options.every((option, index) => option === options[index]);
    });
  }
  
  // 格式化价格
  function formatPrice(price) {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD'
    }).format(price / 100);
  }
  
  // 更新当前变体
  function updateCurrentVariant() {
    currentVariant = findVariantByOptions(selectedOptions);
    
    if (currentVariant) {
      // 更新按钮中的价格
      btnPrice.textContent = formatPrice(currentVariant.price);
      
      // 更新按钮状态
      quickBuyButton.disabled = !currentVariant.available;
      const btnText = quickBuyButton.querySelector('.btn-text');
      
      if (currentVariant.available) {
        btnText.innerHTML = `Buy Now · <span class="btn-price">${formatPrice(currentVariant.price)}</span>`;
      } else {
        btnText.innerHTML = 'Out of Stock';
      }
    }
  }
  
  // 初始化当前变体
  updateCurrentVariant();
  
  // 购买按钮点击
  quickBuyButton.addEventListener('click', function() {
    if (!currentVariant || !currentVariant.available) return;
    
    const quantity = parseInt(quantityInput.value);
    const btnText = quickBuyButton.querySelector('.btn-text');
    const btnLoading = quickBuyButton.querySelector('.btn-loading');
    
    // 显示加载状态
    btnText.style.display = 'none';
    btnLoading.style.display = 'inline';
    quickBuyButton.disabled = true;
    
    // 添加到购物车
    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        id: currentVariant.id,
        quantity: quantity
      })
    })
    .then(response => response.json())
    .then(data => {
      // 成功后跳转到购物车
      window.location.href = '/cart';
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Failed to add to cart, please try again');
    })
    .finally(() => {
      // 恢复按钮状态
      btnText.style.display = 'inline';
      btnLoading.style.display = 'none';
      quickBuyButton.disabled = !currentVariant.available;
    });
  });

    // 监听屏幕旋转
    window.addEventListener('orientationchange', function () {
      setTimeout(function () {
        // 重新计算布局
        window.dispatchEvent(new Event('resize'));
      }, 100);
    });
  });
</script>

