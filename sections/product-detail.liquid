{% schema %}
{
  "name": "Product Detail",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    }
  ],
  "presets": [
    {
      "name": "Product Detail"
    }
  ]
}
{% endschema %}

{% assign product = section.settings.product %}

<style>
  .product-detail-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }

  .product-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    align-content: start;
    height: fit-content;
  }

  .product-image {
    width: 100%;
    height: auto;
    max-height: 300px;
    object-fit: cover;
    background: #f5f5f5;
  }

  .product-info {
    padding: 20px 0;
  }

  .product-title {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .product-price {
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 30px;
  }

  .product-description {
    font-size: 15px;
    line-height: 1.6;
    margin-bottom: 20px;
    color: #333;
  }

  .description-more {
    color: #999;
    cursor: pointer;
    font-size: 15px;
  }

  .size-selector {
    margin: 30px 0;
  }

  .size-buttons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .size-button {
    padding: 12px 24px;
    border: 2px solid #000;
    background: #fff;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    transform: translateZ(0);
    will-change: transform, background-color, color;
  }

  .size-button.selected {
    background: #000;
    color: #fff;
  }

  .size-button:hover {
    background: #000;
    color: #fff;
  }

  .size-button:active {
    transform: scale(0.95);
  }

  .add-to-cart-btn {
    width: 100%;
    max-width: 200px;
    padding: 16px 32px;
    background: #000;
    color: #fff;
    border: none;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 40px;
    transition: background 0.3s;
  }

  .add-to-cart-btn:hover {
    background: #333;
  }

  .product-details-section {
    border-top: 1px solid #e0e0e0;
    padding-top: 20px;
    margin-top: 20px;
  }

  .detail-item {
    border-bottom: 1px solid #e0e0e0;
    padding: 20px 0;
  }

  .detail-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-size: 16px;
    font-weight: 600;
  }

  .detail-toggle {
    font-size: 20px;
    font-weight: 300;
  }

  .detail-content {
    padding-top: 15px;
    font-size: 14px;
    line-height: 1.6;
    color: #333;
  }

  .detail-content p {
    margin-bottom: 10px;
  }

  .delivery-option {
    margin-bottom: 15px;
  }

  .delivery-option strong {
    display: block;
    margin-bottom: 5px;
  }

  .more-links {
    margin-top: 30px;
  }

  .more-links p {
    font-size: 15px;
    margin-bottom: 8px;
  }

  .more-links a {
    color: #00b300;
    text-decoration: none;
    font-weight: 600;
  }

  .more-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 968px) {
    .product-detail-container {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .product-gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .product-title {
      font-size: 20px;
    }

    .product-price {
      font-size: 24px;
    }

    .size-buttons {
      gap: 8px;
    }

    .size-button {
      padding: 10px 20px;
      font-size: 13px;
    }
  }
</style>

<div class="product-detail-container">
  <div class="product-gallery">
    {% if product.images.size > 0 %}
      {% for image in product.images limit: 4 %}
        <img src="{{ image | img_url: '800x' }}" alt="{{ product.title }}" class="product-image">
      {% endfor %}
    {% endif %}
  </div>

  <div class="product-info">
    <h1 class="product-title">{{ product.title }}</h1>
    
    <div class="product-price">€{{ product.price | money_without_currency }}</div>

    <div class="product-description">
      {{ product.description }}
      <span class="description-more">More</span>
    </div>

    <div class="size-selector">
      <div class="size-buttons">
        {% if product.variants.size > 0 %}
          {% for variant in product.variants %}
            <button class="size-button" data-variant-id="{{ variant.id }}">
              {{ variant.title }}
            </button>
          {% endfor %}
        {% else %}
          <button class="size-button selected">SMALL</button>
          <button class="size-button">MEDIUM</button>
          <button class="size-button">LARGE</button>
          <button class="size-button">X-LARGE</button>
        {% endif %}
      </div>
    </div>

    <button class="add-to-cart-btn">ADD TO CART</button>

    <div class="product-details-section">
      {% comment %} 元字段数据获取 - 支持多种访问方式 {% endcomment %}
      {% assign details_value = product.metafields.custom.details.value | default: product.metafields.custom.details %}
      {% assign art_no_value = product.metafields.custom.art_no.value | default: product.metafields.custom.art_no %}
      {% assign size_value = product.metafields.custom.size.value | default: product.metafields.custom.size %}
      {% assign delivery_value = product.metafields.custom.delivery.value | default: product.metafields.custom.delivery %}

      <div class="detail-item">
        <div class="detail-header">
          <span>Details</span>
          <span class="detail-toggle">−</span>
        </div>
        <div class="detail-content">
            <p>{{ product.metafields.custom.details }}</p>
           <p>{{ details_value }}</p>
          
          {% if art_no_value != blank %}
            <p><strong>ART. NO:</strong> {{ art_no_value }}</p>
          {% else %}
            <p><strong>ART. NO:</strong> {{ product.id }}</p>
          {% endif %}
        </div>
      </div>

      <div class="detail-item">
        <div class="detail-header">
          <span>Size & fit</span>
          <span class="detail-toggle">−</span>
        </div>
        <div class="detail-content">
          {% if size_value != blank %}
            <p>{{ size_value }}</p>
          {% else %}
            <p>Model is 185cm/6'1" and wears size M</p>
            <p>Regular fit - true to size</p>
            <p>Measurements taken from size M:</p>
            <ul style="margin-left:20px;">
              <li>Chest: 112cm</li>
              <li>Length: 72cm</li>
              <li>Sleeve: 66cm</li>
            </ul>
          {% endif %}
        </div>
      </div>

      <div class="detail-item">
        <div class="detail-header">
          <span>Delivery</span>
          <span class="detail-toggle">−</span>
        </div>
        <div class="detail-content">
          {% if delivery_value != blank %}
            {{ delivery_value }}
          {% else %}
            <div class="delivery-option">
              <strong>Standard Delivery (3-5 business days)</strong>
              <p>Free on orders over €50</p>
            </div>
            <div class="delivery-option">
              <strong>Express Delivery (1-2 business days)</strong>
              <p>€9.95</p>
            </div>
            <div class="delivery-option">
              <strong>Click & Collect</strong>
              <p>Free - Pick up in store within 2 hours</p>
            </div>
            <p style="margin-top:15px;">
              <a href="/pages/shipping-info" style="color:#00b300;text-decoration:underline;">View full delivery information</a>
            </p>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="more-links">
      <p>More from <a href="#">Champion</a></p>
      <p>More <a href="#">Hooded sweatshirts</a></p>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 从URL获取产品信息 - 支持产品句柄
    const path = window.location.pathname;
    const productHandle = path.split('/').pop();
    
    if (productHandle && productHandle !== 'products') {
      fetchProductByHandle(productHandle);
    }

    // 通过产品句柄获取产品数据
    function fetchProductByHandle(handle) {
      fetch(`/products/${handle}.js`)
        .then(response => response.json())
        .then(product => {
          updateProductDisplay(product);
        })
        .catch(error => {
          console.error('Error fetching product by handle:', error);
        });
    }

    // 更新产品展示
    function updateProductDisplay(product) {
      // 更新标题
      const titleElement = document.querySelector('.product-title');
      if (titleElement && product.title) {
        titleElement.textContent = product.title;
      }

      // 更新价格
      const priceElement = document.querySelector('.product-price');
      if (priceElement && product.price) {
        priceElement.textContent = `€${(product.price / 100).toFixed(2)}`;
      }

      // 更新描述
      const descElement = document.querySelector('.product-description');
      if (descElement && product.description) {
        const shortDesc = product.description.substring(0, 150);
        descElement.innerHTML = `${shortDesc}... <span class="description-more">More</span>`;
      }

      // 更新图片
      const gallery = document.querySelector('.product-gallery');
      if (gallery && product.images && product.images.length > 0) {
        gallery.innerHTML = '';
        product.images.slice(0, 4).forEach(image => {
          const img = document.createElement('img');
          img.src = image;
          img.alt = product.title;
          img.className = 'product-image';
          gallery.appendChild(img);
        });
      }

      // 更新尺码选项
      const sizeContainer = document.querySelector('.size-buttons');
      if (sizeContainer && product.variants && product.variants.length > 0) {
        sizeContainer.innerHTML = '';
        product.variants.forEach((variant, index) => {
          const button = document.createElement('button');
          button.className = `size-button ${index === 0 ? 'selected' : ''}`;
          button.dataset.variantId = variant.id;
          button.textContent = variant.title;
          sizeContainer.appendChild(button);
        });
        
        // 重新绑定尺码选择事件
        bindSizeSelection();
      }
    }

    // 尺码选择
    function bindSizeSelection() {
      const sizeButtons = document.querySelectorAll('.size-button');
      sizeButtons.forEach(button => {
        button.addEventListener('click', function() {
          sizeButtons.forEach(btn => btn.classList.remove('selected'));
          this.classList.add('selected');
        });
      });
    }

    // 初始化尺码选择
    bindSizeSelection();

    // 详情折叠
    const detailHeaders = document.querySelectorAll('.detail-header');
    detailHeaders.forEach(header => {
      header.addEventListener('click', function() {
        const content = this.nextElementSibling;
        const toggle = this.querySelector('.detail-toggle');
        
        if (content.style.display === 'none') {
          content.style.display = 'block';
          toggle.textContent = '−';
        } else {
          content.style.display = 'none';
          toggle.textContent = '+';
        }
      });
    });

    // 添加到购物车
    const addToCartBtn = document.querySelector('.add-to-cart-btn');
    addToCartBtn.addEventListener('click', function() {
      const selectedSize = document.querySelector('.size-button.selected');
      if (!selectedSize) {
        alert('Please select a size');
        return;
      }

      const variantId = selectedSize.dataset.variantId;
      
      // 调用Shopify Cart API添加商品
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          id: variantId,
          quantity: 1
        })
      })
      .then(response => response.json())
      .then(data => {
        // 添加成功提示
        addToCartBtn.textContent = 'ADDED!';
        addToCartBtn.style.background = '#00b300';
        
        setTimeout(() => {
          addToCartBtn.textContent = 'ADD TO CART';
          addToCartBtn.style.background = '#000';
        }, 2000);

        // 更新购物车数量
        updateCartCount();
      })
      .catch(error => {
        console.error('Error adding to cart:', error);
        alert('Failed to add to cart. Please try again.');
      });
    });

    // 更新购物车数量
    function updateCartCount() {
      fetch('/cart.js')
        .then(response => response.json())
        .then(cart => {
          const cartCount = cart.item_count;
          // 更新页面上的购物车数量显示
          const cartCountElements = document.querySelectorAll('.cart-count');
          cartCountElements.forEach(element => {
            element.textContent = cartCount;
          });
        });
    }
  });
</script>
