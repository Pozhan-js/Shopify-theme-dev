    const quickBuyBar = document.querySelector('.quick-buy-bar');
    const productInfo = document.querySelector('.product-info');
    const quickBuyBtn = document.querySelector('.quick-buy-btn');
    const variantSelector = document.querySelector('#quick-buy-variant-selector');

    if (quickBuyBar && productInfo) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach(entry => {
            if (!entry.isIntersecting) {
              quickBuyBar.classList.add('visible');
            } else {
              quickBuyBar.classList.remove('visible');
            }
          });
        },
        {
          threshold: 0.5,
          rootMargin: "0px 0px -50px 0px"
        }
      );

      observer.observe(productInfo);
    }

    // 变体选择逻辑
    const variantSelectors = document.querySelectorAll('.quick-buy-variant-selector');
    const productVariants = {{ product.variants | json }};
    let currentVariant = {{ product.selected_or_first_available_variant | json }};
    
    console.log('Initial variant:', currentVariant);
    console.log('All variants:', productVariants);

    if (variantSelectors.length > 0 && productVariants) {
      variantSelectors.forEach(selector => {
        selector.addEventListener('change', function() {
          const selectedOptions = Array.from(variantSelectors).map(select => select.value);
          console.log('Selected options:', selectedOptions);
          
          // 精确匹配变体
          const matchedVariant = productVariants.find(variant => {
            const match = variant.options.every((option, index) => {
              return option === selectedOptions[index];
            });
            console.log(`Checking variant ${variant.id}:`, variant.options, 'match:', match);
            return match;
          });

          if (matchedVariant) {
            console.log('Matched variant:', matchedVariant);
            currentVariant = matchedVariant;
          } else {
            console.warn('No variant matched selected options');
          }
        });
      });
    }

        // 快速购买功能
        if (quickBuyBtn) {
          quickBuyBtn.addEventListener('click', function(e) {
            e.preventDefault();
            console.log('Current variant when adding to cart:', currentVariant);
            const variantId = currentVariant ? currentVariant.id : {{ product.selected_or_first_available_variant.id }};

        // 添加加载状态
        this.textContent = '处理中...';
        this.disabled = true;

        // 添加到购物车
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: variantId,
            quantity: 1
          }),
        })
          .then((response) => {
            if (response.ok) {
              return response.json();
            }
            throw new Error('添加到购物车失败');
          })
          .then((data) => {
            // 更新购物车数量
            fetch('/cart.js')
              .then(response => response.json())
              .then(cart => {
                const cartItems = document.querySelectorAll('.cart-count-bubble');
                if (cartItems) {
                  cartItems.forEach(item => {
                    item.textContent = cart.item_count;
                  });
                }
              });

            // 恢复按钮状态
            this.textContent = '快速购买';
            this.disabled = false;

            // 静默添加，不显示提示
          })
          .catch((error) => {
            console.error('Error:', error);
            console.error('添加到购物车失败:', error);
            // 恢复按钮状态
            this.textContent = '快速购买';
            this.disabled = false;
          });
      });
    }
  });
class CustomVariantSelector {
  constructor(container) {
    this.container = container;
    this.productData = JSON.parse(document.getElementById('product-json').textContent);
    this.variantSelect = container.querySelector('#variant-selector');
    this.optionButtons = container.querySelectorAll('.option-button');
    this.addToCartBtn = container.querySelector('[data-add-to-cart]');
    
    // 当前选中的选项
    this.selectedOptions = this.getInitialSelectedOptions();
    
    this.init();
  }

  init() {
    // 绑定选项按钮点击事件
    this.optionButtons.forEach(button => {
      button.addEventListener('click', this.handleOptionClick.bind(this));
    });

    // 初始化时更新一次
    this.updateVariant();
    
    // 监听 URL 变化（浏览器前进/后退）
    window.addEventListener('popstate', this.handlePopState.bind(this));
    
    // 从 URL 读取初始变体
    this.loadVariantFromUrl();
  }

  // 获取初始选中的选项
  getInitialSelectedOptions() {
    const options = {};
    this.productData.options.forEach((option, index) => {
      const position = index + 1;
      const activeButton = this.container.querySelector(
        `.option-button[data-option-position="${position}"].active`
      );
      options[position] = activeButton ? activeButton.dataset.value : option.values[0];
    });
    return options;
  }

  // 处理选项点击
  handleOptionClick(event) {
    const button = event.currentTarget;
    const position = button.dataset.optionPosition;
    const value = button.dataset.value;

    // 更新选中状态
    const optionGroup = button.closest('.option-group');
    optionGroup.querySelectorAll('.option-button').forEach(btn => {
      btn.classList.remove('active');
    });
    button.classList.add('active');

    // 更新选中的选项
    this.selectedOptions[position] = value;

    // 更新变体
    this.updateVariant();
  }

  // 更新变体
  updateVariant() {
    const variant = this.getVariantFromOptions();
    
    if (variant) {
      // 更新隐藏的 select
      this.variantSelect.value = variant.id;
      
      // 更新 URL
      this.updateUrl(variant.id);
      
      // 更新价格
      this.updatePrice(variant);
      
      // 更新库存状态
      this.updateAvailability(variant);
      
      // 更新按钮状态
      this.updateAddToCartButton(variant);
      
      // 更新不可用的选项
      this.updateDisabledOptions();
    }
  }

  // 根据选中的选项获取变体
  getVariantFromOptions() {
    return this.productData.variants.find(variant => {
      return this.productData.options.every((option, index) => {
        const position = index + 1;
        return variant.options[index] === this.selectedOptions[position];
      });
    });
  }

  // 更新 URL
  updateUrl(variantId) {
    const url = new URL(window.location.href);
    url.searchParams.set('variant', variantId);
    window.history.replaceState({ path: url.href }, '', url.href);
  }

  // 更新价格
  updatePrice(variant) {
    const priceElement = this.container.querySelector('[data-price]');
    const comparePriceElement = this.container.querySelector('[data-compare-price]');
    
    if (priceElement) {
      priceElement.textContent = this.formatMoney(variant.price);
    }
    
    if (comparePriceElement) {
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        comparePriceElement.textContent = this.formatMoney(variant.compare_at_price);
        comparePriceElement.style.display = 'inline';
      } else {
        comparePriceElement.style.display = 'none';
      }
    }
  }

  // 更新库存状态
  updateAvailability(variant) {
    const availabilityElement = this.container.querySelector('[data-availability]');
    
    if (availabilityElement) {
      if (variant.available) {
        availabilityElement.innerHTML = '<span class="in-stock">有货</span>';
      } else {
        availabilityElement.innerHTML = '<span class="out-of-stock">缺货</span>';
      }
    }
  }

  // 更新加入购物车按钮
  updateAddToCartButton(variant) {
    if (variant.available) {
      this.addToCartBtn.disabled = false;
      this.addToCartBtn.textContent = '加入购物车';
    } else {
      this.addToCartBtn.disabled = true;
      this.addToCartBtn.textContent = '售罄';
    }
  }

  // 更新不可用的选项（禁用售罄的组合）
  updateDisabledOptions() {
    this.productData.options.forEach((option, optionIndex) => {
      const position = optionIndex + 1;
      
      option.values.forEach(value => {
        const button = this.container.querySelector(
          `.option-button[data-option-position="${position}"][data-value="${value}"]`
        );
        
        if (button) {
          // 创建临时选项对象来检查
          const tempOptions = { ...this.selectedOptions };
          tempOptions[position] = value;
          
          // 检查是否有可用的变体
          const hasAvailableVariant = this.productData.variants.some(variant => {
            const matchesOptions = this.productData.options.every((opt, idx) => {
              const pos = idx + 1;
              return variant.options[idx] === tempOptions[pos];
            });
            return matchesOptions && variant.available;
          });
          
          button.disabled = !hasAvailableVariant;
        }
      });
    });
  }

  // 从 URL 加载变体
  loadVariantFromUrl() {
    const urlParams = new URLSearchParams(window.location.search);
    const variantId = urlParams.get('variant');
    
    if (variantId) {
      const variant = this.productData.variants.find(v => v.id == variantId);
      if (variant) {
        // 更新选中的选项
        variant.options.forEach((value, index) => {
          const position = index + 1;
          this.selectedOptions[position] = value;
          
          // 更新按钮状态
          const button = this.container.querySelector(
            `.option-button[data-option-position="${position}"][data-value="${value}"]`
          );
          if (button) {
            const optionGroup = button.closest('.option-group');
            optionGroup.querySelectorAll('.option-button').forEach(btn => {
              btn.classList.remove('active');
            });
            button.classList.add('active');
          }
        });
        
        this.updateVariant();
      }
    }
  }

  // 处理浏览器前进/后退
  handlePopState() {
    this.loadVariantFromUrl();
  }

  // 格式化金额（简化版，实际应使用 Shopify 的 money_format）
  formatMoney(cents) {
    return '$' + (cents / 100).toFixed(2);
  }
}

// 初始化
document.addEventListener('DOMContentLoaded', () => {
  const container = document.querySelector('.custom-variant-selector');
  if (container) {
    new CustomVariantSelector(container);
  }
});

  document.addEventListener('DOMContentLoaded', function () {
    const mainImage = document.getElementById('main-product-image');
    const productImages = document.querySelector('.product-images');
    let touchStartX = 0;
    let touchEndX = 0;
    let currentImageIndex = 0;
    const images = Array.from(document.querySelectorAll('.thumbnail')).map((thumb) => ({
      src: thumb.dataset.image,
      alt: thumb.dataset.imageAlt,
    }));

    // 移动端滑动切换功能
    if (window.innerWidth <= 768) {
      productImages.addEventListener(
        'touchstart',
        function (e) {
          touchStartX = e.changedTouches[0].screenX;
        },
        false
      );

      productImages.addEventListener(
        'touchend',
        function (e) {
          touchEndX = e.changedTouches[0].screenX;
          handleSwipe();
        },
        false
      );

      function handleSwipe() {
        if (touchEndX < touchStartX && currentImageIndex < images.length - 1) {
          // 向左滑动 - 下一张
          currentImageIndex++;
          changeImage(currentImageIndex);
        } else if (touchEndX > touchStartX && currentImageIndex > 0) {
          // 向右滑动 - 上一张
          currentImageIndex--;
          changeImage(currentImageIndex);
        }
      }

      function changeImage(index) {
        if (mainImage && images[index]) {
          mainImage.src = images[index].src;
          mainImage.alt = images[index].alt;
        }
      }
    } else {
      // 桌面端保留缩略图悬停切换功能
      const thumbnails = document.querySelectorAll('.thumbnail');
      thumbnails.forEach((thumbnail) => {
        thumbnail.addEventListener('mouseenter', function () {
          const newImageSrc = this.dataset.image;
          const newImageAlt = this.dataset.imageAlt;
          if (newImageSrc && mainImage) {
            mainImage.src = newImageSrc;
            mainImage.alt = newImageAlt;
            thumbnails.forEach((t) => t.classList.remove('active'));
            this.classList.add('active');
          }
        });
      });
    }

    // 数量选择器功能
    const minusBtn = document.querySelector('.quantity-btn.minus');
    const plusBtn = document.querySelector('.quantity-btn.plus');
    const quantityField = document.querySelector('.quantity-field');

    if (minusBtn && plusBtn && quantityField) {
      minusBtn.addEventListener('click', function () {
        const currentValue = parseInt(quantityField.value);
        if (currentValue > 1) {
          quantityField.value = currentValue - 1;
        }
      });

      plusBtn.addEventListener('click', function () {
        const currentValue = parseInt(quantityField.value);
        quantityField.value = currentValue + 1;
      });
    }

    // 立即购买功能
    const buyNowBtn = document.querySelector('.buy-now-btn');
    if (buyNowBtn) {
      buyNowBtn.addEventListener('click', function (e) {
        e.preventDefault();

        const form = document.getElementById('product-form');
        const formData = new FormData(form);

        // 添加加载状态
        this.textContent = '处理中...';
        this.disabled = true;

        // 先添加到购物车
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: formData.get('id'),
            quantity: parseInt(formData.get('quantity')) || 1,
          }),
        })
          .then((response) => {
            if (response.ok) {
              return response.json();
            }
            throw new Error('添加到购物车失败');
          })
          .then((data) => {
            // 成功添加后跳转到结账页面
            window.location.href = '/checkout';
          })
          .catch((error) => {
            console.error('Error:', error);
            alert('添加到购物车时出现错误，请重试');
            // 恢复按钮状态
            this.textContent = '{{ section.settings.buy_now_text }}';
            this.disabled = false;
          });
      });
    }

    // 监听屏幕旋转
    window.addEventListener('orientationchange', function () {
      setTimeout(function () {
        // 重新计算布局
        window.dispatchEvent(new Event('resize'));
      }, 100);
    });
  });
</script>

