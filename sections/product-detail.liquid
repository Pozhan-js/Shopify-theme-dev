{% schema %}
{
  "name": "Product Detail",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "More Links Settings"
    },
    {
      "type": "text",
      "id": "more_links_title_1",
      "label": "First Link Title",
      "default": "More from"
    },
    {
      "type": "text",
      "id": "more_links_text_1",
      "label": "First Link Text",
      "default": "Champion"
    },
    {
      "type": "url",
      "id": "more_links_url_1",
      "label": "First Link URL"
    },
    {
      "type": "text",
      "id": "more_links_title_2",
      "label": "Second Link Title",
      "default": "More"
    },
    {
      "type": "text",
      "id": "more_links_text_2",
      "label": "Second Link Text",
      "default": "Hooded sweatshirts"
    },
    {
      "type": "url",
      "id": "more_links_url_2",
      "label": "Second Link URL"
    },
    {
      "type": "text",
      "id": "more_links_title_3",
      "label": "Third Link Title (Optional)",
      "info": "Leave empty to hide this link"
    },
    {
      "type": "text",
      "id": "more_links_text_3",
      "label": "Third Link Text (Optional)"
    },
    {
      "type": "url",
      "id": "more_links_url_3",
      "label": "Third Link URL (Optional)"
    },
    {
      "type": "text",
      "id": "more_links_title_4",
      "label": "Fourth Link Title (Optional)",
      "info": "Leave empty to hide this link"
    },
    {
      "type": "text",
      "id": "more_links_text_4",
      "label": "Fourth Link Text (Optional)"
    },
    {
      "type": "url",
      "id": "more_links_url_4",
      "label": "Fourth Link URL (Optional)"
    }
  ],
  "presets": [
    {
      "name": "Product Detail"
    }
  ]
}
{% endschema %}

{% comment %} 从URL获取产品信息 - 参考test_product.liquid的方法 {% endcomment %}
{% assign url_parts = request.path | split: '/' %}
{% assign product_handle = '' %}

{% for part in url_parts %}
  {% if part contains 'products' %}
    {% assign product_index = forloop.index %}
    {% if url_parts.size > product_index %}
      {% assign product_handle = url_parts[product_index] %}
    {% endif %}
    {% break %}
  {% endif %}
{% endfor %}

{% if product_handle == blank %}
  {% assign product_handle = section.settings.product.handle %}
{% endif %}

{% assign current_product = all_products[product_handle] %}

<style>
  .product-detail-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 40px 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
  }

  .product-gallery {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    align-content: start;
    height: fit-content;
  }

  .product-image {
    width: 100%;
    height: auto;
    max-height: 500px;
    object-fit: contain;
    background: #f5f5f5;
  }

  .product-info {
    padding: 20px 0;
  }

  .product-title {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .product-price {
    font-size: 28px;
    font-weight: 600;
    margin-bottom: 30px;
  }

  .product-description {
    font-size: 15px;
    line-height: 1.6;
    margin-bottom: 20px;
    color: #000;
    font-weight: bold;
  }

  .description-more {
    color: #999;
    cursor: pointer;
    font-size: 15px;
  }

  .size-selector {
    margin: 30px 0;
  }

  .size-buttons {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .size-button {
    padding: 10px;
    text-transform: uppercase;
    text-align: center;
    line-height: 1;
    color: #000;
    background-color: #ddd;
    border-radius: 7px;
    white-space: nowrap;
    display: block;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .size-button.selected {
    background-color: #000;
    color: #fff;
  }

  .size-button:hover {
    background-color: #000;
    color: #fff;
  }

  .add-to-cart-btn {
    width: 100%;
    max-width: 200px;
    padding: 16px 32px;
    background: #aaa;
    color: #fff;
    border: none;
    font-size: 14px;
    font-weight: 600;
    cursor: not-allowed;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 40px;
    transition: background 0.3s;
    border-radius: 15px;
  }

  .add-to-cart-btn:not(:disabled) {
    background: #000;
    cursor: pointer;
  }

  .add-to-cart-btn:not(:disabled):hover {
    background: #333;
  }

  .product-details-section {
    border-top: 1px solid #e0e0e0;
    padding-top: 20px;
    margin-top: 20px;
  }

  .detail-item {
    border-bottom: 1px solid #e0e0e0;
    padding: 20px 0;
  }

  .detail-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-size: 16px;
    font-weight: bold;
  }

  .detail-toggle {
    font-size: 20px;
    font-weight: 300;
  }

  .detail-content {
    padding-top: 15px;
    font-size: 14px;
    line-height: 1.6;
    color: #333;
  }

  .detail-content p {
    margin-bottom: 10px;
  }

  .delivery-option {
    margin-bottom: 15px;
  }

  .delivery-option strong {
    display: block;
    margin-bottom: 5px;
  }

  .more-links {
    margin-top: 30px;
  }

  .more-links p {
    font-size: 15px;
    margin-bottom: 8px;
  }

  .more-links a {
    color: #1240FF;
    text-decoration: none;
    font-weight: 600;
  }

  .more-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 968px) {
    .product-detail-container {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .product-gallery {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .product-title {
      font-size: 20px;
    }

    .product-price {
      font-size: 24px;
    }

    .size-buttons {
      gap: 8px;
    }

    .size-button {
      padding: 10px 20px;
      font-size: 13px;
    }
  }
</style>

<div class="product-detail-container">
  {% comment %} 使用当前产品或从URL获取的产品 {% endcomment %}
  {% assign product_to_use = current_product %}
  {% if product_to_use == blank %}
    {% assign product_to_use = product %}
  {% endif %}

  <div class="product-gallery">
    {% if product_to_use.images.size > 0 %}
      {% for image in product_to_use.images limit: 4 %}
        <img src="{{ image | img_url: '800x' }}" alt="{{ product_to_use.title }}" class="product-image" width="400" height="300">
      {% endfor %}
    {% endif %}
  </div>

  <div class="product-info">
    <h1 class="product-title">{{ product_to_use.title }}</h1>
    
    <div class="product-price">{{ product_to_use.price | money }}</div>

    <div class="product-description">
      {{ product_to_use.description }}
      {% comment %} <span class="description-more">More</span> {% endcomment %}
    </div>

    <div class="size-selector">
      <div class="size-buttons">
        {% if product_to_use.variants.size > 0 %}
          {% for variant in product_to_use.variants %}
            <button class="size-button" data-variant-id="{{ variant.id }}">
              {{ variant.title }}
            </button>
          {% endfor %}
        {% else %}
          <button class="size-button selected">SMALL</button>
          <button class="size-button">MEDIUM</button>
          <button class="size-button">LARGE</button>
          <button class="size-button">X-LARGE</button>
        {% endif %}
      </div>
    </div>

    <button class="add-to-cart-btn" disabled>SELECT SIZE</button>

    <div class="product-details-section">
      {% comment %} 使用Liquid直接获取产品元字段 {% endcomment %}
      <div class="detail-item">
        <div class="detail-header">
          <span>Details</span>
          <span class="detail-toggle">+</span>
        </div>
        <div class="detail-content" style="display: none;">
          {% if product_to_use.metafields.custom.details %}
            <p>{{ product_to_use.metafields.custom.details }}</p>
          {% else %}
            <p>Premium quality materials with attention to detail. Designed for comfort and durability.</p>
          {% endif %}
          
          {% if product_to_use.metafields.custom.art_no %}
            <p><span>ART. NO:</span> {{ product_to_use.metafields.custom.art_no }}</p>
          {% else %}
            <p><span>ART. NO:</span> {{ product_to_use.id }}</p>
          {% endif %}
        </div>
      </div>

      <div class="detail-item">
        <div class="detail-header">
          <span>Size & fit</span>
          <span class="detail-toggle">+</span>
        </div>
        <div class="detail-content" style="display: none;">
          {% if product_to_use.metafields.custom.size %}
            <p>{{ product_to_use.metafields.custom.size }}</p>
          {% else %}
            <p>Model is 185cm/6'1" and wears size M</p>
            <p>Regular fit - true to size</p>
            <p>Measurements taken from size M:</p>
            <ul style="margin-left:20px;">
              <li>Chest: 112cm</li>
              <li>Length: 72cm</li>
              <li>Sleeve: 66cm</li>
            </ul>
          {% endif %}
        </div>
      </div>

      <div class="detail-item">
        <div class="detail-header">
          <span>Delivery</span>
          <span class="detail-toggle">+</span>
        </div>
        <div class="detail-content" style="display: none;">
          {% if product_to_use.metafields.custom.delivery %}
            {% render 'delivery-renderer', delivery_text: product_to_use.metafields.custom.delivery %}
          {% else %}
            <div class="delivery-option">
              <strong>Standard Delivery (3-5 business days)</strong>
              <p>Free on orders over €50</p>
            </div>
            <div class="delivery-option">
              <strong>Express Delivery (1-2 business days)</strong>
              <p>€9.95</p>
            </div>
            <div class="delivery-option">
              <strong>Click & Collect</strong>
              <p>Free - Pick up in store within 2 hours</p>
            </div>
            <p style="margin-top:15px;">
              <a href="/pages/shipping-info" style="color:#00b300;text-decoration:underline;">View full delivery information</a>
            </p>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="more-links">
      {% if section.settings.more_links_title_1 != blank and section.settings.more_links_text_1 != blank and section.settings.more_links_url_1 != blank %}
        <p>{{ section.settings.more_links_title_1 }} <a href="{{ section.settings.more_links_url_1 }}">{{ section.settings.more_links_text_1 }}</a></p>
      {% endif %}
      
      {% if section.settings.more_links_title_2 != blank and section.settings.more_links_text_2 != blank and section.settings.more_links_url_2 != blank %}
        <p>{{ section.settings.more_links_title_2 }} <a href="{{ section.settings.more_links_url_2 }}">{{ section.settings.more_links_text_2 }}</a></p>
      {% endif %}
      
      {% if section.settings.more_links_title_3 != blank and section.settings.more_links_text_3 != blank and section.settings.more_links_url_3 != blank %}
        <p>{{ section.settings.more_links_title_3 }} <a href="{{ section.settings.more_links_url_3 }}">{{ section.settings.more_links_text_3 }}</a></p>
      {% endif %}
      
      {% if section.settings.more_links_title_4 != blank and section.settings.more_links_text_4 != blank and section.settings.more_links_url_4 != blank %}
        <p>{{ section.settings.more_links_title_4 }} <a href="{{ section.settings.more_links_url_4 }}">{{ section.settings.more_links_text_4 }}</a></p>
      {% endif %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // 尺码选择
    const sizeButtons = document.querySelectorAll('.size-button');
    const addToCartBtn = document.querySelector('.add-to-cart-btn');
    
    // 确保按钮可点击
    sizeButtons.forEach(button => {
      button.addEventListener('click', function() {
        sizeButtons.forEach(btn => btn.classList.remove('selected'));
        this.classList.add('selected');
        
        // 更新按钮状态
        addToCartBtn.disabled = false;
        addToCartBtn.textContent = 'ADD TO CART';
        addToCartBtn.style.background = '#000';
        addToCartBtn.style.cursor = 'pointer';
      });
    });

    // 详情折叠
    const detailHeaders = document.querySelectorAll('.detail-header');
    detailHeaders.forEach(header => {
      header.addEventListener('click', function() {
        const content = this.nextElementSibling;
        const toggle = this.querySelector('.detail-toggle');
        
        if (content.style.display === 'none') {
          content.style.display = 'block';
          toggle.textContent = '−';
        } else {
          content.style.display = 'none';
          toggle.textContent = '+';
        }
      });
    });

    // 添加到购物车
    addToCartBtn.addEventListener('click', function() {
      const selectedSize = document.querySelector('.size-button.selected');
      if (!selectedSize) {
        alert('Please select a size');
        return;
      }

      const variantId = selectedSize.dataset.variantId;
      
      // 调用Shopify Cart API添加商品
      fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          id: variantId,
          quantity: 1
        })
      })
      .then(response => response.json())
      .then(data => {
        // 添加成功提示
        addToCartBtn.textContent = 'ADDED!';
        addToCartBtn.style.background = '#00b300';
        
        setTimeout(() => {
          addToCartBtn.textContent = 'ADD TO CART';
          addToCartBtn.style.background = '#000';
        }, 2000);

        // 更新购物车数量
        updateCartCount();
      })
      .catch(error => {
        alert('Failed to add to cart. Please try again.');
      });
    });

    // 更新购物车数量
    function updateCartCount() {
      fetch('/cart.js')
        .then(response => response.json())
        .then(cart => {
          const cartCount = cart.item_count;
          // 更新页面上的购物车数量显示
          const cartCountElements = document.querySelectorAll('.cart-count');
          cartCountElements.forEach(element => {
            element.textContent = cartCount;
          });
        });
    }
  });
</script>
