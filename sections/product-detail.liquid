<!-- sections/product-detail.liquid -->
<div class="product-detail-section">
  <div class="product-container">
    <!-- 左侧图片展示区域 -->
    <div class="product-images">
      <div class="main-image">
        <img
          src="{{ product.featured_image | img_url: '800x800' }}"
          alt="{{ product.title }}"
          id="main-product-image"
          width="800"
          height="800"
        >
        <!-- 缩略图移到左下角 -->
        <div class="thumbnail-images">
          {% for image in product.images limit: 4 %}
            <div
              class="thumbnail {% if forloop.first %}active{% endif %}"
              data-image="{{ image | img_url: '800x800' }}"
              data-image-alt="{{ product.title }}"
            >
              <img
                src="{{ image | img_url: '100x100' }}"
                alt="{{ product.title }}"
                width="100"
                height="100"
              >
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <!-- 右侧商品详情区域 -->
    <div class="product-info" style="background-color: {{ section.settings.info_background_color }};">
      <div class="product-info-content">
        {% capture details %}
          {% content_for 'block',
            type: '_product-details',
            id: 'product-details',
            closest.product: product
          %}
        {% endcapture %}
        {{ details }}
      </div>
    </div>
  </div>
</div>

<style>
  .product-detail-section {
    padding: {{ section.settings.section_padding_top }}px 20px {{ section.settings.section_padding_bottom }}px 20px;
    width: 100%;
    margin: 0 auto;
    background: transparent;
    min-height: calc(100vh - 170px);
    display: flex;
    align-items: center;
  }

  .product-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ section.settings.content_gap }}px;
    align-items: start;
    width: 100%;
    max-height: calc(100vh - 180px - {{ section.settings.section_padding_top }}px - {{ section.settings.section_padding_bottom }}px);
  }

  /* 左侧图片区域 */
  .product-images {
    position: sticky;
    top: 20px;
    max-height: calc(100vh - 170px);
  }

  .main-image {
    width: 100%;
    height: calc(100vh - 170px);
    max-height: 700px;
    min-height: 400px;
    border-radius: {{ section.settings.image_border_radius }}px;
    overflow: hidden;
    background: #f8f8f8;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: opacity 0.3s ease;
  }

  /* 缩略图移到左下角 */
  .thumbnail-images {
    position: absolute;
    bottom: 20px;
    left: 20px;
    display: flex;
    gap: 8px;
    flex-direction: column;
    z-index: 10;
  }

  .thumbnail {
    width: 60px;
    height: 60px;
    border-radius: {{ section.settings.thumbnail_border_radius }}px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid rgba(255, 255, 255, 0.8);
    transition: all 0.3s ease;
    opacity: 0.7;
    background: white;
  }

  .thumbnail:hover {
    opacity: 1;
    border-color: {{ section.settings.accent_color }};
    transform: scale(1.05);
  }

  .thumbnail.active {
    border-color: {{ section.settings.accent_color }};
    opacity: 1;
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 移动端图片指示器 */
  .image-indicator {
    position: absolute;
    bottom: 10px;
    right: 15px;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 500;
    z-index: 20;
    backdrop-filter: blur(5px);
    display: none;
  }

  .image-indicator .current {
    font-weight: 700;
  }

  /* 右侧商品信息区域 */
  .product-info {
    height: calc(100vh - 170px);
    max-height: 700px;
    min-height: 400px;
    overflow-y: auto;
    padding: 40px;
    border-radius: {{ section.settings.info_border_radius }}px;
  }

  .product-info::-webkit-scrollbar {
    width: 6px;
  }

  .product-info::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 3px;
  }

  .product-info::-webkit-scrollbar-thumb {
    background: #c1c1c1;
    border-radius: 3px;
  }

  .product-title {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    color: {{ section.settings.title_color }};
    margin: 0 0 10px 0;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .product-subtitle {
    font-size: {{ section.settings.subtitle_font_size }}px;
    color: {{ section.settings.subtitle_color }};
    margin: 0 0 15px 0;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .product-rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 25px;
  }

  .stars {
    color: {{ section.settings.star_color }};
    font-size: 1.1rem;
  }

  .rating-count {
    color: {{ section.settings.text_color }};
    font-size: 0.9rem;
  }

  .product-description {
    color: {{ section.settings.text_color }};
    line-height: 1.6;
    margin-bottom: 30px;
    font-size: {{ section.settings.description_font_size }}px;
  }

  /* 价格显示控制 */
  .mobile-price {
    display: none;
  }

  .desktop-price {
    display: block;
  }

  /* 商品选项 */
  .product-option {
    margin-bottom: 25px;
  }

  .option-label {
    display: block;
    font-weight: 500;
    margin-bottom: 10px;
    color: {{ section.settings.label_color }};
    font-size: 0.9rem;
  }

  /* 颜色选择器 */
  .color-selector {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .color-selector input[type="radio"] {
    display: none;
  }

  .color-option {
    cursor: pointer;
    display: block;
    position: relative;
  }

  .color-circle {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 2px solid #e0e0e0;
    display: block;
    transition: all 0.3s ease;
    position: relative;
  }

  .color-circle::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .color-selector input[type="radio"]:checked + .color-option .color-circle {
    border-color: {{ section.settings.accent_color }};
    box-shadow: 0 0 0 2px rgba(0,0,0,0.1);
  }

  .color-selector input[type="radio"]:checked + .color-option .color-circle::after {
    opacity: 1;
    background: {{ section.settings.accent_color }};
  }

  /* 颜色定义 */
  .color-strawberry-glaze { background: #d63384; }
  .color-pink { background: #ff69b4; }
  .color-nude { background: #deb887; }
  .color-clear { background: #ffffff; border-color: #ccc; }
  .color-lavender { background: #e6e6fa; }

  /* 圆角按钮选择器 */
  .button-selector {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .button-selector input[type="radio"] {
    display: none;
  }

  .button-option {
    padding: 10px 20px;
    border: 2px solid #e0e0e0;
    border-radius: {{ section.settings.option_button_border_radius }}px;
    background: transparent;
    color: {{ section.settings.text_color }};
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.9rem;
    font-weight: 500;
    min-width: 60px;
    text-align: center;
    display: inline-block;
  }

  .button-option:hover {
    border-color: {{ section.settings.accent_color }};
    background: rgba({{ section.settings.accent_color | color_extract: 'red' }}, {{ section.settings.accent_color | color_extract: 'green' }}, {{ section.settings.accent_color | color_extract: 'blue' }}, 0.1);
  }

  .button-selector input[type="radio"]:checked + .button-option {
    border-color: {{ section.settings.accent_color }};
    background: {{ section.settings.accent_color }};
    color: white;
  }

  /* 数量选择器 */
  .quantity-selector {
    margin-bottom: 25px;
  }

  .quantity-label {
    display: block;
    font-weight: 500;
    margin-bottom: 10px;
    color: {{ section.settings.label_color }};
    font-size: 0.9rem;
  }

  .quantity-input {
    display: flex;
    align-items: center;
    width: fit-content;
    border: 1px solid #ddd;
    border-radius: 6px;
    overflow: hidden;
  }

  .quantity-btn {
    background: #f8f8f8;
    border: none;
    width: 40px;
    height: 40px;
    cursor: pointer;
    font-size: 1.2rem;
    transition: background-color 0.3s ease;
  }

  .quantity-btn:hover {
    background: #e8e8e8;
  }

  .quantity-field {
    border: none;
    width: 60px;
    height: 40px;
    text-align: center;
    font-size: 0.9rem;
    background: white;
  }

  /* 价格 */
  .product-price {
    margin-bottom: 30px;
  }

  .price {
    font-size: {{ section.settings.price_font_size }}px;
    font-weight: 600;
    color: {{ section.settings.price_color }};
  }

  .compare-price {
    font-size: {{ section.settings.compare_price_font_size }}px;
    color: #999;
    text-decoration: line-through;
    margin-left: 10px;
  }

  /* 立即购买按钮 */
  .buy-now-btn {
    width: 100%;
    padding: 16px 24px;
    border: 2px solid;
    border-radius: {{ section.settings.button_border_radius }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    background: transparent;
  }

  .buy-now-btn:hover {
    background: {{ section.settings.button_color }};
    color: white !important;
  }

  /* 移动端适配 */
  @media (max-width: 768px) {
    .product-detail-section {
      padding: 20px 15px;
      min-height: auto;
    }

    .product-container {
      grid-template-columns: 1fr;
      gap: 20px;
      max-height: none;
    }

    .product-images {
      position: static;
      order: 1;
      max-height: none;
    }

    .main-image {
      height: 350px;
      max-height: none;
      min-height: 300px;
      border-radius: 8px;
      touch-action: pan-y;
      user-select: none;
    }

    .main-image img {
      transition: opacity 0.3s ease;
    }

    /* 移动端显示图片指示器 */
    .image-indicator {
      display: block;
    }

    .product-info {
      height: auto;
      max-height: none;
      min-height: auto;
      overflow-y: visible;
      padding: 20px;
      order: 2;
    }

    .product-title {
      font-size: {{ section.settings.title_font_size | minus: 12 }}px;
      margin-bottom: 8px;
    }

    .product-subtitle {
      font-size: {{ section.settings.subtitle_font_size | minus: 1 }}px;
      margin-bottom: 12px;
    }

    .product-rating {
      margin-bottom: 15px;
    }

    .product-description {
      font-size: {{ section.settings.description_font_size | minus: 1 }}px;
      margin-bottom: 20px;
    }

    .product-option {
      margin-bottom: 20px;
    }

    .quantity-selector {
      margin-bottom: 20px;
    }

    /* 价格显示控制 - 移动端 */
    .mobile-price {
      display: block;
      margin-bottom: 20px;
      padding: 15px;
      background: rgba(248, 248, 248, 0.8);
      border-radius: 8px;
      text-align: center;
    }

    .desktop-price {
      display: none;
    }

    .mobile-price .price {
      font-size: {{ section.settings.price_font_size | plus: 4 }}px;
    }

    /* 移动端隐藏缩略图 */
    .thumbnail-images {
      display: none;
    }

    /* 颜色选择器适配 */
    .color-selector {
      gap: 10px;
      justify-content: center;
    }

    .color-circle {
      width: 35px;
      height: 35px;
    }

    .color-circle::after {
      width: 16px;
      height: 16px;
    }

    /* 按钮选择器适配 */
    .button-selector {
      gap: 8px;
    }

    .button-option {
      padding: 8px 16px;
      font-size: 0.85rem;
      min-width: 50px;
    }

    /* 按钮适配 */
    .buy-now-btn {
      padding: 18px 24px;
      font-size: {{ section.settings.button_font_size | plus: 2 }}px;
      font-weight: 600;
      position: sticky;
      bottom: 20px;
      z-index: 100;
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }

    /* 数量选择器适配 */
    .quantity-input {
      width: 100%;
      max-width: 150px;
      margin: 0 auto;
    }

    .quantity-btn {
      width: 45px;
      height: 45px;
      font-size: 1.4rem;
    }

    .quantity-field {
      width: 60px;
      height: 45px;
      font-size: 1rem;
    }
  }

  /* 超小屏幕适配 */
  @media (max-width: 480px) {
    .product-detail-section {
      padding: 15px 10px;
    }

    .main-image {
      height: 300px;
    }

    .product-title {
      font-size: {{ section.settings.title_font_size | minus: 16 }}px;
    }

    .thumbnail {
      width: 45px;
      height: 45px;
    }

    .color-circle {
      width: 32px;
      height: 32px;
    }

    .buy-now-btn {
      bottom: 10px;
      margin: 0 -10px;
      border-radius: 0;
    }
  }

  /* 横屏适配 */
  @media (max-width: 768px) and (orientation: landscape) {
    .main-image {
      height: 250px;
    }

    .buy-now-btn {
      position: static;
      margin-top: 20px;
    }
  }
</style>

<script>
    const productData = {{ product_resource | json }};
  
  document.addEventListener('DOMContentLoaded', function () {
    const mainImage = document.getElementById('main-product-image');
    const productImages = document.querySelector('.product-images');
    let touchStartX = 0;
    let touchEndX = 0;
    let currentImageIndex = 0;
    const thumbnails = document.querySelectorAll('.thumbnail');
    const images = Array.from(thumbnails).map((thumb) => ({
      src: thumb.dataset.image,
      alt: thumb.dataset.imageAlt,
    }));

    // 检测是否为移动设备
    function isMobileDevice() {
      return window.innerWidth <= 768 || 'ontouchstart' in window;
    }

     const variantInputs = document.querySelectorAll('variant-picker input[type="radio"], variant-picker select');
    
    variantInputs.forEach(input => {
      input.addEventListener('change', function() {
        const variantId = this.dataset.variantId || this.selectedOptions?.[0]?.dataset.variantId;
        
        if (variantId) {
          // 从产品数据中找到对应的变体
          const variant = productData.variants.find(v => v.id == variantId);
          
          if (variant && variant.featured_media) {
            // 切换到对应的图片
            switchToImage(variant.featured_media.id);
          }
        }
      });
    });
    
    function switchToImage(mediaId) {
      // 根据你的主题图片结构调整这个选择器
      const allImages = document.querySelectorAll('[data-media-id]');
      const targetImage = document.querySelector(`[data-media-id="${mediaId}"]`);
      
      if (targetImage) {
        // 移除所有激活状态
        allImages.forEach(img => img.classList.remove('is-active', 'active'));
        
        // 激活目标图片
        targetImage.classList.add('is-active');
        targetImage.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    // 切换图片函数
    function changeImage(index) {
      if (mainImage && images[index]) {
        // 添加淡出效果
        mainImage.style.opacity = '0.5';
        
        setTimeout(() => {
          mainImage.src = images[index].src;
          mainImage.alt = images[index].alt;
          mainImage.style.opacity = '1';
        }, 150);

        // 更新缩略图激活状态（桌面端）
        if (!isMobileDevice()) {
          thumbnails.forEach((t, i) => {
            t.classList.toggle('active', i === index);
          });
        }
      }
    }

    // 移动端滑动切换功能
    function setupMobileSwipe() {
      if (!productImages) return;

      productImages.addEventListener('touchstart', function (e) {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      productImages.addEventListener('touchend', function (e) {
        touchEndX = e.changedTouches[0].screenX;
        handleSwipe();
      }, { passive: true });

      function handleSwipe() {
        const swipeDistance = touchStartX - touchEndX;
        const minSwipeDistance = 50; // 最小滑动距离（像素）

        // 向左滑动 - 下一张
        if (swipeDistance > minSwipeDistance && currentImageIndex < images.length - 1) {
          currentImageIndex++;
          changeImage(currentImageIndex);
          updateIndicator();
        } 
        // 向右滑动 - 上一张
        else if (swipeDistance < -minSwipeDistance && currentImageIndex > 0) {
          currentImageIndex--;
          changeImage(currentImageIndex);
          updateIndicator();
        }
      }
    }

    // 桌面端悬停切换功能
    function setupDesktopHover() {
      thumbnails.forEach((thumbnail, index) => {
        thumbnail.addEventListener('mouseenter', function () {
          currentImageIndex = index;
          changeImage(index);
        });
      });
    }

    // 添加图片指示器（移动端）
    function addImageIndicator() {
      if (images.length <= 1) return;

      const indicator = document.createElement('div');
      indicator.className = 'image-indicator';
      indicator.innerHTML = `<span class="current">${currentImageIndex + 1}</span> / ${images.length}`;
      
      const mainImageContainer = document.querySelector('.main-image');
      if (mainImageContainer) {
        mainImageContainer.appendChild(indicator);
      }
    }

    // 更新指示器
    function updateIndicator() {
      const currentSpan = document.querySelector('.image-indicator .current');
      if (currentSpan) {
        currentSpan.textContent = currentImageIndex + 1;
      }
    }

    // 初始化
    if (isMobileDevice()) {
      setupMobileSwipe();
      addImageIndicator();
    } else {
      setupDesktopHover();
    }

    // 数量选择器功能
    const minusBtn = document.querySelector('.quantity-btn.minus');
    const plusBtn = document.querySelector('.quantity-btn.plus');
    const quantityField = document.querySelector('.quantity-field');

    if (minusBtn && plusBtn && quantityField) {
      minusBtn.addEventListener('click', function () {
        const currentValue = parseInt(quantityField.value);
        if (currentValue > 1) {
          quantityField.value = currentValue - 1;
        }
      });

      plusBtn.addEventListener('click', function () {
        const currentValue = parseInt(quantityField.value);
        quantityField.value = currentValue + 1;
      });
    }

    // 立即购买功能
    const buyNowBtn = document.querySelector('.buy-now-btn');
    if (buyNowBtn) {
      buyNowBtn.addEventListener('click', function (e) {
        e.preventDefault();

        const form = document.getElementById('product-form');
        if (!form) {
          console.error('找不到产品表单');
          return;
        }

        const formData = new FormData(form);
        const originalText = this.textContent;

        // 添加加载状态
        this.textContent = '处理中...';
        this.disabled = true;

        // 先添加到购物车
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            id: formData.get('id'),
            quantity: parseInt(formData.get('quantity')) || 1,
          }),
        })
          .then((response) => {
            if (response.ok) {
              return response.json();
            }
            throw new Error('添加到购物车失败');
          })
          .then((data) => {
            // 成功添加后跳转到结账页面
            window.location.href = '/checkout';
          })
          .catch((error) => {
            console.error('Error:', error);
            alert('添加到购物车时出现错误,请重试');
            // 恢复按钮状态
            this.textContent = originalText;
            this.disabled = false;
          });
      });
    }

    // 监听窗口大小变化
    let resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        const wasMobile = document.querySelector('.image-indicator') !== null;
        const isMobileNow = isMobileDevice();
        
        // 如果设备类型改变，重新加载页面
        if (wasMobile !== isMobileNow) {
          location.reload();
        }
      }, 250);
    });
  });
</script>

{% schema %}
{
  "name": "商品详情页",
  "tag": "section",
  "class": "product-detail-section",
  "settings": [
    {
      "type": "header",
      "content": "布局设置"
    },
    {
      "type": "range",
      "id": "content_gap",
      "min": 30,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "左右内容间距",
      "default": 60
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "顶部内边距",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "底部内边距",
      "default": 40
    },
    {
      "type": "header",
      "content": "颜色设置"
    },
    {
      "type": "color",
      "id": "info_background_color",
      "label": "右侧内容区域背景颜色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "强调色",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "标题颜色",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "副标题颜色",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "text_color",
