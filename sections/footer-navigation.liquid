{% comment %}
  Footer Navigation Section - 页脚导航模块
  包含联系卡片、品牌信息、导航链接和法律链接
{% endcomment %}

<!-- 联系卡片区域 -->
<section class="contact-cards-section">
  <div class="contact-cards-container">
    <!-- 预约通话卡片 -->
    <div class="contact-card">
      <h3 class="contact-card-title">
        {% if section.settings.schedule_title != blank %}
          {{ section.settings.schedule_title }}
        {% else %}
          Schedule a Call
        {% endif %}
      </h3>
      <p class="contact-card-description">
        {% if section.settings.schedule_description != blank %}
          {{ section.settings.schedule_description }}
        {% else %}
          Choose a time that works for you - we'll connect you with a specialist.
        {% endif %}
      </p>
      <a href="{{ section.settings.schedule_url | default: '#' }}" class="contact-card-button">
        <div class="contact-card-button-icon">
          {% if section.settings.schedule_button_icon %}
            <img src="{{ section.settings.schedule_button_icon | img_url: '24x16' }}" alt="电话图标" class="contact-card-button-icon-default">
          {% else %}
            <svg class="contact-card-button-icon-default" width="12" height="8" viewBox="0 0 12 8" fill="none">
              <path d="M1 1.5L6 6L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {% endif %}
          
          {% if section.settings.schedule_button_icon_hover %}
            <img src="{{ section.settings.schedule_button_icon_hover | img_url: '24x16' }}" alt="电话图标悬停" class="contact-card-button-icon-hover">
          {% else %}
            <svg class="contact-card-button-icon-hover" width="12" height="8" viewBox="0 0 12 8" fill="none">
              <path d="M1 1.5L6 6L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {% endif %}
        </div>
        <span>
          {% if section.settings.schedule_button_text != blank %}
            {{ section.settings.schedule_button_text }}
          {% else %}
            CALL NOW
          {% endif %}
        </span>
      </a>
    </div>

    <!-- WhatsApp卡片 -->
    <div class="contact-card">
      <h3 class="contact-card-title">
        {% if section.settings.whatsapp_title != blank %}
          {{ section.settings.whatsapp_title }}
        {% else %}
          WhatsApp Us
        {% endif %}
      </h3>
      <p class="contact-card-description">
        {% if section.settings.whatsapp_description != blank %}
          {{ section.settings.whatsapp_description }}
        {% else %}
          Message us on WhatsApp for questions and quotes.We typically reply within 1 business day.
        {% endif %}
      </p>
      <a href="{{ section.settings.whatsapp_url | default: '#' }}" class="contact-card-button">
        <div class="contact-card-button-icon">
          {% if section.settings.whatsapp_button_icon %}
            <img src="{{ section.settings.whatsapp_button_icon | img_url: '24x16' }}" alt="WhatsApp图标" class="contact-card-button-icon-default">
          {% else %}
            <svg class="contact-card-button-icon-default" width="12" height="8" viewBox="0 0 12 8" fill="none">
              <path d="M1 1.5L6 6L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {% endif %}
          
          {% if section.settings.whatsapp_button_icon_hover %}
            <img src="{{ section.settings.whatsapp_button_icon_hover | img_url: '24x16' }}" alt="WhatsApp图标悬停" class="contact-card-button-icon-hover">
          {% else %}
            <svg class="contact-card-button-icon-hover" width="12" height="8" viewBox="0 0 12 8" fill="none">
              <path d="M1 1.5L6 6L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {% endif %}
        </div>
        <span>
          {% if section.settings.whatsapp_button_text != blank %}
            {{ section.settings.whatsapp_button_text }}
          {% else %}
            START CHAT
          {% endif %}
        </span>
      </a>
    </div>

    <!-- 邮件支持卡片 -->
    <div class="contact-card">
      <h3 class="contact-card-title">
        {% if section.settings.email_title != blank %}
          {{ section.settings.email_title }}
        {% else %}
          Email Support
        {% endif %}
      </h3>
      <p class="contact-card-description">
        {% if section.settings.email_description != blank %}
          {{ section.settings.email_description }}
        {% else %}
          Send us detailed questions and receive comprehensive answers
        {% endif %}
      </p>
      <a href="{{ section.settings.email_url | default: '#' }}" class="contact-card-button">
        <div class="contact-card-button-icon">
          {% if section.settings.email_button_icon %}
            <img src="{{ section.settings.email_button_icon | img_url: '24x16' }}" alt="邮件图标" class="contact-card-button-icon-default">
          {% else %}
            <svg class="contact-card-button-icon-default" width="12" height="8" viewBox="0 0 12 8" fill="none">
              <path d="M1 1.5L6 6L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {% endif %}
          
          {% if section.settings.email_button_icon_hover %}
            <img src="{{ section.settings.email_button_icon_hover | img_url: '24x16' }}" alt="邮件图标悬停" class="contact-card-button-icon-hover">
          {% else %}
            <svg class="contact-card-button-icon-hover" width="12" height="8" viewBox="0 0 12 8" fill="none">
              <path d="M1 1.5L6 6L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {% endif %}
        </div>
        <span>
          {% if section.settings.email_button_text != blank %}
            {{ section.settings.email_button_text }}
          {% else %}
            SEND EMAIL
          {% endif %}
        </span>
      </a>
    </div>
  </div>
</section>

<!-- 页脚导航区域 -->
<footer class="footer-navigation">
  <div class="footer-container">
    <!-- 品牌区域 -->
    <div class="footer-brand">
      {% if section.settings.logo %}
        <img src="{{ section.settings.logo | img_url: '350x113' }}" alt="{{ section.settings.brand_text | default: 'XSPilates' }}" class="footer-logo">
      {% else %}
        <div class="footer-brand-text">{{ section.settings.brand_text | default: 'XSPilates' }}</div>
      {% endif %}

      <!-- 社交媒体链接 -->
      <div class="social-links">
        {% if section.settings.linkedin_url != blank %}
          <a href="{{ section.settings.linkedin_url }}" class="social-link" target="_blank" rel="noopener">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" class="social-link" target="_blank" rel="noopener">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.facebook_url != blank %}
          <a href="{{ section.settings.facebook_url }}" class="social-link" target="_blank" rel="noopener">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        {% endif %}

        {% if section.settings.youtube_url != blank %}
          <a href="{{ section.settings.youtube_url }}" class="social-link" target="_blank" rel="noopener">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
          </a>
        {% endif %}
      </div>

      <!-- Logo底部图标 -->
      {% if section.settings.icon_1_image or section.settings.icon_2_image or section.settings.icon_3_image or section.settings.icon_4_image %}
        <div class="footer-icons">
          {% if section.settings.icon_1_image %}
            <a href="{{ section.settings.icon_1_url | default: '#' }}" class="footer-icon-link">
              <img src="{{ section.settings.icon_1_image | img_url: '40x40' }}" alt="图标1" class="footer-icon">
            </a>
          {% endif %}
          {% if section.settings.icon_2_image %}
            <a href="{{ section.settings.icon_2_url | default: '#' }}" class="footer-icon-link">
              <img src="{{ section.settings.icon_2_image | img_url: '40x40' }}" alt="图标2" class="footer-icon">
            </a>
          {% endif %}
          {% if section.settings.icon_3_image %}
            <a href="{{ section.settings.icon_3_url | default: '#' }}" class="footer-icon-link">
              <img src="{{ section.settings.icon_3_image | img_url: '40x40' }}" alt="图标3" class="footer-icon">
            </a>
          {% endif %}
          {% if section.settings.icon_4_image %}
            <a href="{{ section.settings.icon_4_url | default: '#' }}" class="footer-icon-link">
              <img src="{{ section.settings.icon_4_image | img_url: '40x40' }}" alt="图标4" class="footer-icon">
            </a>
          {% endif %}
        </div>
      {% endif %}

      <!-- 邮件订阅 -->
      {% if section.settings.show_newsletter %}
        <div class="newsletter-subscription">
          <form class="newsletter-form" action="#" method="post">
            <input 
              type="email" 
              class="newsletter-input" 
              placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your business email' }}" 
              required>
            <button type="submit" class="newsletter-button">
              {{ section.settings.newsletter_button_text | default: 'CONNECT WITH US' }}
            </button>
          </form>
        </div>
      {% endif %}
    </div>

    <!-- 导航栏目 -->
    <div class="footer-nav-columns">
      <!-- 产品栏目 -->
      <div class="footer-column">
        <h4 class="footer-column-title">{{ section.settings.products_title | default: 'PRODUCTS' }}</h4>
        <ul class="footer-nav-list">
          {% for block in section.blocks %}
            {% if block.type == 'product_link' %}
              <li class="footer-nav-item">
                <a href="{{ block.settings.link | default: '#' }}" class="footer-nav-link">
                  {{ block.settings.text }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <!-- 服务栏目 -->
      <div class="footer-column">
        <h4 class="footer-column-title">{{ section.settings.service_title | default: 'OEM SERVICE PROCESS' }}</h4>
        <ul class="footer-nav-list">
          {% for block in section.blocks %}
            {% if block.type == 'service_link' %}
              <li class="footer-nav-item">
                {% if block.settings.text == 'Resources' %}
                  <a href="{{ block.settings.link | default: '#' }}" class="footer-nav-link footer-nav-link-resources">
                    {{ block.settings.text }}
                  </a>
                {% else %}
                  <a href="{{ block.settings.link | default: '#' }}" class="footer-nav-link">
                    {{ block.settings.text }}
                  </a>
                {% endif %}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <!-- 公司栏目 -->
      <div class="footer-column">
        <h4 class="footer-column-title">{{ section.settings.company_title | default: 'COMPANY' }}</h4>
        <ul class="footer-nav-list">
          {% for block in section.blocks %}
            {% if block.type == 'company_link' %}
              <li class="footer-nav-item">
                <a href="{{ block.settings.link | default: '#' }}" class="footer-nav-link">
                  {{ block.settings.text }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
    </div>
  </div>
</footer>

<!-- 法律链接区域 -->
<div class="footer-legal">
  <div class="footer-legal-container">
    <div class="legal-links">
      {% if section.settings.privacy_policy_url != blank %}
        <a href="{{ section.settings.privacy_policy_url }}" class="legal-link">
          {{ section.settings.privacy_policy_text | default: 'Privacy Policy' }}
        </a>
      {% endif %}
      
      {% if section.settings.cookie_policy_url != blank %}
        <a href="{{ section.settings.cookie_policy_url }}" class="legal-link">
          {{ section.settings.cookie_policy_text | default: 'Cookie Policy' }}
        </a>
      {% endif %}
      
      {% if section.settings.terms_conditions_url != blank %}
        <a href="{{ section.settings.terms_conditions_url }}" class="legal-link">
          {{ section.settings.terms_conditions_text | default: 'Terms and Conditions' }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

<style>
/* 联系卡片样式 */
.contact-cards-section {
  background-color: #2b2b2b;
  padding: 60px 0;
}

.contact-cards-container {
  max-width: 1520px;
  margin: 0 auto;
  padding: 0 20px;
  display: flex;
  gap: 26px;
  justify-content: center;
  align-items: stretch;
}

.contact-card {
  background-color: #ffffff;
  border-radius: 8px;
  padding: 38px 22px 22px 22px;
  width: 460px;
  min-height: 280px;
  height: auto;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  flex: 0 0 auto;
}

.contact-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15);
}

.contact-card-title {
  font-size: 36px;
  font-weight: 600;
  color: #161616;
  margin: 0 0 16px 0;
  line-height: 1.2;
}

.contact-card-description {
  font-size: 18px;
  color: #666666;
  line-height: 1.5;
  margin: 0 0 20px 0;
  flex-grow: 1;
}

.contact-card-button {
  background-color: #C22E35;
  color: white;
  border: none;
  border-radius: 4px;
  padding: 12px 24px;
  font-size: 18px;
  font-weight: 600;
  text-decoration: none;
  display: flex;
  align-items: center;
  gap: 12px;
  transition: all 0.3s ease;
  cursor: pointer;
  align-self: flex-start;
  position: relative;
  overflow: hidden;
}

.contact-card-button:hover {
  background-color: #A02329;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(194, 46, 53, 0.3);
}

.contact-card-button-icon {
  width: 12px;
  height: 8px;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
  transition: opacity 0.3s ease;
}

.contact-card-button {
  position: relative;
}

.contact-card-button-icon-hover {
  opacity: 0;
  position: absolute;
  top: 50%;
  left: 12px;
  transform: translateY(-50%);
  width: 12px;
  height: 8px;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.contact-card-button:hover .contact-card-button-icon-default {
  opacity: 0;
}

.contact-card-button:hover .contact-card-button-icon-hover {
  opacity: 1;
}

/* 页脚导航样式 */
.footer-navigation {
  background-color: #2b2b2b;
  padding: 60px 0 40px;
}

.footer-container {
  max-width: 1520px;
  margin: 0 auto;
  padding: 0 20px;
  display: flex;
  gap: 80px;
  justify-content: center;
  align-items: flex-start;
}

.footer-brand {
  display: flex;
  flex-direction: column;
  gap: 30px;
  min-width: 300px;
}

.footer-logo {
  max-width: 315px;
  width: 315px;
  height: 102px;
  object-fit: contain;
}

.footer-brand-text {
  font-size: 32px;
  font-weight: 700;
  color: #ffffff;
  margin: 0;
}

.social-links {
  display: flex;
  gap: 16px;
}

.social-link {
  width: 40px;
  height: 40px;
  background-color: #404040;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  text-decoration: none;
  transition: all 0.3s ease;
}

.social-link:hover {
  background-color: #C22E35;
  transform: translateY(-2px);
}

.social-link svg {
  width: 20px;
  height: 20px;
}

.footer-icons {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.footer-icon-link {
  display: block;
  transition: transform 0.3s ease;
}

.footer-icon-link:hover {
  transform: scale(1.1);
}

.footer-icon {
  width: 40px;
  height: 40px;
  object-fit: contain;
}

.newsletter-subscription {
  width: 380px;
  max-width: 380px;
}

.newsletter-form {
  position: relative;
  width: 380px;
  height: 60px;
  background-color: #ffffff;
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  align-items: center;
}

.newsletter-input {
  flex: 1;
  border: none;
  outline: none;
  background: transparent;
  padding: 0 12px;
  font-size: 14px;
  color: #333333;
}

.newsletter-input::placeholder {
  color: #999999;
  font-size: 14px;
}

.newsletter-button {
  background-color: #C22E35;
  color: white;
  border: none;
  border-radius: 8px;
  width: 168px;
  height: 48px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  margin: 4px;
  position: relative;
  overflow: hidden;
}

.newsletter-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
  transition: left 0.7s ease;
}

.newsletter-button:hover::before {
  left: 0;
}

.newsletter-button:hover {
  color: white;
}

.newsletter-button:hover::before {
  left: 0;
}

.footer-nav-columns {
  margin-top: 24px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 60px;
  align-items: start;
  justify-content: center;
}

.footer-column {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.footer-column-title {
  font-size: 18px;
  font-weight: 600;
  margin: 0 0 25px 0;
  color: #ffffff;
  text-transform: uppercase;
}

.footer-nav-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.footer-nav-item {
  margin: 0;
}

.footer-nav-link {
  color: #cccccc;
  text-decoration: none;
  font-size: 16px;
  line-height: 1.5;
  transition: color 0.3s ease;
}

.footer-nav-link:hover {
  color: #ffffff;
}

/* Resources链接特殊样式 */
.footer-nav-link-resources {
  color: #ffffff !important;
  font-weight: 600 !important;
}

.footer-nav-link-resources:hover {
  color: #C22E35 !important;
}

/* 法律链接区域样式 */
.footer-legal {
  background-color: #1b1b1b;
  padding: 20px 0;
}

.footer-legal-container {
  max-width: 1520px;
  margin: 0 auto;
  padding: 0 20px;
}

.legal-links {
  display: flex;
  gap: 30px;
  justify-content: center;
  align-items: center;
}

.legal-link {
  color: #cccccc;
  text-decoration: none;
  font-size: 14px;
  transition: color 0.3s ease;
  position: relative;
}

.legal-link:hover {
  color: #ffffff;
}

.legal-link:not(:last-child)::after {
