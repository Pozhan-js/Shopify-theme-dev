<style>
  .footer-navigation {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 60px 0;
    position: relative;
    overflow: hidden;
  }

  .footer-navigation::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grid" width="10" height="10" patternUnits="userSpaceOnUse"><path d="M 10 0 L 0 0 0 10" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="0.5"/></pattern></defs><rect width="100" height="100" fill="url(%23grid)"/></svg>');
    opacity: 0.3;
  }

  .footer-navigation-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 1;
  }

  .footer-navigation-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .footer-navigation-title {
    font-size: 2.5rem;
    font-weight: 700;
    color: white;
    margin-bottom: 15px;
    text-shadow: 0 2px 4px rgba(0,0,0,0.3);
  }

  .footer-navigation-subtitle {
    font-size: 1.2rem;
    color: rgba(255,255,255,0.9);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .contact-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
    margin-bottom: 50px;
  }

  .contact-card {
    background: rgba(255,255,255,0.95);
    border-radius: 20px;
    padding: 35px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.2);
  }

  .contact-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }

  .contact-card-title {
    font-size: 1.5rem;
    font-weight: 600;
    color: #333;
    margin-bottom: 15px;
  }

  .contact-card-description {
    color: #666;
    line-height: 1.6;
    margin-bottom: 25px;
    font-size: 0.95rem;
  }

  .contact-card-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 12px 24px;
    border-radius: 25px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
  }

  .contact-card-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(102, 126, 234, 0.6);
    text-decoration: none;
    color: white;
  }

  .contact-card-button-icon-wrapper {
    position: relative;
    width: 12px;
    height: 8px;
    flex-shrink: 0;
    z-index: 2;
  }

  .contact-card-button-icon {
    width: 12px;
    height: 8px;
    flex-shrink: 0;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.3s ease;
  }

  .contact-card-button-icon-default {
    opacity: 1;
  }

  .contact-card-button-icon-hover {
    opacity: 0;
  }

  .contact-card-button:hover .contact-card-button-icon-default {
    opacity: 0;
  }

  .contact-card-button:hover .contact-card-button-icon-hover {
    opacity: 1;
  }

  .footer-bottom {
    text-align: center;
    padding-top: 30px;
    border-top: 1px solid rgba(255,255,255,0.2);
  }

  .footer-bottom-text {
    color: rgba(255,255,255,0.8);
    font-size: 0.9rem;
  }

  @media (max-width: 768px) {
    .footer-navigation {
      padding: 40px 0;
    }
    
    .footer-navigation-title {
      font-size: 2rem;
    }
    
    .contact-cards-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    
    .contact-card {
      padding: 25px;
    }
  }
</style>

<div class="footer-navigation">
  <div class="footer-navigation-container">
    <div class="footer-navigation-header">
      <h2 class="footer-navigation-title">
        {{ section.settings.title | default: "Ready to Get Started?" }}
      </h2>
      <p class="footer-navigation-subtitle">
        {{ section.settings.subtitle | default: "Choose the best way to connect with our team and get the support you need." }}
      </p>
    </div>

    <div class="contact-cards-grid">
      <!-- Schedule a Call Card -->
      <div class="contact-card">
        <h3 class="contact-card-title">
          {{ section.settings.scheduletitle | default: "Schedule a Call" }}
        </h3>
        <p class="contact-card-description">
          {{ section.settings.scheduledescription | default: "Choose a time that works for you - we'll connect you with a specialist." }}
        </p>
        {% if section.settings.schedulebuttontext != blank %}
          <a href="{{ section.settings.scheduleurl | default: '#' }}" class="contact-card-button">
            <span class="contact-card-button-icon-wrapper">
              {% if section.settings.schedulebuttonicon != blank %}
                <img src="{{ section.settings.schedulebuttonicon | imgurl: '12x8' }}" alt="Schedule Icon" class="contact-card-button-icon contact-card-button-icon-default">
                {% if section.settings.schedulebuttoniconhover != blank %}
                  <img src="{{ section.settings.schedulebuttoniconhover | imgurl: '12x8' }}" alt="Schedule Icon Hover" class="contact-card-button-icon contact-card-button-icon-hover">
                {% endif %}
              {% else %}
                <svg class="contact-card-button-icon contact-card-button-icon-default" width="12" height="8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <svg class="contact-card-button-icon contact-card-button-icon-hover" width="12" height="8" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              {% endif %}
            </span>
            {{ section.settings.schedulebuttontext | default: "CALL NOW" }}
          </a>
        {% endif %}
      </div>

      <!-- WhatsApp Card -->
      <div class="contact-card">
        <h3 class="contact-card-title">
          {{ section.settings.whatsapptitle | default: "WhatsApp Us" }}
        </h3>
        <p class="contact-card-description">
          {{ section.settings.whatsappdescription | default: "Message us on WhatsApp for questions and quotes.We typically reply within 1 business day." }}
        </p>
        {% if section.settings.whatsappbuttontext != blank %}
          <a href="{{ section.settings.whatsappurl | default: '#' }}" class="contact-card-button">
            <span class="contact-card-button-icon-wrapper">
              {% if section.settings.whatsappbuttonicon != blank %}
                <img src="{{ section.settings.whatsappbuttonicon | imgurl: '12x8' }}" alt="WhatsApp Icon" class="contact-card-button-icon contact-card-button-icon-default">
                {% if section.settings.whatsappbuttoniconhover != blank %}
                  <img src="{{ section.settings.whatsappbuttoniconhover | imgurl: '12x8' }}" alt="WhatsApp Icon Hover" class="contact-card-button-icon contact-card-button-icon-hover">
                {% endif %}
              {% else %}
                <svg class="contact-card-button-icon contact-card-button-icon-default" width="12" height="8" viewBox="0 0 24 24" fill="none">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.465 3.488" stroke="currentColor" stroke-width="1"/>
                </svg>
                <svg class="contact-card-button-icon contact-card-button-icon-hover" width="12" height="8" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.465 3.488"/>
                </svg>
              {% endif %}
            </span>
            {{ section.settings.whatsappbuttontext | default: "START CHAT" }}
          </a>
        {% endif %}
      </div>

      <!-- Email Support Card -->
      <div class="contact-card">
        <h3 class="contact-card-title">
          {{ section.settings.emailtitle | default: "Email Support" }}
        </h3>
        <p class="contact-card-description">
          {{ section.settings.emaildescription | default: "Send us detailed questions and receive comprehensive answers" }}
        </p>
        {% if section.settings.emailbuttontext != blank %}
          <a href="{{ section.settings.emailurl | default: '#' }}" class="contact-card-button">
            <span class="contact-card-button-icon-wrapper">
              {% if section.settings.emailbuttonicon != blank %}
                <img src="{{ section.settings.emailbuttonicon | imgurl: '12x8' }}" alt="Email Icon" class="contact-card-button-icon contact-card-button-icon-default">
                {% if section.settings.emailbuttoniconhover != blank %}
                  <img src="{{ section.settings.emailbuttoniconhover | imgurl: '12x8' }}" alt="Email Icon Hover" class="contact-card-button-icon contact-card-button-icon-hover">
                {% endif %}
              {% else %}
                <svg class="contact-card-button-icon contact-card-button-icon-default" width="12" height="8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="2"/>
                  <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="2"/>
                </svg>
                <svg class="contact-card-button-icon contact-card-button-icon-hover" width="12" height="8" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6" fill="none" stroke="white" stroke-width="2"/>
                </svg>
              {% endif %}
            </span>
            {{ section.settings.emailbuttontext | default: "SEND EMAIL" }}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-bottom-text">
        {{ section.settings.footertext | default: "We're here to help you succeed. Choose your preferred contact method above." }}
      </p>
    </div>
  </div>
</div>

