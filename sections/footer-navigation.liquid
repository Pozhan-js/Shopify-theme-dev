              <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>{{ section.settings.feature_3 | default: "24/7 Support" }}</span>
          </div>
        </div>
        {% endif %}
      </div>
      
