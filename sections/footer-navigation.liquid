<style>
/* 联系卡片样式 */
.contact-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 20px;
  padding: 30px;
  text-align: center;
  color: white;
  box-shadow: 0 20px 40px rgba(102, 126, 234, 0.3);
  position: relative;
  overflow: hidden;
  margin-bottom: 40px;
}

.contact-card::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
  animation: shimmer 3s ease-in-out infinite;
}

@keyframes shimmer {
  0%, 100% { transform: rotate(0deg); }
  50% { transform: rotate(180deg); }
}

.contact-card-title {
  font-size: 28px;
  font-weight: 700;
  margin-bottom: 15px;
  position: relative;
  z-index: 1;
}

.contact-card-subtitle {
  font-size: 16px;
  opacity: 0.9;
  margin-bottom: 30px;
  position: relative;
  z-index: 1;
}

.contact-card-buttons {
  display: flex;
  flex-direction: column;
  gap: 15px;
  position: relative;
  z-index: 1;
}

.contact-card-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 15px 25px;
  background: rgba(255, 255, 255, 0.2);
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-radius: 50px;
  color: white;
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
  transition: all 0.3s ease;
  backdrop-filter: blur(10px);
  position: relative;
  overflow: hidden;
}

.contact-card-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 0.5s ease;
}

.contact-card-button:hover::before {
  left: 100%;
}

.contact-card-button:hover {
  background: rgba(255, 255, 255, 0.3);
  border-color: rgba(255, 255, 255, 0.5);
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
}

.contact-card-button-icon-wrapper {
  width: 12px;
  height: 8px;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
}

.contact-card-button-icon {
  width: 12px;
  height: 8px;
  flex-shrink: 0;
  position: relative;
  z-index: 2;
  transition: opacity 0.3s ease;
}

.contact-card-button-icon-default {
  opacity: 1;
}

.contact-card-button-icon-hover {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
}

.contact-card-button:hover .contact-card-button-icon-default {
  opacity: 0;
}

.contact-card-button:hover .contact-card-button-icon-hover {
  opacity: 1;
}

/* 响应式设计 */
@media (min-width: 768px) {
  .contact-card-buttons {
    flex-direction: row;
    justify-content: center;
  }
  
  .contact-card-button {
    flex: 1;
    max-width: 200px;
  }
}

@media (max-width: 480px) {
  .contact-card {
    padding: 20px;
    margin-bottom: 30px;
  }
  
  .contact-card-title {
    font-size: 24px;
  }
  
  .contact-card-button {
    padding: 12px 20px;
    font-size: 13px;
  }
}

/* 页脚导航样式 */
.footer-navigation {
  background: #1a1a1a;
  padding: 60px 0 30px;
  color: #ffffff;
}

.footer-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.footer-content {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 40px;
  margin-bottom: 40px;
}

.footer-section h3 {
  color: #ffffff;
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 20px;
  position: relative;
}

.footer-section h3::after {
  content: '';
  position: absolute;
  bottom: -8px;
  left: 0;
  width: 30px;
  height: 2px;
  background: linear-gradient(90deg, #667eea, #764ba2);
}

.footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-links li {
  margin-bottom: 12px;
}

.footer-links a {
  color: #cccccc;
  text-decoration: none;
  font-size: 14px;
  transition: color 0.3s ease;
  display: flex;
  align-items: center;
  gap: 8px;
}

.footer-links a:hover {
  color: #667eea;
}

.footer-bottom {
  border-top: 1px solid #333333;
  padding-top: 30px;
  text-align: center;
}

.footer-bottom p {
  color: #888888;
  font-size: 14px;
  margin: 0;
}

@media (max-width: 768px) {
  .footer-content {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  
  .footer-navigation {
    padding: 40px 0 20px;
  }
}
</style>

<div class="footer-navigation">
  <div class="footer-container">
    <!-- 联系卡片 -->
    {% if section.settings.show_contact_card %}
    <div class="contact-card">
      <h2 class="contact-card-title">{{ section.settings.contact_card_title | default: "需要帮助？" }}</h2>
      <p class="contact-card-subtitle">{{ section.settings.contact_card_subtitle | default: "我们的专业团队随时为您服务" }}</p>
      
      <div class="contact-card-buttons">
        <!-- 预约通话按钮 -->
        {% if section.settings.schedulebuttontext != blank %}
          <a href="{{ section.settings.scheduleurl | default: '#' }}" class="contact-card-button">
            {% if section.settings.schedulebuttonicon != blank %}
              <div class="contact-card-button-icon-wrapper">
                <img src="{{ section.settings.schedulebuttonicon | imgurl: '12x8' }}" alt="Schedule Icon" class="contact-card-button-icon contact-card-button-icon-default">
                {% if section.settings.schedulebuttoniconhover != blank %}
                  <img src="{{ section.settings.schedulebuttoniconhover | imgurl: '12x8' }}" alt="Schedule Icon Hover" class="contact-card-button-icon contact-card-button-icon-hover">
                {% endif %}
              </div>
            {% else %}
              <svg class="contact-card-button-icon" width="12" height="8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {% endif %}
            {{ section.settings.schedulebuttontext | default: "CALL NOW" }}
          </a>
        {% endif %}

        <!-- WhatsApp按钮 -->
        {% if section.settings.whatsappbuttontext != blank %}
          <a href="{{ section.settings.whatsappurl | default: '#' }}" class="contact-card-button">
            {% if section.settings.whatsappbuttonicon != blank %}
              <div class="contact-card-button-icon-wrapper">
                <img src="{{ section.settings.whatsappbuttonicon | imgurl: '12x8' }}" alt="WhatsApp Icon" class="contact-card-button-icon contact-card-button-icon-default">
                {% if section.settings.whatsappbuttoniconhover != blank %}
                  <img src="{{ section.settings.whatsappbuttoniconhover | imgurl: '12x8' }}" alt="WhatsApp Icon Hover" class="contact-card-button-icon contact-card-button-icon-hover">
                {% endif %}
              </div>
            {% else %}
              <svg class="contact-card-button-icon" width="12" height="8" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.465 3.488"/>
              </svg>
            {% endif %}
            {{ section.settings.whatsappbuttontext | default: "START CHAT" }}
          </a>
        {% endif %}

        <!-- 邮件按钮 -->
        {% if section.settings.emailbuttontext != blank %}
          <a href="{{ section.settings.emailurl | default: '#' }}" class="contact-card-button">
            {% if section.settings.emailbuttonicon != blank %}
              <div class="contact-card-button-icon-wrapper">
                <img src="{{ section.settings.emailbuttonicon | imgurl: '12x8' }}" alt="Email Icon" class="contact-card-button-icon contact-card-button-icon-default">
                {% if section.settings.emailbuttoniconhover != blank %}
                  <img src="{{ section.settings.emailbuttoniconhover | imgurl: '12x8' }}" alt="Email Icon Hover" class="contact-card-button-icon contact-card-button-icon-hover">
                {% endif %}
              </div>
            {% else %}
              <svg class="contact-card-button-icon" width="12" height="8" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="currentColor" stroke-width="2"/>
                <polyline points="22,6 12,13 2,6" stroke="currentColor" stroke-width="2"/>
              </svg>
            {% endif %}
            {{ section.settings.emailbuttontext | default: "SEND EMAIL" }}
          </a>
        {% endif %}
      </div>
    </div>
    {% endif %}

    <!-- 页脚内容 -->
    <div class="footer-content">
      <!-- 公司信息 -->
      {% if section.settings.show_company_info %}
      <div class="footer-section">
        <h3>{{ section.settings.company_title | default: "公司信息" }}</h3>
        <div class="footer-links">
          {% if section.settings.company_description != blank %}
            <p style="color: #cccccc; font-size: 14px; line-height: 1.6;">{{ section.settings.company_description }}</p>
          {% endif %}
          {% if section.settings.company_address != blank %}
            <p style="color: #cccccc; font-size: 14px; margin-top: 15px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 8px;">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
              {{ section.settings.company_address }}
            </p>
          {% endif %}
        </div>
      </div>
      {% endif %}

      <!-- 快速链接 -->
      {% if section.settings.show_quick_links %}
      <div class="footer-section">
        <h3>{{ section.settings.quick_links_title | default: "快速链接" }}</h3>
        <ul class="footer-links">
          {% for block in section.blocks %}
            {% if block.type == 'quick_link' %}
              <li>
                <a href="{{ block.settings.link_url | default: '#' }}">
                  {{ block.settings.link_text | default: "链接" }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      <!-- 客户服务 -->
      {% if section.settings.show_customer_service %}
      <div class="footer-section">
        <h3>{{ section.settings.customer_service_title | default: "客户服务" }}</h3>
        <ul class="footer-links">
          {% for block in section.blocks %}
            {% if block.type == 'service_link' %}
              <li>
                <a href="{{ block.settings.service_url | default: '#' }}">
                  {{ block.settings.service_text | default: "服务" }}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      <!-- 联系方式 -->
      {% if section.settings.show_contact_info %}
      <div class="footer-section">
        <h3>{{ section.settings.contact_title | default: "联系我们" }}</h3>
        <div class="footer-links">
          {% if section.settings.contact_phone != blank %}
            <a href="tel:{{ section.settings.contact_phone }}">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
              </svg>
              {{ section.settings.contact_phone }}
            </a>
          {% endif %}
          {% if section.settings.contact_email != blank %}
            <a href="mailto:{{ section.settings.contact_email }}">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
              {{ section.settings.contact_email }}
            </a>
          {% endif %}
        </div>
      </div>
      {% endif %}
    </div>

    <!-- 页脚底部 -->
    <div class="footer-bottom">
      <p>{{ section.settings.copyright_text | default: "© 2024 公司名称. 保留所有权利." }}</p>
    </div>
  </div>
</div>

