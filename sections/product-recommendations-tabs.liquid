{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<style>
  .recommendations-tabs {
    margin: 50px auto;
    max-width: 1200px;
    padding: 0 20px;
  }

  .tab-headers {
    display: flex;
    gap: 20px;
    border-bottom: 2px solid #e0e0e0;
    margin-bottom: 30px;
  }

  .tab-header {
    padding: 15px 30px;
    cursor: pointer;
    font-size: 18px;
    font-weight: 500;
    border: none;
    background: none;
    color: #666;
    position: relative;
    transition: color 0.3s ease;
  }

  .tab-header:hover {
    color: #000;
  }

  .tab-header.active {
    color: #000;
    font-weight: 600;
  }

  .tab-header.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: #000;
  }

  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  @media (max-width: 768px) {
    .tab-header {
      padding: 12px 20px;
      font-size: 16px;
    }

    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
  }
</style>

<div class="recommendations-tabs">
  <div class="tab-headers">
    <button class="tab-header active" data-tab="recommended">
      {{ section.settings.tab_1_title }}
    </button>
    <button class="tab-header" data-tab="recently-viewed">
      {{ section.settings.tab_2_title }}
    </button>
  </div>

  <!-- 你可能喜欢 Tab -->
  <div class="tab-content active" id="recommended">
    <div class="product-recommendations" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}">
      <div class="product-grid" id="recommended-products">
        <p>正在加载推荐商品...</p>
      </div>
    </div>
  </div>

  <!-- 你浏览过的 Tab -->
  <div class="tab-content" id="recently-viewed">
    <div class="product-grid" id="recently-viewed-products">
      <p>正在加载浏览记录...</p>
    </div>
  </div>
</div>

<script>
  // Tab 切换功能
  document.querySelectorAll('.tab-header').forEach(header => {
    header.addEventListener('click', function() {
      const tabName = this.getAttribute('data-tab');
      
      // 移除所有 active 类
      document.querySelectorAll('.tab-header').forEach(h => h.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      
      // 添加 active 类到当前选项
      this.classList.add('active');
      document.getElementById(tabName).classList.add('active');
      
      // 如果切换到浏览记录，加载数据
      if (tabName === 'recently-viewed') {
        loadRecentlyViewed();
      }
    });
  });

  // 加载产品推荐
  function loadRecommendations() {
    const container = document.querySelector('.product-recommendations');
    if (!container) return;
    
    const url = container.dataset.url;
    
    fetch(url)
      .then(response => response.text())
      .then(text => {
        const html = document.createElement('div');
        html.innerHTML = text;
        const recommendations = html.querySelector('.product-recommendations');
        
        if (recommendations && recommendations.innerHTML.trim().length) {
          container.innerHTML = recommendations.innerHTML;
        } else {
          container.innerHTML = '<p>暂无推荐商品</p>';
        }
      })
      .catch(e => {
        console.error('加载推荐失败:', e);
        container.innerHTML = '<p>暂无推荐商品</p>';
      });
  }

  // 浏览记录功能
  function loadRecentlyViewed() {
    const container = document.getElementById('recently-viewed-products');
    const recentlyViewed = JSON.parse(localStorage.getItem('recentlyViewed') || '[]');
    
    console.log('浏览记录:', recentlyViewed); // 调试用
    
    if (recentlyViewed.length === 0) {
      container.innerHTML = '<p>暂无浏览记录</p>';
      return;
    }

    // 构建产品查询
    const handles = recentlyViewed.slice(0, {{ section.settings.products_to_show }});
    const requests = handles.map(handle => 
      fetch(`/products/${handle}.js`)
        .then(response => response.json())
        .catch(error => {
          console.error(`加载产品 ${handle} 失败:`, error);
          return null;
        })
    );

    Promise.all(requests)
      .then(products => {
        const validProducts = products.filter(p => p !== null);
        
        if (validProducts.length === 0) {
          container.innerHTML = '<p>暂无浏览记录</p>';
          return;
        }

        container.innerHTML = validProducts.map(product => `
          <div class="product-card">
            <a href="${product.url}">
              ${product.featured_image ? `
                <img src="${product.featured_image}" 
                     alt="${product.title}" 
                     loading="lazy"
                     style="width: 100%; height: auto;">
              ` : ''}
              <div class="product-title" style="margin: 10px 0; font-size: 16px;">${product.title}</div>
              <div class="product-price" style="font-size: 18px; font-weight: 600;">
                ${formatMoney(product.price)}
              </div>
            </a>
          </div>
        `).join('');
      })
      .catch(error => {
        console.error('加载浏览记录失败:', error);
        container.innerHTML = '<p>加载失败，请稍后再试</p>';
      });
  }

  // 格式化价格
  function formatMoney(cents) {
    const amount = (cents / 100).toFixed(2);
    return '{{ shop.money_format }}'.replace('{{amount}}', amount).replace('{{amount_no_decimals}}', Math.round(cents / 100));
  }

  // 保存当前浏览的商品
  function saveRecentlyViewed() {
    {% if product %}
      const handle = '{{ product.handle }}';
      let recentlyViewed = JSON.parse(localStorage.getItem('recentlyViewed') || '[]');
      
      // 移除重复项
      recentlyViewed = recentlyViewed.filter(h => h !== handle);
      
      // 添加到开头
      recentlyViewed.unshift(handle);
      
      // 只保留最近的商品
      recentlyViewed = recentlyViewed.slice(0, {{ section.settings.products_to_show }});
      
      localStorage.setItem('recentlyViewed', JSON.stringify(recentlyViewed));
      
      console.log('已保存浏览记录:', handle); // 调试用
    {% endif %}
  }

  // 页面加载时执行
  document.addEventListener('DOMContentLoaded', function() {
    // 在产品页面保存浏览记录
    if (window.location.pathname.includes('/products/')) {
      saveRecentlyViewed();
    }
    
    // 加载推荐商品
    loadRecommendations();
  });
</script>

{% schema %}
{
  "name": "商品推荐选项卡",
  "settings": [
    {
      "type": "text",
      "id": "tab_1_title",
      "label": "第一个选项卡标题",
      "default": "你可能喜欢"
    },
    {
      "type": "text",
      "id": "tab_2_title",
      "label": "第二个选项卡标题",
      "default": "你浏览过的"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "显示商品数量",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "商品推荐选项卡"
    }
  ]
}
{% endschema %}
