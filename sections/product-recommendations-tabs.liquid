{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

<style>
  .recommendations-tabs {
    margin: 50px auto;
    max-width: 1200px;
    padding: 0 20px;
  }

  .tab-headers {
    display: flex;
    gap: 20px;
    border-bottom: 2px solid #e0e0e0;
    margin-bottom: 30px;
  }

  .tab-header {
    padding: 15px 30px;
    cursor: pointer;
    font-size: 18px;
    font-weight: 500;
    border: none;
    background: none;
    color: #666;
    position: relative;
    transition: color 0.3s ease;
  }

  .tab-header:hover {
    color: #000;
  }

  .tab-header.active {
    color: #000;
    font-weight: 600;
  }

  .tab-header.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background-color: #000;
  }

  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  @media (max-width: 768px) {
    .tab-header {
      padding: 12px 20px;
      font-size: 16px;
    }

    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
  }
</style>

<div class="recommendations-tabs">
  <div class="tab-headers">
    <button class="tab-header active" data-tab="recommended">
      {{ section.settings.tab_1_title }}
    </button>
    <button class="tab-header" data-tab="recently-viewed">
      {{ section.settings.tab_2_title }}
    </button>
  </div>

  <!-- 你可能喜欢 Tab -->
  <div class="tab-content active" id="recommended">
    <div class="product-grid" id="recommended-products">
      {% if recommendations.performed and recommendations.products_count > 0 %}
        {% for product in recommendations.products limit: section.settings.products_to_show %}
          {% render '_product-card', product: product %}
        {% endfor %}
      {% else %}
        <p>暂无推荐商品</p>
      {% endif %}
    </div>
  </div>

  <!-- 你浏览过的 Tab -->
  <div class="tab-content" id="recently-viewed">
    <div class="product-grid" id="recently-viewed-products">
      <p>正在加载浏览记录...</p>
    </div>
  </div>
</div>

<script>
  // Tab 切换功能
  document.querySelectorAll('.tab-header').forEach(header => {
    header.addEventListener('click', function() {
      const tabName = this.getAttribute('data-tab');
      
      // 移除所有 active 类
      document.querySelectorAll('.tab-header').forEach(h => h.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      
      // 添加 active 类到当前选项
      this.classList.add('active');
      document.getElementById(tabName).classList.add('active');
      
      // 如果切换到浏览记录，加载数据
      if (tabName === 'recently-viewed') {
        loadRecentlyViewed();
      }
    });
  });

  // 浏览记录功能
  function loadRecentlyViewed() {
    const container = document.getElementById('recently-viewed-products');
    const recentlyViewed = JSON.parse(localStorage.getItem('recentlyViewed') || '[]');
    
    if (recentlyViewed.length === 0) {
      container.innerHTML = '<p>暂无浏览记录</p>';
      return;
    }

    // 使用 Section Rendering API 获取产品卡片
    const handles = recentlyViewed.slice(0, {{ section.settings.products_to_show }});
    
    Promise.all(
      handles.map(handle => 
        fetch(`/products/${handle}?section_id={{ section.id }}`)
          .then(response => response.text())
          .then(html => {
            const parser = new DOMParser();
            const doc = parser.parseFromString(html, 'text/html');
            return doc.querySelector('.product-card-wrapper');
          })
      )
    ).then(cards => {
      const validCards = cards.filter(card => card !== null);
      if (validCards.length === 0) {
        container.innerHTML = '<p>暂无浏览记录</p>';
        return;
      }
      container.innerHTML = '';
      validCards.forEach(card => container.appendChild(card));
    }).catch(error => {
      console.error('Error loading recently viewed:', error);
      container.innerHTML = '<p>加载失败，请稍后再试</p>';
    });
  }

  // 保存当前浏览的商品
  function saveRecentlyViewed() {
    {% if product %}
      const handle = '{{ product.handle }}';
      let recentlyViewed = JSON.parse(localStorage.getItem('recentlyViewed') || '[]');
      
      // 移除重复项
      recentlyViewed = recentlyViewed.filter(h => h !== handle);
      
      // 添加到开头
      recentlyViewed.unshift(handle);
      
      // 只保留最近 {{ section.settings.products_to_show }} 个
      recentlyViewed = recentlyViewed.slice(0, {{ section.settings.products_to_show }});
      
      localStorage.setItem('recentlyViewed', JSON.stringify(recentlyViewed));
    {% endif %}
  }

  // 在产品页面保存浏览记录
  if (window.location.pathname.includes('/products/')) {
    saveRecentlyViewed();
  }
</script>

{% schema %}
{
  "name": "商品推荐选项卡",
  "settings": [
    {
      "type": "text",
      "id": "tab_1_title",
      "label": "第一个选项卡标题",
      "default": "你可能喜欢"
    },
    {
      "type": "text",
      "id": "tab_2_title",
      "label": "第二个选项卡标题",
      "default": "你浏览过的"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "显示商品数量",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "商品推荐选项卡"
    }
  ]
}
{% endschema %}
