<div class="ms-stability-section" {{ section.shopify_attributes }}>
  <div class="ms-stability-container">
    <!-- 标题 -->
    <div class="ms-section-header">
      <h2 class="ms-section-title">{{ section.settings.section_title }}</h2>
    </div>

    <!-- 内容布局 -->
    <div class="ms-materials-layout">
      <!-- 左侧品牌logo图片 -->
      <div class="ms-brand-logo-area">
        {% if section.settings.brand_logo_image %}
          <div class="ms-brand-logo-container">
            <img
              src="{{ section.settings.brand_logo_image | img_url: '800x' }}"
              alt="{{ section.settings.brand_logo_alt }}"
              class="ms-brand-logo-image"
            >
          </div>
        {% endif %}
      </div>

      <!-- 中间产品图片区域 -->
      <div class="ms-product-images-area">
        <!-- 上方产品图片 -->
        {% if section.settings.top_product_image %}
          <div class="ms-product-image-container ms-top-image">
            <img
              src="{{ section.settings.top_product_image | img_url: '600x' }}"
              alt="{{ section.settings.top_product_alt }}"
              class="ms-product-image"
            >
          </div>
        {% endif %}

        <!-- 下方产品图片 -->
        {% if section.settings.bottom_product_image %}
          <div class="ms-product-image-container ms-bottom-image">
            <img
              src="{{ section.settings.bottom_product_image | img_url: '600x' }}"
              alt="{{ section.settings.bottom_product_alt }}"
              class="ms-product-image"
            >
          </div>
        {% endif %}
      </div>

      <!-- 右侧文字内容 -->
      <div class="ms-content-area">
        <!-- 主要描述文字 -->
        <div class="ms-main-description">
          {{ section.settings.main_description }}
        </div>

        <!-- CTA区域 -->
        <div class="ms-cta-area">
          <p class="ms-cta-text">{{ section.settings.cta_text }}</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .ms-stability-section {
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px 0;
    background-color: #fff;
  }

  .ms-stability-container {
    max-width: 1520px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* 标题区域 */
  .ms-section-header {
    text-align: center;
    margin-bottom: {{ section.settings.title_margin_bottom }}px;
  }

  .ms-section-title {
    font-size: 48px;
    font-weight: 500;
    color: #161616;
    line-height: {{ section.settings.title_line_height }};
    margin: 0;
    margin-left: auto;
    margin-right: auto;
  }

  /* 主要布局 */
  .ms-materials-layout {
    display: flex;
    gap: 28.65px;
    align-items: start;
    justify-content: start;
    max-width: 1520px;
    margin: 0 auto;
  }

  /* 左侧品牌logo区域 */
  .ms-brand-logo-area {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    flex-shrink: 0;
  }

  .ms-brand-logo-container {
    width: 561px;
    height: 600px;
    border-radius: {{ section.settings.brand_logo_border_radius }}px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ms-brand-logo-image {
    width: 561px;
    height: 600px;
    display: block;
    object-fit: cover;
    object-position: center;
  }

  /* 中间产品图片区域 */
  .ms-product-images-area {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.product_images_gap }}px;
    align-items: center;
    width: 460px;
    flex-shrink: 0;
  }

  .ms-product-image-container {
    width: 460px;
    border-radius: {{ section.settings.product_image_border_radius }}px;
    overflow: hidden;
    background-color: {{ section.settings.product_image_background }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ms-product-image-container.ms-top-image {
    height: 190px;
  }

  .ms-product-image-container.ms-bottom-image {
    height: 190px;
  }

  .ms-product-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    display: block;
    object-fit: contain;
  }

  /* 右侧内容区域 */
  .ms-content-area {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    width: 346px;
    flex-shrink: 0;
  }

  .ms-main-description {
    font-size: {{ section.settings.description_font_size }}px;
    color: {{ section.settings.description_color }};
    line-height: {{ section.settings.description_line_height }};
    margin: 0 0 {{ section.settings.description_margin_bottom }}px 0;
    text-align: left;
  }

  /* CTA区域 */
  .ms-cta-area {
    margin-top: {{ section.settings.cta_margin_top }}px;
  }

  .ms-cta-text {
    font-size: {{ section.settings.cta_font_size }}px;
    color: {{ section.settings.cta_color }};
    font-weight: {{ section.settings.cta_font_weight }};
    line-height: {{ section.settings.cta_line_height }};
    margin: 0;
    position: relative;
    padding-bottom: {{ section.settings.cta_underline_margin_top }}px;
  }

  .ms-cta-text::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: {{ section.settings.cta_underline_height }}px;
    background: linear-gradient(to right, {{ section.settings.cta_underline_color }} 0%, {{ section.settings.cta_underline_color }} 85%, transparent 85%);
    display: {% if section.settings.show_cta_underline %}block{% else %}none{% endif %};
  }

  /* 响应式设计 - 基于1920px设计图按比例缩放 */

  /* 大屏幕 (1920px+) - 使用设计图精确尺寸 */
  @media (min-width: 1920px) {
    .ms-stability-container {
      max-width: 1520px;
    }
    
    .ms-section-title {
      font-size: 48px;
    }
    
    .ms-materials-layout {
      grid-template-columns: 400px 400px 1fr;
      gap: 18px;
    }
    
    .ms-brand-logo-container {
      height: 400px;
    }
    
    .ms-product-image-container.ms-top-image {
      height: 190px;
    }
    
    .ms-product-image-container.ms-bottom-image {
      height: 190px;
    }
  }

  /* 笔记本电脑 (1366px - 1919px) - 按比例缩放 (约0.84倍) */
  @media (max-width: 1919px) and (min-width: 1366px) {
    .ms-stability-container {
      max-width: 1277px; /* 1520 * 0.84 */
    }
    
    .ms-section-title {
      font-size: 40px; /* 48 * 0.84 */
    }
    
    .ms-materials-layout {
      gap: 24px; /* 28.65*0.84 */
      max-width: 1277px; /* 1520 * 0.84 */
    }
    
    .ms-brand-logo-container {
      width: 471px; /* 561 * 0.84 */
      height: 504px; /* 600 * 0.84 */
    }

    .ms-brand-logo-image {
      width: 471px; /* 561 * 0.84 */
      height: 504px; /* 600 * 0.84 */
    }

    .ms-product-images-area {
      width: 386px; /* 460 * 0.84 */
    }

    .ms-product-image-container {
      width: 386px; /* 460 * 0.84 */
    }

    .ms-content-area {
      width: 291px; /* 346 * 0.84 */
    }
    
    .ms-product-image-container.ms-top-image {
      height: 160px; /* 190 * 0.84 */
    }
    
    .ms-product-image-container.ms-bottom-image {
      height: 160px; /* 190 * 0.84 */
    }
  }

  /* 小笔记本 (1024px - 1365px) - 按比例缩放 (约0.67倍) */
  @media (max-width: 1365px) and (min-width: 1024px) {
    .ms-stability-container {
      max-width: 1018px; /* 1520 * 0.67 */
      padding: 0 30px;
    }
    
    .ms-section-title {
      font-size: 32px; /* 48 * 0.67 */
    }
    
    .ms-materials-layout {
      gap: 19px; /* 28.65*0.67 */
      max-width: 1018px; /* 1520 * 0.67 */
    }
    
    .ms-brand-logo-container {
      width: 376px; /* 561 * 0.67 */
      height: 402px; /* 600 * 0.67 */
    }

    .ms-brand-logo-image {
      width: 376px; /* 561 * 0.67 */
      height: 402px; /* 600 * 0.67 */
    }

    .ms-product-images-area {
      width: 308px; /* 460 * 0.67 */
    }

    .ms-product-image-container {
      width: 308px; /* 460 * 0.67 */
    }

    .ms-content-area {
      width: 232px; /* 346 * 0.67 */
    }
    
    .ms-product-image-container.ms-top-image {
      height: 127px; /* 190 * 0.67 */
    }
    
    .ms-product-image-container.ms-bottom-image {
      height: 127px; /* 190 * 0.67 */
    }
  }

  /* 平板横屏 (768px - 1023px) - 按比例缩放 (约0.5倍) */
  @media (max-width: 1023px) and (min-width: 768px) {
    .ms-stability-container {
      padding: 0 25px;
    }
    
    .ms-section-title {
      font-size: 24px; /* 48 * 0.5 */
    }
    
    .ms-materials-layout {
      flex-direction: column;
      gap: 14px; /* 28.65 * 0.5 */
      text-align: center;
      max-width: 100%;
    }

    .ms-content-area {
      padding-left: 0;
    }

    .ms-brand-logo-area {
      order: 1;
    }

    .ms-product-images-area {
      order: 2;
      flex-direction: row;
      justify-content: center;
      gap: 20px;
    }

    .ms-content-area {
      order: 3;
    }

    .ms-brand-logo-container {
      width: 281px; /* 561 * 0.5 */
      height: 300px; /* 600 * 0.5 */
      max-width: 281px;
      margin: 0 auto;
    }

    .ms-brand-logo-image {
      width: 281px; /* 561 * 0.5 */
      height: 300px; /* 600 * 0.5 */
    }

    .ms-product-images-area {
      width: 230px; /* 460 * 0.5 */
    }

    .ms-product-image-container {
      width: 230px; /* 460 * 0.5 */
    }

    .ms-content-area {
      width: 173px; /* 346 * 0.5 */
      margin: 0 auto;
    }

    .ms-product-image-container.ms-top-image {
      height: 95px; /* 190 * 0.5 */
    }

    .ms-product-image-container.ms-bottom-image {
      height: 95px; /* 190 * 0.5 */
    }
  }

  /* 平板竖屏和大手机 (481px - 767px) - 单栏布局，按比例缩放 (约0.4倍) */
  @media (max-width: 767px) and (min-width: 481px) {
    .ms-stability-container {
      padding: 0 20px;
    }
    
    .ms-materials-layout {
      flex-direction: column;
      gap: 11px; /* 28.65 * 0.4 */
      text-align: center;
      max-width: 100%;
    }

    .ms-section-title {
      font-size: 19px; /* 48 * 0.4 */
    }

    .ms-product-images-area {
      flex-direction: column;
      gap: 12px; /* 20 * 0.6 */
    }

    .ms-main-description {
      font-size: 6px; /* 16 * 0.4 */
    }

    .ms-cta-text {
      font-size: 7px; /* 18 * 0.4 */
    }

    .ms-cta-text::after {
      background: linear-gradient(to right, {{ section.settings.cta_underline_color }} 0%, {{ section.settings.cta_underline_color }} 75%, transparent 75%);
    }

    .ms-brand-logo-container {
      width: 224px; /* 561 * 0.4 */
      height: 240px; /* 600 * 0.4 */
      max-width: 224px;
      margin: 0 auto;
    }

    .ms-brand-logo-image {
      width: 224px; /* 561 * 0.4 */
      height: 240px; /* 600 * 0.4 */
    }

    .ms-product-images-area {
      width: 184px; /* 460 * 0.4 */
      margin: 0 auto;
    }

    .ms-product-image-container {
      width: 184px; /* 460 * 0.4 */
    }

    .ms-content-area {
      width: 138px; /* 346 * 0.4 */
      margin: 0 auto;
    }

    .ms-product-image-container.ms-top-image {
      height: 76px; /* 190 * 0.4 */
    }

    .ms-product-image-container.ms-bottom-image {
      height: 76px; /* 190 * 0.4 */
    }
  }

  /* 小手机 (320px - 480px) - 单栏布局，按比例缩放 (约0.33倍) */
  @media (max-width: 480px) {
    .ms-stability-container {
      padding: 0 15px;
    }

    .ms-stability-section {
      padding: 26px 0; /* 80 * 0.33 */
    }

    .ms-materials-layout {
      flex-direction: column;
      gap: 9px; /* 28.65 * 0.33 */
    }

    .ms-section-title {
      font-size: 16px; /* 48 * 0.33 */
    }

    .ms-brand-logo-container,
    .ms-product-image-container {
      padding: 15px;
    }

    .ms-brand-logo-container {
      width: 185px; /* 561 * 0.33 */
      height: 198px; /* 600 * 0.33 */
      max-width: 185px;
      margin: 0 auto;
    }

    .ms-brand-logo-image {
      width: 185px; /* 561 * 0.33 */
      height: 198px; /* 600 * 0.33 */
    }

    .ms-product-images-area {
      width: 152px; /* 460 * 0.33 */
      margin: 0 auto;
    }

    .ms-product-image-container {
      width: 152px; /* 460 * 0.33 */
    }

    .ms-content-area {
      width: 114px; /* 346 * 0.33 */
      margin: 0 auto;
    }

    .ms-product-image-container.ms-top-image {
      height: 63px; /* 190 * 0.33 */
    }

    .ms-product-image-container.ms-bottom-image {
      height: 63px; /* 190 * 0.33 */
    }

    .ms-main-description {
      font-size: 5px; /* 16 * 0.33 */
    }

    .ms-cta-text {
      font-size: 6px; /* 18 * 0.33 */
    }

    .ms-cta-text::after {
      background: linear-gradient(to right, {{ section.settings.cta_underline_color }} 0%, {{ section.settings.cta_underline_color }} 70%, transparent 70%);
    }
  }

  /* 超小屏幕 (最小320px) - 单栏布局，按比例缩放 (约0.25倍) */
  @media (max-width: 320px) {
    .ms-materials-layout {
      flex-direction: column;
      gap: 7px; /* 28.65 * 0.25 */
    }

    .ms-section-title {
      font-size: 12px; /* 48 * 0.25 */
    }

    .ms-brand-logo-container {
      width: 140px; /* 561 * 0.25 */
      height: 150px; /* 600 * 0.25 */
      max-width: 140px;
      margin: 0 auto;
    }

    .ms-brand-logo-image {
      width: 140px; /* 561 * 0.25 */
      height: 150px; /* 600 * 0.25 */
    }

    .ms-product-images-area {
      width: 115px; /* 460 * 0.25 */
      margin: 0 auto;
    }

    .ms-product-image-container {
      width: 115px; /* 460 * 0.25 */
    }

    .ms-content-area {
      width: 87px; /* 346 * 0.25 */
      margin: 0 auto;
    }

    .ms-product-image-container.ms-top-image {
      height: 48px; /* 190 * 0.25 */
    }

    .ms-product-image-container.ms-bottom-image {
      height: 48px; /* 190 * 0.25 */
    }

    .ms-main-description {
      font-size: 4px; /* 16 * 0.25 */
    }

    .ms-cta-text {
      font-size: 5px; /* 18 * 0.25 */
    }
  }
</style>

{% schema %}
{
  "name": "Materials for Stability",
  "tag": "section",
  "class": "materials-stability-section",
  "settings": [
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "layout_gap",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Layout Gap",
      "default": 30
    },
    {
      "type": "header",
      "content": "Section Title"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section Title",
      "default": "Top-Tier Materials for Lasting Stability"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Title Font Size",
      "default": 48
    },
    {
      "type": "select",
      "id": "title_font_weight",
      "label": "Title Font Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title Color",
      "default": "#161616"
    },
    {
      "type": "range",
      "id": "title_line_height",
      "min": 1.0,
      "max": 2.0,
      "step": 0.1,
      "label": "Title Line Height",
      "default": 1.2
    },
    {
      "type": "range",
      "id": "title_margin_bottom",
      "min": 30,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Title Bottom Margin",
      "default": 60
    },
    {
      "type": "header",
      "content": "Brand Logo"
    },
    {
      "type": "image_picker",
      "id": "brand_logo_image",
      "label": "Brand Logo Image"
    },
    {
      "type": "text",
      "id": "brand_logo_alt",
      "label": "Brand Logo Alt Text",
      "default": "XSPilates brand logo on wood surface"
    },
    {
      "type": "range",
      "id": "brand_logo_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Brand Logo Border Radius",
      "default": 16
    },
    {
      "type": "header",
      "content": "Product Images"
    },
    {
      "type": "image_picker",
      "id": "top_product_image",
      "label": "Top Product Image"
    },
    {
      "type": "text",
      "id": "top_product_alt",
      "label": "Top Product Alt Text",
      "default": "Pilates reformer detail view"
