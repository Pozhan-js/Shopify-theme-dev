    {
      "type": "textarea",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "Want to see material samples or test glide performance? Contact us for a custom demo."
    },
    {
      "type": "range",
      "id": "cta_font_size",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "CTA Font Size",
      "default": 18
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "CTA Text Color",
      "default": "#333333"
    },
    {
      "type": "select",
      "id": "cta_font_weight",
      "label": "CTA Font Weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "cta_line_height",
      "min": 1.2,
      "max": 2.0,
      "step": 0.1,
      "label": "CTA Line Height",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "cta_margin_top",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "CTA Top Margin",
      "default": 40
    },
