      "content": "ISO 45001 Certification"
    },
    {
      "type": "image_picker",
      "id": "iso45001certificate",
      "label": "ISO 45001 Certificate Image",
      "info": "Upload ISO 45001 certification document (recommended size: 320x400px)"
    },
    {
      "type": "text",
      "id": "iso45001title",
      "label": "ISO 45001 Title",
      "default": "ISO 45001"
    },
    {
      "type": "textarea",
      "id": "iso45001description",
      "label": "ISO 45001 Description",
      "default": "Occupational health & safety management for safe production environments."
