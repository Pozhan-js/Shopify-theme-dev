{% comment %}
  Sustainable Manufacturing Section
  Displays statistics about sustainable manufacturing practices
{% endcomment %}

<style>
  .sustainable-manufacturing-section {
    padding: 80px 20px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    position: relative;
    overflow: hidden;
  }

  .sustainable-manufacturing-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="2" fill="rgba(255,255,255,0.1)"/></svg>');
    opacity: 0.3;
  }

  .sustainable-manufacturing-container {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .sustainable-manufacturing-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .sustainable-manufacturing-title {
    font-size: 48px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 20px;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
  }

  .sustainable-manufacturing-subtitle {
    font-size: 20px;
    color: rgba(255,255,255,0.9);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .sustainable-manufacturing-carousel-container {
    position: relative;
    padding: 0 60px;
  }

  .sustainable-manufacturing-carousel-wrapper {
    overflow: hidden;
    position: relative;
  }

  .sustainable-manufacturing-carousel-track {
    display: flex;
    gap: 30px;
    transition: transform 0.5s ease;
  }

  .sustainable-manufacturing-statistic-item {
    flex: 0 0 auto;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 20px;
    padding: 40px 30px;
    text-align: center;
    box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .sustainable-manufacturing-statistic-item:hover {
    transform: translateY(-10px);
    box-shadow: 0 15px 40px rgba(0,0,0,0.3);
  }

  .sustainable-manufacturing-icon {
    font-size: 60px;
    margin-bottom: 20px;
    display: block;
  }

  .sustainable-manufacturing-value {
    font-size: 48px;
    font-weight: 700;
    color: #667eea;
    margin-bottom: 10px;
    display: block;
  }

  .sustainable-manufacturing-label {
    font-size: 18px;
    color: #666;
    font-weight: 500;
  }

  .sustainable-manufacturing-nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24px;
    color: #667eea;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    z-index: 10;
  }

  .sustainable-manufacturing-nav-btn:hover {
    background: #ffffff;
    transform: translateY(-50%) scale(1.1);
    box-shadow: 0 6px 20px rgba(0,0,0,0.3);
  }

  .sustainable-manufacturing-prev-btn {
    left: 0;
  }

  .sustainable-manufacturing-next-btn {
    right: 0;
  }

  .sustainable-manufacturing-indicators {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 40px;
  }

  .sustainable-manufacturing-indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .sustainable-manufacturing-indicator.active {
    background: #ffffff;
    width: 30px;
    border-radius: 6px;
  }

  @media (max-width: 768px) {
    .sustainable-manufacturing-section {
      padding: 60px 20px;
    }

    .sustainable-manufacturing-title {
      font-size: 32px;
    }

    .sustainable-manufacturing-subtitle {
      font-size: 16px;
    }

    .sustainable-manufacturing-carousel-container {
      padding: 0;
    }

    .sustainable-manufacturing-carousel-wrapper {
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .sustainable-manufacturing-carousel-wrapper::-webkit-scrollbar {
      display: none;
    }

    .sustainable-manufacturing-carousel-track {
      gap: 20px;
      padding: 0 20px;
    }

    .sustainable-manufacturing-statistic-item {
      scroll-snap-align: center;
      min-width: calc(100% - 40px);
      padding: 30px 20px;
    }

    .sustainable-manufacturing-nav-btn {
      display: none;
    }

    .sustainable-manufacturing-icon {
      font-size: 48px;
    }

    .sustainable-manufacturing-value {
      font-size: 36px;
    }

    .sustainable-manufacturing-label {
      font-size: 16px;
    }
  }
</style>

<section class="sustainable-manufacturing-section">
  <div class="sustainable-manufacturing-container">
    <div class="sustainable-manufacturing-header">
      <h2 class="sustainable-manufacturing-title">{{ section.settings.title }}</h2>
      <p class="sustainable-manufacturing-subtitle">{{ section.settings.subtitle }}</p>
    </div>

    <div class="sustainable-manufacturing-carousel-container">
      <button class="sustainable-manufacturing-nav-btn sustainable-manufacturing-prev-btn" aria-label="Previous">
        ‹
      </button>

      <div class="sustainable-manufacturing-carousel-wrapper">
        <div class="sustainable-manufacturing-carousel-track">
          {% for block in section.blocks %}
            <div class="sustainable-manufacturing-statistic-item" {{ block.shopify_attributes }}>
              <span class="sustainable-manufacturing-icon">{{ block.settings.icon }}</span>
              <span class="sustainable-manufacturing-value">{{ block.settings.value }}</span>
              <span class="sustainable-manufacturing-label">{{ block.settings.label }}</span>
            </div>
          {% endfor %}
        </div>
      </div>

      <button class="sustainable-manufacturing-nav-btn sustainable-manufacturing-next-btn" aria-label="Next">
        ›
      </button>
    </div>

    <div class="sustainable-manufacturing-indicators">
      {% for block in section.blocks %}
        <div class="sustainable-manufacturing-indicator {% if forloop.first %}active{% endif %}"></div>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const carousel = document.querySelector('.sustainable-manufacturing-carousel-track');
    const carouselWrapper = document.querySelector('.sustainable-manufacturing-carousel-wrapper');
    const items = document.querySelectorAll('.sustainable-manufacturing-statistic-item');
    const indicators = document.querySelectorAll('.sustainable-manufacturing-indicator');
    const prevBtn = document.querySelector('.sustainable-manufacturing-prev-btn');
    const nextBtn = document.querySelector('.sustainable-manufacturing-next-btn');
    
    if (!carousel || items.length === 0) return;
    
    let currentIndex = 0;
    const originalItemsCount = items.length;
    let itemsPerView = 3;
    let isMobile = window.innerWidth <= 768;
    let isTransitioning = false;
    let clonedItems = [];
    
    function getItemsPerView() {
      const width = window.innerWidth;
      if (width <= 768) {
        return 1;
      }
      return 3;
    }
    
    function cloneItemsForLoop() {
      if (isMobile || clonedItems.length > 0) return;
      
      for (let i = 0; i < itemsPerView; i++) {
        const clone = items[i].cloneNode(true);
        clone.classList.add('cloned-item');
        carousel.appendChild(clone);
        clonedItems.push(clone);
      }
    }
    
    function removeClonedItems() {
      clonedItems.forEach(item => {
        if (item.parentNode) {
          item.parentNode.removeChild(item);
        }
      });
      clonedItems = [];
    }
    
    function setupCarousel() {
      isMobile = window.innerWidth <= 768;
      itemsPerView = getItemsPerView();
      
      if (isMobile) {
        removeClonedItems();
        carousel.style.transform = 'none';
        carousel.style.transition = '';
        return;
      }
      
      cloneItemsForLoop();
      
      const wrapperWidth = carouselWrapper.offsetWidth;
      const totalGap = 30 * (itemsPerView - 1);
      const itemWidth = (wrapperWidth - totalGap) / itemsPerView;
      
      const allItems = carousel.querySelectorAll('.sustainable-manufacturing-statistic-item');
      allItems.forEach(item => {
        item.style.width = itemWidth + 'px';
        item.style.minWidth = itemWidth + 'px';
      });
      
      if (currentIndex >= originalItemsCount) {
        currentIndex = 0;
      }
    }
    
    function updateCarousel(immediate = false) {
      if (isMobile) {
        return;
      }
      
      const wrapperWidth = carouselWrapper.offsetWidth;
      const totalGap = 30 * (itemsPerView - 1);
      const itemWidth = (wrapperWidth - totalGap) / itemsPerView;
      const moveDistance = currentIndex * (itemWidth + 30);
      
      if (immediate) {
        carousel.style.transition = 'none';
      } else {
        carousel.style.transition = 'transform 0.5s ease';
      }
      
      carousel.style.transform = `translateX(-${moveDistance}px)`;
      
      const indicatorIndex = currentIndex % originalItemsCount;
      indicators.forEach((indicator, index) => {
        indicator.classList.toggle('active', index === indicatorIndex);
      });
    }
    
    function nextSlide() {
      if (isMobile || isTransitioning) return;
      
      isTransitioning = true;
      currentIndex++;
      updateCarousel();
      
      if (currentIndex >= originalItemsCount) {
        setTimeout(() => {
          currentIndex = 0;
          updateCarousel(true);
          isTransitioning = false;
        }, 500);
      } else {
        setTimeout(() => {
          isTransitioning = false;
        }, 500);
      }
    }
    
    function prevSlide() {
      if (isMobile || isTransitioning) return;
      
      isTransitioning = true;
      
      if (currentIndex === 0) {
        currentIndex = originalItemsCount;
        updateCarousel(true);
        
        setTimeout(() => {
          currentIndex = originalItemsCount - 1;
          updateCarousel();
          setTimeout(() => {
            isTransitioning = false;
          }, 500);
        }, 50);
      } else {
        currentIndex--;
        updateCarousel();
        setTimeout(() => {
          isTransitioning = false;
        }, 500);
      }
    }
    
    function updateIndicatorsOnScroll() {
      if (!isMobile) return;
      
      const scrollLeft = carouselWrapper.scrollLeft;
      const itemWidth = items[0].offsetWidth + 20;
      const activeIndex = Math.round(scrollLeft / itemWidth);
      
      indicators.forEach((indicator, index) => {
        indicator.classList.toggle('active', index === activeIndex);
      });
    }
    
    if (nextBtn) nextBtn.addEventListener('click', nextSlide);
    if (prevBtn) prevBtn.addEventListener('click', prevSlide);
    
    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        if (isMobile) {
          const itemWidth = items[0].offsetWidth + 20;
          carouselWrapper.scrollTo({
            left: index * itemWidth,
            behavior: 'smooth'
          });
        } else {
          if (!isTransitioning) {
            currentIndex = index;
            updateCarousel();
          }
        }
      });
    });
    
    if (carouselWrapper) {
      carouselWrapper.addEventListener('scroll', updateIndicatorsOnScroll);
    }
    
    {% if section.settings.autoplay %}
      if (!isMobile) {
        setInterval(nextSlide, {{ section.settings.autoplay_speed | times: 1000 }});
      }
    {% endif %}
    
    let resizeTimeout;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(function() {
        const wasMobile = isMobile;
        setupCarousel();
        if (wasMobile !== isMobile) {
          currentIndex = 0;
        }
        updateCarousel(true);
      }, 100);
    });
    
    setupCarousel();
    updateCarousel(true);
  });
</script>

