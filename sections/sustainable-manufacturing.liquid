<div class="sustainable-manufacturing-section">
  <div class="sustainable-manufacturing-container">
    <div class="sustainable-manufacturing-header">
      <h2 class="sustainable-manufacturing-title">{{ section.settings.title | default: "Sustainable Manufacturing" }}</h2>
      <p class="sustainable-manufacturing-subtitle">{{ section.settings.subtitle | default: "Our commitment to environmental responsibility" }}</p>
    </div>
    
    <div class="sustainable-manufacturing-carousel">
      <div class="sustainable-manufacturing-carousel-wrapper">
        <div class="sustainable-manufacturing-carousel-track">
          {% for block in section.blocks %}
            <div class="sustainable-manufacturing-statistic-item" {{ block.shopify_attributes }}>
              <div class="sustainable-manufacturing-statistic-icon">
                {% if block.settings.icon %}
                  <img src="{{ block.settings.icon | img_url: '60x60' }}" alt="{{ block.settings.title }}">
                {% else %}
                  <div class="sustainable-manufacturing-default-icon">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2L13.09 8.26L20 9L13.09 9.74L12 16L10.91 9.74L4 9L10.91 8.26L12 2Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
                    </svg>
                  </div>
                {% endif %}
              </div>
              <div class="sustainable-manufacturing-statistic-content">
                <h3 class="sustainable-manufacturing-statistic-number">{{ block.settings.number | default: "0%" }}</h3>
                <h4 class="sustainable-manufacturing-statistic-title">{{ block.settings.title | default: "Statistic Title" }}</h4>
                <p class="sustainable-manufacturing-statistic-description">{{ block.settings.description | default: "Description of the statistic" }}</p>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
      
      <div class="sustainable-manufacturing-carousel-controls">
        <button class="sustainable-manufacturing-prev-btn" aria-label="Previous slide">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <button class="sustainable-manufacturing-next-btn" aria-label="Next slide">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
      
      <div class="sustainable-manufacturing-indicators">
        {% for block in section.blocks %}
          <button class="sustainable-manufacturing-indicator {% if forloop.first %}active{% endif %}" aria-label="Go to slide {{ forloop.index }}"></button>
        {% endfor %}
      </div>
    </div>
  </div>
</div>

<style>
.sustainable-manufacturing-section {
  padding: 80px 0;
  background: linear-gradient(135deg, #f8fffe 0%, #e8f5f3 100%);
}

.sustainable-manufacturing-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.sustainable-manufacturing-header {
  text-align: center;
  margin-bottom: 60px;
}

.sustainable-manufacturing-title {
  font-size: 2.5rem;
  font-weight: 700;
  color: #1a5f5a;
  margin-bottom: 16px;
  line-height: 1.2;
}

.sustainable-manufacturing-subtitle {
  font-size: 1.125rem;
  color: #4a7c7a;
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.6;
}

.sustainable-manufacturing-carousel {
  position: relative;
}

.sustainable-manufacturing-carousel-wrapper {
  overflow: hidden;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10px);
  padding: 20px;
  box-shadow: 0 10px 40px rgba(26, 95, 90, 0.1);
}

.sustainable-manufacturing-carousel-track {
  display: flex;
  gap: 30px;
  transition: transform 0.5s ease;
}

.sustainable-manufacturing-statistic-item {
  flex: 0 0 auto;
  background: white;
  border-radius: 12px;
  padding: 40px 30px;
  text-align: center;
  box-shadow: 0 4px 20px rgba(26, 95, 90, 0.08);
  transition: all 0.3s ease;
  border: 1px solid rgba(26, 95, 90, 0.1);
}

.sustainable-manufacturing-statistic-item:hover {
  transform: translateY(-8px);
  box-shadow: 0 12px 40px rgba(26, 95, 90, 0.15);
  border-color: rgba(26, 95, 90, 0.2);
}

.sustainable-manufacturing-statistic-icon {
  margin-bottom: 24px;
  display: flex;
  justify-content: center;
  align-items: center;
}

.sustainable-manufacturing-statistic-icon img {
  width: 60px;
  height: 60px;
  object-fit: contain;
}

.sustainable-manufacturing-default-icon {
  width: 60px;
  height: 60px;
  background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
}

.sustainable-manufacturing-statistic-number {
  font-size: 3rem;
  font-weight: 800;
  color: #1a5f5a;
  margin-bottom: 12px;
  line-height: 1;
  background: linear-gradient(135deg, #4ecdc4 0%, #44a08d 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.sustainable-manufacturing-statistic-title {
  font-size: 1.25rem;
  font-weight: 600;
  color: #2d4a47;
  margin-bottom: 12px;
  line-height: 1.3;
}

.sustainable-manufacturing-statistic-description {
  font-size: 0.95rem;
  color: #6b8e8a;
  line-height: 1.5;
  margin: 0;
}

.sustainable-manufacturing-carousel-controls {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  display: flex;
  justify-content: space-between;
  pointer-events: none;
  z-index: 10;
}

.sustainable-manufacturing-prev-btn,
.sustainable-manufacturing-next-btn {
  width: 48px;
  height: 48px;
  background: white;
  border: 2px solid rgba(26, 95, 90, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  pointer-events: auto;
  color: #4a7c7a;
  box-shadow: 0 4px 20px rgba(26, 95, 90, 0.1);
}

.sustainable-manufacturing-prev-btn:hover,
.sustainable-manufacturing-next-btn:hover {
  background: #4ecdc4;
  color: white;
  border-color: #4ecdc4;
  transform: scale(1.1);
  box-shadow: 0 6px 25px rgba(78, 205, 196, 0.3);
}

.sustainable-manufacturing-prev-btn {
  margin-left: -24px;
}

.sustainable-manufacturing-next-btn {
  margin-right: -24px;
}

.sustainable-manufacturing-indicators {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-top: 40px;
}

.sustainable-manufacturing-indicator {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: none;
  background: rgba(26, 95, 90, 0.2);
  cursor: pointer;
  transition: all 0.3s ease;
}

.sustainable-manufacturing-indicator.active {
  background: #4ecdc4;
  transform: scale(1.2);
}

.sustainable-manufacturing-indicator:hover {
  background: #44a08d;
  transform: scale(1.1);
}

/* 移动端样式 */
@media (max-width: 768px) {
  .sustainable-manufacturing-section {
    padding: 60px 0;
  }
  
  .sustainable-manufacturing-container {
    padding: 0 16px;
  }
  
  .sustainable-manufacturing-title {
    font-size: 2rem;
  }
  
  .sustainable-manufacturing-subtitle {
    font-size: 1rem;
  }
  
  .sustainable-manufacturing-header {
    margin-bottom: 40px;
  }
  
  .sustainable-manufacturing-carousel-wrapper {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 20px 0;
  }
  
  .sustainable-manufacturing-carousel-wrapper::-webkit-scrollbar {
    display: none;
  }
  
  .sustainable-manufacturing-carousel-track {
    gap: 20px;
    padding: 0 20px;
  }
  
  .sustainable-manufacturing-statistic-item {
    flex: 0 0 280px;
    scroll-snap-align: center;
    padding: 30px 20px;
  }
  
  .sustainable-manufacturing-statistic-number {
    font-size: 2.5rem;
  }
  
  .sustainable-manufacturing-statistic-title {
    font-size: 1.125rem;
  }
  
  .sustainable-manufacturing-carousel-controls {
    display: none;
  }
  
  .sustainable-manufacturing-indicators {
    margin-top: 30px;
  }
}

@media (max-width: 480px) {
  .sustainable-manufacturing-statistic-item {
    flex: 0 0 260px;
  }
  
  .sustainable-manufacturing-title {
    font-size: 1.75rem;
  }
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const carousel = document.querySelector('.sustainable-manufacturing-carousel-track');
    const carouselWrapper = document.querySelector('.sustainable-manufacturing-carousel-wrapper');
    const originalItems = document.querySelectorAll('.sustainable-manufacturing-statistic-item');
    const indicators = document.querySelectorAll('.sustainable-manufacturing-indicator');
    const prevBtn = document.querySelector('.sustainable-manufacturing-prev-btn');
    const nextBtn = document.querySelector('.sustainable-manufacturing-next-btn');
    
    if (!carousel || originalItems.length === 0) return;
    
    let currentIndex = 0;
    const totalItems = originalItems.length;
    let itemsPerView = 3;
    let isMobile = window.innerWidth <= 768;
    let isTransitioning = false;
    let allItems = [];
    
    function getItemsPerView() {
      const width = window.innerWidth;
      if (width <= 768) {
        return 1;
      }
      return 3;
    }
    
    function createClonedItems() {
      if (isMobile || totalItems <= itemsPerView) return;
      
      // 清除之前的克隆元素
      const existingClones = carousel.querySelectorAll('.cloned');
      existingClones.forEach(clone => clone.remove());
      
      // 在开头添加最后几个元素的克隆
      for (let i = itemsPerView; i > 0; i--) {
        const cloneIndex = totalItems - i;
        const clone = originalItems[cloneIndex].cloneNode(true);
        clone.classList.add('cloned');
        carousel.insertBefore(clone, carousel.firstChild);
      }
      
      // 在末尾添加前几个元素的克隆
      for (let i = 0; i < itemsPerView; i++) {
        const clone = originalItems[i].cloneNode(true);
        clone.classList.add('cloned');
        carousel.appendChild(clone);
      }
      
      // 更新所有项目的引用
      allItems = carousel.querySelectorAll('.sustainable-manufacturing-statistic-item');
      
      // 设置初始位置（跳过前面的克隆元素）
      currentIndex = itemsPerView;
    }
    
    function setupCarousel() {
      isMobile = window.innerWidth <= 768;
      itemsPerView = getItemsPerView();
      
      if (isMobile) {
        // 手机端：移除所有transform，让原生滚动接管
        carousel.style.transform = 'none';
        // 移除克隆元素
        const clones = carousel.querySelectorAll('.cloned');
        clones.forEach(clone => clone.remove());
        allItems = [...originalItems];
        return;
      }
      
      // 桌面端：创建克隆元素实现无缝循环
      createClonedItems();
      
      // 计算宽度
      const wrapperWidth = carouselWrapper.offsetWidth;
      const totalGap = 30 * (itemsPerView - 1);
      const itemWidth = (wrapperWidth - totalGap) / itemsPerView;
      
      allItems.forEach(item => {
        item.style.width = itemWidth + 'px';
        item.style.minWidth = itemWidth + 'px';
      });
    }
    
    function updateCarousel(withTransition = true) {
      if (isMobile) {
        // 手机端不需要更新transform
        return;
      }
      
      const wrapperWidth = carouselWrapper.offsetWidth;
      const totalGap = 30 * (itemsPerView - 1);
      const itemWidth = (wrapperWidth - totalGap) / itemsPerView;
      const moveDistance = currentIndex * (itemWidth + 30);
      
      if (withTransition) {
        carousel.style.transition = 'transform 0.5s ease';
      } else {
        carousel.style.transition = 'none';
      }
      
      carousel.style.transform = `translateX(-${moveDistance}px)`;
      
      // 更新指示器（基于实际的逻辑索引）
      const logicalIndex = (currentIndex - itemsPerView + totalItems) % totalItems;
      indicators.forEach((indicator, index) => {
        indicator.classList.toggle('active', index === logicalIndex);
      });
    }
    
    function nextSlide() {
      if (isMobile || isTransitioning) return;
      
      isTransitioning = true;
      currentIndex++;
      updateCarousel(true);
      
      // 检查是否需要重置到开始位置
      setTimeout(() => {
        if (currentIndex >= totalItems + itemsPerView) {
          currentIndex = itemsPerView;
          updateCarousel(false);
        }
        isTransitioning = false;
      }, 500);
    }
    
    function prevSlide() {
      if (isMobile || isTransitioning) return;
      
      isTransitioning = true;
      currentIndex--;
      updateCarousel(true);
      
      // 检查是否需要重置到结束位置
      setTimeout(() => {
        if (currentIndex < itemsPerView) {
          currentIndex = totalItems + itemsPerView - 1;
          updateCarousel(false);
        }
        isTransitioning = false;
      }, 500);
    }
    
    function goToSlide(index) {
      if (isMobile || isTransitioning) return;
      
      isTransitioning = true;
      currentIndex = index + itemsPerView;
      updateCarousel(true);
      
      setTimeout(() => {
        isTransitioning = false;
      }, 500);
    }
    
    // 手机端滚动指示器更新
    function updateIndicatorsOnScroll() {
      if (!isMobile) return;
      
      const scrollLeft = carouselWrapper.scrollLeft;
      const itemWidth = originalItems[0].offsetWidth + 20; // 包含margin
      const activeIndex = Math.round(scrollLeft / itemWidth);
      
      indicators.forEach((indicator, index) => {
        indicator.classList.toggle('active', index === activeIndex);
      });
    }
    
    // 按钮事件（仅桌面端）
    if (nextBtn) nextBtn.addEventListener('click', nextSlide);
    if (prevBtn) prevBtn.addEventListener('click', prevSlide);
    
    // 指示器事件
    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        if (isMobile) {
          // 手机端：滚动到对应位置
          const itemWidth = originalItems[0].offsetWidth + 20;
          carouselWrapper.scrollTo({
            left: index * itemWidth,
            behavior: 'smooth'
          });
        } else {
          // 桌面端：跳转到指定幻灯片
          goToSlide(index);
        }
      });
    });
    
    // 手机端滚动事件监听
    if (carouselWrapper) {
      carouselWrapper.addEventListener('scroll', updateIndicatorsOnScroll);
    }
    
    // 自动播放（仅桌面端）
    {% if section.settings.autoplay %}
      let autoplayInterval;
      if (!isMobile) {
        autoplayInterval = setInterval(nextSlide, {{ section.settings.autoplayspeed | times: 1000 }});
        
        // 鼠标悬停时暂停自动播放
        carouselWrapper.addEventListener('mouseenter', () => {
          clearInterval(autoplayInterval);
        });
        
        carouselWrapper.addEventListener('mouseleave', () => {
          autoplayInterval = setInterval(nextSlide, {{ section.settings.autoplayspeed | times: 1000 }});
        });
      }
    {% endif %}
    
    // 窗口大小改变时重新计算
    let resizeTimeout;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(function() {
        setupCarousel();
        updateCarousel(false);
      }, 100);
    });
    
    // 初始化轮播
    setupCarousel();
    updateCarousel(false);
  });
</script>

{% schema %}
{
  "name": "Sustainable Manufacturing",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Sustainable Manufacturing"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Section Subtitle",
      "default": "Our commitment to environmental responsibility"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplayspeed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Autoplay Speed",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "statistic",
      "name": "Statistic",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number/Percentage",
          "default": "85%"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Renewable Energy"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Of our manufacturing processes are powered by renewable energy sources"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sustainable Manufacturing",
      "blocks": [
        {
          "type": "statistic",
          "settings": {
            "number": "85%",
            "title": "Renewable Energy",
            "description": "Of our manufacturing processes are powered by renewable energy sources"
          }
        },
        {
          "type": "statistic",
          "settings": {
            "number": "60%",
            "title": "Waste Reduction",
            "description": "Decrease in manufacturing waste through optimized processes"
          }
        },
        {
          "type": "statistic",
          "settings": {
            "number": "100%",
            "title": "Recyclable Materials",
            "description": "All packaging materials are fully recyclable or biodegradable"
          }
        },
        {
          "type": "statistic",
          "settings": {
            "number": "40%",
            "title": "Carbon Footprint",
            "description": "Reduction in carbon emissions compared to industry standards"
          }
        },
        {
          "type": "statistic",
          "settings": {
            "number": "95%",
            "title": "Water Conservation",
            "description": "Of water used in production is recycled and reused"
          }
        }
      ]
    }
  ]
}
{% endschema %}
